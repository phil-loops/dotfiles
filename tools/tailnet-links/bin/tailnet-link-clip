#!/bin/zsh
# When the clipboard is a lone admin.your-tailnet.ts.net URL outside /admin, rewrites it to app.loops.so (formatting kept).
# Copy the same link again within 2s to keep the tailnet form. `tailnet-link-clip <text>` prints one rewrite.
# Launchd keeps it alive; a failed build or a crash posts to Show's Inbox once a day.
set -uo pipefail
src=${0:A:h:h}/tailnet-link-clip.swift
dir=$HOME/.cache/tailnet-link-clip
bin=$dir/tailnet-link-clip
mkdir -p $dir

alarm() {
  local stamp=$dir/alarmed-$(date +%F)
  [[ -e $stamp ]] && return
  touch $stamp
  show-note "Copied links are no longer rewritten" "tailnet-link-clip $1. Tailnet links you copy stay tailnet links until it's fixed. Log: \`$dir/agent.log\`" || true
}

if [[ ! -x $bin || $src -nt $bin ]]; then
  if swiftc -O -o $bin.tmp $src; then
    mv $bin.tmp $bin
  else
    alarm "failed to build"
    [[ -x $bin ]] || exit 1
  fi
fi

(( $# )) && exec $bin "$@"
$bin
alarm "exited with status $?"
exit 1
