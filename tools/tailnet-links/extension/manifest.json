{
  "manifest_version": 3,
  "name": "Loops via tailnet",
  "version": "1.0",
  "description": "Opens app.loops.so pages on the tailnet admin host. Click the icon to turn it off.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "https://app.loops.so/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Loops via tailnet: on",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
