#!/bin/sh
# pre-rebase — drop the regenerable local overrides that git refuses to rebase across.
# Both hide a tracked-file edit with skip-worktree, which does not protect it: git still
# refuses any rebase that crosses a commit changing the file ("local changes would be
# overwritten"), before replaying a single commit.
#   .helix/languages.toml — helix-tsgo-stamp (post-checkout re-stamps a tsserver-pinned tree)
#   next.config.js        — loops-provenance's X-Dev-Worktree header (re-stamped on the next dev start)
for f in .helix/languages.toml next.config.js; do
  git ls-files -v "$f" 2>/dev/null | grep -q '^S' || continue
  git update-index --no-skip-worktree "$f" && git checkout -q -- "$f"
done
exit 0
