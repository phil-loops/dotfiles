#!/bin/sh

export PATH="$HOME/.volta/bin:/opt/homebrew/bin:$PATH"

# Slimmed 2026-08-19: correctness checks (behind-main, deploy-critical, oxfmt/tsc,
# green-tree skip) live ONLY in the viewer push gates now — the hook stopped
# duplicating them after the two deadlocked an additive push to an approved PR
# (the branch must sit on the PR tip to fast-forward, so "contains main's
# migrations" can never pass there). Full previous hook is in git history.
# What remains are the instant safety nets the gates don't cover.

# git pipes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
refs=$(cat)

# Block work-in-progress commits (X-WIP trailer / wip subjects) from reaching a remote.
printf '%s\n' "$refs" | "$HOME/.dotfiles/scripts/stack-prepush-guard" || exit 1

# the pushed commit: first ref line that isn't a delete (all-zero sha)
push_sha=$(printf '%s\n' "$refs" | awk '$2 !~ /^0+$/ { print $2; exit }')
[ -n "$push_sha" ] || exit 0

# Block TODOs from reaching the shared repo (forks still push freely).
PUSH_SHA="$push_sha" "$HOME/.dotfiles/scripts/prepush-todo-guard" "$@" || exit 1

exit 0
