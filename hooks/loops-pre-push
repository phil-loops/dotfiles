#!/bin/sh

export PATH="$HOME/.volta/bin:$PATH"

# Block work-in-progress commits (X-WIP trailer / wip subjects) from reaching a remote.
# Reads the ref lines git pipes in on stdin; the rest of this hook doesn't use stdin.
"$HOME/.dotfiles/scripts/stack-prepush-guard" || exit 1

# Warn if branch is behind main
behind=$(git rev-list --count HEAD..origin/main 2>/dev/null)
if [ "$behind" -gt 0 ] 2>/dev/null; then
  echo "⚠️  Branch is $behind commits behind origin/main. Consider: git rebase origin/main"

  # Check for deploy-critical changes missed from main
  critical=$(git diff HEAD..origin/main --name-only -- \
    'k8s/charts/loops/values.staging.yaml' \
    'k8s/charts/loops/values.production.yaml' \
    'packages/prisma/migrations/*' \
    'clickhouse/migrations/*' \
    'jobs.ts' \
    'jobs/index.ts' \
    '.env.template' \
    2>/dev/null)

  if [ -n "$critical" ]; then
    echo "🚨 Main has changes to deploy-critical files you're missing:"
    echo "$critical" | sed 's/^/   /'
    echo "   Run: git rebase origin/main"
    exit 1
  fi
fi

# Format-check files that differ from main; block the push if any are mis-formatted
files=$(git diff --name-only main HEAD --diff-filter=ACMR -- '*.ts' '*.tsx')
if [ -n "$files" ]; then
  echo "oxfmt: checking $(echo "$files" | wc -l | tr -d ' ') changed files..."
  if ! echo "$files" | xargs npx oxfmt --check; then
    exit 1
  fi
fi

# Push is proceeding → kick off a detached, on-demand CI watcher for this branch.
# It waits for the PR's checks to resolve, notifies once, then exits — so a watcher
# lives only while CI is in flight (replaces the old always-on launchd sweep).
branch=$(git rev-parse --abbrev-ref HEAD)
case "$branch" in
  main|HEAD) ;;  # never watch main or a detached HEAD
  *) ( "$HOME/.dotfiles/scripts/prwatch" --await "$branch" >/dev/null 2>&1 </dev/null & ) ;;
esac

# usage telemetry: log what this push is sending to GitHub (branch/project/ahead/subjects),
# for the local-vs-pushed workflow read. Detached + best-effort — never blocks the push.
( "$HOME/.dotfiles/scripts/stack-usage-event" push >/dev/null 2>&1 </dev/null & )
exit 0
