  th, td { text-align: left; padding: 12px 18px; border-bottom: 1px solid var(--rule); white-space: nowrap; vertical-align: top; }
  tr:last-child td { border-bottom: 0; }
  th { font-size: 12.5px; font-weight: 500; color: var(--soft); }
  th small { display: block; font-size: 11.5px; font-weight: 400; }
  th:nth-child(1) { width: 32%; } th:nth-child(2) { width: 24%; } th:nth-child(3) { width: 21%; }
  td.what { font-weight: 550; }
  .line { display: block; font: 12px var(--wire); font-weight: 400; color: var(--soft); margin-top: 3px; }
  td.expect { color: var(--soft); font-size: 13.5px; }
  td.expect b, td.got b { font: 500 13.5px var(--wire); margin-right: 8px; color: var(--ink); }
  td.got { border-left: 1px solid var(--rule); font-size: 13.5px; }
  td.got.still, td.got.still b { color: var(--still); }
  td.got.fixed, td.got.fixed b { color: var(--fixed); }
  td.got.latest { background: color-mix(in srgb, currentColor 7%, transparent); font-weight: 600; }
  td.got .why { display: block; max-width: 30ch; white-space: normal; font-size: 12px; font-weight: 400; color: var(--soft); margin-top: 3px; }
  td.none { border-left: 1px solid var(--rule); color: var(--soft); font-size: 13px; }

  .trailhead { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 14px; }
  .tabs { display: flex; gap: 4px; flex-wrap: wrap; }
  .tabs button { font: 500 13px var(--sans); color: var(--soft); background: none; border: 1px solid var(--rule); border-radius: 4px; padding: 6px 12px; cursor: pointer; }
  .tabs button[aria-pressed="true"] { color: var(--press-ink); background: var(--ink); border-color: var(--ink); }
  ol.trail { list-style: none; margin: 0; padding: 0; counter-reset: req; background: var(--sheet); border: 1px solid var(--rule); }
  ol.trail > li { counter-increment: req; border-bottom: 1px solid var(--rule); }
  ol.trail > li:last-child { border-bottom: 0; }
  ol.trail summary { display: grid; grid-template-columns: 2.2em 3.2em 1fr auto; gap: 12px; align-items: baseline; padding: 11px 18px; cursor: pointer; list-style: none; font: 12.5px var(--wire); }
  ol.trail summary::-webkit-details-marker { display: none; }
  ol.trail summary::before { content: counter(req); color: var(--soft); }
  ol.trail summary .st { font-weight: 500; }
  ol.trail li.ok .st { color: var(--fixed); } ol.trail li.no .st { color: var(--still); }
  ol.trail li.skip { color: var(--soft); } ol.trail li.skip summary { cursor: default; }
  ol.trail summary .u { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  ol.trail summary .t { color: var(--soft); font-family: var(--sans); font-size: 12.5px; }
  ol.trail details[open] summary { background: color-mix(in srgb, var(--ink) 5%, transparent); }
  .exchange { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--rule); }
  .exchange > div { padding: 14px 18px 18px; min-width: 0; }
  .exchange > div + div { border-left: 1px solid var(--rule); }
  .exchange h3 { font: 600 12.5px var(--sans); margin: 0 0 8px; color: var(--soft); }
  .exchange pre { margin: 0 0 12px; font: 12px/1.5 var(--wire); white-space: pre-wrap; word-break: break-word; max-height: 420px; overflow: auto; }
  .hint { color: var(--soft); padding: 18px; background: var(--sheet); border: 1px solid var(--rule); }
  @media (max-width: 720px) { .exchange { grid-template-columns: 1fr; } .exchange > div + div { border-left: 0; border-top: 1px solid var(--rule); } }
  @media (prefers-reduced-motion: reduce) { button.run { transition: none; } }
</style>
<main>
  <div class="top"><span><b id="ticket"></b> replayed against <span id="env"></span></span><span><span id="team"></span><span class="envs" id="envs"></span></span></div>
  <h1 id="verdict">Nothing run yet.</h1>
  <p class="lede" id="lede"></p>
  <div class="press" id="starters"><button class="run" id="ask">Run, asking before each write</button><button class="quiet" id="auto">Run all without stopping</button><span id="note" role="status"></span></div>
  <div id="next" hidden></div>
  <div id="setup" hidden></div>
  <div id="ready" hidden></div>
  <div id="groups"></div>
  <section><div class="trailhead"><h2>Every request, in the order it was sent</h2><div class="tabs" id="tabs"></div></div><div id="trail"></div></section>
</main>
<script>
const $ = (id) => document.getElementById(id);
const file = new URLSearchParams(location.search).get("file");
const envName = new URLSearchParams(location.search).get("env");
const api = (path, more = "") => path + "?file=" + encodeURIComponent(file) + (envName ? "&env=" + encodeURIComponent(envName) : "") + more;
const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
const clock = (at) => new Date(at).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
let busy = false, last = "", shownRun = null, openReqs = new Set();

function headline(state) {
  const run = state.runs[state.runs.length - 1];
  if (!run) return ["", "Nothing run yet.", state.about];
  if (run.inProgress) return ["", "Run in progress.", run.trail.filter((t) => !t.skipped).length + " requests sent so far. Nothing that writes is sent until you say so."];
  const all = state.groups.filter((g) => g.applies).flatMap((g) => g.steps.map((s) => run.verdicts[s.id])), count = (k) => all.filter((v) => v === k).length;
  const notes = [count("not-run") && count("not-run") + " could not run; the table says why.", count("unexpected") && count("unexpected") + " answered something neither side of the claim expects; read the trail below.", run.stopped && "The run ended early: " + run.stopped + "."].filter(Boolean).join(" ");
  if (!count("fixed")) return ["still", "Nothing has changed yet.", notes || state.env.name + " still answers the way it does today. Deploy, then run again."];
  if (count("fixed") === all.length) return ["fixed", "Everything is fixed.", notes || state.env.name + " now answers every request the way the branches intend."];
  const done = state.groups.filter((g) => g.applies && g.steps.length && g.steps.every((s) => run.verdicts[s.id] === "fixed")).map((g) => g.title);
  return ["", done.length ? done.join(" and ") + ": fixed. The rest: not yet." : count("fixed") + " of " + all.length + " claims are fixed.", notes || "The table shows which requests still answer the old way."];
}

function cell(run, step, latest) {
  const seen = run.seen[step.id], kind = run.verdicts[step.id];
  if (!seen) return '<td class="none">' + (run.inProgress ? "" : "not reached") + "</td>";
  if (seen.skipped) return '<td class="none">Not run: ' + esc(seen.skipped) + "</td>";
  const word = { fixed: "fixed", today: "same as today", unexpected: "unexpected" }[kind], cls = { fixed: "fixed", today: "still", unexpected: "odd" }[kind];
  return '<td class="got ' + cls + (latest ? " latest" : "") + '"><b>' + (seen.status || "failed") + "</b>" + word + (kind === "unexpected" ? '<span class="why">' + esc(seen.message) + "</span>" : "") + "</td>";
}

function render(state) {
  const runs = state.runs, latest = runs[runs.length - 1], live = Boolean(latest?.inProgress);
  document.title = state.title;
  $("ticket").textContent = state.ticket ?? state.title; $("env").textContent = state.env.name + ", " + state.env.base + (state.env.branch ? ", set up to serve " + state.env.branch : "");
  $("envs").innerHTML = state.envs.length > 1 ? state.envs.map((n) => '<a href="/b?file=' + encodeURIComponent(file) + "&env=" + encodeURIComponent(n) + '"' + (n === state.env.name ? ' aria-current="page"' : "") + ">" + esc(n) + "</a>").join("") : "";
  setupCommand = state.setup;
  if (wasLive && !live) loadChecks();
  wasLive = live;
  $("team").textContent = latest?.team ? "Key belongs to " + latest.team : "";
  $("setup").hidden = state.hasKey && !state.problems.length;
  $("setup").innerHTML = state.problems.length ? "This scenario has problems and cannot run:<pre>" + esc(state.problems.join("\\n")) + "</pre>"
    : "No API key yet. Store the key this bench should use, then come back:<pre>security add-generic-password -s " + esc(state.env.key) + " -a loops -w</pre>";
  $("starters").hidden = live;
  $("ask").disabled = $("auto").disabled = busy || !state.hasKey || state.problems.length > 0;
  const [tone, head, lede] = headline(state);
  $("verdict").className = tone; $("verdict").textContent = head; $("lede").textContent = lede;
  renderNext(state, live);
  $("groups").innerHTML = state.groups.filter((g) => g.steps.length).map((g) =>
    "<section><h2>" + esc(g.title) + "</h2>" + (g.branch ? '<p class="branch">Fixed by <a href="' + esc(g.href) + '">' + esc(g.branch) + "</a>" + (g.tip ? ", now at " + esc(g.tip) : ", which is gone locally, so merged") + (g.applies ? "" : ". " + esc(state.env.name) + " serves " + esc(state.env.branch) + ", so these answers say nothing about this branch") + "</p>" : "") +
    '<div class="scroll"><table><tr><th>Request</th><th>Answers today</th><th>Should answer</th>' +
    (runs.length ? runs.map((r, i) => "<th>Run " + (i + 1) + "<small>" + esc(clock(r.at)) + "</small></th>").join("") : "<th>Runs</th>") + "</tr>" +
    g.steps.map((s) => '<tr><td class="what">' + esc(s.label) + '<span class="line">' + esc(s.line) + "</span></td>" +
      '<td class="expect"><b>' + s.claim.today.status + "</b>" + esc(s.claim.today.text ?? "") + '</td><td class="expect"><b>' + s.claim.fixed.status + "</b>" + esc(s.claim.fixed.text ?? "") + "</td>" +
      (runs.length ? runs.map((r, i) => cell(r, s, i === runs.length - 1)).join("") : '<td class="none">not run yet</td>') + "</tr>").join("") +
    "</table></div></section>").join("");
  if (!runs.some((r) => r.at === shownRun)) shownRun = latest?.at ?? null;
  renderTrail(runs);
}

let setupCommand = null, wasLive = false;
async function loadChecks() {
  const box = $("ready");
  let list;
  try { list = await (await fetch(api("/checks"))).json(); } catch { return; }
  if (!Array.isArray(list)) return;
  const missing = list.filter((c) => !c.ok);
  box.hidden = false;
  box.innerHTML = "<ul>" + list.map((c) => '<li class="' + (c.ok ? "" : "miss") + '">' + esc(c.label) + (c.detail ? "<small>" + esc(c.detail) + "</small>" : "") +
      (!c.ok && c.fix && c.fix !== "run the setup command" ? "<small>" + esc(c.fix) + "</small>" : "") + "</li>").join("") + "</ul>" +
    (missing.length && setupCommand ? "<pre>" + esc(setupCommand) + "</pre>" : "") +
    (missing.length ? '<button class="quiet" id="recheck">Check again</button>' : "");
  const again = $("recheck"); if (again) again.onclick = loadChecks;
}

function renderNext(state, live) {
  const n = state.pending, box = $("next");
  box.hidden = !live;
  if (!live) return;
  if (!n) { box.innerHTML = '<div class="ask"><p>Waiting for the answer…</p></div>'; return; }
  box.innerHTML = '<div class="ask"><p>Next request<small>writes to ' + esc(state.env.name) + " if it succeeds</small></p><pre>" + esc(n.method) + " " + esc(n.url) + (n.body ? "\\n\\n" + pretty(n.body) : "") + "</pre></div>" +
    '<div class="acts"><button class="run" data-do="send">Send this request</button><button class="quiet" data-do="skip">Skip it</button><span class="gap"></span><button class="quiet" data-do="rest">Send this and the rest</button><button class="quiet" data-do="stop">Stop the run</button></div>';
  box.querySelector("button")?.focus();
}

const pretty = (v) => esc(v == null ? "(none)" : typeof v === "string" ? v : JSON.stringify(v, null, 2));
function renderTrail(runs) {
  $("tabs").innerHTML = runs.map((r, i) => '<button data-at="' + esc(r.at) + '" aria-pressed="' + (r.at === shownRun) + '">Run ' + (i + 1) + ", " + esc(clock(r.at)) + (r.inProgress ? ", in progress" : r.stopped ? ", stopped early" : "") + "</button>").join("");
  const run = runs.find((r) => r.at === shownRun);
  if (!run) { $("trail").innerHTML = '<p class="hint">After a run, each request it sent is listed here with its full response.</p>'; return; }
  $("trail").innerHTML = '<ol class="trail">' + run.trail.map((t, j) => {
    if (t.skipped) return '<li class="skip"><details><summary><span class="st">skip</span><span class="u">' + esc(t.method) + " " + esc(t.url) + '</span><span class="t">you skipped it</span></summary></details></li>';
    const k = run.at + ":" + j, ok = t.status >= 200 && t.status < 300;
    return '<li class="' + (ok ? "ok" : "no") + '"><details data-k="' + k + '"' + (openReqs.has(k) ? " open" : "") + '><summary><span class="st">' + (t.status ?? "…") + '</span><span class="u">' + esc(t.method) + " " + esc(t.url) + '</span><span class="t">' + (t.ms ?? "") + " ms</span></summary>" +
      '<div class="exchange"><div><h3>Sent at ' + esc(new Date(t.at).toLocaleTimeString()) + "</h3><pre>" + esc(t.method) + " " + esc(t.url) + "\\n" + Object.entries(t.requestHeaders ?? {}).map(([h, v]) => esc(h) + ": " + esc(v)).join("\\n") + "</pre><h3>Body</h3><pre>" + pretty(t.requestBody) + "</pre></div>" +
      "<div><h3>Answered " + (t.status || "nothing") + " in " + (t.ms ?? "?") + " ms</h3><pre>" + Object.entries(t.responseHeaders ?? {}).map(([h, v]) => esc(h) + ": " + esc(v)).join("\\n") + "</pre><h3>Body</h3><pre>" + pretty(t.responseBody) + "</pre></div></div></details></li>";
  }).join("") + "</ol>";
}

$("tabs").onclick = (e) => { const at = e.target.dataset?.at; if (at) { shownRun = at; renderTrail(JSON.parse(last).runs); } };
$("trail").addEventListener("toggle", (e) => { const k = e.target.dataset?.k; if (k) e.target.open ? openReqs.add(k) : openReqs.delete(k); }, true);
async function post(path, more) {
  busy = true; document.querySelectorAll("button.run, button.quiet").forEach((b) => (b.disabled = true));
  try { const text = await (await fetch(api(path, more), { method: "POST" })).text(); const state = JSON.parse(text); busy = false; last = text; $("note").textContent = state.error ?? ""; render(state); }
  catch (e) { busy = false; $("note").textContent = "That failed: " + e.message; load(true); }
}
$("next").onclick = (e) => { const act = e.target.dataset?.do; if (act && !busy) post("/next", "&do=" + act); };
$("ask").onclick = () => { shownRun = null; post("/run", "&mode=ask"); };
$("auto").onclick = () => { shownRun = null; post("/run", "&mode=auto"); };
async function load(force) {
  if (busy) return;
  const text = await (await fetch(api("/state"))).text();
  if (force || text !== last) { last = text; render(JSON.parse(text)); }
}
load().then(loadChecks); setInterval(load, 1500); document.addEventListener("visibilitychange", () => load());
</script>
</html>`;

// ---------- commands ---------------------------------------------------------------------------------------------------

function scenarioFor(url) {
  const file = resolve(url.searchParams.get("file") ?? "");
  if (!file.startsWith(SHOW_DIR + "/") || !file.endsWith(".json")) throw new Error(`a scenario must be a .json file under ${SHOW_DIR}`);
  return loadScenario(file, url.searchParams.get("env") ?? undefined);
}

function serve(port) {
  createServer(async (req, res) => {
    const json = (code, body) => { res.writeHead(code, { "Content-Type": "application/json" }); res.end(JSON.stringify(body)); };
    const url = new URL(req.url, "http://x");
    try {
      if (req.method === "GET" && url.pathname === "/") return json(200, { bench: true });
      if (req.method === "GET" && url.pathname === "/b") {
        res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
        return res.end(PAGE);
      }
      const s = scenarioFor(url);
      if (req.method === "GET" && url.pathname === "/state") return json(200, state(s));
      if (req.method === "GET" && url.pathname === "/checks") return json(200, await checks(s));
      if (req.method === "POST" && url.pathname === "/run") {
        const key = readKey(s), problems = lint(s);
        if (problems.length) return json(200, { ...state(s), error: "the scenario has problems" });
        if (!key) return json(200, { ...state(s), error: "no key in the Keychain" });
        if (active.has(s.slot)) return json(200, { ...state(s), error: "a run is already in progress" });
        const done = startRun(s, key, url.searchParams.get("mode") === "auto" ? "auto" : "ask");
        const a = active.get(s.slot);
        await Promise.race([done, (async () => { while (active.get(s.slot) === a && !a.pending) await new Promise((r) => setTimeout(r, 40)); })()]);
        return json(200, state(s));
      }
      if (req.method === "POST" && url.pathname === "/next") {
        const a = active.get(s.slot), answer = url.searchParams.get("do");
        if (!a?.pending || !["send", "skip", "rest", "stop"].includes(answer)) return json(200, { ...state(s), error: "nothing is waiting" });
        const { resolve: go } = a.pending;
        a.pending = null;
        go(answer);
        while (active.get(s.slot) === a && !a.pending) await new Promise((r) => setTimeout(r, 40));
        return json(200, state(s));
      }
      json(404, { error: "not found" });
    } catch (error) {
      json(400, { error: error.message });
    }
  }).listen(port, "127.0.0.1", () => console.log(`bench on http://127.0.0.1:${port}`));
}

const [command, ...rest] = process.argv.slice(2);
if (command === "serve") {
  serve(Number(rest[rest.indexOf("--port") + 1] && rest.includes("--port") ? rest[rest.indexOf("--port") + 1] : process.env.BENCH_PORT ?? 7240));
} else if (command === "check" && rest[0]) {
  const problems = lint(loadScenario(rest[0]));
  console.log(problems.length ? problems.map((p) => "✗ " + p).join("\n") : "✓ scenario is sound");
  process.exit(problems.length ? 1 : 0);
} else if (command === "status" && rest[0]) {
  const s = loadScenario(rest[0]), all = loadRuns(s);
  if (!all.length) console.log("no runs yet");
  for (const env of s.envs) {
    const run = all.filter((r) => r.env?.name === env.name).at(-1);
    for (const g of run ? s.groups.filter((g) => applies({ ...s, env }, g)) : []) {
      const kinds = s.steps.filter((step) => step.claim && step.group === g.id).map((step) => verdict(step.claim, run.seen[step.id]));
      console.log(`${g.branch ?? g.id}: ${kinds.filter((k) => k === "fixed").length} of ${kinds.length} fixed on ${run.env.name}, ${run.at}`);
    }
  }
} else if ((command === "setup" || command === "checks") && rest[0]) {
  const s = loadScenario(rest[0], rest.includes("--env") ? rest[rest.indexOf("--env") + 1] : undefined);
  (command === "setup" ? setup(s) : printChecks(s)).then((ok) => process.exit(ok ? 0 : 1), (error) => { console.error("✗ " + error.message); process.exit(1); });
} else {
  console.error("usage: bench serve [--port 7240] | bench check|status <scenario.json> | bench setup|checks <scenario.json> [--env name]");
  process.exit(64);
}
