#!/usr/bin/env node
// bench — replay a scenario's claims against a live environment and keep every run as evidence.
//
// A bench is a set of claims about a live system: "this request answers X today and should answer Y once branch B is
// deployed". The scenario (a Show document, `"mode": "bench"`, see the show skill) states the claims; this runner observes
// them; the verdict is a pure function of claim and observation (`verdict`); the page only renders what `/state` returns.
//
//   bench serve [--port 7240]     the page server Show's Bench workspace loads (http://127.0.0.1:7240/b?file=<scenario>)
//   bench check <scenario.json>   lint a scenario; exit 1 on errors
//   bench status <scenario.json>  the latest run's verdict per group and environment, one line each
//   bench setup <scenario.json> [--env local]   build the state the claims need: run the environment's fixture in the
//                                 loops checkout that has its branch, keep the key it makes in the Keychain, start a
//                                 preview server on the environment's port, then print the checklist
//   bench checks <scenario.json> [--env name]   the checklist alone: what must be true before a run means anything
//
// A scenario lists its environments in `envs` (the first is the default; `?env=<name>` picks another). An environment
// with a `fixture` (a script in scripts/bench-fixtures) and a `branch` can be set up from nothing; one without is
// somebody's standing state, and `checks` (read-only requests) say whether that state is there.
//
// Runs are append-only JSON lines in ~/Library/Application Support/Show/bench-runs/<scenario>.jsonl (BENCH_RUNS overrides).
// The API key comes from the Keychain item the scenario names, on every run, and never reaches the page or a run record.
// Only staging and local hosts are allowed; a step that writes waits for a click unless the run was started as "auto".
import { execFileSync } from "node:child_process";
import { appendFileSync, existsSync, mkdirSync, readFileSync } from "node:fs";
import { createServer } from "node:http";
import { homedir } from "node:os";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const ALLOWED_HOSTS = ["app.l3s.email", "localhost", "127.0.0.1"];
const SHOW_DIR = resolve((process.env.SHOW_DIR ?? join(homedir(), ".dotfiles", "show")).replace(/^~/, homedir()));
const FIXTURES = join(dirname(fileURLToPath(import.meta.url)), "bench-fixtures");
const LOCAL_HOSTS = ["localhost", "127.0.0.1"];
const RUNS_DIR = process.env.BENCH_RUNS ?? join(homedir(), "Library", "Application Support", "Show", "bench-runs");

// ---------- scenario ---------------------------------------------------------------------------------------------------

function loadScenario(file, envName) {
  const path = resolve(file);
  const doc = JSON.parse(readFileSync(path, "utf8"));
  const bench = doc.bench ?? {};
  const envs = bench.envs ?? (bench.env ? [bench.env] : []);
  if (envName && !envs.some((e) => e.name === envName)) throw new Error(`no environment named ${envName} (${envs.map((e) => e.name).join(", ")})`);
  const env = envs.find((e) => e.name === envName) ?? envs[0];
  return { path, id: basename(path, ".json"), title: doc.title ?? basename(path), ...bench, env, envs, slot: `${path}#${env?.name}`,
    groups: bench.groups ?? [], steps: bench.steps ?? [], checks: bench.checks ?? [] };
}

const isLocal = (env) => LOCAL_HOSTS.includes(new URL(env.base).hostname);

function lint(s) {
  const errors = [];
  const say = (m) => errors.push(m);
  if (!s.envs.length) say("no environment (envs)");
  for (const env of s.envs) {
    const at = `env ${env.name ?? "?"}`;
    if (!env.name) say("an environment has no name");
    if (!env.base) say(`${at}: base is missing`);
    else if (!ALLOWED_HOSTS.includes(new URL(env.base).hostname)) say(`${at}: host ${new URL(env.base).hostname} is not allowed (${ALLOWED_HOSTS.join(", ")})`);
    if (!env.key) say(`${at}: key (a Keychain service name) is missing`);
    if (env.fixture && !(env.base && isLocal(env))) say(`${at}: a fixture writes to a database, so it is only allowed on a local environment`);
    if (env.fixture && !existsSync(join(FIXTURES, env.fixture))) say(`${at}: fixture ${env.fixture} is not in scripts/bench-fixtures`);
    if (env.fixture && !env.branch) say(`${at}: a fixture needs branch, the checkout it runs in`);
  }
  for (const check of s.checks) {
    if (!check.label || !check.path) say("a check needs label and path");
  }
  if (!s.steps.length) say("no steps");
  const ids = new Set(), groups = new Set(s.groups.map((g) => g.id)), known = new Set(["now"]);
  for (const step of s.steps) {
    const at = `step ${step.id ?? "?"}`;
    if (!step.id) say("a step has no id");
    if (ids.has(step.id)) say(`${at}: id used twice`);
    ids.add(step.id);
    if (!step.request?.method || !step.request?.path) say(`${at}: request needs method and path`);
    if (step.claim && !(step.claim.today?.status && step.claim.fixed?.status)) say(`${at}: a claim needs today.status and fixed.status`);
    if (step.claim && !groups.has(step.group)) say(`${at}: a claim's group must name one of groups[].id`);
    for (const [, names] of JSON.stringify(step.request ?? {}).matchAll(/\{([\w|?]+)\}/g)) {
      for (const name of names.replace("?", "").split("|")) if (!known.has(name)) say(`${at}: {${name}} is never captured before it is used`);
    }
    Object.keys(step.capture ?? {}).forEach((name) => known.add(name));
  }
  return errors;
}

/// `data[!systemEmailType&draftEmailMessageId].id`: dotted path; `[conds]` picks the first array element whose named
/// fields are truthy (or falsy with `!`), `[]` the first element.
function pick(value, path) {
  for (const part of path.split(".")) {
    const [, key, conds] = part.match(/^(\w+)(?:\[([^\]]*)\])?$/) ?? [];
    if (!key || value == null) return undefined;
    value = value[key];
    if (conds !== undefined) {
      const tests = conds.split("&").filter(Boolean);
      value = (Array.isArray(value) ? value : []).find((item) => tests.every((t) => (t.startsWith("!") ? !item?.[t.slice(1)] : item?.[t])));
    }
  }
  return value ?? undefined;
}

/// Fills `{a|b}` (first captured wins) and `{a?}` (optional: a body key holding only it is dropped). Returns the names
/// that were required and missing.
function fill(template, vars) {
  const missing = [];
  const text = (s) =>
    s.replace(/\{([\w|?]+)\}/g, (_, names) => {
      const optional = names.endsWith("?");
      const found = names.replace("?", "").split("|").map((n) => vars[n]).find((v) => v !== undefined);
      if (found === undefined && !optional) missing.push(names);
      return found ?? "";
    });
  const walk = (v) => {
    if (typeof v === "string") return text(v);
    if (Array.isArray(v)) return v.map(walk);
    if (v && typeof v === "object") {
      return Object.fromEntries(Object.entries(v).flatMap(([k, x]) => (typeof x === "string" && /^\{\w+\?\}$/.test(x) && vars[x.slice(1, -2)] === undefined ? [] : [[k, walk(x)]])));
    }
    return v;
  };
  return { value: walk(template), missing };
}

/// The verdict: what an observation says about a claim. Pure; every view uses this and nothing else.
function verdict(claim, seen) {
  if (!claim) return "lookup";
  if (!seen || seen.status == null) return "not-run";
  const holds = (side) => seen.status === side.status && (!side.says || (seen.message ?? "").includes(side.says));
  return holds(claim.fixed) ? "fixed" : holds(claim.today) ? "today" : "unexpected";
}

// ---------- evidence ---------------------------------------------------------------------------------------------------

const runsFile = (s) => join(RUNS_DIR, `${s.id}.jsonl`);
function loadRuns(s) {
  if (!existsSync(runsFile(s))) return [];
  return readFileSync(runsFile(s), "utf8").split("\n").filter(Boolean).map((line) => JSON.parse(line));
}
function recordRun(s, run) {
  mkdirSync(RUNS_DIR, { recursive: true });
  appendFileSync(runsFile(s), JSON.stringify(run) + "\n");
}

function readKey(s) {
  if (process.env.BENCH_KEY) return process.env.BENCH_KEY;
  try {
    return execFileSync("security", ["find-generic-password", "-s", s.env.key, "-w"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
  } catch {
    return null;
  }
}

function branchTip(s, branch) {
  const repo = process.env.BENCH_REPO ?? join(homedir(), "coding", s.repo ?? "");
  try {
    return execFileSync("git", ["-C", repo, "rev-parse", "--short=10", `refs/heads/${branch}`], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
  } catch {
    return null;
  }
}

// ---------- running ----------------------------------------------------------------------------------------------------

class Stopped extends Error {}
/// The run in flight per scenario path. In "ask" mode a step that writes waits in `pending` for send, skip, rest or stop.
const active = new Map();

async function send(s, key, a, step, request) {
  const url = s.env.base + request.path;
  const writes = step.writes ?? request.method !== "GET";
  if (a.mode === "ask" && writes) {
    const answer = await new Promise((resolve) => (a.pending = { step: step.id, method: request.method, url, body: request.body ?? null, resolve }));
    a.pending = null;
    if (answer === "stop") throw new Stopped();
    if (answer === "rest") a.mode = "auto";
    if (answer === "skip") {
      a.run.trail.push({ step: step.id, at: new Date().toISOString(), method: request.method, url, requestBody: request.body ?? null, skipped: true });
      return { skipped: "you skipped it" };
    }
  }
  const started = Date.now();
  const entry = { step: step.id, at: new Date(started).toISOString(), method: request.method, url, writes,
    requestHeaders: { Authorization: "Bearer ••••" + key.slice(-4), ...(request.body ? { "Content-Type": "application/json" } : {}) },
    requestBody: request.body ?? null };
  a.run.trail.push(entry);
  try {
    const res = await fetch(url, { method: request.method,
      headers: { Authorization: `Bearer ${key}`, ...(request.body ? { "Content-Type": "application/json" } : {}) },
      body: request.body ? JSON.stringify(request.body) : undefined, signal: AbortSignal.timeout(20000) });
    const text = await res.text();
    let json = null;
    try { json = JSON.parse(text); } catch {}
    Object.assign(entry, { status: res.status, ms: Date.now() - started,
      responseHeaders: Object.fromEntries(["content-type", "x-request-id"].flatMap((h) => (res.headers.get(h) ? [[h, res.headers.get(h)]] : []))),
      responseBody: json ?? text.slice(0, 20000) });
    return { status: res.status, json, message: json?.message ?? (json ? "" : text.slice(0, 200)), ms: entry.ms };
  } catch (error) {
    Object.assign(entry, { status: 0, ms: Date.now() - started, responseBody: `request failed: ${error.message}` });
    return { status: 0, json: null, message: `request failed: ${error.message}`, ms: entry.ms };
  }
}

async function execute(s, key, a) {
  const vars = { now: a.run.at.slice(0, 16).replace("T", " ") };
  for (const step of s.steps) {
    const { value: request, missing } = fill(step.request, vars);
    if (missing.length) {
      a.run.seen[step.id] = { skipped: step.needs ?? `nothing earlier gave it ${missing.join(", ")}` };
      continue;
    }
    const seen = await send(s, key, a, step, request);
    a.run.seen[step.id] = seen.skipped ? seen : { status: seen.status, message: seen.message, ms: seen.ms };
    if (seen.status >= 200 && seen.status < 300) {
      for (const [name, path] of Object.entries(step.capture ?? {})) {
        const value = pick(seen.json, path);
        if (value !== undefined && vars[name] === undefined) vars[name] = value;
      }
    }
    if (vars.team) a.run.team = vars.team;
  }
}

async function startRun(s, key, mode) {
  const a = { mode, pending: null,
    run: { at: new Date().toISOString(), scenario: s.id, env: { name: s.env.name, base: s.env.base }, mode, team: null,
      tips: Object.fromEntries(s.groups.filter((g) => g.branch).map((g) => [g.branch, branchTip(s, g.branch)])), seen: {}, trail: [] } };
  active.set(s.slot, a);
  try {
    await execute(s, key, a);
  } catch (error) {
    a.run.stopped = error instanceof Stopped ? "you stopped it" : error.message;
  }
  recordRun(s, a.run);
  active.delete(s.slot);
}

/// An environment that serves one branch can only speak for that branch's claims.
/// A branch that is gone locally has merged (contracted out of its forest), so every server already carries it.
const applies = (s, group) => !s.env.branch || !group.branch || group.branch === s.env.branch || branchTip(s, group.branch) === null;

// ---------- what the page is told --------------------------------------------------------------------------------------

function state(s) {
  const a = active.get(s.slot);
  const runs = loadRuns(s).filter((run) => run.env?.name === s.env.name).slice(-8);
  if (a) runs.push({ ...a.run, inProgress: true });
  const requestLine = (step) => `${step.request.method} ${step.request.path.replace(/\{[\w|?]+\}/g, "{id}")}`;
  return {
    title: s.title, ticket: s.ticket ?? null, about: s.about ?? "", env: { name: s.env.name, base: s.env.base, key: s.env.key, branch: s.env.branch ?? null },
    envs: s.envs.map((e) => e.name), setup: s.env.fixture ? `bench setup ${s.path.replace(homedir(), "~")} --env ${s.env.name}` : null,
    hasKey: Boolean(readKey(s)), problems: lint(s),
    groups: s.groups.map((g) => ({ ...g, applies: applies(s, g), tip: g.branch ? branchTip(s, g.branch) : null,
      href: g.branch && s.repo ? `canopy://v2/b/${s.repo}/${g.branch}` : null,
      steps: s.steps.filter((step) => step.claim && step.group === g.id).map((step) => ({ id: step.id, label: step.label ?? step.id, line: requestLine(step), claim: step.claim })) })),
    runs: runs.map((run) => ({ ...run, verdicts: Object.fromEntries(s.steps.filter((step) => step.claim).map((step) => [step.id, verdict(step.claim, run.seen[step.id])])) })),
    pending: a?.pending ? { ...a.pending, resolve: undefined, writes: true } : null,
  };
}

// ---------- before a run -----------------------------------------------------------------------------------------------

/// What must be true for a run to mean anything, observed with read-only requests: the key, the server, then the
/// scenario's own `checks` ({label, path, has?, fix?}; `has` is a `pick` path that must find something).
async function checks(s) {
  const key = readKey(s), fixWith = s.env.fixture ? "run the setup command" : null;
  const out = [{ label: "An API key is in the Keychain", ok: Boolean(key), detail: key ? "" : s.env.key, fix: fixWith ?? `security add-generic-password -s ${s.env.key} -a loops -w` }];
  if (!key) return out;
  const get = async (path) => {
    try {
      const res = await fetch(s.env.base + path, { headers: { Authorization: `Bearer ${key}` }, signal: AbortSignal.timeout(8000) });
      return { status: res.status, json: await res.json().catch(() => null) };
    } catch (error) {
      return { status: 0, json: null, error: error.message };
    }
  };
  const who = await get("/api-key");
  out.push({ label: `${s.env.name} answers and accepts the key`, ok: who.status === 200,
    detail: who.status === 200 ? `key belongs to ${who.json?.teamName ?? "a team"}` : who.status ? `answered ${who.status}` : `no answer from ${s.env.base}`,
    fix: fixWith ?? (who.status ? "store a key this environment accepts" : "check the environment is up") });
  if (who.status !== 200) return out;
  for (const check of s.checks) {
    const seen = await get(check.path);
    const ok = seen.status >= 200 && seen.status < 300 && (!check.has || pick(seen.json, check.has) !== undefined);
    out.push({ label: check.label, ok, detail: ok ? "" : seen.status >= 200 && seen.status < 300 ? "not found" : `answered ${seen.status || "nothing"}`, fix: fixWith ?? check.fix ?? "" });
  }
  return out;
}

function checkoutOf(s, branch) {
  const repo = process.env.BENCH_REPO ?? join(homedir(), "coding", s.repo ?? "");
  const blocks = execFileSync("git", ["-C", repo, "worktree", "list", "--porcelain"], { encoding: "utf8" }).split("\n\n");
  const block = blocks.find((b) => b.split("\n").includes(`branch refs/heads/${branch}`));
  return block?.split("\n")[0].replace(/^worktree /, "") ?? null;
}

async function setup(s) {
  const env = s.env, problems = lint(s);
  if (problems.length) throw new Error(problems.join("\n"));
  if (!env.fixture) throw new Error(`${env.name} has no fixture: its state is set up by hand. \`bench checks\` says what is missing.`);
  const dir = checkoutOf(s, env.branch);
  if (!dir) throw new Error(`no worktree has ${env.branch} checked out; check it out somewhere, then run this again`);
  console.log(`▸ fixture ${env.fixture} in ${dir}`);
  const printed = execFileSync("npx", ["tsx", "--tsconfig", "script-runner/tsconfig.json", "--import", "dotenv/config", join(FIXTURES, env.fixture)],
    { cwd: dir, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], maxBuffer: 1 << 26 });
  const made = JSON.parse(printed.trim().split("\n").at(-1));
  execFileSync("security", ["add-generic-password", "-U", "-s", env.key, "-a", "loops", "-w", made.key]);
  console.log(`▸ ${made.team}: key ••••${made.key.slice(-4)} kept in the Keychain as ${env.key}`);
  const up = async () => { try { return (await fetch(env.base + "/api-key", { signal: AbortSignal.timeout(60000) })).status > 0; } catch { return false; } };
  if (!(await up())) {
    console.log(`▸ nothing answers at ${env.base}; starting a preview of ${env.branch}`);
    execFileSync("loops-preview", [dir, "--port", new URL(env.base).port], { stdio: "inherit" });
    for (let i = 0; i < 90 && !(await up()); i++) await new Promise((r) => setTimeout(r, 2000));
  }
  return printChecks(s);
}

async function printChecks(s) {
  const list = await checks(s);
  for (const c of list) console.log(`${c.ok ? "✓" : "✗"} ${c.label}${c.detail ? ` (${c.detail})` : ""}${c.ok || !c.fix ? "" : `\n    ${c.fix === "run the setup command" ? `bench setup ${s.path} --env ${s.env.name}` : c.fix}`}`);
  return list.every((c) => c.ok);
}

