#!/usr/bin/env python3
"""agent-rules — one set of rules for every agent Phil runs.

The rules live in ~/.dotfiles/CLAUDE.md and the topic files it imports (claude/*.md). Claude reads
them through its `@` imports; Codex reads ~/.codex/AGENTS.md, which this builds from the same files:
imports inlined, `<!-- claude-only -->` … `<!-- /claude-only -->` blocks dropped, codex/extra.md first.

  agent-rules            rebuild codex/AGENTS.md
  agent-rules --check    exit 1 when codex/AGENTS.md is stale, or a feedback memory carries no
                         disposition (promoted-to / scope: claude / kind: story / retired) — a rule
                         that lives only in memory reaches one agent
  agent-rules --link     point ~/.codex/AGENTS.md at codex/AGENTS.md (an existing plain file is kept
                         as AGENTS.md.before-agent-rules)
"""
import glob
import os
import re
import sys

DOT = os.path.expanduser("~/.dotfiles")
SPINE = os.path.join(DOT, "CLAUDE.md")
EXTRA = os.path.join(DOT, "codex", "extra.md")
OUT = os.path.join(DOT, "codex", "AGENTS.md")
CODEX = os.path.expanduser("~/.codex/AGENTS.md")
MEMORY = os.path.expanduser(os.environ.get("AGENT_RULES_MEMORY_GLOB", "~/.claude/projects/*/memory/feedback_*.md"))
DISPOSITIONS = re.compile(r"^\s*(promoted-to|scope|kind|retired)\s*:", re.M)
CLAUDE_ONLY = re.compile(r"<!-- claude-only -->.*?<!-- /claude-only -->\n?", re.S)
IMPORT = re.compile(r"^@(~?/\S+)\s*$", re.M)

HEADER = """<!-- GENERATED by ~/.dotfiles/scripts/agent-rules from ~/.dotfiles/CLAUDE.md and claude/*.md.
     Never edit this file: edit those sources, then run `agent-rules`. -->

"""


def read(path):
    with open(os.path.expanduser(path)) as f:
        return f.read()


def build():
    spine = IMPORT.sub(lambda m: read(m.group(1)).rstrip("\n") + "\n", read(SPINE))
    body = CLAUDE_ONLY.sub("", spine)
    return HEADER + read(EXTRA).rstrip("\n") + "\n\n" + body.rstrip("\n") + "\n"


def untagged():
    out = []
    for f in sorted(glob.glob(MEMORY)):
        head = read(f).split("\n---", 1)[0] if read(f).startswith("---") else ""
        if not DISPOSITIONS.search(head):
            out.append(f)
    return out


def check():
    bad = 0
    built = build()
    current = read(OUT) if os.path.exists(OUT) else ""
    if built != current:
        print("agent-rules: codex/AGENTS.md is stale — run `agent-rules`", file=sys.stderr)
        bad = 1
    if os.path.realpath(CODEX) != os.path.realpath(OUT):
        print(f"agent-rules: {CODEX} is not linked to {OUT} — run `agent-rules --link`", file=sys.stderr)
        bad = 1
    loose = untagged()
    if loose:
        print(f"agent-rules: {len(loose)} feedback memories carry no disposition (promote the rule, "
              "or tag scope: claude / kind: story / retired):", file=sys.stderr)
        for f in loose:
            print("  " + f, file=sys.stderr)
        bad = 1
    return bad


def link():
    if os.path.islink(CODEX):
        os.unlink(CODEX)
    elif os.path.exists(CODEX):
        os.replace(CODEX, CODEX + ".before-agent-rules")
    os.symlink(OUT, CODEX)
    print(f"{CODEX} -> {OUT}")


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--check":
        sys.exit(check())
    if arg in ("-h", "--help"):
        print(__doc__)
        return
    if arg not in ("", "--link"):
        sys.exit(f"agent-rules: unknown argument {arg!r} (see --help)")
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w") as f:
        f.write(build())
    print(f"wrote {OUT}")
    if arg == "--link":
        link()


if __name__ == "__main__":
    main()
