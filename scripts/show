#!/usr/bin/env bash
# show [<deck.json>…] — open decks as tabs in the one running Show app (no args: the newest deck in ~/.dotfiles/show),
# rebuilding it when Show.swift changes. Re-showing an open deck reloads it. show --build — just (re)build. show --snapshot <deck.json> <out.png> — render offscreen, no window.
# Deck format: ~/.dotfiles/.claude/skills/show/SKILL.md. Source: show-app/Show.swift. Sign-offs land in <deck>.signoff.json.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
src="$here/show-app/Show.swift"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/show"
app="$cache/Show.app"
stamp="$cache/source.sha"

build() {
  local sha
  sha="$(shasum -a 256 "$src" | cut -d' ' -f1)"
  if [[ -x "$app/Contents/MacOS/Show" && -f "$stamp" && "$(cat "$stamp")" == "$sha" ]]; then
    return
  fi
  mkdir -p "$app/Contents/MacOS"
  swiftc -O -swift-version 5 -target arm64-apple-macos14 -framework AppKit -framework WebKit "$src" -o "$app/Contents/MacOS/Show"
  cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>Show</string>
  <key>CFBundleIdentifier</key><string>com.philbrockman.show</string>
  <key>CFBundleName</key><string>Show</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>CFBundleDocumentTypes</key>
  <array><dict>
    <key>CFBundleTypeName</key><string>Show deck</string>
    <key>CFBundleTypeRole</key><string>Viewer</string>
    <key>LSHandlerRank</key><string>None</string>
    <key>LSItemContentTypes</key><array><string>public.json</string></array>
  </dict></array>
</dict>
</plist>
PLIST
  echo "$sha" > "$stamp"
}

case "${1:-}" in
  -h|--help)
    echo "usage: show [<deck.json>…] | show --build | show --snapshot <deck.json> <out.png>" >&2
    exit 64
    ;;
  --build)
    build
    echo "$app"
    ;;
  --snapshot)
    [[ $# -eq 3 ]] || { echo "usage: show --snapshot <deck.json> <out.png>" >&2; exit 64; }
    build
    "$app/Contents/MacOS/Show" "$2" --snapshot "$3"
    ;;
  *)
    if [[ $# -eq 0 ]]; then
      newest="$(ls -t "$HOME/.dotfiles/show/"*.json 2>/dev/null | grep -v '\.signoff\.json$' | head -1)"
      [[ -n "$newest" ]] || { echo "show: no decks in ~/.dotfiles/show" >&2; exit 66; }
      set -- "$newest"
    fi
    decks=()
    for arg in "$@"; do
      deck="$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")"
      [[ -f "$deck" ]] || { echo "show: no such deck: $arg" >&2; exit 66; }
      python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d["title"] and d["sections"] and all(s.get("body") or s.get("url") for s in d["sections"])' "$deck" \
        || { echo "show: $deck is not a deck (needs title + sections)" >&2; exit 65; }
      decks+=("$deck")
    done
    build
    open -a "$app" "${decks[@]}"
    ;;
esac
