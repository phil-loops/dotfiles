#!/usr/bin/env bash
# show [--focus] [<file.json>…] — hand files to the one Show window, each to its workspace (Forest ⌘1, Review ⌘2, Learn ⌘3, Runs ⌘4;
# no args: bring Show to the front, or start it back on the last workspace and documents), rebuilding it when any show-app/*.swift changes. Re-showing an open file reloads it.
# Show comes forward only when Phil asked: run from his terminal, or with --focus / SHOW_FOCUS=1 (a session whose user asked to
# see it now). From a Claude session otherwise it arrives — History (⌘Y), a rail badge, a notification — and nothing moves.
# show --api — the API workspace (⌘5): the loops-postman console, started when it isn't up.
# show --canopy [--focus] [/v2/…] — the Canopy workspace (⌘6): the forest viewer, at a page when given one.
# show --status <deck | /v2/…> — whether it's waiting, opened or dismissed, from Show's event log.
# show --build — just (re)build. show --snapshot <file.json> <out.png> [--appearance light|dark] — render the window offscreen, no window shown.
# show --selftest — drive the app's own offscreen window through every workspace on scratch fixtures; non-zero exit on a failed step.
# show --check-routing <file.json> — print the workspace a file opens in (and a forest's merge order). show --check-live <deck.json> — print a live deck's header, groups and compare diffs.
# show --tutor [<session.json>] — open the Tutor space on a session (no file: the newest in ~/.dotfiles/show/tutor). show --tutor-check <session.json> — print what it would show.
# Deck format: ~/.dotfiles/.claude/skills/show/SKILL.md. Source: show-app/*.swift (one file per area; main.swift holds the entry point), a Swift package that links canopy-native for the Canopy workspace. Sign-offs land in <deck>.signoff.json.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/show"
app="$cache/Show.app"
stamp="$cache/source.sha"

# Show builds from its own copy of the sources in $src, never the shared tree other sessions are editing: show-app as
# it stands (this lane's own work), and canopy-native as last committed — another lane's half-saved file never reaches
# Show's build, and only canopy commits rebuild (and relaunch) it. SHOW_CANOPY=worktree links the live canopy-native,
# for work on the seam between them (CanopyUI/Shell/Embed.swift).
src="$cache/src"

stage() {
  mkdir -p "$src/show-app" "$src/canopy-native"
  rsync -a --delete --exclude .build "$here/show-app/" "$src/show-app/"
  if [[ "${SHOW_CANOPY:-}" == worktree ]]; then
    rsync -a --checksum --delete --exclude .build "$here/canopy-native/" "$src/canopy-native/"
    return
  fi
  local head
  head="$(mktemp -d)"
  git -C "$here/.." archive HEAD scripts/canopy-native | tar -x -C "$head"
  # -a minus -t: an archive stamps every file with the commit's time, so copying times would mark the whole tree edited
  # and rebuild it all; a file is written only when its bytes differ, and only then does its time move
  rsync -rlpD --checksum --delete --exclude .build "$head/scripts/canopy-native/" "$src/canopy-native/"
  rm -rf "$head"
}

# One build at a time: a second launch waits for the first and then finds it current, and no launch restages the
# sources under a build that is reading them.
build() {
  mkdir -p "$cache"
  lockf -k "$cache/build.lock" "$here/show" --build-held >&2
}

# Incremental release: whole-module optimization recompiles all of CanopyUI for a one-line change (53s), and SwiftPM
# leaves -incremental off in release, so even per-file still rebuilt the whole module (18s); with it, 10s. --skip-update:
# the dependencies are pinned in Package.resolved, so asking their remotes for updates is ~2s of every build for nothing.
swiftbuild() { swift build -c release -Xswiftc -no-whole-module-optimization -Xswiftc -incremental --skip-update "$@"; }

build_held() {
  local sha
  stage
  # Show links canopy (its Canopy workspace), so a change on either side rebuilds
  sha="$(cd "$src" && { shasum -a 256 show-app/*.swift show-app/Package.swift; find canopy-native/Package.swift canopy-native/Sources -type f -print0 | sort -z | xargs -0 shasum -a 256; } | shasum -a 256 | cut -d' ' -f1)"
  if [[ -x "$app/Contents/MacOS/Show" && -f "$stamp" && "$(cat "$stamp")" == "$sha" ]]; then
    return
  fi
  echo "show: building…" >&2
  mkdir -p "$app/Contents/MacOS"
  (cd "$src/show-app" && swiftbuild --product Show >&2)
  local out
  out="$(cd "$src/show-app" && swiftbuild --show-bin-path)"
  mkdir -p "$app/Contents/Resources"
  # beside, then renamed in: a running Show keeps its own file (writing over it in place gets it
  # killed for an invalid code signature)
  cp "$out/Show" "$app/Contents/MacOS/Show.new"
  mv -f "$app/Contents/MacOS/Show.new" "$app/Contents/MacOS/Show"
  rm -rf "$app/Contents/Resources/canopy-native_CanopyUI.bundle"
  cp -R "$out/canopy-native_CanopyUI.bundle" "$app/Contents/Resources/"
  cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>Show</string>
  <key>CFBundleIdentifier</key><string>com.philbrockman.show</string>
  <key>CFBundleName</key><string>Show</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>CFBundleURLTypes</key>
  <array><dict>
    <key>CFBundleURLName</key><string>com.philbrockman.show.canopy</string>
    <key>CFBundleURLSchemes</key><array><string>canopy</string></array>
  </dict></array>
  <key>CFBundleDocumentTypes</key>
  <array><dict>
    <key>CFBundleTypeName</key><string>Show deck</string>
    <key>CFBundleTypeRole</key><string>Viewer</string>
    <key>LSHandlerRank</key><string>None</string>
    <key>LSItemContentTypes</key><array><string>public.json</string></array>
  </dict></array>
</dict>
</plist>
PLIST
  echo "$sha" > "$stamp"
}

# request <target-json>… — one inbox request per target ({"document": path} | {"canopy": route} | {"api": true}), handed to
# Show with open -g; Show alone decides whether to come forward. The actor is a session when a Claude session runs this
# (CLAUDECODE), else Phil; the intent is showNow for --focus or SHOW_FOCUS=1 (a session whose user asked to see it), else
# deliver: it waits in History with a notification and a badge, and nothing moves.
request() {
  local intent=deliver actor=phil session="" inbox="$cache/inbox" files=() n=0 target file
  [[ "$focus" == 1 || -n "${SHOW_FOCUS:-}" ]] && intent=showNow
  if [[ -n "${CLAUDECODE:-}" ]]; then
    actor=session
    session="${CLAUDE_CODE_SESSION_ID:0:8}"
  fi
  mkdir -p "$inbox"
  find "$inbox" -name '*.json' -mmin +1440 -delete 2>/dev/null || true
  for target in "$@"; do
    n=$((n + 1))
    file="$inbox/$(date +%s)-$$-$n.json"
    python3 -c 'import json, sys; json.dump({"target": json.loads(sys.argv[1]), "actor": sys.argv[2], "session": sys.argv[3] or None, "intent": sys.argv[4]}, open(sys.argv[5], "w"))' \
      "$target" "$actor" "$session" "$intent" "$file"
    files+=("$file")
  done
  open -g -a "$app" "${files[@]}"
}

document() { python3 -c 'import json, sys; print(json.dumps({"document": sys.argv[1]}))' "$1"; }

focus=0

case "${1:-}" in
  -h|--help)
    echo "usage: show [--focus] [<file.json>…] | show --api | show --canopy [--focus] [/v2/…] | show --status <deck | /v2/…> | show --build | show --snapshot <file.json> <out.png> [--appearance light|dark] | show --selftest | show --check-routing <file.json> | show --check-live <deck.json> | show --tutor [<session.json>] | show --tutor-check <session.json> | show --tutor-ask <session.json> <message>" >&2
    exit 64
    ;;
  --canopy)
    shift
    route=""
    for arg in "$@"; do
      if [[ "$arg" == "--focus" ]]; then focus=1; else route="$arg"; fi
    done
    build
    request "$(python3 -c 'import json, sys; print(json.dumps({"canopy": sys.argv[1]}))' "$route")"
    ;;
  --api)
    shift
    [[ "${1:-}" == "--focus" ]] && focus=1
    build
    request '{"api": true}'
    ;;
  --status)
    [[ $# -eq 2 ]] || { echo "usage: show --status <deck path | /v2/… route>" >&2; exit 64; }
    target="$2"
    [[ "$target" == /v2* || "$target" == canopy:* ]] || target="$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"
    python3 - "$target" "${SHOW_EVENTS:-$HOME/Library/Application Support/Show/events.jsonl}" <<'PY'
import json, sys
target, path = sys.argv[1], sys.argv[2]
want = {"canopy": target.removeprefix("canopy:")} if target.startswith(("/v2", "canopy:")) else {"document": target}
last = None
try:
    for line in open(path):
        event = json.loads(line)
        if event["target"] == want:
            last = event
except FileNotFoundError:
    pass
if last is None:
    print("never arrived or opened")
elif last["kind"] == "arrived":
    print(f"waiting since {last['at']} (not opened yet)")
else:
    print(f"{last['kind']} {last['at']}")
PY
    ;;
  --build)
    build
    echo "$app"
    ;;
  --build-held)
    build_held
    ;;
  --snapshot)
    [[ $# -eq 3 || ( $# -eq 5 && "$4" == "--appearance" && ( "$5" == "light" || "$5" == "dark" ) ) ]] \
      || { echo "usage: show --snapshot <deck.json> <out.png> [--appearance light|dark]" >&2; exit 64; }
    build
    "$app/Contents/MacOS/Show" "$2" --snapshot "$3" "${@:4}"
    ;;
  --selftest)
    build
    "$app/Contents/MacOS/Show" --selftest
    ;;
  --tutor)
    shift
    [[ "${1:-}" == "--focus" ]] && { focus=1; shift; }
    if [[ $# -ge 1 ]]; then
      session="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
    else
      # no file named: the user asked for the newest session, so it comes forward
      focus=1
      session="$(ls -t "$HOME/.dotfiles/show/tutor/"*.json 2>/dev/null | grep -v '\.answers\.json$' | head -1)"
      [[ -n "$session" ]] || { echo "show: no tutor sessions in ~/.dotfiles/show/tutor" >&2; exit 66; }
    fi
    [[ -f "$session" ]] || { echo "show: no such session: $session" >&2; exit 66; }
    python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d.get("mode", d.get("kind")) == "tutor" and d["title"] and isinstance(d["rungs"], list)' "$session" \
      || { echo "show: $session is not a tutor session (needs mode \"tutor\" + title + rungs)" >&2; exit 65; }
    build
    request "$(document "$session")"
    ;;
  --check-routing)
    [[ $# -eq 2 ]] || { echo "usage: show --check-routing <file.json>" >&2; exit 64; }
    build
    "$app/Contents/MacOS/Show" --check-routing "$2"
    ;;
  --check-live)
    [[ $# -eq 2 ]] || { echo "usage: show --check-live <deck.json>" >&2; exit 64; }
    build
    "$app/Contents/MacOS/Show" --check-live "$2"
    ;;
  --tutor-ask)
    [[ $# -eq 3 ]] || { echo "usage: show --tutor-ask <session.json> <message>" >&2; exit 64; }
    build
    "$app/Contents/MacOS/Show" --tutor-ask "$2" "$3"
    ;;
  --tutor-check)
    [[ $# -eq 2 ]] || { echo "usage: show --tutor-check <session.json>" >&2; exit 64; }
    build
    "$app/Contents/MacOS/Show" --tutor-check "$2"
    ;;
  *)
    args=()
    for arg in "$@"; do
      if [[ "$arg" == "--focus" ]]; then focus=1; else args+=("$arg"); fi
    done
    set -- ${args[@]+"${args[@]}"}
    if [[ $# -eq 0 ]]; then
      # A running Show comes to the front; a fresh one reopens the last workspace and each workspace's document.
      build
      open -a "$app"
      exit
    fi
    decks=()
    for arg in "$@"; do
      deck="$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")"
      [[ -f "$deck" ]] || { echo "show: no such deck: $arg" >&2; exit 66; }
      python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
if d.get("mode", d.get("kind")) == "tutor":
    assert d["title"] and isinstance(d["rungs"], list)
else:
    assert d["title"] and d["sections"] and all(s.get("body") or s.get("url") or d.get("mode") == "live" for s in d["sections"])
' "$deck" \
        || { echo "show: $deck is not a deck (needs title + sections) or a tutor session (mode \"tutor\" + title + rungs)" >&2; exit 65; }
      decks+=("$deck")
    done
    build
    targets=()
    for deck in "${decks[@]}"; do targets+=("$(document "$deck")"); done
    request "${targets[@]}"
    ;;
esac
