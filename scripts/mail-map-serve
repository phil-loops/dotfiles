#!/usr/bin/env python3
# mail-map-serve — serve the mail-pipeline map with a working "ask" box.
#
#   mail-map-serve [port]        default 62555; prints the URL, Ctrl-C to stop
#
# The map itself is a static page. The ask box needs a Claude that can READ the loops
# repo, which the blessing viewer already runs (POST :62497/chat → read-only `claude -p`
# in the branch's worktree, streamed as SSE). The browser can't call that directly: the
# viewer allows a localhost Origin but sends no Access-Control-Allow-Origin, so the
# response is unreadable cross-port. So this proxies /chat server-side — same origin from
# the page's view, and zero changes to the viewer.

import http.server
import json
import os
import socketserver
import sys
import urllib.error
import urllib.request

VIEWER = os.environ.get("STACK_VIEWER", "http://127.0.0.1:62497")
HERE = os.path.dirname(os.path.abspath(__file__))
PAGE = os.path.join(HERE, "mail-map.html")

SHELL = """<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
</head><body>
%s
</body></html>"""


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def do_GET(self):
        route = self.path.split("?")[0]
        if route == "/favicon.ico":
            self.send_response(204)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        if route not in ("/", "/index.html"):
            return self.send_error(404)
        try:
            with open(PAGE, "rb") as fh:
                body = (SHELL % fh.read().decode("utf-8")).encode("utf-8")
        except FileNotFoundError:
            return self.send_error(500, f"missing {PAGE}")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        if self.path != "/chat":
            return self.send_error(404)
        n = int(self.headers.get("Content-Length", 0) or 0)
        raw = self.rfile.read(n) if n else b"{}"
        req = urllib.request.Request(
            VIEWER + "/chat", data=raw, headers={"Content-Type": "application/json"}
        )
        try:
            upstream = urllib.request.urlopen(req, timeout=900)
        except urllib.error.URLError as exc:
            msg = json.dumps({"err": f"viewer at {VIEWER} unreachable: {exc}"})
            body = f"event: error\ndata: {msg}\n\n".encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return

        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        try:
            while True:
                chunk = upstream.read1(2048)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            upstream.close()

    def log_message(self, *args):
        pass


class Server(socketserver.ThreadingTCPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 62555
    with Server(("127.0.0.1", port), Handler) as httpd:
        print(f"mail map → http://localhost:{port}   (chat proxied to {VIEWER})")
        print("Ctrl-C to stop")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print()


if __name__ == "__main__":
    main()
