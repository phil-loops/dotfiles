#!/usr/bin/env python3
"""check-launchd-path <file>… — every launchd PATH declares /sbin and /usr/sbin.

launchd hands an agent exactly the PATH in its plist; a spawned script inherits that and has no
login shell to fill the gaps. md5 (/sbin) and lsof (/usr/sbin) are the two that bite: the first
exits 127, the second fails OPEN — an lsof that cannot run reports nothing listening. Run over
plists and over the scripts that generate them.
"""
import re
import sys

NEEDED = ("/sbin", "/usr/sbin")
PATH_LINE = re.compile(r"<key>PATH</key>\s*<string>([^<]*)</string>")
WATCHED = re.compile(r"(launchd/.*\.plist|\.plist)$|scripts/(restack-daemon|gh-review-notify)$")

bad = []
for path in sys.argv[1:]:
    if not WATCHED.search(path):
        continue
    try:
        with open(path) as f:
            body = f.read()
    except OSError:
        continue
    for declared in PATH_LINE.findall(body):
        dirs = declared.split(":")
        missing = [d for d in NEEDED if d not in dirs]
        if missing:
            bad.append(f"{path}: PATH is missing {', '.join(missing)}")

for line in bad:
    print(line, file=sys.stderr)
sys.exit(1 if bad else 0)
