#!/usr/bin/env python3
"""seed-gen-cache — a content-addressed store of generated tRPC types (.gen/trpc-types).

  seed-gen-cache restore <tree> <compiler>   materialize a stored emit for this tree's exact inputs:
                                             exit 0 restored, 1 no entry (build), 2 cache off/unusable
  seed-gen-cache insert  <tree> <compiler> <started>
                                             store the tree's fresh emit (a build that began at the
                                             mtime of file <started>); a no-op unless every input
                                             is older than that
  seed-gen-cache key <tree> [<compiler>]     the exact key of the emit the tree holds, with its
                                             outputs: seed-gen's "is .gen current" marker
  seed-gen-cache --stats | --gc [--json]

seed-gen calls restore before its emit and insert after a stamped build, so every consumer (gates,
the viewer's type trees, review scratch trees, worktrees, the donor) shares one store. Off with
SEED_GEN_CACHE=0; SEED_GEN_CACHE=audit never restores, builds, and checks what it built against
any entry for the same key (a mismatch evicts the entry and leaves a report in poison/) — the push
gates run this way. The store lives in SEED_GEN_CACHE_DIR (default ~/Library/Caches/seed-gen/gen),
bounded by SEED_GEN_CACHE_MB (default 1536) and SEED_GEN_CACHE_DAYS unused (default 14).

The key is everything the emit reads, as the compiler itself recorded it (the tsbuildinfo of a
previous build — ccache's "direct mode"): each input file's content, each package.json it read and
each one it probed and found missing, the physical side of the tree each file lives on, the npm
identity of each package it reached, the tree's resolution candidates (every source file name, the
packages' dist listings, node_modules/@types), the configs, the compiler's own files and seed-gen's.
A stored entry carries the graph it was built from; a tree hits only when that graph's every file
hashes identically in it — so it would read the very same files, and emit the same declarations.
Design, the counterexample per key part, and measurements: wiki loops/canopy-v2-gen-cache.
"""
import ctypes
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
import importlib.machinery
import importlib.util

HERE = os.path.dirname(os.path.realpath(__file__))
SCHEMA = b"seed-gen-cache-v1\0"
CACHE = os.environ.get("SEED_GEN_CACHE_DIR") or os.path.expanduser("~/Library/Caches/seed-gen/gen")
BUDGET = int(os.environ.get("SEED_GEN_CACHE_MB", "1536")) << 20
MAX_AGE = float(os.environ.get("SEED_GEN_CACHE_DAYS", "14")) * 86400
MAX_GRAPHS = 96
OUT = os.path.join(".gen", "trpc-types")
INFO = os.path.join(".gen", "trpc-types.tsbuildinfo")
PATH_FIELDS = ("fileNames", "packageJsons", "missingPackageJsons")


def _load_fingerprint():
    path = os.path.join(HERE, "seed-gen-fingerprint")
    loader = importlib.machinery.SourceFileLoader("seed_gen_fingerprint", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


fp = _load_fingerprint()

_libc = ctypes.CDLL("libc.dylib", use_errno=True) if sys.platform == "darwin" else None


def clone(src, dst):
    """APFS clonefile: copy-on-write, a directory hierarchy in one call. Falls back to a copy."""
    if _libc is not None and _libc.clonefile(os.fsencode(src), os.fsencode(dst), 0) == 0:
        return
    if os.path.isdir(src):
        shutil.copytree(src, dst, symlinks=True)
    else:
        shutil.copy2(src, dst)


def _sha_or_dash(path):
    try:
        return file_sha(path)
    except OSError:
        return "-"


def canon_digest(out):
    """The emit up to TS7's own nondeterminism: two builds of one tree differ in the order of
    synthesized `?: undefined` members (4-7 of ~2,600 files), so each declaration counts as its
    sorted lines and each map without its `mappings` — the bar test-lsp-differential holds .gen to."""
    d = hashlib.sha256()
    for dp, _dns, fns in sorted(os.walk(out)):
        for f in sorted(fns):
            p = os.path.join(dp, f)
            d.update(os.path.relpath(p, out).encode() + b"\0")
            raw = open(p, "rb").read()
            if f.endswith(".map"):
                try:
                    j = json.loads(raw)
                    j.pop("mappings", None)
                    raw = json.dumps(j, sort_keys=True).encode()
                except ValueError:
                    pass
            else:
                raw = b"\n".join(sorted(raw.split(b"\n")))
            d.update(raw + b"\0")
    return d.hexdigest()


def sha(data):
    return hashlib.sha256(data).hexdigest()


def file_sha(path):
    with open(path, "rb") as f:
        return sha(f.read())


# ── anchors: where a compiler-recorded path lives, independent of where the tree sits ──────────
#
# The tsbuildinfo records realpaths relative to .gen: in-tree files as ../lib/x.ts, but a borrowed
# package (an exploded view's per-entry link into the donor or a deps home) as the climb to its
# realpath, ../../../../Users/…/loops-donor/node_modules/zod/… — different for every tree depth and
# every home. An anchor names the file by what it is instead:
#   t    in the tree, outside node_modules
#   tnm  physically in the tree's own node_modules (the donor's; a tree-local prisma client)
#   hnm  physically in the home the tree borrows from (node_modules/.seed-gen-home), under there —
#        reached through the tree's links, or from inside the home itself (a home package's own
#        @prisma/client import lands on the home's copy, not the tree's)
#   abs  anything else, verbatim
# tnm and hnm stay distinct: the side of the tree a declaration's source sits on changes the emit
# (a symlinked .prisma emitted `user?: Prisma`, 2026-08-04).

class Where:
    def __init__(self, root):
        self.root = root
        self.gen = os.path.join(root, ".gen")
        try:
            home = open(os.path.join(root, "node_modules", ".seed-gen-home")).read().strip()
            self.home = os.path.realpath(home) if home else None
        except OSError:
            self.home = None


def anchor(w, name):
    if name.startswith("lib.") and "/" not in name:
        return ("lib", name)
    p = os.path.normpath(os.path.join(w.gen, name))
    low = p.lower()
    if low.startswith(w.root.lower() + "/"):
        rel = p[len(w.root) + 1:]
        if rel.lower().startswith("node_modules/"):
            return ("tnm", rel[len("node_modules/"):])
        return ("t", rel)
    if w.home and low.startswith(w.home.lower() + "/"):
        return ("hnm", p[len(w.home) + 1:])
    return ("abs", p)


def locate(w, kind, rel, real=True):
    """The path an anchor names in this tree, or None when the tree can't hold it on that side.
    `real`: the compiler recorded the file's realpath (anything it read) rather than the path it
    probed (a missing package.json), so a tnm file must physically be in the tree."""
    if kind == "t":
        return os.path.join(w.root, rel)
    if kind == "abs":
        return rel
    if kind == "hnm":
        return os.path.join(w.home, rel) if w.home else None
    p = os.path.join(w.root, "node_modules", rel)
    if real and not os.path.realpath(p).lower().startswith(w.root.lower() + "/"):
        return None
    return p


def spell(w, kind, rel, lower, real):
    """How this tree's compiler would record the anchor, relative to .gen."""
    if kind == "lib":
        return rel
    p = locate(w, kind, rel, real)
    if p is None:
        return None
    s = os.path.relpath(os.path.realpath(p) if real else p, w.gen)
    return s.lower() if lower else s


def anchored_graph(w, info):
    """The tsbuildinfo with every recorded path replaced by its anchor ([kind, rel, lowercased]).
    None if any path can't be re-spelled exactly in this same tree — then it can't be relocated."""
    out = {}
    for field in PATH_FIELDS:
        items = []
        for name in info.get(field) or []:
            kind, rel = anchor(w, name)
            for real in (True, False):
                lower = name == name.lower() and spell(w, kind, rel, False, real) != name
                if spell(w, kind, rel, lower, real) == name:
                    items.append([kind, rel, lower, real])
                    break
            else:
                return None
        out[field] = items
    return out


def relocate(w, info, graph):
    info = dict(info)   # the stored skeleton keeps each path field's place, as null
    for field in PATH_FIELDS:
        names = [spell(w, k, r, lo, real) for k, r, lo, real in graph[field]]
        if any(n is None for n in names):
            return None
        info[field] = names
    return info


# ── the key ───────────────────────────────────────────────────────────────────────────────────

def compiler_id(root, compiler):
    """Every file of the compiler as invoked: the typescript package (launcher + version) and the
    platform package holding the native binary and its lib.*.d.ts. None when it isn't a package.
    Memoized by the files' stat signatures — ctime included, which no rewrite can put back."""
    real = os.path.realpath(compiler)
    pkg = os.path.dirname(real)
    while pkg != "/" and not os.path.isfile(os.path.join(pkg, "package.json")):
        pkg = os.path.dirname(pkg)
    if pkg == "/":
        return None
    try:
        name = json.load(open(os.path.join(pkg, "package.json")))["name"]
    except (OSError, ValueError, KeyError):
        return None
    nm = os.path.dirname(os.path.dirname(pkg)) if name.startswith("@") else os.path.dirname(pkg)
    base = name.split("/")[-1]
    if name != "typescript" and not name.startswith("@typescript/"):
        return None                   # a shim (volta's) or a wrapper: not a compiler we can identify
    plat = os.path.join(nm, "@typescript", f"{base}-darwin-arm64" if sys.platform == "darwin" else f"{base}-linux-x64")
    files = []
    for top in (pkg, plat):
        for dp, dns, fns in os.walk(top):
            dns[:] = sorted(x for x in dns if x != "node_modules")
            files.extend((top, os.path.join(dp, f)) for f in sorted(fns))
    sig = hashlib.sha256(name.encode())
    for _top, p in files:
        st = os.stat(p)
        sig.update(f"{p}\0{st.st_size}\0{st.st_mtime_ns}\0{st.st_ctime_ns}\0{st.st_ino}\0".encode())
    sig = sig.hexdigest()
    memo = store("compilers", sig)
    try:
        return open(memo).read().strip()
    except OSError:
        pass
    d = hashlib.sha256(b"compiler\0" + name.encode() + b"\0")
    for top, p in files:
        d.update(os.fsencode(os.path.relpath(p, top)) + b"\0" + file_sha(p).encode())
    cid = d.hexdigest()
    try:
        os.makedirs(store("compilers"), exist_ok=True)
        write_atomic(memo, cid.encode())
    except OSError:
        pass
    return cid


def tool_id():
    d = hashlib.sha256(b"tool\0")
    for f in ("seed-gen", "seed-gen-fingerprint", "seed-gen-cache"):
        d.update(f.encode() + b"\0" + file_sha(os.path.join(HERE, f)).encode())
    return d.hexdigest()


def tree_names(root):
    """The tree's resolution candidates: every source-like file name the compiler could probe, and
    the packages' dist files, which git ignores (a dist/shared.ts would shadow shared.d.ts). The
    @types entries are in view()."""
    r = subprocess.run(["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
                       cwd=root, check=True, capture_output=True)
    names = sorted({os.fsdecode(n) for n in r.stdout.split(b"\0") if n})
    names = [n for n in names if n.endswith(fp.SOURCE_SUFFIXES) and os.path.lexists(os.path.join(root, n))]
    extra = []
    pk = os.path.join(root, "packages")
    for p in sorted(os.listdir(pk)) if os.path.isdir(pk) else []:
        dist = os.path.join(pk, p, "dist")
        for dp, dns, fns in os.walk(dist):
            dns.sort()
            extra.extend(os.path.relpath(os.path.join(dp, f), root) for f in sorted(fns))
    return names, extra


# The key's parts. `omit` exists for test-seed-gen-cache, which shows for each one a pair of trees
# that differ only in that part and emit differently — a cache keyed without it would cross them.
PARTS = ("compiler", "tool", "names", "listings", "configs", "contents", "pkgjson", "missing", "lock", "side", "view")


EXTENDS = re.compile(r'"extends"\s*:\s*("(?:[^"\\\\]|\\\\.)*"|\[[^\]]*\])')


def extended_configs(root, cfg, seen=None):
    """Configs a tsconfig extends from outside the tree (a package's tsconfig base), followed down
    their own chains — the in-tree ones are already among the hashed configs."""
    seen = set() if seen is None else seen
    try:
        m = EXTENDS.search(open(cfg).read())
    except OSError:
        return []
    if not m:
        return []
    specs = json.loads(m.group(1))
    out = []
    for spec in [specs] if isinstance(specs, str) else specs:
        if spec.startswith((".", "/")):
            cands = [os.path.normpath(os.path.join(os.path.dirname(cfg), spec))]
        else:
            cands = [os.path.join(root, "node_modules", spec)]
        cands = [c for base in cands for c in (base, base + ".json", os.path.join(base, "tsconfig.json"))]
        hit = next((c for c in cands if os.path.isfile(c)), None)
        if hit is None:
            out.append(cands[0])                     # unresolvable: its absence is part of the key
            continue
        real = os.path.realpath(hit)
        if real in seen:
            continue
        seen.add(real)
        if not real.lower().startswith(root.lower() + "/") or "/node_modules/" in real:
            out.append(hit)
        out.extend(extended_configs(root, hit, seen))
    return out


def view(root, home):
    """The tree's node_modules as the compiler walks it: each entry (scopes opened) and what it is —
    a real dir/file, or a link to the home, into the tree, or elsewhere. The graph records where
    files really were, not which link led there: a link retargeted (@loops/settings at another
    package) makes the compile read other files through an unchanged graph."""
    nm = os.path.join(root, "node_modules")
    out = []
    if os.path.islink(nm):
        return ["node_modules -> " + _place(root, home, os.path.normpath(os.path.join(root, os.readlink(nm))))]

    def one(rel):
        p = os.path.join(nm, rel)
        if os.path.islink(p):
            target = os.path.normpath(os.path.join(os.path.dirname(p), os.readlink(p)))
            out.append(f"{rel} -> {_place(root, home, target)}")
        elif os.path.isdir(p):
            out.append(f"{rel}/")
        else:
            out.append(rel)
    try:
        top = sorted(os.listdir(nm))
    except OSError:
        return []
    for e in top:
        if e.startswith(".seed-gen-") or e.startswith(".cache-probe"):
            continue
        one(e)
        p = os.path.join(nm, e)
        if e.startswith("@") and os.path.isdir(p) and not os.path.islink(p):
            for sub in sorted(os.listdir(p)):
                one(e + "/" + sub)
    return out


def _place(root, home, real):
    low = real.lower()
    if low.startswith(root.lower() + "/"):
        return "tree:" + real[len(root) + 1:]
    if home and low.startswith(home.lower() + "/"):
        return "home:" + real[len(home) + 1:]
    return "abs:" + real


class Keyer:
    """Hashes one tree's view of a graph; file digests are shared across the graphs it tries."""

    def __init__(self, root, compiler, omit=frozenset()):
        self.root = root
        self.where = Where(root)
        self.omit = omit
        self.memo = {}
        cid = compiler_id(root, compiler)
        if cid is None:
            raise LookupError("compiler is not an npm package")
        names, extra = tree_names(root)
        self.names, self.extra = names, extra
        d = hashlib.sha256(SCHEMA)
        if "compiler" not in omit:
            d.update(b"compiler\0" + cid.encode() + b"\0")
        if "tool" not in omit:
            d.update(b"tool\0" + tool_id().encode() + b"\0")
        for n in (names if "names" not in omit else []) + (extra if "listings" not in omit else []):
            d.update(os.fsencode(n) + b"\0")
        if "view" not in omit:
            for entry in view(root, self.where.home):
                d.update(b"view\0" + os.fsencode(entry) + b"\0")
        for n in names if "configs" not in omit else []:
            b = os.path.basename(n)
            if b == "package.json" or b.startswith(("tsconfig", "tsbase")):
                d.update(b"config\0" + os.fsencode(n) + b"\0" + self.digest(os.path.join(root, n)).encode())
                if b != "package.json":
                    for ext in extended_configs(root, os.path.join(root, n)):
                        d.update(b"extends\0" + os.fsencode(ext) + b"\0" + self.digest(ext).encode())
        self.base = d.hexdigest()
        self.locks = {}

    def prefetch(self, paths):
        """Hash in parallel what isn't hashed yet: reads and sha256 release the GIL, and four
        threads take a 5,000-file graph from 0.84 s to 0.22 s (2026-10-23)."""
        todo = list(dict.fromkeys(p for p in paths if p and p not in self.memo))
        with ThreadPoolExecutor(4) as ex:
            for p, h in zip(todo, ex.map(_sha_or_dash, todo)):
                self.memo[p] = h

    def digest(self, path):
        if path not in self.memo:
            try:
                self.memo[path] = file_sha(path)
            except OSError:
                self.memo[path] = "-"
        return self.memo[path]

    def lock_entry(self, kind, rel):
        """npm's record (version, resolved, integrity) of the package a node_modules file is in."""
        parts = rel.split("/")
        i, pkg = 0, []
        while i < len(parts) - 1:
            n = 2 if parts[i].startswith("@") else 1
            pkg += parts[i:i + n]
            i += n
            if i < len(parts) - 1 and parts[i] == "node_modules":
                pkg.append("node_modules")
                i += 1
            else:
                break
        key = "node_modules/" + "/".join(pkg)
        lock = self.locks.get(kind)
        if lock is None:
            nm = self.where.home if kind == "hnm" else os.path.join(self.root, "node_modules")
            try:
                lock = json.load(open(os.path.join(nm, ".package-lock.json"))).get("packages") or {}
            except (OSError, ValueError):
                lock = {}
            self.locks[kind] = lock
        e = lock.get(key) or {}
        return key, json.dumps([e.get("version"), e.get("resolved"), e.get("integrity"), e.get("link")])

    def key(self, graph):
        """The entry key for `graph` (anchored) as this tree holds it; None if it can't apply."""
        side = "side" not in self.omit
        self.prefetch(locate(self.where, k, r, re and side) for f in ("fileNames", "packageJsons")
                      for k, r, _lo, re in graph[f] if k != "lib")
        d = hashlib.sha256(self.base.encode())
        pkgs = set()
        for field in PATH_FIELDS:
            d.update(field.encode() + b"\0")
            for kind, rel, _lower, real in sorted(graph[field], key=lambda x: (x[0], x[1].lower(), x[3])):
                d.update(f"{kind}\0{rel.lower()}\0{int(real)}\0".encode())
                if kind == "lib":
                    continue
                p = locate(self.where, kind, rel, real and side)
                if p is None:
                    return None
                if field == "missingPackageJsons":
                    if os.path.exists(p) and "missing" not in self.omit:
                        return None
                    continue
                h = self.digest(p)
                if h == "-":
                    return None
                if ("contents" if field == "fileNames" else "pkgjson") not in self.omit:
                    d.update(h.encode() + b"\0")
                if kind in ("tnm", "hnm") and "lock" not in self.omit:
                    pkgs.add((kind,) + self.lock_entry(kind, rel))
        for kind, k, v in sorted(pkgs):
            d.update(f"npm\0{kind}\0{k}\0{v}\0".encode())
        return d.hexdigest()


# ── the store ─────────────────────────────────────────────────────────────────────────────────

def store(*parts):
    return os.path.join(CACHE, *parts)


def graph_id(graph):
    return sha(json.dumps(graph, sort_keys=True).encode())[:32]


def candidate_graphs():
    d = store("graphs")
    try:
        names = os.listdir(d)
    except OSError:
        return []
    paths = [os.path.join(d, n) for n in names if n.endswith(".json")]
    paths.sort(key=lambda p: -_mtime(p))
    return paths[:MAX_GRAPHS]


def tree_files(graph):
    """The graph's in-tree inputs, lowercased: it can only apply to a tree that has every one."""
    return sorted({r.lower() for k, r, _lo, _re in graph["fileNames"] if k == "t"})


def write_graph(gpath, graph):
    if not os.path.isfile(gpath[:-5] + ".t"):
        write_atomic(gpath[:-5] + ".t", "\n".join(tree_files(graph)).encode())
    if not os.path.isfile(gpath):
        write_atomic(gpath, json.dumps(graph, sort_keys=True).encode())


def _mtime(p):
    try:
        return os.stat(p).st_mtime
    except OSError:
        return 0


def _touch(p):
    try:
        os.utime(p)
    except OSError:
        pass


def write_atomic(path, data):
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, path)


def evict(entry, why):
    trash = store("trash", f"{os.path.basename(entry)}.{os.getpid()}.{time.time_ns()}")
    os.makedirs(store("trash"), exist_ok=True)
    try:
        os.rename(entry, trash)
    except OSError:
        return
    log(f"evicted {os.path.basename(entry)[:12]}: {why}")
    shutil.rmtree(trash, ignore_errors=True)


def log(line):
    try:
        os.makedirs(CACHE, exist_ok=True)
        with open(store("log"), "a") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%S ") + line + "\n")
    except OSError:
        pass


def lookup(root, compiler):
    """Try the most recently used graphs; each costs ~8 ms once the first has hashed the shared
    files, and a sidecar of its in-tree files skips, unread, every graph naming a file this tree
    lacks (a graph from a branch that added one) — the common miss then hashes nothing."""
    keyer = Keyer(root, compiler)
    have = {n.lower() for n in keyer.names + keyer.extra}
    for gpath in candidate_graphs():
        try:
            with open(gpath[:-5] + ".t") as f:
                need = f.read().split("\n")
            if not all(n in have or os.path.exists(os.path.join(root, n)) for n in need if n):
                continue
        except OSError:
            pass
        try:
            graph = json.load(open(gpath))
        except (OSError, ValueError):
            continue
        k = keyer.key(graph)
        if k and os.path.isdir(store("entries", k)):
            _touch(gpath)
            return k, graph
    return None, None


def verify(stage, manifest):
    """Every file the entry claims, byte for byte, and nothing else."""
    out = os.path.join(stage, "out")
    seen = 0
    for dp, _dns, fns in os.walk(out):
        for f in fns:
            p = os.path.join(dp, f)
            rel = os.path.relpath(p, out)
            if manifest["files"].get(rel) != file_sha(p):
                return f"{rel} differs from its manifest"
            seen += 1
    if seen != len(manifest["files"]):
        return f"{len(manifest['files']) - seen} files missing"
    if file_sha(os.path.join(stage, "tsbuildinfo.json")) != manifest["tsbuildinfo"]:
        return "tsbuildinfo differs from its manifest"
    return None


def restore(root, compiler):
    t0 = time.time()
    k, graph = lookup(root, compiler)
    t1 = time.time()
    if not k:
        log(f"miss {root} ({t1 - t0:.2f}s)")
        return 1
    entry = store("entries", k)
    gen = os.path.join(root, ".gen")
    if os.path.islink(gen):
        return 2                      # another tree's .gen, seen through a link: never write it
    os.makedirs(gen, exist_ok=True)
    for n in os.listdir(gen):         # seed-gen holds the tree's lock: any other stage is a crash's
        if n.startswith(".cache-stage."):
            shutil.rmtree(os.path.join(gen, n), ignore_errors=True)
    stage = os.path.join(gen, f".cache-stage.{os.getpid()}")
    try:
        clone(entry, stage)   # from here on the entry may be evicted; this copy is ours
    except OSError:
        return 1
    try:
        manifest = json.load(open(os.path.join(stage, "manifest.json")))
        bad = verify(stage, manifest) if manifest.get("key") == k else "manifest names another key"
    except (OSError, ValueError) as e:
        bad = f"unreadable: {e}"
    if bad:
        shutil.rmtree(stage, ignore_errors=True)
        evict(entry, bad)
        return 1
    info = relocate(Where(root), json.load(open(os.path.join(stage, "tsbuildinfo.json"))), graph)
    if info is None:
        shutil.rmtree(stage, ignore_errors=True)
        return 1
    _touch(os.path.join(entry, "manifest.json"))
    changed = apply(root, stage, manifest)
    write_atomic(os.path.join(root, INFO), json.dumps(info, separators=(",", ":")).encode())
    shutil.rmtree(stage, ignore_errors=True)
    log(f"hit {k[:12]} {root} lookup {t1 - t0:.2f}s apply {time.time() - t1:.2f}s ({changed} files changed)")
    print(f"{k[:12]} {changed}")
    return 0


def apply(root, stage, manifest):
    """Make .gen/trpc-types the entry's files (sync_dir: identical files untouched, so watchers and
    mtimes see only real changes). The stamp markers go first, so an interrupted apply reads as
    unstamped and the next sync rebuilds."""
    for m in (".seed-gen-output", ".seed-gen-inputs", ".seed-gen-sources"):
        try:
            os.unlink(os.path.join(root, ".gen", m))
        except OSError:
            pass
    return fp.sync_dir(os.path.join(stage, "out"), os.path.join(root, OUT))


def changed_since(root, graph, keyer, since):
    """The first input touched at or after `since`, or None. Covers what the key reads: input
    files and package.jsons (content), the source names and the listed dirs (resolution), and npm's
    hidden lockfile (rewritten by every install into the borrowed node_modules)."""
    def newer(p, follow=True):
        try:
            st = os.stat(p) if follow else os.lstat(p)
        except OSError:
            return True
        return max(st.st_mtime_ns, st.st_ctime_ns) >= since
    for field in ("fileNames", "packageJsons"):
        for kind, rel, _lower, real in graph[field]:
            if kind != "lib" and newer(locate(keyer.where, kind, rel, real) or "/nonexistent"):
                return rel
    for n in keyer.names:
        if newer(os.path.join(root, n), follow=False):
            return n
    dirs = [os.path.join(root, "node_modules", "@types")]
    pk = os.path.join(root, "packages")
    for p in os.listdir(pk) if os.path.isdir(pk) else []:
        for dp, _dns, _fns in os.walk(os.path.join(pk, p, "dist")):
            dirs.append(dp)
    for d in dirs:
        if os.path.isdir(d) and newer(d):
            return d
    lock = os.path.join(root, "node_modules", ".package-lock.json")
    if os.path.exists(lock) and newer(lock):
        return lock
    return None


def insert(root, compiler, started):
    """Store this tree's emit. The key is computed and the emit captured first, and only then is
    every input checked to predate the build's start: an input changed at any point from the
    compiler's first read to our last one means the capture may not describe what it read."""
    since = os.stat(started).st_mtime_ns
    info = json.load(open(os.path.join(root, INFO)))
    info = info.get("program", info)
    graph = anchored_graph(Where(root), info)
    if graph is None:
        log(f"skip {root}: tsbuildinfo paths don't relocate")
        return 2
    keyer = Keyer(root, compiler)
    k = keyer.key(graph)
    if k is None:
        log(f"skip {root}: graph doesn't hold in its own tree")
        return 2
    gid = graph_id(graph)
    gpath = store("graphs", gid + ".json")
    entry = store("entries", k)
    if os.path.isdir(entry):
        return audit(root, entry, k, keyer, graph, since, gpath)
    os.makedirs(store("entries"), exist_ok=True)
    os.makedirs(store("graphs"), exist_ok=True)
    tmp = store("entries", f".tmp.{os.getpid()}.{time.time_ns()}")
    try:
        os.makedirs(tmp)
        clone(os.path.join(root, OUT), os.path.join(tmp, "out"))
        skeleton = {f: (None if f in PATH_FIELDS else v) for f, v in info.items()}
        blob = json.dumps(skeleton, separators=(",", ":")).encode()
        write_atomic(os.path.join(tmp, "tsbuildinfo.json"), blob)
        stamped = open(os.path.join(root, ".gen", ".seed-gen-output")).read().strip()
        why = changed_since(root, graph, keyer, since)
        if why is None and fp.outputs_digest(os.path.join(tmp, "out")) != stamped:
            why = "the emit moved after its stamp"
        if why is not None:
            shutil.rmtree(tmp, ignore_errors=True)
            log(f"skip {root}: {why} changed during the build")
            return 2
        canon = canon_digest(os.path.join(tmp, "out"))
        files, size = {}, 0
        for dp, _dns, fns in os.walk(tmp):
            for f in fns:
                p = os.path.join(dp, f)
                size += os.stat(p).st_blocks * 512      # the budget counts disk, small files' blocks and all
                if dp.startswith(os.path.join(tmp, "out")):
                    files[os.path.relpath(p, os.path.join(tmp, "out"))] = file_sha(p)
                    os.chmod(p, 0o444)
        write_graph(gpath, graph)
        manifest = {"key": k, "graph": gid, "files": files, "canon": canon, "tsbuildinfo": sha(blob), "bytes": size + (256 << 10),
                    "created": time.time(), "head": _head(root), "tree": root}
        write_atomic(os.path.join(tmp, "manifest.json"), json.dumps(manifest).encode())
        # an entry appears whole or not at all; a concurrent writer of the same key loses the rename
        os.rename(tmp, entry)
    except (OSError, ValueError) as e:
        shutil.rmtree(tmp, ignore_errors=True)
        if not os.path.isdir(entry):
            log(f"skip {root}: {type(e).__name__}: {e}")
        return 0
    _touch(gpath)
    log(f"insert {k[:12]} {root} ({len(files)} files, {size >> 10} KiB)")
    gc(quiet=True)
    return 0


def audit(root, entry, k, keyer, graph, since, gpath):
    """A tree built what the store already holds: compare. Equal up to the emit's own nondeterminism
    is the expected case; anything else means the key missed something, and the entry is poison —
    evicted, and reported under poison/ so it is seen rather than silently rebuilt around."""
    why = changed_since(root, graph, keyer, since)
    if why is not None:
        return 2
    try:
        man = json.load(open(os.path.join(entry, "manifest.json")))
    except (OSError, ValueError):
        evict(entry, "unreadable manifest")
        return 0
    mine = canon_digest(os.path.join(root, OUT))
    if man.get("canon") == mine:
        _touch(gpath)
        _touch(os.path.join(entry, "manifest.json"))
        log(f"audit {k[:12]} {root}: equal")
        return 0
    os.makedirs(store("poison"), exist_ok=True)
    report = {"key": k, "entryHead": man.get("head"), "entryTree": man.get("tree"), "entryCreated": man.get("created"),
              "tree": root, "head": _head(root), "at": time.time()}
    write_atomic(store("poison", f"{k[:16]}.{int(time.time())}.json"), json.dumps(report, indent=1).encode())
    log(f"POISON {k[:12]}: stored from {str(man.get('head'))[:10]} in {man.get('tree')}, rebuilt differently from "
        f"{report['head'][:10]} in {root}")
    evict(entry, "poison")
    return 0


def _head(root):
    r = subprocess.run(["git", "-C", root, "rev-parse", "HEAD"], capture_output=True, text=True)
    return r.stdout.strip()


def entries():
    d = store("entries")
    out = []
    for k in os.listdir(d) if os.path.isdir(d) else []:
        if k.startswith("."):
            continue
        m = os.path.join(d, k, "manifest.json")
        try:
            man = json.load(open(m))
            out.append({"key": k, "bytes": man.get("bytes", 0), "used": _mtime(m), "graph": man.get("graph"),
                        "created": man.get("created", 0), "head": man.get("head")})
        except (OSError, ValueError):
            out.append({"key": k, "bytes": 0, "used": 0, "graph": None, "created": 0, "broken": True})
    return out


def gc(quiet=False):
    """LRU down to the budget, drop entries unused past the age cap, broken ones, stranded temps,
    and graphs no entry uses. Restores clone an entry before reading it, so evicting never pulls
    files from under a tree."""
    now = time.time()
    es = sorted(entries(), key=lambda e: -e["used"])
    keep, total, dropped = [], 0, 0
    for e in es:
        if e.get("broken") or now - e["used"] > MAX_AGE or total + e["bytes"] > BUDGET:
            evict(store("entries", e["key"]), "gc")
            dropped += 1
            continue
        keep.append(e)
        total += e["bytes"]
    for sub in ("entries", "trash"):
        d = store(sub)
        for n in os.listdir(d) if os.path.isdir(d) else []:
            p = os.path.join(d, n)
            if (sub == "trash" or n.startswith(".tmp.")) and now - _mtime(p) > 3600:
                shutil.rmtree(p, ignore_errors=True)
    d = store("compilers")
    for n in os.listdir(d) if os.path.isdir(d) else []:
        if now - _mtime(os.path.join(d, n)) > MAX_AGE:
            os.unlink(os.path.join(d, n))
    live = {e["graph"] for e in keep}
    d = store("graphs")
    for n in os.listdir(d) if os.path.isdir(d) else []:
        stem = n.rsplit(".", 1)[0]
        if n.endswith((".json", ".t")) and stem not in live and now - _mtime(os.path.join(d, n)) > 3600:
            os.unlink(os.path.join(d, n))
    try:
        lines = open(store("log")).read().splitlines()
        if len(lines) > 20000:
            write_atomic(store("log"), ("\n".join(lines[-10000:]) + "\n").encode())
    except OSError:
        pass
    if not quiet:
        print(f"kept {len(keep)} entries ({total >> 20} MiB of {BUDGET >> 20}), dropped {dropped}")
    return 0


def stats(as_json=False):
    es = entries()
    hits = misses = inserts = audits = 0
    try:
        for line in open(store("log")):
            w = line.split()
            if len(w) > 1:
                hits += w[1] == "hit"
                misses += w[1] == "miss"
                inserts += w[1] == "insert"
                audits += w[1] == "audit"
    except OSError:
        pass
    poison = sorted(os.listdir(store("poison"))) if os.path.isdir(store("poison")) else []
    graphs = len([n for n in os.listdir(store("graphs")) if n.endswith(".json")]) if os.path.isdir(store("graphs")) else 0
    s = {"dir": CACHE, "entries": len(es), "bytes": sum(e["bytes"] for e in es), "graphs": graphs,
         "budgetBytes": BUDGET, "hits": hits, "misses": misses, "inserts": inserts, "audits": audits, "poison": len(poison),
         "enabled": os.environ.get("SEED_GEN_CACHE", "1") != "0"}
    if as_json:
        print(json.dumps(s))
    else:
        rate = f"{100 * hits / (hits + misses):.0f}%" if hits + misses else "—"
        print(f"{CACHE}: {s['entries']} entries, {s['bytes'] >> 20} MiB of {BUDGET >> 20} MiB, {graphs} graphs; "
              f"{hits} hits / {misses} misses ({rate}), {inserts} inserts, {audits} audits"
              f"{'' if s['enabled'] else ' — OFF (SEED_GEN_CACHE=0)'}")
        for n in poison:
            print(f"  POISON: {store('poison', n)} — an entry rebuilt differently; the key misses an input")
    return 0


def tree_key(root, compiler):
    """The exact key of the emit .gen holds now — its own graph, keyed as an entry would be — plus
    the emitted files: seed-gen's .seed-gen-inputs, so "current" and "cached" mean the same inputs."""
    info = json.load(open(os.path.join(root, INFO)))
    info = info.get("program", info)
    graph = anchored_graph(Where(root), info)
    k = Keyer(root, compiler).key(graph) if graph is not None else None
    if k is None:
        raise ValueError("graph does not hold in this tree")
    return sha((k + "\0" + fp.output_key(root)).encode())


def main(argv):
    if argv[:1] == ["key"] and len(argv) in (2, 3):
        root = os.path.realpath(argv[1])
        try:
            print(tree_key(root, argv[2] if len(argv) == 3 and argv[2] else os.path.join(root, "node_modules/typescript/bin/tsc")))
            return 0
        except (LookupError, OSError, ValueError, KeyError, subprocess.CalledProcessError):
            return 1
    if argv[:1] == ["--stats"]:
        return stats("--json" in argv)
    if argv[:1] == ["--gc"]:
        return gc()
    mode = os.environ.get("SEED_GEN_CACHE", "1")
    if mode == "0":
        return 2
    try:
        if argv[:1] == ["restore"] and len(argv) == 3 and mode == "audit":
            return 2
        if argv[:1] == ["restore"] and len(argv) == 3:
            return restore(os.path.realpath(argv[1]), argv[2])
        if argv[:1] == ["insert"] and len(argv) == 4:
            return insert(os.path.realpath(argv[1]), argv[2], argv[3])
    except (LookupError, OSError, ValueError, KeyError, subprocess.CalledProcessError) as e:
        log(f"error {argv[0]} {argv[1] if len(argv) > 1 else ''}: {type(e).__name__}: {e}")
        return 2
    print(__doc__.split("\n\n")[1], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
