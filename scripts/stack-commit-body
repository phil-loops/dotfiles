#!/bin/zsh
# stack-commit-body — compose the default commit body for ONE branch of a forest: the author's own
# prose, then the project's plan (every step's job in merge order, this one marked, each step that
# already landed naming its PR). The plan comes from stack_facts.py, which owns every fact.
#
# Deliberately no Mermaid here. This repo has a PR template, so GitHub prefills a PR body from the
# TEMPLATE and never from the commit message — a diagram in a commit reaches git history and nothing
# else. The map lives in `stack-pr-body`, which is pasted into the PR.
#
#   stack-commit-body <branch>            → full body on stdout (author prose preserved)
#   stack-commit-body <branch> --section  → just the generated plan
#   stack-commit-body <branch> --apply    → rewrite the branch's unpushed tip commit to carry it
#
# Idempotent: the generated plan is replaced, never stacked up. --apply refuses to touch a commit
# that is already on a remote — shared history is never rewritten.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

here="${0:A:h}"
branch="${1:-}"
[[ -n "$branch" ]] || { echo "usage: stack-commit-body <branch> [--section|--apply]" >&2; exit 2; }
mode="${2:-}"

# the generated block is its own marker — regenerating replaces any line that opens with it
MARKER="Part of "

section=$(python3 "$here/stack_facts.py" plan "$branch")
[[ -n "$section" ]] || { echo "stack-commit-body: ${branch} is not in a project" >&2; exit 1; }

if [[ "$mode" == "--section" ]]; then
  print -r -- "$section"
  exit 0
fi

# The author's prose is whatever precedes the marker in the current commit body — preserved as-is.
# "-- forest --" was an earlier form's fence; drop it so regenerating an old body doesn't keep it.
# A body that is ONLY the generated plan leaves grep with no input, and grep exits 1 for
# "nothing selected" — under pipefail that killed the whole script, so the commits most in
# need of a refresh were the ones it silently refused to touch.
prose=$( { git log -1 --format=%b "$branch" \
  | awk -v m="$MARKER" 'index($0, m)==1 {exit} {print}' \
  | grep -vx -- "-- forest --" \
  | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}'; } || true )

body=""
[[ -n "$prose" ]] && body+="${prose}"$'\n\n'
body+="$section"

if [[ "$mode" != "--apply" ]]; then
  print -r -- "$body"
  exit 0
fi

# --apply: re-message the tip commit in place (tree, author and parents preserved), the same motion
# the viewer's message editor uses. Shared history is never rewritten.
tip=$(git rev-parse "$branch")
if git branch -r --contains "$tip" 2>/dev/null | grep -q .; then
  echo "stack-commit-body: ${branch}'s tip is already on a remote — refusing to rewrite it" >&2
  exit 1
fi
subject=$(git log -1 --format=%s "$branch")
msg="${subject}"$'\n\n'"${body}"

# Rewriting a tip reseats every child, so don't do it for a message that already matches —
# prepare-commit-msg seeds the plan at commit time, so usually it does.
if [[ "$(git log -1 --format=%B "$branch" | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}')" == "$msg" ]]; then
  print -r -- "${branch}: message already carries its plan — leaving ${tip:0:10} alone"
  exit 0
fi

new=$(print -r -- "$msg" | git commit-tree "${tip}^{tree}" $(git rev-parse "${tip}^@" | sed 's/^/-p /') )
git update-ref "refs/heads/${branch}" "$new" "$tip"
print -r -- "re-messaged ${branch}: ${tip:0:10} → ${new:0:10}"

# rewriting a tip moves the base its children were forked from — they must be reseated.
kids=$( (git config --get-regexp '^stack-branch\..*\.parent$' 2>/dev/null || true) \
  | awk -v p="$branch" '$2==p{sub(/^stack-branch\./,"",$1); sub(/\.parent$/,"",$1); print $1}')
[[ -n "$kids" ]] && print -r -- "restack these onto it — they still sit on the old tip:\n${kids}"
