#!/bin/zsh
# Rewrites copied Loops links for the audience you share with (menu bar, or `tailnet-link-clip audience external|internal`).
# external: tailnet → app.loops.so; internal: app.loops.so → tailnet. /admin always stays on the tailnet.
set -euo pipefail
src=${0:A:h}/tailnet-link-clip.swift
bin=$HOME/.cache/tailnet-link-clip/tailnet-link-clip
if [[ ! -x $bin || $src -nt $bin ]]; then
  mkdir -p ${bin:h}
  swiftc -O -o $bin.tmp $src
  mv $bin.tmp $bin
fi
exec $bin "$@"
