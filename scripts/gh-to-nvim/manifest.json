{
  "manifest_version": 3,
  "name": "GitHub → nvim",
  "version": "0.1.0",
  "description": "Route GitHub PR files/lines into the local forest viewer's warm nvim.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*"],
  "icons": {
    "16": "icons/fresh-16.png",
    "32": "icons/fresh-32.png",
    "48": "icons/fresh-48.png",
    "128": "icons/fresh-128.png"
  },
  "action": {
    "default_title": "GitHub → nvim",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/fresh-16.png",
      "32": "icons/fresh-32.png",
      "48": "icons/fresh-48.png",
      "128": "icons/fresh-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" }
}
