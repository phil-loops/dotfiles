{
  "manifest_version": 3,
  "name": "GitHub → nvim",
  "version": "0.2.0",
  "description": "Open the current GitHub page (PR / blob / commit) in the local forest viewer's warm nvim. URL-only: no page access.",
  "permissions": ["storage", "nativeMessaging", "activeTab", "notifications"],
  "host_permissions": ["http://localhost/*"],
  "key": "",
  "icons": {
    "16": "icons/fresh-16.png",
    "32": "icons/fresh-32.png",
    "48": "icons/fresh-48.png",
    "128": "icons/fresh-128.png"
  },
  "action": {
    "default_title": "GitHub → nvim",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/fresh-16.png",
      "32": "icons/fresh-32.png",
      "48": "icons/fresh-48.png",
      "128": "icons/fresh-128.png"
    }
  },
  "commands": {
    "open-in-nvim": {
      "suggested_key": { "default": "Ctrl+Shift+O", "mac": "Command+Shift+O" },
      "description": "Open this GitHub page in nvim (selected line, else whole-PR Diffview)"
    },
    "open-in-viewer": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Open this PR in the forest viewer"
    }
  },
  "background": { "service_worker": "background.js" }
}
