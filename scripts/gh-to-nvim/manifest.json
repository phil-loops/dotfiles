{
  "manifest_version": 3,
  "name": "GitHub → canopy",
  "version": "0.3.28",
  "description": "Open the GitHub PR you're on in canopy at the line you selected, or the page's file in Helix. URL-only: no page access.",
  "permissions": [
    "management",
    "storage",
    "nativeMessaging",
    "activeTab",
    "tabs",
    "notifications",
    "declarativeContent",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/fresh-16.png",
    "32": "icons/fresh-32.png",
    "48": "icons/fresh-48.png",
    "128": "icons/fresh-128.png"
  },
  "action": {
    "default_title": "GitHub → canopy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/fresh-16.png",
      "32": "icons/fresh-32.png",
      "48": "icons/fresh-48.png",
      "128": "icons/fresh-128.png"
    }
  },
  "commands": {
    "open-in-nvim": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open this GitHub page's file in Helix (the selected line, else the whole PR)"
    },
    "open-in-viewer": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open this PR in canopy, at the selected line"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "update_url": "http://localhost:62530/dist/updates.xml"
}
