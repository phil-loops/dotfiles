+    pub fn draft_save_matches(&self, uri: &Url) -> bool {
+        self.capabilities
+            .get()
+            .and_then(|value| value.experimental.as_ref())
+            .and_then(|value| value.get("canopyDraftSave"))
+            .is_some_and(|value| {
+                value["protocol"].as_u64() == Some(1)
+                    && value["uri"].as_str() == Some(uri.as_str())
+                    && value["generation"].as_str().is_some()
+                    && value["revision"].as_u64().is_some()
+            })
+    }
+
+    pub async fn accept_draft_save(
+        &self,
+        uri: &Url,
+        text: &Rope,
+        document_version: i32,
+        mode: &str,
+    ) -> anyhow::Result<()> {
+        use crate::draft_save::{validate_receipt, AcceptDraftSave};
+        use serde_json::json;
+
+        anyhow::ensure!(
+            self.draft_save_matches(uri),
+            "draft save bridge is unavailable"
+        );
+        let config = &self
+            .capabilities
+            .get()
+            .unwrap()
+            .experimental
+            .as_ref()
+            .unwrap()["canopyDraftSave"];
+        let generation = config["generation"].as_str().unwrap();
+        let operation = format!("{generation}:{document_version}:{mode}:{}", uri.as_str());
+        let text = text.to_string();
+        let mut state = self.draft_save.lock().await;
+        if let Some(pending) = state.pending.clone() {
+            if pending["operation"].as_str() == Some(&operation) {
+                anyhow::ensure!(
+                    pending["text"] == text && pending["mode"] == mode,
+                    "the pending save operation changed"
+                );
+            }
+            let receipt = self.call::<AcceptDraftSave>(pending.clone()).await?;
+            state.revision = Some(validate_receipt(&pending, &receipt)?);
+            state.pending = None;
+            state.completed = Some(pending.clone());
+            if pending["operation"].as_str() == Some(&operation) {
+                return Ok(());
+            }
+        }
+        if let Some(completed) = state.completed.clone() {
+            if completed["operation"].as_str() == Some(&operation) {
+                anyhow::ensure!(
+                    completed["text"] == text && completed["mode"] == mode,
+                    "the completed save operation changed"
+                );
+                state.pending = Some(completed.clone());
+                let receipt = self.call::<AcceptDraftSave>(completed.clone()).await?;
+                state.revision = Some(validate_receipt(&completed, &receipt)?);
+                state.pending = None;
+                return Ok(());
+            }
+        }
+        let revision = *state
+            .revision
+            .get_or_insert(config["revision"].as_u64().unwrap());
+        let payload = json!({
+            "generation": generation, "operation": operation,
+            "expectedRevision": revision, "documentVersion": document_version,
+            "uri": uri, "text": text, "mode": mode,
+        });
+        state.pending = Some(payload.clone());
+        let receipt = self.call::<AcceptDraftSave>(payload.clone()).await?;
+        state.revision = Some(validate_receipt(&payload, &receipt)?);
+        state.pending = None;
+        state.completed = Some(payload);
+        Ok(())
+    }
