diff --git a/helix-lsp/src/draft_save.rs b/helix-lsp/src/draft_save.rs
new file mode 100644
index 0000000..1862876
--- /dev/null
+++ b/helix-lsp/src/draft_save.rs
@@ -0,0 +1,59 @@
+use crate::lsp;
+use serde_json::Value;
+
+#[derive(Debug, Default)]
+pub(crate) struct DraftSaveState {
+    pub revision: Option<u64>,
+    pub pending: Option<Value>,
+    pub completed: Option<Value>,
+}
+
+pub(crate) enum AcceptDraftSave {}
+
+impl lsp::request::Request for AcceptDraftSave {
+    type Params = Value;
+    type Result = Value;
+    const METHOD: &'static str = "canopy/draft/acceptSave";
+}
+
+pub(crate) fn validate_receipt(payload: &Value, receipt: &Value) -> anyhow::Result<u64> {
+    let revision = payload["expectedRevision"]
+        .as_u64()
+        .and_then(|value| value.checked_add(1))
+        .ok_or_else(|| anyhow::anyhow!("invalid draft save revision"))?;
+    if receipt["generation"] != payload["generation"]
+        || receipt["operation"] != payload["operation"]
+        || receipt["acceptedText"] != payload["text"]
+        || receipt["mode"] != payload["mode"]
+        || receipt["revision"].as_u64() != Some(revision)
+    {
+        anyhow::bail!("draft save acknowledgement does not match the submitted bytes");
+    }
+    Ok(revision)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn draft_save_receipt_requires_the_exact_operation_bytes_mode_and_revision() {
+        let payload = json!({"generation":"owner-a", "operation":"save-a", "expectedRevision":0,
+                             "text":"saved bytes", "mode":"100644"});
+        let receipt = json!({"generation":"owner-a", "operation":"save-a", "revision":1,
+                             "acceptedText":"saved bytes", "mode":"100644"});
+        assert_eq!(validate_receipt(&payload, &receipt).unwrap(), 1);
+        for (field, value) in [
+            ("generation", json!("old-owner")),
+            ("operation", json!("other")),
+            ("revision", json!(2)),
+            ("acceptedText", json!("other bytes")),
+            ("mode", json!("100755")),
+        ] {
+            let mut changed = receipt.clone();
+            changed[field] = value;
+            assert!(validate_receipt(&payload, &changed).is_err(), "{field}");
+        }
+    }
+}
