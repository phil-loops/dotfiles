#!/bin/zsh
# stack-purpose — the "what's the point" of a branch.
#
# The authoritative source is git's NATIVE branch description
# (git config branch.<name>.description) — so git owns it, it travels with the
# repo's config, and it's free to read. You set it intentionally when you create
# or edit a branch (`loops purpose <branch> "..."` or `git branch --edit-description`).
#
# Generation is OPT-IN and never automatic: it only runs with --generate, and it
# produces a *suggestion* (haiku) you can choose to save as the description.
#
#   stack-purpose <branch>                 read-only — description, else a cached
#       suggestion matching current content, else nothing. NO LLM, NO tokens.
#   stack-purpose --generate <branch>      description if set, else LLM-suggest +
#       cache. The only path that spends tokens, and only on explicit ask.
#   stack-purpose --set "<text>" <branch>  write the branch description (git-managed).
#
# Output: {"thesis","enables","source":"description|cache|generated|none"}
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

branch=""; gen=0; set_text=""; have_set=0
while (( $# )); do
  case "$1" in
    --generate) gen=1; shift;;
    --set) set_text="$2"; have_set=1; shift 2;;
    *) branch="$1"; shift;;
  esac
done
[[ -n "$branch" ]] || { echo "usage: stack-purpose [--generate] [--set <text>] <branch>" >&2; exit 2; }

# --set: hand it to git (the native branch description)
if (( have_set )); then
  if [[ -n "$set_text" ]]; then
    git config "branch.${branch}.description" "$set_text"
  else
    git config --unset "branch.${branch}.description" 2>/dev/null || true
  fi
  jq -n --arg t "$set_text" '{thesis:$t, enables:"", source:"description"}'; exit 0
fi

# 1) the branch description — git-managed, free, authoritative
desc=$(git config "branch.${branch}.description" 2>/dev/null || true)
if [[ -n "$desc" ]]; then
  jq -n --arg t "$desc" '{thesis:$t, enables:"", source:"description"}'; exit 0
fi

parent=$(git config "stack-branch.${branch}.parent" 2>/dev/null || true)
[[ -n "$parent" ]] || parent=$(git config stack.main-branch 2>/dev/null || echo main)
git_dir=$(git rev-parse --path-format=absolute --git-common-dir)
ledger="$git_dir/stack-purpose.json"
[[ -f "$ledger" ]] || echo '{}' > "$ledger"

# 2) a cached suggestion still matching the current content (free)
sig=$(git diff "${parent}...${branch}" | git hash-object --stdin)
hit=$(jq -c --arg b "$branch" --arg s "$sig" \
  'if (.[$b].sig == $s) then {thesis:.[$b].thesis, enables:.[$b].enables, source:"cache"} else empty end' "$ledger")
if [[ -n "$hit" ]]; then echo "$hit"; exit 0; fi

# 3) nothing yet — do NOT spend tokens unless explicitly asked
if (( ! gen )); then
  jq -n '{thesis:"", enables:"", source:"none"}'; exit 0
fi

# 4) generate a suggestion (opt-in, the only token path)
diff="$(git diff "${parent}...${branch}")"; diff="${diff[1,12000]}"
children=$(git config --get-regexp '^stack-branch\..*\.parent$' 2>/dev/null \
  | awk -v p="$branch" '$2==p{sub(/^stack-branch\./,"",$1); sub(/\.parent$/,"",$1); print $1}' | paste -sd', ' -)

read -r -d '' prompt <<EOF || true
You are summarizing one branch in a stacked-PR series for a teammate skimming a dependency graph.
Branch: ${branch}  (parent: ${parent})
Branches that build directly on it: ${children:-none (this is a leaf)}

From the diff below, return STRICT JSON and nothing else:
{"thesis": "...", "enables": "..."}
- thesis: ONE plain sentence — what this branch does / why it exists. No filler, no "this branch".
- enables: a SHORT phrase for what it lays the foundation for, informed by the branches that build on it. Empty string "" if it's a leaf.

DIFF:
${diff}
EOF

resp=$(claude -p --model haiku "$prompt" 2>/dev/null || true)
obj=$(printf '%s' "$resp" | python3 -c 'import sys,re; m=re.search(r"\{.*\}", sys.stdin.read(), re.S); print(m.group(0) if m else "")' || true)
if ! printf '%s' "$obj" | jq -e '.thesis' >/dev/null 2>&1; then
  obj='{"thesis":"(could not summarize)","enables":""}'
fi
thesis=$(printf '%s' "$obj" | jq -r '.thesis')
enables=$(printf '%s' "$obj" | jq -r '.enables // ""')

tmp=$(mktemp)
jq --arg b "$branch" --arg s "$sig" --arg t "$thesis" --arg e "$enables" \
  '.[$b]={sig:$s, thesis:$t, enables:$e}' "$ledger" > "$tmp" && mv "$tmp" "$ledger"
jq -n --arg t "$thesis" --arg e "$enables" '{thesis:$t, enables:$e, source:"generated"}'
