#!/usr/bin/env bash
set -euo pipefail
# restack-daemon — ambient trunk watcher (Phase 3), DRY-RUN by default, --apply to act.
#
# Watches origin/main and, ONLY when its tip SHA changes (event-driven — fires at the
# merge rate, never a poll-thrash), runs restack-dryrun and writes a shared state file
# the viewer reads for its status chip / will-conflict badges. Without --apply it MOVES
# NOTHING. With --apply it self-heals the CLEAN cases and parks conflicts as badges.
#
#   restack-daemon                 loop: poll trunk, re-classify on every tip change
#   restack-daemon --apply         also auto-run the restack: contract merged ghosts +
#                                  rebase the clean cases (stack-restack-all --no-claude,
#                                  LOCAL refs only — never pushes), leaving real conflicts
#                                  PARKED as a badge. Opt-in; try `--apply --once` first.
#   restack-daemon --contract      the SAFE subset of --apply: auto-DROP already-merged
#                                  ghosts + rewire their children's parent (pure metadata,
#                                  no rebase → nothing can conflict, no working tree touched),
#                                  leaving the children's rebase-forward PARKED as would-restack
#                                  for a human's ▸ ready button. The middle tier: dry-run < contract < apply.
#   restack-daemon --once          single pass (cron / manual refresh), then exit
#   restack-daemon --interval N    seconds between trunk polls (default 60)
#   restack-daemon --status        print the current state file and exit
#   restack-daemon --stop          signal a running daemon to exit
#   restack-daemon [--apply] install    run it ambiently via launchd (bakes --apply in)
#   restack-daemon uninstall       stop + remove the launchd agent
#
# On every trunk move it also names WHAT merged: squash subjects carry "(#N)", so the
# PR numbers parse locally from old-tip..new-tip; one gh call enriches (title, author,
# whose) and a macOS notification fires — loud when one of YOUR PRs landed, quiet
# otherwise. Best-effort: no gh / offline → numbers only; never blocks the classify.
# The move also fast-forwards the LOCAL main ref (stale-main is the real signal) —
# skipped with a log line if main is checked out in some worktree.
#
# State (under the common git dir, so all worktrees share it):
#   restack-ambient.json   { mode, at, pid, interval, trunk_tip, report:{…dryrun…} }
#   restack-merges.json    { at, from, to, direct, prs:[{number,title,branch,author,mine,mergedAt}] }
#   restack-ambient.log    one summary line per re-classify
#   restack-ambient.pid    running loop's pid (single-instance guard)
#
# NB: launchd runs us as `/bin/bash <self>`, and macOS /bin/bash is the ONLY bash here (3.2.57).
# Stay 3.2-clean: no associative arrays, no ${x^^}/${x,,}, no mapfile/readarray. `scripts/check-bash32`
# enforces this (bash -n can't — bash-4 builtins parse fine on 3.2, they only fail at runtime).

here="$(cd "$(dirname "$0")" && pwd)"
dryrun="$here/restack-dryrun"
MAIN="$(git config stack.main-branch 2>/dev/null || echo main)"
interval=60
mode="loop"
apply=0   # opt-in: --apply auto-runs the (proven, local-only, conflict-parking) restack
contract=0  # opt-in: --contract auto-drops merged ghosts only (metadata, no rebase); < --apply
[[ -x "$dryrun" ]] || { echo "restack-daemon: restack-dryrun not found next to this script" >&2; exit 2; }

while (( $# )); do
  case "$1" in
    --once)     mode="once"; shift ;;
    --status)   mode="status"; shift ;;
    --stop)     mode="stop"; shift ;;
    install)    mode="install"; shift ;;
    uninstall)  mode="uninstall"; shift ;;
    --apply)    apply=1; shift ;;
    --contract) contract=1; shift ;;
    --interval) interval="${2:-}"; shift 2 ;;
    -h|--help)  sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "restack-daemon: unknown arg $1" >&2; exit 2 ;;
  esac
done
[[ "$interval" =~ ^[0-9]+$ ]] && (( interval > 0 )) || { echo "restack-daemon: --interval must be a positive integer" >&2; exit 2; }

gd="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || { echo "restack-daemon: not a git repo" >&2; exit 2; }
state="$gd/restack-ambient.json"
log="$gd/restack-ambient.log"
pidf="$gd/restack-ambient.pid"

# one human-readable tier label, reused by install / status / start-log. --apply is the
# superset (it contracts too), so it wins the label even when --contract is also passed.
if   (( apply ));    then tier="apply";    mode_desc="APPLY — auto-restacks clean cases, parks conflicts"
elif (( contract )); then tier="contract"; mode_desc="CONTRACT — auto-drops merged ghosts, parks rebases"
else                      tier="dry-run";  mode_desc="DRY-RUN — moves nothing"
fi

now() { date +%s; }
logline() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$log"; }

# ---- merge attribution: trunk moved → which PRs, and were any mine? ----
merges_state="$gd/restack-merges.json"
me_login=""
my_login() {
  [[ -n "$me_login" ]] || me_login="$(gh api user -q .login 2>/dev/null || echo '?')"
  [[ "$me_login" == "?" ]] || printf '%s' "$me_login"
}
notify() {
  command -v osascript >/dev/null 2>&1 || return 0
  osascript -e "display notification \"${2//\"/\\\"}\" with title \"${1//\"/\\\"}\" sound name \"Glass\"" 2>/dev/null || true
}
attribute_merges() {
  local old="$1" new="$2" slug subjects nums direct n
  [[ -n "$old" && -n "$new" && "$old" != "$new" ]] || return 0
  n="$(git rev-list --count "$old..$new" 2>/dev/null || echo 0)"
  [[ "$n" =~ ^[0-9]+$ ]] && (( n > 0 )) || return 0
  if (( n > 200 )); then
    logline "merges: ${old:0:9}..${new:0:9} is $n commits — baseline too old, skipped"; return 0
  fi
  slug="$(git remote get-url origin 2>/dev/null | sed -E 's#^(git@github\.com:|https://github\.com/)##; s#\.git$##')"
  subjects="$(git log --format='%s' "$old..$new" 2>/dev/null)"
  [[ -n "$subjects" ]] || return 0
  nums="$(grep -oE '\(#[0-9]+\)$' <<<"$subjects" | tr -cd '0-9\n' | sort -un | paste -s -d, -)"
  direct="$(grep -cvE '\(#[0-9]+\)$' <<<"$subjects" || true)"
  local merged='[]' prs='[]'
  if [[ -n "$nums" ]] && command -v gh >/dev/null 2>&1; then
    merged="$(gh pr list --repo "$slug" --state merged --limit 50 \
      --json number,title,author,headRefName,mergedAt 2>/dev/null || echo '[]')"
  fi
  prs="$(jq -n --argjson want "[${nums:-}]" --argjson merged "$merged" --arg me "$(my_login || true)" '
    [ $want[] as $n |
      (first($merged[] | select(.number == $n)) // {number: $n}) |
      { number: $n, title: (.title // null), branch: (.headRefName // null),
        author: (.author.login // null), mergedAt: (.mergedAt // null),
        mine: (if (.author != null and $me != "") then (.author.login == $me) else null end) } ]' \
    2>/dev/null || echo '[]')"
  local tmp="$merges_state.tmp.$$"
  jq -n --arg from "$old" --arg to "$new" --argjson at "$(now)" \
    --argjson prs "$prs" --argjson direct "${direct:-0}" \
    '{at:$at, from:$from, to:$to, direct:$direct, prs:$prs}' > "$tmp" && mv "$tmp" "$merges_state"
  local total mine_ct
  total="$(jq 'length' <<<"$prs")"
  mine_ct="$(jq '[.[] | select(.mine == true)] | length' <<<"$prs")"
  logline "trunk moved (+$n commits): $total PR(s), $mine_ct mine, ${direct:-0} direct $(jq -r '[.[] | "#\(.number)"] | join(" ")' <<<"$prs")"
  # The trunk-move event (merges_state above) is what the viewer needs, and it's
  # already written. Desktop notifications are for ME: ping when one of MY PRs lands;
  # a plain "main moved" (someone else's merge) is app state, not a popup — stay quiet.
  if (( mine_ct > 0 )); then
    notify "🎉 Your PR merged" "$(jq -r '[.[] | select(.mine == true) | "#\(.number) " + (.title // "")] | join(" · ")' <<<"$prs")"
  fi
}

# A trunk move is also the signal that the LOCAL main ref went stale. Fast-forward it so
# viewer diffs read against true main, not yesterday's (pure ref move — git itself refuses
# if main is checked out in some worktree, in which case we log and leave it alone).
refresh_local_main() {
  local tip="$1" cur
  cur="$(git rev-parse --verify --quiet "refs/heads/$MAIN" || echo "")"
  [[ -n "$cur" && -n "$tip" && "$cur" != "$tip" ]] || return 0
  if git branch -f "$MAIN" "$tip" >/dev/null 2>&1; then
    logline "local $MAIN refreshed ${cur:0:9} → ${tip:0:9}"
  else
    logline "local $MAIN stale (${cur:0:9} → ${tip:0:9}) but checked out — left alone"
  fi
}

child=""   # pid of the in-flight restack-dryrun, so --stop can kill a slow --deep pass

# wrap restack-dryrun --json with daemon metadata, write atomically (tmp + mv in the
# same dir so the viewer never reads a half-written file). The dryrun runs as a tracked
# background child: a full --deep pass over 100+ branches takes minutes, and a daemon you
# can't stop mid-pass is worse than no daemon — the TERM trap kills $child.
reclassify() {
  local pid="$1" reportf="$state.report.$$" tmp rc
  "$dryrun" --no-fetch --json > "$reportf" 2>/dev/null &
  child=$!
  set +e; wait "$child"; rc=$?; set -e
  child=""
  if (( rc != 0 )); then
    rm -f "$reportf"; logline "reclassify FAILED/interrupted (rc=$rc)"; return 1
  fi
  tmp="$state.tmp.$$"
  jq --slurpfile r "$reportf" -n --arg mode "dry-run" --arg tier "$tier" \
    --argjson at "$(now)" --argjson interval "$interval" \
    --arg pid "$pid" '
      ($r[0]) as $report |
      {mode:$mode, tier:$tier, at:$at, pid:(if $pid=="" then null else ($pid|tonumber) end),
       interval:$interval, trunk_tip:$report.trunk_tip, report:$report}' > "$tmp"
  mv "$tmp" "$state"; rm -f "$reportf"
  local s; s="$(jq -r '.report.summary | "clean=\(.clean) restack=\(.would_restack) contract=\(.would_contract) conflict=\(.will_conflict) skipped=\(.skipped)"' "$state")"
  logline "reclassified @ ${2:0:9} → $s"
}

# --apply (opt-in): act on the just-written report. Runs the PROVEN restack for the
# projects with actionable branches (would-restack / would-contract) — clean cases
# self-heal, conflicts PARK as a badge. Safe by construction: `--no-claude` (never spawns
# AI unattended), stack-restack moves LOCAL refs only (never pushes), and it runs in a
# detached scratch worktree (never the main checkout). Merge-truth is GitHub-authoritative
# upstream (restack-dryrun already skips open-PR branches).
apply_if_safe() {
  (( apply )) || return 0
  [[ -f "$state" ]] || return 0
  local n projects scratch
  n="$(jq -r '[.report.branches[]|select(.verdict=="would-restack" or .verdict=="would-contract")]|length' "$state" 2>/dev/null || echo 0)"
  [[ "$n" =~ ^[0-9]+$ ]] && (( n > 0 )) || return 0
  projects="$(jq -r '.report.branches[]|select(.verdict=="would-restack" or .verdict=="would-contract")|.branch' "$state" 2>/dev/null \
    | while read -r b; do git config "stack-branch.$b.project" 2>/dev/null || true; done | sort -u)"
  if [[ -z "${projects// }" ]]; then
    logline "apply: $n actionable branch(es) but no stack-project mapping — skipped"; return 0
  fi
  scratch="$(dirname "$(git rev-parse --show-toplevel)")/.loops-restack-wt"
  if ! git worktree list --porcelain | grep -qx "worktree $scratch"; then
    git worktree add --detach "$scratch" HEAD >/dev/null 2>&1 \
      || { logline "apply: scratch worktree add failed ($scratch)"; return 0; }
  fi
  logline "apply: stack-restack-all --no-claude $(echo "$projects" | tr '\n' ' ') ($n actionable)"
  # shellcheck disable=SC2046  — intentional word-split of newline-separated project names
  ( cd "$scratch" && "$here/stack-restack-all" --no-claude $(echo "$projects") ) >> "$log" 2>&1 \
    && logline "apply: done" || logline "apply: restack-all nonzero (some parked → surfaced as badge)"
  prep_next_bases "$projects"   # collapse each newly-exposed next base's unpushed tail → one voiced commit
  reclassify "$1" "$2"   # refresh state to post-restack+prep reality
}

# Prep one next base for push: collapse its unpushed tail to one voiced commit AND carry the
# stacked subtree — `stack-squash --reseat` owns the whole reseat (BFS the descendants, replay each
# onto the moved base, gate out checked-out/pushed subtrees, roll back on conflict). The daemon only
# adds idempotency: stack-squash re-commits + re-voices (a claude call) even for a single commit, so
# without this every trunk move would re-prep an already-clean base — churn + wasted tokens. Skip
# when the base is already ONE non-WIP commit (the /prep-route "ready" verdict).
prep_one_base() {
  local base="$1" outgoing subj res
  outgoing="$(git rev-list --count "$base" --not --remotes=origin 2>/dev/null || echo 0)"
  [[ "$outgoing" =~ ^[0-9]+$ ]] || outgoing=0
  (( outgoing > 0 )) || { logline "prep: $base — nothing unpushed, skip"; return 0; }
  subj="$(git log -1 --format=%s "$base" 2>/dev/null || true)"
  if (( outgoing == 1 )) && ! grep -qiE '^(wip\b|fixup!|squash!|amend!)' <<<"$subj"; then
    logline "prep: $base — already one voiced commit, nothing to prep"; return 0
  fi
  res="$("$here/stack-squash" --unpushed --format --subject-only --reseat "$base" 2>>"$log")"
  if [[ "$(jq -r '.ok // false' <<<"$res" 2>/dev/null)" == "true" ]]; then
    logline "prep: $base squashed + $(jq -r '.reseated|length' <<<"$res" 2>/dev/null||echo 0) descendant(s) reseated (local, no push)"
  else
    logline "prep: $base not prepped — $(jq -r '.err // .reseat // "squash declined"' <<<"$res" 2>/dev/null)"
  fi
}

# --apply, final leg: once the survivors restack onto fresh main, PREP each project's next base for
# push — squash+voice its unpushed tail and reseat its subtree (the same stack-squash the viewer's
# prep button runs, now with --reseat). Local-only, never pushes. "next base" = stack-forest's
# mergeable roots — the same set the viewer's candidates chip reads, so the daemon and the chip name
# the same branch. Skip any base with a PUSHED counterpart (may carry an open PR — prep must never
# risk diverging a PR head).
prep_next_bases() {
  (( apply )) || return 0
  local projects="$1" proj b bases
  [[ -n "${projects// }" ]] || return 0
  for proj in $projects; do
    bases="$("$here/stack-forest" --projects 2>/dev/null \
      | jq -r --arg p "$proj" '.[]|select(.name==$p)|.mergeable[]?' 2>/dev/null || true)"
    [[ -n "${bases// }" ]] || continue
    while IFS= read -r b; do
      [[ -n "$b" ]] || continue
      git rev-parse --verify -q "refs/remotes/origin/$b" >/dev/null 2>&1 && continue
      prep_one_base "$b"
    done <<< "$bases"
  done
}

# --contract (opt-in): the SAFE subset of --apply. On a trunk move, act on the would-contract
# ghosts ONLY — drop each already-merged branch and rewire its children's parent onto the
# ghost's parent. Pure metadata + a merged-branch delete: NO rebase, so nothing can conflict
# and no working tree is touched. The children's actual rebase-forward stays PARKED as
# would-restack for a human (the viewer's ▸ ready button). Purpose-invariant — a contracted
# child implements the same parent…child delta, so descriptions never need refreshing. A ghost
# checked out in some worktree can't be deleted → left exactly as it was, logged.
contracted_n=0
contract_ghosts() {
  contracted_n=0
  (( contract )) || return 0
  [[ -f "$state" ]] || return 0
  local ghosts g parent key val child proj
  ghosts="$(jq -r '.report.branches[]|select(.verdict=="would-contract")|.branch' "$state" 2>/dev/null || true)"
  [[ -n "${ghosts// }" ]] || return 0
  while IFS= read -r g; do
    [[ -n "$g" ]] || continue
    parent="$(git config "stack-branch.$g.parent" 2>/dev/null || echo "$MAIN")"
    [[ -n "$parent" ]] || parent="$MAIN"
    # delete FIRST — if the ghost is checked out in some worktree it can't be dropped; bail
    # before touching any config so a non-deletable ghost leaves the graph exactly as it was.
    if ! git branch -D "$g" >/dev/null 2>&1; then
      logline "contract: $g merged but not deletable (checked out?) — left for the ▸ ready button"
      continue
    fi
    # rewire every child that pointed at the ghost onto the ghost's parent (metadata only —
    # the child's history still carries the merged commits until its own parked restack replays it)
    while IFS=' ' read -r key val; do
      [[ -z "$key" ]] && continue
      [[ "$val" == "$g" ]] || continue
      child="${key#stack-branch.}"; child="${child%.parent}"
      git config "stack-branch.$child.parent" "$parent"
      git config --unset "stack-branch.$child.base" 2>/dev/null || true
      logline "contract: rewire $child parent → $parent"
    done < <(git config --get-regexp '^stack-branch\..*\.parent$' 2>/dev/null || true)
    # drop the ghost from any integrator's fan-in list — its work is main-native now
    while IFS=' ' read -r key val; do
      [[ -z "$key" ]] && continue
      [[ "$val" == "$g" ]] || continue
      child="${key#stack-branch.}"; child="${child%.requires}"
      git config --unset-all --fixed-value "stack-branch.$child.requires" "$g" 2>/dev/null || true
      logline "contract: drop fan-in requires $g from $child"
    done < <(git config --get-regexp '^stack-branch\..*\.requires$' 2>/dev/null || true)
    proj="$(git config "stack-branch.$g.project" 2>/dev/null || true)"
    [[ -n "$proj" ]] && git config --unset-all --fixed-value "stack-project.$proj.branch" "$g" 2>/dev/null || true
    git config --remove-section "stack-branch.$g" 2>/dev/null || true
    contracted_n=$((contracted_n+1))
    logline "contract: dropped merged ghost $g (children now rebase onto $parent)"
  done <<< "$ghosts"
  (( contracted_n > 0 )) && logline "contract: $contracted_n ghost(s) auto-dropped on this trunk move"
  return 0
}

case "$mode" in
  status)
    [[ -f "$state" ]] && cat "$state" || { echo "restack-daemon: no state yet ($state)"; exit 1; }
    exit 0 ;;
  stop)
    if [[ -f "$pidf" ]] && kill -0 "$(cat "$pidf")" 2>/dev/null; then
      kill -TERM "$(cat "$pidf")" && echo "restack-daemon: signalled pid $(cat "$pidf") to stop"
    else
      echo "restack-daemon: no running daemon (stale or absent pidfile)"; rm -f "$pidf"
    fi
    exit 0 ;;
  once)
    git fetch -q origin "$MAIN" 2>/dev/null || true
    tip="$(git rev-parse --verify --quiet "origin/$MAIN" || git rev-parse --verify --quiet "$MAIN" || echo "")"
    prev_tip="$(jq -r '.trunk_tip // empty' "$state" 2>/dev/null || true)"
    [[ -n "$prev_tip" && -n "$tip" ]] && attribute_merges "$prev_tip" "$tip"
    refresh_local_main "$tip"
    reclassify "" "$tip"
    if (( apply )); then
      apply_if_safe "" "$tip"
    elif (( contract )); then
      contract_ghosts; (( contracted_n )) && reclassify "" "$tip"
    fi
    echo "restack-daemon: single $( (( apply )) && echo apply || { (( contract )) && echo contract || echo dry-run; } ) pass written → $state"
    exit 0 ;;
  install)
    # gate the deploy: launchd will run us under /bin/bash (3.2), where a bash-4 construct is a
    # latent crash bash -n can't see. Refuse to install a script that trips the tripwire.
    if [[ -x "$here/check-bash32" ]] && ! "$here/check-bash32" "$0"; then
      echo "restack-daemon: refusing to install — bash-4 construct(s) above would crash under /bin/bash 3.2" >&2; exit 1
    fi
    label="com.philbrockman.restack-daemon"
    plist="$HOME/Library/LaunchAgents/$label.plist"
    repo="$(git rev-parse --show-toplevel)"
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    applyarg=""; (( apply )) && applyarg="<string>--apply</string>"
    contractarg=""; (( contract )) && contractarg="<string>--contract</string>"
    mkdir -p "$(dirname "$plist")"
    # KeepAlive restarts it if it dies; WorkingDirectory pins the watched repo (origin/main +
    # forest config are per-repo). Stop = uninstall (KeepAlive would relaunch a --stop'd one).
    cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>$self</string><string>--interval</string><string>$interval</string>$applyarg$contractarg</array>
  <key>WorkingDirectory</key><string>$repo</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>$gd/restack-ambient.agent.out.log</string>
  <key>StandardErrorPath</key><string>$gd/restack-ambient.agent.err.log</string>
</dict>
</plist>
EOF
    uid="$(id -u)"
    launchctl bootout "gui/$uid/$label" 2>/dev/null || true
    rm -f "$pidf"   # a prior run's pidfile would block the relaunched loop's single-instance guard
    # bootout is async; an immediate re-bootstrap can race it and fail with EIO(5). Retry briefly.
    ok=0
    for _ in 1 2 3 4 5; do
      launchctl bootstrap "gui/$uid" "$plist" 2>/dev/null && { ok=1; break; }
      sleep 1
    done
    if (( ok )); then
      echo "restack-daemon: installed + started (watching $repo every ${interval}s, $mode_desc)"
      echo "  state: $state    logs: $gd/restack-ambient.agent.*.log    stop: restack-daemon uninstall"
    else
      echo "restack-daemon: launchctl bootstrap failed (still loaded? try: restack-daemon uninstall)" >&2; exit 1
    fi
    exit 0 ;;
  uninstall)
    label="com.philbrockman.restack-daemon"
    plist="$HOME/Library/LaunchAgents/$label.plist"
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    rm -f "$plist" "$pidf"
    echo "restack-daemon: uninstalled (agent stopped, plist removed)"
    exit 0 ;;
esac

# ---- loop mode: single-instance guard ----
if [[ -f "$pidf" ]] && kill -0 "$(cat "$pidf" 2>/dev/null)" 2>/dev/null; then
  echo "restack-daemon: already running (pid $(cat "$pidf")) — use --stop first" >&2; exit 1
fi
echo $$ > "$pidf"
running=1
# job control on → each backgrounded reclassify is its own process group, so the trap can
# reap the WHOLE subtree (restack-dryrun → rebase-classify → git), not just the direct child.
set -m
# TERM/INT must actually stop the loop (the old stack-restack-all trapped TERM and hung —
# this clears the flag AND kills any in-flight --deep pass's process group so --stop lands
# within ~1s, leaving no orphaned classify/git procs, not after a minutes-long classify pass.
trap 'running=0; [[ -n "$child" ]] && kill -TERM -"$child" 2>/dev/null || true' TERM INT
trap 'rm -f "$pidf"' EXIT

logline "daemon start pid=$$ interval=${interval}s ($mode_desc)"
# attribution baseline survives restarts via the state file's trunk_tip; last_tip stays
# empty so a fresh daemon still re-classifies once on startup.
prev_tip="$(jq -r '.trunk_tip // empty' "$state" 2>/dev/null || true)"
last_tip=""
while (( running )); do
  git fetch -q origin "$MAIN" 2>/dev/null || true
  tip="$(git rev-parse --verify --quiet "origin/$MAIN" || git rev-parse --verify --quiet "$MAIN" || echo "")"
  if [[ -n "$tip" && "$tip" != "$last_tip" ]]; then
    base="${last_tip:-$prev_tip}"
    [[ -n "$base" ]] && attribute_merges "$base" "$tip"
    refresh_local_main "$tip"
    if reclassify "$$" "$tip"; then
      last_tip="$tip"
      if (( apply )); then apply_if_safe "$$" "$tip"
      elif (( contract )); then contract_ghosts; (( contracted_n )) && reclassify "$$" "$tip"; fi
    fi
  fi
  # interruptible sleep: a TERM during the sleep wakes us, the trap clears `running`,
  # and the while-check exits — so --stop is honoured within one fetch cycle, not one interval.
  for _ in $(seq "$interval"); do (( running )) || break; sleep 1; done
done
logline "daemon stop pid=$$"
