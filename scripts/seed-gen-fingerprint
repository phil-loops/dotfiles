#!/usr/bin/env python3
"""Fingerprint tRPC generation inputs, resolution candidates, and emitted artifacts."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


SOURCE_SUFFIXES = (".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs", ".json")


def output_key(tree):
    return outputs_digest(Path(tree) / ".gen/trpc-types")


def outputs_digest(output):
    output = Path(output)
    if not (output / "trpc/root.d.ts").is_file():
        raise ValueError("missing generated root")
    digest = hashlib.sha256()
    for path in sorted(output.rglob("*")):
        if path.is_file():
            digest.update(os.fsencode(str(path.relative_to(output))) + b"\0")
            digest.update(path.read_bytes())
            digest.update(b"\0")
    return digest.hexdigest()


DECL = ((".tsx", ".d.ts"), (".ts", ".d.ts"), (".mts", ".d.mts"), (".cts", ".d.cts"))


def prune_outputs(tree):
    """Delete emitted declarations whose source left the graph. An incremental emit rewrites what
    changed and never deletes, so a tree that held another commit kept that commit's extra
    outputs — a fresh build of the same commit has none (2026-10-22). Expected outputs are each
    in-tree TypeScript source's .d.ts (+ .map) under the outDir, mirroring rootDir = the tree.
    Compared case-folded: the tsbuildinfo records many names as the compiler's canonical (lowercased)
    path on this case-insensitive filesystem."""
    tree = Path(tree).absolute()
    info = tree / ".gen/trpc-types.tsbuildinfo"
    graph = json.loads(info.read_text())
    graph = graph.get("program", graph)
    names = graph.get("fileNames") or []
    low = str(tree).lower() + "/"
    if not names:
        raise ValueError("no compiler input graph")
    expected = set()
    for name in names:
        path = os.path.normpath(info.parent / name).lower()
        if not path.startswith(low):
            continue
        rel = path[len(low):]
        if rel.startswith("node_modules/") or rel.endswith((".d.ts", ".d.mts", ".d.cts")):
            continue
        for src, dst in DECL:
            if rel.endswith(src):
                expected.update((rel[: -len(src)] + dst, rel[: -len(src)] + dst + ".map"))
                break
    out = tree / ".gen/trpc-types"
    gone = 0
    for path in sorted(out.rglob("*"), reverse=True):
        rel = str(path.relative_to(out))
        if path.is_file() and rel.lower() not in expected:
            path.unlink()
            gone += 1
        elif path.is_dir() and not any(path.iterdir()):
            path.rmdir()
    return gone


STAGE = ".emit"   # beside trpc-types, at its depth: the maps' relative `sources` come out the same


def sync_dir(src, dst):
    """Make `dst` hold exactly `src`'s files, moving them in: a file already byte-identical stays
    untouched (its mtime and inode too, so a watcher hears only real changes), the rest are
    renamed over, extras deleted. Returns how many files changed."""
    src, dst = Path(src), Path(dst)
    files = [p.relative_to(src) for p in src.rglob("*") if p.is_file()]
    keep = {str(r).lower() for r in files}
    changed = 0
    for rel in files:
        s, t = src / rel, dst / rel
        try:
            if t.stat().st_size == s.stat().st_size and t.read_bytes() == s.read_bytes():
                continue
        except OSError:
            pass
        t.parent.mkdir(parents=True, exist_ok=True)
        if t.is_dir() and not t.is_symlink():
            shutil.rmtree(t)
        os.chmod(s, 0o644)
        os.replace(s, t)
        changed += 1
    for path in sorted(dst.rglob("*"), reverse=True):
        if path.is_file() and str(path.relative_to(dst)).lower() not in keep:
            path.unlink()
            changed += 1
        elif path.is_dir() and not any(path.iterdir()):
            path.rmdir()
    return changed


def adopt_emit(tree):
    """Take a full emit from .gen/.emit into .gen/trpc-types (sync_dir), and point the tsbuildinfo
    the compiler wrote back at trpc-types. seed-gen emits in full every time: TS7's incremental
    emit under noCheck re-emits a changed file but not the files whose declarations are inferred
    from it (2026-10-23: lib/app-env/rate-limiting.ts gained a getter, index.d.ts kept the old
    shape), and a full emit in place would rewrite every output, which the type service hears as
    a change to each of ~1,500 files."""
    tree = Path(tree)
    stage, out = tree / ".gen" / STAGE, tree / ".gen/trpc-types"
    if not (stage / "trpc/root.d.ts").is_file():
        raise ValueError("no staged emit")
    out.mkdir(parents=True, exist_ok=True)
    changed = sync_dir(stage, out)
    info_path = tree / ".gen/trpc-types.tsbuildinfo"
    info = json.loads(info_path.read_text())
    prefix = "./" + STAGE

    def fix(v):
        if isinstance(v, str) and (v == prefix or v.startswith(prefix + "/")):
            return "./trpc-types" + v[len(prefix):]
        return v
    for k, v in list(info.items()):
        if k in ("fileNames", "packageJsons", "missingPackageJsons"):
            continue
        if isinstance(v, dict):
            info[k] = {kk: fix(vv) for kk, vv in v.items()}
        else:
            info[k] = fix(v)
    tmp = info_path.with_name(info_path.name + ".tmp")
    tmp.write_text(json.dumps(info, separators=(",", ":")))
    os.replace(tmp, info_path)
    shutil.rmtree(stage, ignore_errors=True)
    return changed


def fingerprint(tree, snapshot=False):
    tree = Path(tree).absolute()
    result = subprocess.run(
        ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
        cwd=tree, check=True, capture_output=True)
    names = sorted(set(os.fsdecode(n) for n in result.stdout.split(b"\0") if n))
    sources = [n for n in names if n.endswith(SOURCE_SUFFIXES)]
    digest = hashlib.sha256(b"seed-gen-inputs-v1\0")

    def add(label, path):
        digest.update(os.fsencode(label) + b"\0")
        digest.update(Path(path).read_bytes())
        digest.update(b"\0")

    for name in sources:
        digest.update(os.fsencode(name) + b"\0")
    if snapshot:
        for name in sources:
            if (tree / name).is_file():
                add(name, tree / name)
        return digest.hexdigest()

    info = tree / ".gen/trpc-types.tsbuildinfo"
    graph = json.loads(info.read_text())
    graph = graph.get("program", graph)
    if not graph.get("fileNames"):
        raise ValueError("no compiler input graph")
    add("compiler", tree / "node_modules/typescript/package.json")
    for name in sorted(graph["fileNames"]):
        # Native TypeScript embeds its lib.*.d.ts files in the versioned compiler.
        if name.startswith("lib.") and "/" not in name and name.endswith(".d.ts"):
            continue
        add("input:" + name, os.path.normpath(info.parent / name))
    for name in sources:
        base = Path(name).name
        if base in ("package.json", "package-lock.json") or base.startswith(("tsconfig", "tsbase")):
            if (tree / name).is_file():
                add("config:" + name, tree / name)
    digest.update(output_key(tree).encode())
    return digest.hexdigest()


if __name__ == "__main__":
    try:
        if "--prune" in sys.argv[2:]:
            print(prune_outputs(sys.argv[1]))
        elif "--adopt" in sys.argv[2:]:
            print(adopt_emit(sys.argv[1]))
        elif "--outputs" in sys.argv[2:]:
            print(output_key(sys.argv[1]))
        else:
            print(fingerprint(sys.argv[1], snapshot="--snapshot" in sys.argv[2:]))
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError):
        sys.exit(1)
