#!/usr/bin/env bash
# stack-doctor — read-only health scan of the git forest (stack-project.* config).
# Flags the failure modes that bite restacks, born from the goals-in-workflows orphan
# (2026-07-08): a parent gets amended/rebased but its descendants are left on the
# pre-amend commit, so restacking with the branch tip as cut point duplicates code.
#
#   stack-doctor                 scan every project
#   stack-doctor <project>       scan one project
#   stack-doctor --orphans       only show projects with a problem (orphan/stale/ghost)
#   stack-doctor --prune         GC config whose branch is gone (--dry-run to preview)
#   stack-doctor --viewer        also compare EVERY project against the running viewer
#                                (one named project already does this — see ⧉ below)
#
# Per branch:
#   ✓ fresh    on current origin/main
#   ⇡ stale-N  forked N commits behind origin/main (restack candidate)
#   ⚠ ORPHAN   its parent's branch tip is NOT an ancestor of it — parent was amended
#              and this child was left behind. Cut at its REAL parent (git rev-parse <b>^),
#              never the metadata parent tip. See feedback_restack-orphaned-stack.
#   ⊘ empty    parent...branch diff is empty (contract: drop + rewire children)
#   ~ ghost?   patch-contained in origin/main (likely squash-merged — verify, then contract)
#   ✗ MISSING  branch in config but no ref
#   ∴ decide   proof branch (role=proof, never ships) outlived every shippable member —
#              keep it as a standing proof, lift the artifact out, or drop it. Never
#              sweep it silently.
#   ⛓ chain    exactly one `requires` on a main-rooted branch — a mis-encoded chain
#              (the one-dep test): set parent=<dep> and drop the requires.
#   ∅ purpose  no branch description — an unfinished operation; every forest member
#              carries a one-line purpose (git branch --edit-description).
#   ⧉ viewer   the running viewer serves a different branch set than git does — its
#              per-forest /model cache froze. Nothing else compares the two, which is
#              why a contracted branch rendered on the map for 25 minutes before anyone
#              noticed (2026-07-21). Cure: bounce the server.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

only_problems=0; want=""; do_prune=0; dry_run=0; check_viewer=0
for a in "$@"; do
  case "$a" in
    --orphans|--problems) only_problems=1 ;;
    --prune) do_prune=1 ;;
    --viewer) check_viewer=1 ;;
    --dry-run|-n) dry_run=1 ;;
    -h|--help) sed -n '2,33p' "$0"; exit 0 ;;
    *) want="$a" ;;
  esac
done
[ -n "$want" ] && check_viewer=1

git rev-parse --git-dir >/dev/null 2>&1 || { echo "stack-doctor: not in a git repo" >&2; exit 1; }

# ── prune ───────────────────────────────────────────────────────────────────
# The cure for what the scan already diagnoses (✗ MISSING / ghost projects).
# `stack-branch.<b>.*` and `stack-project.<p>.*` live outside git's own
# `branch.<b>.*` namespace, which git GCs on delete and moves on rename — so
# ours survives the branch it describes and accumulates forever.
#
# Two rules, both keyed on "the ref is gone", never on staleness:
#   1. branch has no ref  → drop its stack-branch.*, its registry entries, and
#      any other branch's `requires` naming it.
#   2. project has no surviving member → drop its stack-project.* (focus/tier/…).
# A project with keys but no members yet (mid-setup) is NOT pruned — it's only
# a ghost once it had members and outlived them, so require zero live members
# AND zero registry entries.
alive() { git rev-parse --verify -q "$1^{commit}" >/dev/null 2>&1; }
unset_key() {  # $1 = full key
  if [ "$dry_run" = "1" ]; then echo "    would unset  $1"
  else git config --unset-all "$1" 2>/dev/null || true; echo "    unset  $1"; fi
}

prune() {
  local pruned=0 key name branch proj v
  # --name-only is load-bearing: `summary` values are multi-line prose, so raw
  # --get-regexp output interleaves value lines that parse as bogus keys.
  # Suffixes never contain a dot, branch names do (cal.com-integration) — so
  # strip the LAST component, never split on the first.
  echo "── pruning config whose branch is gone ──"
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    name="${key#stack-branch.}"; branch="${name%.*}"
    alive "$branch" && continue
    echo "  ✗ $branch (no ref)"
    unset_key "$key"; pruned=$((pruned+1))
  done < <(git config --name-only --get-regexp '^stack-branch\..*\.' 2>/dev/null | sort)

  while IFS= read -r key; do
    [ -n "$key" ] || continue
    name="${key#branch.}"; branch="${name%.stack-*}"
    alive "$branch" && continue
    echo "  ✗ $branch (no ref)"
    echo "    left alone (new namespace, git-managed)  $key"
  done < <(git config --name-only --get-regexp '^branch\..*\.stack-' 2>/dev/null | sort)

  # registry entries + fan-in deps naming a branch that no longer exists
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    while IFS= read -r v; do
      [ -n "$v" ] || continue
      alive "$v" && continue
      if [ "$dry_run" = "1" ]; then echo "    would drop   $key = $v (no ref)"
      else git config --unset-all "$key" "^$(printf '%s' "$v" | sed 's/[][\.*^$/]/\\&/g')$" 2>/dev/null || true
           echo "    dropped  $key = $v (no ref)"; fi
      pruned=$((pruned+1))
    done < <(git config --get-all "$key" 2>/dev/null)
  done < <(git config --name-only --get-regexp '^(stack-project\..*\.branch|stack-branch\..*\.requires)$' 2>/dev/null | sort -u)

  while IFS= read -r key; do
    [ -n "$key" ] || continue
    while IFS= read -r v; do
      [ -n "$v" ] || continue
      alive "$v" && continue
      echo "    left alone (new namespace, git-managed)  $key = $v (no ref)"
    done < <(git config --get-all "$key" 2>/dev/null)
  done < <(git config --name-only --get-regexp '^branch\..*\.stack-requires$' 2>/dev/null | sort -u)

  # ghost projects: keys outliving every member. Build the live-member set ONCE —
  # per-project rescans are O(projects x branches) git calls and crawl on a big forest.
  local live_projects
  live_projects=$'\n'
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    name="${key#stack-branch.}"; branch="${name%.*}"
    alive "$branch" || continue
    v=$(git config "branch.$branch.stack-project" 2>/dev/null || git config "stack-branch.$branch.project" 2>/dev/null || true)
    [ -n "$v" ] && live_projects+="$v"$'\n'
  done < <(git config --name-only --get-regexp '^stack-branch\..*\.project$' 2>/dev/null)
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    name="${key#branch.}"; branch="${name%.stack-project}"
    alive "$branch" || continue
    v=$(git config "branch.$branch.stack-project" 2>/dev/null || true)
    [ -n "$v" ] && live_projects+="$v"$'\n'
  done < <(git config --name-only --get-regexp '^branch\..*\.stack-project$' 2>/dev/null)
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    proj="${key#stack-project.}"; proj="${proj%.*}"
    while IFS= read -r v; do
      [ -n "$v" ] && alive "$v" && live_projects+="$proj"$'\n'
    done < <(git config --get-all "$key" 2>/dev/null)
  done < <(git config --name-only --get-regexp '^stack-project\..*\.branch$' 2>/dev/null)

  while IFS= read -r proj; do
    [ -n "$proj" ] || continue
    case "$live_projects" in *$'\n'"$proj"$'\n'*) continue ;; esac
    echo "  ⊘ project $proj (no surviving member)"
    while IFS= read -r key; do unset_key "$key"; pruned=$((pruned+1)); done \
      < <(git config --name-only --get-regexp "^stack-project\.$(printf '%s' "$proj" | sed 's/[][\.*^$/]/\\&/g')\." 2>/dev/null | sort -u)
  done < <(git config --name-only --get-regexp '^stack-project\.' 2>/dev/null \
           | sed -E 's/^stack-project\.(.*)\.[^.]+$/\1/' | sort -u)

  if [ "$pruned" = "0" ]; then echo "  nothing to prune — config is clean"
  elif [ "$dry_run" = "1" ]; then echo "── $pruned dangling key(s) would be pruned (--prune without --dry-run to apply) ──"
  else echo "── $pruned dangling key(s) pruned ──"; fi
}

if [ "$do_prune" = "1" ]; then prune; exit 0; fi
git fetch origin main --quiet 2>/dev/null || true
OM=$(git rev-parse --verify -q origin/main 2>/dev/null || git rev-parse --verify -q main)

sha() { git rev-parse --short "$1" 2>/dev/null; }
# real parent commit of a branch = its first-parent commit
realparent() { git rev-parse --short "$1^" 2>/dev/null; }

# ── viewer model drift ──────────────────────────────────────────────────────
# Comparing what the viewer SERVES to what git says is the only way a frozen /model
# cache ever surfaces. It costs a curl + a stack-forest build per project (~1.3s), so
# the whole-repo sweep is opt-in (--viewer); one named project gets it for free.
here="$(cd "$(dirname "$0")" && pwd)"
viewer_port=""
[ "$check_viewer" = "1" ] && viewer_port=$("$here/stack-review-port" 2>/dev/null || true)

modeldiff() {  # served JSON $1 vs git JSON $2 → how they disagree, empty when they agree
  python3 -c '
import json, sys
def nodes(p):
    d = json.load(open(p))
    return d, {b: n for b, n in (d.get("nodes") or {}).items() if not b.startswith("✦")}
sd, sn = nodes(sys.argv[1])
td, tn = nodes(sys.argv[2])
# stack-forest emits roots/children/requires in an unstable order — two runs over identical
# state disagree, so only their CONTENT can mean anything here
norm = lambda v: sorted(v) if isinstance(v, list) and all(isinstance(x, str) for x in v) else v
out = []
gone, missing = sorted(set(sn) - set(tn)), sorted(set(tn) - set(sn))
if gone:    out.append("shows dead branches: " + " ".join(gone))
if missing: out.append("omits live branches: " + " ".join(missing))
# only the keys stack-forest itself emits: /model grafts description + mergeRank on top
bad = [(b, sorted(k for k in tn[b] if norm(sn[b].get(k)) != norm(tn[b][k]))) for b in sorted(set(sn) & set(tn))]
bad = [(b, ks) for b, ks in bad if ks]
if bad:     out.append("wrong data on: " + " ".join("%s(%s)" % (b, ",".join(ks[:3])) for b, ks in bad))
if norm(sd.get("roots") or []) != norm(td.get("roots") or []): out.append("different roots")
print(" — ".join(out))' "$1" "$2" 2>/dev/null
}

drift_once() {  # $1 = project, $2 = scratch dir → modeldiff of a fresh read of both sides
  curl -sf --max-time 2 "http://127.0.0.1:$viewer_port/model?branch=$1" -o "$2/served.json" || return 1
  "$here/stack-forest" "$1" > "$2/truth.json" 2>/dev/null || return 1
  modeldiff "$2/served.json" "$2/truth.json"
}

viewer_drift() {  # $1 = project → a report line iff served ≠ git; silent if the server is down
  [ -n "$viewer_port" ] || return 0
  local tmp drift pid
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN
  drift=$(drift_once "$1" "$tmp") || return 0
  [ -n "$drift" ] || return 0
  # a commit landing between the two reads looks exactly like a stale cache — but only once,
  # since the second read rebuilds. Cry wolf here and the whole check gets tuned out.
  drift=$(drift_once "$1" "$tmp") || return 0
  [ -n "$drift" ] || return 0
  pid=$(lsof -ti "tcp:$viewer_port" -sTCP:LISTEN 2>/dev/null | head -1)
  printf '  ⧉ viewer serves a stale model — %s — bounce it: kill %s; stack-review-serve --ensure\n' \
    "$drift" "${pid:-<pid>}"
}

problems=0
projects=$(git config --get-regexp '^stack-project\..*\.branch$' 2>/dev/null | sed -E 's/^stack-project\.([^.]+)\.branch .*/\1/' | sort -u)
[ -n "$projects" ] || { echo "no stack-projects configured"; exit 0; }

for proj in $projects; do
  [ -n "$want" ] && [ "$proj" != "$want" ] && continue
  lines=""; proj_problem=0; proof_members=""; shippable_alive=0
  for b in $(git config --get-all "stack-project.$proj.branch"); do
    if ! git rev-parse --verify -q "$b" >/dev/null; then
      lines+="  ✗ MISSING  $b (in config, no ref)"$'\n'; proj_problem=1; continue
    fi
    role=$(git config "branch.$b.stack-role" 2>/dev/null || git config "stack-branch.$b.role" 2>/dev/null || true)
    if [ "$role" = "proof" ]; then proof_members+="$b"$'\n'; else shippable_alive=1; fi
    parent=$(git config "branch.$b.stack-parent" 2>/dev/null || git config "stack-branch.$b.parent" 2>/dev/null || echo main)
    glyph="✓"; detail=""
    # orphan check: only when parent is a real, existing branch (not main/origin/main)
    if [ "$parent" != "main" ] && [ "$parent" != "origin/main" ] && git rev-parse --verify -q "$parent" >/dev/null; then
      if ! git merge-base --is-ancestor "$parent" "$b" 2>/dev/null; then
        glyph="⚠"; detail="ORPHAN — parent '$parent' tip $(sha "$parent") not an ancestor; real parent $(realparent "$b"). Cut there, not the tip."
        proj_problem=1
      fi
    fi
    if [ "$glyph" = "✓" ]; then
      # empty? (parent...branch diff empty → contract)
      pref="$parent"; git rev-parse --verify -q "$parent" >/dev/null || pref="$OM"
      if [ -z "$(git diff "$pref...$b" 2>/dev/null | head -c1)" ]; then
        glyph="⊘"; detail="empty vs $parent — contract (drop + rewire children)"; proj_problem=1
      else
        base=$(git merge-base "$b" "$OM" 2>/dev/null)
        if [ "$base" = "$OM" ]; then
          # fresh on main; still maybe a squash-merged ghost
          if [ "$(git cherry "$OM" "$b" 2>/dev/null | grep -c '^+')" = "0" ]; then
            glyph="~"; detail="patch-contained in origin/main — likely squash-merged; verify then contract"; proj_problem=1
          fi
        else
          behind=$(git rev-list --count "$base..$OM" 2>/dev/null)
          glyph="⇡"; detail="stale-$behind (forked $behind behind origin/main)"; proj_problem=1
        fi
      fi
    fi
    lines+="  $glyph $b${role:+ [$role]}${detail:+  — $detail}"$'\n'
    reqs=$(git config --get-all "branch.$b.stack-requires" 2>/dev/null || git config --get-all "stack-branch.$b.requires" 2>/dev/null || true)
    nreq=$(printf '%s' "$reqs" | grep -c . || true)
    if { [ "$parent" = "main" ] || [ "$parent" = "origin/main" ]; } && [ "$nreq" = "1" ]; then
      lines+="  ⛓ $b — one requires ($reqs) on a main-rooted branch: mis-encoded chain — set parent=$reqs, drop the requires"$'\n'; proj_problem=1
    fi
    if [ "$role" != "proof" ] && [ -z "$(git config "branch.$b.description" 2>/dev/null || true)" ]; then
      lines+="  ∅ $b — no purpose: git config branch.$b.description \"<thesis>\""$'\n'; proj_problem=1
    fi
  done
  drift=$(viewer_drift "$proj")
  if [ -n "$drift" ]; then lines+="$drift"$'\n'; proj_problem=1; fi
  if [ -n "$proof_members" ] && [ "$shippable_alive" = "0" ]; then
    while IFS= read -r pb; do
      [ -n "$pb" ] || continue
      lines+="  ∴ $pb — proof branch outlived its forest: keep as standing proof, lift the artifact, or drop"$'\n'
    done <<< "$proof_members"
    proj_problem=1
  fi
  if [ "$only_problems" = "1" ] && [ "$proj_problem" = "0" ]; then continue; fi
  printf '### %s\n%s\n' "$proj" "$lines"
  [ "$proj_problem" = "1" ] && problems=$((problems+1))
done

echo "── scanned against origin/main $(sha "$OM"); $problems project(s) need attention ──"
