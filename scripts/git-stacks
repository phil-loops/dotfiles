#!/usr/bin/env zsh
# Show branch stacks and fuzzy-select a branch to check out.
# Reads parent pointers from stack-branch.*.parent.
# Usage: git-stacks        (interactive picker)
#        git-stacks --list  (just print stacks)

set -uo pipefail

local list_only=false
[[ "${1:-}" == "--list" ]] && list_only=true

local current_branch=$(git branch --show-current 2>/dev/null)

typeset -A parent_of
typeset -A children_of

local line branch parent
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  if [[ "$line" =~ '^stack-branch\.(.+)\.parent (.+)$' ]]; then
    parent_of[${match[1]}]="${match[2]}"
  fi
done < <(git config --local --get-regexp '^stack-branch\..*\.parent$' 2>/dev/null)

# Rebuild children map from final parent map
for branch in "${(@k)parent_of}"; do
  parent="${parent_of[$branch]}"
  children_of[$parent]="${children_of[$parent]:-} $branch"
done

# Find stack roots: children of main that themselves have children
local roots=()
for branch in ${(z)children_of[main]:-}; do
  [[ -n "${children_of[$branch]:-}" ]] && roots+=("$branch")
done

if [[ ${#roots[@]} -eq 0 ]]; then
  echo "No stacks found."
  exit 0
fi

# Print a stack recursively
print_stack() {
  local branch="$1" indent="$2" marker="  "
  [[ "$branch" == "$current_branch" ]] && marker="* "
  printf "%s%s%s\n" "$indent" "$marker" "$branch"
  local child
  for child in ${(z)children_of[$branch]:-}; do
    print_stack "$child" "  $indent"
  done
}

local output="" first=true
for root in ${(o)roots}; do
  $first || output+=$'\n'
  first=false
  output+="$(print_stack "$root" "")"
done

if $list_only; then
  echo "$output"
  exit 0
fi

local selected=$(echo "$output" | fzf --reverse --height=40% --prompt="stack> " \
  --preview-window=hidden)

[[ -z "$selected" ]] && exit 0

local target="${selected##*[* ]}"
[[ -n "$target" ]] && git checkout "$target"
