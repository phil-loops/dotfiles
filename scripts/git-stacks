#!/usr/bin/env bash
# Show git-town branch stacks and fuzzy-select a branch to check out.
# Usage: git-stacks        (interactive picker)
#        git-stacks --list  (just print stacks)

LIST_ONLY=false
if [[ "$1" == "--list" ]]; then
  LIST_ONLY=true
fi

stacks=$(git town branch 2>/dev/null | awk '
  {
    raw = $0
    gsub(/\033\[[0-9;]*m/, "")
    sub(/\*/, " ")
    match($0, /^[ ]*/)
    d = RLENGTH

    lines[NR] = raw
    depths[NR] = d
    total = NR
  }
  END {
    main_depth = -1
    for (i = 1; i <= total; i++) {
      tmp = lines[i]
      gsub(/\033\[[0-9;]*m/, "", tmp)
      gsub(/^[ *]+/, "", tmp)
      if (tmp == "main") { main_depth = depths[i]; break }
    }
    if (main_depth < 0) exit

    child_depth = main_depth + 2
    first = 1

    i = 1
    while (i <= total) {
      if (depths[i] == child_depth) {
        j = i + 1
        while (j <= total && depths[j] > child_depth) j++
        subtree_end = j - 1

        if (subtree_end > i) {
          if (!first) print ""
          first = 0
          for (k = i; k <= subtree_end; k++) print lines[k]
        }
        i = j
      } else {
        i++
      }
    }
  }
')

if [[ -z "$stacks" ]]; then
  echo "No stacks found."
  exit 0
fi

if $LIST_ONLY; then
  echo "$stacks"
  exit 0
fi

selected=$(echo "$stacks" | fzf --ansi --reverse --height=40% --prompt="stack> " \
  --preview-window=hidden)

if [[ -z "$selected" ]]; then
  exit 0
fi

# Extract branch name from the selected line
branch=$(echo "$selected" | sed 's/\x1b\[[0-9;]*m//g' | sed 's/^[* ]*//')

if [[ -n "$branch" && "$branch" != "" ]]; then
  git checkout "$branch"
fi
