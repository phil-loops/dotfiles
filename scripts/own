#!/bin/zsh
# own — per-session file-ownership for concurrent Claude sessions (see ~/.dotfiles/OWNERS).
#   own claim <lane>            this session holds <lane> (records a fresh timestamp)
#   own slice <name> <lane>...  hold several lanes for ONE vertical feature, tagged <name>
#   own request <lane>          ask for <lane>: claim it if free/stale, else register a request
#   own who <path>              which lane owns <path>, and whether it's actively held
#   own list                    every lane: held-age · liveness · slice · pending request · its paths
#   own release <lane|slice>    drop a lane's claim, or every lane tagged with a slice name
# Claims live in the DOTFILES repo's git config (own.<lane>.held = epoch), NOT wherever
# you invoke from — the lanes describe dotfiles, so the state must too. A slice records
# own.<lane>.slice = <name> so the OTHER session sees WHY.
#
# LIVENESS: a claim also records the holder's process (own.<lane>.pid/.start via
# claude-session-pid). "active" = that process is ALIVE — not a timer — so a crashed/
# closed session frees its lane the moment anyone looks, while a live-but-idle one
# keeps it (never yank a claim from someone mid-task). Claims with no pid (a manual
# claim outside a session) fall back to the 15-min "held recently" heuristic.
emulate -L zsh; set -uo pipefail
ROOT="${0:A:h:h}"; OWNERS="$ROOT/OWNERS"; NOW=$(date +%s); FRESH=900
RESOLVER="${0:A:h}/claude-session-pid"
gc(){ git -C "$ROOT" config "$@"; }   # always the dotfiles repo, regardless of cwd
SID="${OWN_SESSION:-}"                 # caller's session id (the PreToolUse hook passes it); "" for manual CLI
# stamp WHO holds a lane: session id + a liveness token (pid + process start-time).
_setowner(){ local lane="$1" out pid start
  [[ -n "$SID" ]] && gc "own.$lane.session" "$SID" || gc --unset "own.$lane.session" 2>/dev/null
  if out=$("$RESOLVER" 2>/dev/null) && [[ -n "$out" ]]; then
    pid="${out%%	*}"; start="${out#*	}"
    gc "own.$lane.pid" "$pid"; gc "own.$lane.start" "$start"
  else   # no claude ancestor (manual claim in a plain shell) → legacy age-based claim
    gc --unset "own.$lane.pid" 2>/dev/null; gc --unset "own.$lane.start" 2>/dev/null
  fi }
_clearowner(){ local lane="$1"   # drop every owner field for a lane
  local k; for k in held req slice session pid start; do gc --unset "own.$lane.$k" 2>/dev/null; done; }
# liveness of a lane's holder process: 0=alive, 1=dead, 2=no pid recorded (legacy)
_alive(){ local lane="$1" pid start cur
  pid=$(gc "own.$lane.pid" 2>/dev/null) || return 2; [[ -n "$pid" ]] || return 2
  kill -0 "$pid" 2>/dev/null || return 1
  start=$(gc "own.$lane.start" 2>/dev/null)
  cur=$(ps -o lstart= -p "$pid" 2>/dev/null | awk '{$1=$1};1')   # canonical single-spaced (matches claude-session-pid)
  [[ "$cur" == "$start" ]] || return 1   # start-time mismatch → pid was reused → holder is gone
  return 0 }
# "actively held" = holder process alive, OR (no pid recorded AND held within FRESH)
_active(){ local lane="$1" a; _alive "$lane"; local rc=$?
  (( rc == 0 )) && return 0
  (( rc == 2 )) && { a=$(_age "$lane") && (( a < FRESH )) && return 0; }
  return 1 }
# WHO AM I, in the same currency a claim records. The CLI never sets OWN_SESSION (only the
# PreToolUse hook does) and _setowner UNSETS .session when it's empty — so a hand-claimed lane
# is identified by its holder PID, not a session id. Compare pids or the check never fires.
_mypid(){ local out; out=$("$RESOLVER" 2>/dev/null) && [[ -n "$out" ]] && print -r -- "${out%%	*}"; }
# An Edit is a TOOL call, not a shell command — there's nowhere to inline OWN_FORCE=1 the way
# you would for TSGO_SKIP. So the override is stateful, time-boxed and loud: `own force <lane>`,
# honoured only for the pid that asked, expiring on its own so a 2am override can't become the
# permanent state of the repo. OWN_FORCE=1 still works for plain shell callers.
_forced(){ local lane="$1" v pid exp mp
  [[ -n "${OWN_FORCE:-}" ]] && return 0
  v=$(gc "own.$lane.force" 2>/dev/null) || return 1
  [[ -n "$v" ]] || return 1
  pid="${v%% *}"; exp="${v##* }"
  (( NOW > exp )) && { gc --unset "own.$lane.force" 2>/dev/null; return 1; }
  mp=$(_mypid); [[ "$pid" == "${mp:-cli}" ]] || return 1
  return 0 }
# is lane $1 held by SOMEONE ELSE, right now? (0 = yes, hands off)
_held_by_other(){ local lane="$1" hp mp hs
  _active "$lane" || return 1
  hp=$(gc "own.$lane.pid" 2>/dev/null); mp=$(_mypid)
  [[ -n "$hp" && -n "$mp" && "$hp" != "$mp" ]] && return 0
  hs=$(gc "own.$lane.session" 2>/dev/null)
  [[ -n "$hs" && -n "$SID" && "$hs" != "$SID" ]] && return 0
  return 1 }
# "(you)" or "(sess 5bf6bd76)" or "(pid 21994)" — whatever identifies the holder to a reader.
_holder_tag(){ local lane="$1" hp hs mp
  hp=$(gc "own.$lane.pid" 2>/dev/null); hs=$(gc "own.$lane.session" 2>/dev/null); mp=$(_mypid)
  [[ -n "$mp" && "$hp" == "$mp" ]] && { print -rn -- " (you)"; return; }
  [[ -n "$hs" ]] && { print -rn -- " (sess ${hs%%-*})"; return; }
  [[ -n "$hp" ]] && print -rn -- " (pid $hp)"; }
_lane_for(){ local p="$1" best="" blen=0 line lane globs g
  while IFS= read -r line; do
    [[ "$line" == \#* || -z "${line// /}" ]] && continue
    lane="${line%% *}"; globs="${line#* }"
    for g in ${(s: :)globs}; do [[ "$p" == ${g}* && ${#g} -gt $blen ]] && { best="$lane"; blen=${#g}; }; done
  done < "$OWNERS"; print -r -- "$best"; }
_age(){ local h; h=$(gc "own.$1.held" 2>/dev/null) || return 1; [[ -n "$h" ]] && print -r -- $((NOW-h)) || return 1; }
_req(){ local r; r=$(gc "own.$1.req" 2>/dev/null) || return 1; [[ -n "$r" ]] && print -r -- $((NOW-r)) || return 1; }
_paths(){ grep "^$1 " "$OWNERS" | cut -d' ' -f2- | tr ' ' '\n' | sed '/^$/d;s/^/  /'; }
_lanes(){ grep -v '^#' "$OWNERS" | awk 'NF{print $1}'; }
_is_lane(){ grep -q "^$1 " "$OWNERS"; }
case "${1:-list}" in
  claim) [[ -n "${2:-}" ]] || { print "usage: own claim <lane>" >&2; exit 2; }
    # A misspelled lane must FAIL, not claim a lane that doesn't exist. 'own claim viewer-solid'
    # (the directory name, not the lane) wrote own.viewer-solid.* and printed "you hold it" — but
    # 'own list' iterates OWNERS, so the claim was invisible, the real [viewer] lane read free to
    # everyone else, and the phantom key outlived its session by three weeks (2026-07-16).
    _is_lane "$2" || { print "no such lane: $2 (see 'own list')" >&2; exit 2; }
    # A claim never STEALS. Claiming used to stamp unconditionally, so two sessions could each
    # be told "you hold [viewer]" and edit on for hours — the loser never learns it lost (it
    # cost a session a whole afternoon of lane-less edits, 2026-07-16). Hand-off goes through
    # 'own request' → the holder releases. Manual CLI (no OWN_SESSION) keeps the old behaviour.
    if _held_by_other "$2"; then
      print "[$2] is actively held by another live session — NOT claiming (that would silently steal it)." >&2
      print "  'own request $2' registers a request; they release, then you claim. 'own list' shows who." >&2
      exit 1
    fi
    gc "own.$2.held" "$NOW"; gc --unset "own.$2.req" 2>/dev/null; gc --unset "own.$2.slice" 2>/dev/null; _setowner "$2"
    print "you hold [$2] — edit these directly; patch anything else:"; _paths "$2" ;;
  slice) [[ $# -ge 3 ]] || { print "usage: own slice <name> <lane> [<lane>...]" >&2; exit 2; }
    local name="$2"; shift 2; local ln
    for ln in "$@"; do _is_lane "$ln" || { print "no such lane: $ln (see 'own list')" >&2; exit 2; }; done
    for ln in "$@"; do
      gc "own.$ln.held" "$NOW"; gc "own.$ln.slice" "$name"; gc --unset "own.$ln.req" 2>/dev/null; _setowner "$ln"
    done
    print "holding [${(j:, :)@}] for slice:$name — one feature across these lanes."
    print "the other session's 'own list' now shows WHY they're held. edit these directly; patch anything else." ;;
  force) [[ -n "${2:-}" ]] || { print "usage: own force <lane> [minutes]" >&2; exit 2; }
    _is_lane "$2" || { print "no such lane: $2 (see 'own list')" >&2; exit 2; }
    local mins="${3:-10}" mp=$(_mypid)
    gc "own.$2.force" "${mp:-cli} $((NOW + mins * 60))"
    print "⚠ forcing edits on [$2] for ${mins}m — the guard will let this session through and say so each time."
    print "  the holder is still working in there; the patch protocol exists for a reason."
    print "  'own unforce $2' drops it early; it expires on its own regardless." ;;
  unforce) [[ -n "${2:-}" ]] || { print "usage: own unforce <lane>" >&2; exit 2; }
    gc --unset "own.$2.force" 2>/dev/null; print "force dropped on [$2]" ;;
  request) [[ -n "${2:-}" ]] || { print "usage: own request <lane>" >&2; exit 2; }
    if _active "$2"; then
      gc "own.$2.req" "$NOW"; local a=$(_age "$2")
      print "[$2] is actively held (live holder${a:+, ${a}s ago}) — request registered."
      print "  the holder sees it on 'own list' and runs 'own release $2' to hand off; then 'own claim $2'."
    else
      gc "own.$2.held" "$NOW"; gc --unset "own.$2.req" 2>/dev/null; gc --unset "own.$2.slice" 2>/dev/null; _setowner "$2"
      print "[$2] was free/stale — claimed it. you hold it now:"; _paths "$2"
    fi ;;
  who) [[ -n "${2:-}" ]] || { print "usage: own who <path>" >&2; exit 2; }
    local l=$(_lane_for "$2"); [[ -z "$l" ]] && { print "$2 → (unowned)"; exit 0; }
    local sl=$(gc "own.$l.slice" 2>/dev/null) a; a=$(_age "$l" 2>/dev/null) || a=""
    _alive "$l"; local rc=$?
    # "a LIVE session" includes YOU. who used to report liveness without ever asking whose, so the
    # holder was told to patch-protocol against themselves 0s after claiming — wrong for exactly
    # the person most likely to ask (2026-07-16). Only claim YOU on a positive pid match: an
    # unresolvable self falls through to the warning, which is the safe way to be unsure.
    local hp=$(gc "own.$l.pid" 2>/dev/null) mp=$(_mypid)
    if (( rc == 0 )) && [[ -n "$mp" && "$hp" == "$mp" ]]; then
      print "$2 → [$l]${sl:+ (slice:$sl)} · ● held by YOU${a:+ (${a}s ago)} — edit it directly"
    elif (( rc == 0 )); then
      print "$2 → [$l]${sl:+ (slice:$sl)} · ● held by a LIVE session${a:+ (${a}s ago)} ⚠ use the patch protocol"
    elif (( rc == 1 )); then
      print "$2 → [$l]${sl:+ (slice:$sl)} · ✗ holder process gone — free to take${a:+ (claim was ${a}s old)}"
    elif [[ -n "$a" ]] && (( a < FRESH )); then
      print "$2 → [$l]${sl:+ (slice:$sl)} · held ${a}s ago (no pid; legacy) ⚠ likely ACTIVE — use the patch protocol"
    else
      print "$2 → [$l] · unclaimed"
    fi ;;
  list) local line lane a rq r sl liv
    while IFS= read -r line; do [[ "$line" == \#* || -z "${line// /}" ]] && continue
      lane="${line%% *}"; _alive "$lane"; local rc=$?
      if a=$(_age "$lane" 2>/dev/null); then h="held ${a}s ago"; else h="—"; fi
      # NAME the live holder. "● live" alone says a lane is taken but not by whom, so a session
      # that wants it has to guess — and guessed wrong: 5bf6bd76 read "● live", assumed the lane
      # belonged to the session that had mentioned claiming it that morning, and stood down for
      # someone who had already released it (2026-07-16). "who holds this" must be answerable.
      liv=""; (( rc == 0 )) && liv=" · ● live$(_holder_tag "$lane")"
      (( rc == 1 )) && liv=" · ✗ dead (free to take)"
      r=""; sl=$(gc "own.$lane.slice" 2>/dev/null); [[ -n "$sl" ]] && r=" · slice:$sl"
      if rq=$(_req "$lane" 2>/dev/null) && (( rq < FRESH )); then r="$r ⟵ requested ${rq}s ago"; fi
      printf '  %-9s %-15s %s%s%s\n' "$lane" "$h" "${line#* }" "$liv" "$r"; done < "$OWNERS" ;;
  release) local arg="${2:-}"; [[ -n "$arg" ]] || { print "usage: own release <lane|slice>" >&2; exit 2; }
    if _is_lane "$arg"; then
      # Releasing someone else's live lane wipes their claim without telling them — the other
      # half of the same footgun as a stealing claim. Yours, or dead, or nothing.
      if _held_by_other "$arg"; then
        print "[$arg] is held by another live session, not you — refusing to release their lane." >&2
        print "  they release it themselves; 'own request $arg' asks them to." >&2
        exit 1
      fi
      _clearowner "$arg"; print "released [$arg]"
    else   # not a lane → treat as a slice name; release every lane tagged with it
      local any=0 ln
      for ln in $(_lanes); do
        if [[ "$(gc "own.$ln.slice" 2>/dev/null)" == "$arg" ]]; then
          _clearowner "$ln"; print "released [$ln] (slice:$arg)"; any=1
        fi
      done
      [[ $any -eq 1 ]] || { print "no lane or slice named '$arg'" >&2; exit 1; }
    fi ;;
  guard) local p="${2:-}"; [[ -n "$p" ]] || exit 0      # PreToolUse hook entry — warn-only, NEVER blocks
    case "$p" in "$ROOT"/*) ;; *) exit 0 ;; esac          # only dotfiles paths are laned
    local rel="${p#$ROOT/}" lane=$(_lane_for "${p#$ROOT/}")
    [[ -n "$lane" ]] || exit 0
    # Held by someone else → warn and LEAVE THEIR CLAIM ALONE. This used to warn and then
    # auto-claim anyway, so "who holds it" decayed to "who edited last": every session that
    # touched a viewer file silently took the lane from the one actually working it, and the
    # next session was told THEY were the holder. A claim you can lose by someone else's
    # keystroke isn't a claim. (Also why a single stack-gates edit squatted [stack] 9.5h.)
    # _held_by_other compares PID too, so a hand-claimed lane (which records no .session,
    # since the CLI has no OWN_SESSION) is finally visible here instead of warning nobody.
    if _held_by_other "$lane"; then
      local sl=$(gc "own.$lane.slice" 2>/dev/null) a=$(_age "$lane" 2>/dev/null)
      if _forced "$lane"; then
        print -u2 "⚠ own: [$lane] is held by another LIVE session — FORCED past the guard, editing $rel anyway."
        exit 0
      fi
      # BLOCK. A warning here scrolled past a busy session and the edit landed on someone
      # else's file regardless — "aware, and letting it get stepped on" (Phil, 2026-07-16:
      # fail loudly and quickly rather than let everything get stepped on). Exit 2 is the
      # PreToolUse deny: the tool call never runs and this text goes back as the reason.
      print -u2 "✘ own: [$lane]${sl:+ (slice:$sl)} is held by another LIVE session${a:+ (${a}s ago)}."
      print -u2 "   BLOCKED — editing $rel would step on their work."
      print -u2 "   → patch it:  git worktree add --detach /tmp/wt HEAD && edit there"
      print -u2 "                git -C /tmp/wt diff > ~/.dotfiles/patches/<name>.patch && git apply --3way <patch>"
      print -u2 "   → hand off:  own request $lane      (they release, then you claim)"
      print -u2 "   → override:  own force $lane        (10m, this session only — then retry)"
      exit 2
    fi
    gc "own.$lane.held" "$NOW"; _setowner "$lane"        # free lane → register THIS session's activity
    exit 0 ;;
  *) print "usage: own {claim <lane>|slice <name> <lane>...|request <lane>|force <lane> [min]|unforce <lane>|who <path>|list|release <lane|slice>}" >&2; exit 2 ;;
esac
