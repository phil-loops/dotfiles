#!/usr/bin/env python3
"""stack-forest — project-scoped dependency tree model, in one fast process.

Two modes (the server maps endpoints to them):

  stack-forest <project|branch>        WAVE 1 — structure + per-node blessing
      counts + file rows (path+status), NO diffs. This is what paints the graph
      and tree-rail; it must be fast, so it does ~2 git calls per node (no diff,
      no jq) and fans the nodes out through a throttled thread pool.

  stack-forest --node <branch>         WAVE 2 — one node's file DIFFS (patch +
      since-blessed delta). Expensive, but scoped to a single node and fetched
      lazily when you actually look at it.

Resolution matches stack-review: parents/children from stack-branch.*.parent,
seeds from stack-project.*.branch, expand along the pointers. Bounded to the
project's connected component.
"""
import sys, os, re, json, subprocess
from concurrent.futures import ThreadPoolExecutor


def git_out(args):
    r = subprocess.run(["git", *args], capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ""


def contrib_id(parent, branch, path):
    """Rebase-stable identity of the branch's contribution to a file: the patch-id
    of `git diff -U0 parent...branch -- path`. Survives the parent moving underneath
    the branch, so an inherited upstream edit doesn't read as a change. "" if empty."""
    d = subprocess.run(["git", "diff", "-U0", f"{parent}...{branch}", "--", path],
                       capture_output=True, text=True).stdout
    if not d:
        return ""
    pid = subprocess.run(["git", "patch-id", "--stable"], input=d,
                         capture_output=True, text=True).stdout
    return pid.split()[0] if pid.strip() else ""


def blob_diff(a_blob, b_blob, path):
    """A file's blessed-blob → current-blob diff, with the real path in the headers — git
    names a blob-to-blob diff by hash, which renders as gibberish. "" if identical."""
    raw = git_out(["diff", a_blob, b_blob])
    if not raw:
        return ""
    out = []
    for ln in raw.split("\n"):
        if ln.startswith("diff --git "):
            out.append(f"diff --git a/{path} b/{path}")
        elif ln.startswith("--- "):
            out.append(f"--- a/{path}")
        elif ln.startswith("+++ "):
            out.append(f"+++ b/{path}")
        else:
            out.append(ln)
    return "\n".join(out)


# ---- args ----------------------------------------------------------------
argv = sys.argv[1:]
node_mode = False
if argv and argv[0] == "--node":
    node_mode = True
    argv = argv[1:]
# WAVE 2 can diff against an arbitrary upstream ref (default = the node's parent)
base = None
if "--base" in argv:
    i = argv.index("--base")
    base = argv[i + 1] if i + 1 < len(argv) else None
    del argv[i:i + 2]
target = (argv[0] if argv else git_out(["branch", "--show-current"])).strip()
if not target:
    print(json.dumps({"project": "", "roots": [], "nodes": {}}))
    sys.exit(0)
MAIN = git_out(["config", "stack.main-branch"]).strip() or "main"


def is_trunk(ref):
    """Forest boundary below a node: the trunk, or any remote-tracking ref — e.g. a
    review node's `origin/<base>` parent. A remote ref is never a local working node,
    so an upward walk must STOP at it without pulling it in as a phantom member."""
    return not ref or ref == MAIN or ref.startswith("origin/")


# Every branch ultimately merges into origin/main, so the trunk DIFF base is the REMOTE trunk,
# not local `main`. A stale local main lags a fetch and folds already-pushed commits into the
# diff (the "garbage diff" — a clean branch rendering as dozens of unrelated files). Falls back
# to local MAIN when there's no origin/<main> (no remote, or never fetched).
REMOTE_MAIN = (
    f"origin/{MAIN}"
    if git_out(["rev-parse", "--verify", "--quiet", f"origin/{MAIN}"]).strip()
    else MAIN
)


def trunk_base(parent):
    """A node's diff/bless base: its parent, except the local trunk resolves to origin/main
    (a non-trunk parent or an already-remote ref is returned unchanged)."""
    return REMOTE_MAIN if (not parent or parent == MAIN) else parent

# ---- one config read → parents / children / requires / project seeds ------
parents, children, seeds, requires, archived = {}, {}, {}, {}, set()
for line in git_out(["config", "--local", "--list"]).splitlines():
    if "=" not in line:
        continue
    k, v = line.split("=", 1)
    m = re.match(r"^stack-branch\.(.+)\.parent$", k)
    if m:
        parents[m.group(1)] = v
        continue
    # fan-in deps (multivar): branches a node carries beyond its single parent
    m = re.match(r"^stack-branch\.(.+)\.requires$", k)
    if m:
        requires.setdefault(m.group(1), []).append(v)
        continue
    # per-branch project tag (stack-branch.<b>.project = <name>) — the rot-free
    # successor to the stack-project.<name>.branch registry: the tag lives on the
    # branch, so deleting/renaming it can't dangle a central list. Both are read
    # during migration; a branch tagged into project N is a seed of N.
    m = re.match(r"^stack-branch\.(.+)\.project$", k)
    if m:
        seeds.setdefault(v, []).append(m.group(1))
        continue
    m = re.match(r"^stack-project\.(.+)\.branch$", k)
    if m:
        seeds.setdefault(m.group(1), []).append(v)
        continue
    # archived projects (stack-project.<name>.archived=true): registered but
    # hidden from the picker unless --projects --all asks for them.
    m = re.match(r"^stack-project\.(.+)\.archived$", k)
    if m and v.strip().lower() == "true":
        archived.add(m.group(1))
for b, p in parents.items():
    children.setdefault(p, []).append(b)
# a branch may appear in seeds from both the legacy registry and its per-branch
# tag during migration — dedupe (order-preserving) so counts/lists don't double.
seeds = {n: list(dict.fromkeys(bs)) for n, bs in seeds.items()}


def expand(seedlist):
    seen = set()

    def descend(b):
        for c in children.get(b, []):
            if c not in seen:
                seen.add(c)
                descend(c)
    for s in seedlist:
        cur = s
        while cur and not is_trunk(cur):
            seen.add(cur)
            cur = parents.get(cur, "")
        descend(s)
    # pull in `requires` deps (fan-in) + their chains until stable
    changed = True
    while changed:
        changed = False
        for b in list(seen):
            for req in requires.get(b, []):
                if req not in seen:
                    cur = req
                    while cur and not is_trunk(cur):
                        seen.add(cur)
                        cur = parents.get(cur, "")
                    descend(req)
                    changed = True
    return seen


# ---- "legal to merge into main" — pure topology, no PR data ---------------
# A branch is mergeable when nothing upstream still has a live ref: its parent is
# main (or already merged, so restack dropped the ref) AND every fan-in `requires`
# dep is likewise gone. One for-each-ref read makes it set membership — no per-
# branch git calls. This is the single source of truth the server splits by PR
# state into ready (has PR) vs candidate (no PR yet), and that graph.js marks.
_existing = set(git_out(["for-each-ref", "--format=%(refname:short)", "refs/heads"]).split())


def mergeable(b):
    upstream = ([parents.get(b, MAIN)] if not is_trunk(parents.get(b, MAIN)) else []) + requires.get(b, [])
    return not any(u in _existing for u in upstream)


def landed(b):
    """True when the branch already merged into origin/main but its ref lingers.
    `git cherry` marks each of the branch's commits '-' when a patch-equivalent
    commit exists upstream. The forest squashes each branch to ONE commit before
    merge, so the squash commit on main is patch-equal to the branch's lone
    commit → an all-'-' result means landed. Empty (no commits beyond base) or an
    absent origin/main → False. Catches what topology-mergeable + behind-count
    both miss: a squash-merged branch whose ref hasn't been cleaned up yet."""
    out = git_out(["cherry", "origin/main", b]).strip()
    return bool(out) and all(ln[:1] == "-" for ln in out.splitlines())


def _pr_rank(pr):
    # Prefer a live PR over a historical one when a branch name has been reused.
    return ({"OPEN": 3, "MERGED": 2, "CLOSED": 1}.get(pr["state"], 0), pr["number"] or 0)


def fetch_pr_state():
    """Authoritative per-branch PR state, read LIVE from GitHub — never cached.
    One batched `gh pr list` → {headRefName: {number,state,draft,url,review}}.
    GitHub is the source of truth for "merged?" (a squash-merge is invisible to
    local git by sha, which is why `landed()` is only a fragile fallback). Returns
    {} on any gh failure so the forest still renders. Checks rollup is omitted on
    purpose: statusCheckRollup makes gh fetch per-PR check runs (~15s for 300 PRs
    vs ~3s without) — fetch it lazily per open node instead."""
    limit = 500  # gh returns most-recent first, so the cap only drops OLDEST (inactive) PRs
    try:
        r = subprocess.run(
            ["gh", "pr", "list", "--state", "all", "--limit", str(limit), "--json",
             "headRefName,number,state,isDraft,url,reviewDecision"],
            capture_output=True, text=True, timeout=30,
        )
        prs = json.loads(r.stdout or "[]") if r.returncode == 0 else []
    except Exception:
        return {}
    if len(prs) >= limit:
        print(f"stack-forest: pr-state hit the {limit}-PR cap - the oldest PRs beyond it lose "
              "merged/draft badges and fall back to a slower local check; bump `limit`.",
              file=sys.stderr)
    out = {}
    for p in prs:
        ref = p.get("headRefName")
        if not ref:
            continue
        cur = {
            "number": p.get("number"),
            "state": p.get("state"),                    # OPEN | MERGED | CLOSED
            "draft": bool(p.get("isDraft")),
            "url": p.get("url"),
            "review": p.get("reviewDecision") or None,  # APPROVED | CHANGES_REQUESTED | REVIEW_REQUIRED
        }
        if ref not in out or _pr_rank(cur) > _pr_rank(out[ref]):
            out[ref] = cur
    return out


# ---- live PR state overlay -----------------------------------------------
# {headRefName: {number,state,draft,url,review}} straight from GitHub, no git, no
# cache. Kept OUT of the WAVE-1 tree so the graph paints instantly (git-only); the
# browser fetches this separately and overlays authoritative merged/draft/review
# badges when it resolves (~3s). GitHub is the source of truth for "merged?".
if not node_mode and target == "--pr-state":
    print(json.dumps(fetch_pr_state()))
    sys.exit(0)


# ---- project list (the picker) -------------------------------------------
# names + branch counts + the mergeable seed branches — no git diffs, instant. The
# browser shows these as buttons; clicking one opens ?branch=<name> (resolved below).
if not node_mode and target == "--projects":
    include_archived = "--all" in argv[1:]
    print(json.dumps([{"name": n, "branches": len(expand(seeds[n])),
                       "mergeable": [b for b in seeds[n] if mergeable(b)],
                       "archived": n in archived}
                      for n in sorted(seeds)
                      if include_archived or n not in archived]))
    sys.exit(0)


# ---- standalone branches (the picker's "pinned loose branches" section) ----
# An OPT-IN watch list: branches the user explicitly pinned (multivar
# `stack.standalone`), NOT auto-discovery. With ~1.5k stale local heads in a real
# repo, auto-listing every loose branch is noise — so nothing shows unless added.
# Each pinned branch that still exists emits a row {branch, commits, add, del};
# in the picker each opens as its own one-root view (?branch=X → expand([X])). A
# pinned branch is shown regardless of ahead-ness (you chose it); only a deleted
# ref drops out. numstat per branch, fanned out — the list is small by design.
if not node_mode and target == "--standalone":
    picked = [b.strip() for b in git_out(["config", "--get-all", "stack.standalone"]).splitlines() if b.strip()]
    existing = set(_existing)

    def standalone_row(b):
        if b not in existing:        # ref deleted out from under the config → drop
            return None
        base = git_out(["config", f"stack-branch.{b}.parent"]).strip() or MAIN
        n = git_out(["rev-list", "--count", f"{base}..{b}"]).strip()
        ahead = int(n) if n.isdigit() else 0
        add = dele = 0
        for ln in git_out(["diff", "--numstat", f"{base}...{b}"]).splitlines():
            parts = ln.split("\t")
            if len(parts) == 3:
                a, d, _ = parts
                add += 0 if a == "-" else int(a or 0)
                dele += 0 if d == "-" else int(d or 0)
        return {"branch": b, "commits": ahead, "add": add, "del": dele}

    rows = []
    if picked:
        workers = max(1, min(8, (os.cpu_count() or 4), len(picked)))
        with ThreadPoolExecutor(max_workers=workers) as ex:
            rows = [r for r in ex.map(standalone_row, picked) if r]
    rows.sort(key=lambda r: r["branch"])
    print(json.dumps(rows))
    sys.exit(0)


# ---- the blessing ledger, read once --------------------------------------
gd = git_out(["rev-parse", "--path-format=absolute", "--git-common-dir"]).strip()
try:
    ledger = json.load(open(os.path.join(gd, "stack-blessed.json")))
except Exception:
    ledger = {}
# contribution ledger (rebase-stable patch-ids) — preferred over the blob ledger
# when present; the blob ledger remains the fallback for legacy / nvim blesses.
try:
    contrib = json.load(open(os.path.join(gd, "stack-blessed-contrib.json")))
except Exception:
    contrib = {}

DIFF_HDR = re.compile(r"^diff --git a/(.+?) b/(.+)$")


def file_status(branch, parent):
    """(file rows with status, counts) — NO diffs. ~2 git calls, plus one cheap
    patch-id per file that carries a contribution bless."""
    blessed = ledger.get(branch, {})
    blessed_c = contrib.get(branch, {})
    toks = git_out(["diff", "--name-status", "-z", f"{parent}...{branch}"]).split("\x00")
    paths, deleted = [], set()
    i = 0
    while i < len(toks):
        st = toks[i]
        if not st:
            i += 1
            continue
        if st[0] == "R":
            p = toks[i + 2] if i + 2 < len(toks) else ""
            i += 3
        else:
            p = toks[i + 1] if i + 1 < len(toks) else ""
            i += 2
        if p:
            paths.append(p)
            if st[0] == "D":
                deleted.add(p)
    cur = {}
    live = [p for p in paths if p not in deleted]
    if live:
        cur = dict(zip(live, git_out(["rev-parse", *[f"{branch}:{p}" for p in live]]).split()))
    rows, clean = [], 0
    stale = unbl = 0
    for p in paths:
        bl, cu = blessed.get(p, ""), cur.get(p, "")
        blc = blessed_c.get(p, "")
        if blc:
            # blessed with a contribution id → compare the rebase-stable patch-id
            cuc = contrib_id(parent, branch, p)
            if cuc and cuc == blc:
                s = "clean"; clean += 1
            else:
                s = "stale"; stale += 1
        elif not bl:
            s = "unblessed"; unbl += 1
        elif bl == cu:          # legacy / nvim bless: blob fallback
            s = "clean"; clean += 1
        else:
            s = "stale"; stale += 1
        rows.append({"path": p, "status": s, "blessed": bl, "current": cu})
    # per-file +/- deltas (one numstat call) — for the node popover's file list
    nst = {}
    for ln in git_out(["diff", "--numstat", f"{parent}...{branch}"]).splitlines():
        parts = ln.split("\t")
        if len(parts) == 3:
            a, d, p = parts
            nst[p] = (0 if a == "-" else int(a or 0), 0 if d == "-" else int(d or 0))
    for r in rows:
        r["add"], r["del"] = nst.get(r["path"], (0, 0))
    return rows, clean, stale, unbl


# ---- WAVE 2: one node's diffs --------------------------------------------
if node_mode:
    branch = target
    parent = parents.get(branch, MAIN)
    # "last blessed" is per-file — blessing keys on each file's blob, there is no blessed
    # ref to diff against — so each file's patch is rebuilt from its blessed blob below.
    since_blessed = base == "blessed"
    # default view (and the explicit "vs main" button) diff against the REMOTE trunk, so a
    # root-on-main node is honest against what it merges into — a stale local main no longer
    # folds already-pushed commits into the diff. since-blessed keeps the local parent (it
    # diffs each file's blessed blob); an explicit non-trunk base is used verbatim.
    if since_blessed:
        diff_base = parent
    elif not base or base == MAIN:
        diff_base = trunk_base(parent if not base else MAIN)
    else:
        diff_base = base
    rows, *_ = file_status(branch, diff_base)
    # fan-in: drop carried `requires` files so the INCREMENTAL (parent) view shows
    # only own work. Against an arbitrary base (e.g. main) we want the FULL diff.
    reqs = requires.get(branch, []) if diff_base == parent else []
    if reqs:
        carried = set()
        for r in reqs:
            carried.update(git_out(["diff", "--name-only", f"{MAIN}...{r}"]).split())
        rows = [row for row in rows if row["path"] not in carried]
    chunks = {}
    full = git_out(["diff", "-p", f"{diff_base}...{branch}"])
    for ch in re.split(r"(?m)^(?=diff --git )", full):
        if ch.startswith("diff --git "):
            m = DIFF_HDR.match(ch.splitlines()[0])
            if m:
                chunks[m.group(2)] = ch.rstrip("\n") + "\n"
    files = []
    for r in rows:
        stale = ""
        if r["status"] == "stale" and r["blessed"] and r["current"]:
            stale = git_out(["diff", r["blessed"], r["current"]])
        if since_blessed:
            # what you haven't reviewed yet: an unblessed file shows its whole contribution;
            # a blessed file shows only the delta past its blessed blob (nothing if clean).
            if r["status"] == "unblessed":
                patch = chunks.get(r["path"], "")
            elif r["blessed"] and r["current"] and r["blessed"] != r["current"]:
                patch = blob_diff(r["blessed"], r["current"], r["path"])
            else:
                patch = ""
        else:
            patch = chunks.get(r["path"], "")
        files.append({"path": r["path"], "status": r["status"], "add": r["add"], "del": r["del"],
                      "patch": patch, "stale": stale})
    print(json.dumps({"branch": branch, "files": files}))
    sys.exit(0)

# ---- WAVE 1: the fast structural model -----------------------------------
project, members = "", set()
if target in ("--all", "*", ":forest:"):
    # the WHOLE forest: every tracked branch across all components, not just the
    # one reachable from a single leaf. roots = those whose parent is main.
    members = set(parents) | {b for cl in children.values() for b in cl} \
            | {r for rs in requires.values() for r in rs} \
            | {s for sd in seeds.values() for s in sd}
    members.discard(MAIN)
    project = "whole forest"
elif target in seeds:
    project, members = target, expand(seeds[target])
else:
    for name, sd in seeds.items():
        mem = expand(sd)
        if target in mem:
            project, members = name, mem
            break
    if not members:
        project, members = target, expand([target])


def build(branch):
    parent = parents.get(branch, MAIN)
    rows, clean, stale, unbl = file_status(branch, trunk_base(parent))
    # fan-in: a node CARRIES its `requires` deps' files (cherry-picked). Subtract
    # those paths so the node shows only its OWN work — clean counts, not the
    # carried content. (Path-level; the forest keeps one provider per file.)
    reqs = requires.get(branch, [])
    if reqs:
        carried = set()
        for r in reqs:
            carried.update(git_out(["diff", "--name-only", f"{MAIN}...{r}"]).split())
        rows = [row for row in rows if row["path"] not in carried]
        clean = sum(1 for r in rows if r["status"] == "clean")
        stale = sum(1 for r in rows if r["status"] == "stale")
        unbl = sum(1 for r in rows if r["status"] == "unblessed")
    if stale:
        roll = "stale"
    elif clean + stale == 0:
        roll = "unblessed"
    elif unbl:
        roll = "partial"
    else:
        roll = "clean"
    return branch, {
        "branch": branch, "parent": parent, "status": roll,
        "clean": clean, "stale": stale, "unblessed": unbl, "total": len(rows),
        "files": [{"path": r["path"], "status": r["status"], "add": r["add"], "del": r["del"]} for r in rows],
        "children": [c for c in children.get(branch, []) if c in members],
        "requires": [r for r in requires.get(branch, []) if r in members],
        "mergeable": mergeable(branch),
        "landed": landed(branch),
    }


# throttled fan-out — subprocess.run releases the GIL while git runs, so threads
# give real parallelism; the cap keeps a huge graph from spawning everything at once.
workers = max(1, min(8, (os.cpu_count() or 4), len(members) or 1))
with ThreadPoolExecutor(max_workers=workers) as ex:
    nodes = dict(ex.map(build, members))
roots = [b for b in members if parents.get(b, MAIN) not in members]

# ---- working-tree dirt per branch (the raw signal the map turns into "dams") --
# A branch's dirt = the tracked, uncommitted paths in the worktree it's checked
# out in. The map flags a branch as a dam when this set collides with a DOWNSTREAM
# node's own diff: once the dirt commits, those descendants conflict on rebase.
# Untracked (??) paths are excluded — rebase never touches them, so they can't
# conflict. Cheap: one `worktree list` + a `status` per member worktree.
def _worktree_branches():
    res, path = [], None
    for line in git_out(["worktree", "list", "--porcelain"]).splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):]
        elif line.startswith("branch "):
            if path:
                res.append((path, line[len("branch "):].replace("refs/heads/", "", 1)))
            path = None
        elif not line:
            path = None
    return res


def _dirty_paths(wt_path):
    out = subprocess.run(["git", "-C", wt_path, "status", "--porcelain"],
                         capture_output=True, text=True).stdout
    paths = set()
    for ln in out.splitlines():
        if len(ln) < 4 or ln[:2] == "??":
            continue
        rest = ln[3:]
        if " -> " in rest:                       # rename: both endpoints can collide
            old, new = rest.split(" -> ", 1)
            paths.add(old.strip().strip('"'))
            paths.add(new.strip().strip('"'))
        else:
            paths.add(rest.strip().strip('"'))
    return paths


for _wt, _br in _worktree_branches():
    if _br in nodes:
        dp = _dirty_paths(_wt)
        if dp:
            nodes[_br]["dirty"] = sorted(dp)

# ---- ghost "feature" node: the single culmination of a multi-leaf project. A
# phantom (no branch, no diff/bless) that fans in the project's un-subsumed TIPS —
# leaves not already carried by another node's `requires`. It maps to the ephemeral
# integration ref (stack-integrate octopus-merges the same tips), so its only action
# is an integrate preview. Emitted ONLY when >1 tip exists; a single-tip project
# already culminates in that tip. Pure topology — zero extra git calls.
if project and project != "whole forest":
    required = {r for b in members for r in requires.get(b, []) if r in members}
    tips = sorted(b for b in members if not nodes[b]["children"] and b not in required)
    if len(tips) > 1:
        ghost = f"✦ {project}"   # ✦ <project> — sentinel key, never a real branch
        nodes[ghost] = {
            "branch": ghost, "parent": MAIN, "ghost": True, "status": "ghost",
            "requires": tips, "children": [],
            "clean": 0, "stale": 0, "unblessed": 0, "total": 0, "files": [],
            "mergeable": False, "landed": False,
            "integration": f"refs/stack/{project}-integration",
        }
        roots.append(ghost)

print(json.dumps({"project": project, "roots": roots, "nodes": nodes}))
