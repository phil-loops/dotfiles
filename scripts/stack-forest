#!/usr/bin/env python3
"""stack-forest — project-scoped dependency tree model, in one fast process.

Two modes (the server maps endpoints to them):

  stack-forest <project|branch>        WAVE 1 — structure + per-node blessing
      counts + file rows (path+status), NO diffs. This is what paints the graph
      and tree-rail; it must be fast, so it does ~2 git calls per node (no diff,
      no jq) and fans the nodes out through a throttled thread pool.

  stack-forest --node <branch>         WAVE 2 — one node's file DIFFS (patch +
      since-blessed delta). Expensive, but scoped to a single node and fetched
      lazily when you actually look at it.

Resolution matches stack-review: parents/children from stack-branch.*.parent,
seeds from stack-project.*.branch, expand along the pointers. Bounded to the
project's connected component.
"""
import sys, os, re, json, subprocess
from concurrent.futures import ThreadPoolExecutor


def git_out(args):
    r = subprocess.run(["git", *args], capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ""


def contrib_id(parent, branch, path):
    """Rebase-stable identity of the branch's contribution to a file: the patch-id
    of `git diff -U0 parent...branch -- path`. Survives the parent moving underneath
    the branch, so an inherited upstream edit doesn't read as a change. "" if empty."""
    d = subprocess.run(["git", "diff", "-U0", f"{parent}...{branch}", "--", path],
                       capture_output=True, text=True).stdout
    if not d:
        return ""
    pid = subprocess.run(["git", "patch-id", "--stable"], input=d,
                         capture_output=True, text=True).stdout
    return pid.split()[0] if pid.strip() else ""


# ---- args ----------------------------------------------------------------
argv = sys.argv[1:]
node_mode = False
if argv and argv[0] == "--node":
    node_mode = True
    argv = argv[1:]
# WAVE 2 can diff against an arbitrary upstream ref (default = the node's parent)
base = None
if "--base" in argv:
    i = argv.index("--base")
    base = argv[i + 1] if i + 1 < len(argv) else None
    del argv[i:i + 2]
target = (argv[0] if argv else git_out(["branch", "--show-current"])).strip()
if not target:
    print(json.dumps({"project": "", "roots": [], "nodes": {}}))
    sys.exit(0)
MAIN = git_out(["config", "stack.main-branch"]).strip() or "main"

# ---- one config read → parents / children / requires / project seeds ------
parents, children, seeds, requires = {}, {}, {}, {}
for line in git_out(["config", "--local", "--list"]).splitlines():
    if "=" not in line:
        continue
    k, v = line.split("=", 1)
    m = re.match(r"^stack-branch\.(.+)\.parent$", k)
    if m:
        parents[m.group(1)] = v
        continue
    # fan-in deps (multivar): branches a node carries beyond its single parent
    m = re.match(r"^stack-branch\.(.+)\.requires$", k)
    if m:
        requires.setdefault(m.group(1), []).append(v)
        continue
    m = re.match(r"^stack-project\.(.+)\.branch$", k)
    if m:
        seeds.setdefault(m.group(1), []).append(v)
for b, p in parents.items():
    children.setdefault(p, []).append(b)


def expand(seedlist):
    seen = set()

    def descend(b):
        for c in children.get(b, []):
            if c not in seen:
                seen.add(c)
                descend(c)
    for s in seedlist:
        cur = s
        while cur and cur != MAIN:
            seen.add(cur)
            cur = parents.get(cur, "")
        descend(s)
    # pull in `requires` deps (fan-in) + their chains until stable
    changed = True
    while changed:
        changed = False
        for b in list(seen):
            for req in requires.get(b, []):
                if req not in seen:
                    cur = req
                    while cur and cur != MAIN:
                        seen.add(cur)
                        cur = parents.get(cur, "")
                    descend(req)
                    changed = True
    return seen


# ---- "legal to merge into main" — pure topology, no PR data ---------------
# A branch is mergeable when nothing upstream still has a live ref: its parent is
# main (or already merged, so restack dropped the ref) AND every fan-in `requires`
# dep is likewise gone. One for-each-ref read makes it set membership — no per-
# branch git calls. This is the single source of truth the server splits by PR
# state into ready (has PR) vs candidate (no PR yet), and that graph.js marks.
_existing = set(git_out(["for-each-ref", "--format=%(refname:short)", "refs/heads"]).split())


def mergeable(b):
    upstream = ([parents.get(b, MAIN)] if parents.get(b, MAIN) != MAIN else []) + requires.get(b, [])
    return not any(u in _existing for u in upstream)


# ---- project list (the picker) -------------------------------------------
# names + branch counts + the mergeable seed branches — no git diffs, instant. The
# browser shows these as buttons; clicking one opens ?branch=<name> (resolved below).
if not node_mode and target == "--projects":
    print(json.dumps([{"name": n, "branches": len(expand(seeds[n])),
                       "mergeable": [b for b in seeds[n] if mergeable(b)]}
                      for n in sorted(seeds)]))
    sys.exit(0)


# ---- standalone branches (the picker's "pinned loose branches" section) ----
# An OPT-IN watch list: branches the user explicitly pinned (multivar
# `stack.standalone`), NOT auto-discovery. With ~1.5k stale local heads in a real
# repo, auto-listing every loose branch is noise — so nothing shows unless added.
# Each pinned branch that still exists emits a row {branch, commits, add, del};
# in the picker each opens as its own one-root view (?branch=X → expand([X])). A
# pinned branch is shown regardless of ahead-ness (you chose it); only a deleted
# ref drops out. numstat per branch, fanned out — the list is small by design.
if not node_mode and target == "--standalone":
    picked = [b.strip() for b in git_out(["config", "--get-all", "stack.standalone"]).splitlines() if b.strip()]
    existing = set(_existing)

    def standalone_row(b):
        if b not in existing:        # ref deleted out from under the config → drop
            return None
        n = git_out(["rev-list", "--count", f"{MAIN}..{b}"]).strip()
        ahead = int(n) if n.isdigit() else 0
        add = dele = 0
        for ln in git_out(["diff", "--numstat", f"{MAIN}...{b}"]).splitlines():
            parts = ln.split("\t")
            if len(parts) == 3:
                a, d, _ = parts
                add += 0 if a == "-" else int(a or 0)
                dele += 0 if d == "-" else int(d or 0)
        return {"branch": b, "commits": ahead, "add": add, "del": dele}

    rows = []
    if picked:
        workers = max(1, min(8, (os.cpu_count() or 4), len(picked)))
        with ThreadPoolExecutor(max_workers=workers) as ex:
            rows = [r for r in ex.map(standalone_row, picked) if r]
    rows.sort(key=lambda r: r["branch"])
    print(json.dumps(rows))
    sys.exit(0)


# ---- the blessing ledger, read once --------------------------------------
gd = git_out(["rev-parse", "--path-format=absolute", "--git-common-dir"]).strip()
try:
    ledger = json.load(open(os.path.join(gd, "stack-blessed.json")))
except Exception:
    ledger = {}
# contribution ledger (rebase-stable patch-ids) — preferred over the blob ledger
# when present; the blob ledger remains the fallback for legacy / nvim blesses.
try:
    contrib = json.load(open(os.path.join(gd, "stack-blessed-contrib.json")))
except Exception:
    contrib = {}

DIFF_HDR = re.compile(r"^diff --git a/(.+?) b/(.+)$")


def file_status(branch, parent):
    """(file rows with status, counts) — NO diffs. ~2 git calls, plus one cheap
    patch-id per file that carries a contribution bless."""
    blessed = ledger.get(branch, {})
    blessed_c = contrib.get(branch, {})
    toks = git_out(["diff", "--name-status", "-z", f"{parent}...{branch}"]).split("\x00")
    paths, deleted = [], set()
    i = 0
    while i < len(toks):
        st = toks[i]
        if not st:
            i += 1
            continue
        if st[0] == "R":
            p = toks[i + 2] if i + 2 < len(toks) else ""
            i += 3
        else:
            p = toks[i + 1] if i + 1 < len(toks) else ""
            i += 2
        if p:
            paths.append(p)
            if st[0] == "D":
                deleted.add(p)
    cur = {}
    live = [p for p in paths if p not in deleted]
    if live:
        cur = dict(zip(live, git_out(["rev-parse", *[f"{branch}:{p}" for p in live]]).split()))
    rows, clean = [], 0
    stale = unbl = 0
    for p in paths:
        bl, cu = blessed.get(p, ""), cur.get(p, "")
        blc = blessed_c.get(p, "")
        if blc:
            # blessed with a contribution id → compare the rebase-stable patch-id
            cuc = contrib_id(parent, branch, p)
            if cuc and cuc == blc:
                s = "clean"; clean += 1
            else:
                s = "stale"; stale += 1
        elif not bl:
            s = "unblessed"; unbl += 1
        elif bl == cu:          # legacy / nvim bless: blob fallback
            s = "clean"; clean += 1
        else:
            s = "stale"; stale += 1
        rows.append({"path": p, "status": s, "blessed": bl, "current": cu})
    # per-file +/- deltas (one numstat call) — for the node popover's file list
    nst = {}
    for ln in git_out(["diff", "--numstat", f"{parent}...{branch}"]).splitlines():
        parts = ln.split("\t")
        if len(parts) == 3:
            a, d, p = parts
            nst[p] = (0 if a == "-" else int(a or 0), 0 if d == "-" else int(d or 0))
    for r in rows:
        r["add"], r["del"] = nst.get(r["path"], (0, 0))
    return rows, clean, stale, unbl


# ---- WAVE 2: one node's diffs --------------------------------------------
if node_mode:
    branch = target
    parent = parents.get(branch, MAIN)
    diff_base = base or parent            # diff vs any upstream node; default = parent
    rows, *_ = file_status(branch, diff_base)
    # fan-in: drop carried `requires` files so the INCREMENTAL (parent) view shows
    # only own work. Against an arbitrary base (e.g. main) we want the FULL diff.
    reqs = requires.get(branch, []) if diff_base == parent else []
    if reqs:
        carried = set()
        for r in reqs:
            carried.update(git_out(["diff", "--name-only", f"{MAIN}...{r}"]).split())
        rows = [row for row in rows if row["path"] not in carried]
    chunks = {}
    full = git_out(["diff", "-p", f"{diff_base}...{branch}"])
    for ch in re.split(r"(?m)^(?=diff --git )", full):
        if ch.startswith("diff --git "):
            m = DIFF_HDR.match(ch.splitlines()[0])
            if m:
                chunks[m.group(2)] = ch.rstrip("\n") + "\n"
    files = []
    for r in rows:
        stale = ""
        if r["status"] == "stale" and r["blessed"] and r["current"]:
            stale = git_out(["diff", r["blessed"], r["current"]])
        files.append({"path": r["path"], "status": r["status"], "add": r["add"], "del": r["del"],
                      "patch": chunks.get(r["path"], ""), "stale": stale})
    print(json.dumps({"branch": branch, "files": files}))
    sys.exit(0)

# ---- WAVE 1: the fast structural model -----------------------------------
project, members = "", set()
if target in ("--all", "*", ":forest:"):
    # the WHOLE forest: every tracked branch across all components, not just the
    # one reachable from a single leaf. roots = those whose parent is main.
    members = set(parents) | {b for cl in children.values() for b in cl} \
            | {r for rs in requires.values() for r in rs} \
            | {s for sd in seeds.values() for s in sd}
    members.discard(MAIN)
    project = "whole forest"
elif target in seeds:
    project, members = target, expand(seeds[target])
else:
    for name, sd in seeds.items():
        mem = expand(sd)
        if target in mem:
            project, members = name, mem
            break
    if not members:
        project, members = target, expand([target])


def build(branch):
    parent = parents.get(branch, MAIN)
    rows, clean, stale, unbl = file_status(branch, parent)
    # fan-in: a node CARRIES its `requires` deps' files (cherry-picked). Subtract
    # those paths so the node shows only its OWN work — clean counts, not the
    # carried content. (Path-level; the forest keeps one provider per file.)
    reqs = requires.get(branch, [])
    if reqs:
        carried = set()
        for r in reqs:
            carried.update(git_out(["diff", "--name-only", f"{MAIN}...{r}"]).split())
        rows = [row for row in rows if row["path"] not in carried]
        clean = sum(1 for r in rows if r["status"] == "clean")
        stale = sum(1 for r in rows if r["status"] == "stale")
        unbl = sum(1 for r in rows if r["status"] == "unblessed")
    if stale:
        roll = "stale"
    elif clean + stale == 0:
        roll = "unblessed"
    elif unbl:
        roll = "partial"
    else:
        roll = "clean"
    return branch, {
        "branch": branch, "parent": parent, "status": roll,
        "clean": clean, "stale": stale, "unblessed": unbl, "total": len(rows),
        "files": [{"path": r["path"], "status": r["status"], "add": r["add"], "del": r["del"]} for r in rows],
        "children": [c for c in children.get(branch, []) if c in members],
        "requires": [r for r in requires.get(branch, []) if r in members],
        "mergeable": mergeable(branch),
    }


# throttled fan-out — subprocess.run releases the GIL while git runs, so threads
# give real parallelism; the cap keeps a huge graph from spawning everything at once.
workers = max(1, min(8, (os.cpu_count() or 4), len(members) or 1))
with ThreadPoolExecutor(max_workers=workers) as ex:
    nodes = dict(ex.map(build, members))
roots = [b for b in members if parents.get(b, MAIN) not in members]
print(json.dumps({"project": project, "roots": roots, "nodes": nodes}))
