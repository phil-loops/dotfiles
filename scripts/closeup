#!/usr/bin/env python3
"""closeup — is this Claude session done, and if so, close its tmux pane.

  closeup check   what this session still has outstanding; exit 1 if anything, 0 if clean
  closeup close [--note <markdown> | --note -] [--dry]
                  post the closing handoff to Show's Inbox (the note, then the handoff table with
                  canopy links), then release this session's lanes and kill its own tmux pane.
                  Refuses unless the pane is provably this session's (its pane_pid is an ancestor
                  of the session's claude process — never inferred from pane_current_command), and
                  closes nothing when the Inbox post fails, so a handoff is never lost with the pane

`check` sees only what lives on disk: uncommitted changes in the session's checkout, dirty
files inside the dotfiles lanes it holds, canopy-todo items it still has `doing`, and
patches it wrote (claude-session-track records each) that haven't landed. It then prints a handoff table — every
branch this session made (its work-journal binding) with local vs origin, open PR and gates
verdict, read fresh — which never affects the exit code: it is what a closing message quotes
instead of recalling push state from the conversation. What only the conversation knows —
running background tasks, a question awaiting Phil, a promised follow-up — is the
/closeup skill's job to check before it calls `close`.
"""
import json, os, subprocess, sys, urllib.request

DOTFILES = os.path.expanduser("~/.dotfiles")
PRESENCE = os.path.expanduser("~/.claude/session-presence")


def sh(args, cwd=None):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=20, cwd=cwd).stdout
    except Exception:
        return ""


def session():
    """This session's presence record, found by its claude pid."""
    out = sh([os.path.join(DOTFILES, "scripts/claude-session-pid")]).split("\t")
    pid = int(out[0]) if out and out[0].strip().isdigit() else None
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    for name in os.listdir(PRESENCE) if os.path.isdir(PRESENCE) else []:
        try:
            rec = json.load(open(os.path.join(PRESENCE, name)))
        except Exception:
            continue
        if (sid and rec.get("session_id") == sid) or (pid and rec.get("pid") == pid):
            rec["pid"] = pid or rec.get("pid")
            return rec
    if pid:
        return {"pid": pid, "session_id": sid, "cwd": os.getcwd(), "started_at": 0, "tmux_pane": os.environ.get("TMUX_PANE")}
    sys.exit("closeup: can't find this session's claude process")


def my_lanes():
    """[(lane, [path prefixes])] the session holds, from `own list`."""
    lanes = []
    for line in sh(["own", "list"]).splitlines():
        if "(you)" not in line:
            continue
        cols = line.split()
        if not cols:
            continue
        mid = line.split("ago", 1)[-1].split("·")[0].split()
        lanes.append((cols[0], mid))
    return lanes


def check(rec):
    found = []
    cwd = rec.get("cwd") or os.getcwd()
    top = sh(["git", "-C", cwd, "rev-parse", "--show-toplevel"]).strip()
    if top and os.path.realpath(top) != os.path.realpath(DOTFILES):
        dirty = sh(["git", "-C", top, "status", "--short"]).splitlines()
        if dirty:
            found.append(f"uncommitted in {top}: " + ", ".join(l[3:] for l in dirty[:6]) + (" …" if len(dirty) > 6 else ""))

    lanes = my_lanes()
    if lanes:
        prefixes = [p for _, ps in lanes for p in ps]
        dirty = [l[3:] for l in sh(["git", "-C", DOTFILES, "status", "--short"]).splitlines()
                 if any(l[3:].startswith(p) for p in prefixes)]
        if dirty:
            found.append(f"uncommitted in your dotfiles lanes ({', '.join(n for n, _ in lanes)}): " + ", ".join(dirty))

    short = (rec.get("session_id") or "")[:8]
    mine = []
    tdir = os.path.join(DOTFILES, "canopy/todo")
    for f in sorted(os.listdir(tdir)) if short and os.path.isdir(tdir) else []:
        head = open(os.path.join(tdir, f)).read().split("+++")[1:2]
        meta = dict(l.split(" = ", 1) for l in (head[0].splitlines() if head else []) if " = " in l)
        if meta.get("owner", "").strip('"') == short and meta.get("state", "").strip('"') == "doing":
            mine.append(f[:-3])
    if mine:
        found.append("canopy-todo still doing: " + ", ".join(mine))

    pdir = os.path.join(DOTFILES, "patches")
    fresh = [f for f in rec.get("patches", []) if os.path.exists(os.path.join(pdir, f))]
    if fresh:
        found.append("patches this session wrote, not landed: " + ", ".join(fresh))

    for f in found:
        print("• " + f)
    if not found:
        print("nothing outstanding on disk")
    return 1 if found else 0


def repo_registry():
    """name -> main worktree, the same registry the viewer server builds (stack.viewer-repos)."""
    roots = sh(["git", "config", "--get-all", "stack.viewer-repos"]).split() or ["~/coding/loops", "~/coding/monotoad"]
    reg = {}
    for root in roots:
        path = os.path.expanduser(root)
        first = next((l[len("worktree "):] for l in sh(["git", "-C", path, "worktree", "list", "--porcelain"]).splitlines()
                      if l.startswith("worktree ")), None)
        if first:
            reg[os.path.basename(path)] = first
    return reg


def session_branches(rec):
    """[(repo, branch, project)] for the work bound to this session."""
    sid = rec.get("session_id") or ""
    if not sid:
        return []
    sys.path.insert(0, os.path.join(DOTFILES, "scripts/srv"))
    try:
        import workjournal
        j = workjournal.Journal()
        try:
            binding = j.binding(workjournal.CLAUDE_CODE_SOURCE, sid) or {}
            rows = []
            for w in binding.get("works", []):
                work = j.work(w if isinstance(w, str) else w.get("work_id")) or {}
                if work.get("repo") and work.get("branch"):
                    rows.append((work["repo"], work["branch"], work.get("project") or ""))
            return rows
        finally:
            j.close()
    except Exception as e:
        print(f"(handoffs: work journal unreadable — {e})")
        return []


def handoff_rows(rec):
    """[(repo, branch, local, origin, pr, gates, status)] read now from git, origin, gh and the viewer."""
    rows = session_branches(rec)
    if not rows:
        return []
    reg = repo_registry()
    table = []
    for repo in sorted({r for r, _, _ in rows}):
        path = reg.get(repo)
        mine = [(b, p) for r, b, p in rows if r == repo]
        if not path:
            table += [(repo, b, "?", "?", "", "?", f"repo {repo} not in stack.viewer-repos") for b, _ in mine]
            continue
        remote = {}
        for line in sh(["git", "-C", path, "ls-remote", "--heads", "origin"]).splitlines():
            sha, _, ref = line.partition("\t")
            remote[ref.removeprefix("refs/heads/")] = sha
        prs = {}
        try:
            for pr in json.loads(sh(["gh", "pr", "list", "--state", "open", "--limit", "300", "--json", "number,headRefName"], cwd=path) or "[]"):
                prs[pr["headRefName"]] = pr["number"]
        except ValueError:
            pass
        port = sh(["stack-review-port", path]).strip()
        try:
            state = json.load(urllib.request.urlopen(f"http://localhost:{port}/state", timeout=5))
            entities = state.get("entities", {}).get("branch", {})
        except Exception:
            entities = None
        for branch, _ in mine:
            local = sh(["git", "-C", path, "rev-parse", "--verify", "-q", f"refs/heads/{branch}"]).strip()
            origin = remote.get(branch, "")
            gates = "?" if entities is None else (entities.get(f"{repo}:{branch}", {}).get("gates") or "—")
            if not local:
                status = "deleted locally" + (" (still on origin)" if origin else "")
            elif not origin:
                status = "not pushed"
            elif local == origin:
                status = "pushed, nothing to push"
            else:
                # first-parent: a catch-up merge is one commit to push, not every main commit it brings in
                ahead = sh(["git", "-C", path, "rev-list", "--count", "--first-parent", f"{origin}..{local}"]).strip()
                behind = sh(["git", "-C", path, "rev-list", "--count", "--first-parent", f"{local}..{origin}"]).strip()
                if not ahead and not behind:
                    status = "origin moved (fetch to compare)"
                elif behind == "0":
                    status = f"{ahead} commit(s) to push"
                else:
                    status = f"diverged: {ahead} ahead, {behind} behind origin"
            pr = f"#{prs[branch]}" if branch in prs else "—"
            table.append((repo, branch, local[:10] or "—", origin[:10] or "—", pr, gates, status))
    return table


def handoffs(rec):
    table = handoff_rows(rec)
    if not table:
        return
    width = max(len(r[1]) for r in table)
    print("\nhandoffs (read now from git, origin, gh and the viewer — quote these, don't recall):")
    print(f"  {'branch':<{width}}  {'local':<10}  {'origin':<10}  {'PR':<7}  {'gates':<6}  status")
    for _, branch, local, origin, pr, gates, status in table:
        print(f"  {branch:<{width}}  {local:<10}  {origin:<10}  {pr:<7}  {gates:<6}  {status}")


def handoff_note(rec, note):
    """(title, markdown) for the Inbox: the session's closing note, then its branches as canopy links."""
    short = (rec.get("session_id") or "")[:8]
    topic = sh(["claude-say", "--topic", short]).strip() if short else ""
    topic = topic or os.path.basename(rec.get("cwd") or os.getcwd())
    parts = [note.strip()] if note and note.strip() else []
    table = handoff_rows(rec)
    if table:
        lines = ["| branch | PR | gates | status |", "|---|---|---|---|"]
        for repo, branch, _, _, pr, gates, status in table:
            lines.append(f"| [{branch}](canopy://v2/b/{repo}/{branch}) | {pr} | {gates} | {status} |")
        parts.append("\n".join(lines))
    return f"Closed: {topic}", "\n\n".join(parts) or "Closed with nothing to hand off."


def ancestors(pid):
    tree = {}
    for line in sh(["ps", "-axo", "pid=,ppid="]).splitlines():
        p = line.split()
        if len(p) == 2:
            tree[int(p[0])] = int(p[1])
    seen = []
    while pid and pid not in seen:
        seen.append(pid)
        pid = tree.get(pid)
    return seen


def close(rec, dry=False, pane=None, note=None):
    pane = pane or rec.get("tmux_pane") or os.environ.get("TMUX_PANE")
    if not pane:
        sys.exit("closeup: this session isn't in a tmux pane — nothing to close")
    pane_pid = sh(["tmux", "display-message", "-p", "-t", pane, "#{pane_pid}"]).strip()
    if not pane_pid.isdigit() or int(pane_pid) not in ancestors(rec["pid"]):
        sys.exit(f"closeup: pane {pane} (pane_pid {pane_pid or '?'}) isn't this session's — refusing")
    title, body = handoff_note(rec, note)
    if dry:
        print(f"would post to the Inbox: {title}\n{body}\n")
        print(f"would release {', '.join(l for l, _ in my_lanes()) or 'no lanes'} and close pane {pane} (pane_pid {pane_pid} owns claude {rec['pid']})")
        return
    try:
        posted = subprocess.run(["show-note", title, body], capture_output=True, text=True, timeout=30)
    except Exception as e:
        posted = None
        err = str(e)
    if not posted or posted.returncode != 0:
        err = posted.stderr.strip() if posted else err
        sys.exit(f"closeup: posting the handoff to the Inbox failed ({err or 'no output'}) — pane left open")
    for lane, _ in my_lanes():
        sh(["own", "release", lane])
    print(f"closing pane {pane}")
    sys.stdout.flush()
    subprocess.Popen(["sh", "-c", f"sleep 1; tmux kill-pane -t '{pane}'"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "check"
    rec = session()
    if cmd == "check":
        code = check(rec)
        handoffs(rec)
        sys.exit(code)
    if cmd == "close":
        args = sys.argv[2:]
        note = None
        if "--note" in args:
            i = args.index("--note")
            if i + 1 >= len(args):
                sys.exit("closeup: --note needs markdown, or - to read it from stdin")
            note = sys.stdin.read() if args[i + 1] == "-" else args[i + 1]
            del args[i:i + 2]
        close(rec, dry="--dry" in args, pane=next((a for a in args if a.startswith("%")), None), note=note)
        sys.exit(0)
    sys.exit(__doc__)
