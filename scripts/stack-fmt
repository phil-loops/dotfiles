#!/bin/zsh
# stack-fmt — make every branch in a stack-project oxfmt-clean, cascading.
#
# Usage: stack fmt <project>          # format the forest, commit + re-cascade
#        stack fmt <project> --check  # report drift only, write nothing (CI/gate)
#        stack fmt <project> --plan   # show topo order + per-branch drift, no writes
#
# Why this exists: oxfmt drift on a base branch can't be fixed in isolation — once you
# reformat a base, every descendant must rebase onto the new tip. Doing that by hand is
# the one-off this kills. It's the *fixer* paired with stack-gates' `format` gate (the
# detector): the gate goes red, `stack fmt` makes it green across the whole forest.
#
# Walk (bottom-up, mirrors stack-restack): snapshot every tip; for each branch in topo
# order, first rebase it onto its parent's *moved* tip (cut at the parent's snapshot),
# then oxfmt --write its own delta (.ts/.tsx changed vs merge-base(parent,branch)) and
# commit if anything changed. A branch's final tip becomes the cut for its children.
# main never moves (formatting never advances it), so roots only format.

set -u

MAIN_BRANCH=$(git config stack.main-branch 2>/dev/null || echo "main")
SELF_DIR="${0:A:h}"

PROJECT=""
MODE="write"   # write | check | plan
for arg in "$@"; do
  case "$arg" in
    --check) MODE="check" ;;
    --plan)  MODE="plan" ;;
    --*)     echo "stack-fmt: unknown flag $arg" >&2; exit 2 ;;
    *)       PROJECT="$arg" ;;
  esac
done
if [[ -z "$PROJECT" ]]; then
  echo "usage: stack fmt <project> [--check|--plan]" >&2
  exit 2
fi

# --- primitives mirrored from stack-restack (same config keys, same conventions) ---

git_locked() {
  local attempt out rc
  for attempt in 1 2 3 4 5; do
    out=$(git "$@" 2>&1); rc=$?
    [[ -n "$out" ]] && print -r -- "$out"
    [[ $rc -eq 0 || "$out" != *index.lock*"File exists"* ]] && return $rc
    sleep 0.$(( attempt * 15 ))
  done
  return $rc
}

worktree_of() {
  git worktree list --porcelain | awk -v b="refs/heads/$1" '
    $1 == "worktree" { p = $2 }
    $0 == "branch " b { print p; exit }
  '
}

# Materialize a branch and echo the directory its git ops run in: its worktree if it
# lives in one (already checked out there), else this repo after checking it out here.
# All subsequent ops use `git -C <dir>` so rebase state/abort stay addressable even
# mid-conflict (a plain `git checkout` would fail during a rebase).
prepare_branch_dir() {
  local wt=$(worktree_of "$1")
  if [[ -n "$wt" ]]; then echo "$wt"; return 0; fi
  git_locked checkout "$1" >/dev/null 2>&1 || return 1
  git rev-parse --show-toplevel
}

# Forest membership, expanded along the parent/requires graph via stack-forest (the
# same resolution the viewer uses), topo-sorted parents-before-children.
topo_order() {
  local project="$1"
  local -a members
  while IFS= read -r m; do
    [[ -n "$m" ]] && members+=("$m")
  done < <("${SELF_DIR}/stack-forest" "$project" 2>/dev/null | jq -r '.nodes // {} | keys[]' 2>/dev/null)
  if (( ${#members[@]} == 0 )); then
    while IFS= read -r m; do
      [[ -n "$m" ]] && members+=("$m")
    done < <(git config --get-all "stack-project.${project}.branch" 2>/dev/null)
  fi

  local -A is_member emitted
  for m in "${members[@]}"; do is_member[$m]=1; done
  local progress=1
  while (( progress )); do
    progress=0
    for m in "${members[@]}"; do
      [[ -n "${emitted[$m]:-}" ]] && continue
      local p=$(git config "branch.${m}.stack-parent" 2>/dev/null || git config "stack-branch.${m}.parent" 2>/dev/null || true)
      if [[ -z "${is_member[$p]:-}" ]] || [[ -n "${emitted[$p]:-}" ]]; then
        echo "$m"; emitted[$m]=1; progress=1
      fi
    done
  done
  for m in "${members[@]}"; do
    [[ -z "${emitted[$m]:-}" ]] && { echo "cycle in stack-branch parents near ${m}" >&2; return 1; }
  done
}

# Resolve an oxfmt binary once, absolute. oxfmt reads its config by walking up from each
# file, so an absolute binary run against repo-relative paths picks up the repo's config
# regardless of cwd. Prefer a repo-local install; fall back to PATH.
resolve_oxfmt() {
  local d
  for d in "$(git rev-parse --show-toplevel 2>/dev/null)" $(git worktree list --porcelain | awk '$1=="worktree"{print $2}'); do
    [[ -x "$d/node_modules/.bin/oxfmt" ]] && { echo "$d/node_modules/.bin/oxfmt"; return 0; }
  done
  command -v oxfmt 2>/dev/null && return 0
  return 1
}

OXFMT=$(resolve_oxfmt) || { echo "stack-fmt: no oxfmt binary found (repo node_modules or PATH)" >&2; exit 1; }

# .ts/.tsx files a branch contributes vs its merge-base with its parent, filtered to
# those still present in the branch tip (deletes/renames drop out).
delta_files() {
  local branch="$1" dir="$2" parent="$3"
  local base
  base=$(git -C "$dir" merge-base "$parent" "$branch" 2>/dev/null) || return 0
  git -C "$dir" diff --name-only --diff-filter=d "$base" "$branch" -- '*.ts' '*.tsx' 2>/dev/null
}

# --- walk ---

# Where this repo's HEAD started, so checkouts of non-worktree branches can be undone.
START_REF=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || git rev-parse HEAD 2>/dev/null)

typeset -A OLDTIP NEWTIP MOVED
typeset -a ORDER
while IFS= read -r b; do [[ -n "$b" ]] && ORDER+=("$b"); done < <(topo_order "$PROJECT") || exit 1
if (( ${#ORDER[@]} == 0 )); then
  echo "stack-fmt: no branches found for project '$PROJECT'" >&2
  exit 1
fi
for b in "${ORDER[@]}"; do OLDTIP[$b]=$(git rev-parse "$b" 2>/dev/null); NEWTIP[$b]="${OLDTIP[$b]}"; done

DRIFT=0   # for --check / --plan
FAIL=0

for b in "${ORDER[@]}"; do
  parent=$(git config "branch.${b}.stack-parent" 2>/dev/null || git config "stack-branch.${b}.parent" 2>/dev/null || echo "$MAIN_BRANCH")
  [[ -z "$parent" ]] && parent="$MAIN_BRANCH"
  if ! dir=$(prepare_branch_dir "$b"); then
    echo "  ✗ $b — could not check out; skipping" >&2; FAIL=1; continue
  fi

  # 1. Re-cascade: if the parent's tip moved (its own format commit), rebase this
  #    branch onto the new tip, cutting at the parent's snapshot. The parent's only
  #    new commit is `style: oxfmt`, so any conflict is whitespace-only — `-X theirs`
  #    resolves it semantically-identically and this branch's own format step (below)
  #    re-normalizes. A failure here is therefore a real (delete/modify) conflict.
  if [[ "$MODE" == "write" && -n "${MOVED[$parent]:-}" ]]; then
    if ! git -C "$dir" rebase -X theirs --onto "${NEWTIP[$parent]}" "${OLDTIP[$parent]}" "$b" >/dev/null 2>&1; then
      git -C "$dir" rebase --abort >/dev/null 2>&1
      echo "  ✗ $b — rebase onto reformatted ${parent} didn't auto-resolve; resolve by hand, then re-run" >&2
      FAIL=1
      break
    fi
  fi

  # 2. Format this branch's own delta (.ts/.tsx it contributes vs its parent).
  typeset -a files changed
  files=()
  while IFS= read -r f; do [[ -n "$f" ]] && files+=("$f"); done < <(delta_files "$b" "$dir" "$parent")

  if [[ "$MODE" == "write" ]]; then
    if (( ${#files[@]} == 0 )); then
      echo "  • $b — no .ts/.tsx delta"
    elif [[ -n "$(git -C "$dir" status --porcelain -- "${files[@]}" 2>/dev/null)" ]]; then
      echo "  ✗ $b — ${dir} has uncommitted changes in delta files; not formatting (commit/stash first)" >&2
      FAIL=1
    else
      ( cd "$dir" && "$OXFMT" "${files[@]}" >/dev/null 2>&1 )
      if [[ -n "$(git -C "$dir" status --porcelain -- "${files[@]}" 2>/dev/null)" ]]; then
        changed=("${(@f)$(git -C "$dir" diff --name-only -- "${files[@]}")}")
        git -C "$dir" add -- "${files[@]}"
        git -C "$dir" commit -q -m "style: oxfmt" -- "${files[@]}"
        echo "  ✓ $b — formatted ${#changed[@]} file(s), committed"
      else
        echo "  • $b — clean"
      fi
    fi
    # A moved tip (from the rebase above or a fresh format commit) means children must
    # re-cascade onto it.
    NEWTIP[$b]=$(git rev-parse "$b" 2>/dev/null)
    [[ "${NEWTIP[$b]}" != "${OLDTIP[$b]}" ]] && MOVED[$b]=1
  else
    if (( ${#files[@]} == 0 )); then
      [[ "$MODE" == "plan" ]] && echo "  • $b — no .ts/.tsx delta"
    elif ( cd "$dir" && "$OXFMT" --check "${files[@]}" >/dev/null 2>&1 ); then
      [[ "$MODE" == "plan" ]] && echo "  • $b — clean"
    else
      DRIFT=1
      echo "  ✗ $b — oxfmt drift in delta files"
    fi
  fi
done

# Undo any checkouts we did in this repo (worktree branches were never moved here).
[[ -n "$START_REF" ]] && git_locked checkout "$START_REF" >/dev/null 2>&1 || true

if [[ "$MODE" == "write" ]]; then
  if (( FAIL )); then
    echo "stack-fmt: stopped with unresolved issues above." >&2
    exit 1
  fi
  echo "✓ forest oxfmt-clean"
else
  if (( DRIFT )); then exit 1; fi
  echo "✓ no oxfmt drift"
fi
