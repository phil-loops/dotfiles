#!/bin/zsh
# stack-open — open a file ON a branch in a warm, LSP-ready nvim.
#
# Materializes a per-branch scratch worktree (git objects shared with the main
# repo, node_modules symlinked, reset to the branch's current tip) so relative
# AND package imports resolve, then opens the file as a buffer in ONE persistent
# "review-nvim" via its --listen socket — warm tsserver, instant, full LSP.
# Launches the nvim (in the tmux 'loops' session) if it isn't already running.
#
#   stack-open <branch> <path> [<pos>]  ensure worktree + open <path> in the warm nvim;
#                                       <pos> lands the cursor: "<line>" or "<line>:<col>"
#   stack-open --here <path> [<pos>]   open <path> in the MAIN working checkout (no worktree)
#                                       — for jumping from a GitHub blob view to your editor
#   stack-open --prepare <branch>  create/refresh the worktree only (prefetch)
#   stack-open --prune [<days>]    remove scratch worktrees idle > days (default 3)
#   stack-open --gc [<days>] [--dry-run]   the expiry ladder, with a size report: idle > days
#                                       (default 1) loses its regenerable weight (a real
#                                       node_modules goes back to a symlink, .next goes), idle
#                                       > 3d loses the whole worktree. Runs on every open too,
#                                       quietly; a dir any live process sits in is never touched.
#
# A branch already checked out in a real worktree is opened there (editable);
# otherwise a scratch worktree under $STACK_OPEN_DIR is used.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

SCRATCH="${STACK_OPEN_DIR:-/tmp/stack-study}"
SOCK="${STACK_OPEN_SOCK:-/tmp/stack-review-nvim.sock}"
SESSION="${STACK_OPEN_TMUX:-loops}"

main_root=$(git rev-parse --show-toplevel)

_wt_list=""
wt_list(){   # the porcelain worktree list, computed once — it's repo-global and costs ~70ms at 147 worktrees
  [[ -n "$_wt_list" ]] || _wt_list=$(git worktree list --porcelain)
  print -r -- "$_wt_list"
}

main_checkout(){   # the repo's FIRST worktree — the only one that really has node_modules/.gen.
                   # Not $main_root: we may be invoked from any sibling worktree, and hanging a
                   # scratch dir's node_modules off one of those breaks when it's removed.
  # `|| true`: awk exits on the first worktree, so the producer dies on SIGPIPE (141)
  local first; first=$(wt_list | awk '/^worktree /{print $2; exit}') || true
  print -r -- "${first:-$main_root}"
}

existing_worktree(){   # echo the path of a real worktree holding <branch>, if any
  # Claude session scratchpads (/tmp/claude-*/…) are deleted when their session ends — opening
  # into one strands Helix buffers and space-t watchers on a vanished dir; prefer our own scratch.
  # `|| true`: awk exits at the match, so the producer dies on SIGPIPE (141) — pipefail+set -e would abort the caller's ex=$(...)
  wt_list | awk -v ref="refs/heads/$1" '
    /^worktree /{p=substr($0,10)} /^branch /{if($2==ref && p !~ /^\/(private\/)?tmp\/claude-/){print p; exit}}' || true
}
install_followup_hook(){   # idempotently install the detached-HEAD → branch-follow post-commit hook
  # Scratch worktrees are DETACHED so they never lock the branch (you can still
  # rebase it in your main checkout). The cost: a commit here lands on a detached
  # HEAD and would strand. This hook advances the recorded branch ref to follow
  # any commit (`:wc` OR a plain `git commit`), so the branch — and the viewer —
  # keep up. It's a no-op in the main repo (HEAD attached) and in any detached
  # checkout without a stack-open marker, so it's safe in the shared hooks dir.
  local dir="$1" hooks hook
  hooks=$(git -C "$dir" rev-parse --git-path hooks); hook="$hooks/post-commit"
  [[ -s "$hook" ]] && ! grep -q stack-open-branch "$hook" 2>/dev/null && return 0   # non-empty foreign hook — don't clobber (empty file carries no logic to protect)
  mkdir -p "$hooks"
  cat > "$hook" <<'HOOK'
#!/bin/sh
# usage telemetry: log this commit's shape (branch/project/ahead/subject) before the
# scratch-worktree handling below early-exits on an attached HEAD. Detached + backgrounded
# so it adds zero latency and can never fail the commit. Lives in this canonical hook (not a
# hand-edit) so install_followup_hook's rewrite can't clobber it.
( "$HOME/.dotfiles/scripts/stack-usage-event" commit >/dev/null 2>&1 & )

# stack-open: advance a detached scratch review worktree's branch ref to follow
# commits, so `:wc` / `git commit` here don't strand on a detached HEAD.
git symbolic-ref -q HEAD >/dev/null 2>&1 && exit 0          # attached → not a scratch commit
marker="$(git rev-parse --git-dir)/stack-open-branch"
[ -f "$marker" ] || exit 0                                  # no marker → not a stack-open worktree
b=$(cat "$marker")
[ -n "$b" ] && git branch -f "$b" HEAD 2>/dev/null || true  # follow (skip silently if branch is locked elsewhere)
HOOK
  chmod +x "$hook"
}
_live_cwds=""
live_cwds(){   # every live process's cwd, computed once (~0.3s). Reclaiming under a running
               # process is the thing to never do: yanking a worktree a warm hx/nvim sits in
               # panics tsgo (typescript-go overlayfs.go:350), and a dev server loses its build.
  [[ -n "$_live_cwds" ]] || _live_cwds=$(lsof -a -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | sort -u) || true
  print -r -- "$_live_cwds"
}
in_use(){   # is <dir>, or anything under it, some live process's cwd?
  # An empty probe means lsof failed (it lives in /usr/sbin, off some PATHs), not that nothing
  # is running — the guard has to fail CLOSED, or a machine without lsof silently reclaims
  # everything, including the worktree a warm Helix is sitting in.
  local real cwds; cwds=$(live_cwds)
  [[ -n "$cwds" ]] || return 0
  real=$(cd "$1" 2>/dev/null && pwd -P) || real="$1"
  case $'\n'"$cwds"$'\n' in
    *$'\n'"$real"$'\n'*|*$'\n'"$real"/*) return 0;;
  esac
  return 1
}
idle_dirs(){ find "$SCRATCH" -maxdepth 1 -mindepth 1 -type d -mtime +"$1" 2>/dev/null }
ours(){   # $SCRATCH is one shared directory but stack-open runs from whatever repo you're in —
          # only reclaim from worktrees of THIS repo, whose node_modules we know the source of
  [[ "$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" == "$_common_dir" ]]
}
_common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || _common_dir=""
human_kb(){ (( $1 >= 1048576 )) && printf '%.1fG' $(( $1 / 1048576.0 )) || printf '%dM' $(( $1 / 1024 )) }

# What a scratch worktree may hold that stack-open can always make again. node_modules belongs
# here because ensure_worktree only ever wants a symlink to the main checkout's — a real 1.5G
# directory means something ran an install in the scratch dir and left it behind.
strip_fat(){   # <days> [--dry-run] — shed regenerable weight from worktrees nobody has opened
               # lately, but KEEP the checkout: a stripped worktree still opens instantly.
  [[ -d "$SCRATCH" ]] || return 0
  local days="$1" dry="${2:-}" d kb total=0 nm mine=0 clock
  nm="$(main_checkout)/node_modules"
  clock=$(mktemp)
  for d in ${(f)"$(idle_dirs "$days")"}; do
    [[ -n "$d" ]] || continue
    ours "$d" || continue
    mine=$(( mine + 1 ))
    in_use "$d" && continue
    # The idle clock must measure when YOU last opened this worktree, not when we last swept it:
    # stripping writes to the directory, and an mtime bumped by our own maintenance would hide
    # the dir from the removal rung for another three days.
    touch -r "$d" "$clock"
    # only when the symlink we'd put back would actually resolve — never trade 1.5G of working
    # deps for a dangling link
    if [[ -d "$d/node_modules" && ! -L "$d/node_modules" && -d "$nm" ]]; then
      kb=$(du -sk "$d/node_modules" 2>/dev/null | cut -f1) || kb=0
      total=$(( total + kb ))
      [[ -n "$dry" ]] || { rm -rf "$d/node_modules"; ln -sfn "$nm" "$d/node_modules"; }
      echo "  ${d:t}  $(human_kb ${kb:-0})  node_modules → symlink" >&2
    fi
    if [[ -d "$d/.next" ]]; then
      kb=$(du -sk "$d/.next" 2>/dev/null | cut -f1) || kb=0
      total=$(( total + kb ))
      [[ -n "$dry" ]] || rm -rf "$d/.next"
      echo "  ${d:t}  $(human_kb ${kb:-0})  .next build cache" >&2
    fi
    touch -r "$clock" "$d"
  done
  rm -f "$clock"
  if (( total > 0 )); then
    echo "stack-open: $(human_kb $total) ${dry:+would be }reclaimed from scratch worktrees idle > ${days}d" >&2
  elif (( mine == 0 )); then
    echo "stack-open: no scratch worktrees of ${_common_dir:h:t} are idle > ${days}d — nothing to reclaim" >&2
  fi
  return 0
}

prune_old(){ [[ -d "$SCRATCH" ]] || return 0
  local d
  for d in ${(f)"$(idle_dirs "${1:-3}")"}; do
    [[ -n "$d" ]] || continue
    # Ours to remove, or rubble belonging to no repo (a parked zombie). Another repo's worktree
    # is neither — $SCRATCH is one shared directory and we run from whatever repo you're in.
    if ! ours "$d" && git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then continue; fi
    in_use "$d" && continue
    git worktree remove --force "$d" 2>/dev/null || rm -rf "$d"
  done
  git worktree prune 2>/dev/null || true
}
seed_gen(){   # give <dir> a .gen so tsgo can resolve #trpc imports — without it the tRPC
              # client type COLLAPSES to the "collides with a built-in method" sentinel in
              # the editor (verified). A branch that leaves the router alone can just SHARE
              # main's .gen; only one that touches trpc/** needs its own writable copy to
              # rebuild into. Never blocks the open. NB: .gen does NOT reduce tsgo memory —
              # this is purely for correctness.
  local dir="$1" head marker src
  # source .gen from the MAIN checkout (first worktree), not wherever stack-open runs —
  # a sibling worktree has no .gen of its own (it's gitignored, only built in main).
  # `|| true`: awk exits on the first worktree, so the producer dies on SIGPIPE (141) — pipefail+set -e would abort the open
  src=$(wt_list | awk '/^worktree /{print $2; exit}') || true
  [[ -n "$src" && -d "$src/.gen" ]] || return 0                # nothing to seed from
  # Router untouched → main's .gen already IS this branch's .gen. Link it: copying was ~0.66s of
  # a ~1.7s cold open (the "COW clone is ~instant" claim was wrong — it clonefiles per file), and
  # it was paid BEFORE this check, so the overwhelmingly common branch paid for a copy it never used.
  if git -C "$dir" diff --quiet main...HEAD -- trpc 2>/dev/null; then
    [[ -e "$dir/.gen" ]] || ln -sfn "$src/.gen" "$dir/.gen"
    return 0
  fi
  # Touches the router → it needs a PRIVATE .gen, because the rebuild below writes into it;
  # rebuilding through a symlink would corrupt main's.
  [[ -L "$dir/.gen" ]] && rm -f "$dir/.gen"
  [[ -d "$dir/.gen" ]] || cp -cR "$src/.gen" "$dir/.gen" 2>/dev/null \
    || cp -R "$src/.gen" "$dir/.gen" 2>/dev/null || return 0   # COW clone, fall back to plain copy
  head=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || return 0
  marker="$dir/.gen/.stack-open-gen-sha"
  [[ -f "$marker" && "$(cat "$marker" 2>/dev/null)" == "$head" ]] && return 0   # already built for this HEAD
  # tsconfig.trpc-types.json moved under typescript/ (loops PR #9599); a pre-split branch
  # still carries it at the root, and stack-open opens old branches too.
  local proj=typescript/tsconfig.trpc-types.json
  [[ -f "$dir/$proj" ]] || proj=tsconfig.trpc-types.json
  [[ -f "$dir/$proj" ]] || return 0                             # no trpc-types project → keep the cloned baseline
  # tsgo emits these declarations ~3x faster (17s → 5s); tsc only when the link is missing.
  local compiler="$dir/node_modules/.bin/tsgo" runner=
  if [[ ! -x "$compiler" ]]; then
    compiler="$dir/node_modules/typescript/bin/tsc"
    runner="$HOME/.volta/bin/node"
  fi
  [[ -e "$compiler" ]] || return 0                              # no compiler → keep the cloned baseline
  # Single-flight lock. It only means "in flight" while its owner is alive: the viewer SIGKILLs
  # stack-open's whole process group at 8s, and a lock orphaned by that kill used to freeze this
  # worktree's .gen for good — every later open silently kept the stale #trpc types.
  local lock="$dir/.gen/.rebuilding" owner stale=""
  if ! mkdir "$lock" 2>/dev/null; then
    owner=$(cat "$lock/pid" 2>/dev/null) || true
    [[ -n "$owner" ]] && ! kill -0 "$owner" 2>/dev/null && stale=1
    [[ -n "$(find "$lock" -maxdepth 0 -mmin +30 2>/dev/null)" ]] && stale=1   # killed before it recorded a pid
    [[ -n "$stale" ]] || return 0
    rm -rf "$lock"; mkdir "$lock" 2>/dev/null || return 0
  fi
  # background incremental rebuild → stamp the sha, release the lock. Call the binary
  # DIRECTLY (never npx — backgrounded npx with no TTY hangs on its install prompt and
  # piles up runaway procs); tsc is a JS entrypoint so it needs node, tsgo is native.
  # The subshell must drop the inherited stdout/stderr too, not just silence the compiler: a
  # caller that pipes us (the server's Popen+communicate) waits for EOF on those fds, so holding
  # them open makes this "background" rebuild block the open for as long as the compile takes.
  ( cd "$dir" && ${runner:+"$runner"} "$compiler" --project "$proj" --pretty false >/dev/null 2>&1 \
      && echo "$head" > "$marker"; rm -rf "$lock" ) >/dev/null 2>&1 &!
  print -r -- $! > "$lock/pid" 2>/dev/null || true   # the rebuild outlives us; the lock follows IT, not this script
}
ensure_worktree(){   # echo a checkout dir for <branch> (real worktree, else scratch)
  local b="$1" ex dir
  ex=$(existing_worktree "$b"); if [[ -n "$ex" ]]; then echo "$ex"; return; fi
  mkdir -p "$SCRATCH"; dir="$SCRATCH/${b//\//_}"
  # Zombie: the dir survived but its .git gitfile didn't (prune racing a background --prepare).
  # Every `git -C "$dir"` below then fails into /dev/null and the marker write resolves to
  # `/stack-open-branch` — "read-only file system", a 500, and the viewer's useless open-failed
  # toast. Park it (never delete: it may hold unpushed scratch edits) and rebuild from scratch.
  if [[ -d "$dir" ]] && ! git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    local parked="${dir}.zombie-$(date +%Y%m%d%H%M%S)"
    mv "$dir" "$parked" 2>/dev/null \
      && echo "stack-open: $dir was no longer a worktree — parked at $parked, recreating" >&2
    git worktree prune 2>/dev/null || true
  fi
  if [[ -d "$dir" ]]; then
    # already at the branch's tip → skip the (~0.3s) re-checkout; only sync when it moved.
    # Retry until HEAD actually matches the tip: a concurrent prepare (background warm) holds
    # git's index.lock, and a single swallowed failure used to leave the worktree pinned to a
    # stale (e.g. force-pushed) head — so a precise line-open landed on an old snapshot. Loop a
    # few times instead of trusting one attempt.
    if [[ "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" != "$(git rev-parse "$b" 2>/dev/null)" ]]; then
      # The resync always wins: this worktree exists to show the branch as the viewer shows it,
      # so it must never sit on a stale head. Dirty tracked files would be eaten by the -f below
      # (and skipping the sync over them is what used to pin the worktree at an old snapshot for
      # good), so park them in a stash first — recover with `git -C <dir> stash list`. Untracked
      # files survive checkout -f untouched, so -uno keeps them out of the stash.
      if [[ -n "$(git -C "$dir" status --porcelain --untracked-files=no 2>/dev/null)" ]]; then
        git -C "$dir" stash push -q -m "stack-open: parked $b edits $(date +%Y-%m-%dT%H:%M:%S)" 2>/dev/null \
          && echo "stack-open: parked uncommitted $b edits in a stash — git -C $dir stash list" >&2
      fi
      for _ in 1 2 3 4 5; do
        git -C "$dir" checkout --detach -f "$b" -q 2>/dev/null \
          || git -C "$dir" reset --hard "$b" -q 2>/dev/null || true
        [[ "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" == "$(git rev-parse "$b" 2>/dev/null)" ]] && break
        sleep 0.2
      done
    fi
  else
    git worktree add --detach "$dir" "$b" -q
  fi
  [[ -e "$dir/node_modules" ]] || ln -sfn "$(main_checkout)/node_modules" "$dir/node_modules"
  seed_gen "$dir"   # .gen for #trpc resolution (clone now, branch-rebuild in background)
  "${0:A:h}/helix-tsgo-stamp" "$dir" 2>/dev/null || true   # local-only Helix→tsgo override
  # record the branch + install the follow-hook so commits here advance the ref
  # instead of stranding on the detached HEAD (see install_followup_hook).
  echo "$b" > "$(git -C "$dir" rev-parse --git-dir)/stack-open-branch"
  install_followup_hook "$dir"
  touch "$dir"; echo "$dir"
}
focus_terminal(){   # raise the GUI terminal hosting tmux so the buffer is actually visible
  local app="${STACK_OPEN_TERMINAL:-}"
  [[ "$app" == none ]] && return 0   # STACK_OPEN_TERMINAL=none — for scripted/batch opens, which
                                     # otherwise yank the user's focus once per call
  if [[ -z "$app" ]]; then case "${TERM_PROGRAM:-}" in
    iTerm.app)       app=iTerm ;;
    Apple_Terminal)  app=Terminal ;;
    WezTerm)         app=WezTerm ;;
    ghostty|Ghostty) app=Ghostty ;;
    vscode|cursor)   return 0 ;;   # integrated terminal — don't yank focus away
    # inside tmux TERM_PROGRAM=tmux (useless) — fall back to whichever known GUI terminal is running
    # `|| true`: head -1 closes early, so ps/grep die on SIGPIPE (141) — pipefail+set -e would abort the whole open
    *) app=$(ps -axo comm 2>/dev/null | grep -ioE 'iTerm|WezTerm|Alacritty|kitty|Ghostty|Terminal' | head -1) || true
       [[ -n "$app" ]] || app=Terminal ;;
  esac; fi
  [[ -n "$app" ]] && open -a "$app" >/dev/null 2>&1 || true
}
quiet_open(){ [[ "${STACK_OPEN_TERMINAL:-}" == none ]] }   # STACK_OPEN_TERMINAL=none — surface NOTHING:
                                                          # a tmux select-window yanks the human's
                                                          # focus just as surely as `open -a` does, so
                                                          # a scripted/batch open must skip both.

surface_review_window(){   # bring the warm nvim's tmux window to the front, reliably.
  # Identify it by the socket nvim's PID, not by name: tmux `automatic-rename` (on by
  # default) renames a window to its running command, so 'review-nvim' silently becomes
  # 'nvim' and a by-name select-window misses — which leaves you stranded on whatever
  # window you were on. PID match is rename-proof; then pin the name + turn the rename
  # off so it stays reliable, and select by index (unambiguous).
  local npid win
  quiet_open && return 0
  npid=$(nvim --server "$SOCK" --remote-expr 'getpid()' 2>/dev/null) || true
  if [[ -n "${npid:-}" ]]; then
    # `|| true`: the `break` closes the pipe early, so `tmux list-panes` dies on SIGPIPE (141) — pipefail+set -e would abort the open
    win=$(tmux list-panes -s -t "$SESSION" -F '#{window_index} #{pane_pid}' 2>/dev/null | while read -r idx ppid; do
      { [[ "$ppid" == "$npid" ]] || pgrep -P "$ppid" 2>/dev/null | grep -qx "$npid"; } && { print -r -- "$idx"; break; }
    done) || true
  fi
  # trailing `|| true`: awk exits at the match → tmux SIGPIPE (141); the substitution follows the final `||`, so set -e still applies
  [[ -n "${win:-}" ]] || win=$(tmux list-windows -t "$SESSION" -F '#{window_index} #{window_name}' 2>/dev/null | awk '$2=="review-nvim"{print $1; exit}') || true
  [[ -n "${win:-}" ]] || return 0
  tmux set-window-option -t "${SESSION}:${win}" automatic-rename off 2>/dev/null || true
  tmux rename-window -t "${SESSION}:${win}" review-nvim 2>/dev/null || true
  tmux select-window -t "${SESSION}:${win}" 2>/dev/null || true
}

hx_pane_line(){ tmux capture-pane -p -t "$1" 2>/dev/null | tail -"${2:-1}" }

typeset -F SECONDS
HX_DEADLINE=0
hx_out_of_time(){ (( HX_DEADLINE > 0 && SECONDS >= HX_DEADLINE )) }
             # Every poll below answers to ONE budget, because the caller kills us: the viewer
             # SIGKILLs stack-open's process group 8s into /open. The per-step caps alone add up
             # to ~17s, so a slow-but-working drive used to be killed mid-keystroke — with the
             # prompt half-typed and the undo guard never reached, which is the "it scribbled
             # into my file" report. Give up in time to recover and report instead.

HX_LOCK=""
hx_lock(){   # one driver per pane. Two hover+o presses landing at once is what turns a
             # stolen ':' prompt into keys typed straight into the file: the racer's Escape
             # closes the prompt mid-batch, ':cd <dir>' then runs 'c' as a change command and
             # the path types itself into the buffer (reproduced 2026-07-21).
  local lock="${TMPDIR:-/tmp}/stack-open-hx-${1//[^a-zA-Z0-9]/}.lock" i holder
  for i in {1..30}; do   # ~3s: waiting out the holder must still leave time to open cold
    hx_out_of_time && return 2   # 2 = out of budget, not contended — the caller says so out loud
    if mkdir "$lock" 2>/dev/null; then print -r -- $$ > "$lock/pid"; HX_LOCK="$lock"; return 0; fi
    holder=$(cat "$lock/pid" 2>/dev/null) || true
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then rm -rf "$lock"; continue; fi
    sleep 0.1
  done
  return 1
}
hx_unlock(){ [[ -n "$HX_LOCK" ]] && rm -rf "$HX_LOCK"; HX_LOCK=""; }

hx_modified(){ [[ "$(hx_pane_line "$1" 2)" == *"[+]"* ]] }   # Helix's unsaved-buffer marker

hx_verify_normal(){   # Escape until the pane's statusline proves NOR with no ':' prompt open
  local pane="$1" round i snap
  for round in 1 2 3; do
    tmux send-keys -t "$pane" Escape
    for i in {1..12}; do
      hx_out_of_time && return 1
      sleep 0.05
      snap=$(hx_pane_line "$pane" 2)
      if [[ "$snap" == *NOR* && "${snap##*$'\n'}" != :* ]]; then return 0; fi
    done
  done
  return 1
}

hx_cmd(){   # run one ':' command: open the prompt, watch the body echo back OUT of it, then Enter.
            # The echo is the only proof the keys reached Helix's command line rather than the
            # buffer — a prompt that closed under us otherwise edits the file silently.
  local pane="$1" cmd="$2" expect=":$2" i last width before opened=
  before=$(hx_pane_line "$pane")
  tmux send-keys -t "$pane" :
  for i in {1..30}; do
    hx_out_of_time && return 1
    sleep 0.05
    last=$(hx_pane_line "$pane")
    # the line must CHANGE into a prompt — Helix pre-fills it with a history suggestion, so
    # "starts with ':'" alone would also match a leftover frame from the previous open
    if [[ "$last" == :* && "$last" != "$before" ]]; then opened=1; break; fi
  done
  [[ -n "$opened" ]] || return 1
  width=$(tmux display -p -t "$pane" '#{pane_width}' 2>/dev/null) || width=0
  tmux send-keys -t "$pane" -l "$cmd"
  for i in {1..60}; do   # Helix's path completion needs >1s to echo a long path back
    hx_out_of_time && return 1
    sleep 0.05
    last=$(hx_pane_line "$pane")
    if [[ "$last" == "$expect" ]]; then tmux send-keys -t "$pane" Enter; return 0; fi
    # too long to fit — Helix scrolls the prompt, so only its tail is on screen
    if (( ${#expect} >= width )) && [[ -n "$last" && "$expect" == *"$last" ]]; then
      tmux send-keys -t "$pane" Enter; return 0
    fi
  done
  return 1
}

hx_goto_line(){   # land on <line> (no-op without one) through the verified ':' prompt — a bare
                  # '<n>gg' is at the mercy of Escape+digit coalescing, and lands on 21 for 121
  local pane="$1" line="$2"
  [[ -n "$line" ]] || return 0
  hx_verify_normal "$pane" || return 1
  hx_cmd "$pane" "goto ${line}"
}

hx_open(){   # open <file> in the warm review-hx tmux window (reuse via send-keys), else launch hx
             # cold; land the cursor on <line>. Helix has no --server socket, so "warm" is a tmux
             # send-keys trick. Realpath (:A) the paths so /tmp→/private/tmp matches Helix's cwd and
             # LSP picker entries (references, symbols) render project-relative instead of absolute.
  local dir="${1:A}" line="$2" file="${3:A}"
  [[ -n "$file" ]] || return 1
  local win pane retire=""
  # Target the PANE running hx, not the window: window-targeted keys land in the window's
  # ACTIVE pane, which after a space-t is often the test pager — ':open …' typed into less.
  # `|| true`: awk exits at the match → tmux SIGPIPE (141); pipefail+set -e would abort the open
  read -r win pane <<<"$(tmux list-panes -s -t "$SESSION" \
          -F '#{window_index} #{pane_id} #{pane_current_command} #{window_name}' 2>/dev/null \
        | awk '$3=="hx" && $4=="review-hx" {print $1, $2; exit}')" || true
  # Open by RELATIVE path once we've cd'd: Helix re-completes the whole prompt on every
  # keystroke, so a 100-char absolute path costs it over a second of stat()s per open.
  local rel_target="$file"; [[ "$file" == "$dir"/* ]] && rel_target="${file#$dir/}"
  if [[ -n "${pane:-}" ]]; then
    # Verify state, never sleep-and-hope: under load ESC+':' coalesce into Alt-: and the 'c' of
    # ':cd' runs as a change command — the rest of the keys typed themselves into the buffer as
    # text (2026-07-20, PR-9614 deep link). Poll the statusline for NOR / the ':' prompt before
    # each batch; if the pane won't verify, send nothing more and open a cold window instead.
    # :cd into this file's worktree first — the warm Helix's cwd is pinned to whichever scratch
    # worktree it was first launched in, and gd/reference pickers render entries relative to cwd,
    # so a file from any OTHER branch (every scratch worktree is a fresh path) shows absolute
    # without this. LSP workspace root is resolved per-file, so :cd never disturbs it.
    local dirty_before="" starved=""
    HX_DEADLINE=${STACK_OPEN_HX_BUDGET:-5}   # seconds of THIS script's life, not of the drive:
                                             # the worktree work before us spends the same 8s
    if hx_lock "$pane"; then
      hx_modified "$pane" && dirty_before=1
      if hx_verify_normal "$pane" \
         && hx_cmd "$pane" "cd ${dir}" \
         && hx_cmd "$pane" "open ${rel_target}"; then
        # The file IS open now — a cursor that didn't land is worth a warning, not a rival window.
        hx_goto_line "$pane" "$line" || echo "stack-open: opened $rel_target but couldn't land on line $line" >&2
      else
        hx_out_of_time && starved=1   # read it BEFORE the recovery extends the deadline
        # A batch that died mid-way may have typed its body into the buffer. Undo only when the
        # pane was clean before we touched it — that's the proof the edit is ours, not the human's.
        HX_DEADLINE=7   # cleaning up after ourselves outranks the open we just lost — still under the kill
        if hx_verify_normal "$pane" && [[ -z "$dirty_before" ]] && hx_modified "$pane"; then
          tmux send-keys -t "$pane" -l u
          echo "stack-open: a lost prompt typed into the buffer — undone" >&2
        fi
        if [[ -z "$starved" ]]; then
          echo "stack-open: review-hx pane wouldn't reach a known state; opening cold" >&2
          retire=1
        fi
        pane=""
      fi
      hx_unlock
    else
      local why=$?
      # Busy, not broken: someone else's batch has the pane. Retiring it here would orphan a
      # perfectly good warm Helix and send every later open to a rival window.
      (( why == 2 )) && starved=1 \
                     || echo "stack-open: another open is still driving review-hx; opening cold" >&2
      pane=""
    fi
    # Out of budget anywhere in there means the worktree work ate the 8s the viewer allows. The
    # pane is fine and now warm, so say so — piling a rival window on a healthy one is the disease.
    if [[ -n "$starved" ]]; then
      echo "stack-open: no time left to drive review-hx (cold worktree) — press o again, it's warm now" >&2
      return 1
    fi
  fi
  if [[ -z "${pane:-}" ]]; then
    # Retire whatever we couldn't drive before spawning its replacement, so the next hover+o
    # aims at the fresh window instead of the same stuck pane — that pileup is how one bad
    # open became four review-hx windows.
    local stale
    if [[ -n "$retire" ]]; then
      for stale in ${(f)"$(tmux list-windows -t "$SESSION" -F '#{window_index} #{window_name}' 2>/dev/null | awk '$2=="review-hx"{print $1}')"}; do
        [[ -n "$stale" ]] && tmux rename-window -t "${SESSION}:${stale}" review-hx-stale 2>/dev/null || true
      done
    fi
    local target="$file"; [[ -n "$line" ]] && target="${file}:${line}"
    tmux new-window -t "$SESSION" -n review-hx "cd ${(q)dir} && hx ${(q)target}" \
      || { echo "stack-open: couldn't open a tmux window (is the '$SESSION' session running?)" >&2; return 1; }
    win=$(tmux list-windows -t "$SESSION" -F '#{window_index} #{window_name}' 2>/dev/null | awk '$2=="review-hx"{print $1; exit}') || true
  fi
  if ! quiet_open && [[ -n "${win:-}" ]]; then
    tmux select-window -t "${SESSION}:${win}" 2>/dev/null || true
  fi
  focus_terminal
  return 0
}

case "${1:-}" in
  --prune)   prune_old "${2:-3}"; echo "pruned scratch worktrees idle > ${2:-3}d"; exit 0;;
  --gc)      # the whole expiry ladder, out loud: shed weight at <days>, remove the long-idle
    gcdays="${2:-1}"; [[ "$gcdays" == --dry-run ]] && gcdays=1
    gcdry=""; [[ "${2:-}" == --dry-run || "${3:-}" == --dry-run ]] && gcdry=1
    strip_fat "$gcdays" "$gcdry"
    [[ -n "$gcdry" ]] || prune_old 3
    echo "scratch now $(du -sh "$SCRATCH" 2>/dev/null | cut -f1) in $(ls -d "$SCRATCH"/*/ 2>/dev/null | wc -l | tr -d ' ') worktrees"
    exit 0;;
  --prepare) ensure_worktree "${2:?branch}" >/dev/null; exit 0;;
  --path)    ensure_worktree "${2:?branch}"; exit 0;;   # create-if-needed + print the checkout dir
  --review)  # open <branch> for whole-PR review: Helix → its changed files as buffers; nvim → the gm Diffview
    rbranch="${2:?usage: stack-open --review <branch>}"
    EDITOR_CHOICE="${STACK_OPEN_EDITOR:-$(git -C "$main_root" config stack.open-editor 2>/dev/null || true)}"
    if [[ "$EDITOR_CHOICE" == hx || "$EDITOR_CHOICE" == helix ]]; then
      # Helix has no Diffview — open the branch's first changed file (vs main) at its first hunk.
      rdir=$(ensure_worktree "$rbranch")
      mbref="origin/main"; git -C "$rdir" rev-parse -q --verify origin/main >/dev/null 2>&1 || mbref="main"
      first=$(git -C "$rdir" diff --name-only "${mbref}...${rbranch}" 2>/dev/null | head -1) || true
      if [[ -z "$first" ]]; then
        echo "review-opened $rbranch (no files changed vs ${mbref}) → nothing to open"; exit 0
      fi
      firstline=$(git -C "$rdir" diff -U0 "${mbref}...${rbranch}" -- "$first" 2>/dev/null \
                    | sed -n 's/^@@ -[0-9,]* +\([0-9]*\).*/\1/p' | head -1) || true
      hx_open "$rdir" "$firstline" "$rdir/$first" || exit 1
      echo "opened $first on $rbranch → review-hx"; exit 0
    fi
    rdir=$(ensure_worktree "$rbranch")   # nvim path only: the edit worktree for the <leader>gm Diffview
    to(){ perl -e 'alarm shift; exec @ARGV' "$@"; }   # bound every --server call (wedged-nvim guard)
    if [[ -S "$SOCK" ]] && to 2 nvim --server "$SOCK" --remote-expr '1' >/dev/null 2>&1; then
      # cd the warm nvim into the worktree so <leader>gm's git calls target THIS branch, then fire
      # the mapping (mapleader=space → " gm"). <C-\><C-N> forces normal mode first.
      to 4 nvim --server "$SOCK" --remote-send "<C-\><C-N>:cd ${rdir}<CR>" >/dev/null 2>&1 || true
      to 6 nvim --server "$SOCK" --remote-send "<C-\><C-N> gm" >/dev/null 2>&1 || true
    else
      rm -f "$SOCK"
      tmux new-window -t "$SESSION" -n review-nvim "cd ${(q)rdir} && nvim --listen ${(q)SOCK}" \
        || { echo "stack-open: couldn't open a tmux window (is the '$SESSION' session running?)" >&2; exit 1; }
    fi
    surface_review_window; focus_terminal
    echo "review-opened $rbranch (gm Diffview) → review-nvim ($rdir)"; exit 0;;
esac

if [[ "${1:-}" == "--here" ]]; then
  # Open a path in the MAIN working checkout (no branch worktree) — for "jump to this file
  # from a GitHub blob view", where you want your editable checkout at that line, not a
  # detached scratch worktree of the ref.
  rel="${2:?usage: stack-open --here <path> [<pos>]}"   # NOT `path` — that's zsh's $PATH array
  pos="${3:-}"
  branch="working tree"; dir="$main_root"
else
  branch="${1:?usage: stack-open <branch> <path> [<pos>]}"
  rel="${2:?usage: stack-open <branch> <path> [<pos>]}"   # NOT `path` — that's zsh's $PATH array
  pos="${3:-}"   # optional locator to land on: "<line>" or "<line>:<col>"
  # lazy self-clean, two rungs: shed regenerable weight after a day idle, remove the worktree
  # after three. Drops our pipes so it can't block a piped caller.
  ( strip_fat 1; prune_old 3 ) >/dev/null 2>&1 &!
  dir=$(ensure_worktree "$branch")
fi
file="$dir/$rel"
[[ -f "$file" ]] || { echo "stack-open: '$rel' not in $branch" >&2; exit 1; }

# Stale-worktree / force-push backstop. A requested line past EOF means this checkout is behind
# the file the reviewer sees on GitHub (its line numbers are for the live head). For a scratch
# worktree, force one more sync to the branch tip and re-measure; if the line still doesn't exist,
# land on the LAST line and warn (the caller surfaces it) instead of silently clamping onto a
# phantom line of an old snapshot — the "viewer lied" failure.
stale_warn=""
case "$pos" in <->) want_line="$pos";; <->:<->) want_line="${pos%%:*}";; *) want_line="";; esac
if [[ -n "$want_line" ]]; then
  nlines=$(wc -l < "$file" 2>/dev/null || echo 0)
  if (( want_line > nlines + 1 )); then
    if [[ "$dir" == "$SCRATCH"/* ]]; then
      git -C "$dir" checkout --detach -f "$branch" -q 2>/dev/null || git -C "$dir" reset --hard "$branch" -q 2>/dev/null || true
      nlines=$(wc -l < "$file" 2>/dev/null || echo 0)
    fi
    if (( want_line > nlines + 1 )); then
      stale_warn="line ${want_line} > ${nlines}-line file — opened at end; this checkout differs from GitHub (re-fetch the PR head)"
      pos="$nlines"
    fi
  fi
fi

# Resolve the opaque <pos> into nvim locators — THE one place the grammar lives.
# Grow it here (patterns, ranges) and callers/server never change.
#   warm_expr = a VimL command run synchronously after :edit;  launch_arg = a +cmd for a cold launch.
warm_expr=""; launch_arg=""
case "$pos" in
  "")        ;;                                                  # no position — open at top
  <->)       warm_expr="normal! ${pos}Gzz";        launch_arg="+${pos}" ;;          # line
  <->:<->)   warm_expr="call cursor(${pos%%:*},${pos##*:}) | normal! zz"
             launch_arg="+call cursor(${pos%%:*},${pos##*:})" ;;                    # line:col
  *)         echo "stack-open: unrecognized <pos> '$pos' — opening at top" >&2 ;;
esac

# ── editor seam ──────────────────────────────────────────────────────
# STACK_OPEN_EDITOR=hx (or `git config stack.open-editor hx`) routes file opens to Helix.
# Helix has no remote-control socket, so "warm" is a tmux trick: reuse a review-hx window
# via send-keys (:open + <n>gg), else launch `hx` cold — the CLI takes file:line directly.
# The --review Diffview stays nvim-only either way (it IS a nvim feature).
EDITOR_CHOICE="${STACK_OPEN_EDITOR:-$(git -C "$main_root" config stack.open-editor 2>/dev/null || true)}"
if [[ "$EDITOR_CHOICE" == hx || "$EDITOR_CHOICE" == helix ]]; then
  case "$pos" in <->) hxline="$pos";; <->:<->) hxline="${pos%%:*}";; *) hxline="";; esac
  hx_open "$dir" "$hxline" "$file" || exit 1
  [[ -n "$stale_warn" ]] && echo "stack-open: $stale_warn" >&2 || true
  echo "opened $rel on $branch → review-hx ($dir)"
  exit 0
fi

# Bound every --server call: a WEDGED review-nvim (stuck on a swap/other prompt) makes
# any --server request hang forever — that hangs /open and spins the viewer's hover+o
# indefinitely. macOS has no `timeout`; perl's alarm caps each call (the exec'd nvim
# inherits the pending alarm and dies on SIGALRM).
nvim_to(){ perl -e 'alarm shift; exec @ARGV' "$@"; }

if [[ -S "$SOCK" ]] && nvim_to 2 nvim --server "$SOCK" --remote-expr '1' >/dev/null 2>&1; then
  # close any leftover gm Diffview first — --remote-expr is synchronous, so it's gone before the
  # file opens; otherwise the file opens INSIDE the Diffview layout instead of as a clean buffer.
  nvim_to 4 nvim --server "$SOCK" --remote-expr 'execute("silent! DiffviewClose")' >/dev/null 2>&1 || true
  nvim_to 5 nvim --server "$SOCK" --remote "$file"          # warm instance — hot tsserver
  # Jump synchronously via --remote-expr — an RPC that nvim serializes AFTER the :edit's reload
  # on its main loop — instead of async --remote-send keys. Otherwise a file that changed on disk
  # (e.g. a re-fetched PR head) reloads WHILE the keystrokes arrive and the cursor lands wrong.
  # execute() also runs regardless of the user's current mode, so no <C-\><C-N> dance is needed.
  [[ -n "$warm_expr" ]] && nvim_to 3 nvim --server "$SOCK" --remote-expr "execute('${warm_expr}')" >/dev/null 2>&1 || true
else
  # Socket missing OR the probe timed out (a WEDGED nvim still holding it). Just rm +
  # respawn would leave the zombie alive while the new nvim binds a fresh socket → the
  # "N nvims contending on one socket" pileup. So reap whatever holds $SOCK first.
  if [[ -S "$SOCK" ]]; then
    stale=$(lsof -t "$SOCK" 2>/dev/null) || true   # lsof exits 1 when the socket file has no holder (stale) — don't let set -e abort
    [[ -n "$stale" ]] && kill -9 ${=stale} 2>/dev/null || true
  fi
  rm -f "$SOCK"
  cmd="nvim --listen ${(q)SOCK}"                   # single-string form (proven); (q) keeps spaces/parens intact
  [[ -n "$launch_arg" ]] && cmd+=" ${(q)launch_arg}"
  cmd+=" ${(q)file}"
  tmux new-window -t "$SESSION" -n review-nvim "$cmd" \
    || { echo "stack-open: couldn't open a tmux window (is the '$SESSION' session running?)" >&2; exit 1; }
fi
surface_review_window
focus_terminal
# stderr (not stdout): the server captures it as the response's `err`, which the GitHub→nvim
# toast shows even on a successful open — so a clamp-to-EOF reads as a visible warning, never silent.
[[ -n "$stale_warn" ]] && echo "stack-open: $stale_warn" >&2 || true
echo "opened $rel on $branch → review-nvim ($dir)"
