#!/bin/zsh
# Stack Integrate - build an ephemeral integration ref that octopus-merges all
# leaves of a stack-project on top of main. Represents the virtual "feature"
# node: what main looks like when the whole project ships.
#
# Usage: loops stack integrate <project>                  # build, print ref name
#        loops stack integrate <project> --check          # exit 0 if clean, 1 if conflicts
#        loops stack integrate <project> --status         # --check + report playground worktree state (k: v lines)
#        loops stack integrate <project> --worktree       # build + check out the playground worktree (refresh only if it has no tracked edits)
#        loops stack integrate <project> --worktree-reset # build + FORCE the playground onto the latest integration, discarding its tracked edits
#        loops stack integrate --all                      # build for every project
#
# --status/--worktree/--worktree-reset print machine-readable lines:
#   playground: <path> / exists: 0|1 / dirty: 0|1 / fresh: 0|1
# dirty = tracked edits only (-uno; untracked scratch files never block a refresh).
# fresh = the playground's HEAD TREE equals the integration ref's tree (sha compare
# would always differ — every rebuild mints a new merge commit).
#
# Ref name: refs/stack/<project>-integration  (under refs/stack/, not refs/heads/
# — invisible to `git branch`, ephemeral, never pushed). Refreshed on every call.
#
# Leaves = the DAG's tips over BOTH edge kinds: a member is not a leaf if another
# member's `parent` is it, OR if another member `requires` (carries) it — the
# carried copy already rides inside the requiring branch's history, adapted to
# that context, so merging the carried branch's own tip too would conflict with
# its adapted copy by construction.
#
# On conflict, exits 1 and prints which leaves conflict. Caller can then review
# leaves individually instead.

set -e

MAIN_BRANCH=$(git config stack.main-branch 2>/dev/null || echo "main")
CHECK_ONLY=0
STATUS=0
WORKTREE=0
RESET=0
ALL=0
PROJECT=""
for arg in "$@"; do
  case "$arg" in
    --check) CHECK_ONLY=1 ;;
    --status) STATUS=1 ;;
    --worktree) WORKTREE=1 ;;
    --worktree-reset) WORKTREE=1; RESET=1 ;;
    --all) ALL=1 ;;
    --*) echo "unknown flag: $arg" >&2; exit 2 ;;
    *) [[ -z "$PROJECT" ]] && PROJECT="$arg" ;;
  esac
done

# The playground worktree lives beside the MAIN repo root (never a worktree's own
# dir): <repo>-integ-<project>.
playground_path() {
  local project="$1"
  local common=$(git rev-parse --path-format=absolute --git-common-dir)
  local main_root=$(dirname "$common")
  echo "$(dirname "$main_root")/$(basename "$main_root")-integ-${project}"
}

# Tracked files a dev server rewrites as it boots (`next dev` repoints next-env.d.ts at its build
# dir). Counting those as edits freezes the playground on the first integration it ever served —
# a refresh refuses to run over tracked edits, so every later run silently gets stale code.
GENERATED=(next-env.d.ts)
GENERATED_EXCLUDE=("${GENERATED[@]/#/:(exclude)}")

# $1 = worktree path — the tracked edits that are actually a human's
playground_dirt() {
  git -C "$1" status --porcelain -uno -- . "${GENERATED_EXCLUDE[@]}" 2>/dev/null
}

report_playground() {
  local project="$1" ref="$2"
  local wt_path=$(playground_path "$project")
  echo "playground: $wt_path"
  if git -C "$wt_path" rev-parse --git-dir >/dev/null 2>&1; then
    echo "exists: 1"
    local dirty=0
    [[ -n $(playground_dirt "$wt_path") ]] && dirty=1
    echo "dirty: $dirty"
    local fresh=0
    if [[ -n "$ref" ]] && [[ $(git -C "$wt_path" rev-parse 'HEAD^{tree}' 2>/dev/null) == $(git rev-parse "${ref}^{tree}" 2>/dev/null) ]]; then
      fresh=1
    fi
    echo "fresh: $fresh"
  else
    echo "exists: 0"
  fi
}

# Check the integration ref out into the persistent playground worktree (detached
# HEAD). Refreshing never touches a playground with tracked edits — discarding
# those requires the explicit --worktree-reset. Untracked files always survive.
materialize_worktree() {
  local project="$1" ref="$2"
  local sha=$(git rev-parse "$ref")
  local wt_path=$(playground_path "$project")
  if git -C "$wt_path" rev-parse --git-dir >/dev/null 2>&1; then
    if (( RESET )); then
      git -C "$wt_path" checkout --force --detach "$sha" >/dev/null 2>&1
    elif [[ -n $(playground_dirt "$wt_path") ]]; then
      echo "playground has tracked edits — left as-is (--worktree-reset discards them)" >&2
    elif [[ $(git -C "$wt_path" rev-parse 'HEAD^{tree}') != $(git rev-parse "${ref}^{tree}") ]]; then
      git -C "$wt_path" checkout -- "${GENERATED[@]}" >/dev/null 2>&1 || true
      if ! git -C "$wt_path" checkout --detach "$sha" >/dev/null 2>&1; then
        echo "playground refresh failed — still on $(git -C "$wt_path" rev-parse --short HEAD)" >&2
      fi
    fi
  else
    git worktree add --detach "$wt_path" "$sha" >/dev/null 2>&1
  fi
  report_playground "$project" "$ref"
}

build_integration() {
  local project="$1"

  # Collect project members.
  local -a members
  while IFS= read -r m; do
    [[ -n "$m" ]] && members+=("$m")
  done < <(git config --get-all "stack-project.${project}.branch" 2>/dev/null || true)

  if (( ${#members[@]} == 0 )); then
    echo "no such project: $project" >&2
    return 2
  fi

  # Build is_member lookup.
  local -A is_member
  for m in "${members[@]}"; do is_member[$m]=1; done

  # Branches carried by another member via `requires` — their content already
  # rides inside the requiring branch's history, so they are covered, not leaves.
  local -A is_carried
  local r
  for m in "${members[@]}"; do
    while IFS= read -r r; do
      [[ -n "$r" ]] && is_carried[$r]=1
    done < <(git config --get-all "branch.${m}.stack-requires" 2>/dev/null || git config --get-all "stack-branch.${m}.requires" 2>/dev/null || true)
  done

  # Leaves = project members with no project-member child and no carrier.
  local -a leaves
  for m in "${members[@]}"; do
    local has_child=0
    for other in "${members[@]}"; do
      [[ "$other" == "$m" ]] && continue
      local op=$(git config "branch.${other}.stack-parent" 2>/dev/null || git config "stack-branch.${other}.parent" 2>/dev/null || true)
      if [[ "$op" == "$m" ]]; then has_child=1; break; fi
    done
    (( has_child == 0 )) && [[ -z "${is_carried[$m]:-}" ]] && leaves+=("$m")
  done

  if (( ${#leaves[@]} == 0 )); then
    echo "$project: no leaves (cycle in stack metadata?)" >&2
    return 2
  fi

  local ref="refs/stack/${project}-integration"

  # Single leaf: integration ref = leaf tip itself. No merge needed.
  if (( ${#leaves[@]} == 1 )); then
    git update-ref "$ref" "refs/heads/${leaves[1]}"
    if (( STATUS )); then report_playground "$project" "$ref"; return 0; fi
    if (( CHECK_ONLY )); then return 0; fi
    if (( WORKTREE )); then materialize_worktree "$project" "$ref"; return 0; fi
    echo "$ref"
    return 0
  fi

  # Multiple leaves: octopus merge them on top of main.
  # Done in a temp worktree to avoid disturbing user's checkout. Worktree at
  # detached HEAD on main; we merge leaves in, then capture the resulting tree.
  local repo_root=$(git rev-parse --show-toplevel)
  local tmp_wt=$(mktemp -d -t stack-integrate-XXXXXX)
  rmdir "$tmp_wt"   # git worktree add wants a non-existent path

  git worktree add --detach "$tmp_wt" "$MAIN_BRANCH" >/dev/null 2>&1

  local merge_msg="stack: integrate ${project} (${leaves[*]})"
  if ! git -C "$tmp_wt" merge --no-ff --no-edit -m "$merge_msg" "${leaves[@]}" >/dev/null 2>&1; then
    # Capture conflicting files before aborting.
    local -a conflict_files
    while IFS= read -r f; do
      [[ -n "$f" ]] && conflict_files+=("$f")
    done < <(git -C "$tmp_wt" diff --name-only --diff-filter=U 2>/dev/null)

    git -C "$tmp_wt" merge --abort 2>/dev/null || true

    # For each conflicting file, list the leaves that modify it (vs main).
    {
      echo "$project: octopus merge failed — leaves modify overlapping files."
      for f in "${conflict_files[@]}"; do
        echo "  $f"
        for leaf in "${leaves[@]}"; do
          if ! git -C "$tmp_wt" diff --quiet "$MAIN_BRANCH" "$leaf" -- "$f" 2>/dev/null; then
            echo "    • $leaf"
          fi
        done
      done
      echo "Resolve by linearizing the conflicting leaves (rebase one onto the other), carrying one into the other (requires), or review them separately."
    } >&2

    git worktree remove --force "$tmp_wt" >/dev/null 2>&1 || true
    if (( STATUS )); then report_playground "$project" ""; fi
    return 1
  fi

  local integration_sha=$(git -C "$tmp_wt" rev-parse HEAD)
  git update-ref "$ref" "$integration_sha"

  git worktree remove --force "$tmp_wt" >/dev/null 2>&1 || true

  if (( STATUS )); then report_playground "$project" "$ref"; return 0; fi
  if (( CHECK_ONLY )); then return 0; fi
  if (( WORKTREE )); then materialize_worktree "$project" "$ref"; return 0; fi
  echo "$ref"
  return 0
}

if (( ALL )); then
  typeset -a all_projects
  while IFS=' ' read -r key _; do
    [[ -z "$key" ]] && continue
    name="${key#stack-project.}"
    name="${name%.branch}"
    if [[ ! " ${all_projects[*]} " == *" $name "* ]]; then
      all_projects+=("$name")
    fi
  done < <(git config --get-regexp '^stack-project\..*\.branch$' 2>/dev/null || true)

  if (( ${#all_projects[@]} == 0 )); then
    echo "no stack-projects registered" >&2
    exit 1
  fi

  rc=0
  for p in "${all_projects[@]}"; do
    if build_integration "$p"; then
      :
    else
      rc=1
    fi
  done
  exit $rc
fi

if [[ -z "$PROJECT" ]]; then
  echo "Usage: loops stack integrate <project> [--check]" >&2
  echo "       loops stack integrate --all" >&2
  exit 2
fi

build_integration "$PROJECT"
