#!/bin/zsh
# Stack Integrate - build an ephemeral integration ref that replays a stack-project
# onto main the way it will land: every member, in canonical merge order
# (stack-merge-rank), its own commits cherry-picked onto the result so far, with
# commits that are already in (a carried `requires` copy, a patch main has) dropped
# as empty. Represents the virtual "feature" node: what main looks like when the
# whole project ships.
#
# Usage: stack integrate <project>                  # build, print ref name
#        stack integrate <project> --check          # exit 0 if clean, 1 if conflicts
#        stack integrate <project> --status         # --check + report playground worktree state (k: v lines)
#        stack integrate <project> --worktree       # build + check out the playground worktree (refresh only if it has no tracked edits)
#        stack integrate <project> --worktree-reset # build + FORCE the playground onto the latest integration, discarding its tracked edits
#        stack integrate --all                      # build for every project
#
# --status/--worktree/--worktree-reset print machine-readable lines:
#   playground: <path> / exists: 0|1 / dirty: 0|1 / fresh: 0|1
# dirty = tracked edits only (-uno; untracked scratch files never block a refresh).
# fresh = the playground's HEAD TREE equals the integration ref's tree (sha compare
# would always differ — every rebuild mints new commits).
#
# Ref name: refs/stack/<project>-integration  (under refs/stack/, not refs/heads/
# — invisible to `git branch`, ephemeral, never pushed). Refreshed on every call.
#
# Why a replay, not an octopus merge of the leaves: merging whole leaf histories
# compares a carried copy with its original as two unrelated edits, so a forest
# whose carrier later deletes or rewrites what it carried "conflicts" though
# landing it in order is clean (goal-flip-converter, 2026-11-17). Replaying in merge
# order is the landing itself, so it conflicts exactly when landing would. A commit
# whose patch is already applied is skipped by patch-id (`git cherry`), as rebase does.
# role=proof members are skipped: a proof branch duplicates the forest as one spike.
#
# On conflict, exits 1 and names the member that doesn't apply, the commit, the
# files, and the members already applied before it.

set -e

MAIN_BRANCH=$(git config stack.main-branch 2>/dev/null || echo "main")
CHECK_ONLY=0
STATUS=0
WORKTREE=0
RESET=0
ALL=0
PROJECT=""
for arg in "$@"; do
  case "$arg" in
    --check) CHECK_ONLY=1 ;;
    --status) STATUS=1 ;;
    --worktree) WORKTREE=1 ;;
    --worktree-reset) WORKTREE=1; RESET=1 ;;
    --all) ALL=1 ;;
    --*) echo "unknown flag: $arg" >&2; exit 2 ;;
    *) [[ -z "$PROJECT" ]] && PROJECT="$arg" ;;
  esac
done

# The playground worktree lives beside the MAIN repo root (never a worktree's own
# dir): <repo>-integ-<project>.
playground_path() {
  local project="$1"
  local common=$(git rev-parse --path-format=absolute --git-common-dir)
  local main_root=$(dirname "$common")
  echo "$(dirname "$main_root")/$(basename "$main_root")-integ-${project}"
}

# Tracked files a dev server rewrites as it boots (`next dev` repoints next-env.d.ts at its build
# dir). Counting those as edits freezes the playground on the first integration it ever served —
# a refresh refuses to run over tracked edits, so every later run silently gets stale code.
GENERATED=(next-env.d.ts)
GENERATED_EXCLUDE=("${GENERATED[@]/#/:(exclude)}")

# $1 = worktree path — the tracked edits that are actually a human's
playground_dirt() {
  git -C "$1" status --porcelain -uno -- . "${GENERATED_EXCLUDE[@]}" 2>/dev/null
}

report_playground() {
  local project="$1" ref="$2"
  local wt_path=$(playground_path "$project")
  echo "playground: $wt_path"
  if git -C "$wt_path" rev-parse --git-dir >/dev/null 2>&1; then
    echo "exists: 1"
    local dirty=0
    [[ -n $(playground_dirt "$wt_path") ]] && dirty=1
    echo "dirty: $dirty"
    local fresh=0
    if [[ -n "$ref" ]] && [[ $(git -C "$wt_path" rev-parse 'HEAD^{tree}' 2>/dev/null) == $(git rev-parse "${ref}^{tree}" 2>/dev/null) ]]; then
      fresh=1
    fi
    echo "fresh: $fresh"
  else
    echo "exists: 0"
  fi
}

# Check the integration ref out into the persistent playground worktree (detached
# HEAD). Refreshing never touches a playground with tracked edits — discarding
# those requires the explicit --worktree-reset. Untracked files always survive.
materialize_worktree() {
  local project="$1" ref="$2"
  local sha=$(git rev-parse "$ref")
  local wt_path=$(playground_path "$project")
  if git -C "$wt_path" rev-parse --git-dir >/dev/null 2>&1; then
    if (( RESET )); then
      git -C "$wt_path" checkout --force --detach "$sha" >/dev/null 2>&1
    elif [[ -n $(playground_dirt "$wt_path") ]]; then
      echo "playground has tracked edits — left as-is (--worktree-reset discards them)" >&2
    elif [[ $(git -C "$wt_path" rev-parse 'HEAD^{tree}') != $(git rev-parse "${ref}^{tree}") ]]; then
      git -C "$wt_path" checkout -- "${GENERATED[@]}" >/dev/null 2>&1 || true
      if ! git -C "$wt_path" checkout --detach "$sha" >/dev/null 2>&1; then
        echo "playground refresh failed — still on $(git -C "$wt_path" rev-parse --short HEAD)" >&2
      fi
    fi
  else
    git worktree add --detach "$wt_path" "$sha" >/dev/null 2>&1
  fi
  report_playground "$project" "$ref"
}

finish_integration() {
  local project="$1" ref="$2"
  if (( STATUS )); then report_playground "$project" "$ref"; return 0; fi
  if (( CHECK_ONLY )); then return 0; fi
  if (( WORKTREE )); then materialize_worktree "$project" "$ref"; return 0; fi
  echo "$ref"
}

build_integration() {
  local project="$1"

  local -a members
  while IFS= read -r m; do
    [[ -n "$m" ]] && members+=("$m")
  done < <(git config --get-all "stack-project.${project}.branch" 2>/dev/null || true)
  if (( ${#members[@]} == 0 )); then
    echo "no such project: $project" >&2
    return 2
  fi

  local -A is_member
  for m in "${members[@]}"; do
    git rev-parse -q --verify "refs/heads/$m" >/dev/null && is_member[$m]=1
  done

  local -a order
  while IFS= read -r m; do
    [[ -z "$m" ]] && continue
    [[ "$(git config "branch.${m}.stack-role" 2>/dev/null || true)" == "proof" ]] && continue
    git rev-parse --verify -q "refs/heads/$m" >/dev/null || continue
    order+=("$m")
  done < <(stack-merge-rank "$project" | jq -r '.order[]')
  if (( ${#order[@]} == 0 )); then
    echo "$project: nothing to integrate" >&2
    return 2
  fi

  # The newest main any member could have been cut from: a member based on
  # origin/main must not replay main's own newer commits as if they were its own.
  local base=$(git rev-parse "$MAIN_BRANCH")
  local upstream=$(git rev-parse -q --verify "origin/$MAIN_BRANCH" 2>/dev/null || true)
  if [[ -n "$upstream" ]] && git merge-base --is-ancestor "$base" "$upstream"; then
    base="$upstream"
  fi

  local ref="refs/stack/${project}-integration"
  local tmp_wt=$(mktemp -d -t stack-integrate-XXXXXX)
  rmdir "$tmp_wt"
  git -c core.hooksPath=/dev/null worktree add --detach "$tmp_wt" "$base" >/dev/null 2>&1
  local -a pick=(git -C "$tmp_wt" -c core.hooksPath=/dev/null -c user.name=stack-integrate -c user.email=stack-integrate@localhost)

  local -a applied
  local m parent from c
  for m in "${order[@]}"; do
    parent=$(git config "branch.${m}.stack-parent" 2>/dev/null || true)
    if [[ -n "$parent" && -n "${is_member[$parent]:-}" ]]; then
      from="refs/heads/$parent"
    else
      from="$base"
    fi
    # `git cherry` = what rebase skips: a commit whose patch is already applied (a
    # carried requires copy, a fix that landed through another member) is left out.
    for c in $(git -C "$tmp_wt" cherry HEAD "refs/heads/${m}" "$from" | awk '$1 == "+" { print $2 }'); do
      if ! "${pick[@]}" cherry-pick --empty=drop --allow-empty-message "$c" >/dev/null 2>&1; then
        local -a conflict_files
        conflict_files=("${(@f)$(git -C "$tmp_wt" diff --name-only --diff-filter=U 2>/dev/null)}")
        "${pick[@]}" cherry-pick --abort >/dev/null 2>&1 || true
        {
          echo "$project: $m doesn't apply in merge order — $(git log -1 --format='%h %s' "$c") conflicts in:"
          local f
          for f in "${conflict_files[@]}"; do [[ -n "$f" ]] && echo "  $f"; done
          if (( ${#applied[@]} )); then
            echo "after: ${applied[*]}"
          fi
          echo "Rebase $m onto what it builds on, or carry the branch it overlaps (requires)."
        } >&2
        git worktree remove --force "$tmp_wt" >/dev/null 2>&1 || true
        if (( STATUS )); then report_playground "$project" ""; fi
        return 1
      fi
    done
    applied+=("$m")
  done

  git update-ref "$ref" "$(git -C "$tmp_wt" rev-parse HEAD)"
  git worktree remove --force "$tmp_wt" >/dev/null 2>&1 || true
  finish_integration "$project" "$ref"
}

if (( ALL )); then
  typeset -a all_projects
  while IFS=' ' read -r key _; do
    [[ -z "$key" ]] && continue
    name="${key#stack-project.}"
    name="${name%.branch}"
    if [[ ! " ${all_projects[*]} " == *" $name "* ]]; then
      all_projects+=("$name")
    fi
  done < <(git config --get-regexp '^stack-project\..*\.branch$' 2>/dev/null || true)

  if (( ${#all_projects[@]} == 0 )); then
    echo "no stack-projects registered" >&2
    exit 1
  fi

  rc=0
  for p in "${all_projects[@]}"; do
    if build_integration "$p"; then
      :
    else
      rc=1
    fi
  done
  exit $rc
fi

if [[ -z "$PROJECT" ]]; then
  echo "Usage: stack integrate <project> [--check]" >&2
  echo "       stack integrate --all" >&2
  exit 2
fi

build_integration "$PROJECT"
