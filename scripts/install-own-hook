#!/bin/zsh
# install-own-hook — register the own hooks in GLOBAL ~/.claude/settings.json.
# Global (not project-scoped) so it catches dotfiles edits from ANY session cwd. The
# registration lives in an untracked file, so this tracked installer is its source of
# truth — re-run it on a fresh machine. Idempotent, and it HEALS a stale matcher in
# place: a hook registered before a vector was known (NotebookEdit, Bash) is upgraded
# rather than duplicated, so re-running is always the way to catch up.
#
# One hook: own-hook, on Edit/Write/MultiEdit/NotebookEdit. It PREVENTS the write
# (exit 2 = deny) because it is handed the tool call and the exact path — it knows WHO
# is writing WHAT before it happens.
#
# The Bash side (own-bash-hook) is RETIRED, not forgotten — see `retire` below, which
# actively unregisters it so a machine that installed it stops. It watched the disk after
# each shell command and accused whoever's window the change fell in. But mtime answers
# WHEN, never WHO: a lane holder saving their own file mid-window is indistinguishable
# from someone stomping it. It shipped 2 false accusations and 0 true ones in one hour —
# the second one named an innocent bystander and mailed the accusation to a third party.
# Detection on the raw-write path needs per-write PID (root-level tracing), not a clock.
# Hooks are hot-reloadable, so a running session picks these up without a restart.
emulate -L zsh; set -euo pipefail
python3 - "$HOME/.claude/settings.json" "${0:A:h}" <<'PY'
import json, sys, os
path, d = sys.argv[1], sys.argv[2]
want = [
    ("PreToolUse",  "Edit|Write|MultiEdit|NotebookEdit", f"{d}/own-hook"),
]
# Uninstalling has to be as automatic as installing. A retired hook left in an untracked
# settings.json keeps firing on every machine that already has it — and hooks hot-reload,
# so removing it here stops live sessions mid-flight. This is the only way to recall one.
retire = [f"{d}/own-bash-hook pre", f"{d}/own-bash-hook post"]
os.makedirs(os.path.dirname(path), exist_ok=True)
try:
    cfg = json.load(open(path))
except Exception:
    cfg = {}
dirty = False
for event, blocks in list(cfg.get("hooks", {}).items()):
    for blk in list(blocks):
        blk["hooks"] = [h for h in blk.get("hooks", []) if h.get("command") not in retire]
        if not blk["hooks"]:
            blocks.remove(blk)
            dirty = True
            print(f"✗ retired     {event:12} {blk.get('matcher')}")
for event, matcher, cmd in want:
    blocks = cfg.setdefault("hooks", {}).setdefault(event, [])
    blk = next((b for b in blocks if any(h.get("command") == cmd for h in b.get("hooks", []))), None)
    if blk is None:
        blocks.append({"matcher": matcher, "hooks": [{"type": "command", "command": cmd}]})
        dirty = True
        print(f"✓ registered  {event:12} {matcher:36} {cmd}")
    elif blk.get("matcher") != matcher:
        print(f"↻ healed      {event:12} {blk.get('matcher')!r} → {matcher!r}")
        blk["matcher"] = matcher
        dirty = True
    else:
        print(f"· already     {event:12} {matcher:36} {cmd}")
if dirty:
    json.dump(cfg, open(path, "w"), indent=2)
    open(path, "a").write("\n")
    print("→ wrote", path)
else:
    print("→ no change:", path)
PY
