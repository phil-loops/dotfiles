#!/usr/bin/env bash
# canopy [--focus] [/v2/... | canopy://...] — open canopy at a page: Show's canopy workspace (⌘6). From a Claude session
# the page arrives quietly (a notification) unless --focus or SHOW_FOCUS=1; from your terminal it comes forward. Show is
# canopy's only app and window. The headless tools below run the bare canopy binary instead — a
# plain executable, not an app, so nothing can open it as a second window — rebuilt when its sources changed.
#   canopy --build                 just (re)build; prints the binary's path
#   canopy --dump [--dump-wait s]  headless: hydrate + listen, print the world as JSON, exit
#   canopy --shoot <dir> --shot "<name>=/v2/… [keys…]" [--size WxH]   headless: draw pages to <dir>/<name>.png
#   canopy --bench [--page /v2/…]… [--budget ms] [--quick]   headless: time every key on every page; exit 1 if any is over
#   canopy --appearance light|dark|system
# For those, the server port is per repo: --port wins, else `stack-review-port` in --repo, else the
# current git repo's when a server listens there, else ~/coding/loops.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/canopy-native"
stamp="$cache/source.sha"
bin="$cache/canopy"

sources_sha() {
  (cd "$here" && find Package.swift Sources -type f -print0 | sort -z | xargs -0 shasum -a 256) | shasum -a 256 | cut -d' ' -f1
}

build() {
  local sha
  sha="$(sources_sha)"
  if [[ -x "$bin" && -f "$stamp" && "$(cat "$stamp")" == "$sha" ]]; then
    return
  fi
  echo "canopy: building…" >&2
  (cd "$here" && swift build -c release --product Canopy >&2)
  local out
  out="$(cd "$here" && swift build -c release --show-bin-path)"
  mkdir -p "$cache"
  # the fonts' resource bundle sits beside the binary, where Bundle.module looks
  rm -rf "$cache/canopy-native_CanopyUI.bundle"
  cp -R "$out/canopy-native_CanopyUI.bundle" "$cache/"
  cp "$out/Canopy" "$bin.new" && mv "$bin.new" "$bin"
  echo "$sha" > "$stamp"
}

port="" repo="" route="" headless=0 focus=()
pass=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --build) build; echo "$bin"; exit 0 ;;
    --focus) focus=(--focus); shift ;;
    --port) port="$2"; shift 2 ;;
    --repo) repo="$2"; shift 2 ;;
    --dump) headless=1; pass+=("--dump"); shift ;;
    --shoot) headless=1; pass+=("$1" "$2"); shift 2 ;;
    --bench) headless=1; pass+=("$1"); shift ;;
    --quick) pass+=("$1"); shift ;;
    --shot|--size|--page|--budget|--dump-wait|--appearance) pass+=("$1" "$2"); shift 2 ;;
    /v2*|canopy:*) route="$1"; shift ;;
    *) echo "canopy: unknown argument $1" >&2; exit 64 ;;
  esac
done

(( headless )) || exec "$here/../show" --canopy ${focus[@]+"${focus[@]}"} "$route"

port_of() { (cd "$1" && "$HOME/.dotfiles/scripts/stack-review-port") 2>/dev/null; }
listening() { nc -z 127.0.0.1 "$1" >/dev/null 2>&1; }

if [[ -z "$port" ]]; then
  if [[ -n "$repo" ]]; then
    port="$(port_of "$repo")"
  else
    here_repo="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if [[ -n "$here_repo" ]] && p="$(port_of "$here_repo")" && [[ -n "$p" ]] && listening "$p"; then
      repo="$here_repo" port="$p"
    else
      repo="$HOME/coding/loops" port="$(port_of "$repo")"
    fi
  fi
fi
[[ -n "$port" ]] || { echo "canopy: no server port (is \`stack web\` running?)" >&2; exit 69; }

build
args=(--port "$port" ${repo:+--repo "$repo"} ${route:+"$route"} ${pass[@]+"${pass[@]}"})

exec "$bin" "${args[@]}"
