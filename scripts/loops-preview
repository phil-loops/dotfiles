#!/usr/bin/env bash
# loops-preview — preview a loops worktree/branch on a side port WITHOUT disturbing
# the primary dev server (or another Claude session's checkout).
#
# Runs a web-only `next dev` for the given checkout in a detached tmux session, on
# an auto-picked free port, reusing the MAIN checkout's node_modules + .env and the
# already-running Docker services (Postgres/ClickHouse/Valkey/…). One tmux session
# per checkout, so several previews can run side by side. No second DB, no second
# Docker project, no collision with `task dev` on :3000.
#
# Usage:
#   loops-preview [dir] [--port N] [--main path] [--open]  # start (dir defaults to $PWD)
#   loops-preview [dir] --kill                             # stop the preview for that dir
#   loops-preview --list                                  # rich list: port · url · branch · age · state
#   loops-preview --json                                  # same, machine-readable (the viewer dock reads this)
#                                                         # both also surface UNMANAGED next-dev listeners
#                                                         # on :3000-3060 that no preview session owns
#   loops-preview --kill-all                              # stop every preview
#   loops-preview --reap [--older-than MINUTES]           # stop orphaned/crashed (and optionally old) previews
#
# Env: LOOPS_MAIN overrides the main checkout (default ~/coding/loops).
#
# Caveat: shares MAIN's built workspace packages (via the symlinked node_modules),
# so a preview that changes packages/* won't reflect those until MAIN rebuilds them.
# App code (app/, pages/, components/, trpc/, lib/) is compiled from the preview
# checkout itself, so UI/route changes show up fine.
set -euo pipefail

cyan() { printf '\033[36m▸ %s\033[0m\n' "$*"; }
dim()  { printf '\033[2m%s\033[0m\n' "$*"; }
err()  { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; }

MAIN="${LOOPS_MAIN:-$HOME/coding/loops}"
PORT=""
ACTION="start"
DIR=""
OLDER_THAN=""
OPEN=""

while [ $# -gt 0 ]; do
  case "$1" in
    --kill) ACTION="kill" ;;
    --kill-all) ACTION="kill-all" ;;
    --reap) ACTION="reap" ;;
    --list) ACTION="list" ;;
    --json) ACTION="json" ;;
    --open) OPEN=1 ;;
    --older-than) OLDER_THAN="${2:-}"; shift ;;
    --port) PORT="${2:-}"; shift ;;
    --main) MAIN="${2:-}"; shift ;;
    -*) err "unknown flag: $1"; exit 2 ;;
    *) DIR="$1" ;;
  esac
  shift
done

PREFIX="loops-preview-"
meta_of()    { printf '/tmp/%s%s.meta' "$PREFIX" "$1"; }        # $1 = NAME
sessions()   { tmux ls 2>/dev/null | sed -n "s/^\(${PREFIX}[^:]*\):.*/\1/p"; }
name_of()    { printf '%s' "${1#$PREFIX}"; }                     # $1 = SESSION → NAME
meta_get()   { [ -f "$1" ] && grep -m1 "^$2=" "$1" 2>/dev/null | cut -d= -f2- || true; }  # $1=metafile $2=KEY
listening()  { [ -n "$1" ] && lsof -iTCP:"$1" -sTCP:LISTEN -n >/dev/null 2>&1; }          # $1=PORT
age_secs()   { [ -n "$1" ] && echo $(( $(date +%s) - $1 )) || echo 0; }                   # $1=STARTED epoch
age_human()  { local s="$1"; [ "$s" -lt 60 ] && echo "${s}s" || { [ "$s" -lt 3600 ] && echo "$((s/60))m" || echo "$((s/3600))h"; }; }
# $1=DIR — a detached HEAD reports as detached@<sha>, not blank (blank made the dock fall back
# to the worktree name and hide that a server was pinned to an old commit). A stack-open scratch
# worktree is detached-but-intentional: it records the branch it stands in for, so prefer that
# name over the sha (ensure_worktree keeps it resynced to that branch's tip).
branch_of()  {
  local b gd
  b="$(git -C "$1" branch --show-current 2>/dev/null)" || { echo "(gone)"; return; }
  if [ -n "$b" ]; then echo "$b"; return; fi
  gd="$(git -C "$1" rev-parse --git-dir 2>/dev/null)"
  if [ -n "$gd" ] && [ -s "$gd/stack-open-branch" ]; then sed -n '1p' "$gd/stack-open-branch"; return; fi
  echo "detached@$(git -C "$1" rev-parse --short HEAD 2>/dev/null)"
}
behind_of()  { git -C "$1" rev-list --count HEAD..origin/main 2>/dev/null || true; }      # $1=DIR
json_esc()   { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
# state of one preview, echoed as: orphaned (dir gone) · up (listening) · dead (crashed, session lingers)
state_of()   { local dir="$1" port="$2"; { [ -z "$dir" ] || [ ! -d "$dir" ]; } && { echo orphaned; return; }; listening "$port" && echo up || echo dead; }

# Unmanaged next-dev listeners on :3000-3060 — servers no preview session owns (a leftover
# headless `next dev`, a `task dev` in a worktree). Echoes "PORT PID" per stray; $1 = ports
# already claimed by registered sessions.
stray_listeners() {
  local known=" $1 " port pid
  lsof -nP -iTCP:3000-3060 -sTCP:LISTEN 2>/dev/null \
    | awk 'NR>1 {n=split($9,a,":"); print a[n], $2}' | sort -u -k1,1n \
    | while read -r port pid; do
        case "$known" in *" $port "*) continue ;; esac
        ps -p "$pid" -o command= 2>/dev/null | grep -q next || continue
        echo "$port $pid"
      done
}
cwd_of()     { lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1; }     # $1=PID
pid_age() {  # $1=PID → seconds alive, from ps etime ([[dd-]hh:]mm:ss)
  local e d=0 h=0 m=0 s=0 rest
  e="$(ps -p "$1" -o etime= 2>/dev/null | tr -d ' ')"
  [ -n "$e" ] || { echo 0; return; }
  case "$e" in *-*) d="${e%%-*}"; e="${e#*-}" ;; esac
  case "$e" in
    *:*:*) h="${e%%:*}"; rest="${e#*:}"; m="${rest%%:*}"; s="${rest#*:}" ;;
    *)     m="${e%%:*}"; s="${e#*:}" ;;
  esac
  echo $(( 10#$d*86400 + 10#$h*3600 + 10#$m*60 + 10#$s ))
}

# Kill the listener on a port (whole process group, so the npx→npm→next tree dies together).
# Refuses anything that isn't a next dev server — this must never reach for a Docker service
# or an unrelated node process that happens to sit in the range.
kill_port() {
  local port="$1" pid pgid cmd
  pid="$(lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null | head -1)"
  [ -n "$pid" ] || { err "nothing listening on :$port"; exit 1; }
  cmd="$(ps -p "$pid" -o command= 2>/dev/null)"
  case "$cmd" in *next*) ;; *) err "refusing to kill :$port — not a next dev server ($cmd)"; exit 1 ;; esac
  pgid="$(ps -p "$pid" -o pgid= 2>/dev/null | tr -d ' ')"
  if [ -n "$pgid" ] && [ "$pgid" -gt 1 ] 2>/dev/null; then
    kill -TERM -- "-$pgid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  else
    kill -TERM "$pid" 2>/dev/null || true
  fi
  cyan "killed :$port (pid $pid)"
}

# Stop one session by NAME: kill tmux + drop its meta. Echoes nothing.
stop_one() {
  local name="$1"
  tmux kill-session -t "${PREFIX}${name}" 2>/dev/null || true
  rm -f "$(meta_of "$name")"
}

if [ "$ACTION" = "list" ]; then
  found=""
  reg_ports=""
  for s in $(sessions); do
    found=1
    name="$(name_of "$s")"; m="$(meta_of "$name")"
    port="$(meta_get "$m" PORT)"; dir="$(meta_get "$m" DIR)"; started="$(meta_get "$m" STARTED)"
    reg_ports="$reg_ports $port"
    state="$(state_of "$dir" "$port")"
    if [ -n "$dir" ] && [ -d "$dir" ]; then branch="$(branch_of "$dir")"; else branch="(dir gone)"; fi
    printf '  %-22s :%-5s  %-24s %-6s %s\n' \
      "$name" "${port:-?}" "$branch" "$(age_human "$(age_secs "$started")")" "$state"
    [ "$state" = "up" ] && dim "                         http://localhost:$port"
  done
  while read -r port pid; do
    [ -n "$port" ] || continue
    found=1
    dir="$(cwd_of "$pid")"
    branch=""; [ -n "$dir" ] && [ -d "$dir" ] && branch="$(branch_of "$dir")"
    printf '  %-22s :%-5s  %-24s %-6s %s\n' \
      "$(basename "${dir:-pid-$pid}")" "$port" "${branch:-?}" "$(age_human "$(pid_age "$pid")")" "unmanaged (pid $pid)"
    dim "                         http://localhost:$port"
  done <<EOF
$(stray_listeners "$reg_ports")
EOF
  [ -n "$found" ] || echo "no previews running"
  exit 0
fi

if [ "$ACTION" = "json" ]; then
  printf '['
  first=1
  reg_ports=""
  for s in $(sessions); do
    name="$(name_of "$s")"; m="$(meta_of "$name")"
    port="$(meta_get "$m" PORT)"; dir="$(meta_get "$m" DIR)"; started="$(meta_get "$m" STARTED)"
    reg_ports="$reg_ports $port"
    state="$(state_of "$dir" "$port")"
    if [ -n "$dir" ] && [ -d "$dir" ]; then branch="$(branch_of "$dir")"; behind="$(behind_of "$dir")"; else branch=""; behind=""; fi
    url=""; [ "$state" = "up" ] && url="http://localhost:$port"
    [ -n "$first" ] || printf ','
    first=""
    printf '{"name":"%s","port":"%s","dir":"%s","branch":"%s","started":"%s","age":"%s","state":"%s","url":"%s","managed":true,"behind":"%s"}' \
      "$(json_esc "$name")" "$(json_esc "$port")" "$(json_esc "$dir")" "$(json_esc "$branch")" \
      "$(json_esc "$started")" "$(json_esc "$(age_human "$(age_secs "$started")")")" "$(json_esc "$state")" "$(json_esc "$url")" \
      "$(json_esc "$behind")"
  done
  while read -r port pid; do
    [ -n "$port" ] || continue
    dir="$(cwd_of "$pid")"
    branch=""; behind=""
    if [ -n "$dir" ] && [ -d "$dir" ]; then branch="$(branch_of "$dir")"; behind="$(behind_of "$dir")"; fi
    [ -n "$first" ] || printf ','
    first=""
    printf '{"name":"%s","port":"%s","dir":"%s","branch":"%s","pid":"%s","age":"%s","state":"up","url":"http://localhost:%s","managed":false,"behind":"%s"}' \
      "$(json_esc "$(basename "${dir:-pid-$pid}")")" "$(json_esc "$port")" "$(json_esc "$dir")" "$(json_esc "$branch")" \
      "$(json_esc "$pid")" "$(json_esc "$(age_human "$(pid_age "$pid")")")" "$(json_esc "$port")" "$(json_esc "$behind")"
  done <<EOF
$(stray_listeners "$reg_ports")
EOF
  printf ']\n'
  exit 0
fi

if [ "$ACTION" = "kill-all" ]; then
  n=0
  for s in $(sessions); do stop_one "$(name_of "$s")"; n=$((n+1)); done
  cyan "killed $n preview(s)"
  exit 0
fi

if [ "$ACTION" = "reap" ]; then
  n=0
  for s in $(sessions); do
    name="$(name_of "$s")"; m="$(meta_of "$name")"
    port="$(meta_get "$m" PORT)"; dir="$(meta_get "$m" DIR)"; started="$(meta_get "$m" STARTED)"
    reason=""
    if [ -z "$dir" ] || [ ! -d "$dir" ]; then reason="orphaned (dir gone)"
    elif ! listening "$port"; then reason="dead (not listening on :$port)"
    elif [ -n "$OLDER_THAN" ] && [ "$(age_secs "$started")" -gt "$((OLDER_THAN * 60))" ]; then
      reason="older than ${OLDER_THAN}m"
    fi
    if [ -n "$reason" ]; then
      stop_one "$name"; cyan "reaped $name — $reason"; n=$((n+1))
    fi
  done
  [ "$n" -gt 0 ] || echo "nothing to reap"
  exit 0
fi

# --kill needs only the session NAME (basename of the path string) — never cd, so an orphaned
# preview whose worktree is already gone can still be torn down by the dir the dock recorded.
# With --port it kills by PORT instead: one dir can host both a registered preview and an
# unmanaged stray, so only the port names a server precisely.
if [ "$ACTION" = "kill" ]; then
  if [ -n "$PORT" ]; then
    for s in $(sessions); do
      name="$(name_of "$s")"
      if [ "$(meta_get "$(meta_of "$name")" PORT)" = "$PORT" ]; then
        stop_one "$name"; cyan "killed ${PREFIX}${name}"; exit 0
      fi
    done
    kill_port "$PORT"
    exit 0
  fi
  NAME="$(basename "${DIR:-$PWD}")"
  if tmux has-session -t "${PREFIX}${NAME}" 2>/dev/null; then
    stop_one "$NAME"; cyan "killed ${PREFIX}${NAME}"
  else
    rm -f "$(meta_of "$NAME")"; echo "no session ${PREFIX}${NAME}"
  fi
  exit 0
fi

DIR="$(cd "${DIR:-$PWD}" && pwd)"
NAME="$(basename "$DIR")"
SESSION="${PREFIX}${NAME}"
LOG="/tmp/$SESSION.log"
META="$(meta_of "$NAME")"

[ -f "$DIR/package.json" ] || { err "$DIR is not a loops checkout (no package.json)"; exit 1; }
MAIN="$(cd "$MAIN" && pwd)"

# Worktrees have no node_modules and don't carry untracked env files — borrow MAIN's.
if [ ! -e "$DIR/node_modules" ]; then
  ln -sfn "$MAIN/node_modules" "$DIR/node_modules"
  cyan "linked node_modules from $MAIN"
fi
for e in .env .env.local .env.development; do
  if [ -f "$MAIN/$e" ] && [ ! -e "$DIR/$e" ]; then
    ln -sfn "$MAIN/$e" "$DIR/$e"
    cyan "linked $e from $MAIN"
  fi
done

# Auto-pick the first free port (3010-3060) unless one was given.
if [ -z "$PORT" ]; then
  for p in $(seq 3010 3060); do
    if ! lsof -iTCP:"$p" -sTCP:LISTEN -n >/dev/null 2>&1; then PORT="$p"; break; fi
  done
fi
[ -n "$PORT" ] || { err "no free port in 3010-3060"; exit 1; }

# stale .next from a prior branch/session serves old route manifests — dynamic routes (/api/trpc/[trpc]) 404 and the client never bootstraps (blank page); rebuild clean
rm -rf "$DIR/.next"

tmux kill-session -t "$SESSION" 2>/dev/null || true
# --webpack: Turbopack rejects a node_modules symlink pointing outside the project dir (fatal
# "points out of the filesystem root"), and every preview borrows MAIN's node_modules that way
tmux new-session -d -s "$SESSION" "cd '$DIR' && npx next dev --webpack -p $PORT > '$LOG' 2>&1"
printf 'DIR=%s\nPORT=%s\nSTARTED=%s\n' "$DIR" "$PORT" "$(date +%s)" > "$META"

cyan "preview $NAME  →  http://localhost:$PORT"
cyan "branch:  $(branch_of "$DIR")"
cyan "watch:   tmux attach -t $SESSION   ·   log: $LOG"
cyan "stop:    loops-preview '$DIR' --kill"
echo "(clean build — first request compiles from scratch, ~20-60s)"
[ -n "$OPEN" ] && open "http://localhost:$PORT" || true
