#!/usr/bin/env bash
# loops-preview — preview a loops worktree/branch on a side port WITHOUT disturbing
# the primary dev server (or another Claude session's checkout).
#
# Runs a web-only `next dev` for the given checkout in a detached tmux session, on
# an auto-picked free port, reusing the MAIN checkout's node_modules + .env and the
# already-running Docker services (Postgres/ClickHouse/Valkey/…). One tmux session
# per checkout, so several previews can run side by side. No second DB, no second
# Docker project, no collision with `task dev` on :3000.
#
# Usage:
#   loops-preview [dir] [--port N] [--main path] [--open] [--jobs]  # start (dir defaults to $PWD)
#   loops-preview [dir] --kill                             # stop the preview for that dir
#   loops-preview --list                                  # rich list: port · url · branch · age · state
#   loops-preview --json                                  # same, machine-readable (the viewer dock reads this)
#                                                         # both also surface UNMANAGED next-dev listeners
#                                                         # on :3000-3060 that no preview session owns
#   loops-preview --kill-all                              # stop every preview
#   loops-preview --reap [--older-than MINUTES]           # stop orphaned/crashed (and optionally old) previews
#
# Env: LOOPS_MAIN overrides the main checkout (default ~/coding/loops).
#
# --jobs: give the preview its OWN jobs pipeline. Creates a per-preview elasticmq queue
# (preview-<name>, DLQ'd to dlq-dev), points the web server's queue env vars at it, and runs
# a jobs worker FROM THE PREVIEW CHECKOUT in a second tmux window — so jobs enqueued by this
# preview run this branch's code instead of whatever branch the main dev stack's worker is on.
# Needs the branch to carry the HEALTH_PORT change (lib/job-queue/index.ts); otherwise the
# preview falls back to the shared queue with a warning. DB/ClickHouse/Valkey stay shared.
#
# Caveat: copies MAIN's built workspace packages (packages/*/dist), so a preview that
# changes packages/* won't reflect those until MAIN rebuilds them.
# App code (app/, pages/, components/, trpc/, lib/) is compiled from the preview
# checkout itself, so UI/route changes show up fine.
set -euo pipefail

cyan() { printf '\033[36m▸ %s\033[0m\n' "$*"; }
dim()  { printf '\033[2m%s\033[0m\n' "$*"; }
err()  { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; }

MAIN="${LOOPS_MAIN:-$HOME/coding/loops}"
PORT=""
ACTION="start"
DIR=""
OLDER_THAN=""
OPEN=""
JOBS=""

while [ $# -gt 0 ]; do
  case "$1" in
    --kill) ACTION="kill" ;;
    --kill-all) ACTION="kill-all" ;;
    --reap) ACTION="reap" ;;
    --list) ACTION="list" ;;
    --json) ACTION="json" ;;
    --open) OPEN=1 ;;
    --jobs) JOBS=1 ;;
    --older-than) OLDER_THAN="${2:-}"; shift ;;
    --port) PORT="${2:-}"; shift ;;
    --main) MAIN="${2:-}"; shift ;;
    -*) err "unknown flag: $1"; exit 2 ;;
    *) DIR="$1" ;;
  esac
  shift
done

PREFIX="loops-preview-"
meta_of()    { printf '/tmp/%s%s.meta' "$PREFIX" "$1"; }        # $1 = NAME
sessions()   { tmux ls 2>/dev/null | sed -n "s/^\(${PREFIX}[^:]*\):.*/\1/p"; }
name_of()    { printf '%s' "${1#$PREFIX}"; }                     # $1 = SESSION → NAME
meta_get()   { [ -f "$1" ] && grep -m1 "^$2=" "$1" 2>/dev/null | cut -d= -f2- || true; }  # $1=metafile $2=KEY
listening()  { [ -n "$1" ] && lsof -iTCP:"$1" -sTCP:LISTEN -n >/dev/null 2>&1; }          # $1=PORT
age_secs()   { [ -n "$1" ] && echo $(( $(date +%s) - $1 )) || echo 0; }                   # $1=STARTED epoch
age_human()  { local s="$1"; [ "$s" -lt 60 ] && echo "${s}s" || { [ "$s" -lt 3600 ] && echo "$((s/60))m" || echo "$((s/3600))h"; }; }
# $1=DIR — a detached HEAD reports as detached@<sha>, not blank (blank made the dock fall back
# to the worktree name and hide that a server was pinned to an old commit). A stack-open scratch
# worktree is detached-but-intentional: it records the branch it stands in for, so prefer that
# name over the sha (ensure_worktree keeps it resynced to that branch's tip).
branch_of()  {
  local b gd
  b="$(git -C "$1" branch --show-current 2>/dev/null)" || { echo "(gone)"; return; }
  if [ -n "$b" ]; then echo "$b"; return; fi
  gd="$(git -C "$1" rev-parse --git-dir 2>/dev/null)"
  if [ -n "$gd" ] && [ -s "$gd/stack-open-branch" ]; then sed -n '1p' "$gd/stack-open-branch"; return; fi
  echo "detached@$(git -C "$1" rev-parse --short HEAD 2>/dev/null)"
}
behind_of()  { git -C "$1" rev-list --count HEAD..origin/main 2>/dev/null || true; }      # $1=DIR
json_esc()   { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
# state of one preview, echoed as: orphaned (dir gone) · up (listening) · dead (crashed, session lingers)
state_of()   { local dir="$1" port="$2"; { [ -z "$dir" ] || [ ! -d "$dir" ]; } && { echo orphaned; return; }; listening "$port" && echo up || echo dead; }

# Unmanaged next-dev listeners on :3000-3060 — servers no preview session owns (a leftover
# headless `next dev`, a `task dev` in a worktree). Echoes "PORT PID" per stray; $1 = ports
# already claimed by registered sessions.
stray_listeners() {
  local known=" $1 " port pid
  lsof -nP -iTCP:3000-3060 -sTCP:LISTEN 2>/dev/null \
    | awk 'NR>1 {n=split($9,a,":"); print a[n], $2}' | sort -u -k1,1n \
    | while read -r port pid; do
        case "$known" in *" $port "*) continue ;; esac
        ps -p "$pid" -o command= 2>/dev/null | grep -q next || continue
        echo "$port $pid"
      done
}
cwd_of()     { lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1; }     # $1=PID
pid_age() {  # $1=PID → seconds alive, from ps etime ([[dd-]hh:]mm:ss)
  local e d=0 h=0 m=0 s=0 rest
  e="$(ps -p "$1" -o etime= 2>/dev/null | tr -d ' ')"
  [ -n "$e" ] || { echo 0; return; }
  case "$e" in *-*) d="${e%%-*}"; e="${e#*-}" ;; esac
  case "$e" in
    *:*:*) h="${e%%:*}"; rest="${e#*:}"; m="${rest%%:*}"; s="${rest#*:}" ;;
    *)     m="${e%%:*}"; s="${e#*:}" ;;
  esac
  echo $(( 10#$d*86400 + 10#$h*3600 + 10#$m*60 + 10#$s ))
}

# Kill the listener on a port (whole process group, so the npx→npm→next tree dies together).
# Refuses anything that isn't a next dev server — this must never reach for a Docker service
# or an unrelated node process that happens to sit in the range.
kill_port() {
  local port="$1" pid pgid cmd
  pid="$(lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null | head -1)"
  [ -n "$pid" ] || { err "nothing listening on :$port"; exit 1; }
  cmd="$(ps -p "$pid" -o command= 2>/dev/null)"
  case "$cmd" in *next*) ;; *) err "refusing to kill :$port — not a next dev server ($cmd)"; exit 1 ;; esac
  pgid="$(ps -p "$pid" -o pgid= 2>/dev/null | tr -d ' ')"
  if [ -n "$pgid" ] && [ "$pgid" -gt 1 ] 2>/dev/null; then
    kill -TERM -- "-$pgid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  else
    kill -TERM "$pid" 2>/dev/null || true
  fi
  cyan "killed :$port (pid $pid)"
}

# Stop one session by NAME: kill tmux + drop its meta (and its jobs queue). Echoes nothing.
stop_one() {
  local name="$1" queue
  queue="$(meta_get "$(meta_of "$name")" QUEUE)"
  [ -n "$queue" ] && curl -s --max-time 3 "$queue?Action=DeleteQueue" >/dev/null 2>&1 || true
  tmux kill-session -t "${PREFIX}${name}" 2>/dev/null || true
  rm -f "$(meta_of "$name")"
}

if [ "$ACTION" = "list" ]; then
  found=""
  reg_ports=""
  for s in $(sessions); do
    found=1
    name="$(name_of "$s")"; m="$(meta_of "$name")"
    port="$(meta_get "$m" PORT)"; dir="$(meta_get "$m" DIR)"; started="$(meta_get "$m" STARTED)"
    reg_ports="$reg_ports $port"
    state="$(state_of "$dir" "$port")"
    if [ -n "$dir" ] && [ -d "$dir" ]; then branch="$(branch_of "$dir")"; else branch="(dir gone)"; fi
    printf '  %-22s :%-5s  %-24s %-6s %s\n' \
      "$name" "${port:-?}" "$branch" "$(age_human "$(age_secs "$started")")" "$state"
    [ "$state" = "up" ] && dim "                         http://localhost:$port"
    if [ -n "$(meta_get "$m" QUEUE)" ]; then
      jport="$(meta_get "$m" JPORT)"
      dim "                         jobs: $(listening "$jport" && echo "up (:$jport)" || echo dead) · queue preview-$name"
    fi
  done
  while read -r port pid; do
    [ -n "$port" ] || continue
    found=1
    dir="$(cwd_of "$pid")"
    branch=""; [ -n "$dir" ] && [ -d "$dir" ] && branch="$(branch_of "$dir")"
    printf '  %-22s :%-5s  %-24s %-6s %s\n' \
      "$(basename "${dir:-pid-$pid}")" "$port" "${branch:-?}" "$(age_human "$(pid_age "$pid")")" "unmanaged (pid $pid)"
    dim "                         http://localhost:$port"
  done <<EOF
$(stray_listeners "$reg_ports")
EOF
  [ -n "$found" ] || echo "no previews running"
  exit 0
fi

if [ "$ACTION" = "json" ]; then
  printf '['
  first=1
  reg_ports=""
  for s in $(sessions); do
    name="$(name_of "$s")"; m="$(meta_of "$name")"
    port="$(meta_get "$m" PORT)"; dir="$(meta_get "$m" DIR)"; started="$(meta_get "$m" STARTED)"
    reg_ports="$reg_ports $port"
    state="$(state_of "$dir" "$port")"
    if [ -n "$dir" ] && [ -d "$dir" ]; then branch="$(branch_of "$dir")"; behind="$(behind_of "$dir")"; else branch=""; behind=""; fi
    url=""; [ "$state" = "up" ] && url="http://localhost:$port"
    jstate=""
    if [ -n "$(meta_get "$m" QUEUE)" ]; then
      listening "$(meta_get "$m" JPORT)" && jstate="up" || jstate="dead"
    fi
    [ -n "$first" ] || printf ','
    first=""
    printf '{"name":"%s","port":"%s","dir":"%s","branch":"%s","started":"%s","age":"%s","state":"%s","url":"%s","managed":true,"behind":"%s","jobs":"%s"}' \
      "$(json_esc "$name")" "$(json_esc "$port")" "$(json_esc "$dir")" "$(json_esc "$branch")" \
      "$(json_esc "$started")" "$(json_esc "$(age_human "$(age_secs "$started")")")" "$(json_esc "$state")" "$(json_esc "$url")" \
      "$(json_esc "$behind")" "$(json_esc "$jstate")"
  done
  while read -r port pid; do
    [ -n "$port" ] || continue
    dir="$(cwd_of "$pid")"
    branch=""; behind=""
    if [ -n "$dir" ] && [ -d "$dir" ]; then branch="$(branch_of "$dir")"; behind="$(behind_of "$dir")"; fi
    [ -n "$first" ] || printf ','
    first=""
    printf '{"name":"%s","port":"%s","dir":"%s","branch":"%s","pid":"%s","age":"%s","state":"up","url":"http://localhost:%s","managed":false,"behind":"%s"}' \
      "$(json_esc "$(basename "${dir:-pid-$pid}")")" "$(json_esc "$port")" "$(json_esc "$dir")" "$(json_esc "$branch")" \
      "$(json_esc "$pid")" "$(json_esc "$(age_human "$(pid_age "$pid")")")" "$(json_esc "$port")" "$(json_esc "$behind")"
  done <<EOF
$(stray_listeners "$reg_ports")
EOF
  printf ']\n'
  exit 0
fi

if [ "$ACTION" = "kill-all" ]; then
  n=0
  for s in $(sessions); do stop_one "$(name_of "$s")"; n=$((n+1)); done
  cyan "killed $n preview(s)"
  exit 0
fi

if [ "$ACTION" = "reap" ]; then
  n=0
  for s in $(sessions); do
    name="$(name_of "$s")"; m="$(meta_of "$name")"
    port="$(meta_get "$m" PORT)"; dir="$(meta_get "$m" DIR)"; started="$(meta_get "$m" STARTED)"
    reason=""
    if [ -z "$dir" ] || [ ! -d "$dir" ]; then reason="orphaned (dir gone)"
    elif ! listening "$port"; then reason="dead (not listening on :$port)"
    elif [ -n "$OLDER_THAN" ] && [ "$(age_secs "$started")" -gt "$((OLDER_THAN * 60))" ]; then
      reason="older than ${OLDER_THAN}m"
    fi
    if [ -n "$reason" ]; then
      stop_one "$name"; cyan "reaped $name — $reason"; n=$((n+1))
    fi
  done
  [ "$n" -gt 0 ] || echo "nothing to reap"
  exit 0
fi

# --kill needs only the session NAME (basename of the path string) — never cd, so an orphaned
# preview whose worktree is already gone can still be torn down by the dir the dock recorded.
# With --port it kills by PORT instead: one dir can host both a registered preview and an
# unmanaged stray, so only the port names a server precisely.
if [ "$ACTION" = "kill" ]; then
  if [ -n "$PORT" ]; then
    for s in $(sessions); do
      name="$(name_of "$s")"
      if [ "$(meta_get "$(meta_of "$name")" PORT)" = "$PORT" ]; then
        stop_one "$name"; cyan "killed ${PREFIX}${name}"; exit 0
      fi
    done
    kill_port "$PORT"
    exit 0
  fi
  NAME="$(basename "${DIR:-$PWD}")"
  if tmux has-session -t "${PREFIX}${NAME}" 2>/dev/null; then
    stop_one "$NAME"; cyan "killed ${PREFIX}${NAME}"
  else
    rm -f "$(meta_of "$NAME")"; echo "no session ${PREFIX}${NAME}"
  fi
  exit 0
fi

DIR="$(cd "${DIR:-$PWD}" && pwd)"
NAME="$(basename "$DIR")"
SESSION="${PREFIX}${NAME}"
LOG="/tmp/$SESSION.log"
META="$(meta_of "$NAME")"

[ -f "$DIR/package.json" ] || { err "$DIR is not a loops checkout (no package.json)"; exit 1; }
MAIN="$(cd "$MAIN" && pwd)"
# previewing MAIN itself would rm -rf its real node_modules and then "clone" from the
# just-deleted source, leaving a self-symlink (2026-07-23) — the refresh logic assumes DIR≠MAIN
[ "$DIR" = "$MAIN" ] && { err "refusing to preview the MAIN checkout ($MAIN) — run the real dev stack there, or preview a worktree"; exit 1; }

# Worktrees have no node_modules and don't carry untracked env files — take them from MAIN.
# Turbopack refuses to follow a node_modules that symlinks out of the project root ("points out of
# the filesystem root", fatal at boot), so the checkout gets a REAL tree: an APFS clone of MAIN's,
# which shares its blocks (~30s once, ~no disk). Only if cloning fails do we symlink and pin the
# preview to the old bundler.
BUNDLER=""
# MAIN must never enter the borrow block: the refresh clause would rm -rf the very tree it then
# clones from, leaving node_modules a symlink to itself (bit us 2026-07-23).
if [ "$DIR" = "$MAIN" ]; then
  [ -d "$DIR/node_modules" ] && [ ! -L "$DIR/node_modules" ] || { err "MAIN's node_modules is missing or a symlink — run npm install in $MAIN"; exit 1; }
else
  # a seed-gen "repointed" tree (per-entry symlinks out to MAIN) boots next fine but Turbopack
  # refuses out-of-root symlinks — zero compile, every request 500s on missing build manifests
  if [ -d "$DIR/node_modules" ] && [ -L "$DIR/node_modules/next" ]; then
    cyan "node_modules entries are symlinks to MAIN (Turbopack-fatal) — re-cloning real"
    rm -rf "$DIR/node_modules"
  fi
  if [ -d "$DIR/node_modules" ] && [ ! -L "$DIR/node_modules" ] && [ "$MAIN/package-lock.json" -nt "$DIR/node_modules" ]; then
    cyan "MAIN reinstalled since this clone — refreshing node_modules"
    rm -rf "$DIR/node_modules"
  fi
  if [ ! -e "$DIR/node_modules" ] || [ -L "$DIR/node_modules" ]; then
    rm -f "$DIR/node_modules"
    cyan "cloning node_modules from $MAIN (once per checkout, ~30s)"
    if ! cp -Rc "$MAIN/node_modules" "$DIR/node_modules" 2>/dev/null; then
      rm -rf "$DIR/node_modules"
      ln -sfn "$MAIN/node_modules" "$DIR/node_modules"
      err "clone failed — linked MAIN's node_modules; this preview runs on webpack"
    else
      # a quarantine-flagged ancestor (e.g. Chrome-launched viewer) stamps EVERY file it clones, so one
      # canary tells whether the tree is tainted; Gatekeeper only blocks Mach-O dlopen/exec, so a tainted
      # clone needs its ~1.3k executables stripped, never a full xattr walk of the ~310k-file tree
      canary="$DIR/node_modules/@next/swc-darwin-arm64/next-swc.darwin-arm64.node"
      [ -e "$canary" ] || canary=$(find "$DIR/node_modules" -type f -name '*.node' -print -quit 2>/dev/null)
      if [ -n "$canary" ] && xattr -p com.apple.quarantine "$canary" >/dev/null 2>&1; then
        cyan "clone inherited quarantine — stripping native binaries"
        find "$DIR/node_modules" -type f \( -name '*.node' -o -perm -111 \) -print0 2>/dev/null \
          | xargs -0 xattr -d com.apple.quarantine 2>/dev/null || true
      fi
    fi
  fi
fi
if [ -L "$DIR/node_modules" ]; then BUNDLER="--webpack"; fi

# the workspace links resolve to the checkout's OWN packages/*, which carry source but no build —
# take MAIN's dist for each (gitignored, so the checkout stays clean)
for src in "$MAIN"/packages/*/dist; do
  [ -d "$src" ] || continue
  dest="$DIR/packages/$(basename "$(dirname "$src")")/dist"
  [ -d "$(dirname "$dest")" ] || continue
  if [ ! -d "$dest" ] || [ "$src" -nt "$dest" ]; then
    rm -rf "$dest"
    cp -Rc "$src" "$dest" 2>/dev/null || cp -R "$src" "$dest"
  fi
done
for e in .env .env.local .env.development; do
  if [ -f "$MAIN/$e" ] && [ ! -e "$DIR/$e" ]; then
    ln -sfn "$MAIN/$e" "$DIR/$e"
    cyan "linked $e from $MAIN"
  fi
done

# Auto-pick the first free port (3010-3060) unless one was given.
if [ -z "$PORT" ]; then
  for p in $(seq 3010 3060); do
    if ! lsof -iTCP:"$p" -sTCP:LISTEN -n >/dev/null 2>&1; then PORT="$p"; break; fi
  done
fi
[ -n "$PORT" ] || { err "no free port in 3010-3060"; exit 1; }

# --jobs: per-preview queue + a worker from THIS checkout (see header). The env overrides cover
# every queue var that defaults to the shared elasticmq/dev (lib/app-env/sqs.ts); the worker gets
# the same set so a job that re-enqueues stays inside the preview queue.
QUEUE_URL=""
JPORT=""
QUEUE_ENV=""
if [ -n "$JOBS" ] && ! grep -q HEALTH_PORT "$DIR/lib/job-queue/index.ts" 2>/dev/null; then
  err "--jobs: this branch predates the HEALTH_PORT override in lib/job-queue/index.ts — jobs stay on the shared queue/worker"
  JOBS=""
fi
if [ -n "$JOBS" ]; then
  QUEUE_URL="$(curl -sG --max-time 5 "http://localhost:9324/" \
    --data-urlencode "Action=CreateQueue" \
    --data-urlencode "QueueName=preview-$NAME" \
    --data-urlencode "Attribute.1.Name=RedrivePolicy" \
    --data-urlencode 'Attribute.1.Value={"deadLetterTargetArn":"arn:aws:sqs:elasticmq:000000000000:dlq-dev","maxReceiveCount":"2"}' \
    | sed -n 's:.*<QueueUrl>\(.*\)</QueueUrl>.*:\1:p')"
  [ -n "$QUEUE_URL" ] || { err "--jobs: elasticmq CreateQueue failed (is the dev Docker stack up?)"; exit 1; }
  for p in $(seq 4001 4060); do
    if ! listening "$p"; then JPORT="$p"; break; fi
  done
  [ -n "$JPORT" ] || { err "--jobs: no free healthcheck port in 4001-4060"; exit 1; }
  QUEUE_ENV="UI_QUEUE_URL='$QUEUE_URL' BACKGROUND_QUEUE_URL='$QUEUE_URL' SQS_UNSUBSCRIBE_QUEUE_URL='$QUEUE_URL' SQS_WEBHOOKS_JOBS_QUEUE_URL='$QUEUE_URL' MAIL_RENDER_QUEUE_URL='$QUEUE_URL' MAIL_SEND_QUEUE_URL='$QUEUE_URL'"
fi

tmux kill-session -t "$SESSION" 2>/dev/null || true
# stale .next from a prior branch/session serves old route manifests — dynamic routes
# (/api/trpc/[trpc]) 404 and the client never bootstraps (blank page); rebuild clean.
# Only AFTER the old session is dead — deleting under a live server wedges it into
# endless build-manifest ENOENTs.
rm -rf "$DIR/.next"
"$HOME/.dotfiles/scripts/loops-provenance" "$DIR" --no-agent >/dev/null 2>&1 || true  # best-effort X-Dev-Worktree stamp
tmux new-session -d -s "$SESSION" "cd '$DIR' && $QUEUE_ENV npx next dev $BUNDLER -p $PORT > '$LOG' 2>&1"
if [ -n "$JOBS" ]; then
  JLOG="/tmp/$SESSION-jobs.log"
  tmux new-window -t "$SESSION" -n jobs "cd '$DIR' && $QUEUE_ENV HEALTH_PORT=$JPORT npx tsx --watch --watch-preserve-output --tsconfig lib/job-queue/tsconfig.json --import dotenv/config lib/job-queue/index.js '$QUEUE_URL' 10 > '$JLOG' 2>&1"
fi
printf 'DIR=%s\nPORT=%s\nSTARTED=%s\nQUEUE=%s\nJPORT=%s\n' "$DIR" "$PORT" "$(date +%s)" "$QUEUE_URL" "$JPORT" > "$META"

# next dev rewrites the tracked next-env.d.ts at boot (and only at boot) to a types path the
# committed file doesn't carry, so every preview would leave its checkout dirty — restore it as
# soon as the server has written it, and only when we didn't inherit real edits to the file.
if git -C "$DIR" diff --quiet -- next-env.d.ts 2>/dev/null; then
  (
    for _ in $(seq 1 90); do
      sleep 1
      git -C "$DIR" diff --quiet -- next-env.d.ts 2>/dev/null && continue
      git -C "$DIR" checkout -- next-env.d.ts 2>/dev/null
      break
    done
  ) >/dev/null 2>&1 &
fi

cyan "preview $NAME  →  http://localhost:$PORT"
cyan "branch:  $(branch_of "$DIR")"
[ -n "$JOBS" ] && cyan "jobs:    own worker from this checkout · queue preview-$NAME · health :$JPORT · log /tmp/$SESSION-jobs.log"
cyan "watch:   tmux attach -t $SESSION   ·   log: $LOG"
cyan "stop:    loops-preview '$DIR' --kill"
echo "(clean build — first request compiles from scratch, ~20-60s)"
[ -n "$OPEN" ] && open "http://localhost:$PORT" || true
