{
  "name": "blessed-viewer-solid",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "$HOME/.dotfiles/scripts/stack-review-serve --ensure || true",
    "dev": "vite --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit",
    "bake": "node bake.mjs",
    "build:static": "VITE_STATIC=1 vite build && node bake.mjs",
    "visual:serve": "node visual/fixture-server.mjs --dist dist --fixtures visual/fixtures --port 7333",
    "visual:shot": "node visual/shot-all.mjs --base http://127.0.0.1:7333 --out /tmp/viewer-shots",
    "visual:diff": "node visual/diff.mjs --a visual/baseline --b /tmp/viewer-shots --out /tmp/viewer-diffs",
    "visual:invariants": "node visual/invariants.mjs --base http://127.0.0.1:7333",
    "visual:behave": "node visual/behave-focus-drag.mjs --base http://127.0.0.1:7333"
  },
  "dependencies": {
    "@solidjs/router": "^0.16.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-query": "^5.59.0",
    "diff2html": "^3.4.48",
    "marked": "^18.0.5",
    "solid-js": "^1.9.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260617.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.3.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
