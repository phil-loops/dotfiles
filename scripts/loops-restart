#!/usr/bin/env bash
set -euo pipefail

# loops-restart — find EVERY running loops instance (dev stack + previews), kill them
# all, rebuild packages, restart the :3000 service and its dependencies cleanly.
#
#   loops-restart [--dir <checkout>] [--reset|--keep] [--no-restart] [--dry-run]
#
#   --dir <path>   checkout to (re)start in. Default: ~/coding/loops (the main checkout).
#   --reset        full DB reset on start: `task dev` (prisma migrate reset --force +
#                  reseed + clickhouse:reset). Use for a clean slate.
#   --keep         keep dev data: `task dev:watch` (rebuild packages + restart node
#                  services only, no deliberate DB wipe). DEFAULT — right for a code/
#                  package change. Also applies pending Postgres migrations (prisma
#                  migrate deploy) and seeds when the DB is empty.
#   --no-restart   kill (+ docker-down if relocating) only; don't relaunch.
#   --dry-run      print what it WOULD kill / bring down / start; touch nothing.
#
# Discovery casts a wide net on purpose: the `task …dev…` stack, `next dev` preview
# servers (loops-preview worktrees on :3010+), and anything listening on the dev/preview
# ports — every process group rooted in a ~/coding/loops* checkout is listed and killed.
# Runaway previews left over from old sessions die with the stack; "kill all, then
# restart :3000 and its dependencies" is the one behavior.
#
# Docker: the compose project is brought down ONLY when relocating checkouts or on
# --reset. The psql service has NO volume, so `compose down` DESTROYS the dev database —
# a same-checkout keep-restart leaves the containers (and your data) running. When the
# DB does come up empty, ensure_db_ready migrates + reseeds it.
#
# Safety: only touches process groups whose cwd is under ~/coding/loops*, and never a
# `claude` process. The server runs in a detached tmux session `loops-dev`, logging to
# /tmp/loops-dev.log (which the `dev-tail` skill reads), so it outlives your shell.

DIR="$HOME/coding/loops"
MODE="keep"        # keep | reset
RESTART=1
DRY=0
LOG=/tmp/loops-dev.log
SESSION=loops-dev
# 3000–3005 + 4000 = the dev stack; 3010–3019 = loops-preview side servers
DEV_PORTS=(3000 3001 3002 3003 3004 3005 4000 3010 3011 3012 3013 3014 3015 3016 3017 3018 3019)

while [ $# -gt 0 ]; do
  case "$1" in
    --dir) DIR="$2"; shift 2 ;;
    --reset) MODE="reset"; shift ;;
    --keep)  MODE="keep";  shift ;;
    --no-restart) RESTART=0; shift ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "loops-restart: unknown arg: $1" >&2; exit 2 ;;
  esac
done
DIR="${DIR%/}"

say() { printf '\033[36m▸ %s\033[0m\n' "$*"; }

cwd_of()  { lsof -a -p "$1" -d cwd -Fn 2>/dev/null | grep '^n' | sed 's/^n//'; }
pgid_of() { ps -o pgid= -p "$1" 2>/dev/null | tr -d ' '; }

# || true: head -1 closes early, so grep dies on SIGPIPE (141) — pipefail + set -e would abort the caller
db_url_of() { grep -E '^DATABASE_URL=' "$1/.env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' || true; }

# keep mode (`task dev:watch`) never migrates/seeds — so after a relocating restart the
# compose Postgres can come up fresh+empty and the app 500s on `relation "User" does not
# exist`. Bring the schema forward (idempotent, non-destructive — also picks up migrations
# pulled since last run), then seed ONLY when the DB is empty (never re-seed a populated
# one). `migrate deploy` never trips Prisma's AI-agent guard (only `migrate reset --force`
# does), so this is safe to run unattended. Needs psql to detect emptiness; without it we
# still migrate but skip auto-seed (don't seed blindly).
ensure_db_ready() {
  local dir="$1" url n
  url="$(db_url_of "$dir")"
  if command -v psql >/dev/null 2>&1 && [ -n "$url" ]; then
    for _ in $(seq 1 20); do
      if psql "$url" -c 'SELECT 1' >/dev/null 2>&1; then break; fi
      sleep 1
    done
  else
    sleep 3
  fi
  say "applying Postgres migrations (prisma migrate deploy)"
  (cd "$dir" && npx prisma migrate deploy) 2>&1 | tail -3 || true
  if command -v psql >/dev/null 2>&1 && [ -n "$url" ]; then
    n="$(psql "$url" -t -A -c 'SELECT count(*) FROM "User";' 2>/dev/null | tr -d '[:space:]')"
    if [ "$n" = "0" ]; then
      # not `prisma db seed`: Prisma 7 stopped loading .env for the seed subprocess, so
      # the seed dies on missing DEV_EMAIL — load .env via tsx ourselves
      say "fresh/empty DB — seeding (seed-prisma/seed.ts with .env loaded)"
      (cd "$dir" && npx tsx --tsconfig tsconfig.node.json --import dotenv/config seed-prisma/seed.ts) 2>&1 | tail -3 || true
    fi
  fi
}

# Seed PIDs that DEFINE the running loops instances — precisely, not "anything sharing
# the checkout cwd" (the main checkout is the cwd of the viewer, shells, editors… killing
# by cwd there is a footgun). Three unambiguous signals: the `task …dev…` orchestrator,
# `next dev` preview servers, and whoever LISTENS on the dev/preview ports. Their process
# GROUPS are the whole tree to kill; only groups rooted in ~/coding/loops* qualify.
SELF_PGID="$(pgid_of $$)"
seed_pids() {
  { pgrep -f 'task .*dev' 2>/dev/null || true
    pgrep -f 'next dev' 2>/dev/null || true
    lsof -nP -sTCP:LISTEN $(printf -- '-iTCP:%s ' "${DEV_PORTS[@]}") -t 2>/dev/null || true
  } | sort -u
}

RUNNING=""
declare -a KILL_PGIDS=() KILL_LABELS=()
for p in $(seed_pids); do
  cmd=$(ps -o command= -p "$p" 2>/dev/null || true)
  case "$cmd" in claude\ *|*/claude\ *|claude) continue ;; esac   # never a working session
  wd="$(cwd_of "$p")"
  case "$wd" in "$HOME/coding/loops"*) ;; *) continue ;; esac     # only loops checkouts
  g=$(pgid_of "$p"); [ -n "$g" ] || continue
  [ "$g" = "$SELF_PGID" ] && continue                              # never our own group
  case "$cmd" in *task*dev*) [ -z "$RUNNING" ] && RUNNING="$wd" ;; esac  # compose lives with `task dev`, not previews
  case " ${KILL_PGIDS[*]:-} " in *" $g "*) ;; *) KILL_PGIDS+=("$g"); KILL_LABELS+=("$wd") ;; esac
done
PREVIEW_SESSIONS="$(tmux ls -F '#{session_name}' 2>/dev/null | grep '^loops-preview-' | tr '\n' ' ' || true)"

# compose down destroys the dev DB (psql has no volume) — only pay that when the compose
# project must move checkouts, or the user asked for a reset anyway
NEED_DOCKER_DOWN=0
if [ -n "$RUNNING" ] && { [ "$MODE" = reset ] || [ "$RUNNING" != "$DIR" ]; }; then
  NEED_DOCKER_DOWN=1
fi

if [ "${#KILL_PGIDS[@]}" -gt 0 ]; then
  say "found ${#KILL_PGIDS[@]} loops instance(s) — killing all:"
  for i in "${!KILL_PGIDS[@]}"; do
    say "  group ${KILL_PGIDS[$i]} — ${KILL_LABELS[$i]}"
  done
  [ -n "$PREVIEW_SESSIONS" ] && say "  preview tmux sessions: $PREVIEW_SESSIONS"
  if [ "$DRY" = 1 ]; then
    for g in "${KILL_PGIDS[@]}"; do
      say "would TERM→KILL process group $g:"; ps -o pid=,command= -g "$g" 2>/dev/null | sed 's/^/      /' | cut -c1-100
    done
    if [ "$NEED_DOCKER_DOWN" = 1 ]; then
      say "would: (cd $RUNNING && docker compose down) — DESTROYS dev DB (psql has no volume)"
    else
      say "same-checkout keep restart — docker (and dev data) left running"
    fi
  else
    for g in "${KILL_PGIDS[@]}"; do kill -TERM "-$g" 2>/dev/null || true; done
    sleep 2
    for g in "${KILL_PGIDS[@]}"; do kill -9 "-$g" 2>/dev/null || true; done
    for s in $PREVIEW_SESSIONS; do tmux kill-session -t "$s" 2>/dev/null || true; done
    if [ "$NEED_DOCKER_DOWN" = 1 ] && [ -f "$RUNNING/docker-compose.yml" -o -f "$RUNNING/compose.yml" -o -f "$RUNNING/docker-compose.yaml" ]; then
      say "bringing down its Docker compose project (dev DB is destroyed with it — psql has no volume)"
      (cd "$RUNNING" && docker compose down) 2>&1 | tail -3 || true
    fi
  fi
else
  say "no loops instances found (no 'task …dev…'/'next dev' process, nothing on dev/preview ports) — nothing to kill"
fi

# free-port sanity — anything still bound would fail the relaunch
STILL=$(lsof -nP -sTCP:LISTEN $(printf -- '-iTCP:%s ' "${DEV_PORTS[@]}") -t 2>/dev/null | sort -u | tr '\n' ' ' || true)
[ -n "$STILL" ] && say "warning: dev ports still held by pids: $STILL"

if [ "$RESTART" = 0 ]; then
  say "--no-restart: stopped. (kill + docker-down only)"
  exit 0
fi

[ -d "$DIR" ] || { echo "loops-restart: --dir not a directory: $DIR" >&2; exit 2; }
TASK=$([ "$MODE" = reset ] && echo "task dev" || echo "task dev:watch")
say "restarting in $DIR via: $TASK   (mode=$MODE, log=$LOG, tmux=$SESSION)"

# `task dev:watch` (keep mode) only relaunches node services — unlike `task dev`, it does
# NOT bring the compose project up, so after the down above the watchers spin on
# ECONNREFUSED. Reset mode's `task dev` already deps on :docker:compose:up.
NEED_DOCKER_UP=$([ "$MODE" = keep ] && echo 1 || echo 0)

if [ "$DRY" = 1 ]; then
  [ "$NEED_DOCKER_UP" = 1 ] && say "would: (cd $DIR && docker compose up -d --remove-orphans)"
  [ "$NEED_DOCKER_UP" = 1 ] && say "would: (cd $DIR && npx prisma migrate deploy; seed if DB empty)"
  say "dry-run: not launching"
  exit 0
fi

if [ "$NEED_DOCKER_UP" = 1 ]; then
  say "bringing up Docker compose project in $DIR"
  (cd "$DIR" && docker compose up -d --remove-orphans) 2>&1 | tail -3 || true
  ensure_db_ready "$DIR"
fi

tmux kill-session -t "$SESSION" 2>/dev/null || true
tmux new-session -d -s "$SESSION" "cd '$DIR' && $TASK 2>&1 | tee '$LOG'"
sleep 3
if tmux has-session -t "$SESSION" 2>/dev/null; then
  say "up: tmux attach -t $SESSION   ·   tail -f $LOG   ·   dev-tail skill reads $LOG"
else
  echo "loops-restart: $SESSION exited immediately — check $LOG:" >&2
  tail -n 20 "$LOG" >&2 || true
  exit 1
fi
