#!/bin/zsh
# hx-test <file> — the Helix side of a contextual test watcher. Helix has no test
# integration and :sh discards output, so instead of capturing results we drive a
# dedicated tmux pane BESIDE Helix that runs node:test in --watch mode: it re-runs
# on every :w and streams the spec reporter's colored pass/fail live.
#   helix/config.toml binds  space-t = [":write", ":sh hx-test %{buffer_name}"]
# The :write lands the current edit before we kick the watcher (which then re-runs
# on each subsequent save on its own).
#
# File resolution: a *.test.ts buffer runs itself; a source buffer runs its sibling
# <base>.test.ts. The pane is reused across presses (matched by pane title "hx-test"),
# so pressing space-t from a different file just re-points the same watcher — one test
# pane, not a new split each time.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

file="${1:?usage: hx-test <file>}"
file="${file:A}"   # %{buffer_name} is cwd-relative; absolutize before deriving paths

case "$file" in
  *.test.ts|*.test.tsx) testfile="$file" ;;
  *.ts)  testfile="${file:r}.test.ts" ;;
  *.tsx) testfile="${file:r}.test.tsx" ;;
  *)     echo "hx-test: not a TypeScript file: ${file:t}"; exit 0 ;;
esac
if [[ ! -f "$testfile" ]]; then
  echo "hx-test: no test file (${testfile:t}) next to ${file:t}"
  exit 0
fi

root=$(git -C "${file:h}" rev-parse --show-toplevel)
rel="${testfile#$root/}"

if [[ -z "${TMUX:-}" ]]; then
  echo "hx-test: not in tmux — run: task test -- $rel"
  exit 0
fi

# node:test in a tty auto-selects the colored spec reporter; the pane is a tty, so we
# get color for free. --watch re-runs the suite on every save under $root.
cmd="cd ${(q)root} && clear && npx tsx --tsconfig tsconfig.node.json --watch --test ${(q)rel}"

# Reuse the pane titled hx-test in THIS window; create a 30%-height split below on first use.
target=$(tmux list-panes -F '#{pane_id} #{pane_title}' | awk '$2=="hx-test"{print $1; exit}')
if [[ -z "$target" ]]; then
  target=$(tmux split-window -d -v -l 30% -c "$root" -P -F '#{pane_id}')
  tmux select-pane -t "$target" -T hx-test
fi

tmux send-keys -t "$target" C-c            # stop any in-flight watcher before re-pointing
tmux send-keys -t "$target" "$cmd" Enter
echo "▶ watching ${rel:t}"
