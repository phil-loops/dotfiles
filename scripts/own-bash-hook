#!/bin/zsh
# own-bash-hook {pre|post} — Claude Code hooks for the Bash tool (matcher: Bash).
#
# The Edit guard (own-hook) only ever sees Edit/Write/MultiEdit. Every raw write —
# `sed -i`, `cat >`, `tee`, a heredoc, `python - <<EOF`, `git apply`, a headless editor —
# reaches the same files without the guard ever running. Prevention there is hopeless:
# you cannot reliably parse a shell command's write targets, and a blanket deny would
# break the sanctioned `git apply --3way` (the patch protocol) and every build that
# writes dist/. Detection is exact instead — a write leaves a mark on disk whatever
# made it — so we watch the disk rather than the command:
#
#   pre  — stamp the clock AND snapshot what is already dirty, before the command runs.
#   post — a file that was CLEAN at pre and is dirty now, in ANOTHER live session's lane,
#          is a trespass. Reported within the same tool call.
#
# The snapshot is load-bearing, not an optimization. mtime cannot attribute authorship: a
# holder saving their own file while your command runs is indistinguishable from you
# stomping it — which false-accused a read-only `git status` on day one. Subtracting the
# pre-existing dirty set removes that whole class: the holder's own WIP is theirs and its
# churn is not news. Cost: a raw write onto a file the holder is ALREADY mid-edit on goes
# unseen. That gap wants a ledger of sanctioned writes (own-hook recording each Edit) so
# unexplained ones can be isolated by elimination — not more mtime.
#
# Only the very next turn can still cheaply revert it, which is the whole point: know
# now, not when someone else's afternoon has been quietly built on top of it.
emulate -L zsh; set -uo pipefail
mode="${1:-post}"
input=$(cat)
eval "$(print -r -- "$input" | python3 -c '
import sys, json, shlex
try: d = json.load(sys.stdin)
except Exception: sys.exit(0)
print("sid=" + shlex.quote(d.get("session_id", "")))
' 2>/dev/null)"
STAMP="${TMPDIR:-/tmp}/own-bash-${sid:-anon}.stamp"
SNAP="${TMPDIR:-/tmp}/own-bash-${sid:-anon}.dirty"
ROOT="$HOME/.dotfiles"

if [[ "$mode" == pre ]]; then
  date +%s > "$STAMP"          # never blocks: a Bash call is not the guard's business
  (cd "$ROOT" && git status --porcelain --no-renames 2>/dev/null | sed 's/^...//') > "$SNAP" 2>/dev/null
  exit 0
fi

# no stamp (hook added mid-session, or a pre that never ran) → look back a short window.
# no snapshot → every dirty file looks new, so stay quiet rather than accuse on a guess.
since=$(cat "$STAMP" 2>/dev/null) || since=$(( $(date +%s) - 30 ))
[[ -n "$since" ]] || since=$(( $(date +%s) - 30 ))
[[ -f "$SNAP" ]] || exit 0
OWN_SESSION="${sid:-}" "${0:A:h}/own" trespass "$since" "$SNAP"
exit $?   # 2 = trespass; PostToolUse feeds the message back to the session that did it
