#!/usr/bin/env python3
# hx-hunk [--show|--parent|--refresh|--close] <file> <line> — "what did this used to say?" for Helix.
#
# Helix's gutter marks a changed line but cannot show the text it replaced. This paints the
# change under the cursor, old lines and new lines together, into a tmux pane beside Helix.
# helix/config.toml binds
#   space-i  = show   (open the pane if needed, paint the change at the cursor)
#   space-I  = close
#   space-o p = the parent's version in a second Helix (see --parent below)
#   ]g / [g  = jump to the next / previous change, then repaint if the pane is open
# so the pane follows the keys you already use and nothing polls.
#
# The comparison is `git diff HEAD`, the same base Helix's gutter uses. In a stack-open diff
# view (<branch>.diffbase) HEAD is the branch's parent, so the pane shows the branch's change;
# in an ordinary checkout it shows your uncommitted edits. It reads the file on disk, so an
# unsaved edit appears after :w.
#
# --parent (space-o p) swaps the painted pane for a second HELIX on the parent's version of the
# file: `stack-open --old-path` keeps a checkout whose files are the branch's diff base, so the
# old code gets a language server (hover, gd) of its own, and its gutter marks the lines the
# branch went on to change. Only for files opened in stack-open's diff view; ]g / [g then move
# that Helix to the matching old line. Helix has no remote control, so it is steered the way
# stack-open steers review-hx: a ':' prompt whose echo is verified before Enter.
#
# The painted pane runs nothing but `tail -f /dev/null`; each call writes a finished frame to its tty.
# No daemon, no state beyond the pane id stored on the Helix pane as @hx-hunk-pane.
import difflib
import os
import re
import subprocess
import sys
import time

RESET, DIM, BOLD = "\033[0m", "\033[2m", "\033[1m"
RED, GREEN, CYAN = "\033[31m", "\033[32m", "\033[36m"
RED_HI, GREEN_HI = "\033[1;97;41m", "\033[1;30;42m"


def run(*cmd, cwd=None):
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)


def tmux(*args):
    return run("tmux", *args).stdout.strip()


def find_pane(hx_pane):
    pane = tmux("show-options", "-pqv", "-t", hx_pane, "@hx-hunk-pane")
    if pane and pane in tmux("list-panes", "-a", "-F", "#{pane_id}").split():
        return pane
    return ""


def pane_kind(hx_pane):
    return tmux("show-options", "-pqv", "-t", hx_pane, "@hx-hunk-kind") or "paint"


def close_pane(hx_pane, pane):
    if pane:
        tmux("kill-pane", "-t", pane)
    tmux("set-option", "-p", "-u", "-t", hx_pane, "@hx-hunk-pane")
    tmux("set-option", "-p", "-u", "-t", hx_pane, "@hx-hunk-kind")


def open_pane(hx_pane, kind="paint", cwd=None, command=None):
    size = "42%" if kind == "paint" else "50%"
    args = ["split-window", "-d", "-h", "-l", size, "-t", hx_pane, "-P", "-F", "#{pane_id}"]
    if cwd:
        args += ["-c", cwd]
    args.append(command or "stty -echo; printf '\\033[?25l'; exec tail -f /dev/null")
    pane = tmux(*args)
    tmux("select-pane", "-t", pane, "-T", "hx-hunk")
    tmux("select-pane", "-t", hx_pane)
    tmux("set-option", "-p", "-t", hx_pane, "@hx-hunk-pane", pane)
    tmux("set-option", "-p", "-t", hx_pane, "@hx-hunk-kind", kind)
    return pane


def old_line(diff, line):
    """The parent-side line that sits where <line> does now, from a -U0 diff."""
    shift = 0
    for m in re.finditer(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", diff, re.M):
        os_, oc = int(m[1]), int(m[2]) if m[2] is not None else 1
        ns, nc = int(m[3]), int(m[4]) if m[4] is not None else 1
        if nc == 0:
            if line <= ns:
                break
            if line == ns + 1:
                return os_
        else:
            if line < ns:
                break
            if line <= ns + nc - 1:
                return os_ if oc else os_ + 1
        shift += oc - nc
    return max(1, line + shift)


def diff_view(path):
    """(root, rel, branch) when <path> sits in a stack-open diff view, else None."""
    inside = run("git", "rev-parse", "--show-toplevel", "--absolute-git-dir", cwd=os.path.dirname(path))
    if inside.returncode != 0:
        return None
    root, gitdir = inside.stdout.split("\n")[:2]
    try:
        branch = open(os.path.join(gitdir, "stack-open-branch")).read().strip()
    except OSError:
        return None
    if not branch or not os.path.exists(os.path.join(gitdir, "stack-open-diff-base")):
        return None
    return root, os.path.relpath(os.path.realpath(path), os.path.realpath(root)), branch


def parent_target(path, line):
    """(old checkout, rel path, old line) for the file's parent-side twin; a message on failure."""
    view = diff_view(path)
    if not view:
        return None, "the parent's version needs a file opened from the viewer (diff view)"
    root, rel, branch = view
    built = run(os.path.expanduser("~/.dotfiles/scripts/stack-open"), "--old-path", branch, cwd=root)
    old_root = built.stdout.strip().split("\n")[-1] if built.returncode == 0 else ""
    if not old_root or not os.path.isdir(old_root):
        return None, f"could not build the parent's checkout for {branch}"
    if not os.path.isfile(os.path.join(old_root, rel)):
        return None, f"{rel} is new on this branch: the parent has no version of it"
    diff = run("git", "diff", "--no-color", "--no-ext-diff", "-U0", "HEAD", "--", rel, cwd=root).stdout
    return (old_root, rel, old_line(diff, line)), ""


def tail(pane, n=1):
    return run("tmux", "capture-pane", "-p", "-t", pane).stdout.rstrip("\n").split("\n")[-n:]


def steer(pane, command):
    """Run one ':' command in the Helix in <pane>, proving each step from the screen."""
    for _ in range(3):
        tmux("send-keys", "-t", pane, "Escape")
        for _ in range(12):
            time.sleep(0.04)
            last = tail(pane, 2)
            if any("NOR" in row for row in last) and not last[-1].startswith(":"):
                break
        else:
            continue
        break
    else:
        return False
    before = tail(pane)[0]
    tmux("send-keys", "-t", pane, ":")
    for _ in range(30):
        time.sleep(0.04)
        now = tail(pane)[0]
        if now.startswith(":") and now != before:
            break
    else:
        return False
    buffer = f"hx-hunk-{os.getpid()}"
    run("tmux", "set-buffer", "-b", buffer, "--", command)
    run("tmux", "paste-buffer", "-p", "-d", "-b", buffer, "-t", pane)
    width = int(tmux("display-message", "-p", "-t", pane, "#{pane_width}") or 0)
    expect = ":" + command
    for _ in range(50):
        time.sleep(0.04)
        now = tail(pane)[0]
        if now == expect or (len(expect) >= width and now and expect.endswith(now)):
            tmux("send-keys", "-t", pane, "Enter")
            return True
    tmux("send-keys", "-t", pane, "Escape")
    return False


def follow(hx_pane, pane, path, line):
    """Move the parent-side Helix to <path>'s old line. Latest request wins; one driver at a time."""
    target, problem = parent_target(path, line)
    if not target:
        tmux("display-message", "hx-hunk: " + problem)
        return
    _, rel, old = target
    state = os.path.join(os.environ.get("TMPDIR", "/tmp"), "hx-hunk-" + pane.strip("%"))
    stamp = f"{os.getpid()}-{time.time()}"
    with open(state + ".want", "w") as out:
        out.write(stamp)
    lock = state + ".lock"
    for _ in range(60):
        try:
            os.mkdir(lock)
            break
        except FileExistsError:
            try:
                if time.time() - os.path.getmtime(lock) > 5:
                    os.rmdir(lock)
            except OSError:
                pass
            time.sleep(0.05)
    else:
        return
    try:
        if open(state + ".want").read() != stamp:
            return
        if steer(pane, f"open {rel}:{old}"):
            time.sleep(0.05)
            tmux("send-keys", "-t", pane, "z", "z")
    finally:
        try:
            os.rmdir(lock)
        except OSError:
            pass


def parse_hunks(diff):
    """[(new_start, new_end, [(kind, old_no, new_no, text)])] from a unified diff."""
    hunks, rows, old, new = [], None, 0, 0
    for raw in diff.splitlines():
        m = re.match(r"@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", raw)
        if m:
            old, new = int(m[1]), int(m[3])
            count = int(m[4]) if m[4] is not None else 1
            rows = []
            hunks.append((new, new + max(count, 1) - 1, rows))
        elif rows is None or raw.startswith("\\"):
            continue
        elif raw.startswith("-"):
            rows.append(("-", old, None, raw[1:]))
            old += 1
        elif raw.startswith("+"):
            rows.append(("+", None, new, raw[1:]))
            new += 1
        else:
            rows.append((" ", old, new, raw[1:]))
            old += 1
            new += 1
    return hunks


def pick(hunks, line):
    def distance(h):
        start, end, _ = h
        return 0 if start <= line <= end else min(abs(line - start), abs(line - end))
    index = min(range(len(hunks)), key=lambda i: distance(hunks[i]))
    return index, distance(hunks[index])


def spans(old_text, new_text):
    """Which character ranges differ between a removed line and the line that replaced it."""
    split = lambda s: re.findall(r"\w+|\s+|.", s)
    a, b = split(old_text), split(new_text)
    matcher = difflib.SequenceMatcher(None, a, b, autojunk=False)
    if matcher.ratio() < 0.5:
        return None, None
    old_hi, new_hi = [], []
    apos = [0]
    for tok in a:
        apos.append(apos[-1] + len(tok))
    bpos = [0]
    for tok in b:
        bpos.append(bpos[-1] + len(tok))
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == "equal":
            continue
        if i2 > i1:
            old_hi.append((apos[i1], apos[i2]))
        if j2 > j1:
            new_hi.append((bpos[j1], bpos[j2]))
    return old_hi, new_hi


def pair_changes(rows):
    """Map row index -> highlight spans, pairing each run of removals with the additions after it."""
    marks, i = {}, 0
    while i < len(rows):
        if rows[i][0] != "-":
            i += 1
            continue
        dels = i
        while i < len(rows) and rows[i][0] == "-":
            i += 1
        adds = i
        while i < len(rows) and rows[i][0] == "+":
            i += 1
        # Word-level marks only when the run is line-for-line (N removed, N added). A rewrite
        # of a different shape pairs unrelated lines and the marks become noise.
        if adds - dels != i - adds:
            continue
        for k in range(adds - dels):
            old_hi, new_hi = spans(rows[dels + k][3], rows[adds + k][3])
            if old_hi is not None:
                marks[dels + k], marks[adds + k] = old_hi, new_hi
    return marks


def paint(text, hi, base, strong, width):
    """Wrap text to width, colouring highlighted spans; returns a list of screen lines."""
    text = text.expandtabs(2)
    hi = hi or []
    out, col, line = [], 0, base
    state = None
    for pos, ch in enumerate(text):
        want = strong if any(s <= pos < e for s, e in hi) else base
        if col == width:
            out.append(line + RESET)
            line, col, state = base, 0, None
        if want != state:
            line += RESET + want
            state = want
        line += ch
        col += 1
    out.append(line + RESET)
    return out


def frame(path, line, width, height):
    folder, name = os.path.split(path)
    inside = run("git", "rev-parse", "--show-toplevel", cwd=folder)
    if inside.returncode != 0:
        return [f"{DIM}{name}: not in a git checkout{RESET}"]
    root = inside.stdout.strip()
    rel = os.path.relpath(os.path.realpath(path), os.path.realpath(root))
    base = run("git", "rev-parse", "--short", "HEAD", cwd=root).stdout.strip()
    title = f"{BOLD}{rel}{RESET}"

    tracked = run("git", "cat-file", "-e", f"HEAD:{rel}", cwd=root).returncode == 0
    if not tracked:
        return [title, "", f"{GREEN}New file. It does not exist in {base}, so every line is new.{RESET}"]
    diff = run("git", "diff", "--no-color", "--no-ext-diff", "-U3", "HEAD", "--", rel, cwd=root).stdout
    hunks = parse_hunks(diff)
    if not hunks:
        return [title, "", f"{DIM}No changes against {base}.{RESET}"]

    index, distance = pick(hunks, line)
    start, end, rows = hunks[index]
    where = "" if distance == 0 else f"  {DIM}(nearest to line {line}){RESET}"
    head = [
        title,
        f"{CYAN}change {index + 1} of {len(hunks)}{RESET}  {DIM}lines {start}-{end}  against {base}{RESET}{where}",
        "",
    ]

    marks = pair_changes(rows)
    numw = len(str(max(end, max((r[1] or 0) for r in rows))))
    textw = max(20, width - numw - 4)
    body, cursor_row = [], 0
    for i, (kind, old_no, new_no, text) in enumerate(rows):
        number = new_no if new_no is not None else old_no
        if kind == "-":
            base_c, strong, sign = RED, RED_HI, "-"
        elif kind == "+":
            base_c, strong, sign = GREEN, GREEN_HI, "+"
        else:
            base_c, strong, sign = DIM, DIM, " "
        pointer = "▶" if new_no == line else " "
        if new_no == line:
            cursor_row = len(body)
        wrapped = paint(text, marks.get(i), base_c, strong, textw)
        for n, piece in enumerate(wrapped):
            if n == 0:
                gutter = f"{pointer}{base_c}{number:>{numw}} {sign}{RESET} "
            else:
                gutter = " " * (numw + 4)
            body.append(gutter + piece)

    room = max(3, height - len(head))
    if len(body) > room:
        top = max(0, min(cursor_row - room // 2, len(body) - room))
        clipped = body[top:top + room]
        if top > 0:
            clipped[0] = f"{DIM}  ↑ {top} more{RESET}"
        below = len(body) - (top + room)
        if below > 0:
            clipped[-1] = f"{DIM}  ↓ {below} more{RESET}"
        body = clipped
    return head + body


def main():
    args = sys.argv[1:]
    mode = "--show"
    if args and args[0] in ("--show", "--parent", "--refresh", "--close"):
        mode = args.pop(0)
    hx_pane = os.environ.get("TMUX_PANE", "")
    if not hx_pane:
        print("hx-hunk: not in tmux")
        return
    pane = find_pane(hx_pane)
    kind = pane_kind(hx_pane) if pane else ""
    if mode == "--close":
        close_pane(hx_pane, pane)
        return
    if mode == "--refresh" and not pane:
        return
    if len(args) < 2 or not os.path.isfile(args[0]):
        if mode != "--refresh":
            print("hx-hunk: this buffer is not a file on disk")
        return
    path = os.path.abspath(args[0])
    line = int(args[1]) if args[1].isdigit() else 1
    want = kind if mode == "--refresh" else ("parent" if mode == "--parent" else "paint")

    if want == "parent":
        if kind == "parent":
            # Steering takes a few tenths of a second; never hold Helix's :sh for it.
            if os.fork():
                return
            os.setsid()
            follow(hx_pane, pane, path, line)
            return
        target, problem = parent_target(path, line)
        if not target:
            tmux("display-message", "hx-hunk: " + problem)
            return
        old_root, rel, old = target
        close_pane(hx_pane, pane)
        open_pane(hx_pane, "parent", old_root, f"exec hx {rel}:{old}")
        return

    if kind == "parent":
        close_pane(hx_pane, pane)
        pane = ""
    if not pane:
        pane = open_pane(hx_pane)
    tty, width, height = tmux(
        "display-message", "-p", "-t", pane, "#{pane_tty} #{pane_width} #{pane_height}"
    ).split()
    lines = frame(path, line, int(width) - 1, int(height) - 1)
    with open(tty, "w") as out:
        out.write("\033[?25l\033[H\033[2J\033[3J" + "\r\n".join(lines))


if __name__ == "__main__":
    main()
