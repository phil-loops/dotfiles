#!/bin/zsh
# Stack Archive - hide/show a registered stack-project in the blessed viewer
# chooser (and the swiftbar menu) WITHOUT unregistering it. Non-destructive and
# reversible: toggles the git-config flag `stack-project.<name>.archived`. The
# branch-seed multivar (`.branch`) is left untouched, so the project comes back
# exactly as it was.
#
# Usage: stack archive [project]      # hide from chooser (archived=true)
#        stack unarchive [project]    # show again (unset archived)
#        stack archived               # list archived projects
# No project + a TTY → fzf-pick (archive: from visible; unarchive: from archived).

set -e

op="$1"; shift 2>/dev/null || true

# Enumerate registered projects, partitioned by the archived flag.
typeset -A seen
typeset -a all_projects archived_projects visible_projects
while IFS=' ' read -r key value; do
  [[ -z "$key" ]] && continue
  name="${key#stack-project.}"; name="${name%.branch}"
  [[ -n "${seen[$name]:-}" ]] && continue
  seen[$name]=1
  all_projects+=("$name")
  if [[ "$(git config --bool stack-project.${name}.archived 2>/dev/null)" == "true" ]]; then
    archived_projects+=("$name")
  else
    visible_projects+=("$name")
  fi
done < <(git config --get-regexp '^stack-project\..*\.branch$' 2>/dev/null || true)

die() { echo "$1" >&2; exit 1; }

if (( ${#all_projects[@]} == 0 )); then
  die "No stack-projects registered in this repo."
fi

# pick <prompt> <candidate...> → echoes the chosen name, or exits.
pick() {
  local prompt="$1"; shift
  (( $# == 0 )) && die "nothing to ${prompt}."
  [[ -t 1 ]] || die "no project given (non-interactive). Usage: stack ${prompt} <project>"
  printf '%s\n' "$@" | fzf --prompt="${prompt}> " --height=40% --reverse \
    --preview="git config --get-all stack-project.{}.branch" --preview-window=right:55% \
    || exit 130
}

known() { [[ -n "${seen[$1]:-}" ]] || die "No stack-project '$1'. Known: ${all_projects[*]}"; }

case "$op" in
  archive)
    name="${1:-$(pick archive "${visible_projects[@]}")}"
    known "$name"
    git config stack-project.${name}.archived true
    echo "✦ archived '$name' — hidden from the chooser  (stack unarchive $name to restore)"
    ;;
  unarchive)
    name="${1:-$(pick unarchive "${archived_projects[@]}")}"
    known "$name"
    git config --unset stack-project.${name}.archived 2>/dev/null || true
    echo "✦ unarchived '$name' — visible in the chooser again"
    ;;
  list|archived|"")
    if (( ${#archived_projects[@]} == 0 )); then
      echo "No archived projects."
    else
      printf '%s\n' "${archived_projects[@]}"
    fi
    ;;
  *)
    echo "stack archive commands:" >&2
    echo "  stack archive [project]     hide a project from the chooser" >&2
    echo "  stack unarchive [project]   show it again" >&2
    echo "  stack archived              list archived projects" >&2
    exit 1
    ;;
esac
