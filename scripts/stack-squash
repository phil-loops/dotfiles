#!/usr/bin/env python3
"""stack-squash — collapse a branch's commits into ONE, with a message drafted in
*your* voice by a headless `claude`, learned from your recent commits on main.

  stack-squash <branch>            squash parent..branch + auto-commit (voiced msg)
  stack-squash --dry <branch>      draft the message + report, but DON'T rewrite
  stack-squash --unpushed <b>      squash only UNPUSHED commits (base = upstream if
                                   the branch is published, else its parent) — so a
                                   plain push works, never a force-push
  stack-squash --format <branch>   after committing, run oxfmt + oxlint --fix on the
                                   changed files and fold the fixes into the same commit
  stack-squash --subject-only <b>  draft a SUBJECT LINE ONLY — no body, no bullets
                                   (a smart one-line title for the squash)
  stack-squash --unstage <branch>  collapse parent..branch into UNSTAGED working-tree
                                   changes (reset --mixed base) — NO commit, no message;
                                   hand the commit to GitHub Desktop. Skips claude.
  stack-squash --message=<msg> <b> use <msg> verbatim as the commit message (the
                                   composer wrote it) — skips drafting entirely
  stack-squash --no-voice <b>      skip the claude draft: commit with the mechanical
                                   message (newest non-wip subject) — instant; voice
                                   the message later, on demand
  stack-squash --reseat <b>        after the squash moves the tip, REPLAY the descendant
                                   subtree onto it (cut at each old parent tip, parent-first)
                                   so stacked children don't orphan. Refuses (leaving the base
                                   un-squashed) if any descendant is checked out or pushed; a
                                   rebase conflict rolls the whole subtree back. Reports
                                   `reseated:[...]`. Without it, squash punts the reseat to the
                                   caller (the interactive viewer still does its own _reseat_walk).

`--unpushed` + `--format` together is the "prep for push" combo; add `--reseat` to also
carry the stack. Flags compose and may appear in any order before <branch>.

Safe-by-default: refuses on a dirty working tree. Without --reseat it does NOT restack
descendants. Emits a JSON report on stdout: {ok, branch, parent, base, n, sha, header,
message, voiced, formatted, reseated, err}. `voiced` is false when claude was unavailable
and we fell back to a mechanical message.

Env: CLAUDE_BIN (default "claude"), SQUASH_MODEL (optional --model passthrough),
MAIN_BRANCH (default "main").
"""
import sys, os, json, re, subprocess, time

CLAUDE_BIN = os.environ.get("CLAUDE_BIN", "claude")
MAIN = os.environ.get("MAIN_BRANCH", "main")
STACK_BASE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "stack-base")


_cwd = None   # set to a worktree path once we know where to mutate (see below)

# We mutate in whatever worktree the branch lives in — often the MAIN checkout,
# whose .git/index is shared with anything else watching it (GitHub Desktop polling
# `git status` grabs .git/index.lock for ~100ms at a time). A `reset`/`commit` that
# reaches for the lock mid-poll would otherwise fail outright and leave the squash
# half-done. So retry on the lock's signature: back off briefly and try again — the
# lock clears in well under a second. Gated on the stderr signature, so read-only
# calls and genuine failures (e.g. a missing ref) are never retried.
_LOCK_RE = re.compile(r"index\.lock.*File exists", re.S)


def git(args, **kw):
    if _cwd and "cwd" not in kw:
        kw["cwd"] = _cwd
    r = subprocess.run(["git", *args], capture_output=True, text=True, **kw)
    for attempt in range(5):   # 0.15+0.30+0.45+0.60+0.75 ≈ 2.25s of patience, max
        if r.returncode == 0 or not _LOCK_RE.search(r.stderr or ""):
            return r
        time.sleep(0.15 * (attempt + 1))
        r = subprocess.run(["git", *args], capture_output=True, text=True, **kw)
    return r


def worktrees():
    """[(path, branch_or_None)] from `git worktree list`, main worktree first."""
    out, path = [], None
    for ln in git(["worktree", "list", "--porcelain"]).stdout.splitlines():
        if ln.startswith("worktree "):
            path = ln[len("worktree "):]
        elif ln.startswith("branch ") and path is not None:
            out.append((path, ln[len("branch "):]))
            path = None
        elif ln == "" and path is not None:   # detached worktree (no branch line)
            out.append((path, None))
            path = None
    if path is not None:
        out.append((path, None))
    return out


def out(d):
    print(json.dumps(d))
    sys.exit(0 if d.get("ok") else 1)


def children_of(b):
    """branches whose stack-branch.<child>.parent points at b (direct children)."""
    kids = []
    for ln in git(["config", "--get-regexp", r"^stack-branch\..*\.parent$"]).stdout.splitlines():
        key, _, val = ln.partition(" ")
        if val.strip() == b and key.startswith("stack-branch.") and key.endswith(".parent"):
            kids.append(key[len("stack-branch."):-len(".parent")])
    return kids


def subtree(base):
    """(node, parent) pairs for base + all descendants, BFS parent-before-child order."""
    order, frontier = [(base, None)], [base]
    while frontier:
        node = frontier.pop(0)
        for c in children_of(node):
            order.append((c, node)); frontier.append(c)
    return order


def reseat_gate(base):
    """Reason a base's subtree can't be safely reseated, or None. Run BEFORE squashing so an
    unreseatable base is left untouched (no squash) rather than squashed-then-orphaned. A
    descendant checked out in a worktree can't be rewritten under a live session; a pushed one
    would need a force-push."""
    live = {b for _, b in worktrees() if b}
    for node, _ in subtree(base)[1:]:
        if f"refs/heads/{node}" in live:
            return f"{node} is checked out — reseat would rewrite a live worktree"
        if git(["rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{node}"]).returncode == 0:
            return f"{node} is pushed — reseat would need a force-push"
    return None


def reseat_cascade(base, old_base_tip, base_wt):
    """After the base tip moved (old_base_tip → HEAD), replay every descendant onto its parent's
    NEW tip, cut at the parent's OLD tip, parent-first — the reseat stack-squash historically
    punted to the caller. Conflict → roll the WHOLE subtree back to pre-squash tips (undoing the
    squash: base via reset --hard in its worktree, descendants via branch -f) so a failed reseat
    never leaves a half-moved or orphaned stack. Returns {reseated:[...]} | {conflict:branch}."""
    order = subtree(base)
    if len(order) == 1:
        return {"reseated": []}
    snap = {node: git(["rev-parse", node]).stdout.strip() for node, _ in order}
    snap[base] = old_base_tip   # base already moved; its pre-squash tip is the rollback + cut point

    def rollback():
        for nb, sha in snap.items():
            if nb == base and base_wt:
                git(["reset", "--hard", sha], cwd=base_wt)
            else:
                git(["branch", "-f", nb, sha], cwd=None)

    scratch = subprocess.run(["mktemp", "-d", "-t", "squash-reseat"], capture_output=True, text=True).stdout.strip()
    git(["worktree", "add", "--detach", scratch, base], cwd=None)
    try:
        for node, par in order[1:]:
            oldp, newp = snap[par], git(["rev-parse", par]).stdout.strip()
            if git(["rebase", "--onto", newp, oldp, node], cwd=scratch).returncode != 0:
                git(["rebase", "--abort"], cwd=scratch)
                rollback()
                return {"conflict": node}
        return {"reseated": [n for n, _ in order[1:]]}
    finally:
        git(["worktree", "remove", "--force", scratch], cwd=None)


# ---- args ----------------------------------------------------------------
argv = sys.argv[1:]
dry = unpushed = fmt = subject_only = unstage = no_voice = reseat = False
provided_msg = ""   # --message=<msg>: use this verbatim (the composer wrote it), skip drafting
rest = []
for a in argv:
    if a == "--dry":
        dry = True
    elif a == "--unpushed":
        unpushed = True
    elif a == "--format":
        fmt = True
    elif a == "--subject-only":
        subject_only = True
    elif a == "--unstage":
        unstage = True
    elif a == "--no-voice":
        no_voice = True
    elif a == "--reseat":
        reseat = True
    elif a.startswith("--message="):
        provided_msg = a[len("--message="):]
    else:
        rest.append(a)
branch = (rest[0] if rest else "").strip()
if not branch:
    out({"ok": False, "err": "usage: stack-squash [--dry] [--unpushed] [--format] [--subject-only] [--unstage] [--no-voice] <branch>"})

# branch must exist
if git(["rev-parse", "--verify", "--quiet", branch]).returncode != 0:
    out({"ok": False, "branch": branch, "err": f"no such branch: {branch}"})

orig_tip = git(["rev-parse", branch]).stdout.strip()   # pre-squash tip: reseat cut + rollback point

parent = git(["config", f"stack-branch.{branch}.parent"]).stdout.strip() or MAIN

# squash base: the FROZEN commit the branch sits on, via stack-base (resolves the
# recorded stack-branch.<b>.base, else merge-base(parent, branch)). Never reset
# against the parent *name* — `main` is a moving ref, and resolving it here would
# fold main's advance into the squash. --unpushed instead bases on the branch's
# upstream (so only never-pushed commits collapse — a plain push lands them, no
# force-push); if the branch was never published, fall back to the frozen base.
sb = subprocess.run([STACK_BASE, branch], capture_output=True, text=True)
base = sb.stdout.strip() or git(["merge-base", parent, branch]).stdout.strip() or parent
# Clamp a ROOT branch's base FORWARD to its real fork with origin/main. The frozen
# .base goes stale-OLD when a restack rebases the branch onto a NEWER origin/main but
# leaves .base at the old fork: `reset --soft <old-base>` would then fold origin/main's
# whole advance (every commit between the old base and the new tip) into the squash —
# the bug that swept 5 upstream PRs into a one-file goal commit. For a branch rooted on
# main the true fork point is merge-base(origin/main, branch); use it whenever the frozen
# base sits strictly behind it. (Stacked branches keep their parent fork — untouched.)
if parent == MAIN:
    omb = git(["merge-base", "origin/main", branch]).stdout.strip()
    if omb and omb != base and git(["merge-base", "--is-ancestor", base, omb]).returncode == 0:
        base = omb
force = False   # will pushing the squashed branch need a force? (true once published history is rewritten)
if unpushed:
    up = git(["rev-parse", "--abbrev-ref", f"{branch}@{{upstream}}"])
    cand = up.stdout.strip()
    published = (up.returncode == 0 and cand
                 and git(["rev-parse", "--verify", "--quiet", cand]).returncode == 0)
    if published:
        # Only base on the upstream when it's actually an ANCESTOR of the branch — i.e.
        # the branch is "remote + new commits" and a plain push lands them. If the branch
        # was REBASED, its old remote is a stale ancestor on a different base; basing on it
        # would sweep every intervening commit (origin/main's advance + pre-rebase history)
        # into the squash. In that case keep the frozen fork-point base so only the branch's
        # OWN commits collapse — and the push needs a force (the remote has diverged).
        if git(["merge-base", "--is-ancestor", cand, branch]).returncode == 0:
            base = cand
        else:
            force = True

# the commits we'd collapse
log = git(["log", f"{base}..{branch}", "--format=%h %s"]).stdout.strip()
commits = [ln for ln in log.splitlines() if ln]
n = len(commits)
if n == 0:
    out({"ok": False, "branch": branch, "parent": parent, "base": base, "n": 0,
         "err": f"{branch} has no {'unpushed ' if unpushed else ''}commits beyond {base} — nothing to squash"})

# ---- --unstage: collapse to UNSTAGED working-tree changes, no commit ------
# Hand the commit to GitHub Desktop. `reset --mixed base` moves HEAD+index to base but
# leaves the working tree at the branch tip, so the whole parent..branch diff shows up as
# unstaged changes. No commit ⇒ no voiced message, so skip the drafting below entirely.
if unstage:
    if dry:
        out({"ok": True, "branch": branch, "parent": parent, "base": base, "n": n,
             "unstaged": True, "dry": True})
    branch_wt = next((p for p, b in worktrees() if b == f"refs/heads/{branch}"), None)
    if branch_wt:
        _cwd = branch_wt
    if git(["status", "--porcelain", "--untracked-files=no"]).stdout.strip():
        where = f" in worktree {branch_wt}" if branch_wt else ""
        out({"ok": False, "branch": branch, "parent": parent, "base": base, "n": n,
             "err": f"working tree is dirty{where} — commit or stash first"})
    if not branch_wt:
        co = git(["checkout", branch])
        if co.returncode != 0:
            out({"ok": False, "branch": branch, "parent": parent, "base": base, "n": n,
                 "err": "checkout failed: " + co.stderr.strip()})
    rs = git(["reset", "--mixed", base])
    if rs.returncode != 0:
        out({"ok": False, "branch": branch, "parent": parent, "base": base, "n": n,
             "err": "reset --mixed failed: " + rs.stderr.strip()})
    out({"ok": True, "branch": branch, "parent": parent, "base": base, "n": n, "unstaged": True})

# ---- draft the message in your voice -------------------------------------
author = git(["config", "user.name"]).stdout.strip() or "the author"
# voice corpus: your recent subjects+bodies on main (study the style, don't copy)
corpus = git(["log", MAIN, f"--author={author}", "-n", "25",
              "--no-merges", "--format=%s%n%b%n---"]).stdout.strip()
subjects = "\n".join("  " + c for c in commits)
diffstat = git(["diff", "--stat", f"{base}...{branch}"]).stdout.strip()
patch = git(["diff", f"{base}...{branch}"]).stdout
patch_clip = "\n".join(patch.splitlines()[:300])   # keep the prompt bounded

if subject_only:
    write_instr = (
        f"Write ONE commit message that is a SUBJECT LINE ONLY — a single line in {author}'s "
        f"voice (their prefix/scope convention, imperative, terse) capturing the whole squashed "
        f"change. NO body, NO blank line, NO bullets — output just the one subject line."
    )
else:
    write_instr = (
        f"Write ONE commit message:\n"
        f"- A subject line in {author}'s voice (their prefix/scope convention, imperative, terse).\n"
        f"- Then a blank line, then a SHORT body that summarizes what got folded in: 2-4 terse\n"
        f"  bullet points, one per distinct change being squashed (derive them from the commits\n"
        f"  and diff above — e.g. the impl, a refactor, the tests). Keep each bullet to one line,\n"
        f"  in the author's voice. If only one trivial change is being squashed, the body may be\n"
        f"  a single line instead of bullets."
    )

prompt = f"""You are drafting a single git commit message in {author}'s voice for a squashed branch.

Study {author}'s recent commit messages and match their conventions EXACTLY — prefix
style (e.g. conventional-commit `type(scope):`), imperative mood, subject length, when
they write a body vs. not, tone and terseness:

<voice-examples>
{corpus}
</voice-examples>

This squash collapses {n} commit(s) on branch `{branch}` (onto `{base}`). The subjects
are often just "wip" — rely on the DIFF below for what actually changed:
<commits>
{subjects}
</commits>

<diffstat>
{diffstat}
</diffstat>

<diff>
{patch_clip}
</diff>

{write_instr}

Output ONLY the raw commit message — no preface, no explanation, no code fences."""

# a composer-written message is used verbatim — it IS the voice, so no drafting call
message = provided_msg.strip()
voiced = bool(message)
if not message and not no_voice:
    try:
        cmd = [CLAUDE_BIN, "-p"]
        if os.environ.get("SQUASH_MODEL"):
            cmd += ["--model", os.environ["SQUASH_MODEL"]]
        r = subprocess.run(cmd, input=prompt, capture_output=True, text=True, timeout=120)
        draft = (r.stdout or "").strip().strip("`").strip()
        if draft:
            message = draft
            voiced = True
    except Exception:
        pass

if not message:
    # mechanical fallback — the newest non-"wip" subject, else the top one, sans hash
    pick = next((c for c in commits if c.split(" ", 1)[-1].strip().lower() != "wip"), commits[0])
    top = pick.split(" ", 1)
    message = top[1] if len(top) > 1 else f"squash {branch}"

if subject_only and message:
    # guarantee no body regardless of what the draft (or fallback) returned
    message = message.splitlines()[0].strip()

header = message.splitlines()[0] if message else f"squash {branch}"


def report(**extra):
    return {"ok": True, "branch": branch, "parent": parent, "base": base, "n": n,
            "header": header, "message": message, "voiced": voiced, "force": force,
            "subject_only": subject_only, **extra}


if dry:
    out(report(dry=True, unpushed=unpushed))

# --reseat gate: refuse BEFORE squashing if the subtree can't be safely reseated, so an
# unreseatable base is left wholly untouched rather than squashed-then-orphaned.
if reseat:
    skip = reseat_gate(branch)
    if skip:
        out({"ok": False, "branch": branch, "parent": parent, "base": base, "n": n,
             "header": header, "message": message, "voiced": voiced,
             "err": f"reseat refused: {skip}", "reseat": "refused"})

# ---- squash --------------------------------------------------------------
def fail(err):
    out({"ok": False, "branch": branch, "parent": parent, "base": base, "n": n,
         "header": header, "message": message, "voiced": voiced, "err": err})


# Where to mutate. git refuses `checkout <branch>` when that branch is already
# checked out in another worktree (Phil's worktree-per-feature workflow). So if
# the branch lives in a worktree, operate THERE — it's already checked out, no
# `checkout` needed. Otherwise check it out in the main repo as before.
wts = worktrees()
main_wt = wts[0][0] if wts else None
branch_wt = next((p for p, b in wts if b == f"refs/heads/{branch}"), None)

if branch_wt:
    _cwd = branch_wt   # all subsequent git() calls run here (read-only ref calls are cwd-agnostic)
    if git(["status", "--porcelain", "--untracked-files=no"]).stdout.strip():
        fail(f"working tree is dirty in worktree {branch_wt} — commit or stash first (squash needs a clean checkout)")
else:
    if git(["status", "--porcelain", "--untracked-files=no"]).stdout.strip():
        fail("working tree is dirty — commit or stash first (squash needs a clean checkout)")
    co = git(["checkout", branch])
    if co.returncode != 0:
        fail("checkout failed: " + co.stderr.strip())

rs = git(["reset", "--soft", base])
if rs.returncode != 0:
    fail("reset --soft failed: " + rs.stderr.strip())

ci = git(["commit", "-m", message])
if ci.returncode != 0:
    fail("commit failed: " + ci.stderr.strip())

# ---- format (fold oxfmt fixes into the same commit) ----------------------
formatted = 0
if fmt:
    repo = git(["rev-parse", "--show-toplevel"]).stdout.strip()
    oxfmt = os.path.join(repo, "node_modules", ".bin", "oxfmt")
    # worktrees usually have no node_modules — borrow the main worktree's oxfmt
    # (cwd stays `repo`, so it reads the worktree's own config + files)
    if not os.path.exists(oxfmt) and main_wt:
        oxfmt = os.path.join(main_wt, "node_modules", ".bin", "oxfmt")
    oxlint = os.path.join(repo, "node_modules", ".bin", "oxlint")
    if not os.path.exists(oxlint) and main_wt:
        oxlint = os.path.join(main_wt, "node_modules", ".bin", "oxlint")
    files = [f for f in git(["diff", "--name-only", f"{base}..HEAD"]).stdout.split()
             if os.path.exists(os.path.join(repo, f))]
    ran = False
    if files and os.path.exists(oxfmt):
        subprocess.run([oxfmt, "--write", *files], cwd=repo, capture_output=True, text=True)
        ran = True
    if files and os.path.exists(oxlint):
        subprocess.run([oxlint, "--type-aware", "--quiet", "--fix", *files], cwd=repo, capture_output=True, text=True)
        ran = True
    if ran:
        porc = git(["status", "--porcelain"]).stdout.strip()   # tree was clean → any dirt is the fixers'
        if porc:
            formatted = len(porc.splitlines())
            git(["add", "-u"])
            git(["commit", "--amend", "--no-edit"])

new_sha = git(["rev-parse", "--short", "HEAD"]).stdout.strip()

# ---- --reseat: replay the descendant subtree onto the moved base ---------
reseated = None
if reseat:
    res = reseat_cascade(branch, orig_tip, _cwd)
    if "conflict" in res:
        out({"ok": False, "branch": branch, "parent": parent, "base": base, "n": n,
             "header": header, "message": message, "voiced": voiced,
             "err": f"reseat conflict on {res['conflict']} — squash rolled back, subtree restored",
             "reseat": "conflict"})
    reseated = res.get("reseated", [])

out(report(sha=new_sha, formatted=formatted, unpushed=unpushed, reseated=reseated))
