#!/usr/bin/env python3
"""Exercise editor transactions against disposable repositories, without remotes."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import threading
import time
import unittest
import uuid
from unittest import mock

sys.path.insert(0, str(Path(__file__).resolve().parent))
from srv import ctx, editartifacts, editlease, editprojection, edits, ghreview, state


class Request:
    def _send(self, code, body, *args):
        self.code, self.data = code, json.loads(body)


class EditSessions(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix="canopy-edit-test-")
        self.root = Path(self.temporary.name)
        self.processes = []
        self.repo = self.root / "repo"
        self.repo.mkdir()
        self.git("init", "-q", "-b", "main")
        for key, value in {"user.name": "Editor", "user.email": "editor@example.invalid", "commit.gpgsign": "false",
                           "core.hooksPath": str(self.root / "hooks")}.items():
            self.git("config", key, value)
        (self.repo / "a.txt").write_text("base\n")
        (self.repo / "untouched.txt").write_text("keep\n")
        self.git("add", ".")
        self.git("commit", "-qm", "base")
        self.base = self.git("rev-parse", "HEAD")
        self.git("checkout", "-qb", "feature")
        (self.repo / "a.txt").write_text("before\n")
        self.git("commit", "-qam", "feat: change a")
        self.tip = self.git("rev-parse", "HEAD")
        self.git("config", "branch.feature.stack-parent", "main")
        self.old = ctx.CWD, ctx.MAIN_WT, ctx.REPOS, ctx.run
        self.cleanup_patch = mock.patch.object(edits, "_cleanup_later")
        self.cleanup_patch.start()
        self.warm_patch = mock.patch.object(edits, "_warm_later")
        self.warm_patch.start()
        self.release_patch = mock.patch.object(edits, "_release_later")
        self.release_patch.start()
        ctx.CWD = ctx.MAIN_WT = str(self.repo)
        ctx.REPOS = {"fixture": str(self.repo)}
        ctx.run = lambda args, timeout=None: subprocess.run(args, cwd=ctx.repo_cwd(), capture_output=True, text=True)

    def tearDown(self):
        for process in self.processes:
            if process.poll() is None:
                process.terminate()
            process.communicate(timeout=5)
        self.cleanup_patch.stop()
        self.warm_patch.stop()
        self.release_patch.stop()
        ctx.CWD, ctx.MAIN_WT, ctx.REPOS, ctx.run = self.old
        ctx.clear_repo()
        self.temporary.cleanup()

    def git(self, *args):
        return subprocess.run(["git", "-C", str(self.repo), *args], capture_output=True, text=True, check=True).stdout.strip()

    def call(self, handler, data):
        req = Request()
        handler(req, json.dumps(data))
        self.assertEqual(req.code, 200)
        return req.data

    def prepare(self, branch="feature"):
        session = str(uuid.uuid4())
        data = {"branch": branch, "expectedTip": self.tip, "baseSha": self.base, "session": session, "epoch": state.EPOCH}
        answer = self.call(edits.prepare, data)
        self.assertTrue(answer["ok"], answer)
        edits._warm(str(self.repo), edits._root(session)[1])
        return data, Path(answer["dir"])

    def commit(self, data):
        return self.call(edits.commit, {**data, "operation": data["session"]})

    def leased(self, **options):
        data = {"branch": "feature", "expectedTip": self.tip, "baseSha": self.base, "session": str(uuid.uuid4()),
                "epoch": state.EPOCH, "leaseProtocol": 1, "entry": {"path": "a.txt", "line": 1, "col": 1}}
        data.update(options)
        answer = self.call(edits.prepare, data)
        self.assertTrue(answer["ok"], answer)
        data["attachment"] = answer["attachment"]["token"]
        return data, Path(answer["dir"]), answer["attachment"]

    def test_released_reviews_invalidate_tickets_and_retire_only_owned_clean_checkouts(self):
        data, checkout, attachment = self.leased(viewOwner=str(uuid.uuid4()))
        root = edits._root(data["session"])[1]
        edits._warm(str(self.repo), root)
        self.assertTrue((root / "warm-index").exists())
        result = self.call(edits.release, data)
        self.assertTrue(result["released"])
        process = self.launcher(attachment, checkout, wait=False)
        _, error = process.communicate(timeout=5)
        self.assertEqual(process.returncode, 75)
        self.assertIn("no longer current", error)
        self.assertFalse(self.call(edits.prepare, data)["ok"])
        edits._release_checkout(str(self.repo), root)
        self.assertFalse(checkout.exists())
        self.assertFalse((root / "warm-index").exists())
        self.assertEqual(edits._load(root)["checkoutState"], "retired")
        self.assertTrue(self.call(edits.release, data)["released"])
        edits._release_checkout(str(self.repo), root)
        self.assertEqual(self.git("rev-parse", "feature"), self.tip)

    def test_review_readiness_includes_index_preparation_without_a_later_workspace_lock_holder(self):
        records = []
        original = edits._save
        def capture(path, value, **kw):
            records.append(json.loads(json.dumps(value)))
            original(path, value, **kw)
        with mock.patch.object(edits, "_save", side_effect=capture):
            data, _, attachment = self.leased(viewOwner=str(uuid.uuid4()))
        self.assertEqual([record["state"] for record in records], ["preparing", "editing"])
        ready = records[-1]
        root = edits._root(data["session"])[1]
        self.assertTrue(editartifacts.matches(root, ready, "warm-index"))
        self.assertEqual(ready["attachment"]["token"], attachment["token"])
        self.assertEqual(ready["indexStamp"], edits._stamp(Path(ready["gitdir"]) / "index"))
        edits._warm_later.assert_not_called()

    def test_release_before_preparation_is_a_durable_cancellation(self):
        data = {"session": str(uuid.uuid4()), "viewOwner": str(uuid.uuid4()), "branch": "feature",
                "expectedTip": self.tip, "baseSha": self.base, "epoch": state.EPOCH, "leaseProtocol": 1,
                "entry": {"path": "a.txt", "line": 1, "col": 1}}
        self.assertTrue(self.call(edits.release, data)["released"])
        with mock.patch.object(edits, "_git", side_effect=AssertionError("a cancelled review never materializes")):
            self.assertFalse(self.call(edits.prepare, data)["ok"])
        self.assertFalse((edits._root(data["session"])[1] / "checkout").exists())
        self.assertFalse(self.commit(data)["ok"])
        self.assertEqual(self.call(edits.workspaces, {"epoch": state.EPOCH, "branch": "feature"})["workspaces"], [])

    def test_release_cannot_reclaim_a_workspace_once_an_editor_entered_it(self):
        data, checkout, attachment = self.leased(viewOwner=str(uuid.uuid4()))
        process = self.launcher(attachment, checkout, position="a.txt:4:2")
        self.assertEqual(edits._load(edits._root(data["session"])[1])["entry"], {"path": "a.txt", "line": 4, "col": 2})
        (checkout / "a.txt").write_text("keep my file\n")
        self.assertTrue(self.call(edits.release, data)["preserved"])
        process.kill()
        process.wait()
        self.assertTrue(self.call(edits.release, data)["preserved"])
        resumed = self.call(edits.prepare, {key: value for key, value in data.items() if key != "viewOwner"})
        self.assertTrue(resumed["ok"], resumed)
        self.assertTrue(self.call(edits.release, data)["preserved"])
        self.assertEqual((checkout / "a.txt").read_text(), "keep my file\n")
        self.assertNotEqual(resumed["attachment"]["token"], attachment["token"])

    def test_a_review_workspace_refuses_other_owners_and_never_appears_as_an_abandoned_edit(self):
        data, checkout, attachment = self.leased(viewOwner=str(uuid.uuid4()))
        for handler in (edits.prepare, edits.release):
            self.assertFalse(self.call(handler, {**data, "viewOwner": str(uuid.uuid4())})["ok"])
        self.assertFalse(self.call(edits.prepare, {key: value for key, value in data.items() if key != "viewOwner"})["ok"])
        self.assertEqual(self.call(edits.workspaces, {"epoch": state.EPOCH})["workspaces"], [])
        process = self.launcher(attachment, checkout)
        process.kill()
        process.wait()
        self.assertTrue(self.call(edits.workspaces, {"epoch": state.EPOCH})["workspaces"][0]["resumable"])

    def test_review_release_preserves_external_changes_and_unknown_generated_files(self):
        for name in ("a.txt", "untracked.txt", "ignored.txt"):
            data, checkout, _ = self.leased(viewOwner=str(uuid.uuid4()))
            if name == "ignored.txt":
                (Path(edits._load(edits._root(data["session"])[1])["gitdir"]) / "info").mkdir(exist_ok=True)
                with (self.repo / ".git/info/exclude").open("a") as out:
                    out.write("\nignored.txt\n")
            (checkout / name).write_text("external changes\n")
            root = edits._root(data["session"])[1]
            (root / "snapshot-index").write_text("unknown generated name")
            self.assertTrue(self.call(edits.release, data)["released"])
            edits._release_checkout(str(self.repo), root)
            self.assertEqual((checkout / name).read_text(), "external changes\n")
            self.assertEqual((root / "snapshot-index").read_text(), "unknown generated name")
            self.assertEqual(edits._load(root)["checkoutState"], "preserved")

    def test_release_survives_an_epoch_change_but_cannot_cancel_another_repository(self):
        data, checkout, _ = self.leased(viewOwner=str(uuid.uuid4()))
        with mock.patch.object(state, "EPOCH", "another-epoch"):
            self.assertTrue(self.call(edits.release, data)["released"])
        root = edits._root(data["session"])[1]
        saved = edits._load(root)
        saved["identity"] = [0, 0]
        edits._save(root / "session.json", saved)
        self.assertFalse(self.call(edits.release, data)["ok"])
        edits._release_checkout(str(self.repo), root)
        self.assertTrue(checkout.exists())

    def test_warming_a_released_view_cannot_recreate_index_artifacts(self):
        data, _, _ = self.leased(viewOwner=str(uuid.uuid4()))
        root = edits._root(data["session"])[1]
        self.call(edits.release, data)
        edits._release_checkout(str(self.repo), root)
        with mock.patch.object(edits.subprocess, "run", side_effect=AssertionError("a released review does no index warming")):
            edits._warm(str(self.repo), root)
        self.assertFalse((root / "warm-index").exists())

    def test_an_unused_review_with_manually_changed_index_flags_is_preserved(self):
        data, checkout, _ = self.leased(viewOwner=str(uuid.uuid4()))
        edits._git("update-index", "--assume-unchanged", "a.txt", cwd=checkout)
        (checkout / "a.txt").write_text("hidden external change\n")
        self.call(edits.release, data)
        edits._release_checkout(str(self.repo), edits._root(data["session"])[1])
        self.assertEqual((checkout / "a.txt").read_text(), "hidden external change\n")

    def test_a_replaced_review_checkout_is_never_retired_through_an_alias(self):
        data, checkout, _ = self.leased(viewOwner=str(uuid.uuid4()))
        original = checkout.with_name("moved-checkout")
        checkout.rename(original)
        checkout.symlink_to(original, target_is_directory=True)
        self.call(edits.release, data)
        edits._release_checkout(str(self.repo), edits._root(data["session"])[1])
        self.assertEqual((original / "a.txt").read_text(), "before\n")
        self.assertTrue(checkout.is_symlink())

    def test_review_retirement_replays_after_its_private_head_was_already_aligned(self):
        data, checkout, _ = self.leased(viewOwner=str(uuid.uuid4()))
        root = edits._root(data["session"])[1]
        self.call(edits.release, data)
        original = edits._git
        def interrupt(*args, **kw):
            if args[:2] == ("worktree", "remove"):
                raise ghreview.Refused("fixture interrupted removal")
            return original(*args, **kw)
        with mock.patch.object(edits, "_git", side_effect=interrupt):
            edits._release_checkout(str(self.repo), root)
        self.assertTrue(checkout.is_dir())
        self.assertEqual(Path(edits._load(root)["gitdir"], "HEAD").read_text().strip(), self.tip)
        edits._release_checkout(str(self.repo), root)
        self.assertFalse(checkout.exists())

    def test_review_release_preserves_a_checkout_with_an_unknown_lock_owner(self):
        data, checkout, _ = self.leased(viewOwner=str(uuid.uuid4()))
        root = edits._root(data["session"])[1]
        locked = Path(edits._load(root)["gitdir"], "locked")
        locked.write_text("another operation\n")
        self.call(edits.release, data)
        edits._release_checkout(str(self.repo), root)
        self.assertTrue(checkout.is_dir())
        self.assertEqual(locked.read_text(), "another operation\n")

    def test_release_of_an_interrupted_preparation_preserves_its_partial_checkout(self):
        data = {"session": str(uuid.uuid4()), "viewOwner": str(uuid.uuid4()), "branch": "feature",
                "expectedTip": self.tip, "baseSha": self.base, "epoch": state.EPOCH, "leaseProtocol": 1,
                "entry": {"path": "a.txt", "line": 1, "col": 1}}
        with mock.patch.object(edits, "_prepared", side_effect=ghreview.Refused("fixture interrupted readiness")):
            self.assertFalse(self.call(edits.prepare, data)["ok"])
        self.assertTrue(self.call(edits.release, data)["released"])
        root = edits._root(data["session"])[1]
        edits._release_checkout(str(self.repo), root)
        self.assertEqual((root / "checkout/a.txt").read_text(), "before\n")

    def test_a_prepared_review_rechecks_the_actual_branch_when_its_ticket_launches(self):
        data, checkout, attachment = self.leased(viewOwner=str(uuid.uuid4()))
        self.git("update-ref", "refs/heads/feature", self.base, self.tip)
        process = self.launcher(attachment, checkout, wait=False)
        _, error = process.communicate(timeout=5)
        self.assertEqual(process.returncode, 75)
        self.assertIn("branch moved", error)
        self.assertNotIn("entered", edits._load(edits._root(data["session"])[1]))

    def test_releasing_during_preparation_waits_for_the_owned_checkout_and_revokes_it(self):
        started, resume = threading.Event(), threading.Event()
        data = {"session": str(uuid.uuid4()), "viewOwner": str(uuid.uuid4()), "branch": "feature",
                "expectedTip": self.tip, "baseSha": self.base, "epoch": state.EPOCH, "leaseProtocol": 1,
                "entry": {"path": "a.txt", "line": 1, "col": 1}}
        original = edits._git
        def held(*args, **kw):
            if "read-tree" in args and "--reset" in args:
                started.set()
                if not resume.wait(10):
                    raise AssertionError("the fixture never released preparation")
            return original(*args, **kw)
        results = []
        def request(handler):
            ctx.set_repo(str(self.repo))
            try:
                results.append(self.call(handler, data))
            finally:
                ctx.clear_repo()
        with mock.patch.object(edits, "_git", side_effect=held):
            preparing = threading.Thread(target=request, args=(edits.prepare,))
            preparing.start()
            self.assertTrue(started.wait(10))
            releasing = threading.Thread(target=request, args=(edits.release,))
            releasing.start()
            resume.set()
            preparing.join(10)
            releasing.join(10)
        self.assertEqual(len(results), 2)
        self.assertTrue(all(result["ok"] for result in results), results)
        root = edits._root(data["session"])[1]
        self.assertEqual(edits._load(root)["state"], "released")
        edits._release_checkout(str(self.repo), root)
        self.assertFalse((root / "checkout").exists())

    def launcher(self, attachment, checkout, *, close_descriptors=False, wait=True, position="a.txt:1:1"):
        directory = self.root / "bin"
        directory.mkdir(exist_ok=True)
        hx = directory / "hx"
        hx.write_text('''#!/usr/bin/env python3
import os, pathlib, time
if os.environ.get("CLOSE_LEASE"):
    for fd in range(3, 256):
        try: os.close(fd)
        except OSError: pass
pathlib.Path(os.environ["EDITOR_READY"]).write_text(str(os.getpid()))
while True: time.sleep(1)
''')
        hx.chmod(0o755)
        ready = self.root / ("ready-" + str(uuid.uuid4()))
        env = {**os.environ, "PATH": str(directory) + os.pathsep + os.environ["PATH"], "EDITOR_READY": str(ready)}
        if close_descriptors:
            env["CLOSE_LEASE"] = "1"
        script = Path(__file__).resolve().parent / "canopy-editor"
        process = subprocess.Popen([sys.executable, str(script), attachment["record"], attachment["token"], position],
                                   cwd=checkout, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        self.processes.append(process)
        if wait:
            until = time.monotonic() + 5
            while not ready.exists() and process.poll() is None and time.monotonic() < until:
                time.sleep(0.01)
            self.assertTrue(ready.exists(), process.communicate() if process.poll() is not None else "the editor did not attach")
        return process

    def test_resuming_a_leased_workspace_keeps_its_identity_and_unsaved_files(self):
        data, checkout, attachment = self.leased()
        identity = checkout.stat().st_ino
        (checkout / "a.txt").write_text("unsaved editor files\n")
        answer = self.call(edits.prepare, data)
        self.assertTrue(answer["ok"], answer)
        self.assertEqual(answer["dir"], str(checkout))
        self.assertEqual(checkout.stat().st_ino, identity)
        self.assertEqual((checkout / "a.txt").read_text(), "unsaved editor files\n")
        self.assertNotEqual(answer["attachment"]["token"], attachment["token"])
        self.assertFalse(self.commit(data)["ok"])
        data["attachment"] = answer["attachment"]["token"]
        self.assertTrue(self.commit(data)["ok"])
        self.assertEqual(self.git("show", "feature:a.txt"), "unsaved editor files")

    def test_ready_workspaces_are_published_with_the_complete_attachment_in_one_record(self):
        records = []
        original = edits._save
        def capture(path, value, **kw):
            records.append(json.loads(json.dumps(value)))
            original(path, value, **kw)
        with mock.patch.object(edits, "_save", side_effect=capture):
            data, checkout, attachment = self.leased()
        self.assertEqual([record["state"] for record in records], ["preparing", "editing"])
        preparing, ready = records
        self.assertIn("identity", preparing["attachment"])
        self.assertNotIn("token", preparing["attachment"])
        self.assertEqual(ready["attachment"]["token"], attachment["token"])
        self.assertEqual(ready["attachment"]["identity"], preparing["attachment"]["identity"])
        self.assertIn("checkoutIdentity", ready)
        self.assertEqual(ready["expectedTip"], self.tip)

    def test_a_failed_readiness_publication_never_leaves_an_editable_partial_workspace(self):
        original = edits._save
        def fail(path, value, **kw):
            if value.get("state") == "editing":
                raise ghreview.Refused("fixture failed the readiness publication")
            original(path, value, **kw)
        data = {"branch": "feature", "expectedTip": self.tip, "baseSha": self.base, "session": str(uuid.uuid4()),
                "epoch": state.EPOCH, "leaseProtocol": 1, "entry": {"path": "a.txt", "line": 1, "col": 1}}
        with mock.patch.object(edits, "_save", side_effect=fail):
            self.assertFalse(self.call(edits.prepare, data)["ok"])
        root = edits._root(data["session"])[1]
        saved = edits._load(root)
        self.assertEqual(saved["state"], "preparing")
        self.assertNotIn("token", saved["attachment"])
        self.assertEqual((root / "checkout/a.txt").read_text(), "before\n")
        self.assertFalse(self.call(edits.prepare, data)["ok"])

    def test_live_editor_leases_survive_a_server_epoch_change(self):
        data, checkout, attachment = self.leased()
        process = self.launcher(attachment, checkout)
        (checkout / "a.txt").write_text("live edit\n")
        with mock.patch.object(state, "EPOCH", "restarted"):
            answer = self.call(edits.prepare, {**data, "epoch": "restarted"})
            self.assertFalse(answer["ok"])
            self.assertIn("live editor", answer["err"])
            self.assertFalse(self.commit({**data, "epoch": "restarted"})["ok"])
            listing = self.call(edits.workspaces, {"epoch": "restarted"})
            self.assertFalse(listing["workspaces"][0]["resumable"])
        self.assertNotIn("operation", edits._load(edits._root(data["session"])[1]))
        process.kill()
        process.wait()
        listing = self.call(edits.workspaces, {"epoch": state.EPOCH})
        self.assertTrue(listing["workspaces"][0]["resumable"])
        self.assertEqual((checkout / "a.txt").read_text(), "live edit\n")
        self.assertTrue(self.call(edits.prepare, data)["ok"])

    def test_process_birth_identity_protects_an_editor_that_closes_inherited_descriptors(self):
        data, checkout, attachment = self.leased()
        process = self.launcher(attachment, checkout, close_descriptors=True)
        answer = self.call(edits.prepare, data)
        self.assertFalse(answer["ok"])
        self.assertIn("live editor", answer["err"])
        self.assertFalse(self.commit(data)["ok"])
        process.kill()
        process.wait()
        self.assertTrue(self.call(edits.prepare, data)["ok"])

    def test_an_old_attachment_cannot_launch_after_an_unstarted_ticket_is_replaced(self):
        data, checkout, old = self.leased()
        answer = self.call(edits.prepare, data)
        self.assertTrue(answer["ok"])
        process = self.launcher(old, checkout, wait=False)
        _, error = process.communicate(timeout=5)
        self.assertEqual(process.returncode, 75)
        self.assertIn("no longer current", error)
        winner = self.launcher(answer["attachment"], checkout)
        self.assertIsNone(winner.poll())

    def test_two_simultaneous_launches_share_only_one_kernel_attachment(self):
        data, checkout, attachment = self.leased()
        first = self.launcher(attachment, checkout, wait=False)
        second = self.launcher(attachment, checkout, wait=False)
        until = time.monotonic() + 5
        while first.poll() is None and second.poll() is None and time.monotonic() < until:
            time.sleep(0.01)
        self.assertEqual(sum(p.poll() is None for p in (first, second)), 1)
        loser = next(p for p in (first, second) if p.poll() is not None)
        self.assertEqual(loser.returncode, 75)
        self.assertEqual(edits._load(edits._root(data["session"])[1])["attachment"]["token"], attachment["token"])

    def test_a_missing_or_replaced_lease_file_is_never_recreated(self):
        for replaced in (False, True):
            data, checkout, _ = self.leased()
            lock = edits._root(data["session"])[1] / "editor.lock"
            lock.rename(lock.with_suffix(".old"))
            if replaced:
                lock.write_text("foreign lease\n")
            self.assertFalse(self.call(edits.prepare, data)["ok"])
            self.assertFalse(self.commit(data)["ok"])
            self.assertEqual(lock.read_text() if replaced else lock.exists(), "foreign lease\n" if replaced else False)
            self.assertEqual((checkout / "a.txt").read_text(), "before\n")

    def test_unknown_process_liveness_preserves_the_existing_attachment(self):
        data, checkout, attachment = self.leased()
        root = edits._root(data["session"])[1]
        saved = edits._load(root)
        saved["attachment"]["process"] = editlease.process_identity(os.getpid())
        edits._save(root / "session.json", saved)
        with mock.patch.object(editlease, "process_identity", side_effect=ghreview.Refused("process unavailable")):
            self.assertFalse(self.call(edits.prepare, data)["ok"])
            self.assertFalse(self.commit(data)["ok"])
            self.assertFalse(self.call(edits.workspaces, {"epoch": state.EPOCH})["workspaces"][0]["resumable"])
        self.assertEqual(edits._load(root)["attachment"]["token"], attachment["token"])

    def test_a_reused_pid_is_not_the_original_editor_process(self):
        data, checkout, attachment = self.leased()
        root = edits._root(data["session"])[1]
        saved = edits._load(root)
        process = editlease.process_identity(os.getpid())
        process[-1] = str(process[-1]) + "-previous"
        saved["attachment"]["process"] = process
        edits._save(root / "session.json", saved)
        answer = self.call(edits.prepare, data)
        self.assertTrue(answer["ok"], answer)
        self.assertNotEqual(answer["attachment"]["token"], attachment["token"])

    def test_legacy_workspaces_are_not_assumed_to_have_attachment_leases(self):
        data, checkout = self.prepare()
        listing = self.call(edits.workspaces, {"epoch": state.EPOCH})
        self.assertFalse(listing["workspaces"][0]["resumable"])
        self.assertFalse(self.call(edits.prepare, {**data, "leaseProtocol": 1, "entry": {"path": "a.txt", "line": 1, "col": 1}})["ok"])
        self.assertFalse((edits._root(data["session"])[1] / "editor.lock").exists())

    def test_frozen_receipts_do_not_require_the_old_attachment_file(self):
        data, checkout, _ = self.leased()
        (checkout / "a.txt").write_text("frozen\n")
        receipt = self.commit(data)
        self.assertTrue(receipt["ok"], receipt)
        (edits._root(data["session"])[1] / "editor.lock").unlink()
        self.assertEqual(self.commit(data), receipt)

    def test_a_frozen_leased_save_recovers_after_process_death_without_its_attachment_file(self):
        data, checkout, _ = self.leased()
        (checkout / "a.txt").write_text("frozen leased files\n")
        saved = self.crash_save(data, "ref-before-index")
        (edits._root(data["session"])[1] / "editor.lock").unlink()
        answer = self.recover(data)
        self.assertTrue(answer["ok"], answer)
        self.assertEqual(answer["sha"], saved["receipt"]["sha"])
        self.assertEqual(self.git("show", "feature:a.txt"), "frozen leased files")

    def completed(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("completed\n")
        receipt = self.commit(data)
        self.assertTrue(receipt["ok"], receipt)
        return data, checkout, receipt, edits._root(data["session"])[1]

    def test_completed_index_copies_are_retired_while_receipts_and_the_checkout_survive(self):
        data, checkout, receipt, root = self.completed()
        saved = edits._load(root)
        names = set(saved["artifacts"])
        self.assertEqual(names, editartifacts.FILES)
        self.assertTrue(all((root / name).exists() for name in names))
        edits._cleanup(str(self.repo), root)
        saved = edits._load(root)
        self.assertFalse(saved["artifacts"])
        self.assertFalse(saved["retiringArtifacts"])
        self.assertTrue(all(not (root / name).exists() for name in names))
        self.assertTrue((root / "session.json").exists() and (root / "lock").exists())
        self.assertTrue(checkout.exists())
        self.assertEqual((checkout / "a.txt").read_text(), "completed\n")
        self.assertEqual(self.commit(data), receipt)
        edits._cleanup(str(self.repo), root)
        self.assertFalse(edits._load(root)["artifacts"])

    def test_pending_save_artifacts_remain_available_for_recovery(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("pending\n")
        self.crash_save(data, "planned")
        root = edits._root(data["session"])[1]
        names = set(edits._load(root)["artifacts"])
        edits._cleanup(str(self.repo), root)
        self.assertTrue(all((root / name).exists() for name in names))
        self.assertTrue(self.recover(data)["ok"])
        edits._cleanup(str(self.repo), root)
        self.assertFalse(edits._load(root)["artifacts"])

    def test_changed_or_replaced_artifacts_are_preserved(self):
        data, checkout, receipt, root = self.completed()
        (root / "warm-index").write_text("manual saved bytes\n")
        snapshot = root / "snapshot-index"
        snapshot.rename(root / "snapshot-original")
        snapshot.write_bytes((root / "snapshot-original").read_bytes())
        edits._cleanup(str(self.repo), root)
        self.assertEqual((root / "warm-index").read_text(), "manual saved bytes\n")
        self.assertTrue(snapshot.exists() and (root / "snapshot-original").exists())
        self.assertEqual(set(edits._load(root)["artifacts"]), {"warm-index", "snapshot-index"})
        self.assertEqual(self.commit(data), receipt)

    def test_symlinks_and_unrecognized_artifact_names_cannot_delete_project_files(self):
        data, checkout, _, root = self.completed()
        protected = self.root / "protected.txt"
        protected.write_text("keep\n")
        (root / "warm-index").unlink()
        (root / "warm-index").symlink_to(protected)
        saved = edits._load(root)
        saved["artifacts"].update({"checkout/a.txt": [1, 2, 3, 4, 5], "session.json": [1, 2, 3, 4, 5]})
        edits._save(root / "session.json", saved)
        edits._cleanup(str(self.repo), root)
        self.assertEqual(protected.read_text(), "keep\n")
        self.assertTrue((root / "warm-index").is_symlink())
        self.assertEqual((checkout / "a.txt").read_text(), "completed\n")
        self.assertTrue((root / "session.json").is_file())

    def test_finished_snapshot_retirement_preserves_later_uncommitted_checkout_files(self):
        data, checkout, receipt, root = self.completed()
        (checkout / "a.txt").write_text("later editor files\n")
        (checkout / "private-note").write_text("keep this too\n")
        edits._cleanup(str(self.repo), root)
        self.assertFalse(edits._load(root)["artifacts"])
        self.assertEqual((checkout / "a.txt").read_text(), "later editor files\n")
        self.assertEqual((checkout / "private-note").read_text(), "keep this too\n")
        self.assertEqual(self.commit(data), receipt)

    def test_replaced_workspace_roots_are_not_collected(self):
        _, _, _, root = self.completed()
        old = root.with_suffix(".old")
        root.rename(old)
        root.mkdir()
        (root / "session.json").write_bytes((old / "session.json").read_bytes())
        (root / "warm-index").write_text("foreign workspace\n")
        before = (root / "session.json").read_bytes()
        edits._cleanup(str(self.repo), root)
        self.assertEqual((root / "warm-index").read_text(), "foreign workspace\n")
        self.assertEqual((root / "session.json").read_bytes(), before)

    def test_a_file_replaced_during_retirement_is_restored_without_deletion(self):
        _, _, _, root = self.completed()
        original = editartifacts.os.rename
        def replace(name, target, **kw):
            if name == "warm-index":
                (root / name).rename(root / "warm-index-original")
                (root / name).write_text("arrived during retirement\n")
            return original(name, target, **kw)
        with mock.patch.object(editartifacts.os, "rename", side_effect=replace):
            edits._cleanup(str(self.repo), root)
        self.assertEqual((root / "warm-index").read_text(), "arrived during retirement\n")
        self.assertTrue((root / "warm-index-original").exists())

    def test_retirement_keeps_using_the_owned_directory_after_its_path_is_replaced(self):
        _, _, _, root = self.completed()
        original = editartifacts.os.rename
        old = root.with_suffix(".old")
        moved = False
        def replace(name, target, **kw):
            nonlocal moved
            if not moved and name in editartifacts.FILES:
                moved = True
                root.rename(old)
                root.mkdir()
                (root / "session.json").write_text("foreign directory\n")
            return original(name, target, **kw)
        with mock.patch.object(editartifacts.os, "rename", side_effect=replace):
            edits._cleanup(str(self.repo), root)
        self.assertTrue(moved)
        self.assertEqual((root / "session.json").read_text(), "foreign directory\n")
        self.assertFalse(json.loads((old / "session.json").read_text())["artifacts"])

    def crash_retirement(self, root, boundary):
        program = r'''
import os, signal, subprocess, sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from srv import ctx, editartifacts, edits
ctx.CWD = ctx.MAIN_WT = sys.argv[2]
ctx.REPOS = {"fixture": sys.argv[2]}
ctx.run = lambda args, timeout=None: subprocess.run(args, cwd=ctx.repo_cwd(), capture_output=True, text=True)
original, original_rename = os.unlink, os.rename
def unlink(name, *args, **kw):
    result = original(name, *args, **kw)
    if sys.argv[4] == "unlink" and str(name).startswith(editartifacts.PREFIX):
        os.kill(os.getpid(), signal.SIGKILL)
    return result
def rename(name, *args, **kw):
    result = original_rename(name, *args, **kw)
    if sys.argv[4] == "rename" and name in editartifacts.FILES:
        os.kill(os.getpid(), signal.SIGKILL)
    return result
os.unlink = unlink
os.rename = rename
edits._cleanup(sys.argv[2], Path(sys.argv[3]))
'''
        result = subprocess.run([sys.executable, "-c", program, str(Path(__file__).resolve().parent), str(self.repo), str(root), boundary],
                                capture_output=True, text=True, timeout=10)
        self.assertEqual(result.returncode, -9, result.stdout + result.stderr)

    def test_process_death_mid_retirement_replays_cleanup_without_losing_the_receipt(self):
        data, checkout, receipt, root = self.completed()
        self.crash_retirement(root, "unlink")
        self.assertTrue(edits._load(root)["retiringArtifacts"])
        edits._cleanup(str(self.repo), root)
        self.assertFalse(edits._load(root)["artifacts"] or edits._load(root)["retiringArtifacts"])
        self.assertEqual(self.commit(data), receipt)

    def test_process_death_after_retirement_rename_reclaims_the_known_moved_index(self):
        data, checkout, receipt, root = self.completed()
        self.crash_retirement(root, "rename")
        self.assertTrue(list(root.glob(editartifacts.PREFIX + "*")))
        edits._cleanup(str(self.repo), root)
        self.assertFalse(list(root.glob(editartifacts.PREFIX + "*")))
        self.assertFalse(edits._load(root)["artifacts"] or edits._load(root)["retiringArtifacts"])
        self.assertEqual(self.commit(data), receipt)

    def crash_save(self, data, phase):
        program = r'''
import json, os, signal, subprocess, sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from srv import ctx, edits, editprojection, state
ctx.CWD = ctx.MAIN_WT = sys.argv[2]
ctx.REPOS = {"fixture": sys.argv[2]}
ctx.run = lambda args, timeout=None: subprocess.run(args, cwd=ctx.repo_cwd(), capture_output=True, text=True)
data = json.load(sys.stdin)
data.update(epoch=state.EPOCH, operation=data["session"])
phase = sys.argv[3]
original_save, original_git = edits._save, edits._git
def die():
    os.kill(os.getpid(), signal.SIGKILL)
def save(path, value):
    current = value.get("projection", {}).get("phase")
    if phase == "index-unrecorded" and current == "index-applied":
        die()
    original_save(path, value)
    if current == phase:
        die()
def git(*args, **kw):
    if "read-tree" in args and "-u" in args and Path(kw.get("cwd", "/")).resolve() == Path(ctx.CWD).resolve():
        if phase == "partial-files":
            (Path(ctx.CWD) / "a.txt").write_text("interrupted file bytes\n")
            die()
        result = original_git(*args, **kw)
        if phase == "files-unrecorded":
            die()
        return result
    return original_git(*args, **kw)
edits._save, edits._git = save, git
if phase == "ref-before-index":
    editprojection.Projection.install = lambda self: die()
edits._cleanup_later = lambda root: None
class Request:
    def _send(self, code, body, *args):
        print(body)
edits.commit(Request(), json.dumps(data))
'''
        result = subprocess.run([sys.executable, "-c", program, str(Path(__file__).resolve().parent), str(self.repo), phase],
                                input=json.dumps(data), capture_output=True, text=True, timeout=20)
        self.assertEqual(result.returncode, -9, result.stdout + result.stderr)
        until = time.monotonic() + 5
        while (self.repo / ".git/HEAD.lock").exists() and time.monotonic() < until:
            time.sleep(0.01)
        self.assertFalse((self.repo / ".git/HEAD.lock").exists())
        return edits._load(edits._root(data["session"])[1])

    def recover(self, data):
        return self.call(edits.recover, {**data, "operation": data["session"]})

    def test_real_process_death_at_each_landing_boundary_recovers_the_same_commit(self):
        for phase in ("planned", "files-unrecorded", "files-applied", "ref-before-index", "index-unrecorded", "index-applied"):
            with self.subTest(phase=phase):
                data, checkout = self.prepare()
                (checkout / "a.txt").write_text(phase + "\n")
                saved = self.crash_save(data, phase)
                listing = self.call(edits.workspaces, {"epoch": state.EPOCH, "branch": "feature"})
                row = next(row for row in listing["workspaces"] if row["session"] == data["session"])
                self.assertTrue(row["retryable"])
                self.assertEqual(row["operation"], data["session"])
                (checkout / "a.txt").write_text("later private edit\n")
                receipt = self.recover(data)
                self.assertTrue(receipt["ok"], receipt)
                self.assertEqual(receipt["sha"], saved["receipt"]["sha"])
                self.assertEqual(self.git("show", "feature:a.txt"), phase)
                self.assertEqual((self.repo / "a.txt").read_text(), phase + "\n")
                self.assertEqual(self.git("status", "--porcelain"), "")
                self.assertEqual(self.git("rev-list", "--count", f"{self.tip}..feature"), "1")
                self.assertEqual(self.recover(data), receipt)
                self.assertFalse((self.repo / ".git/index.lock").exists())
                self.tip = receipt["sha"]

    def test_interrupted_preparation_is_discoverable_and_never_overwritten(self):
        original = edits._git
        def fail(*args, **kw):
            if "read-tree" in args and "--reset" in args:
                raise ghreview.Refused("interrupted preparation")
            return original(*args, **kw)
        data = {"session": str(uuid.uuid4()), "branch": "feature", "expectedTip": self.tip, "baseSha": self.base, "epoch": state.EPOCH}
        with mock.patch.object(edits, "_git", side_effect=fail):
            self.assertFalse(self.call(edits.prepare, data)["ok"])
        root = edits._root(data["session"])[1]
        (root / "checkout/private.txt").write_text("preserve\n")
        answer = self.call(edits.prepare, data)
        self.assertFalse(answer["ok"])
        self.assertIn("interrupted", answer["err"])
        self.assertEqual((root / "checkout/private.txt").read_text(), "preserve\n")
        listing = self.call(edits.workspaces, {"epoch": state.EPOCH})
        self.assertEqual(listing["workspaces"][0]["state"], "preparing")
        self.assertFalse(listing["workspaces"][0]["retryable"])
        self.assertFalse(self.recover(data)["ok"])

    def test_a_damaged_workspace_cannot_hide_other_recoverable_saves(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        self.crash_save(data, "planned")
        broken = edits._root(str(uuid.uuid4()))[1]
        broken.mkdir()
        (broken / "session.json").write_text("[]")
        listing = self.call(edits.workspaces, {"epoch": state.EPOCH, "branch": "feature"})
        self.assertEqual([row["session"] for row in listing["workspaces"]], [data["session"]])
        self.assertEqual((broken / "session.json").read_text(), "[]")
        self.assertTrue(self.recover(data)["ok"])

    def test_recovery_never_freezes_an_open_editor_or_another_operation(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("editing\n")
        self.assertFalse(self.recover(data)["ok"])
        self.assertNotIn("operation", edits._load(edits._root(data["session"])[1]))
        self.crash_save(data, "planned")
        self.assertFalse(self.recover({**data, "session": str(uuid.uuid4())})["ok"])
        answer = self.call(edits.recover, {**data, "operation": str(uuid.uuid4())})
        self.assertFalse(answer["ok"])
        self.assertEqual(self.git("rev-parse", "feature"), self.tip)

    def test_recovery_preserves_a_replaced_git_lock(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        self.crash_save(data, "planned")
        lock = self.repo / ".git/index.lock"
        lock.rename(lock.with_suffix(".previous"))
        lock.write_text("foreign lock\n")
        answer = self.recover(data)
        self.assertFalse(answer["ok"])
        self.assertEqual(lock.read_text(), "foreign lock\n")
        self.assertEqual(self.git("rev-parse", "feature"), self.tip)

    def test_recovery_preserves_a_lock_whose_contents_changed_on_the_same_inode(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        self.crash_save(data, "planned")
        lock = self.repo / ".git/index.lock"
        identity = lock.stat().st_ino
        lock.write_text("replaced contents\n")
        self.assertEqual(lock.stat().st_ino, identity)
        self.assertFalse(self.recover(data)["ok"])
        self.assertEqual(lock.read_text(), "replaced contents\n")

    def test_recovery_rejects_modified_index_snapshots_and_old_epochs(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        self.crash_save(data, "planned")
        root = edits._root(data["session"])[1]
        self.assertFalse(self.recover({**data, "epoch": "old-server"})["ok"])
        index = root / "attached-index-after"
        subprocess.run(["git", "read-tree", self.base], cwd=self.repo,
                       env={**os.environ, "GIT_INDEX_FILE": str(index)}, check=True)
        self.assertFalse(self.recover(data)["ok"])
        self.assertEqual(self.git("rev-parse", "feature"), self.tip)
        self.assertEqual((self.repo / "a.txt").read_text(), "before\n")

    def test_recovery_refuses_new_staging_without_resetting_it(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        self.crash_save(data, "files-applied")
        (self.repo / ".git/index.lock").unlink()
        (self.repo / "untouched.txt").write_text("new staged bytes\n")
        self.git("add", "untouched.txt")
        answer = self.recover(data)
        self.assertFalse(answer["ok"])
        self.assertEqual(self.git("show", ":untouched.txt"), "new staged bytes")
        self.assertEqual((self.repo / "a.txt").read_text(), "frozen\n")
        self.assertEqual(self.git("rev-parse", "feature"), self.tip)

    def test_recovery_refuses_a_switched_checkout_without_writing_its_files(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        self.crash_save(data, "planned")
        (self.repo / ".git/index.lock").unlink()
        self.git("checkout", "main")
        self.assertFalse(self.recover(data)["ok"])
        self.assertEqual((self.repo / "a.txt").read_text(), "base\n")
        self.assertEqual(self.git("symbolic-ref", "HEAD"), "refs/heads/main")
        self.assertEqual(self.git("rev-parse", "feature"), self.tip)

    def test_partial_file_application_is_preserved_when_it_cannot_be_proven_safe(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        (checkout / "untouched.txt").write_text("second edit\n")
        self.crash_save(data, "partial-files")
        answer = self.recover(data)
        self.assertFalse(answer["ok"])
        self.assertEqual((self.repo / "a.txt").read_text(), "interrupted file bytes\n")
        self.assertEqual((self.repo / "untouched.txt").read_text(), "keep\n")
        self.assertEqual(self.git("rev-parse", "feature"), self.tip)

    def test_a_frozen_save_recovers_without_the_original_private_checkout(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        self.crash_save(data, "planned")
        self.git("worktree", "unlock", str(checkout))
        self.git("worktree", "remove", "--force", str(checkout))
        self.assertTrue(self.recover(data)["ok"])
        self.assertEqual(self.git("show", "feature:a.txt"), "frozen")

    def test_external_git_checkout_cannot_enter_during_the_attached_update(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        original = edits._git
        attempts = []
        def competing(*args, **kw):
            if "read-tree" in args and "-u" in args and Path(kw.get("cwd", "/")).resolve() == self.repo.resolve():
                attempts.append(subprocess.run(["git", "checkout", "main"], cwd=self.repo, capture_output=True))
            return original(*args, **kw)
        with mock.patch.object(edits, "_git", side_effect=competing):
            answer = self.commit(data)
        self.assertTrue(answer["ok"], answer)
        self.assertEqual(len(attempts), 1)
        self.assertNotEqual(attempts[0].returncode, 0)
        self.assertEqual(self.git("symbolic-ref", "HEAD"), "refs/heads/feature")

    def test_a_failed_save_releases_the_ref_transaction_before_the_checkout_lock(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        original_git, original_exit = edits._git, editprojection.Projection.__exit__
        attempts = []
        def fail(*args, **kw):
            if "read-tree" in args and "-u" in args and Path(kw.get("cwd", "/")).resolve() == self.repo.resolve():
                raise ghreview.Refused("fixture interrupted the file update")
            return original_git(*args, **kw)
        def release(projection, *args):
            original_exit(projection, *args)
            attempts.append(subprocess.run(["git", "checkout", "main"], cwd=self.repo, capture_output=True))
        with mock.patch.object(edits, "_git", side_effect=fail), mock.patch.object(editprojection.Projection, "__exit__", release):
            self.assertFalse(self.commit(data)["ok"])
        self.assertEqual(len(attempts), 1)
        self.assertEqual(attempts[0].returncode, 0, attempts[0].stderr)
        self.assertEqual(self.git("symbolic-ref", "HEAD"), "refs/heads/main")
        self.assertEqual((self.repo / "a.txt").read_text(), "base\n")
        self.assertEqual(self.git("rev-parse", "feature"), self.tip)

    def test_completed_index_application_replays_without_touching_later_local_edits(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        self.crash_save(data, "index-applied")
        (self.repo / "a.txt").write_text("later local edit\n")
        self.git("add", "a.txt")
        self.assertTrue(self.recover(data)["ok"])
        self.assertEqual(self.git("show", ":a.txt"), "later local edit")
        self.assertEqual((self.repo / "a.txt").read_text(), "later local edit\n")

    def test_recovery_after_file_application_preserves_later_edits_and_earlier_staging(self):
        data, checkout = self.prepare()
        (self.repo / "untouched.txt").write_text("earlier staging\n")
        self.git("add", "untouched.txt")
        (checkout / "a.txt").write_text("frozen\n")
        self.crash_save(data, "files-applied")
        (self.repo / "a.txt").write_text("later working bytes\n")
        self.assertTrue(self.recover(data)["ok"])
        self.assertEqual(self.git("show", "feature:a.txt"), "frozen")
        self.assertEqual(self.git("show", ":untouched.txt"), "earlier staging")
        self.assertEqual((self.repo / "a.txt").read_text(), "later working bytes\n")

    def test_each_editor_owns_its_checkout_and_gutter_base(self):
        first, a = self.prepare()
        (a / "a.txt").write_text("private\n")
        second, b = self.prepare()
        self.assertNotEqual(a, b)
        self.assertEqual((a / "a.txt").read_text(), "private\n")
        self.assertEqual((b / "a.txt").read_text(), "before\n")
        self.assertEqual(subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=a, text=True).strip(), self.base)
        again = self.call(edits.prepare, first)
        self.assertEqual(again["dir"], str(a))
        self.assertEqual((a / "a.txt").read_text(), "private\n")

    def test_a_partial_preparation_is_preserved_instead_of_replaced(self):
        session = str(uuid.uuid4())
        root = edits._root(session)[1]
        checkout = root / "checkout"
        checkout.mkdir(parents=True)
        (checkout / "saved.txt").write_text("preserve\n")
        answer = self.call(edits.prepare, {"session": session, "branch": "feature", "expectedTip": self.tip,
                                          "baseSha": self.base, "epoch": state.EPOCH})
        self.assertFalse(answer["ok"])
        self.assertEqual((checkout / "saved.txt").read_text(), "preserve\n")

    def test_save_receipt_names_exact_git_objects_and_updates_attached_checkout(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("after\n")
        receipt = self.commit(data)
        self.assertTrue(receipt["ok"], receipt)
        self.assertEqual(self.git("show", "feature:a.txt"), "after")
        self.assertEqual((self.repo / "a.txt").read_text(), "after\n")
        self.assertEqual(self.git("status", "--porcelain"), "")
        self.assertEqual(receipt["expectedTip"], self.tip)
        self.assertEqual(receipt["baseSha"], self.base)
        self.assertEqual(receipt["sha"], self.git("rev-parse", "HEAD"))
        self.assertEqual(receipt["tree"], self.git("rev-parse", "HEAD^{tree}"))
        self.assertEqual(receipt["history"]["sha"], receipt["sha"])
        self.assertIn("-base\n+after", receipt["files"][0]["patch"])

    def test_lost_response_replays_the_same_frozen_commit_after_checkout_changes(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        with mock.patch.object(edits, "_retire"):
            first = self.commit(data)
        self.assertTrue(first["ok"], first)
        (checkout / "a.txt").write_text("later\n")
        second = self.commit(data)
        self.assertEqual(first, second)
        self.assertEqual(self.git("show", "feature:a.txt"), "frozen")
        self.assertEqual(self.git("rev-list", "--count", "main..feature"), "2")

    def test_success_parks_an_exclusively_claimed_checkout_and_keeps_the_replay_receipt(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("saved\n")
        receipt = self.commit(data)
        self.assertTrue(receipt["ok"], receipt)
        edits._cleanup(str(self.repo), edits._root(data["session"])[1])
        self.assertTrue(checkout.exists())
        self.tip = receipt["sha"]
        newer, next_checkout = self.prepare()
        self.assertNotEqual(checkout, next_checkout)
        self.assertFalse(checkout.exists())
        self.assertEqual((next_checkout / "a.txt").read_text(), "saved\n")
        other, other_checkout = self.prepare()
        self.assertNotEqual(next_checkout, other_checkout)
        (next_checkout / "a.txt").write_text("new owner\n")
        self.assertEqual((other_checkout / "a.txt").read_text(), "saved\n")
        self.assertEqual(self.commit(data), {**receipt, "epoch": state.EPOCH})

    def test_a_dirty_parked_checkout_is_preserved_instead_of_reset(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("saved\n")
        receipt = self.commit(data)
        edits._cleanup(str(self.repo), edits._root(data["session"])[1])
        (checkout / "a.txt").write_text("late external edit\n")
        self.tip = receipt["sha"]
        newer, next_checkout = self.prepare()
        self.assertEqual((next_checkout / "a.txt").read_text(), "saved\n")
        self.assertEqual((checkout / "a.txt").read_text(), "late external edit\n")

    def test_another_branch_claims_the_cached_checkout_and_updates_only_its_private_files(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("saved\n")
        receipt = self.commit(data)
        edits._cleanup(str(self.repo), edits._root(data["session"])[1])
        identity = checkout.stat().st_ino
        self.git("checkout", "-qb", "other", "main")
        self.git("config", "branch.other.stack-parent", "main")
        (self.repo / "a.txt").write_text("other branch\n")
        self.git("commit", "-qam", "other")
        self.tip = self.git("rev-parse", "HEAD")
        newer, next_checkout = self.prepare(branch="other")
        self.assertEqual(next_checkout.stat().st_ino, identity)
        self.assertEqual((next_checkout / "a.txt").read_text(), "other branch\n")
        self.assertEqual((self.repo / "a.txt").read_text(), "other branch\n")
        self.assertEqual(self.commit(data), receipt)

    def test_fixup_still_names_the_older_unpublished_commit(self):
        self.git("commit", "-qm", "unrelated", "--allow-empty")
        self.tip = self.git("rev-parse", "HEAD")
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("edited\n")
        receipt = self.commit(data)
        self.assertEqual(receipt["message"], "fixup! feat: change a")

    def test_a_published_commit_uses_an_edit_message(self):
        self.git("update-ref", "refs/remotes/fixture/feature", self.tip)
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("edited\n")
        receipt = self.commit(data)
        self.assertEqual(receipt["message"], "edit a.txt")

    def test_a_parent_boundary_line_uses_an_edit_message(self):
        data, checkout = self.prepare()
        (checkout / "untouched.txt").write_text("edited\n")
        receipt = self.commit(data)
        self.assertEqual(receipt["message"], "edit untouched.txt")

    def test_late_staged_content_is_preserved_during_cache_cleanup(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("saved\n")
        self.assertTrue(self.commit(data)["ok"])
        (checkout / "a.txt").write_text("staged after commit\n")
        subprocess.run(["git", "add", "a.txt"], cwd=checkout, check=True)
        edits._cleanup(str(self.repo), edits._root(data["session"])[1])
        self.assertEqual(subprocess.check_output(["git", "show", ":a.txt"], cwd=checkout, text=True), "staged after commit\n")

    def test_uncommitted_ignored_files_keep_the_checkout(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("saved\n")
        exclude = self.repo / ".git/info/exclude"
        with exclude.open("a") as out:
            out.write("\nprivate-note\n")
        (checkout / "private-note").write_text("keep me\n")
        receipt = self.commit(data)
        self.assertTrue(receipt["ok"], receipt)
        edits._cleanup(str(self.repo), edits._root(data["session"])[1])
        self.assertEqual((checkout / "private-note").read_text(), "keep me\n")

    def test_restart_after_ref_advance_recovers_the_prepared_receipt(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        common, root = edits._root(data["session"])
        session = edits._load(root)
        receipt = edits._freeze(root, session, data["session"])
        edits._advance(session)
        self.assertEqual(self.commit(data), {**receipt, "epoch": state.EPOCH})
        self.assertEqual(edits._load(root)["state"], "committed")

    def test_an_old_epoch_cannot_commit_after_restart_but_an_explicit_retry_can(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("saved\n")
        with mock.patch.object(state, "EPOCH", "restarted"):
            self.assertFalse(self.commit(data)["ok"])
            self.assertEqual(self.git("rev-parse", "feature"), self.tip)
            answer = self.commit({**data, "epoch": "restarted"})
            self.assertTrue(answer["ok"], answer)
            self.assertEqual(answer["epoch"], "restarted")

    def test_a_different_operation_cannot_recapture_a_saved_session(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("frozen\n")
        self.assertTrue(self.commit(data)["ok"])
        answer = self.call(edits.commit, {**data, "operation": str(uuid.uuid4())})
        self.assertFalse(answer["ok"])

    def test_two_clients_from_the_same_tip_cannot_overwrite_each_other(self):
        a, first = self.prepare()
        b, second = self.prepare()
        (first / "a.txt").write_text("first\n")
        (second / "a.txt").write_text("second\n")
        self.assertTrue(self.commit(a)["ok"])
        refusal = self.commit(b)
        self.assertFalse(refusal["ok"])
        self.assertEqual(self.git("show", "feature:a.txt"), "first")
        self.assertEqual((second / "a.txt").read_text(), "second\n")
        self.assertEqual(edits._load(edits._root(b["session"])[1])["state"], "prepared")

    def test_capture_preserves_racy_index_detection_for_same_size_edits(self):
        self.git("config", "core.checkStat", "minimal")
        self.git("config", "core.trustctime", "false")
        data, checkout = self.prepare()
        root = edits._root(data["session"])[1]
        session = edits._load(root)
        path = checkout / "a.txt"
        stamp = path.stat()
        older = stamp.st_mtime_ns - 10_000_000_000
        os.utime(path, ns=(stamp.st_atime_ns, older))
        subprocess.run(["git", "update-index", "--refresh"], cwd=checkout, check=True, capture_output=True)
        index = Path(session["gitdir"]) / "index"
        os.utime(index, ns=(stamp.st_atime_ns, older))
        path.write_text("edited\n")
        os.utime(path, ns=(stamp.st_atime_ns, older))
        tree, paths = edits._capture(root, session)
        self.assertIn("a.txt", paths)
        self.assertEqual(self.git("show", f"{tree}:a.txt"), "edited")

    def test_attached_worktree_edits_to_the_same_path_are_preserved(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("editor\n")
        (self.repo / "a.txt").write_text("local unsaved\n")
        answer = self.commit(data)
        self.assertFalse(answer["ok"])
        self.assertEqual(self.git("rev-parse", "feature"), self.tip)
        self.assertEqual((self.repo / "a.txt").read_text(), "local unsaved\n")
        self.assertFalse((self.repo / ".git/refs/heads/feature.lock").exists())

    def test_unrelated_worktree_edits_and_staged_files_survive(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("editor\n")
        (self.repo / "untouched.txt").write_text("local staged\n")
        self.git("add", "untouched.txt")
        answer = self.commit(data)
        self.assertTrue(answer["ok"], answer)
        self.assertEqual(self.git("diff", "--cached", "--name-only"), "untouched.txt")
        self.assertEqual((self.repo / "untouched.txt").read_text(), "local staged\n")

    def test_binary_symlink_executable_rename_and_delete_are_frozen(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").rename(checkout / "renamed.txt")
        (checkout / "untouched.txt").unlink()
        (checkout / "binary").write_bytes(b"\0\xff\x01")
        (checkout / "link").symlink_to("renamed.txt")
        (checkout / "executable").write_text("#!/bin/sh\nexit 0\n")
        (checkout / "executable").chmod(0o755)
        answer = self.commit(data)
        self.assertTrue(answer["ok"], answer)
        self.assertEqual(subprocess.check_output(["git", "show", "feature:binary"], cwd=self.repo), b"\0\xff\x01")
        tree = self.git("ls-tree", "feature")
        self.assertIn("120000 blob", tree)
        self.assertIn("100755 blob", tree)
        self.assertNotIn("\tuntouched.txt", tree)
        self.assertNotIn("\ta.txt", tree)
        self.assertIn("renamed.txt", answer["paths"])

    def test_reverting_a_file_to_the_comparison_base_removes_its_diff(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("base\n")
        answer = self.commit(data)
        self.assertTrue(answer["ok"], answer)
        self.assertEqual(answer["paths"], ["a.txt"])
        self.assertEqual(answer["files"], [])

    def test_a_second_rename_replaces_the_original_diff_source_as_well(self):
        self.git("mv", "untouched.txt", "middle.txt")
        self.git("commit", "-qm", "rename")
        self.tip = self.git("rev-parse", "HEAD")
        data, checkout = self.prepare()
        (checkout / "middle.txt").rename(checkout / "final.txt")
        answer = self.commit(data)
        self.assertTrue(answer["ok"], answer)
        self.assertEqual(set(answer["paths"]), {"untouched.txt", "middle.txt", "final.txt"})
        self.assertEqual({file["path"] for file in answer["files"]}, {"untouched.txt", "final.txt"})

    def test_another_repository_cannot_supply_the_checkout(self):
        data, checkout = self.prepare()
        replacement = checkout.with_name("old")
        checkout.rename(replacement)
        checkout.mkdir()
        self.assertFalse(self.commit(data)["ok"])
        self.assertEqual((replacement / "a.txt").read_text(), "before\n")

    def test_matching_heads_in_another_repository_do_not_transfer_a_lease(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("original session\n")
        other = self.root / "other"
        subprocess.run(["git", "clone", "-q", "--shared", "--no-checkout", str(self.repo), str(other)], check=True)
        ctx.set_repo(str(other))
        try:
            answer = self.commit(data)
            self.assertFalse(answer["ok"])
            self.assertEqual(subprocess.check_output(["git", "rev-parse", "feature"], cwd=other, text=True).strip(), self.tip)
        finally:
            ctx.clear_repo()
        self.assertEqual((checkout / "a.txt").read_text(), "original session\n")

    def test_manual_index_changes_are_preserved_and_refused(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("staged separately\n")
        subprocess.run(["git", "add", "a.txt"], cwd=checkout, check=True)
        (checkout / "a.txt").write_text("unstaged separately\n")
        answer = self.commit(data)
        self.assertFalse(answer["ok"])
        self.assertEqual(self.git("rev-parse", "feature"), self.tip)
        self.assertEqual(subprocess.check_output(["git", "show", ":a.txt"], cwd=checkout, text=True), "staged separately\n")

    def test_detached_branch_commits_with_compare_and_swap(self):
        data, checkout = self.prepare()
        self.git("checkout", "-q", "main")
        (checkout / "a.txt").write_text("detached\n")
        answer = self.commit(data)
        self.assertTrue(answer["ok"], answer)
        self.assertEqual(self.git("show", "feature:a.txt"), "detached")
        self.assertEqual(self.git("symbolic-ref", "--short", "HEAD"), "main")

    def test_ref_movement_between_validation_and_prepare_is_refused(self):
        data, checkout = self.prepare()
        (checkout / "a.txt").write_text("editor\n")
        other = self.git("commit-tree", "HEAD^{tree}", "-p", self.tip, "-m", "concurrent")
        original = edits._attached
        def move(branch):
            self.git("update-ref", "refs/heads/feature", other, self.tip)
            return original(branch)
        with mock.patch.object(edits, "_attached", side_effect=move):
            answer = self.commit(data)
        self.assertFalse(answer["ok"])
        self.assertEqual(self.git("rev-parse", "feature"), other)
        self.assertEqual((self.repo / "a.txt").read_text(), "before\n")

    def prime(self):
        data = {"branch": "feature", "expectedTip": self.tip, "epoch": state.EPOCH}
        answer = self.call(edits.prime, data)
        self.assertTrue(answer["ok"], answer)
        with edits._PRIME_LOCK:
            future = edits._PRIMING.get(str((self.repo / ".git").resolve()))
        if future:
            future.result(timeout=10)

    def test_review_warmup_creates_a_snapshot_without_a_commit_or_edit_authority(self):
        self.prime()
        self.assertEqual(self.git("rev-parse", "feature"), self.tip)
        self.assertEqual(self.git("for-each-ref", "refs/canopy/edits"), "")
        ready = json.loads((self.repo / ".git/canopy-edits/ready.json").read_text())
        cache = edits._load(edits._root(ready["session"])[1])
        self.assertEqual(cache["kind"], "cache")
        self.assertNotIn("receipt", cache)
        self.assertNotIn("operation", cache)
        answer = self.commit({"session": ready["session"], "branch": "feature", "expectedTip": self.tip, "epoch": state.EPOCH})
        self.assertFalse(answer["ok"])
        original = edits._checkout(edits._root(ready["session"])[1], cache)
        identity = original.stat().st_ino
        data, checkout = self.prepare()
        self.assertEqual(checkout.stat().st_ino, identity)
        self.assertNotEqual(data["session"], ready["session"])
        self.assertEqual((checkout / "a.txt").read_text(), "before\n")

    def test_warmup_can_resolve_the_initial_branch_before_client_hydration(self):
        answer = self.call(edits.prime, {"branch": "feature"})
        self.assertTrue(answer["ok"], answer)
        with edits._PRIME_LOCK:
            future = edits._PRIMING.get(str((self.repo / ".git").resolve()))
        if future:
            future.result(timeout=10)
        ready = json.loads((self.repo / ".git/canopy-edits/ready.json").read_text())
        self.assertEqual(ready["tip"], self.tip)
        self.assertEqual(self.git("rev-parse", "feature"), self.tip)

    def test_first_open_joins_inflight_warmup_instead_of_copying_again(self):
        started, release, finished = threading.Event(), threading.Event(), threading.Event()
        original = edits._git
        copies = []
        def held(*args, **kwargs):
            if "read-tree" in args and "--reset" in args:
                copies.append(args)
                started.set()
                if not release.wait(10):
                    raise AssertionError("warmup was never released")
            return original(*args, **kwargs)
        results = []
        def opening():
            ctx.set_repo(str(self.repo))
            try:
                session = str(uuid.uuid4())
                results.append(self.call(edits.prepare, {"session": session, "branch": "feature", "expectedTip": self.tip,
                                                         "baseSha": self.base, "epoch": state.EPOCH}))
            finally:
                ctx.clear_repo()
                finished.set()
        with mock.patch.object(edits, "_git", side_effect=held):
            self.call(edits.prime, {"branch": "feature", "expectedTip": self.tip, "epoch": state.EPOCH})
            self.assertTrue(started.wait(10))
            self.call(edits.prime, {"branch": "feature", "expectedTip": self.tip, "epoch": state.EPOCH})
            worker = threading.Thread(target=opening)
            worker.start()
            try:
                self.assertFalse(finished.wait(0.05))
            finally:
                release.set()
                worker.join(10)
            self.assertTrue(finished.is_set())
        self.assertEqual(len(copies), 1)
        self.assertTrue(results[0]["ok"], results)
        self.assertEqual((Path(results[0]["dir"]) / "a.txt").read_text(), "before\n")

    def test_failed_warmup_falls_back_to_an_ordinary_private_editor_checkout(self):
        original = edits._prepare
        def failed(req, data, cache=False):
            if cache:
                raise ghreview.Refused("fixture failure")
            return original(req, data)
        with mock.patch.object(edits, "_prepare", side_effect=failed):
            self.prime()
            data, checkout = self.prepare()
        self.assertEqual((checkout / "a.txt").read_text(), "before\n")

    def test_an_idle_snapshot_cannot_bypass_validation_through_a_direct_handoff(self):
        self.prime()
        common = (self.repo / ".git").resolve()
        ready = json.loads((common / "canopy-edits/ready.json").read_text())
        source = edits._root(ready["session"])[1]
        destination = edits._root(str(uuid.uuid4()))[1]
        destination.mkdir()
        with self.assertRaises(ghreview.Refused):
            edits._take_reserved(common, destination, source)
        self.assertTrue((source / "checkout/a.txt").exists())

    def test_dirty_unused_warmup_files_are_preserved_when_an_editor_claims(self):
        self.prime()
        common = (self.repo / ".git").resolve()
        ready = json.loads((common / "canopy-edits/ready.json").read_text())
        source = edits._root(ready["session"])[1]
        (source / "checkout/a.txt").write_text("changed after warmup\n")
        data, checkout = self.prepare()
        self.assertEqual((checkout / "a.txt").read_text(), "before\n")
        self.assertEqual((source / "checkout/a.txt").read_text(), "changed after warmup\n")

    def test_replacing_a_cached_checkout_prevents_eviction(self):
        self.prime()
        common = (self.repo / ".git").resolve()
        ready = json.loads((common / "canopy-edits/ready.json").read_text())
        source = edits._root(ready["session"])[1]
        checkout = source / "checkout"
        checkout.rename(source / "original-checkout")
        checkout.mkdir()
        (checkout / "keep.txt").write_text("replacement\n")
        edits._evict(str(self.repo), source)
        self.assertEqual((checkout / "keep.txt").read_text(), "replacement\n")


