#!/bin/zsh
# stack-forest-mermaid — render a project's forest as a Mermaid diagram. A thin renderer over
# stack_facts.py, which owns every fact (see there); GitHub renders Mermaid in a PR body.
#
#   stack-forest-mermaid <branch> [--fence]
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

branch="${1:-}"
[[ -n "$branch" ]] || { echo "usage: stack-forest-mermaid <branch> [--fence]" >&2; exit 2; }
exec python3 "${0:A:h}/stack_facts.py" mermaid "$@"
