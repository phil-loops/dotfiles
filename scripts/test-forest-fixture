#!/usr/bin/env python3
"""test-forest-fixture — build a throwaway repo with a small forest, then assert the tooling's
read-only verdicts and its ref-rewriting scripts against it.

  test-forest-fixture              run every check
  test-forest-fixture --keep       leave the fixture on disk and print its path
  test-forest-fixture -k <substr>  only checks whose name contains <substr>

Why: everything load-bearing here was verified by hand — a throwaway branch in the real repo,
a curl, an eyeball. That works and leaves nothing behind. This is the same ritual with the
repo built from scratch (so the expected answer is known, not inferred) and the assertions
written down, so the namespace migration and the zsh rewrites have something to fail against.

Two layers, no server and no network:
  · the srv modules called directly (repostate, push, sync, review) with ctx pinned at the
    fixture and the open-PR cache SEEDED — a fixture has no GitHub, and seeding the cache dict
    is test setup, not a production seam, so the real gh path stays the only one that runs live.
  · the scripts as subprocesses (stack-reword, worktree-hygiene) — the ones that move refs.

The fixture:
    A─B─C            main, origin/main = C
       └─D           base   (parent main, unpushed, 1 commit)
          └─E        child  (parent base)
       └─F─G         pub    (origin/pub = F → 1 outgoing, published)
       └─J─K         pubtwo (origin/pubtwo = B → 2 outgoing, published)
       └─H─I         two    (parent main, unpushed, 2 commits)
       └─W           wip    (subject "wip: not voiced")
"""
import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

# Every git call below targets a temp repo by explicit cwd, so an INHERITED git environment is
# always wrong and never harmless: run from a pre-commit hook, git exports GIT_DIR and
# GIT_INDEX_FILE, and the fixture's `git init` re-inits the caller's repo instead (2026-09-09 —
# it landed on ~/.dotfiles itself and only failed at `remote add`). Scrub before anything runs.
for _k in [k for k in os.environ if k.startswith("GIT_")]:
    del os.environ[_k]

FAIL = []
PASS = []


def check(name, cond, detail=""):
    (PASS if cond else FAIL).append(name)
    print(f"  {'✓' if cond else '✗'} {name}" + (f"\n      {detail}" if not cond and detail else ""))


# Identity and signing ride on the COMMAND, never written into a repo's config. The config
# form escaped once: with GIT_DIR inherited from a pre-commit hook, `git -C <tmp> config
# user.name Fixture` wrote into ~/.dotfiles itself, and 15 commits across three sessions were
# authored "Fixture <t@t.t>" before anyone noticed (2026-09-10). Scrubbing GIT_* fixed the
# cause; this makes the blast radius zero even if something else ever reintroduces it.
_ID = ["-c", "user.name=Fixture", "-c", "user.email=t@t.t", "-c", "commit.gpgsign=false"]


def git(repo, *args, check_rc=True):
    r = subprocess.run(["git", *_ID, *args], cwd=repo, capture_output=True, text=True)
    if check_rc and r.returncode != 0:
        raise SystemExit(f"fixture git failed: git {' '.join(args)}\n{r.stderr}")
    return r.stdout.strip()


def commit(repo, msg, path="f.txt", body=None):
    with open(os.path.join(repo, path), "a") as fh:
        fh.write((body or msg) + "\n")
    git(repo, "add", path)
    git(repo, "commit", "-qm", msg)
    return git(repo, "rev-parse", "HEAD")


def build():
    """A repo whose forest shape is known, with a bare 'origin' holding main + pub."""
    root = tempfile.mkdtemp(prefix="forest-fixture-")
    repo, remote = os.path.join(root, "work"), os.path.join(root, "origin.git")
    subprocess.run(["git", "init", "-q", "--bare", "--initial-branch=main", remote], check=True)
    subprocess.run(["git", "init", "-q", "--initial-branch=main", repo], check=True)
    # tripwire: if this fixture's git dir is not inside the temp root, every command below is
    # about to operate on somebody's real repo. Refuse loudly rather than write to it.
    gd = subprocess.run(["git", "-C", repo, "rev-parse", "--absolute-git-dir"],
                        capture_output=True, text=True).stdout.strip()
    # realpath both sides: macOS resolves /var → /private/var, so a raw prefix check on a
    # mkdtemp path fails on every clean run
    if not os.path.realpath(gd).startswith(os.path.realpath(root)):
        raise SystemExit(f"fixture refuses to run: git dir resolved OUTSIDE the fixture — {gd}\n"
                         "  (a stray GIT_DIR/GIT_WORK_TREE in the environment; the scrub at the top failed)")
    git(repo, "remote", "add", "origin", remote)

    a = commit(repo, "A")
    b = commit(repo, "B")
    c = commit(repo, "C")
    git(repo, "push", "-q", "origin", "main")

    git(repo, "checkout", "-q", "-b", "base", b)
    d = commit(repo, "add the base thing")
    git(repo, "checkout", "-q", "-b", "child", d)
    e = commit(repo, "use the base thing in the child")

    git(repo, "checkout", "-q", "-b", "pub", b)
    f = commit(repo, "publish this one")
    git(repo, "push", "-q", "origin", "pub")
    g = commit(repo, "then follow it up")

    git(repo, "checkout", "-q", "-b", "two", b)
    h = commit(repo, "first of two")
    i = commit(repo, "second of two")

    # a published branch with TWO outgoing commits: the remote-tracking ref is planted at B
    # directly rather than pushed, so `two` above stays genuinely unpushed for the reword checks
    git(repo, "checkout", "-q", "-b", "pubtwo", b)
    commit(repo, "first follow-up")
    commit(repo, "second follow-up")
    git(repo, "update-ref", "refs/remotes/origin/pubtwo", b)

    git(repo, "checkout", "-q", "-b", "wip", b)
    w = commit(repo, "wip: not voiced")

    git(repo, "checkout", "-q", "main")
    for br, parent in (("base", "main"), ("child", "base"), ("pub", "main"), ("two", "main"),
                       ("pubtwo", "main"), ("wip", "main")):
        git(repo, "config", f"stack-branch.{br}.parent", parent)
        git(repo, "config", f"stack-branch.{br}.project", "fixture")
        git(repo, "config", f"branch.{br}.description", f"{br}: one line of purpose")
        git(repo, "config", "--add", "stack-project.fixture.branch", br)
    # a branch carrying ONLY the legacy namespace — the migration's canary
    git(repo, "checkout", "-q", "-b", "legacy", b)
    commit(repo, "legacy-namespace branch")
    git(repo, "checkout", "-q", "main")
    git(repo, "config", "branch.legacy.stack-parent", "base")
    return root, repo, {"a": a, "b": b, "c": c, "d": d, "e": e, "f": f, "g": g, "h": h, "i": i, "w": w}


def wire_srv(repo):
    """Point the srv modules at the fixture: our own `run` (ctx's is the server's), and a
    SEEDED open-PR cache so nothing reaches for gh."""
    from srv import ctx

    def run(args, timeout=None):
        return subprocess.run(args, cwd=ctx.repo_cwd(), capture_output=True, text=True, timeout=timeout)

    ctx.CWD = repo
    ctx.init(run=run, ROOT=repo, SCRIPTS=HERE, CWD=repo, MAIN_WT=repo, repos={})
    ctx.set_repo(repo)
    from srv import sync
    sync._pr_cache[repo] = {"at": time.monotonic(), "heads": set(), "outage": False}
    return sync


def set_prs(sync, repo, heads):
    sync._pr_cache[repo] = {"at": time.monotonic(), "heads": set(heads), "outage": False}
    from srv import repostate
    repostate.invalidate()


def ward(v, k):
    return next((w for w in v["wards"] if w["k"] == k), None)


def run_checks(repo, shas, only):
    def want(name):
        return not only or only in name

    sync = wire_srv(repo)
    from srv import repostate, push, review

    if want("repostate"):
        print("repostate")
        snap = repostate.snapshot()
        check("repostate: parent from stack-branch", snap.parent("child") == "base", snap.parent("child"))
        check("repostate: parent falls back to main", snap.parent("base") == "main", snap.parent("base"))
        check("repostate: unknown branch → main", snap.parent("nope") == "main", snap.parent("nope"))
        check("repostate: pre-migration stack-branch.<b>.parent still resolves",
              snap.parent("legacy") == "base", snap.parent("legacy"))
        # mid-sweep a key exists in BOTH namespaces; the target must win or a reader answers
        # with the value the sweep superseded
        git(repo, "config", "branch.child.stack-parent", "main")
        repostate.invalidate()
        check("repostate: target namespace wins over the old spelling",
              repostate.snapshot().parent("child") == "main", repostate.snapshot().parent("child"))
        git(repo, "config", "--unset", "branch.child.stack-parent")
        git(repo, "config", "branch.base.stack-gates-green-tree", "deadbeef")
        repostate.invalidate()
        check("repostate: gates verdict reads the target namespace first",
              push._green_tree("base") == "deadbeef", push._green_tree("base"))
        git(repo, "config", "--unset", "branch.base.stack-gates-green-tree")
        repostate.invalidate()
        check("repostate: local tip", snap.local("base") == shas["d"], snap.local("base"))
        check("repostate: origin copy present only where pushed",
              bool(snap.remote("pub")) and not snap.remote("base"))
        check("repostate: description", snap.description("base").startswith("base:"), snap.description("base"))
        check("repostate: multivar config keeps every value",
              len(snap.get_all("stack-project.fixture.branch")) == 6,
              str(snap.get_all("stack-project.fixture.branch")))
        fp = snap.fingerprint
        git(repo, "branch", "fp-probe", shas["b"])
        repostate.invalidate()
        check("repostate: fingerprint moves on a ref change", repostate.snapshot().fingerprint != fp)
        fp2 = repostate.snapshot().fingerprint
        git(repo, "config", "stack-branch.base.role", "proof")
        repostate.invalidate()
        check("repostate: fingerprint moves on a config write", repostate.snapshot().fingerprint != fp2)
        git(repo, "branch", "-D", "fp-probe")
        git(repo, "config", "--unset", "stack-branch.base.role")
        repostate.invalidate()

    if want("namespace"):
        print("namespace dual-read")
        snap = repostate.snapshot()
        roots = snap.branch_keys("parent")
        check("namespace: the enumerator sees every branch in the old spelling",
              {"base", "pub", "two", "wip", "child"} <= set(roots), str(sorted(roots)))
        git(repo, "config", "branch.moved.stack-parent", "main")
        git(repo, "branch", "moved", shas["b"])
        repostate.invalidate()
        roots = repostate.snapshot().branch_keys("parent")
        check("namespace: the enumerator sees a swept branch too", roots.get("moved") == "main", str(roots.get("moved")))
        # a branch name with a dot must survive affix-stripping, never a split on "."
        git(repo, "branch", "wt-1.2", shas["b"])
        git(repo, "config", "stack-branch.wt-1.2.parent", "base")
        repostate.invalidate()
        check("namespace: a dotted branch name survives the enumerator",
              repostate.snapshot().branch_keys("parent").get("wt-1.2") == "base",
              str(repostate.snapshot().branch_keys("parent").get("wt-1.2")))
        git(repo, "config", "--add", "stack-branch.base.requires", "dep-one")
        git(repo, "config", "--add", "stack-branch.base.requires", "dep-two")
        repostate.invalidate()
        check("namespace: multivar reads every value from the old spelling",
              repostate.snapshot().branch_key_all("base", "requires") == ["dep-one", "dep-two"],
              str(repostate.snapshot().branch_key_all("base", "requires")))
        git(repo, "config", "--add", "branch.base.stack-requires", "dep-swept")
        repostate.invalidate()
        check("namespace: multivar takes the target namespace WHOLE, never concatenated",
              repostate.snapshot().branch_key_all("base", "requires") == ["dep-swept"],
              str(repostate.snapshot().branch_key_all("base", "requires")))
        # the whole reason for the migration: git GCs branch.<b>.* on delete, and leaves
        # stack-branch.<b>.* behind as rot for stack-doctor to sweep
        git(repo, "branch", "-D", "moved", "wt-1.2")
        check("namespace: deleting a branch GCs its target-namespace keys",
              git(repo, "config", "--get", "branch.moved.stack-parent", check_rc=False) == "")
        check("namespace: the old spelling outlives the branch",
              git(repo, "config", "--get", "stack-branch.wt-1.2.parent", check_rc=False) == "base")
        git(repo, "config", "--remove-section", "stack-branch.wt-1.2")
        git(repo, "config", "--remove-section", "branch.base")
        git(repo, "config", "--unset-all", "stack-branch.base.requires")
        git(repo, "config", "branch.base.description", "base: one line of purpose")
        repostate.invalidate()

    if want("dualwrite"):
        print("dual-write (namespace migration)")
        from srv import stackcfg, ctx
        cfg = lambda k: git(repo, "config", "--get", k, check_rc=False)
        stackcfg.set_key("base", "role", "proof")
        check("dualwrite: set writes the target spelling",
              cfg("branch.base.stack-role") == "proof", cfg("branch.base.stack-role"))
        check("dualwrite: set writes the legacy spelling too",
              cfg("stack-branch.base.role") == "proof", cfg("stack-branch.base.role"))
        stackcfg.unset_key("base", "role")
        check("dualwrite: unset clears both",
              cfg("branch.base.stack-role") == "" and cfg("stack-branch.base.role") == "")
        stackcfg.add_key("base", "requires", "dep-a")
        stackcfg.add_key("base", "requires", "dep-b")
        both = (git(repo, "config", "--get-all", "branch.base.stack-requires", check_rc=False).split(),
                git(repo, "config", "--get-all", "stack-branch.base.requires", check_rc=False).split())
        check("dualwrite: add keeps every value in both", both == (["dep-a", "dep-b"], ["dep-a", "dep-b"]), str(both))
        stackcfg.unset_key("base", "requires", "dep-a")
        both = (git(repo, "config", "--get-all", "branch.base.stack-requires", check_rc=False).split(),
                git(repo, "config", "--get-all", "stack-branch.base.requires", check_rc=False).split())
        check("dualwrite: a valued unset removes that value from both", both == (["dep-b"], ["dep-b"]), str(both))

        # the trap: the target side must NEVER be `--remove-section branch.<b>`
        desc_before = cfg("branch.base.description")
        git(repo, "config", "branch.base.remote", "origin")
        stackcfg.remove_stack_section("base")
        check("dualwrite: removing the stack section clears both namespaces' stack keys",
              cfg("branch.base.stack-requires") == "" and cfg("stack-branch.base.requires") == "")
        check("dualwrite: and leaves git's OWN branch keys intact",
              cfg("branch.base.description") == desc_before and cfg("branch.base.remote") == "origin",
              f'{cfg("branch.base.description")!r} / {cfg("branch.base.remote")!r}')

        # the shadow backstop: disagreeing namespaces read the target and say so
        git(repo, "config", "branch.base.stack-parent", "main")
        git(repo, "config", "stack-branch.base.parent", "stale-parent")
        repostate.invalidate()
        logged = []
        real_log = ctx.log
        ctx.log = lambda line: logged.append(line)
        try:
            answer = repostate.snapshot().parent("base")
        finally:
            ctx.log = real_log
        check("dualwrite: a shadowed legacy key still reads the target", answer == "main", answer)
        check("dualwrite: and the shadowing is logged, naming the branch and key",
              any("base" in l and "parent" in l and "stale-parent" in l for l in logged), str(logged))
        git(repo, "config", "--unset", "stack-branch.base.parent")
        git(repo, "config", "--unset", "branch.base.stack-parent")
        git(repo, "config", "branch.base.description", "base: one line of purpose")
        repostate.invalidate()

        # the ratchet: a file already converted must never grow a legacy-only write again
        import re as _re
        import shlex as _shlex
        # PENDING only ever shrinks. stack-config-move is the sweep itself — it moves legacy to
        # target and deletes legacy, so dual-writing would be nonsense; it stays exempt.
        PENDING = {"stack-restack", "stack-rm"}
        EXEMPT = {"stack-config-move"}

        def _kind(ln):
            """read | set | add | unset — by counting positionals after `config`, because a read
            is `git config <key>` and a write is `git config <key> <value>`. Pattern-matching
            this got it wrong twice (dual-read second arms and echo'd advice both looked like
            writes), so the classifier tokenizes."""
            m = _re.search(r"git\s+(?:-C\s+\S+\s+)?config\b(.*)$", ln)
            if not m:
                return None
            rest = _re.split(r"\s(?:2>|>|\|\||\||;|&&)|\s#", m.group(1))[0]
            if "--unset" in rest or "--remove-section" in rest:
                return "unset"
            if "--add" in rest:
                return "add"
            try:
                toks = _shlex.split(rest, posix=False)
            except ValueError:
                toks = rest.split()
            return "set" if len([t for t in toks if not t.startswith("--")]) >= 2 else "read"

        def _legacy_writes(path):
            out = []
            for i, ln in enumerate(path.read_text(errors="replace").splitlines(), 1):
                if "stack-branch." not in ln or "config" not in ln:
                    continue
                if _re.search(r"--get\b|get-regexp", ln):
                    continue
                k = _kind(ln)
                if k and k != "read":
                    out.append(f"{path.name}:{i}")
            return out

        zsh_offenders = []
        for f in sorted(pathlib.Path(HERE).glob("stack-*")):
            if (not f.is_file() or f.suffix in (".md", ".zsh") or f.name in PENDING | EXEMPT
                    or f.name.startswith("test-")):
                continue
            if f.read_text(errors="replace").startswith("#!/usr/bin/env python3"):
                continue
            zsh_offenders += _legacy_writes(f)
        check("dualwrite: no legacy-only write left in the converted zsh scripts",
              not zsh_offenders, str(zsh_offenders[:5]))
        check("dualwrite: only the two contested files are still pending",
              PENDING == {"stack-restack", "stack-rm"}, str(sorted(PENDING)))
        # read vs write, textually: a read closes the key and the arg list — f"stack-branch.…"])
        # — while a write follows the key with a comma and a value. --unset / --add /
        # --remove-section are writes whatever follows.
        KEY_THEN_VALUE = _re.compile(r'stack-branch\.[^"\']*["\']\s*,')
        MUTATOR = _re.compile(r'--unset|--add|--remove-section')
        offenders = []
        for f in sorted(pathlib.Path(HERE).glob("srv/*.py")):
            if f.name == "stackcfg.py":
                continue
            for i, ln in enumerate(f.read_text().splitlines(), 1):
                if "stack-branch." not in ln or "config" not in ln:
                    continue
                if _re.search(r'--get\b|get-regexp', ln):
                    continue
                if MUTATOR.search(ln) or KEY_THEN_VALUE.search(ln):
                    offenders.append(f"{f.name}:{i}")
        check("dualwrite: no legacy-only write left in srv/ (the ratchet)",
              not offenders, str(offenders[:4]))


    if want("verdict"):
        print("push verdict")
        set_prs(sync, repo, [])
        v = push._origin_verdict("base")
        check("verdict: one unpushed commit counts as outgoing", v["outgoing"] == 1, str(v["outgoing"]))
        check("verdict: unpushed branch has no origin copy", v["originExists"] is False)
        check("verdict: gates ward red with no recorded verdict", not ward(v, "gates")["ok"])
        check("verdict: not pushable while a hard ward is red", v["ok"] is False, str(v["reasons"]))
        git(repo, "config", "stack-branch.base.gates-green-tree", git(repo, "rev-parse", "base^{tree}"))
        repostate.invalidate()
        v = push._origin_verdict("base")
        check("verdict: recorded green tree opens the door", v["ok"] is True, str(v["reasons"]))
        check("verdict: manifest carries per-commit churn",
              v["commits"] and v["commits"][0]["files"] == 1 and v["commits"][0]["add"] >= 1,
              json.dumps(v["commits"][:1]))

        v = push._origin_verdict("two")
        check("verdict: two commits on an UNPUBLISHED branch are refused",
              not ward(v, "one")["ok"] and "2 commits" in ward(v, "one")["why"], ward(v, "one")["why"])
        set_prs(sync, repo, ["pubtwo"])
        v = push._origin_verdict("pubtwo")
        check("verdict: two follow-ups on a PUBLISHED branch are allowed",
              ward(v, "one")["ok"] and "follow-up" in ward(v, "one")["label"], json.dumps(ward(v, "one")))
        check("verdict: follow-up flag set", v["followup"] is True)

        set_prs(sync, repo, [])
        v = push._origin_verdict("wip")
        check("verdict: a wip subject fails the voiced ward", not ward(v, "voiced")["ok"])
        v = push._origin_verdict("main")
        check("verdict: trunk is refused outright",
              any("trunk" in r for r in v["reasons"]), str(v["reasons"]))
        check("verdict: missing branch → None", push._origin_verdict("no-such-branch") is None)

        v = push._origin_verdict("pub")
        check("verdict: published branch with 1 outgoing", v["outgoing"] == 1 and v["published"] is False)
        set_prs(sync, repo, ["pub"])
        v = push._origin_verdict("pub")
        check("verdict: published comes from the PR head set", v["published"] is True)
        check("verdict: fast-forward holds when origin is an ancestor", v["ff"] is True)

    if want("chain"):
        print("chain + pr base")
        set_prs(sync, repo, ["pub"])
        check("chain: stacked child targets its parent's open PR",
              push._pr_base("legacy") == "main", push._pr_base("legacy"))
        git(repo, "config", "stack-branch.stacked-on-pub.parent", "pub")
        git(repo, "branch", "stacked-on-pub", "pub")
        from srv import repostate as rs
        rs.invalidate()
        check("chain: child of a published parent bases its PR on that parent",
              push._pr_base("stacked-on-pub") == "pub", push._pr_base("stacked-on-pub"))
        check("chain: intact chain reports no break", push._chain_break("stacked-on-pub") == "")
        git(repo, "branch", "-f", "stacked-on-pub", shas["b"])   # drop the parent's pushed commit
        rs.invalidate()
        check("chain: a child missing its parent's ORIGIN copy is flagged",
              push._chain_break("stacked-on-pub") == "pub", push._chain_break("stacked-on-pub"))
        git(repo, "branch", "-D", "stacked-on-pub")
        git(repo, "config", "--remove-section", "stack-branch.stacked-on-pub")
        rs.invalidate()

    if want("sync"):
        print("sync state")
        set_prs(sync, repo, ["pub"])
        st = sync.state("base")
        check("sync: behind counts main's commits the branch lacks", st["behind"] == 1, str(st["behind"]))
        check("sync: an unpublished root off main is syncable", st["syncable"] is True, st["why"])
        check("sync: never pushed reads as local", st["shared"] == "local", st["shared"])
        st = sync.state("pub")
        check("sync: a published branch is not syncable", st["syncable"] is False, st["why"])
        check("sync: unpushed commits read as ahead", st["shared"] == "ahead" and st["aheadOfOrigin"] == 1,
              f'{st["shared"]}/{st["aheadOfOrigin"]}')
        st = sync.state("child")
        check("sync: a stacked branch with a project routes to restack", st["restack"] is True, st["why"])

    if want("commits"):
        print("commits + diff")

        class Req:
            def __init__(self):
                self.body = None

            def _send(self, code, body, ctype=None):
                self.code, self.body = code, body

        class U:
            def __init__(self, q):
                self.query = q

        r = Req()
        review.commits(r, U("branch=child"))
        rows = json.loads(r.body)
        own = [c for c in rows if c["own"]]
        check("commits: own set is parent..branch", len(own) == 1 and own[0]["subject"].startswith("use the base"),
              json.dumps([c["subject"] for c in own]))
        check("commits: ancestors are present but not own", any(not c["own"] for c in rows))
        check("commits: body rides along for the reword prefill", "body" in rows[0])
        r = Req()
        review.commits(r, U("branch=pub"))
        rows = json.loads(r.body)
        pushed = [c["pushed"] for c in rows if c["own"]]
        check("commits: the origin waterline marks what is already pushed",
              pushed == [False, True], str(pushed))
        r = Req()
        review.commit_diff(r, U(f"sha={shas['d']}"))
        check("commit-diff: one commit's files", len(json.loads(r.body)["files"]) == 1, r.body[:120])

    if want("shellout"):
        print("script boundary")
        from srv import shellout
        import stat as _stat
        d = os.path.join(os.path.dirname(repo), "fakescripts")
        os.makedirs(d, exist_ok=True)

        def fake(name, body, rc=0):
            path = os.path.join(d, name)
            with open(path, "w") as fh:
                fh.write(f"#!/bin/sh\n{body}\nexit {rc}\n")
            os.chmod(path, os.stat(path).st_mode | _stat.S_IEXEC)
            return path

        v, e = shellout.json_out(fake("ok", 'echo \'{"ok": true, "gates": []}\''), require=("ok",))
        check("shellout: a clean verdict parses", e is None and v["ok"] is True, str(e))
        v, e = shellout.json_out(fake("noisy", 'echo "warning: something"; echo \'{"ok": true}\''), require=("ok",))
        check("shellout: a verdict behind a warning line still parses", e is None and v["ok"] is True, str(e))
        v, e = shellout.json_out(fake("garbage", 'echo "zsh: command not found: nope"'), require=("ok",))
        check("shellout: garbage is an error, never passed through", v is None and e is not None)
        check("shellout: the error names the script and quotes it",
              e and "garbage" in e["err"] and "not found" in e["detail"]["stdout"], str(e))
        v, e = shellout.json_out(fake("renamed", 'echo \'{"okay": true}\''), require=("ok",))
        check("shellout: a renamed key is a contract break, not a default",
              v is None and e and "missing ok" in e["err"], str(e))
        v, e = shellout.json_out(fake("crash", 'echo "fatal: bad revision" >&2', rc=128), require=("ok",))
        check("shellout: a nonzero exit reports the script's own last words",
              v is None and e and "bad revision" in e["err"], str(e))
        check("shellout: the exit code rides along", e and e["detail"]["exit"] == 128, str(e))
        v, e = shellout.json_out(fake("list", 'echo \'[1,2,3]\''), want=list)
        check("shellout: a list verdict is allowed when asked for", e is None and v == [1, 2, 3], str(e))
        v, e = shellout.json_out(fake("wrongtype", 'echo \'[1,2]\''), require=("ok",))
        check("shellout: a list where a dict was wanted is an error",
              v is None and e and "expected dict" in e["err"], str(e))
        # the REAL contract, not a stand-in: stack-gates is the script the push door believes
        v, e = shellout.json_out(os.path.join(HERE, "stack-gates"), ["--branch", "main"], require=("ok",))
        check("shellout: the real stack-gates verdict satisfies the contract",
              e is None and isinstance(v.get("gates"), list), str(e))

    if want("reword"):
        print("stack-reword")
        before_tree = git(repo, "rev-parse", "child^{tree}")
        base_before = git(repo, "rev-parse", "base")
        r = subprocess.run([os.path.join(HERE, "stack-reword"), "--branch", "child", shas["e"],
                            "-m", "reworded child subject", "-m", "and a body"],
                           cwd=repo, capture_output=True, text=True)
        check("reword: exits clean on an unpushed commit", r.returncode == 0, r.stderr.strip()[:200])
        check("reword: the tree is untouched", git(repo, "rev-parse", "child^{tree}") == before_tree)
        check("reword: the new subject is in place",
              git(repo, "log", "-1", "--format=%s", "child") == "reworded child subject",
              git(repo, "log", "-1", "--format=%s", "child"))
        check("reword: the body landed", "and a body" in git(repo, "log", "-1", "--format=%b", "child"))
        check("reword: the parent branch did not move", git(repo, "rev-parse", "base") == base_before)

        # rewording a commit BELOW the tip carries the commits above it
        tip_subject = git(repo, "log", "-1", "--format=%s", "two")
        r = subprocess.run([os.path.join(HERE, "stack-reword"), "--branch", "two", shas["h"],
                            "-m", "reworded the lower commit"], cwd=repo, capture_output=True, text=True)
        check("reword: a non-tip commit rewords", r.returncode == 0, r.stderr.strip()[:200])
        check("reword: the commits above it are carried",
              git(repo, "log", "-1", "--format=%s", "two") == tip_subject,
              git(repo, "log", "-1", "--format=%s", "two"))
        check("reword: the lower commit's new subject is in history",
              "reworded the lower commit" in git(repo, "log", "--format=%s", "two"))

        r = subprocess.run([os.path.join(HERE, "stack-reword"), "--branch", "pub", shas["f"],
                            "-m", "should be refused"], cwd=repo, capture_output=True, text=True)
        check("reword: refuses a commit origin already holds", r.returncode != 0, r.stdout.strip()[:160])
        check("reword: says why it refused", "pushed" in r.stderr.lower(), r.stderr.strip()[:160])

    if want("hygiene"):
        print("worktree-hygiene")
        wt = os.path.join(os.path.dirname(repo), "wt-idle")
        git(repo, "worktree", "add", "-q", "--detach", wt, "main")
        os.makedirs(os.path.join(repo, "node_modules"), exist_ok=True)      # the main checkout's real one
        os.makedirs(os.path.join(wt, "node_modules", "pkg"), exist_ok=True)  # a stray clone
        env = {**os.environ, "HOME": os.environ["HOME"]}
        # the discriminator that stopped hygiene from fighting seed-gen: three shapes, and only
        # a REAL clone is worth reclaiming
        # one dict for globals AND locals: split them and the script's own `import os` lands in
        # locals while its functions look up globals
        ns = {"__name__": "wh"}
        exec(compile(pathlib.Path(os.path.join(HERE, "worktree-hygiene")).read_text(),
                     "worktree-hygiene", "exec"), ns)
        state = ns["nm_state"]
        donor = os.path.join(os.path.dirname(repo), "donor-nm")
        os.makedirs(os.path.join(donor, "pkg-a"), exist_ok=True)
        os.makedirs(os.path.join(donor, "pkg-b"), exist_ok=True)
        shapes = os.path.join(os.path.dirname(repo), "shapes")
        os.makedirs(shapes, exist_ok=True)
        whole = os.path.join(shapes, "whole")
        os.path.islink(whole) or os.symlink(donor, whole)
        exploded = os.path.join(shapes, "exploded")
        os.makedirs(exploded, exist_ok=True)
        for e in ("pkg-a", "pkg-b"):
            tgt = os.path.join(exploded, e)
            os.path.islink(tgt) or os.symlink(os.path.join(donor, e), tgt)
        os.makedirs(os.path.join(exploded, ".prisma"), exist_ok=True)   # seed-gen copies this one for real
        real = os.path.join(shapes, "real")
        os.makedirs(os.path.join(real, "pkg-a"), exist_ok=True)
        os.makedirs(os.path.join(real, "pkg-b"), exist_ok=True)
        check("hygiene: one symlink to the donor is the intended shape", state(whole) == "link", state(whole))
        check("hygiene: seed-gen's per-entry-symlink view is left alone",
              state(exploded) == "exploded", state(exploded))
        check("hygiene: real packages on disk are the reclaimable shape", state(real) == "real", state(real))
        check("hygiene: no node_modules reads as absent",
              state(os.path.join(shapes, "nope")) == "absent", state(os.path.join(shapes, "nope")))

        r = subprocess.run([sys.executable, os.path.join(HERE, "worktree-hygiene")],
                           cwd=repo, capture_output=True, text=True, env=env)
        # the script reads ~/coding/loops, so a fixture run is a smoke test of its refusal path
        check("hygiene: runs without touching the fixture", r.returncode in (0, 1))
        check("hygiene: dry run never writes", os.path.isdir(os.path.join(wt, "node_modules")))
        git(repo, "worktree", "remove", "--force", wt)


def main():
    only = ""
    if "-k" in sys.argv:
        only = sys.argv[sys.argv.index("-k") + 1]
    root, repo, shas = build()
    keep = "--keep" in sys.argv
    print(f"fixture: {repo}")
    try:
        run_checks(repo, shas, only)
    finally:
        if keep:
            print(f"\nkept: {root}")
        else:
            shutil.rmtree(root, ignore_errors=True)
    print(f"\n{len(PASS)} passed, {len(FAIL)} failed")
    if FAIL:
        for f in FAIL:
            print(f"  FAILED: {f}")
        sys.exit(1)


if __name__ == "__main__":
    main()
