#!/usr/bin/env python3
# stack-usage-event <kind> — append one git-workflow usage event to the same local log
# the viewer writes (.git/stack-usage.jsonl in the git-common-dir), so commit/squash/push
# behaviour sits in one stream alongside the in-app nav/cmd/action events.
#
# Called from git hooks (post-commit, pre-push). It does its OWN git introspection per
# kind, so the hooks pass no message text — no shell-escaping of commit subjects. ALWAYS
# exits 0 and swallows every error: a telemetry hiccup must never block a commit or push.
# Kill switch: STACK_USAGE=0.
#
#   stack-usage-event commit [<sha> [<branch>]]   # one event per commit (post-commit hook)
#   stack-usage-event push <remote> [<url>]        # one event per pushed ref, refs on stdin (pre-push hook)
#   stack-usage-event who <sha>  # which session made <sha> — read-only, for handoff notes
#
# The post-commit hook runs this backgrounded, so by the time it reads HEAD a rebase may have
# moved on — which is how one tip got logged once per replayed commit. The hook therefore
# captures the sha, the branch (a rebase's head-name while HEAD is detached) and STACK_REPLAY
# (rebase / cherry-pick, read from the git dir) synchronously and hands them over.
#
# Replays are recorded, not dropped: `replay: "rebase" | "cherry-pick" | "patch-id"` (the last:
# a commit whose patch-id this log already holds — a restack, a carried cherry-pick, a
# message-only amend). Readers wanting authored work filter on its absence.
#
# Who: `actor` is "claude" (a session ancestor), "cli" (no claude ancestor — Phil at a terminal
# or GH Desktop; `client` says which), or, under the viewer server (STACK_VIA=viewer), the
# request's actor — "browser" for Phil's click, "claude" for a session's curl, "server" for the
# server's own background work (focus auto-sync). A server-run git op never walks ancestry: the
# server inherits whichever session launched it, which once stamped Phil's clicks as Claude's.
import sys, os, json, time, glob, subprocess


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True).stdout.strip()


def session():
    # Every commit in a shared repo is authored "Phil Brockman", so which SESSION made one has
    # only ever been inferred — and inference got two commits misattributed in a single day
    # (2026-07-22), each time to a session that hadn't read the code. Stamp it instead, via the
    # same ancestor walk `own` uses for lane claims. No claude ancestor = Phil at a terminal,
    # recorded as null: that is an answer, not a gap.
    # Two ways in, because the ancestor walk alone returns nothing here: the post-commit hook
    # launches this as `( … & )`, so the parent is gone before we run and the process is already
    # reparented to launchd. The environment survives that, and presence records carry tmux_pane
    # — so the pane is the identity that outlives the detach. Prefer the pid when we have one
    # (a pane can be re-hosted, e.g. cw-claim joining a warm-pool pane into a new window).
    out = subprocess.run([os.path.join(os.path.dirname(os.path.abspath(__file__)), "claude-session-pid")],
                         capture_output=True, text=True, timeout=5).stdout
    pid = out.split("\t")[0].strip() if out else ""
    pane = os.environ.get("TMUX_PANE", "")
    by_pane = None
    for f in glob.glob(os.path.expanduser("~/.claude/session-presence/*.json")):
        try:
            with open(f) as fh:
                d = json.load(fh)
        except Exception:
            continue
        sid = (d.get("session_id") or "")[:8] or None
        if pid and str(d.get("pid")) == pid:
            return sid
        if pane and d.get("tmux_pane") == pane:
            by_pane = sid
    return by_pane


def attribution():
    if os.environ.get("STACK_VIA") == "viewer":
        return {"actor": os.environ.get("STACK_ACTOR") or "server", "via": "viewer",
                "session": os.environ.get("STACK_SESSION") or None}
    sid = session()
    ev = {"actor": "claude" if sid else "cli", "session": sid}
    if os.environ.get("DESKTOP_TRAMPOLINE_TOKEN") or "GitHub Desktop" in os.environ.get("GIT_ASKPASS", ""):
        ev["client"] = "gh-desktop"
    elif os.environ.get("HELIX_RUNTIME") or os.environ.get("STACK_CLIENT") == "helix":
        ev["client"] = "helix"
    return ev


def patch_id(sha):
    out = subprocess.run(["git", "show", "--format=", sha], capture_output=True)
    if not out.stdout:
        return None
    pid = subprocess.run(["git", "patch-id", "--stable"], input=out.stdout, capture_output=True).stdout.split()
    return pid[0].decode()[:12] if pid else None


def seen_patch(path, pid):
    try:
        with open(path) as f:
            for line in f:
                if pid in line:
                    try:
                        ev = json.loads(line)
                    except Exception:
                        continue
                    if ev.get("type") == "commit" and ev.get("pid") == pid:
                        return ev.get("sha")
    except FileNotFoundError:
        pass
    return None


def commit_event(path, sha_arg, branch_arg):
    sha = git("rev-parse", "--verify", "-q", f"{sha_arg or 'HEAD'}^{{commit}}")
    branch = branch_arg or git("symbolic-ref", "-q", "--short", "HEAD")
    if branch.startswith("refs/heads/"):
        branch = branch[len("refs/heads/"):]
    if not sha or not branch:
        return None  # detached outside a rebase (a scratch worktree) — not a workflow commit
    ev = {"type": "commit", "branch": branch, "sha": sha[:10]}
    subject = git("log", "-1", "--format=%s", sha)
    body = git("log", "-1", "--format=%b", sha)
    ev["subjectLen"] = len(subject)
    ev["bodyLines"] = len([ln for ln in body.splitlines() if ln.strip()])
    pid = patch_id(sha)
    if pid:
        ev["pid"] = pid
    replay = os.environ.get("STACK_REPLAY") or ""
    if not replay and pid:
        first = seen_patch(path, pid)
        if first and first != ev["sha"]:
            replay, ev["of"] = "patch-id", first
        elif first == ev["sha"]:
            return None  # the very same commit twice (two hooks, one commit) — nothing new happened
    if replay:
        ev["replay"] = replay
    return ev


def push_events(remote, refs):
    main_branch = git("config", "stack.main-branch") or "main"
    out = []
    for line in refs.splitlines():
        parts = line.split()
        if len(parts) != 4:
            continue
        lref, lsha, rref, rsha = parts
        dst = rref[len("refs/heads/"):] if rref.startswith("refs/heads/") else rref
        src = lref[len("refs/heads/"):] if lref.startswith("refs/heads/") else lref
        ev = {"type": "push", "branch": src if src != "(delete)" else dst, "remote": remote, "dst": dst}
        if set(lsha) == {"0"}:
            ev["delete"] = True
            out.append(ev)
            continue
        ev["sha"] = lsha[:10]
        new = set(rsha) == {"0"}
        ev["new"] = new
        base = main_branch if new else rsha
        if not new and git("cat-file", "-t", rsha) == "commit":
            ev["force"] = subprocess.run(["git", "merge-base", "--is-ancestor", rsha, lsha]).returncode != 0
        n = git("rev-list", "--count", f"{base}..{lsha}")
        ev["commits"] = int(n) if n.isdigit() else None
        ahead = git("rev-list", "--count", f"{main_branch}..{lsha}")
        ev["ahead"] = int(ahead) if ahead.isdigit() else None
        ev["subjects"] = git("log", "--format=%s", f"{main_branch}..{lsha}").splitlines()[:50]
        out.append(ev)
    return out


def await_landing(remote, events, limit=90):
    # pre-push runs BEFORE the push: an event written then can't say whether it landed. Watch the
    # remote-tracking ref git updates on success instead; a rejected or killed push never moves it.
    if not git("config", f"remote.{remote}.url"):
        return  # pushed to a bare URL: no tracking ref to watch, so the outcome stays unknown
    t0 = time.time()
    pending = [e for e in events if not e.get("delete") and e.get("sha")]
    while pending and time.time() - t0 < limit:
        time.sleep(1)
        for e in list(pending):
            got = git("rev-parse", "-q", "--verify", f"refs/remotes/{remote}/{e['dst']}")
            if got.startswith(e["sha"]):
                e["landed"], e["landMs"] = True, int((time.time() - t0) * 1000)
                pending.remove(e)
    for e in pending:
        e["landed"] = False


def who(want):
    path = log_file()
    if not want:
        print(f"usage: {os.path.basename(__file__)} who <sha>")
        return
    if not path or not os.path.exists(path):
        print("no usage log in this repo yet")
        return
    for line in reversed(open(path).read().splitlines()):
        try:
            ev = json.loads(line)
        except Exception:
            continue
        if ev.get("type") == "commit" and str(ev.get("sha", "")).startswith(want):
            by = ev.get("session") or "— no claude ancestor (a hand commit)"
            print(f"{ev['sha']}  by {by}  on {ev.get('branch')}  "
                  f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(ev.get('ts', 0)))}")
            return
    print(f"{want}: not in this repo's usage log (predates session stamping, or another repo)")


def log_file():
    gd = git("rev-parse", "--git-common-dir")
    if not gd:
        return ""
    if not os.path.isabs(gd):
        top = git("rev-parse", "--show-toplevel")
        gd = os.path.join(top, gd) if top else gd
    return os.path.join(gd, "stack-usage.jsonl")


def main():
    kind = sys.argv[1] if len(sys.argv) > 1 else ""
    if kind == "who":   # a read — answerable even with logging switched off
        return who(sys.argv[2] if len(sys.argv) > 2 else "")
    if os.environ.get("STACK_USAGE") == "0":
        return
    path = log_file()
    if not path:
        return
    ts = int(time.time())
    main_branch = git("config", "stack.main-branch") or "main"
    if kind == "commit":
        ev = commit_event(path, *(sys.argv[2:4] + ["", ""])[:2])
        events = [ev] if ev else []
        if ev:
            ahead = git("rev-list", "--count", f"{main_branch}..{ev['sha']}")
            ev["ahead"] = int(ahead) if ahead.isdigit() else None
    elif kind == "push":
        try:
            os.setsid()   # outlive the pusher's process group: the landing watch runs ~90s past it
        except OSError:
            pass
        remote = sys.argv[2] if len(sys.argv) > 2 else "origin"
        events = push_events(remote, sys.stdin.read())
    else:
        return
    if not events:
        return
    who_ = attribution()
    for ev in events:
        b = ev.get("branch") or ""
        ev["project"] = git("config", f"branch.{b}.stack-project") or git("config", f"stack-branch.{b}.project") or None
        ev.update(who_)
        ev["ts"] = ts
    if kind == "push":
        # written once the outcome is known, so the line lands up to ~90s after `ts` says
        await_landing(sys.argv[2] if len(sys.argv) > 2 else "origin", events)
    with open(path, "a") as f:
        for ev in events:
            f.write(json.dumps(ev) + "\n")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
