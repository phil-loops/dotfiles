#!/usr/bin/env python3
"""claude-say <who> <message…>  [--draft] — drop a message into another Claude Code
session's prompt, over tmux, and submit it.

SUBMIT BY DEFAULT (presses Enter): the text lands in the target's input line and is
sent, so a note can't be silently lost in an unattended pane. --draft (alias
--no-send) leaves the text WITHOUT Enter for a human to review and submit; --send is
still accepted as a no-op for muscle memory.

<who> picks a LIVE session (from the presence registry, see claude-sessions) by:
  • session-id prefix      claude-say 9272 "…"
  • repo name              claude-say loops "…"     (if it's the only loops session)
  • a substring of what it's working on (recent files / branch / area)
                           claude-say goal-attachment "…"
Empty, --list, ambiguous, or no-match → prints the addressable sessions.
--json (no <who>) → the same list as JSON with each session's tmux pane + address,
for machine callers (the viewer's ✦ session picker).

A live pid is necessary but NOT sufficient for reachability: a session idle for a
day still has a healthy process, and a note typed into its pane just sits unread.
Every listing carries the idle age and flags anything past STALE_WINDOW as ⚠ STALE
(--json: "stale": true). Sending to one WARNS but still sends — an unread note
beats no note, and the caller may be deliberately leaving a handoff.

The current session can't be MESSAGED, but --json/--list still show it (flagged
"(you)" / self:true) — a session introspecting its own address must see the truth,
not conclude it's unregistered and hand-guess a pane id (that guess once landed a
reply in a Helix pane as raw normal-mode keystrokes).
"""
import os, sys, json, glob, time, subprocess

DIR = os.path.expanduser("~/.claude/session-presence")
SCRIPTS = os.path.dirname(os.path.realpath(__file__))
# a working session heartbeats every few minutes at worst (a long typecheck is the gap);
# the observed split is seconds-to-minutes for everyone working vs. hours for the abandoned.
STALE_WINDOW = 1200   # seconds since last tool use → the pane is probably unattended


def sh(a):
    try:
        return subprocess.run(a, capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return ""


def pid_alive(pid, start):
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    except Exception:
        return False
    return " ".join(sh(["ps", "-o", "lstart=", "-p", str(pid)]).split()) == start


def live_sessions():
    """One record per live process (newest wins) — mirrors claude-sessions."""
    best = {}
    for f in glob.glob(os.path.join(DIR, "*.json")):
        try:
            r = json.load(open(f))
        except Exception:
            continue
        if not pid_alive(r.get("pid"), r.get("start_time", "")):
            continue
        pid = r.get("pid")
        if pid not in best or r.get("last_active", 0) > best[pid].get("last_active", 0):
            best[pid] = r
    return list(best.values())


def self_pid():
    out = sh([os.path.join(SCRIPTS, "claude-session-pid")])
    try:
        return int(out.split("\t")[0]) if out.strip() else None
    except Exception:
        return None


def idle_of(r):
    return max(0, int(time.time()) - int(r.get("last_active") or 0))


def ago(sec):
    if sec < 90:
        return "%ds" % sec
    if sec < 5400:
        return "%dm" % (sec // 60)
    return "%dh" % (sec // 3600)


def area(r):
    files = r.get("files") or []
    if files:
        segs = [s for s in files[-1].split("/") if s]
        return "/".join(segs[-2:]) if len(segs) >= 2 else (segs[-1] if segs else "?")
    return r.get("branch", "") or "—"


def pid_under_pane(pid, pane):
    """Is the session's process a descendant of the pane's own shell?"""
    if not pid or not pane:
        return False
    pane_pid = sh(["tmux", "display-message", "-p", "-t", pane, "#{pane_pid}"]).strip()
    if not pane_pid:
        return False
    p = int(pid)
    for _ in range(30):
        if not p or p <= 1:
            return False
        if str(p) == pane_pid:
            return True
        try:
            p = int(sh(["ps", "-o", "ppid=", "-p", str(p)]))
        except Exception:
            return False
    return False


def pane_of(r):
    """The session's tmux pane: the captured one, else reverse-map pid → pane."""
    if r.get("tmux_pane"):
        return r["tmux_pane"]
    pid = r.get("pid")
    if not pid:
        return ""
    anc, p = set(), pid
    for _ in range(30):
        if not p or p <= 1:
            break
        anc.add(p)
        try:
            p = int(sh(["ps", "-o", "ppid=", "-p", str(p)]))
        except Exception:
            break
    for line in sh(["tmux", "list-panes", "-a", "-F", "#{pane_id} #{pane_pid}"]).splitlines():
        try:
            pane, ppid = line.split()
            if int(ppid) in anc:
                return pane
        except Exception:
            pass
    return ""


def show(sessions, stream=sys.stdout, me=None):
    for r in sorted(sessions, key=idle_of):
        idle = idle_of(r)
        tail = "  (you)" if r.get("pid") == me else ""
        if idle >= STALE_WINDOW:
            tail += "  ⚠ STALE — likely unattended"
        print(("  %-10s %-28s %-18s idle %-5s%s" % (
            r.get("session_id", "")[:8], area(r), r.get("repo_name", ""), ago(idle), tail)).rstrip(), file=stream)


def main():
    flags = {a for a in sys.argv[1:] if a.startswith("--")}
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    send = not ({"--draft", "--no-send"} & flags)   # submit by default; --draft keeps draft-only

    me = self_pid()
    everyone = live_sessions()
    others = [r for r in everyone if r.get("pid") != me]

    if "--json" in flags and not args:
        out = []
        for r in sorted(everyone, key=lambda r: -(r.get("last_active") or 0)):
            pane = pane_of(r)
            if not pane:   # no pane = undeliverable; the picker only lists reachable sessions
                continue
            addr = sh(["tmux", "display-message", "-p", "-t", pane,
                       "#{session_name}:#{window_index}.#{pane_index} · #{window_name}"]).strip()
            out.append({
                "session_id": r.get("session_id", ""),
                "repo_name": r.get("repo_name", ""),
                "branch": r.get("branch", "") or "",
                "area": area(r),
                "pane": pane,
                "addr": addr,
                "idle_s": idle_of(r),
                "idle_h": ago(idle_of(r)),
                "stale": idle_of(r) >= STALE_WINDOW,
                "self": r.get("pid") == me,
            })
        print(json.dumps(out))
        return 0

    if not args or args[0] == "--list":
        print("addressable sessions:")
        show(everyone, me=me)
        return 0

    who, msg = args[0], " ".join(args[1:]).strip()
    if not msg:
        print("usage: claude-say <who> <message…> [--draft]", file=sys.stderr)
        return 2

    w = who.lower()
    def hit(r):
        return (r.get("session_id", "").startswith(who)
                or w == r.get("repo_name", "").lower()
                or w in area(r).lower()
                or w in (" ".join(r.get("files") or [])).lower()
                or w in (r.get("branch", "") or "").lower())
    cands = [r for r in others if hit(r)]

    if not cands:
        print("no live session matches %r. addressable:" % who, file=sys.stderr)
        show(others, sys.stderr)
        return 1
    if len(cands) > 1:
        print("%r matches %d sessions — narrow it (sid prefix or a unique file/area):" % (who, len(cands)), file=sys.stderr)
        show(cands, sys.stderr)
        return 1

    tgt = cands[0]
    pane = pane_of(tgt)
    if not pane:
        print("matched %s but found no tmux pane (not under tmux?) — can't deliver." % tgt.get("session_id", "")[:8], file=sys.stderr)
        return 1

    # never type into a pane that isn't a Claude prompt: a stale registry/pane mapping would
    # feed the message to whatever runs there as raw keystrokes (an editor eats them as
    # normal-mode commands — this typed a handback note into a Helix scratch buffer once).
    # Claude retitles its own process to its version ("2.1.207"), so the pane's command name
    # alone can't confirm it; proving the session's pid lives under this pane's shell can.
    cmd = sh(["tmux", "display-message", "-p", "-t", pane, "#{pane_current_command}"]).strip()
    if cmd not in ("claude", "node") and not pid_under_pane(tgt.get("pid"), pane):
        print("pane %s is running %r and does not host session pid %s — refusing to type into it."
              % (pane, cmd, tgt.get("pid")), file=sys.stderr)
        return 1

    # a leading "/" would make the target's CLI parse the message as a slash command
    # (and eat it as "Unknown command: /<word>") — a leading space defuses the parse.
    if msg.startswith("/"):
        msg = " " + msg

    idle = idle_of(tgt)
    if idle >= STALE_WINDOW:
        print("⚠ WARNING: %s has been idle %s — its process is alive but nobody is likely reading\n"
              "  that pane. Sending anyway; treat this as a note left behind, not a reply you'll get."
              % (tgt.get("session_id", "")[:8], ago(idle)), file=sys.stderr)

    subprocess.run(["tmux", "send-keys", "-t", pane, "-l", msg])   # literal text, NO Enter
    if send:
        # never submit into a composer that already held text: a stray char there fuses with
        # this message and our Enter executes the hybrid (a lone "/" + a note once ran as the
        # slash command "/disregard"). Positively-seen residue → leave as draft; can't-tell →
        # submit as before (a silently-lost note in an unattended pane is the worse failure).
        time.sleep(0.3)   # let the target TUI paint the typed text before inspecting it
        snippet = msg.strip()[:24]
        line = next((l for l in reversed(sh(["tmux", "capture-pane", "-t", pane, "-p"]).splitlines())
                     if snippet and snippet in l), "")
        # a lone nbsp/zero-width IS an empty composer — counting it as residue strands the note
        residue = line.split(snippet)[0].strip(" \t\xa0\u2007\u202f\u200b│|┃▌>❯›∙·⏵") if line else ""
        if residue:
            print("composer already held %r — NOT submitting; left as a draft to review in that pane."
                  % residue[-20:], file=sys.stderr)
            send = False
    if send:
        subprocess.run(["tmux", "send-keys", "-t", pane, "Enter"])
    print("%s → %s · %s  (pane %s, idle %s%s)" % (
        "sent+entered" if send else "drafted (no Enter — review & send in that pane)",
        tgt.get("session_id", "")[:8], area(tgt), pane, ago(idle),
        " ⚠ STALE" if idle >= STALE_WINDOW else ""))
    sys.stdout.flush()
    time.sleep(0.4)   # let the target TUI repaint so the confirmation shows the landed text
    tail = [l for l in sh(["tmux", "capture-pane", "-t", pane, "-p"]).splitlines() if l.strip()][-3:]
    for l in tail:
        print("  | " + l)
    return 0


sys.exit(main())
