#!/usr/bin/env bash
# gh-to-nvim-pack — bump the patch version, pack the extension into dist/ (CRX
# signed with gh-to-nvim-key.pem), and refresh dist/updates.xml.
#
# The launchd static server (gh-to-nvim-forceinstall) serves dist/ on
# 127.0.0.1:62530; the force-installed copy sees the newer published version
# and asks Chrome to fetch it. So the ship loop is:
# edit → gh-to-nvim-pack → Chrome installs the signed update on its next accepted check.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC="$here/gh-to-nvim"
KEY="$here/gh-to-nvim-key.pem"
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

stage_root="$(mktemp -d)"
trap 'rm -rf "$stage_root"' EXIT
stage="$stage_root/gh-to-nvim"
mkdir -p "$stage"
rsync -a --exclude dist --exclude .DS_Store --exclude README.md "$SRC/" "$stage/"
cp "$stage/manifest.json" "$stage_root/original.json"

# Chrome only installs a strictly higher version — every pack must bump.
VERSION="$(python3 - "$stage/manifest.json" "$SRC/dist/gh-to-nvim.crx" <<'EOF'
import json, sys, zipfile
path = sys.argv[1]
m = json.load(open(path))
versions = [m["version"]]
try:
    with zipfile.ZipFile(sys.argv[2]) as current:
        versions.append(json.loads(current.read("manifest.json"))["version"])
except (FileNotFoundError, zipfile.BadZipFile, KeyError, ValueError):
    pass
parts = max([int(part) for part in version.split(".")] for version in versions)
parts[-1] += 1
m["version"] = ".".join(map(str, parts))
with open(path, "w") as f:
    json.dump(m, f, indent=2, ensure_ascii=False)
    f.write("\n")
print(m["version"])
EOF
)"

"$CHROME" --pack-extension="$stage" --pack-extension-key="$KEY" >/dev/null

EXT_ID="$("$here/gh-to-nvim-ext-id" prod)"
if ! cmp -s "$stage_root/original.json" "$SRC/manifest.json"; then
  echo "manifest changed during packing; retry with the current source" >&2
  exit 1
fi
mkdir -p "$SRC/dist"
mv "$stage.crx" "$SRC/dist/gh-to-nvim.crx"
cp "$stage/manifest.json" "$SRC/manifest.json"

update_file="$(mktemp "$SRC/dist/updates.xml.XXXXXX")"
cat > "$update_file" <<XML
<?xml version='1.0' encoding='UTF-8'?>
<gupdate xmlns='http://www.google.com/update2/response' protocol='2.0'>
  <app appid='$EXT_ID'>
    <updatecheck codebase='http://localhost:62530/dist/gh-to-nvim.crx' version='$VERSION' />
  </app>
</gupdate>
XML
mv "$update_file" "$SRC/dist/updates.xml"

echo "packed v$VERSION → dist/gh-to-nvim.crx (id $EXT_ID)"
