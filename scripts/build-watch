#!/usr/bin/env bash
# build-watch — desktop-notify when the loops CI image build (build-and-test)
# finishes, so you stop refreshing Slack. Resolves the newest build-and-test run
# on your fork and hands it to prwatch, which streams status then fires a
# clickable notification + bell on Done/Failed (click opens the run).
#
#   build-watch                 watch the latest build-and-test run on Loops-so/loops
#   build-watch <run-id|url>    watch a specific run
#   build-watch -R owner/repo   watch the latest run in another repo (default Loops-so/loops)
set -euo pipefail

REPO="Loops-so/loops"
target=""
while [ $# -gt 0 ]; do
  case "$1" in
    -R|--repo) REPO="$2"; shift 2 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *)         target="$1"; shift ;;
  esac
done

if [ -z "$target" ]; then
  read -r id status title < <(gh run list -R "$REPO" --workflow=build-and-test.yml -L 1 \
    --json databaseId,status,displayTitle \
    -q '.[0] | "\(.databaseId)\t\(.status)\t\(.displayTitle)"')
  [ -n "${id:-}" ] || { echo "build-watch: no build-and-test runs found on $REPO" >&2; exit 1; }
  echo "→ latest build-and-test run $id ($status) — $title"
  target="https://github.com/$REPO/actions/runs/$id"
fi

exec prwatch "$target"
