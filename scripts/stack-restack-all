#!/usr/bin/env zsh
# Restack several projects back-to-back, RESILIENT to conflicts. A project that parks
# on a conflict must not block the others: we abort that project's own in-progress
# rebase (freeing whatever worktree it parked in) and carry on to the next. The FIRST
# project that hit a conflict is then re-restacked LAST so it re-parks and surfaces its
# contextual resolve/abort button to the human; everything that could restack already did.
#
# Only ever aborts a rebase THIS run started (located via the parked state's CURRENT
# branch) — never an unrelated rebase a human has going in some other worktree.
#
# Usage: stack-restack-all <project> [<project> ...]   (run cwd = the scratch worktree)
set -uo pipefail

SCRIPTS="${0:A:h}"
GIT_COMMON_DIR=$(git rev-parse --git-common-dir)
[[ "$GIT_COMMON_DIR" != /* ]] && GIT_COMMON_DIR="$PWD/$GIT_COMMON_DIR"
STATE="$GIT_COMMON_DIR/stack-restack-state/state"

# Single-flight the WHOLE batch. stack-restack locks per-invocation and releases on
# every exit (including a park→handoff), so back-to-back children leave gaps a
# concurrent `stack-restack <project>` can slip into — two drivers, one worktree.
# Hold ONE lock for the run; children go reentrant via STACK_RESTACK_LOCK_OWNER.
# Same lockfile stack-restack uses (GIT_COMMON_DIR, shared across linked worktrees).
LOCK_FILE="$GIT_COMMON_DIR/stack-restack.lock"
LOCK_HELD=""
release_batch_lock() {
  [[ -n "$LOCK_HELD" ]] || return 0
  local holder; holder="$(cat "$LOCK_HELD" 2>/dev/null)"
  [[ "${holder%% *}" == "$$" ]] && rm -f "$LOCK_HELD"
  LOCK_HELD=""
}
trap 'release_batch_lock' EXIT
while true; do
  if ( set -o noclobber; print -r -- "$$ restack-all $*" > "$LOCK_FILE" ) 2>/dev/null; then
    LOCK_HELD="$LOCK_FILE"; break
  fi
  holder="$(cat "$LOCK_FILE" 2>/dev/null)"; holder_pid="${holder%% *}"
  if [[ -n "$holder_pid" ]] && kill -0 "$holder_pid" 2>/dev/null; then
    echo "a restack is already running (pid $holder_pid: ${holder#* }) — wait for it, or abort the wedged project if needed." >&2
    exit 1
  fi
  echo "  (clearing stale restack lock from dead pid ${holder_pid:-?})" >&2
  rm -f "$LOCK_FILE"
done
export STACK_RESTACK_LOCK_OWNER=$$
# One PR lookup for the whole batch — each child stack-restack reuses it for the
# published-history guard instead of hitting the GitHub API per project.
export STACK_RESTACK_OPEN_PR_HEADS=" $(gh pr list --state open --limit 200 --json headRefName --jq '.[].headRefName' 2>/dev/null | tr '\n' ' ' || true) "

worktree_of() {  # the worktree a branch is checked out in (mirrors stack-restack's helper)
  git worktree list --porcelain | awk -v b="refs/heads/$1" '
    $1 == "worktree" { p = $2 }
    $0 == "branch " b { print p; exit }
  '
}

abort_park() {  # $1 = project whose just-finished run parked: undo its rebase + clear state
  local cur wt
  [[ -f "$STATE" ]] && cur=$(sed -n 's/^CURRENT=//p' "$STATE" | head -1) || true
  if [[ -n "${cur:-}" ]]; then
    wt=$(worktree_of "$cur")
    [[ -n "$wt" ]] && git -C "$wt" rebase --abort 2>/dev/null
  fi
  git -C "$PWD" rebase --abort 2>/dev/null            # also the scratch wt, if it parked here
  "$SCRIPTS/stack-restack" "$1" --abort >/dev/null 2>&1   # clears STATE_DIR + artifacts
}

# A SIGTERM/SIGINT mid-walk (e.g. the viewer's "■ stop" → /restack-stop) must actually STOP:
# abort whatever rebase is in flight, drop the parked state, release the lock, and exit — not
# just release the lock and resume the loop (the old EEXIT-INT-TERM trap did the latter, so a
# plain kill was ignored and /restack-stop had to escalate to SIGKILL). The server signals the
# child stack-restack too, so we needn't chase it here.
on_signal() {
  echo "" >&2
  echo "  ✋ restack-all interrupted — aborting the in-progress rebase and stopping" >&2
  local cur wt
  [[ -f "$STATE" ]] && cur=$(sed -n 's/^CURRENT=//p' "$STATE" | head -1) || true
  if [[ -n "${cur:-}" ]]; then
    wt=$(worktree_of "$cur")
    [[ -n "$wt" ]] && git -C "$wt" rebase --abort 2>/dev/null
  fi
  git -C "$PWD" rebase --abort 2>/dev/null
  rm -rf "$GIT_COMMON_DIR/stack-restack-state"
  release_batch_lock
  exit 130
}
trap 'on_signal' INT TERM

# Split leading --flags (forwarded to each stack-restack, e.g. --no-claude so the
# ambient daemon parks conflicts instead of spawning AI) from the project names.
typeset -a rflags projects
rflags=(); projects=()
for a in "$@"; do
  case "$a" in
    --*) rflags+=("$a") ;;
    *)   projects+=("$a") ;;
  esac
done

pop_now() {  # pop the first interactive "now" entry from the shared restack queue, if any
  # The viewer's /restack enqueues "now <project>" here when a driver is busy. Lost-pop /
  # re-appear races with the server's rewrite are harmless: a re-run restack is a no-op,
  # an un-popped entry gets drained after the batch.
  local qf="$GIT_COMMON_DIR/restack-queue" first
  [[ -f "$qf" ]] || return 1
  first="$(head -1 "$qf" 2>/dev/null)"
  [[ "$first" == now\ * ]] || return 1
  sed '1d' "$qf" > "$qf.tmp" && mv "$qf.tmp" "$qf"
  print -r -- "${first#now }"
}

typeset -a problems
typeset spliced
problems=()
for p in "${projects[@]}"; do
  # Interactive sync clicks jump in at project boundaries — they wait for ONE
  # mid-rebase project, never the whole sweep.
  while spliced="$(pop_now)"; do
    if "$SCRIPTS/stack-restack" "$spliced" "${rflags[@]}"; then
      echo "✓ $spliced restacked (spliced ahead of the sweep)"
    else
      echo "⚠ $spliced parked on a conflict — aborting to continue with the rest"
      problems+=("$spliced")
      abort_park "$spliced"
    fi
  done
  if "$SCRIPTS/stack-restack" "$p" "${rflags[@]}"; then
    echo "✓ $p restacked"
  else
    echo "⚠ $p parked on a conflict — aborting to continue with the rest"
    problems+=("$p")
    abort_park "$p"
  fi
done

if (( ${#problems} > 0 )); then
  # Re-run the first problem so it re-parks and its branch surfaces the contextual
  # button. Leaves that worktree mid-rebase on purpose — do NOT detach over a live park.
  echo "↩ re-surfacing ${problems[1]} for review (${#problems} project(s) need attention)"
  "$SCRIPTS/stack-restack" "${problems[1]}" "${rflags[@]}" || true
else
  git -C "$PWD" checkout --detach >/dev/null 2>&1   # release the last branch held here
fi
