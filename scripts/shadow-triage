#!/usr/bin/env python3
"""shadow-triage — label a shadow evaluator's disagreements with prod in Show.

  shadow-triage [FILE|-] [--focus]   read an EvalResult export (default: the clipboard), add its rows to the
                                     pipeline's store and open its labelling deck in Show
  shadow-triage sql [PIPELINE]       print the query whose result rows this reads (copy them as CSV, run again)
  shadow-triage results [PIPELINE]   your labels so far, content-free, plus the sharp set file for the next run
  shadow-triage form [PIPELINE] [--day YYYY-MM-DD]
                                     copy a Google Apps Script that builds a quiz for the team: one question per sending
                                     domain, one per page (Block / Allow); the answer key is your label from the deck
                                     (sol right / sol wrong), else Sol's call; Sol's reasoning shows after submit. Paste at script.google.com/create, Run, open the logged link.

Rows are grouped by the From address's root domain, one deck section per domain, so six copies of one campaign are
one decision. In Show: j/k move, 1 sol right · 2 sol wrong · 3 unsure, a takes the proposed label (your label from
an earlier deck for the same domain), the note field keeps a why. Labels live in the deck's .signoff.json and are
folded into ~/.local/share/shadow-triage/<pipeline>/labels.json on every run, so an archived deck's labels come back
as proposals when the domain shows up again.

Input: a CSV with a header row (any subset of EvalResult's columns that includes emailText), or headerless rows in
EvalResult's schema order (TablePlus / Postico "copy as CSV"). Deck text is customer-derived: decks stay in
~/.local/share/show, outside every repo.
"""
import csv
import hashlib
import io
import json
import os
import random
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

STORE = Path(os.environ.get("SHADOW_TRIAGE_STORE", Path.home() / ".local/share/shadow-triage"))
DECKS = Path(os.environ.get("SHADOW_TRIAGE_DECKS", Path.home() / ".local/share/show"))
LOOPS = Path(os.environ.get("SHADOW_TRIAGE_REPO", Path.home() / "coding/loops"))
SHOW = Path(__file__).resolve().parent / "show"

SCHEMA_ORDER = [
    "createdAt", "updatedAt", "id", "startedAt", "status", "errorMessage", "emailMessageId", "emailText",
    "prodRawOutput", "prodDecision", "prodEvalDuration", "pipeline", "evalDuration", "tokens", "rawOutput", "decision",
]
CHOICES = [
    {"key": "1", "label": "sol right"},
    {"key": "2", "label": "sol wrong"},
    {"key": "3", "label": "unsure"},
]
LABEL = {c["key"]: c["label"] for c in CHOICES}
MULTI_PART_SUFFIXES = {"co", "com", "org", "net", "gov", "edu", "ac"}


def die(message):
    print(f"shadow-triage: {message}", file=sys.stderr)
    sys.exit(1)


def as_bool(value):
    v = (value or "").strip().lower()
    if v in ("true", "t", "1", "yes"):
        return True
    if v in ("false", "f", "0", "no"):
        return False
    return None


def read_rows(text):
    records = list(csv.reader(io.StringIO(text)))
    records = [r for r in records if any(cell.strip() for cell in r)]
    if not records:
        die("no rows in the input")
    first = records[0]
    if "emailText" in first:
        header, body = first, records[1:]
    elif len(first) == len(SCHEMA_ORDER):
        header, body = SCHEMA_ORDER, records
    else:
        die(
            f"can't tell the columns: no header row with emailText, and {len(first)} columns isn't EvalResult's "
            f"{len(SCHEMA_ORDER)}. Export with headers, or run `shadow-triage sql` for a query that fits."
        )
    rows = []
    for record in body:
        row = {name: (record[i] if i < len(record) else "") for i, name in enumerate(header)}
        row = {k: (None if v == "NULL" else v) for k, v in row.items()}
        if not row.get("emailText"):
            continue
        if not row.get("id"):
            seed = (row.get("createdAt") or "") + row["emailText"]
            row["id"] = "h" + hashlib.sha1(seed.encode()).hexdigest()[:16]
        rows.append(row)
    if not rows:
        die("no row carries an emailText")
    return rows


def email_fields(text):
    fields = {}
    for line in text.splitlines()[:8]:
        m = re.match(r"^(Sender|From|Reply-to|Subject):\s*(.*)$", line)
        if m:
            fields[m.group(1)] = m.group(2).strip()
    return fields


def root_domain(address):
    host = (address or "").rsplit("@", 1)[-1].strip().lower().strip(">")
    parts = [p for p in host.split(".") if p]
    if len(parts) < 2:
        return host or "(no from address)"
    if len(parts) >= 3 and len(parts[-1]) == 2 and parts[-2] in MULTI_PART_SUFFIXES:
        return ".".join(parts[-3:])
    return ".".join(parts[-2:])


def model_answer(raw):
    if not raw:
        return {}
    try:
        answer = json.loads(raw)
        return answer if isinstance(answer, dict) else {}
    except json.JSONDecodeError:
        return {"unparsed": raw}


def direction(row):
    prod, sol = as_bool(row.get("prodDecision")), as_bool(row.get("decision"))
    word = {True: "block", False: "allow", None: "?"}
    return f"prod {word[prod]} → sol {word[sol]}"


def load_json(path, default):
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False))
    tmp.replace(path)


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "unknown"


def deck_path(pipeline):
    return DECKS / f"shadow-triage-{slug(pipeline)}.private.json"


def harvest_labels(pipeline):
    """Fold the deck's sign-offs into the pipeline's label ledger, keyed by root domain."""
    ledger_path = STORE / slug(pipeline) / "labels.json"
    ledger = load_json(ledger_path, {})
    name = deck_path(pipeline).with_suffix("").with_suffix(".private.signoff.json").name
    signoffs = {**load_json(DECKS / "archive" / name, {}), **load_json(DECKS / name, {})}
    rows_by_section = load_json(STORE / slug(pipeline) / "sections.json", {})
    for section_id, signoff in signoffs.items():
        if not section_id.startswith("d-") or not signoff.get("choice"):
            continue
        domain = section_id[2:]
        ledger[domain] = {
            "choice": signoff["choice"],
            "note": signoff.get("note") or "",
            "at": signoff.get("at"),
            "rowIds": rows_by_section.get(section_id, []),
        }
    write_json(ledger_path, ledger)
    return ledger


def prompt_text():
    """The evaluator prompts on origin/main, to mark reason phrases the model may be echoing."""
    try:
        listing = subprocess.run(
            ["git", "-C", str(LOOPS), "ls-tree", "-r", "--name-only", "origin/main", "evals/", "lib/evals/"],
            capture_output=True, text=True, check=True,
        ).stdout.split()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""
    texts = []
    for path in listing:
        if path.endswith(".ts") and not path.endswith(".test.ts"):
            show = subprocess.run(["git", "-C", str(LOOPS), "show", f"origin/main:{path}"], capture_output=True, text=True)
            texts.append(show.stdout)
    return "\n".join(texts)


def words(text):
    return re.findall(r"[a-z‹›]+", text.lower())


def mask_domains(text):
    return re.sub(r"\b[\w-]+(\.[\w-]+)+\b", "‹domain›", text)


def recurring_phrases(groups, prompt):
    """Word 4-grams that recur in the model's reasons across 3+ domains, marked when the prompt carries 3 of the words in a row."""
    seen = {}
    for domain, rows in groups.items():
        grams = set()
        for row in rows:
            ws = words(mask_domains(model_answer(row.get("rawOutput")).get("reason", "")))
            grams |= {" ".join(ws[i:i + 4]) for i in range(len(ws) - 3)}
        for gram in grams:
            seen.setdefault(gram, set()).add(domain)
    common = {g: d for g, d in seen.items() if len(d) >= 3}
    prompt_ws = words(prompt)
    prompt_trigrams = {" ".join(prompt_ws[i:i + 3]) for i in range(len(prompt_ws) - 2)}
    phrases = []
    for gram in common:
        ws = gram.split()
        if any(" ".join(ws[:3]) == " ".join(o.split()[1:]) and common[o] == common[gram] for o in common):
            continue
        while True:
            nxt = [o for o in common if " ".join(o.split()[:3]) == " ".join(ws[-3:]) and common[o] == common[gram]
                   and o != gram]
            if not nxt or len(ws) > 24:
                break
            ws.append(nxt[0].split()[-1])
        phrases.append((ws, common[gram]))
    out = []
    for ws, domains in sorted(phrases, key=lambda p: (-len(p[1]), -len(p[0]))):
        echoed = any(" ".join(ws[i:i + 3]) in prompt_trigrams for i in range(len(ws) - 2))
        out.append((" ".join(ws), sorted(domains), echoed))
    return out[:8]


def section_for(domain, rows, prior):
    rows = sorted(rows, key=lambda r: r.get("createdAt") or "", reverse=True)
    head = email_fields(rows[0]["emailText"])
    senders = sorted({email_fields(r["emailText"]).get("Sender", "") for r in rows} - {""})
    directions = sorted({direction(r) for r in rows})
    days = sorted({(r.get("createdAt") or "")[:10] for r in rows} - {""})
    when = days[0] if len(days) == 1 else f"{days[0]} – {days[-1]}" if days else ""

    verdicts = ["| when | prod | sol | request | relies on |", "|---|---|---|---|---|"]
    for r in rows:
        answer = model_answer(r.get("rawOutput"))
        cells = [
            (r.get("createdAt") or "")[5:16],
            f"{r.get('prodRawOutput') or '?'}",
            answer.get("verdict", "?"),
            answer.get("request", answer.get("unparsed", ""))[:90],
            answer.get("relies_on", "")[:90],
        ]
        verdicts.append("| " + " | ".join(c.replace("|", "/").replace("\n", " ") for c in cells) + " |")

    reasons = []
    for r in rows:
        reason = model_answer(r.get("rawOutput")).get("reason")
        if reason and reason not in reasons:
            reasons.append(reason)

    texts = []
    for r in rows:
        if r["emailText"] not in texts:
            texts.append(r["emailText"])

    body = [
        f"**{' · '.join(directions)}** · {len(rows)} row{'s' if len(rows) != 1 else ''} · {when}",
        "",
        "```",
        f"Sender:   {', '.join(senders) or '—'}",
        f"From:     {head.get('From', '—')}",
        f"Reply-to: {head.get('Reply-to', '—')}",
        "```",
    ]
    if prior:
        body += ["", f"> Labelled **{LABEL.get(prior['choice'], prior['choice'])}** on {(prior.get('at') or '')[:10]}"
                 + (f": {prior['note']}" if prior.get("note") else "")]
    body += ["", "## Why sol decided", ""] + [f"- {r}" for r in reasons]
    body += ["", "## Verdicts", ""] + verdicts
    for i, text in enumerate(texts):
        title = "## Email" if len(texts) == 1 else f"## Email {i + 1} of {len(texts)}"
        body += ["", title, "", "```", text.strip().replace("```", "ˋˋˋ"), "```"]

    section = {
        "id": f"d-{domain}",
        "group": "Unlabelled" if not prior else "Seen before",
        "title": domain,
        "tag": f"{senders[0] if senders else ''} · {len(rows)}×",
        "body": "\n".join(body),
    }
    if prior:
        section["proposed"] = prior["choice"]
    return section


def overview(pipeline, groups, ledger, phrases):
    all_rows = [r for rows in groups.values() for r in rows]
    by_direction = {}
    for r in all_rows:
        by_direction[direction(r)] = by_direction.get(direction(r), 0) + 1
    labelled = {d: ledger[d] for d in groups if d in ledger}
    tally = {}
    for entry in labelled.values():
        tally[LABEL.get(entry["choice"], entry["choice"])] = tally.get(LABEL.get(entry["choice"], entry["choice"]), 0) + 1

    lines = [
        f"`{pipeline}` against prod: each section is one sending domain. **1** sol right · **2** sol wrong · "
        "**3** unsure · **a** takes the proposed label · the note keeps the why.",
        "",
        "| disagreement | rows |",
        "|---|---|",
    ] + [f"| {k} | {v} |" for k, v in sorted(by_direction.items())]
    lines += ["", f"{len(groups)} domains, {len(labelled)} labelled"
              + (": " + ", ".join(f"{v} {k}" for k, v in sorted(tally.items())) if tally else ".")]
    if phrases:
        lines += ["", "## Reasons that repeat across domains", "",
                  "A phrase the model writes for many unrelated senders is often the prompt talking, not the email. "
                  "◆ marks phrases that share three words in a row with the evaluator's prompt on origin/main.", ""]
        lines += [f"- {'◆ ' if echoed else ''}“{gram}” — {', '.join(domains)}" for gram, domains, echoed in phrases]
    lines += ["", "## When you're done", "", "`shadow-triage results` prints the tally and writes the sharp set "
              "(row ids, domain, label, note) for the next prompt run."]
    return {"id": "overview", "group": "Overview", "title": "Overview", "body": "\n".join(lines)}


def build(rows_in, focus):
    pipelines = {}
    for row in rows_in:
        pipelines.setdefault(row.get("pipeline") or "unknown-pipeline", []).append(row)
    for pipeline, new_rows in pipelines.items():
        store_path = STORE / slug(pipeline) / "rows.json"
        store = load_json(store_path, {})
        added = sum(1 for r in new_rows if r["id"] not in store)
        for row in new_rows:
            store[row["id"]] = row
        write_json(store_path, store)

        ledger = harvest_labels(pipeline)
        groups = {}
        for row in store.values():
            groups.setdefault(root_domain(email_fields(row["emailText"]).get("From")), []).append(row)
        newest = lambda d: max((r.get("createdAt") or "") for r in groups[d])
        unlabelled = sorted([d for d in groups if d not in ledger], key=newest, reverse=True)
        seen = sorted([d for d in groups if d in ledger], key=newest, reverse=True)

        deck = {
            "title": f"Shadow triage · {pipeline}",
            "subtitle": "Is sol right where it disagrees with prod?",
            "choices": CHOICES,
            "sections": [overview(pipeline, groups, ledger, recurring_phrases(groups, prompt_text()))]
            + [section_for(d, groups[d], ledger.get(d)) for d in unlabelled + seen],
        }
        session = os.environ.get("CLAUDE_CODE_SESSION_ID", "")[:8]
        if session:
            deck["replyTo"] = session
        write_json(STORE / slug(pipeline) / "sections.json",
                   {f"d-{d}": [r["id"] for r in rows] for d, rows in groups.items()})
        path = deck_path(pipeline)
        write_json(path, deck)
        print(f"{pipeline}: {added} new rows, {len(groups)} domains → {path}")
        subprocess.run([str(SHOW)] + (["--focus"] if focus else []) + [str(path)], check=False)


def results(pipeline):
    pipelines = [pipeline] if pipeline else [p.name for p in STORE.iterdir() if p.is_dir()] if STORE.exists() else []
    if not pipelines:
        die("nothing triaged yet")
    for name in pipelines:
        deck = load_json(DECKS / f"shadow-triage-{slug(name)}.private.json", {})
        full = deck.get("title", "").removeprefix("Shadow triage · ") or name
        ledger = harvest_labels(full)
        store = load_json(STORE / slug(full) / "rows.json", {})
        sharp = []
        for domain, entry in sorted(ledger.items()):
            for row_id in entry["rowIds"]:
                row = store.get(row_id, {})
                sharp.append({"evalResultId": row_id, "emailMessageId": row.get("emailMessageId"), "domain": domain,
                              "label": LABEL.get(entry["choice"], entry["choice"]), "note": entry["note"]})
        sharp_path = STORE / slug(full) / "sharp-set.json"
        write_json(sharp_path, sharp)
        tally = {}
        for entry in ledger.values():
            label = LABEL.get(entry["choice"], entry["choice"])
            tally[label] = tally.get(label, 0) + 1
        domains = {root_domain(email_fields(r["emailText"]).get("From")) for r in store.values()}
        print(f"{full}: {len(ledger)} of {len(domains)} domains labelled — "
              + (", ".join(f"{v} {k}" for k, v in sorted(tally.items())) or "none yet"))
        print(f"  sharp set: {sharp_path} ({len(sharp)} rows)")


FORM_SCRIPT = """function buildShadowQuiz() {{
  var senders = {senders};
  var form = FormApp.create({title});
  form.setIsQuiz(true);
  form.setDescription("block or send");
  form.setProgressBar(true);
  form.setLimitOneResponsePerUser(true);
  try {{ form.setEmailCollectionType(FormApp.EmailCollectionType.VERIFIED); }} catch (e) {{}}
  form.setAllowResponseEdits(true);
  form.setPublishingSummary(true);
  senders.forEach(function (s, i) {{
    if (i > 0) form.addPageBreakItem();
    var item = form.addMultipleChoiceItem();
    var feedback = FormApp.createFeedback().setText(s.reveal).build();
    item.setTitle("would you let this send?")
      .setHelpText(s.email)
      .setChoices([item.createChoice("Block", s.key === "block"), item.createChoice("Allow", s.key === "allow")])
      .setRequired(true)
      .setPoints(1)
      .setFeedbackForCorrect(feedback)
      .setFeedbackForIncorrect(feedback);
    form.addPageBreakItem().setTitle("What Sol said").setHelpText(s.reveal);
    form.addParagraphTextItem().setTitle("Anything off about this reasoning?")
      .setHelpText("Optional. e.g. \\"I don't buy this because…\\"");
  }});
  form.addPageBreakItem();
  form.addParagraphTextItem().setTitle("Anything Sol got wrong? Which sender, and why");
  Logger.log("Share this: " + form.getPublishedUrl());
  Logger.log("Edit / responses: " + form.getEditUrl());
}}
"""


def form(pipeline, day):
    pipelines = [pipeline] if pipeline else [p.name for p in STORE.iterdir() if p.is_dir()] if STORE.exists() else []
    if len(pipelines) != 1:
        die("name the pipeline: " + ", ".join(pipelines) if pipelines else "nothing triaged yet")
    store = load_json(STORE / slug(pipelines[0]) / "rows.json", {})
    if not store:
        die("no rows stored for " + pipelines[0])
    full = next(iter(store.values())).get("pipeline") or pipelines[0]
    day = day or max((r.get("createdAt") or "")[:10] for r in store.values())
    groups = {}
    for row in store.values():
        if (row.get("createdAt") or "").startswith(day):
            groups.setdefault(root_domain(email_fields(row["emailText"]).get("From")), []).append(row)
    if not groups:
        die(f"no rows on {day}")
    ledger = harvest_labels(full)
    senders = []
    for domain, rows in sorted(groups.items()):
        row = max(rows, key=lambda r: r.get("createdAt") or "")
        answer = model_answer(row.get("rawOutput"))
        sol = "block" if as_bool(row.get("decision")) else "allow"
        label = ledger.get(domain, {}).get("choice")
        key = {"1": sol, "2": "allow" if sol == "block" else "block"}.get(label, sol)
        prod = {True: "blocked", False: "allowed", None: "?"}[as_bool(row.get("prodDecision"))]
        text = row["emailText"].strip()
        senders.append({
            "email": text if len(text) <= 1800 else text[:1800] + "\n…",
            "key": key,
            "reveal": f"Sol: {sol}. Prod: {prod}.\n\nRequest: {answer.get('request', '?')}\n"
                      f"Relies on: {answer.get('relies_on', '?')}\nWhy: {answer.get('reason', '?')}",
        })
    random.shuffle(senders)
    month, date = day[5:7].lstrip("0"), day[8:10].lstrip("0")
    script = FORM_SCRIPT.format(
        senders=json.dumps(senders, ensure_ascii=False, indent=2),
        title=json.dumps(f"{month}/{date} Disagreements"),
    )
    out = STORE / slug(pipelines[0]) / f"form-{day}.gs"
    out.write_text(script)
    subprocess.run(["pbcopy"], input=script, text=True)
    print(f"{full} · {day}: {len(senders)} questions → {out} (on the clipboard)")
    print("  script.google.com/create → paste over the editor → Run buildShadowQuiz → allow → the log prints the link")


SQL = """-- shadow flips for one pipeline over the last day; copy the result rows as CSV, then `shadow-triage`
SELECT * FROM "EvalResult"
WHERE pipeline = '{pipeline}'
  AND status = 'Completed'
  AND "rawOutput" <> ''
  AND decision IS DISTINCT FROM "prodDecision"
  AND "createdAt" > now() - interval '1 day'
ORDER BY "createdAt" DESC;"""


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    if args and args[0] == "sql":
        print(SQL.format(pipeline=args[1] if len(args) > 1 else "sol_layered_block_or_allow_v1"))
        return
    if args and args[0] == "form":
        rest = args[1:]
        day = rest[rest.index("--day") + 1] if "--day" in rest else None
        rest = [a for i, a in enumerate(rest) if a != "--day" and (i == 0 or rest[i - 1] != "--day")]
        form(rest[0] if rest else None, day)
        return
    if args and args[0] == "results":
        results(args[1] if len(args) > 1 else None)
        return
    focus = "--focus" in args
    args = [a for a in args if a != "--focus"]
    if not args:
        text = subprocess.run(["pbpaste"], capture_output=True, text=True).stdout
    elif args[0] == "-":
        text = sys.stdin.read()
    else:
        text = Path(args[0]).expanduser().read_text()
    build(read_rows(text), focus)


if __name__ == "__main__":
    main()
