#!/usr/bin/env bash
# build-notify — ambient monitor for build-and-test MAIN image builds. Taps me on the
# shoulder when a main build finishes, so I never track it by hand. launchd StartInterval
# sweep (one pass per invocation — see com.philbrockman.build-notify.plist).
#
# Notifies on completed main builds (merged-PR, direct push, or re-run), deduped by
# run-id. When a build maps to one of my merged PRs (its headSha == my PR's mergeCommit),
# the notification is enriched with the PR # and the ready-to-paste seed command. First run
# (and the v2 scope-widening) seeds finished builds silently — no backlog spam.
#
# Storm guards (the machine-was-off-for-two-days case): unseen builds that finished more
# than BUILD_NOTIFY_MAX_AGE_H ago seed silently, and only the NEWEST fresh success
# notifies per sweep — older successes in the same pass are superseded (logged, seeded).
# Failures still notify individually.
#
# v3 adds the staging sweep: my OPEN PRs whose body carries the Traffic Cop
# "Tested in staging" checklist get a notification when their PR-branch image build
# (matching the PR's current head) completes — with the ready-to-paste
# `task release:staging VERSION=...` deploy command. Seeds silently on first v3 run.
#
# v4 adds the staging-flip sweep: after a [staging] deploy-v2 enqueue completes, watch
# app.l3s.email's Next.js buildId and notify when staging is ACTUALLY serving a new
# build (the enqueue run itself finishes in ~10s and proves nothing).
#
#   build-notify                 one sweep (what launchd runs)
#   BUILD_NOTIFY_REPO=...        override repo (default Loops-so/loops)
#   BUILD_NOTIFY_MAX_AGE_H=...   notify horizon in hours (default 6)
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

REPO="${BUILD_NOTIFY_REPO:-Loops-so/loops}"
MAX_AGE_H="${BUILD_NOTIFY_MAX_AGE_H:-6}"
statedir="$HOME/.cache/build-notify"; mkdir -p "$statedir"
seen="$statedir/notified"
firstrun=0; [ -f "$seen" ] || { : > "$seen"; firstrun=1; }
# v2 widened scope (PR-only → all main builds); migrate silently the first time we see the old file.
grep -qx '#v2' "$seen" 2>/dev/null || firstrun=1
# v3 added the staging sweep; its first pass seeds already-finished branch builds silently.
v3first=0; grep -qx '#v3' "$seen" 2>/dev/null || v3first=1
# v4 added the staging-flip sweep; same silent first-pass seeding for deploy-v2 enqueues.
v4first=0; grep -qx '#v4' "$seen" 2>/dev/null || v4first=1

notify() {  # $1 title  $2 msg  $3 url
  "$HOME/.dotfiles/scripts/notify-journal" build-notify notified "$1" "$2" "$3" 2>/dev/null || true
  if command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title "build-notify · $1" -message "$2" -sound Glass -open "$3" >/dev/null 2>&1 || true
  else
    printf '\a'; echo "build-notify: $1 — $2 ($3)"
  fi
}
journal_silent() {  # $1 disposition  $2 title  $3 msg  $4 url
  "$HOME/.dotfiles/scripts/notify-journal" build-notify "$1" "$2" "$3" "$4" 2>/dev/null || true
}
dur_of() {  # $1 startedAt  $2 updatedAt (ISO) -> "Nm" or ""
  [ -n "$1" ] && [ -n "$2" ] || return 0
  local s e; s=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$1" +%s 2>/dev/null) || return 0
  e=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$2" +%s 2>/dev/null) || return 0
  echo "$(( (e - s) / 60 ))m"
}

# my merged PRs → "mergeSha<TAB>number" (for enrichment + seed suggestion)
prs=$(gh pr list -R "$REPO" --author @me --state merged -L 30 --json number,mergeCommit \
  -q '.[] | select(.mergeCommit.oid != null) | "\(.mergeCommit.oid)\t\(.number)"' 2>/dev/null || true)

# completed build-and-test main runs
runs=$(gh run list -R "$REPO" --workflow=build-and-test.yml --branch main -L 30 \
  --json databaseId,headSha,conclusion,number,headBranch,startedAt,updatedAt,event,url,status \
  -q '.[] | select(.status=="completed") | [.databaseId,.headSha,.conclusion,.number,.headBranch,.startedAt,.updatedAt,.event,.url] | @tsv' 2>/dev/null || true)
[ -n "$runs" ] || { grep -qx '#v2' "$seen" 2>/dev/null || echo '#v2' >> "$seen"; exit 0; }

# Cross-sweep supersession: a merge train gives every merge its own main build, but each
# newer build CONTAINS the older ones — an older success is stale the moment a newer main
# build is in flight. (The success_notified guard below only covers two successes landing
# in the SAME sweep.) Failures still notify individually — red main is always actionable.
inflight_max=$(gh run list -R "$REPO" --workflow=build-and-test.yml --branch main -L 10 \
  --json number,status -q '[.[] | select(.status!="completed") | .number] | max // 0' 2>/dev/null || echo 0)

now_s=$(date +%s)
success_notified=0
while IFS=$'\t' read -r rid sha concl runnum headbr startedAt updatedAt event url; do
  [ -n "$rid" ] || continue
  grep -qx "$rid" "$seen" && continue
  if [ "$firstrun" = "1" ]; then echo "$rid" >> "$seen"; continue; fi   # seed silently
  tag="${headbr}-${runnum}-1"
  end_s=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$updatedAt" +%s 2>/dev/null || echo 0)
  if [ "$end_s" -gt 0 ] && [ $(( now_s - end_s )) -gt $(( MAX_AGE_H * 3600 )) ]; then
    echo "build-notify: · $tag finished >${MAX_AGE_H}h ago — seeded silently"
    journal_silent silent-age "$tag" "${concl:-?} build finished >${MAX_AGE_H}h ago" "$url"
    echo "$rid" >> "$seen"; continue
  fi
  dur=$(dur_of "$startedAt" "$updatedAt")
  # PR match (no early awk exit → SIGPIPE-safe)
  prnum=$(printf '%s\n' "$prs" | awk -F'\t' -v s="$sha" '$1==s && !f{print $2; f=1}')
  # one-shot mute: an explicit prwatch on this PR already fired its single notification —
  # its post-merge image-build success seeds silently (failures still notify: pipeline alert)
  answered_key=$(printf '%s#%s' "$REPO" "${prnum:-}" | tr '[:upper:]' '[:lower:]')
  if [ -n "$prnum" ] && [ "$concl" = "success" ] \
     && grep -qxF "$answered_key" "$HOME/.cache/prwatch/answered.txt" 2>/dev/null; then
    echo "build-notify: · $tag (PR #$prnum) muted — explicit watch already notified"
    journal_silent silent-answered "$tag" "PR #$prnum already answered by an explicit watch" "$url"
    echo "$rid" >> "$seen"; continue
  fi
  if [ "$concl" = "success" ]; then
    if [ "$success_notified" = "1" ]; then   # runs arrive newest-first; a newer success already notified
      echo "build-notify: · $tag superseded this sweep — seeded silently"
      journal_silent silent-superseded "$tag" "built, superseded by a newer build this sweep" "$url"
      echo "$rid" >> "$seen"; continue
    fi
    if [ "${inflight_max:-0}" -gt "$runnum" ] 2>/dev/null; then
      echo "build-notify: · $tag superseded — main build #$inflight_max in flight"
      journal_silent silent-superseded "$tag" "built; superseded by in-flight main build #$inflight_max" "$url"
      echo "$rid" >> "$seen"; continue
    fi
    success_notified=1
    if [ -n "$prnum" ]; then
      msg="PR #$prnum → $tag${dur:+ in $dur}. Seed staging: seed-staging-goal --tag $tag"
    elif [ "$event" != "pull_request" ]; then
      msg="main build $tag (direct push)${dur:+ in $dur}. Seed: seed-staging-goal --tag $tag"
    else
      msg="$tag built${dur:+ in $dur}. Seed: seed-staging-goal --tag $tag"
    fi
    notify "✓ image built" "$msg" "$url"
    echo "build-notify: ✓ $tag${dur:+ ($dur)} — seed-staging-goal --tag $tag"
  else
    notify "✗ build ${concl:-failed}" "$tag ${concl:-failed}${dur:+ after $dur}. Re-run at the run page ↗" "$url"
  fi
  echo "$rid" >> "$seen"
done <<< "$runs"

# --- staging sweep: open PRs with the "Tested in staging" marker ---------------------
# Notify when the build for the PR's CURRENT head completes — a new push makes a new run
# (new run-id), so re-pushes re-notify naturally. Dedup shares $seen (run ids are global).
stprs=$(gh pr list -R "$REPO" --author @me --state open \
  --json number,headRefName,headRefOid,body \
  -q '.[] | select(.body | test("tested in staging"; "i")) | [(.number|tostring),.headRefName,.headRefOid] | @tsv' 2>/dev/null || true)

while IFS=$'\t' read -r prnum prbranch prsha; do
  [ -n "$prnum" ] || continue
  runs=$(gh run list -R "$REPO" --workflow=build-and-test.yml --branch "$prbranch" -L 15 \
    --json databaseId,headSha,conclusion,status,number,attempt,createdAt,startedAt,updatedAt,url \
    -q '.[] | select(.status=="completed") | [(.databaseId|tostring),.headSha,.conclusion,(.number|tostring),(.attempt|tostring),.createdAt,.startedAt,.updatedAt,.url] | @tsv' 2>/dev/null || true)
  [ -n "$runs" ] || continue
  # newest completed run on the PR's current head (no early awk exit → SIGPIPE-safe)
  line=$(printf '%s\n' "$runs" | awk -F'\t' -v s="$prsha" '$2==s && !f{print; f=1}')
  [ -n "$line" ] || continue
  IFS=$'\t' read -r rid sha concl runnum attempt createdAt startedAt updatedAt url <<< "$line"
  grep -qx "$rid" "$seen" && continue
  if [ "$firstrun" = "1" ] || [ "$v3first" = "1" ]; then echo "$rid" >> "$seen"; continue; fi
  end_s=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$updatedAt" +%s 2>/dev/null || echo 0)
  if [ "$end_s" -gt 0 ] && [ $(( now_s - end_s )) -gt $(( MAX_AGE_H * 3600 )) ]; then
    echo "build-notify: · PR #$prnum staging build finished >${MAX_AGE_H}h ago — seeded silently"
    journal_silent silent-age "PR #$prnum staging build" "${concl:-?} finished >${MAX_AGE_H}h ago" "$url"
    echo "$rid" >> "$seen"; continue
  fi
  dur=$(dur_of "$startedAt" "$updatedAt")
  d="${createdAt:0:10}"; version="${d//-/.}-$runnum-$attempt"
  if [ "$concl" = "success" ]; then
    notify "⇪ staging build ready" "PR #$prnum ($prbranch) built${dur:+ in $dur}. Deploy: task release:staging VERSION=$version" "$url"
    echo "build-notify: ⇪ PR #$prnum staging build ready — task release:staging VERSION=$version"
  else
    notify "✗ staging build ${concl:-failed}" "PR #$prnum ($prbranch) ${concl:-failed}${dur:+ after $dur}. Re-run at the run page ↗" "$url"
  fi
  echo "$rid" >> "$seen"
done <<< "$stprs"

# --- staging-flip sweep: notify when staging is ACTUALLY running a new build ----------
# deploy-v2 "success" = ENQUEUED only (10s shim: Slack announce + `loopsctl deploy` → SQS;
# the deployer worker does the helm rollout and reports to the Slack thread). The
# machine-side "go test" signal is staging serving a NEW Next.js buildId, so: arm a
# pending watch on a completed [staging] deploy-v2 enqueue, then notify when the buildId
# flips — or nag if it hasn't after BUILD_NOTIFY_STAGING_STALL_MIN. Enqueue failures
# notify immediately. kubectl would be exact but needs an interactive aws-vault unlock.
STAGING_URL="${BUILD_NOTIFY_STAGING_URL:-https://app.l3s.email/}"
STALL_MIN="${BUILD_NOTIFY_STAGING_STALL_MIN:-45}"
pend="$statedir/staging-pending"

# the 404 shell also embeds buildId, so no auth needed (no head/exit → SIGPIPE-safe)
bid_now=$(curl -sS --max-time 8 "$STAGING_URL" 2>/dev/null | sed -n 's/.*"buildId":"\([^"]*\)".*/\1/p' | awk 'NR==1' || true)

# Staleness ground truth: the buildId only changes when staging actually SERVES a new
# build, so its flip time is "how fresh is staging" — no kubectl (needs an aws-vault
# unlock) and no Slack-thread reading. staging-last gains version/actor from the pending
# enqueue below when one is armed; an untracked deploy still moves the clock.
bidfile="$statedir/staging-bid"; lastfile="$statedir/staging-last"
if [ -n "$bid_now" ]; then
  prev_bid=$(cut -f1 "$bidfile" 2>/dev/null || true)
  if [ "$bid_now" != "$prev_bid" ]; then
    printf '%s\t%s\n' "$bid_now" "$now_s" > "$bidfile"
    [ -n "$prev_bid" ] && printf '?\t?\t%s\n' "$now_s" > "$lastfile"
  fi
fi

deps=$(gh run list -R "$REPO" --workflow=deploy-v2.yml -L 10 \
  --json databaseId,displayTitle,status,conclusion,updatedAt,url \
  -q '.[] | select(.status=="completed" and (.displayTitle | startswith("[staging]"))) | [(.databaseId|tostring),.conclusion,.displayTitle,.updatedAt,.url] | @tsv' 2>/dev/null || true)

while IFS=$'\t' read -r rid concl title updatedAt url; do
  [ -n "$rid" ] || continue
  grep -qx "$rid" "$seen" && continue
  if [ "$firstrun" = "1" ] || [ "$v4first" = "1" ]; then echo "$rid" >> "$seen"; continue; fi
  end_s=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$updatedAt" +%s 2>/dev/null || echo 0)
  if [ "$end_s" -gt 0 ] && [ $(( now_s - end_s )) -gt $(( MAX_AGE_H * 3600 )) ]; then
    journal_silent silent-age "$title" "${concl:-?} enqueue finished >${MAX_AGE_H}h ago" "$url"
    echo "$rid" >> "$seen"; continue
  fi
  ver="${title#\[staging\] deploying }"
  if [ "$concl" = "success" ]; then
    actor=$(gh api "repos/$REPO/actions/runs/$rid" -q '.actor.login' 2>/dev/null || echo "?")
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$rid" "$now_s" "${bid_now:-unknown}" "$ver" "$actor" "$url" > "$pend"
    echo "build-notify: ⛴ staging deploy $ver enqueued by $actor — watching for buildId flip"
    journal_silent armed "staging $ver" "enqueued by $actor; watching for the buildId flip" "$url"
  else
    notify "✗ staging enqueue ${concl:-failed}" "$title — deploy never enqueued. Re-run at the run page ↗" "$url"
  fi
  echo "$rid" >> "$seen"
done <<< "$deps"

if [ -s "$pend" ] && [ -n "$bid_now" ]; then
  IFS=$'\t' read -r prid parm_s pbid pver pactor purl < "$pend"
  if [ "$pbid" = "unknown" ]; then   # baseline fetch failed at arm time; take it now
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$prid" "$parm_s" "$bid_now" "$pver" "$pactor" "$purl" > "$pend"
  elif [ "$bid_now" != "$pbid" ]; then
    mins=$(( (now_s - parm_s) / 60 ))
    notify "⛴ staging flipped" "$pver ($pactor) is live ~${mins}m after enqueue — go test" "$STAGING_URL"
    echo "build-notify: ⛴ staging flipped to $pver (${mins}m)"
    printf '%s\t%s\t%s\n' "$pver" "$pactor" "$now_s" > "$lastfile"
    : > "$pend"
  elif [ $(( now_s - parm_s )) -gt $(( STALL_MIN * 60 )) ]; then
    notify "⏳ staging deploy stalled" "$pver enqueued >${STALL_MIN}m ago and staging's buildId hasn't changed — check the Slack thread" "$purl"
    : > "$pend"
  fi
fi

grep -qx '#v2' "$seen" 2>/dev/null || echo '#v2' >> "$seen"
grep -qx '#v3' "$seen" 2>/dev/null || echo '#v3' >> "$seen"
grep -qx '#v4' "$seen" 2>/dev/null || echo '#v4' >> "$seen"
tail -n 300 "$seen" > "$seen.tmp" 2>/dev/null && mv "$seen.tmp" "$seen"
