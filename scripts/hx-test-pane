#!/bin/zsh
# hx-test-pane <pane-id> <root> <rel> <watch-file>... — the daemon behind space-t's
# test pane. Runs OUTSIDE the pane (it drives the pane via respawn-pane, so it must not
# BE the pane's process). Loop: run the test once → respawn the pane as a plain read-only
# `less` at the bottom of the result → block until a watched file changes → repeat.
#
# Why not `tsx --watch | less -R +F`: follow-mode shows a "Waiting for data" prompt and
# swallows j/k until Ctrl-c. Re-opening a fresh non-follow `less` per run instead keeps the
# pane a normal pager — bare vim nav works out of the box — while still snapping to the
# newest result. +G is safe here because we page a real file (a pipe would block on EOF).
set -u
export PATH="$HOME/.volta/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

pane=$1; root=$2; rel=$3; shift 3
watch=("$@")
log=$(mktemp -t hx-test)
trap 'rm -f "$log"' EXIT

pane_alive() { tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$pane"; }
sig() { local f s=""; for f in "$watch[@]"; do s+=" $(stat -f %m "$f" 2>/dev/null)"; done; print -r -- "$s"; }
# respawn-pane -k kills the previous less and opens a fresh one at the bottom (latest run),
# in the foreground so it owns the tty and bare j/k scroll.
show() { tmux respawn-pane -k -t "$pane" "less -R +G ${(q)log}" 2>/dev/null; }
fail() { : > "$log"; printf '\n  ✗ %s\n' "$1" >> "$log"; show; exit 1; }

cd "$root" 2>/dev/null || fail "worktree is gone: $root"
# Repo-local tsx only — a bare `npx tsx` in a worktree without node_modules net-installs its
# own copy and flails (a scratch checkout of someone else's branch is exactly that worktree).
tsx="$root/node_modules/.bin/tsx"
[[ -x "$tsx" ]] || fail "no node_modules in ${root:t} — ln -s the main checkout's (or npm ci), then space-t again"
# tsconfig.node.json was split into typescript/tsconfig.{runtime,test}.json (loops PR #9599);
# pre-split branches still carry the old single config.
cfg=typescript/tsconfig.test.json
[[ -f "$root/$cfg" ]] || cfg=tsconfig.node.json

while pane_alive; do
  [[ -d "$root" && -f "$root/$rel" ]] || fail "worktree vanished under the watcher: $root"
  : > "$log"
  FORCE_COLOR=1 "$tsx" --tsconfig "$cfg" --test-reporter=spec --test "$rel" >> "$log" 2>&1
  pane_alive || break
  show || break
  base=$(sig)
  while pane_alive; do
    sleep 0.6
    [[ -d "$root" ]] || fail "worktree vanished under the watcher: $root"
    [[ "$(sig)" != "$base" ]] && break
  done
done
