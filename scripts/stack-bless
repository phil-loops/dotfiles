#!/bin/zsh
# stack-bless — record per-file blob hashes as "blessed" (reviewed) for a branch.
#
# Shares the EXACT ledger + model used by nvim's custom/stack-blessed.lua:
#   store:  $GIT_DIR/stack-blessed.json   shape { branch: { path: blobhash } }
#   model:  a file is "blessed" at the blob hash (git rev-parse <branch>:<path>)
#           you reviewed. Blob hashes are content, so they survive rebases —
#           a file goes "stale" only when its content actually changes.
# Blessing here (CLI / website) and blessing in nvim write the same ledger, so
# there is exactly one blessing concept.
#
# Usage:
#   stack-bless <branch> [--parent <p>]             bless every file in <p>...<branch>
#   stack-bless <branch> --file <path>               bless a single file
#   stack-bless <branch> --unbless [--file <path>]   remove a bless (file, or whole branch)
#   stack-bless refs/stack/<project>-integration [--file <path>] [--unbless]
#       ghost bless: the integration node blesses under ITS OWN ledger key (the ref),
#       vs origin/main. Deliberately independent of per-branch blesses — approving a
#       file in the whole-feature view is a different review act than approving each
#       branch's increment, and neither implies the other.
#
# Parent defaults to stack-branch.<branch>.parent, then stack.main-branch, then main.
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

branch=""; parent=""; file=""; unbless=0
while (( $# )); do
  case "$1" in
    --parent)  parent="$2"; shift 2;;
    --file)    file="$2"; shift 2;;
    --unbless) unbless=1; shift;;
    -*) echo "stack-bless: unknown flag $1" >&2; exit 2;;
    *)  if [[ -z "$branch" ]]; then branch="$1"; shift
        else echo "stack-bless: unexpected arg $1" >&2; exit 2; fi;;
  esac
done
[[ -n "$branch" ]] || { echo "usage: stack-bless <branch> [--parent p] [--file path] [--unbless]" >&2; exit 2; }

if [[ "$branch" == refs/stack/*-integration ]]; then
  # ghost integration node: a real blessable ref with its own ledger key. Its diff/bless
  # base is the trunk (no stack-branch.<ref>.parent exists, so the default resolution
  # below lands on main → origin/main), matching the viewer's main..integration view.
  git rev-parse --verify --quiet "$branch" >/dev/null \
    || { echo "stack-bless: no such integration ref: $branch" >&2; exit 1; }
else
  git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null \
    || { echo "stack-bless: no such branch: $branch" >&2; exit 1; }
fi

git_dir=$(git rev-parse --path-format=absolute --git-common-dir)
ledger="$git_dir/stack-blessed.json"
[[ -f "$ledger" ]] || echo '{}' > "$ledger"
# Sidecar ledger keyed on the branch's CONTRIBUTION identity (rebase-stable patch-id
# of parent...branch per file) rather than the file blob. The blob ledger above stays
# the source for nvim + legacy entries; readers prefer this sidecar when present and
# fall back to the blob otherwise. We write BOTH so a CLI/web bless is visible to nvim.
contrib="$git_dir/stack-blessed-contrib.json"
[[ -f "$contrib" ]] || echo '{}' > "$contrib"
tmp="$(mktemp)"

# Serialize the ledger read-modify-write: the viewer's keyboard blessing fires rapid
# concurrent /bless POSTs that each exec stack-bless, and their jq-then-mv interleaves
# (last mv wins → lost blesses). mkdir is the portable atomic mutex (no flock on macOS).
# Partial: nvim's stack-blessed.lua writes the same files unlocked, so this guards the
# CLI/viewer path against itself, not against a simultaneous nvim bless.
lockdir="$git_dir/stack-blessed.lock"
for _ in {1..40}; do
  mkdir "$lockdir" 2>/dev/null && break
  # steal a crashed holder's lock — 10s dwarfs any real bless write
  if [[ -d "$lockdir" ]] && (( $(date +%s) - $(stat -f %m "$lockdir" 2>/dev/null || echo 0) > 10 )); then
    rmdir "$lockdir" 2>/dev/null || true
  fi
  sleep 0.05
done
trap 'rmdir "$lockdir" 2>/dev/null || true' EXIT

if (( unbless )); then
  if [[ -n "$file" ]]; then
    for L in "$ledger" "$contrib"; do
      jq --arg b "$branch" --arg f "$file" '
        (if .[$b] then .[$b] |= del(.[$f]) else . end)
        | (if (.[$b] // {}) == {} then del(.[$b]) else . end)' "$L" > "$tmp"
      mv "$tmp" "$L"
    done
    echo "unblessed $file on $branch"
  else
    for L in "$ledger" "$contrib"; do
      jq --arg b "$branch" 'del(.[$b])' "$L" > "$tmp"; mv "$tmp" "$L"
    done
    echo "unblessed all of $branch"
  fi
  exit 0
fi

# resolve parent for the file list
[[ -n "$parent" ]] || parent=$(git config "branch.${branch}.stack-parent" 2>/dev/null || git config "stack-branch.${branch}.parent" 2>/dev/null || true)
[[ -n "$parent" ]] || parent=$(git config stack.main-branch 2>/dev/null || echo main)

# the trunk bless-base is the REMOTE trunk (origin/main) — what the branch merges into — so a
# stale local main can't shift the rebase-stable patch-id. Mirrors stack-forest's trunk_base, so
# a bless WRITTEN here matches the contribution id stack-forest CHECKS against.
_main=$(git config stack.main-branch 2>/dev/null || echo main)
if [[ "$parent" == "$_main" ]] && git rev-parse --verify --quiet "origin/${_main}" >/dev/null; then
  parent="origin/${_main}"
fi

if [[ -n "$file" ]]; then
  files=("$file")
else
  files=("${(@f)$(git diff --name-only "${parent}...${branch}")}")
fi

# build { path: blob } (content) and { path: patch-id } (contribution) for files
# that still exist on the branch. The patch-id of `git diff -U0 parent...branch`
# is invariant under rebase — it survives the parent moving underneath the branch,
# so an inherited upstream edit to the same file no longer reads as "changed".
updates='{}'; cupdates='{}'; count=0
for f in "${files[@]}"; do
  [[ -n "$f" ]] || continue
  blob=$(git rev-parse "${branch}:${f}" 2>/dev/null) || continue
  updates=$(jq --arg f "$f" --arg b "$blob" '. + {($f): $b}' <<< "$updates")
  cid=$(git diff -U0 "${parent}...${branch}" -- "$f" 2>/dev/null | git patch-id --stable | awk '{print $1}')
  [[ -n "$cid" ]] && cupdates=$(jq --arg f "$f" --arg c "$cid" '. + {($f): $c}' <<< "$cupdates")
  count=$((count + 1))
done

jq --arg b "$branch" --argjson upd "$updates" \
  '.[$b] = ((.[$b] // {}) + $upd)' "$ledger" > "$tmp"
mv "$tmp" "$ledger"
jq --arg b "$branch" --argjson upd "$cupdates" \
  '.[$b] = ((.[$b] // {}) + $upd)' "$contrib" > "$tmp"
mv "$tmp" "$contrib"
echo "blessed $count file(s) on $branch (vs $parent)"
