#!/usr/bin/env python3
"""stack-gates — run a repo's pre-push gates and report per-gate pass/fail as JSON.

This is the "run the gates" step of prepare-to-push: the mobile flow shows each
gate's verdict and only enables push when all are green (a red gate = "blocked,
needs the laptop" — you can't fix code from a phone).

Gates are git-config driven so each repo declares its own, e.g.:

    git config --add stack-gates.cmd "typecheck::./node_modules/.bin/tsc --project tsconfig.node.json --noEmit"
    git config --add stack-gates.cmd "format::git diff --name-only main HEAD -- '*.ts' '*.tsx' | xargs -r ./node_modules/.bin/oxfmt --check"

Each entry is "<label>::<shell command>"; a non-zero exit fails that gate. With no
config, falls back to auto-detected defaults (repo-local tsc if a tsconfig exists,
oxfmt --check on changed *.ts/*.tsx if oxfmt is present).

  stack-gates [<branch> | --branch <b>] [--fix] [--progress <file>]
                                       run in the worktree of <b>; if none exists, materialize
                                       its stack-open scratch checkout (detached at the tip) —
                                       never gates an unrelated tree. Unrecognized arguments
                                       are an error (a silently-dropped branch arg once gated
                                       the caller's cwd and recorded verdicts for it).

Before any gate runs, the tree's generated artifacts are repaired in place (reported as an
"env" entry only when something was done): a node_modules symlink pointing anywhere but the
main checkout is repointed, and seed-gen --sync brings .gen (and main's packages dist) up to
date for the gated HEAD — so a red typecheck means the CODE is wrong, not the tree.

--progress: append JSONL events to <file> as gates run — {"event":"plan","gates":[...]},
then start/done per gate, then {"event":"result",...} mirroring stdout. Lets a caller
that spawned this detached (srv/push.py /gates) show live per-gate progress.

--fix: a red gate with a registered remediation (`stack-gates.fix "<name>::<cmd>"`, or a
built-in) gets one fix attempt + re-check. The built-in format fix cascades stack-fmt
across the branch's forest (or folds an oxfmt commit on a standalone branch). A fixed
gate reports "fixed": true.

Output (stdout): {"ok": bool, "gates": [{"name","ok","ms","summary","fixed"?}]}
"""
import json
import os
import shlex
import shutil
import subprocess
import sys
import time


def run(cmd, cwd):
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)


def worktree_of(branch, cwd):
    """Path of the worktree holding <branch>, or None if it isn't checked out anywhere."""
    if not branch:
        return None
    path = None
    out = run(["git", "worktree", "list", "--porcelain"], cwd).stdout
    for ln in out.splitlines():
        if ln.startswith("worktree "):
            path = ln[len("worktree "):]
        elif ln == f"branch refs/heads/{branch}" and path:
            return path
    return None


def scratch_checkout(branch, cwd):
    """Materialize <branch> in its stack-open scratch worktree (detached at the tip,
    node_modules symlinked, .gen seeded) and return (path, err). Gating cwd's tree
    instead would verify whatever bytes the caller's checkout happens to hold — a
    verdict recorded against a branch that was never actually checked."""
    stack_open = os.path.join(os.path.dirname(os.path.abspath(__file__)), "stack-open")
    r = run([stack_open, "--path", branch], cwd)
    lines = [ln.strip() for ln in (r.stdout or "").splitlines() if ln.strip()]
    path = lines[-1] if lines else ""
    if r.returncode != 0 or not os.path.isdir(path):
        return None, f"scratch checkout failed: {last_lines(r.stderr or r.stdout or '', 3)}"
    tip = run(["git", "rev-parse", branch], cwd).stdout.strip()
    head = run(["git", "rev-parse", "HEAD"], path).stdout.strip()
    if head != tip:
        return None, f"scratch worktree {path} is pinned off the branch tip"
    # helix-tsgo-stamp seeds machine-local editor config into every worktree — tooling
    # dirt, not branch content; a red here poisons callers' per-tree memos (pregate)
    dirt = [ln for ln in run(["git", "status", "--porcelain"], path).stdout.splitlines()
            if ln.strip() and ln[3:] not in (".helix/", ".helix/languages.toml")]
    if dirt:
        return None, f"scratch worktree {path} has uncommitted edits (in-flight work?)"
    return path, ""


def configured_gates(cwd):
    out = run(["git", "config", "--get-all", "stack-gates.cmd"], cwd).stdout
    gates = []
    for ln in out.splitlines():
        if "::" in ln:
            label, cmd = ln.split("::", 1)
            gates.append((label.strip(), cmd.strip()))
    return gates


def resolve(cmd, cwd):
    """Absolute path to a tool: repo-local node_modules first, then PATH (volta etc.)."""
    local = os.path.join(cwd, "node_modules", ".bin", cmd)
    return local if os.path.exists(local) else shutil.which(cmd)


def repo_local(cmd, cwd):
    """Repo-pinned tool only — no PATH fallback. A global build (volta) can be
    version-skewed from the repo's toolchain and reject configs the repo accepts."""
    local = os.path.join(cwd, "node_modules", ".bin", cmd)
    return local if os.path.exists(local) else None


# Files where a behind-origin/main branch is a hard push-block, not just a warning —
# kept in lockstep with the loops-pre-push hook's deploy-critical list (drift here =
# the gate and the hook disagree on what blocks a push).
DEPLOY_CRITICAL = (
    "'k8s/charts/loops/values.staging.yaml' 'k8s/charts/loops/values.production.yaml' "
    "'packages/prisma/migrations/*' 'clickhouse/migrations/*' "
    "'jobs.ts' 'jobs/index.ts' '.env.template'"
)


def default_gates(cwd, branch=""):
    # fresh: reject a branch behind origin/main on a deploy-critical file (with an
    # auto-rebase fix) instead of at the push wall. Runs first — its rebase, when it
    # fires, must land before typecheck/format see the tree.
    # EXEMPT: an additive update to an already-pushed head (origin/<branch> is an
    # ancestor of the tip). That push fast-forwards a published PR — it cannot rebase
    # forward without rewriting shared history, so "contains main's migrations" can
    # never pass and the gate deadlocks the flow (2026-08-19, models/delete-user).
    ff = ""
    if branch:
        q = shlex.quote(f"refs/remotes/origin/{branch}")
        ff = (f'git rev-parse --verify -q {q} >/dev/null 2>&1 '
              f'&& git merge-base --is-ancestor {q} HEAD 2>/dev/null && exit 0; ')
    gates = [("fresh", ff +
              '[ "$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)" -eq 0 ] && exit 0; '
              # three-dot like the hook: main-side changes only, so the branch's own
              # new migrations don't read as "missing" (two-dot red-locked any schema branch)
              f'miss="$(git diff HEAD...origin/main --name-only -- {DEPLOY_CRITICAL})"; '
              '[ -z "$miss" ] && exit 0; '
              'echo "behind origin/main, missing deploy-critical:"; echo "$miss"; exit 1')]
    # Typecheck with the repo-PINNED tsc: since TS7 landed on main (#9866, 2026-08-10)
    # tsc IS the native fast compiler, and on parked pre-TS7 branches the pinned tsc is
    # still the version their configs were written for — slow there, but exact.
    tsc = repo_local("tsc", cwd)
    oxfmt = resolve("oxfmt", cwd)
    # Mirror CI's typecheck surface (lint:typecheck:entries), NOT tsconfig.runtime.json:
    # that config nodenext-checks every file in the repo, which no CI job and no build
    # ever does — it reds on code CI accepts (stripe's cjs typings drop event namespaces,
    # so main's #10157 only compiles under the bundler resolution CI uses; 2026-08-27).
    # next+test = CI's bundler configs; runtime-build = the union of CI's node-entry
    # checks; apps/realtime is CI's remaining standalone entry. CI's `tsc -b packages`
    # is deliberately absent: composite emit through scratch-tree symlinks is the
    # TS2883/poisoned-dts trap seed-gen exists to avoid.
    if os.path.exists(os.path.join(cwd, "typescript/tsconfig.runtime.json")):
        ts_projects = [p for p in ("typescript/tsconfig.next.json",
                                   "typescript/tsconfig.test.json",
                                   "typescript/tsconfig.runtime-build.json",
                                   "apps/realtime/tsconfig.json")
                       if os.path.exists(os.path.join(cwd, p))]
    # tsconfig.node.json predates the #9599 split; parked pre-split branches keep it.
    elif os.path.exists(os.path.join(cwd, "tsconfig.node.json")):
        ts_projects = ["tsconfig.node.json"]
    else:
        ts_projects = []
    # env_repair syncs the generated tRPC types before gates run, but when that couldn't happen
    # (no compiler, rebuild failed) a red here may still be the types, not the code. Say so ON the
    # failure rather than gating separately: a provenance gate would block every push on this
    # machine until the seed is rebuilt, which is not ours to impose.
    seed_gen = os.path.join(os.path.dirname(os.path.abspath(__file__)), "seed-gen")
    why_red = f' || {{ {seed_gen} --check . ; exit 1; }}' if os.path.exists(seed_gen) else ""
    if ts_projects and not tsc:
        gates.append(("typecheck", 'echo "no repo-local tsc (node_modules/.bin/tsc) — run npm install"; exit 1'))
    elif ts_projects:
        gates.append(("typecheck",
                      "{ " + " && ".join(f"{tsc} --project {p} --noEmit" for p in ts_projects)
                      + f" ; }}{why_red}"))
    if oxfmt:
        # merge-base against origin/main, never the local main ref: a stale local main inflates
        # the file set with other branches' files (169 files red for a 3-file branch, 2026-07-30).
        gates.append((
            "format",
            'base=$(git merge-base origin/main HEAD 2>/dev/null || echo main); '
            "git diff --name-only \"$base\" HEAD --diff-filter=ACMR -- '*.ts' '*.tsx' "
            f"| xargs -r {oxfmt} --check",
        ))
    delta_tests = os.path.join(os.path.dirname(os.path.abspath(__file__)), "stack-delta-tests")
    if ts_projects and os.path.exists(delta_tests):
        gates.append(("tests", delta_tests))
    return gates


def gconf(key, cwd):
    return run(["git", "config", "--get", key], cwd).stdout.strip()


def configured_fixes(cwd):
    """Optional per-gate remediation: `stack-gates.fix "<name>::<cmd>"`, mirroring
    stack-gates.cmd. A failing gate with a fix can be auto-remediated under --fix."""
    out = run(["git", "config", "--get-all", "stack-gates.fix"], cwd).stdout
    fixes = {}
    for ln in out.splitlines():
        if "::" in ln:
            name, cmd = ln.split("::", 1)
            fixes[name.strip()] = cmd.strip()
    return fixes


def default_fixes(cwd, branch, borrowed=False):
    """Built-in remediation. The fresh gate rebases the branch onto fresh origin/main —
    but only a root branch (parent main/empty): rebasing a STACKED branch onto main would
    tear it off its parent, so those stay red ("restack the forest from the laptop").
    The format gate: a forest branch is fixed by the whole-forest cascade (stack-fmt —
    formatting only the leaf leaves its drifted ancestors red); a standalone branch folds
    an oxfmt pass into a fresh commit. --no-verify keeps a pre-commit formatter from re-firing."""
    self_dir = os.path.dirname(os.path.abspath(__file__))
    fixes = {}
    parent = (gconf(f"branch.{branch}.stack-parent", cwd) or gconf(f"stack-branch.{branch}.parent", cwd)) if branch else ""
    if parent in ("", "main") and borrowed:
        # Detached scratch: a bare rebase moves only the detached HEAD, and stack-open's
        # post-commit follow-hook force-moves the branch at EVERY replayed commit — so pin
        # the outcome explicitly: branch → rebased tip on success, restored tip on abort.
        fixes["fresh"] = (
            f'old=$(git rev-parse "refs/heads/{branch}") && git fetch origin main -q && '
            f'git rebase origin/main && git branch -f "{branch}" HEAD '
            f'|| {{ git rebase --abort 2>/dev/null; git branch -f "{branch}" "$old"; exit 1; }}'
        )
    elif parent in ("", "main"):
        fixes["fresh"] = ("git fetch origin main -q && git rebase origin/main "
                          "|| { git rebase --abort 2>/dev/null; exit 1; }")
    project = (gconf(f"branch.{branch}.stack-project", cwd) or gconf(f"stack-branch.{branch}.project", cwd)) if branch else ""
    if project and os.path.exists(os.path.join(self_dir, "stack-fmt")):
        fixes["format"] = f"{self_dir}/stack-fmt {project}"
        return fixes
    oxfmt = resolve("oxfmt", cwd)
    if oxfmt:
        fixes["format"] = (
            'base=$(git merge-base origin/main HEAD 2>/dev/null || echo main); '
            "files=$(git diff --name-only \"$base\" HEAD --diff-filter=ACMR -- '*.ts' '*.tsx'); "
            '[ -z "$files" ] && exit 0; '
            f'echo "$files" | xargs {oxfmt} --write; '
            'echo "$files" | xargs git add; '
            'git commit -q -m "style: oxfmt" --no-verify'
        )
    return fixes


def last_lines(text, n=12):
    lines = [ln for ln in text.splitlines() if ln.strip()]
    tail = lines[-n:]
    return "\n".join(tail)


def env_repair(cwd):
    """Deterministic repairs to the tree's generated artifacts (all gitignored) so a gate
    red means the code is wrong, not the environment. Returns (notes, ok): notes only for
    actions actually taken — a healthy tree stays silent."""
    notes = []
    ok = True
    out = run(["git", "worktree", "list", "--porcelain"], cwd).stdout
    main = next((ln[len("worktree "):] for ln in out.splitlines() if ln.startswith("worktree ")), "")
    if not main:
        return notes, ok
    # seed-gen --sync owns every repair (node_modules donor, tree-local packages dist, .gen) —
    # one implementation shared with the pre-push hook, per the drift lesson in its header
    seed_gen = os.path.join(os.path.dirname(os.path.abspath(__file__)), "seed-gen")
    if os.path.exists(seed_gen):
        # donor first (main's .gen + packages dist feed every other tree), then the gated tree
        for tree in dict.fromkeys([main, cwd]):
            label = "" if tree == cwd else "main checkout: "
            try:
                r = subprocess.run([seed_gen, "--sync", tree],
                                   capture_output=True, text=True, timeout=600)
                msg = (r.stdout or "").strip()
                if msg:
                    notes.append(label + msg)
                if r.returncode != 0:
                    ok = False
            except subprocess.TimeoutExpired:
                notes.append(f"{label}types rebuild timed out after 600s")
                ok = False
    return notes, ok


def main():
    branch = ""
    progress_path = ""
    do_fix = False
    positional = []
    unknown = []
    argv = sys.argv[1:]
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--branch" and i + 1 < len(argv):
            branch = argv[i + 1]
            i += 2
        elif a == "--progress" and i + 1 < len(argv):
            progress_path = argv[i + 1]
            i += 2
        elif a == "--fix":
            do_fix = True
            i += 1
        elif a.startswith("-"):
            unknown.append(a)
            i += 1
        else:
            positional.append(a)
            i += 1
    if not branch and len(positional) == 1:
        branch = positional.pop()
    if unknown or positional:
        bad = " ".join(unknown + positional)
        verdict = {"ok": False, "gates": [
            {"name": "usage", "ok": False, "ms": 0,
             "summary": f"unrecognized argument(s): {bad}\n"
                        "usage: stack-gates [<branch> | --branch <b>] [--fix] [--progress <file>]"}]}
        print(json.dumps(verdict))
        return 0

    prog = open(progress_path, "w", buffering=1) if progress_path else None

    def emit(obj):
        if prog:
            prog.write(json.dumps(obj) + "\n")

    cwd = os.getcwd()
    borrowed = False
    if branch:
        wt = worktree_of(branch, cwd)
        if not wt:
            wt, err = scratch_checkout(branch, cwd)
            borrowed = True
            if not wt:
                verdict = {"ok": False, "gates": [
                    {"name": "worktree", "ok": False, "ms": 0,
                     "summary": f"no checkout holds {branch} — {err}"}]}
                emit({"event": "plan", "gates": ["worktree"]})
                emit({"event": "result", **verdict})
                print(json.dumps(verdict))
                return 0
        cwd = wt
    t0 = time.time()
    env_notes, env_ok = env_repair(cwd)
    env_ms = int((time.time() - t0) * 1000)
    gates = configured_gates(cwd) or default_gates(cwd, branch)
    fixes = (configured_fixes(cwd) or default_fixes(cwd, branch, borrowed)) if do_fix else {}

    if not gates:
        verdict = {"ok": True, "gates": [], "note": "no gates configured for this repo"}
        emit({"event": "result", **verdict})
        print(json.dumps(verdict))
        return 0

    plan = (["env"] if env_notes else []) + [name for name, _ in gates]
    emit({"event": "plan", "gates": plan})
    results = []
    all_ok = True
    if env_notes:
        results.append({"name": "env", "ok": env_ok, "ms": env_ms,
                        "summary": "\n".join(env_notes)})
        emit({"event": "done", "gate": "env", "ok": env_ok, "ms": env_ms})
        all_ok = all_ok and env_ok
    for name, cmd in gates:
        t0 = time.time()
        emit({"event": "start", "gate": name, "ts": t0})
        r = run(["bash", "-lc", cmd], cwd)
        ok = r.returncode == 0
        fixed = False
        # A red gate with a registered fix gets one remediation attempt, then a re-check.
        if not ok and name in fixes:
            run(["bash", "-lc", fixes[name]], cwd)
            r = run(["bash", "-lc", cmd], cwd)
            if r.returncode == 0:
                ok = True
                fixed = True
        ms = int((time.time() - t0) * 1000)
        all_ok = all_ok and ok
        summary = "" if ok else last_lines((r.stdout or "") + "\n" + (r.stderr or ""))
        entry = {"name": name, "ok": ok, "ms": ms, "summary": summary}
        if fixed:
            entry["fixed"] = True
        results.append(entry)
        emit({"event": "done", "gate": name, "ok": ok, "ms": ms})

    verdict = {"ok": all_ok, "gates": results}
    emit({"event": "result", **verdict})
    print(json.dumps(verdict))
    return 0 if all_ok else 0   # always exit 0: the JSON carries the verdict; the caller reads ok


if __name__ == "__main__":
    sys.exit(main())
