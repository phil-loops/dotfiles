#!/bin/zsh
# Stack List - print all registered stack-projects in this repo, optionally fzf-pick.
# Usage: loops stack list                 # pretty-print all projects
#        loops stack list <project>       # print dependency tree for one project
#        loops stack list --pick          # fzf-pick, open in stack review
#        loops stack list --pick --echo   # fzf-pick, print chosen name (no open)
#        loops stack list --names         # one name per line (for completion/scripts)
# Any extra args (e.g. --html) after --pick are forwarded to `loops stack review`.

set -e

PICK=0
NAMES_ONLY=0
ECHO_ONLY=0
TARGET=""
FORWARD=()
for arg in "$@"; do
  case "$arg" in
    --pick|-p) PICK=1 ;;
    --names) NAMES_ONLY=1 ;;
    --echo) ECHO_ONLY=1 ;;
    --*) FORWARD+=("$arg") ;;
    *) [[ -z "$TARGET" ]] && TARGET="$arg" || FORWARD+=("$arg") ;;
  esac
done

# Collect projects: name -> array of branches.
typeset -A project_branches
typeset -a project_order

while IFS=' ' read -r key value; do
  [[ -z "$key" ]] && continue
  # key format: stack-project.<name>.branch
  name="${key#stack-project.}"
  name="${name%.branch}"
  if [[ -z "${project_branches[$name]+_}" ]]; then
    project_order+=("$name")
    project_branches[$name]="$value"
  else
    project_branches[$name]+=$'\n'"$value"
  fi
done < <(git config --get-regexp '^stack-project\..*\.branch$' 2>/dev/null || true)

if (( ${#project_order[@]} == 0 )); then
  echo "No stack-projects registered in this repo." >&2
  echo "  (set with: git config --add stack-project.<name>.branch <branch>)" >&2
  exit 1
fi

if (( NAMES_ONLY )); then
  printf '%s\n' "${project_order[@]}"
  exit 0
fi

# Single-project tree view.
if [[ -n "$TARGET" ]]; then
  if [[ -z "${project_branches[$TARGET]+_}" ]]; then
    echo "No stack-project '$TARGET' registered." >&2
    echo "Known: ${project_order[*]}" >&2
    exit 1
  fi
  current_branch=$(git branch --show-current 2>/dev/null)
  typeset -A is_member parent_of
  typeset -a members
  while IFS= read -r b; do
    [[ -z "$b" ]] && continue
    members+=("$b")
    is_member[$b]=1
    p=$(git config "branch.${b}.stack-parent" 2>/dev/null || git config "stack-branch.${b}.parent" 2>/dev/null || true)
    parent_of[$b]="$p"
  done <<<"${project_branches[$TARGET]}"

  # Find roots: members whose parent is not a project member (typically `main`).
  typeset -a roots
  for b in "${members[@]}"; do
    p="${parent_of[$b]}"
    if [[ -z "${is_member[$p]+_}" ]]; then roots+=("$b"); fi
  done

  print_subtree() {
    local b="$1" indent="$2" marker="  "
    [[ "$b" == "$current_branch" ]] && marker="* "
    # children: project members whose parent == b
    local children=()
    for cand in "${members[@]}"; do
      [[ "${parent_of[$cand]}" == "$b" ]] && children+=("$cand")
    done
    printf "%s%s\033[1m%s\033[0m\n" "$indent" "$marker" "$b"
    for c in "${children[@]}"; do
      print_subtree "$c" "  $indent"
    done
  }

  printf '\033[1m%s\033[0m\n' "$TARGET"
  for r in "${roots[@]}"; do
    parent_label="${parent_of[$r]:-?}"
    printf '  \033[2m(on %s)\033[0m\n' "$parent_label"
    print_subtree "$r" "  "
  done
  # Virtual feature node — what main looks like when the whole project ships.
  printf '  \033[2m└─→\033[0m \033[1;36m[%s — integrated]\033[0m \033[2m(virtual)\033[0m\n' "$TARGET"
  exit 0
fi

if (( PICK )); then
  # Build fzf input: one project per line, preview = its branch list.
  chosen=$(
    for name in "${project_order[@]}"; do
      count=$(printf '%s\n' "${project_branches[$name]}" | wc -l | tr -d ' ')
      printf '%s\t%s branch(es)\n' "$name" "$count"
    done | fzf \
      --with-nth=1,2 \
      --delimiter=$'\t' \
      --preview="echo {1} | xargs -I{} git config --get-all stack-project.{}.branch" \
      --preview-window=right:60% \
      --prompt="stack project> " \
      --height=40% \
      --reverse
  ) || exit 130
  name="${chosen%%$'\t'*}"
  if (( ECHO_ONLY )); then
    echo "$name"
    exit 0
  fi
  exec ~/.dotfiles/scripts/stack-review "$name" "${FORWARD[@]}"
fi

# Default: pretty print.
for name in "${project_order[@]}"; do
  printf '\033[1m%s\033[0m\n' "$name"
  while IFS= read -r b; do
    [[ -n "$b" ]] && printf '  %s\n' "$b"
  done <<<"${project_branches[$name]}"
done
