#!/bin/zsh
# helix-tsgo-stamp [dir] — point Helix at tsgo for this worktree, LOCAL-only.
#
# The loops repo commits a shared .helix/languages.toml that pins
# typescript-language-server (tsserver). Teammates need that until TS7 lands, so we
# don't touch the tracked file — instead we transform a copy in THIS worktree and
# `git update-index --skip-worktree` it, so the override never reaches origin. Each
# worktree is stamped independently, so tsgo roots per-branch (correct types), at the
# cost of one ~1.2GB tsgo per concurrently-open editor (no cross-instance LRU).
#
# Also: the shared config formats with `--stdin-filepath %{buffer_name}`, but Helix runs
# the formatter from the file's folder, where that root-relative path points nowhere and
# oxfmt sorts the repo's Tailwind classes as unknown. %{file_path_absolute} fixes it
# (format-helix-buffers-by-absolute-path); once main carries that, this half no-ops.
#
# Idempotent and self-scoping: each half no-ops unless the worktree ships the config it
# overrides, and skips if already stamped.
#
# Fails loud on a config it hasn't seen: the committed file's blob must be one of KNOWN
# (or already carry %{file_path_absolute}, upstream's own fix). Anything else means a
# teammate changed it, so the stamp touches nothing, says so on stderr and in a
# notification, and exits 3 — recheck both halves against the new file, then add its blob.
emulate -L zsh; set -uo pipefail

KNOWN=(
  75d4833f4a1f8192f5e87b308e803eea2101900a   # 112fc96f00 — tsserver, pre-#10330 branches
  7e903265fda07d81418f27d3f3f41e772d16dbc2   # 395746a1dc — #10330, main as of 2026-11-02
)

dir="${1:-$PWD}"
top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || exit 0
cfg="$top/.helix/languages.toml"

[[ -f "$cfg" ]] || exit 0

blob=$(git -C "$top" rev-parse -q --verify HEAD:.helix/languages.toml 2>/dev/null) || exit 0
if (( ! ${KNOWN[(Ie)$blob]} )) && ! git -C "$top" cat-file -p "$blob" | grep -q '%{file_path_absolute}'; then
  msg="helix-tsgo-stamp: loops' .helix/languages.toml changed upstream (blob ${blob:0:10}) — not stamped. Recheck the tsgo + absolute-path overrides, then add the blob to KNOWN in ~/.dotfiles/scripts/helix-tsgo-stamp"
  print -u2 -- "⚠ $msg  [$top]"
  osascript -e "display notification \"${msg//\"/}\" with title \"Helix stamp refused\"" >/dev/null 2>&1 || true
  exit 3
fi

if grep -q '"%{buffer_name}"' "$cfg"; then
  sed -i '' 's/"%{buffer_name}"/"%{file_path_absolute}"/g' "$cfg"
  git -C "$top" update-index --skip-worktree .helix/languages.toml
fi

grep -q 'typescript-language-server' "$cfg" || exit 0   # not the config we override
grep -q 'language-server.tsgo' "$cfg" && exit 0         # already stamped

cat >> "$cfg" <<'TSGO'

[language-server.tsgo]
command = "tsgo"
args = ["--lsp", "--stdio"]
TSGO

# swap the TS language server, and restore the user's deliberate no-surprise-format
sed -i '' \
  -e 's/"typescript-language-server"/"tsgo"/g' \
  -e 's/auto-format = true/auto-format = false/g' \
  "$cfg"

git -C "$top" update-index --skip-worktree .helix/languages.toml
