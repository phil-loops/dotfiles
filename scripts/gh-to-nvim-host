#!/usr/bin/env python3
"""gh-to-nvim-host — Chrome native-messaging host for the GitHub→nvim extension.

The extension popup's "Launch viewer" button can't run a shell command (MV3
sandbox), so Chrome spawns THIS on demand via native messaging and we start the
forest viewer for it. Speaks Chrome's stdio protocol: a 4-byte little-endian
length prefix, then that many bytes of UTF-8 JSON, both directions.

Message in:  {"action": "launch", "repo": "<abs path>"?}   (repo defaults to ~/coding/loops)
Message out: {"ok": bool, "started": bool, "err": str?}

`stack-review-serve` is idempotent (a live server on the repo's port is reused),
so a launch while already-up is a harmless no-op.
"""
import json
import os
import struct
import subprocess
import sys

DEFAULT_REPO = os.path.expanduser("~/coding/loops")
SERVE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "stack-review-serve")


def read_message():
    raw_len = sys.stdin.buffer.read(4)
    if len(raw_len) < 4:
        return None
    (n,) = struct.unpack("=I", raw_len)
    return json.loads(sys.stdin.buffer.read(n).decode("utf-8"))


def send_message(obj):
    data = json.dumps(obj).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("=I", len(data)))
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()


def launch(repo):
    if not os.path.isdir(repo):
        return {"ok": False, "started": False, "err": f"no such repo: {repo}"}
    if not os.path.exists(SERVE):
        return {"ok": False, "started": False, "err": f"missing {SERVE}"}
    # Detach fully: the host process exits as soon as it replies, and Chrome would
    # otherwise reap the child. start_new_session + closed stdio = survives our exit.
    subprocess.Popen(
        [SERVE],
        cwd=repo,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return {"ok": True, "started": True}


def main():
    msg = read_message()
    if not msg:
        return
    if msg.get("action") == "launch":
        send_message(launch(msg.get("repo") or DEFAULT_REPO))
    else:
        send_message({"ok": False, "err": f"unknown action: {msg.get('action')}"})


if __name__ == "__main__":
    main()
