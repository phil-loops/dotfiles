#!/usr/bin/env python3
"""worktree-hygiene — put every non-main loops worktree back in its intended shape: node_modules
is a SYMLINK to the main checkout (what stack-open installs on every open — gates, seed-gen,
tsc and the editor LSP all work through it), and .next is a cache that may go once idle. A
REAL node_modules clone belongs to exactly one thing: a running loops-preview (Turbopack
refuses out-of-root symlinks), and loops-preview re-clones one from its pool when it finds a
symlink. So a real clone with no live process inside is wrong state, not a cache — it gets
relinked regardless of age; .next keeps an idle window.

  worktree-hygiene                 dry run: list what would change and why the rest is kept
  worktree-hygiene --apply         do it, appending one JSON line per tree to the log
  worktree-hygiene --days N        idle window for .next (default 2)

In use means any process has its cwd inside the tree (a preview server, a Claude session, an
editor shell). Idle for .next means the newest of: the directory's mtime, its .git gitfile,
and every file git status reports as changed. Review scratch under /private/tmp/stack-study
belongs to stack-open's own ladder and is skipped, as are the main checkout and dot-prefixed
tooling trees.

Log: ~/.cache/worktree-hygiene/log.jsonl (one line per tree) + last.json (the last run's
summary, which the viewer's Machine page reads).
"""
import json
import os
import subprocess
import sys
import time

REPO = os.path.expanduser("~/coding/loops")
CACHE = os.path.expanduser("~/.cache/worktree-hygiene")
FAT = ("node_modules", ".next")


def git(args, cwd=REPO):
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True).stdout


def worktrees():
    paths = []
    for ln in git(["worktree", "list", "--porcelain"]).splitlines():
        if ln.startswith("worktree "):
            paths.append(ln[9:])
    main = paths[0] if paths else None
    return main, paths[1:]


def cwds_in_use():
    out = subprocess.run(["/usr/sbin/lsof", "-Fn", "-d", "cwd"], capture_output=True, text=True).stdout
    return {ln[1:] for ln in out.splitlines() if ln.startswith("n/")}


def newest_touch(path):
    latest = os.stat(path).st_mtime
    gitfile = os.path.join(path, ".git")
    if os.path.exists(gitfile):
        latest = max(latest, os.stat(gitfile).st_mtime)
    for rec in git(["status", "--porcelain", "-z", "--untracked-files=normal"], cwd=path).split("\0"):
        if len(rec) > 3:
            f = os.path.join(path, rec[3:])
            try:
                latest = max(latest, os.stat(f).st_mtime)
            except OSError:
                pass
    return latest


def apparent_mb(path):
    out = subprocess.run(["du", "-sk", path], capture_output=True, text=True).stdout.split()
    return int(out[0]) // 1024 if out and out[0].isdigit() else 0


def main():
    apply = "--apply" in sys.argv
    days = 2
    if "--days" in sys.argv:
        days = int(sys.argv[sys.argv.index("--days") + 1])
    main_wt, trees = worktrees()
    main_nm = os.path.join(main_wt, "node_modules")
    if not os.path.isdir(main_nm) or os.path.islink(main_nm):
        print(f"main checkout {main_wt} has no real node_modules — nothing to link to; refusing", file=sys.stderr)
        sys.exit(1)
    busy = cwds_in_use()
    now = time.time()
    acted, kept = [], []
    for wt in trees:
        name = os.path.basename(wt)
        if "/stack-study/" in wt or name.startswith(".") or wt == main_wt:
            continue
        nm = os.path.join(wt, "node_modules")
        nxt = os.path.join(wt, ".next")
        real_nm = os.path.isdir(nm) and not os.path.islink(nm)
        has_next = os.path.isdir(nxt)
        if not real_nm and not has_next:
            continue
        if any(c == wt or c.startswith(wt + "/") for c in busy):
            kept.append((name, "in use"))
            continue
        removed, freed = [], 0
        if real_nm:
            freed += apparent_mb(nm)
            removed.append("node_modules→symlink")
        if has_next:
            idle = (now - newest_touch(wt)) / 86400
            if idle >= days:
                freed += apparent_mb(nxt)
                removed.append(".next")
            elif not real_nm:
                kept.append((name, f".next kept, touched {idle:.1f}d ago"))
                continue
        if apply:
            if real_nm:
                subprocess.run(["rm", "-rf", nm])
                os.symlink(main_nm, nm)
            if ".next" in removed:
                subprocess.run(["rm", "-rf", nxt])
        acted.append({"at": now, "worktree": wt, "removed": removed, "apparentMb": freed})
    os.makedirs(CACHE, exist_ok=True)
    if apply:
        with open(os.path.join(CACHE, "log.jsonl"), "a") as fh:
            for a in acted:
                fh.write(json.dumps(a) + "\n")
        with open(os.path.join(CACHE, "last.json"), "w") as fh:
            json.dump({"at": now, "days": days, "stripped": len(acted),
                       "apparentMb": sum(a["apparentMb"] for a in acted), "kept": len(kept)}, fh)
    verb = "relinked" if apply else "would relink"
    for a in acted:
        print(f"{verb} {os.path.basename(a['worktree'])}: {' + '.join(a['removed'])} ({a['apparentMb']} MB apparent)")
    for name, why in kept:
        print(f"kept {name}: {why}")
    print(f"{verb} {len(acted)} tree(s), {sum(a['apparentMb'] for a in acted)} MB apparent; kept {len(kept)}")


if __name__ == "__main__":
    main()
