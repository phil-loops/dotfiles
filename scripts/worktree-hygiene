#!/usr/bin/env python3
"""worktree-hygiene — put every non-main loops worktree back in its intended shape: node_modules
is a SYMLINK to the main checkout (what stack-open installs on every open — gates, seed-gen,
tsc and the editor LSP all work through it), and .next is a cache that may go once idle. A
REAL node_modules clone belongs to exactly one thing: a running loops-preview (Turbopack
refuses out-of-root symlinks), and loops-preview re-clones one from its pool when it finds a
symlink. So a real clone with no live process inside is wrong state, not a cache — it gets
relinked regardless of age; .next keeps an idle window.

  worktree-hygiene                 dry run: list what would change and why the rest is kept
  worktree-hygiene --apply         do it, appending one JSON line per tree to the log
  worktree-hygiene --days N        idle window for .next (default 2)
  worktree-hygiene --retire-days N idle window before a worktree is retired (default 3)

A worktree idle past the retire window is removed outright: a checkout is disposable, the work
lives in git. Nothing is lost on the way out. A dirty tree is committed onto a new
parked/<name> branch first; a detached HEAD no ref holds gets a parked/<name> branch. Bring
either back with `git worktree add ~/coding/<name> parked/<name>`. Idle for retiring means the
newest of the .next signals plus the HEAD file and the last commit. The index and reflog are
left out because canopy's status sweeps and restacks touch every tree's.

Three shapes count as fine, not just the symlink: see nm_state — seed-gen's exploded
per-entry-symlink view is deliberate (Turbopack refuses a node_modules that links out of the
project root) and nearly free, so only a REAL clone with no live process is reclaimed.

In use means any process has its cwd inside the tree (a preview server, a Claude session, an
editor shell). Idle for .next means the newest of: the directory's mtime, its .git gitfile,
and every file git status reports as changed. Review scratch under ~/Library/Caches/stack-study
belongs to stack-open's own ladder and is skipped, as are the main checkout and dot-prefixed
tooling trees.

Log: ~/.cache/worktree-hygiene/log.jsonl (one line per tree) + last.json (the last run's
summary, which the viewer's Machine page reads).
"""
import json
import os
import subprocess
import sys
import time

REPO = os.path.expanduser("~/coding/loops")
CACHE = os.path.expanduser("~/.cache/worktree-hygiene")
FAT = ("node_modules", ".next")


def git(args, cwd=REPO):
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True).stdout


def worktrees():
    paths = []
    for ln in git(["worktree", "list", "--porcelain"]).splitlines():
        if ln.startswith("worktree "):
            paths.append(ln[9:])
    main = paths[0] if paths else None
    return main, paths[1:]


def cwds_in_use():
    out = subprocess.run(["/usr/sbin/lsof", "-Fn", "-d", "cwd"], capture_output=True, text=True).stdout
    return {ln[1:] for ln in out.splitlines() if ln.startswith("n/")}


def newest_touch(path):
    latest = os.stat(path).st_mtime
    gitfile = os.path.join(path, ".git")
    if os.path.exists(gitfile):
        latest = max(latest, os.stat(gitfile).st_mtime)
    for rec in git(["status", "--porcelain", "-z", "--untracked-files=normal"], cwd=path).split("\0"):
        if len(rec) > 3:
            f = os.path.join(path, rec[3:])
            try:
                latest = max(latest, os.stat(f).st_mtime)
            except OSError:
                pass
    return latest


def last_activity(path):
    latest = newest_touch(path)
    gitdir = git(["rev-parse", "--absolute-git-dir"], cwd=path).strip()
    head = os.path.join(gitdir, "HEAD")
    if os.path.exists(head):
        latest = max(latest, os.stat(head).st_mtime)
    committed = git(["log", "-1", "--format=%ct"], cwd=path).strip()
    if committed.isdigit():
        latest = max(latest, int(committed))
    return latest


def unused_branch(base):
    name, n = base, 1
    while git(["rev-parse", "--verify", "-q", f"refs/heads/{name}"]).strip():
        n += 1
        name = f"{base}-{n}"
    return name


def retire(wt, apply):
    """Remove an idle worktree, parking anything no branch holds. Returns how it was retired."""
    name = os.path.basename(wt)
    branch = git(["symbolic-ref", "-q", "--short", "HEAD"], cwd=wt).strip()
    head = git(["rev-parse", "HEAD"], cwd=wt).strip()
    dirty = git(["status", "--porcelain", "--untracked-files=normal"], cwd=wt).strip()
    held = branch or git(["for-each-ref", "--contains", head, "--count=1", "refs/heads", "refs/remotes"]).strip()
    parked = None
    if dirty or not held:
        parked = unused_branch(f"parked/{name}")
    if apply:
        if dirty:
            git(["switch", "-q", "-c", parked], cwd=wt)
            git(["add", "-A"], cwd=wt)
            was = branch or f"detached {head[:10]}"
            git(["-c", "core.hooksPath=/dev/null", "commit", "-q", "--no-verify",
                 "-m", f"wip: parked {name} (was {was})"], cwd=wt)
            if git(["status", "--porcelain"], cwd=wt).strip():
                return None
        elif parked:
            git(["branch", parked, head])
        subprocess.run(["git", "worktree", "remove", "--force", wt], cwd=REPO, capture_output=True)
        if os.path.exists(wt):
            return None
    if dirty:
        return f"parked changes on {parked}"
    if parked:
        return f"parked detached HEAD on {parked}"
    return f"removed ({branch or 'detached, held by a ref'})"


def nm_state(path):
    """Which of the three node_modules shapes this is — the discriminator hygiene turned out to
    need. seed-gen builds an EXPLODED view (a directory of per-entry symlinks into the donor)
    because Turbopack refuses a node_modules that symlinks out of the project root, and that view
    costs almost nothing. Treating it as "a real directory, so wrong state" made this script and
    seed-gen fight: relink, re-explode, relink (4 trees twice on 2026-09-10). Measured: exploded
    = 580 of 662 entries are symlinks, 186 MB; a real clone = 0 symlinks, ~3.5 GB.

      "link"     — one symlink to the donor: what stack-open installs. Nothing to do.
      "exploded" — a directory of per-entry symlinks: seed-gen's, deliberate. Nothing to do.
      "real"     — actual packages on disk: only a running preview needs this.
      "absent"   — no node_modules at all.
    """
    if os.path.islink(path):
        return "link"
    if not os.path.isdir(path):
        return "absent"
    try:
        entries = os.listdir(path)
    except OSError:
        return "absent"
    if not entries:
        return "absent"
    links = sum(1 for e in entries if os.path.islink(os.path.join(path, e)))
    return "exploded" if links * 2 > len(entries) else "real"


def apparent_mb(path):
    out = subprocess.run(["du", "-sk", path], capture_output=True, text=True).stdout.split()
    return int(out[0]) // 1024 if out and out[0].isdigit() else 0


def main():
    apply = "--apply" in sys.argv
    days = 2
    if "--days" in sys.argv:
        days = int(sys.argv[sys.argv.index("--days") + 1])
    retire_days = 3
    if "--retire-days" in sys.argv:
        retire_days = int(sys.argv[sys.argv.index("--retire-days") + 1])
    main_wt, trees = worktrees()
    main_nm = os.path.join(main_wt, "node_modules")
    if not os.path.isdir(main_nm) or os.path.islink(main_nm):
        print(f"main checkout {main_wt} has no real node_modules — nothing to link to; refusing", file=sys.stderr)
        sys.exit(1)
    donor = git(["config", "--get", "stack.donor"]).strip()
    busy = cwds_in_use()
    now = time.time()
    acted, kept, retired = [], [], []
    for wt in trees:
        name = os.path.basename(wt)
        if "/stack-study/" in wt or name.startswith(".") or wt in (main_wt, donor):
            continue
        if not os.path.isdir(wt):
            continue
        in_use = any(c == wt or c.startswith(wt + "/") for c in busy)
        if not in_use and (now - last_activity(wt)) / 86400 >= retire_days:
            how = retire(wt, apply)
            if how:
                retired.append({"at": now, "worktree": wt, "retired": how})
                continue
            kept.append((name, "retire failed; left in place"))
        nm = os.path.join(wt, "node_modules")
        nxt = os.path.join(wt, ".next")
        real_nm = nm_state(nm) == "real"
        has_next = os.path.isdir(nxt)
        if not real_nm and not has_next:
            continue
        if any(c == wt or c.startswith(wt + "/") for c in busy):
            kept.append((name, "in use"))
            continue
        removed, freed = [], 0
        if real_nm:
            freed += apparent_mb(nm)
            removed.append("node_modules→symlink")
        if has_next:
            idle = (now - newest_touch(wt)) / 86400
            if idle >= days:
                freed += apparent_mb(nxt)
                removed.append(".next")
            elif not real_nm:
                kept.append((name, f".next kept, touched {idle:.1f}d ago"))
                continue
        if apply:
            if real_nm:
                subprocess.run(["rm", "-rf", nm])
                os.symlink(main_nm, nm)
            if ".next" in removed:
                subprocess.run(["rm", "-rf", nxt])
        acted.append({"at": now, "worktree": wt, "removed": removed, "apparentMb": freed})
    os.makedirs(CACHE, exist_ok=True)
    if apply:
        with open(os.path.join(CACHE, "log.jsonl"), "a") as fh:
            for a in acted + retired:
                fh.write(json.dumps(a) + "\n")
        subprocess.run(["git", "worktree", "prune"], cwd=REPO, capture_output=True)
        with open(os.path.join(CACHE, "last.json"), "w") as fh:
            json.dump({"at": now, "days": days, "retireDays": retire_days, "retired": len(retired),
                       "stripped": len(acted),
                       "apparentMb": sum(a["apparentMb"] for a in acted), "kept": len(kept)}, fh)
    for r in retired:
        print(f"{'retired' if apply else 'would retire'} {os.path.basename(r['worktree'])}: {r['retired']}")
    verb = "relinked" if apply else "would relink"
    for a in acted:
        print(f"{verb} {os.path.basename(a['worktree'])}: {' + '.join(a['removed'])} ({a['apparentMb']} MB apparent)")
    for name, why in kept:
        print(f"kept {name}: {why}")
    print(f"{verb} {len(acted)} tree(s), {sum(a['apparentMb'] for a in acted)} MB apparent; "
          f"{'retired' if apply else 'would retire'} {len(retired)}; kept {len(kept)}")


if __name__ == "__main__":
    main()
