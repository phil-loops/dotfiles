#!/usr/bin/env node
// loo-6235-repro — a one-button page that replays the LOO-6235 API requests against
// staging with a disabled-domain team's key, and keeps each run so before/after a deploy
// sit side by side. Serves http://127.0.0.1:7235 (shown in Show through a deck `url` section).
//
// The key is read from the macOS Keychain on every run and never reaches the page:
//   security add-generic-password -s loops-staging-disabled-domain-key -a loops -w
import { execFileSync } from "node:child_process";
import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { createServer } from "node:http";
import { homedir } from "node:os";
import { join } from "node:path";

const PORT = Number(process.env.REPRO_PORT ?? 7235);
const BASE = process.env.REPRO_BASE ?? "https://app.l3s.email/api/v1";
const KEY_SERVICE = "loops-staging-disabled-domain-key";
const SEND_TO = process.env.REPRO_SEND_TO ?? "loo-6235-repro@example.com";
const STATE_DIR = process.env.REPRO_STATE ?? join(homedir(), ".cache", "loo-6235-repro");
const RUNS_FILE = join(STATE_DIR, "runs.json");

const NO_DOMAIN = { status: 400, text: "no sending domain configured", match: "No sending domain" };
const NOT_VERIFIED = { text: "domain is not verified", match: "not verified" };
const DISABLED = { text: "domain has been disabled", match: "has been disabled" };
const STEPS = [
  { id: "campaign", pr: 1, label: "Create a campaign", before: NO_DOMAIN, after: { status: 201, text: "created" } },
  { id: "transactional", pr: 1, label: "Create a transactional email", before: NO_DOMAIN, after: { status: 201, text: "created" } },
  { id: "draft", pr: 1, label: "Create a transactional draft", before: NO_DOMAIN, after: { status: 200, text: "ok" } },
  { id: "read", pr: 1, label: "Read an email message", before: NO_DOMAIN, after: { status: 200, text: "ok" } },
  { id: "update", pr: 1, label: "Update an email message", before: NO_DOMAIN, after: { status: 200, text: "ok" } },
  { id: "publish", pr: 2, label: "Publish a transactional", before: { status: 422, ...NOT_VERIFIED }, after: { status: 422, ...DISABLED } },
  { id: "send", pr: 2, label: "Send a transactional", before: { status: 400, ...NOT_VERIFIED }, after: { status: 400, ...DISABLED } },
];

function readKey() {
  if (process.env.REPRO_KEY) {
    return process.env.REPRO_KEY;
  }
  try {
    return execFileSync("security", ["find-generic-password", "-s", KEY_SERVICE, "-w"], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
  } catch {
    return null;
  }
}

function loadRuns() {
  try {
    return JSON.parse(readFileSync(RUNS_FILE, "utf8"));
  } catch {
    return [];
  }
}

function saveRuns(runs) {
  mkdirSync(STATE_DIR, { recursive: true });
  writeFileSync(RUNS_FILE, JSON.stringify(runs.slice(-8), null, 2));
}

class Stopped extends Error {}

// The run in flight, if any. In "step" mode every request waits here until the page says
// send, skip, rest (send this and all that follow) or stop.
let active = null;

function gate(planned) {
  if (active.mode === "auto") {
    return Promise.resolve("send");
  }
  return new Promise((resolve) => {
    active.pending = { ...planned, resolve };
  });
}

// Every request a run fires goes through here and lands in its audit trail, key redacted.
async function call(key, method, path, body) {
  const planned = { method, url: BASE + path, requestBody: body ?? null, readOnly: method === "GET" };
  const answer = await gate(planned);
  active.pending = null;
  if (answer === "stop") {
    throw new Stopped();
  }
  if (answer === "rest") {
    active.mode = "auto";
  }
  if (answer === "skip") {
    active.run.trail.push({ at: new Date().toISOString(), method, url: BASE + path, requestBody: body ?? null, skipped: true, status: null, ms: 0 });
    return { status: null, json: null, message: "skipped: you skipped it", ms: 0 };
  }
  const started = Date.now();
  const entry = {
    at: new Date(started).toISOString(),
    method,
    url: BASE + path,
    requestHeaders: {
      Authorization: "Bearer ••••" + key.slice(-4),
      ...(body ? { "Content-Type": "application/json" } : {}),
    },
    requestBody: body ?? null,
  };
  active.run.trail.push(entry);
  try {
    const res = await fetch(BASE + path, {
      method,
      headers: {
        Authorization: `Bearer ${key}`,
        ...(body ? { "Content-Type": "application/json" } : {}),
      },
      body: body ? JSON.stringify(body) : undefined,
      signal: AbortSignal.timeout(20000),
    });
    const text = await res.text();
    let json = null;
    try {
      json = JSON.parse(text);
    } catch {}
    const ms = Date.now() - started;
    Object.assign(entry, {
      status: res.status,
      ms,
      responseHeaders: Object.fromEntries(
        ["content-type", "x-request-id", "x-ratelimit-remaining"].flatMap((h) =>
          res.headers.get(h) ? [[h, res.headers.get(h)]] : []
        )
      ),
      responseBody: json ?? text.slice(0, 20000),
    });
    return { status: res.status, json, message: json?.message ?? (json ? "" : text.slice(0, 200)), ms };
  } catch (error) {
    const ms = Date.now() - started;
    Object.assign(entry, { status: 0, ms, responseBody: `request failed: ${error.message}` });
    return { status: 0, json: null, message: `request failed: ${error.message}`, ms };
  }
}

const shown = (request, r) =>
  r.status === null ? { request, status: null, message: r.message, ms: 0 } : { request, status: r.status, message: r.message, ms: r.ms };
const skipped = (request, why) => ({ request, status: null, message: `skipped: ${why}`, ms: 0 });

async function run(key) {
  const { results } = active.run;
  const name = `LOO-6235 repro ${active.run.at.slice(0, 16).replace("T", " ")}`;

  const who = await call(key, "GET", "/api-key");
  active.run.team = who.json?.teamName ?? (who.status === null ? "team not checked" : `unknown (${who.status} ${who.message})`);

  results.campaign = shown("POST /campaigns", await call(key, "POST", "/campaigns", { name }));

  const created = await call(key, "POST", "/transactional-emails", { name });
  results.transactional = shown("POST /transactional-emails", created);

  const list = await call(key, "GET", "/transactional-emails?perPage=20");
  const own = (list.json?.data ?? []).filter((t) => !t.systemEmailType);
  const fresh = created.status === 201 ? created.json : null;
  const target = fresh ?? own[0] ?? (list.json?.data ?? [])[0];

  if (!target) {
    for (const id of ["draft", "read", "update"]) {
      results[id] = skipped("", "the team has no transactional email yet; make one in the staging app");
    }
  } else {
    const draft = await call(key, "POST", `/transactional-emails/${target.id}/draft`);
    results.draft = shown("POST /transactional-emails/{id}/draft", draft);

    const messageId = draft.json?.draftEmailMessageId ?? target.draftEmailMessageId ?? target.publishedEmailMessageId;
    if (!messageId) {
      results.read = skipped("GET /email-messages/{id}", "the transactional has no email message");
      results.update = skipped("POST /email-messages/{id}", "the transactional has no email message");
    } else {
      const read = await call(key, "GET", `/email-messages/${messageId}`);
      results.read = shown("GET /email-messages/{id}", read);
      const update = await call(key, "POST", `/email-messages/${messageId}`, {
        ...(read.json?.contentRevisionId ? { expectedRevisionId: read.json.contentRevisionId } : {}),
        subject: name,
      });
      results.update = shown("POST /email-messages/{id}", update);
    }
  }

  const drafted = fresh ?? own.find((t) => t.draftEmailMessageId);
  results.publish = drafted
    ? shown("POST /transactional-emails/{id}/publish", await call(key, "POST", `/transactional-emails/${drafted.id}/publish`))
    : skipped("POST /transactional-emails/{id}/publish", "needs a non-system transactional email with an unpublished draft on this team");

  const published = own.find((t) => t.publishedEmailMessageId);
  results.send = published
    ? shown("POST /transactional", await call(key, "POST", "/transactional", { transactionalId: published.id, email: SEND_TO }))
    : skipped("POST /transactional", "needs a published, non-system transactional email on this team");
}

async function startRun(key, mode) {
  active = { mode, pending: null, run: { at: new Date().toISOString(), team: "", mode, results: {}, trail: [], inProgress: true } };
  try {
    await run(key);
  } catch (error) {
    if (!(error instanceof Stopped)) {
      active.run.error = error.message;
    }
    active.run.stopped = true;
  }
  delete active.run.inProgress;
  const runs = loadRuns();
  runs.push(active.run);
  saveRuns(runs);
  active = null;
}

