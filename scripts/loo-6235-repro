<script>
const STEPS = __STEPS__;
const $ = (id) => document.getElementById(id);
const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
const clock = (at) => new Date(at).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
const matches = (r, e) => r.status === e.status && (!e.match || (r.message ?? "").includes(e.match));
const kindOf = (step, r) => !r || r.status === null ? "skipped" : matches(r, step.after) ? "fixed" : matches(r, step.before) ? "still" : "odd";
let busy = false, last = "", shownRun = null, openReqs = new Set();

function verdict(run) {
  if (run?.inProgress) return ["", "Run in progress.", (run.trail ?? []).filter((t) => !t.skipped).length + " requests sent so far. Nothing else is sent until you say so."];
  if (!run) return ["", "Nothing run yet.", "Seven API requests that a team with a disabled sending domain gets wrong answers to. Run them now, deploy, then run them again and compare."];
  const kinds = STEPS.map((s) => ({ pr: s.pr, kind: kindOf(s, run.results[s.id]) }));
  const ran = kinds.filter((k) => k.kind !== "skipped");
  const count = (pr, kind) => kinds.filter((k) => (!pr || k.pr === pr) && k.kind === kind).length;
  const fixed = count(0, "fixed"), odd = count(0, "odd"), skipped = count(0, "skipped");
  const tail = (skipped ? skipped + " could not run; the table says why. " : "") + (odd ? odd + " answered something neither expected; read the trail below." : "");
  if (ran.length && fixed === ran.length) return ["fixed", "All " + fixed + " requests are fixed.", tail || "Staging now answers every request the way the two branches intend."];
  if (!fixed) return ["still", "Nothing has changed yet.", tail || "Staging still answers the way the ticket describes. Deploy, then run the requests again."];
  if (count(1, "fixed") && !count(1, "still") && !count(2, "fixed")) return ["", "Drafting works again. Send and publish still say “not verified”.", tail || "That is the first branch deployed without the second."];
  return ["", fixed + " of " + ran.length + " requests are fixed.", tail || "The table shows which ones still answer the old way."];
}

function cell(step, r, latest) {
  const kind = kindOf(step, r);
  if (!r) return '<td class="none"></td>';
  if (kind === "skipped") return '<td class="none">' + esc(r.message.replace(/^skipped: /, "Not run: ")) + "</td>";
  const word = { fixed: "fixed", still: "same as today", odd: "unexpected" }[kind];
  return '<td class="got ' + kind + (latest ? " latest" : "") + '"><b>' + (r.status || "failed") + "</b>" + word +
    (kind === "odd" ? '<span class="why">' + esc(r.message) + "</span>" : "") + "</td>";
}

function render(state) {
  const runs = state.runs, latest = runs[runs.length - 1];
  $("setup").hidden = state.hasKey;
  const live = Boolean(latest?.inProgress);
  $("starters").hidden = live;
  $("run").disabled = $("step").disabled = busy || !state.hasKey;
  renderNext(state);
  $("team").textContent = latest ? "Key belongs to " + latest.team : "";
  const [tone, head, lede] = verdict(latest);
  $("verdict").className = tone; $("verdict").textContent = head; $("lede").textContent = lede;

  $("groups").innerHTML = state.branches.map((b) => {
    const rows = STEPS.filter((s) => s.pr === b.pr).map((s) => {
      const line = runs.map((r) => r.results[s.id]?.request).find(Boolean) ?? "";
      return '<tr><td class="what">' + esc(s.label) + '<span class="line">' + esc(line) + "</span></td>" +
        '<td class="expect"><b>' + s.before.status + "</b>" + esc(s.before.text) + "</td>" +
        '<td class="expect"><b>' + s.after.status + "</b>" + esc(s.after.text) + "</td>" +
        (runs.length ? runs.map((r, i) => cell(s, r.results[s.id], i === runs.length - 1)).join("") : '<td class="none">not run yet</td>') + "</tr>";
    }).join("");
    return "<section><h2>" + esc(b.title) + '</h2><p class="branch">Fixed by <a href="' + esc(b.href) + '">' + esc(b.name) + "</a>" +
      (b.tip ? ", now at " + esc(b.tip) : ", which is no longer a local branch") + '</p><div class="scroll"><table><tr><th>Request</th><th>Answers today</th><th>Should answer</th>' +
      (runs.length ? runs.map((r, i) => "<th>Run " + (i + 1) + "<small>" + esc(clock(r.at)) + "</small></th>").join("") : "<th>Runs</th>") +
      "</tr>" + rows + "</table></div></section>";
  }).join("");

  if (!runs.some((r) => r.at === shownRun)) shownRun = latest?.at ?? null;
  renderTrail(runs);
}

function renderNext(state) {
  const n = state.pending, box = $("next");
  box.hidden = !state.runs[state.runs.length - 1]?.inProgress;
  if (box.hidden) return;
  if (!n) { box.innerHTML = '<div class="ask"><p>Waiting for the answer…</p></div>'; return; }
  box.innerHTML = '<div class="ask"><p>Next request<small>' + (n.readOnly ? "reads only, changes nothing on staging" : "writes to staging if it succeeds") + "</small></p><pre>" +
    esc(n.method) + " " + esc(n.url) + (n.requestBody ? "\\n\\n" + pretty(n.requestBody) : "") + "</pre></div>" +
    '<div class="acts"><button class="run" data-do="send">Send this request</button><button class="quiet" data-do="skip">Skip it</button>' +
    '<span class="gap"></span><button class="quiet" data-do="rest">Send this and the rest</button><button class="quiet" data-do="stop">Stop the run</button></div>';
  box.querySelector("button")?.focus();
}
$("next").onclick = async (e) => {
  const act = e.target.dataset?.do; if (!act || busy) return;
  busy = true; $("next").querySelectorAll("button").forEach((b) => (b.disabled = true));
  try { const text = await (await fetch("/next?do=" + act, { method: "POST" })).text(); last = text; busy = false; render(JSON.parse(text)); }
  catch (err) { busy = false; $("note").textContent = "That failed: " + err.message; }
};
const pretty = (v) => esc(v == null ? "(none)" : typeof v === "string" ? v : JSON.stringify(v, null, 2));
function renderTrail(runs) {
  $("tabs").innerHTML = runs.map((r, i) => '<button data-at="' + esc(r.at) + '" aria-pressed="' + (r.at === shownRun) + '">Run ' + (i + 1) + ", " + esc(clock(r.at)) + (r.inProgress ? ", in progress" : r.stopped ? ", stopped early" : "") + "</button>").join("");
  const run = runs.find((r) => r.at === shownRun);
  if (!run) { $("trail").innerHTML = '<p class="hint">After a run, each request it sent is listed here with its full response.</p>'; return; }
  $("trail").innerHTML = '<ol class="trail">' + (run.trail ?? []).map((t, j) => {
    if (t.skipped) return '<li class="skip"><details><summary><span class="st">skip</span><span class="u">' + esc(t.method) + " " + esc(t.url) + '</span><span class="t">you skipped it</span></summary></details></li>';
    const k = run.at + ":" + j, ok = t.status >= 200 && t.status < 300;
    return '<li class="' + (ok ? "ok" : "no") + '"><details data-k="' + k + '"' + (openReqs.has(k) ? " open" : "") + ">" +
      '<summary><span class="st">' + (t.status || "failed") + '</span><span class="u">' + esc(t.method) + " " + esc(t.url) + '</span><span class="t">' + t.ms + " ms</span></summary>" +
      '<div class="exchange"><div><h3>Sent at ' + esc(new Date(t.at).toLocaleTimeString()) + "</h3><pre>" + esc(t.method) + " " + esc(t.url) + "\\n" +
      Object.entries(t.requestHeaders ?? {}).map(([h, v]) => esc(h) + ": " + esc(v)).join("\\n") + "</pre><h3>Body</h3><pre>" + pretty(t.requestBody) + "</pre></div>" +
      "<div><h3>Answered " + (t.status || "nothing") + " in " + t.ms + " ms</h3><pre>" +
      Object.entries(t.responseHeaders ?? {}).map(([h, v]) => esc(h) + ": " + esc(v)).join("\\n") + "</pre><h3>Body</h3><pre>" + pretty(t.responseBody) + "</pre></div></div></details></li>";
  }).join("") + "</ol>";
}

$("tabs").onclick = (e) => { const at = e.target.dataset?.at; if (at) { shownRun = at; renderTrail(JSON.parse(last).runs); } };
$("trail").addEventListener("toggle", (e) => { const k = e.target.dataset?.k; if (k) e.target.open ? openReqs.add(k) : openReqs.delete(k); }, true);

async function load() {
  if (busy) return;
  const text = await (await fetch("/state")).text();
  if (text !== last) { last = text; render(JSON.parse(text)); }
}
async function start(mode) {
  busy = true; $("run").disabled = $("step").disabled = true; $("note").textContent = mode === "auto" ? "Running the requests…" : "";
  const started = Date.now();
  try {
    const text = await (await fetch("/run?mode=" + mode, { method: "POST" })).text();
    const state = JSON.parse(text);
    busy = false; last = text; shownRun = null;
    $("note").textContent = state.error ?? (mode === "auto" ? "Ran " + (state.runs[state.runs.length - 1]?.trail?.length ?? 0) + " requests in " + ((Date.now() - started) / 1000).toFixed(1) + " s" : "");
    render(state);
  } catch (e) { busy = false; $("note").textContent = "The run failed: " + e.message; $("run").disabled = $("step").disabled = false; }
}
$("run").onclick = () => start("auto");
$("step").onclick = () => start("step");
load();
setInterval(load, 1500);
document.addEventListener("visibilitychange", load);
</script>
</html>`;

const REPO = process.env.REPRO_REPO ?? join(homedir(), "coding", "loops");
const BRANCHES = [
  { pr: 1, name: "allow-content-api-drafts-on-a-disabled-domain", title: "Drafting on a disabled domain" },
  { pr: 2, name: "say-when-the-sending-domain-is-disabled", title: "Saying the domain is disabled" },
];

function branchTip(name) {
  try {
    return execFileSync("git", ["-C", REPO, "rev-parse", "--short=10", `refs/heads/${name}`], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
  } catch {
    return null;
  }
}

const state = () => ({
  hasKey: Boolean(readKey()),
  runs: active ? [...loadRuns(), active.run] : loadRuns(),
  pending: active?.pending ? { ...active.pending, resolve: undefined } : null,
  mode: active?.mode ?? null,
  branches: BRANCHES.map((b) => ({ ...b, tip: branchTip(b.name), href: `canopy://v2/b/loops/${b.name}` })),
});
createServer(async (req, res) => {
  const json = (code, body) => {
    res.writeHead(code, { "Content-Type": "application/json" });
    res.end(JSON.stringify(body));
  };
  const url = new URL(req.url, "http://x");
  if (req.method === "GET" && url.pathname === "/") {
    res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
    return res.end(
      PAGE.replaceAll("__BASE__", BASE).replaceAll("__SERVICE__", KEY_SERVICE).replace("__STEPS__", JSON.stringify(STEPS))
    );
  }
  if (req.method === "GET" && url.pathname === "/state") {
    return json(200, state());
  }
  if (req.method === "POST" && url.pathname === "/run") {
    const key = readKey();
    if (!key) {
      return json(200, { ...state(), error: "no key in the Keychain" });
    }
    if (active) {
      return json(200, { ...state(), error: "a run is already in progress" });
    }
    const mode = url.searchParams.get("mode") === "step" ? "step" : "auto";
    const done = startRun(key, mode);
    if (mode === "auto") {
      await done;
    } else {
      await new Promise((r) => setTimeout(r, 30));
    }
    return json(200, state());
  }
  if (req.method === "POST" && url.pathname === "/next") {
    const answer = url.searchParams.get("do");
    if (!active?.pending || !["send", "skip", "rest", "stop"].includes(answer)) {
      return json(200, { ...state(), error: "nothing is waiting" });
    }
    const hadRun = active.run;
    const { resolve } = active.pending;
    active.pending = null;
    resolve(answer);
    // wait until the request has answered and the run is either waiting again or finished
    for (let i = 0; i < 400 && active && active.run === hadRun && !active.pending; i++) {
      await new Promise((r) => setTimeout(r, 50));
    }
    return json(200, state());
  }
  json(404, { error: "not found" });
}).listen(PORT, "127.0.0.1", () => {
  console.log(`loo-6235-repro on http://127.0.0.1:${PORT} → ${BASE}`);
});
