#!/usr/bin/env python3
"""gh-review-notify — poll GitHub notifications, forward the ones that matter to your phone.

GitHub has no real push to a third-party app, so this polls GET /notifications politely (via
`gh api`, so auth is gh's own — no PAT to manage) and forwards the threads you care about to
ntfy (https://ntfy.sh): your phone subscribes to a topic, no account, no keys.

  gh-review-notify              one poll; print new matching threads
  gh-review-notify --watch      loop forever, honoring GitHub's X-Poll-Interval
  NTFY_TOPIC=<topic> gh-review-notify --watch   also push each to ntfy.sh/<topic>

Env:
  NTFY_TOPIC          ntfy topic to POST to (optional; print-only if unset)
  NTFY_SERVER         ntfy base url (default https://ntfy.sh)
  GH_NOTIFY_REASONS   comma list of notification `reason`s to forward
                      (default: review_requested,state_change,mention,assign)

Polling is conditional: we send If-Modified-Since with the prior Last-Modified, so an
unchanged feed returns 304 and costs nothing against the rate limit. State (the last
Last-Modified + the thread ids already forwarded) lives in ~/.cache/gh-review-notify/.
This never marks anything read — it only observes.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

REASONS = set(
    (os.environ.get("GH_NOTIFY_REASONS") or "review_requested,state_change,mention,assign").split(",")
)
NTFY_SERVER = os.environ.get("NTFY_SERVER", "https://ntfy.sh").rstrip("/")
STATE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "gh-review-notify"
STATE_FILE = STATE_DIR / "state.json"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "gh-review-notify"
TOPIC_FILE = CONFIG_DIR / "topic"
LABEL = "com.philbrockman.gh-review-notify"
PLIST = Path.home() / "Library" / "LaunchAgents" / f"{LABEL}.plist"


def configured_topic() -> str:
    """ntfy topic from $NTFY_TOPIC, else the saved config — so the launchd agent (which
    carries no shell env) still knows where to push."""
    env = os.environ.get("NTFY_TOPIC", "").strip()
    if env:
        return env
    try:
        return TOPIC_FILE.read_text().strip()
    except FileNotFoundError:
        return ""


NTFY_TOPIC = configured_topic()

# a reason → (emoji, ntfy priority, short label) for legible output and phone alerts.
REASON_STYLE = {
    "review_requested": ("👀", "high", "review requested"),
    "state_change": ("🔀", "default", "state changed"),
    "mention": ("💬", "high", "mentioned"),
    "assign": ("📌", "default", "assigned"),
    "ci_activity": ("🔧", "low", "CI"),
    "comment": ("💬", "default", "comment"),
}


def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text())
    except (FileNotFoundError, ValueError):
        return {"last_modified": None, "seen": []}


def save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    # cap the seen-id list so it can't grow forever; recent ids are all dedup needs.
    state["seen"] = state["seen"][-500:]
    STATE_FILE.write_text(json.dumps(state))


def poll(last_modified: str | None) -> tuple[int, list[dict], str | None, int]:
    """One conditional poll. Returns (status, threads, new_last_modified, poll_interval)."""
    args = ["gh", "api", "--include"]
    if last_modified:
        args += ["-H", f"If-Modified-Since: {last_modified}"]
    args += ["/notifications?all=false&per_page=50"]
    r = subprocess.run(args, capture_output=True, text=True)
    if r.returncode != 0 and "304" not in r.stdout and "304" not in r.stderr:
        sys.stderr.write(f"gh-review-notify: gh api failed:\n{r.stderr}\n")
        return 0, [], last_modified, 60
    head, _, body = r.stdout.partition("\n\n")
    status = 304 if " 304" in head.split("\n", 1)[0] else 200
    new_lm, interval = last_modified, 60
    for line in head.splitlines():
        low = line.lower()
        if low.startswith("last-modified:"):
            new_lm = line.split(":", 1)[1].strip()
        elif low.startswith("x-poll-interval:"):
            interval = int(line.split(":", 1)[1].strip() or 60)
    if status == 304:
        return 304, [], new_lm, interval
    try:
        threads = json.loads(body) if body.strip() else []
    except ValueError:
        threads = []
    return 200, threads, new_lm, interval


def html_url(thread: dict) -> str:
    subj = thread.get("subject") or {}
    api = subj.get("url") or ""
    # api.github.com/repos/o/r/pulls/N → github.com/o/r/pull/N ; same for issues.
    if "/repos/" in api:
        path = api.split("/repos/", 1)[1].replace("/pulls/", "/pull/")
        return f"https://github.com/{path}"
    return (thread.get("repository") or {}).get("html_url", "https://github.com/notifications")


def notify(thread: dict) -> None:
    reason = thread.get("reason", "")
    emoji, priority, label = REASON_STYLE.get(reason, ("•", "default", reason))
    subj = (thread.get("subject") or {}).get("title", "(no title)")
    repo = (thread.get("repository") or {}).get("full_name", "?")
    url = html_url(thread)
    print(f"{emoji} [{label}] {subj}  ·  {repo}\n   {url}", flush=True)
    if not NTFY_TOPIC:
        return
    try:
        req = urllib.request.Request(
            f"{NTFY_SERVER}/{NTFY_TOPIC}",
            data=f"{subj}\n{repo}".encode(),
            headers={"Title": f"{emoji} {label}", "Priority": priority, "Click": url, "Tags": "octopus"},
            method="POST",
        )
        urllib.request.urlopen(req, timeout=10).read()
    except Exception as e:  # ntfy down shouldn't kill the loop
        sys.stderr.write(f"gh-review-notify: ntfy POST failed: {e}\n")


def run_once(state: dict) -> int:
    status, threads, new_lm, interval = poll(state.get("last_modified"))
    state["last_modified"] = new_lm
    seen = set(state.get("seen", []))
    fresh = 0
    for t in threads:
        if t.get("reason") not in REASONS:
            continue
        key = f"{t.get('id')}@{t.get('updated_at')}"
        if key in seen:
            continue
        seen.add(key)
        state["seen"].append(key)
        notify(t)
        fresh += 1
    if status == 200 and fresh == 0:
        print(f"(nothing new matching {sorted(REASONS)})", flush=True)
    save_state(state)
    return interval


PLIST_TEMPLATE = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{label}</string>
  <key>ProgramArguments</key>
  <array><string>{python}</string><string>{script}</string><string>--watch</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>NTFY_TOPIC</key><string>{topic}</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>{out}</string>
  <key>StandardErrorPath</key><string>{err}</string>
</dict>
</plist>
"""


def plist_text(topic: str) -> str:
    # stable system interpreter, not sys.executable (which can be Xcode's, prone to moving);
    # the script is pure stdlib so /usr/bin/python3 runs it.
    return PLIST_TEMPLATE.format(
        label=LABEL, python="/usr/bin/python3", script=os.path.abspath(__file__), topic=topic,
        out=str(STATE_DIR / "agent.out.log"), err=str(STATE_DIR / "agent.err.log"))


def cmd_install(topic: str, dry: bool) -> None:
    if not topic:
        sys.exit("install: need a topic — `gh-review-notify install --topic <your-secret-topic>`")
    text = plist_text(topic)
    if dry:
        print(text)
        return
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    TOPIC_FILE.write_text(topic + "\n")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    PLIST.parent.mkdir(parents=True, exist_ok=True)
    PLIST.write_text(text)
    uid = os.getuid()
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{LABEL}"], capture_output=True)
    r = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(PLIST)], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"install: launchctl bootstrap failed: {r.stderr.strip()}")
    print(f"installed + started → pushing to ntfy.sh/{topic}\n  logs: {STATE_DIR}/agent.*.log\n  stop: gh-review-notify uninstall")


def cmd_uninstall() -> None:
    subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{LABEL}"], capture_output=True)
    if PLIST.exists():
        PLIST.unlink()
    print("uninstalled (agent stopped, plist removed; topic config kept)")


def cmd_status() -> None:
    loaded = subprocess.run(["launchctl", "print", f"gui/{os.getuid()}/{LABEL}"], capture_output=True).returncode == 0
    print(f"agent:   {'running' if loaded else 'not loaded'}")
    print(f"plist:   {'present' if PLIST.exists() else 'absent'} ({PLIST})")
    print(f"topic:   {NTFY_TOPIC or '(unset — run install --topic <x>)'}")
    print(f"reasons: {sorted(REASONS)}")


def main() -> None:
    args = sys.argv[1:]
    cmd = args[0] if args else ""
    if cmd == "install":
        topic = ""
        if "--topic" in args:
            i = args.index("--topic")
            topic = args[i + 1] if i + 1 < len(args) else ""
        cmd_install(topic or NTFY_TOPIC, "--dry-run" in args)
        return
    if cmd == "uninstall":
        cmd_uninstall()
        return
    if cmd == "status":
        cmd_status()
        return
    watch = "--watch" in args
    dest = f"→ ntfy.sh/{NTFY_TOPIC}" if NTFY_TOPIC else "(print only — set NTFY_TOPIC or run `install`)"
    print(f"gh-review-notify: reasons={sorted(REASONS)} {dest}", flush=True)
    state = load_state()
    if not watch:
        run_once(state)
        return
    while True:
        interval = run_once(state)
        time.sleep(max(60, interval))


if __name__ == "__main__":
    main()
