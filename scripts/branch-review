#!/bin/zsh
# Branch Review - opens nvim with diffview for reviewing a branch against main
# Supports blessing (same UX as stack review, without stack parent tracking)

set -e

# Get branch (argument or current)
BRANCH="${1:-$(git branch --show-current 2>/dev/null)}"
if [[ -z "$BRANCH" ]]; then
  echo "Not in a git repository or no branch specified"
  exit 1
fi

BASE=$(git config stack.main-branch 2>/dev/null || echo "main")

# Keep the review base fresh: fast-forward the trunk from origin so we don't
# diff against a stale local main (best effort; FF-only).
git fetch --quiet origin "${BASE}:${BASE}" 2>/dev/null \
  || echo "  (couldn't fast-forward ${BASE} from origin — review base may be stale)"

# Verify the branch exists
if ! git rev-parse --verify "$BRANCH" &>/dev/null; then
  echo "Branch '$BRANCH' does not exist"
  exit 1
fi

# Check there are actually changes
DIFF_COUNT=$(git diff --name-only "${BASE}...${BRANCH}" 2>/dev/null | wc -l | tr -d ' ')
if [[ "$DIFF_COUNT" -eq 0 ]]; then
  echo "No changes between $BASE and $BRANCH"
  exit 0
fi

echo "Reviewing $BRANCH against $BASE ($DIFF_COUNT files changed)"

# Launch nvim with DiffviewOpen, then setup branch-review module
nvim -c "DiffviewOpen ${BASE}...${BRANCH}" \
     -c "lua require('custom.branch-review').setup({branch='${BRANCH}', base='${BASE}'})"
