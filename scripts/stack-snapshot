#!/bin/zsh
# Stack Snapshot - capture and compare stack state
# Usage: stack-snapshot [save|diff|show]

set -e

CACHE_DIR="$HOME/.cache/stack-snapshots"
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
REPO_NAME=$(basename "$REPO_ROOT")
REPO_CACHE="$CACHE_DIR/$REPO_NAME"

mkdir -p "$REPO_CACHE"

# Get current branch
BRANCH=$(git branch --show-current 2>/dev/null)
MAIN_BRANCH=$(git config stack.main-branch 2>/dev/null || echo "main")

get_stack_branches() {
  git config --local --list 2>/dev/null \
    | grep -E "^stack-branch\..*\.parent=" \
    | while IFS= read -r line; do
        if [[ "$line" =~ 'stack-branch\.(.+)\.parent=(.+)' ]]; then
          echo "${match[1]}"
        fi
      done | sort -u
}

lookup_parent() {
  git config "stack-branch.$1.parent" 2>/dev/null
}

# Get file hashes for a branch diff against its parent
get_branch_files() {
  local branch="$1"
  local parent=$(lookup_parent "$branch")
  [[ -z "$parent" ]] && return

  git diff --name-only "$parent".."$branch" -- "*.ts" "*.tsx" 2>/dev/null | while read file; do
    local hash=$(git show "$branch":"$file" 2>/dev/null | md5 -q)
    echo "$file:$hash"
  done
}

# Save current snapshot
save_snapshot() {
  local timestamp=$(date +%Y%m%d_%H%M%S)
  local snapshot_file="$REPO_CACHE/$timestamp.json"
  local latest_link="$REPO_CACHE/latest.json"

  echo "{" > "$snapshot_file"
  echo "  \"timestamp\": \"$timestamp\"," >> "$snapshot_file"
  echo "  \"branch\": \"$BRANCH\"," >> "$snapshot_file"
  echo "  \"branches\": {" >> "$snapshot_file"

  local first=true
  get_stack_branches | while read branch; do
    local sha=$(git rev-parse "$branch" 2>/dev/null)
    local parent=$(lookup_parent "$branch")

    [[ "$first" == "true" ]] && first=false || echo "," >> "$snapshot_file"

    echo -n "    \"$branch\": {\"sha\": \"$sha\", \"parent\": \"$parent\", \"files\": {" >> "$snapshot_file"

    local file_first=true
    get_branch_files "$branch" | while read file_hash; do
      local file="${file_hash%%:*}"
      local hash="${file_hash##*:}"
      [[ "$file_first" == "true" ]] && file_first=false || echo -n ", " >> "$snapshot_file"
      echo -n "\"$file\": \"$hash\"" >> "$snapshot_file"
    done

    echo -n "}}" >> "$snapshot_file"
  done

  echo "" >> "$snapshot_file"
  echo "  }" >> "$snapshot_file"
  echo "}" >> "$snapshot_file"

  # Update latest link
  ln -sf "$snapshot_file" "$latest_link"

  echo "$snapshot_file"
}

# Compare current state to last snapshot
diff_snapshot() {
  local latest="$REPO_CACHE/latest.json"

  if [[ ! -f "$latest" ]]; then
    echo "No previous snapshot found. Run: stack-snapshot save"
    exit 1
  fi

  local old_snapshot=$(cat "$latest")

  echo "=== Stack Changes Since Last Snapshot ==="
  echo ""

  get_stack_branches | while read branch; do
    local current_sha=$(git rev-parse "$branch" 2>/dev/null)
    local old_sha=$(echo "$old_snapshot" | grep -o "\"$branch\": {\"sha\": \"[^\"]*" | cut -d'"' -f5)

    if [[ -z "$old_sha" ]]; then
      echo "🆕 $branch (new branch)"
    elif [[ "$current_sha" != "$old_sha" ]]; then
      echo "📝 $branch"
      echo "   $old_sha -> ${current_sha:0:12}"

      # Show changed files
      git diff --name-only "$old_sha".."$current_sha" -- "*.ts" "*.tsx" 2>/dev/null | while read file; do
        echo "      • $file"
      done
    fi
  done
}

# Show last snapshot info
show_snapshot() {
  local latest="$REPO_CACHE/latest.json"

  if [[ ! -f "$latest" ]]; then
    echo "No snapshot found."
    exit 1
  fi

  local real_path=$(readlink "$latest" 2>/dev/null || echo "$latest")
  local timestamp=$(basename "$real_path" .json)

  echo "Last snapshot: $timestamp"
  echo "Branches tracked: $(cat "$latest" | grep -c '"sha"')"
}

# Output JSON for nvim consumption
json_diff() {
  local latest="$REPO_CACHE/latest.json"

  if [[ ! -f "$latest" ]]; then
    echo "{}"
    exit 0
  fi

  local old_snapshot=$(cat "$latest")

  echo "{"
  local first=true

  get_stack_branches | while read branch; do
    local current_sha=$(git rev-parse "$branch" 2>/dev/null)
    local old_sha=$(echo "$old_snapshot" | grep -o "\"$branch\": {\"sha\": \"[^\"]*" | cut -d'"' -f5)

    [[ "$first" == "true" ]] && first=false || echo ","

    if [[ -z "$old_sha" ]]; then
      echo -n "  \"$branch\": {\"status\": \"new\", \"files\": []}"
    elif [[ "$current_sha" != "$old_sha" ]]; then
      echo -n "  \"$branch\": {\"status\": \"modified\", \"old_sha\": \"$old_sha\", \"new_sha\": \"$current_sha\", \"files\": ["

      local file_first=true
      git diff --name-only "$old_sha".."$current_sha" -- "*.ts" "*.tsx" 2>/dev/null | while read file; do
        [[ "$file_first" == "true" ]] && file_first=false || echo -n ", "
        echo -n "\"$file\""
      done

      echo -n "]}"
    else
      echo -n "  \"$branch\": {\"status\": \"unchanged\", \"files\": []}"
    fi
  done

  echo ""
  echo "}"
}

case "${1:-show}" in
  save)
    snapshot_file=$(save_snapshot)
    echo "Snapshot saved: $snapshot_file"
    ;;
  diff)
    diff_snapshot
    ;;
  json)
    json_diff
    ;;
  show|*)
    show_snapshot
    ;;
esac
