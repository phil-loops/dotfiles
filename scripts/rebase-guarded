#!/usr/bin/env python3
"""rebase-guarded — `git rebase` that can't strand a worktree (srv/rebaseguard.py).

  rebase-guarded -C <dir> <rebase args…>   rebase with an owner record; aborts on failure, and
                                           first aborts a stranded rebase whose owner died.
                                           Exit: git's own; 3 = a person's rebase is in progress
  rebase-guarded --heal -C <dir>           just the heal: exit 0 clear/healed, 3 a person's rebase

The owner recorded is this process, so a kill -9 of the caller's process group leaves a record
the next guarded run (or --heal) acts on."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from srv import rebaseguard  # noqa: E402


def main(argv):
    heal_only = argv[:1] == ["--heal"]
    if heal_only:
        argv = argv[1:]
    if len(argv) < 2 or argv[0] != "-C":
        print(__doc__.strip(), file=sys.stderr)
        return 2
    wt, args = argv[1], argv[2:]
    if heal_only:
        state = rebaseguard.heal(wt)
        if state == "healed":
            print(f"aborted a rebase stranded by a dead owner in {wt}")
        return 3 if state in ("person", "live") else 0
    r = rebaseguard.run(wt, args)
    sys.stdout.write(r.stdout or "")
    sys.stderr.write(r.stderr or "")
    return r.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
