#!/bin/zsh
# stack-claude-resume <session-id> <cwd> <branch> [<target>] — pop a headless viewer chat
# out into an INTERACTIVE claude in tmux, continuing the SAME conversation via `claude
# --resume`. The viewer's chat ran headless + read-only in <cwd>; resuming there (claude
# sessions are scoped to their project dir, so the cwd MUST match the one the chat used)
# hands you the whole thread in a real terminal — now able to edit/run, not just read.
#
#   <target> placement:
#     (empty) | "new"      → a fresh tmux window
#     "<session>:<window>" → split that existing window into a new pane (the "which window?" pick)
#   STACK_CLAUDE_TMUX=<session>  override the session a new window lands in (default: loops)
#   STACK_CLAUDE_DRY=1           print what it would do, launch nothing
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

SESSION="${STACK_CLAUDE_TMUX:-${STACK_OPEN_TMUX:-loops}}"

sid="${1:?usage: stack-claude-resume <session-id> <cwd> <branch> [<target>]}"
dir="${2:?usage: stack-claude-resume <session-id> <cwd> <branch> [<target>]}"
branch="${3:?usage: stack-claude-resume <session-id> <cwd> <branch> [<target>]}"
target="${4:-}"

# sid + target are baked into the tmux command/target strings — guard them to plain tokens.
if [[ ! "$sid" =~ '^[A-Za-z0-9._-]+$' ]]; then
  print -u2 "stack-claude-resume: refusing suspicious session id '$sid'"; exit 1
fi
[[ -d "$dir" ]] || { print -u2 "stack-claude-resume: no such dir '$dir'"; exit 1; }

focus_terminal(){   # raise the GUI terminal hosting tmux so the resumed thread is actually visible
  local app="${STACK_CLAUDE_TERMINAL:-${STACK_OPEN_TERMINAL:-}}"
  if [[ -z "$app" ]]; then case "${TERM_PROGRAM:-}" in
    iTerm.app)       app=iTerm ;;
    Apple_Terminal)  app=Terminal ;;
    WezTerm)         app=WezTerm ;;
    ghostty|Ghostty) app=Ghostty ;;
    vscode|cursor)   return 0 ;;   # integrated terminal — don't yank focus away
    # inside tmux TERM_PROGRAM=tmux (useless) — fall back to whichever known GUI terminal is running
    # || true: head -1 closes early, so grep/ps die on SIGPIPE (141) — pipefail + set -e would abort
    *) app=$(ps -axo comm 2>/dev/null | grep -ioE 'iTerm|WezTerm|Alacritty|kitty|Ghostty|Terminal' | head -1) || true
       [[ -n "$app" ]] || app=Terminal ;;
  esac; fi
  [[ -n "$app" ]] || return 0
  # `activate` alone often only bounces the dock when the caller isn't frontmost (the browser
  # is) — macOS focus-stealing prevention raises the window faint/non-key. Forcing frontmost via
  # System Events makes it the actual key window. Best-effort: needs Accessibility, may no-op.
  osascript >/dev/null 2>&1 \
    -e "tell application \"$app\" to activate" \
    -e "tell application \"System Events\" to set frontmost of (first process whose name is \"$app\") to true" \
    || true
}
surface(){   # move the active client onto <session:window> (and its active pane), then raise the GUI
  local wt="$1" client
  tmux select-window -t "$wt" 2>/dev/null || true
  # A client parked on another session won't follow select-window, so switch it explicitly — the
  # pop-out lands in '$SESSION' but you may be attached elsewhere. Switch only the most-recently
  # active client (not every client) so a secondary client parked elsewhere on purpose stays put.
  # || true: head -1 closes early, so sort dies on SIGPIPE (141) — pipefail + set -e would abort
  client=$(tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-) || true
  [[ -n "$client" ]] && tmux switch-client -c "$client" -t "$wt" 2>/dev/null || true
  focus_terminal
}

# claude exits → drop to a shell so the resumed thread's output sticks around in the pane.
cmd="claude --resume $sid; exec \$SHELL"

if [[ -z "$target" || "$target" == "new" ]]; then
  win="chat:${branch##*/}"
  if [[ -n "${STACK_CLAUDE_DRY:-}" ]]; then
    print -r -- "DRY: tmux new-window -t $SESSION -n $win -c $dir '$cmd'"; exit 0
  fi
  tmux new-window -t "$SESSION" -n "$win" -c "$dir" "$cmd" \
    || { print -u2 "stack-claude-resume: couldn't open a tmux window (is the '$SESSION' session running?)"; exit 1; }
  surface "$SESSION:$win"
  print -r -- "resumed $sid in a new window ($SESSION:$win) at $dir"
else
  if [[ ! "$target" =~ '^[A-Za-z0-9._:/-]+$' ]]; then
    print -u2 "stack-claude-resume: bad target '$target'"; exit 1
  fi
  if [[ -n "${STACK_CLAUDE_DRY:-}" ]]; then
    print -r -- "DRY: tmux split-window -t $target -c $dir '$cmd'"; exit 0
  fi
  pane=$(tmux split-window -t "$target" -c "$dir" -P -F '#{pane_id}' "$cmd") \
    || { print -u2 "stack-claude-resume: couldn't split window '$target'"; exit 1; }
  tmux select-pane -t "$pane" 2>/dev/null || true
  surface "$target"
  print -r -- "resumed $sid as a new pane in $target at $dir"
fi
