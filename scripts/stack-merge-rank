#!/usr/bin/env python3
# stack-merge-rank <branch-or-project> — the ONE deterministic merge-order authority for a forest,
# so the story view, ForestMap, and stack-pr-body stop each rolling their own topo (and drifting on
# tie-breaks / cycle handling). Consumed by review.py (grafts mergeRank onto /model nodes) and
# stack-pr-body (deterministic sequencing).
#
# mergeRank = longest path from main over parent + requires edges. main = 0; a base off main = 1;
# a node one fan-in/parent step deeper = 2; and so on. Siblings share a rank (they're independent).
#
# Canonical merge order = STABLE sort by mergeRank ascending over the project's branch-list order
# (the order in stack-project.<p>.branch) — so equal ranks keep their declared order, identically
# for every consumer. The emitted "order" array already encodes that; consumers can render it as-is.
#
# Output (JSON): {"project": "...", "rank": {branch: rank, ...}, "order": [branch, ...]}
import json
import subprocess
import sys


# one spawn for the whole namespace — per-key `git config` spawns cost ~40ms each, and the old
# 4-reads-per-branch loop made this script the slow step of every plan/model render
def read_config():
    raw = subprocess.run(["git", "config", "-z", "--get-regexp",
                          r"^(branch|stack-branch|stack-project)\."],
                         capture_output=True, text=True).stdout
    conf = {}
    for entry in raw.split("\0"):
        if entry:
            key, _, val = entry.partition("\n")
            conf.setdefault(key, []).append(val.strip())
    return conf


# importable too: stack_facts loads this file as a module and calls compute() with its own
# already-read config, skipping a second python startup
def compute(key, conf):
    one = lambda k: (conf.get(k) or [""])[-1].strip()
    many = lambda k: [v.strip() for v in conf.get(k, []) if v.strip()]
    # accept a branch (resolve its project) or a project name directly
    project = one(f"branch.{key}.stack-project") or one(f"stack-branch.{key}.project")
    if not project:
        project = key
    branches = many(f"stack-project.{project}.branch")
    if not branches:
        return {"project": project, "rank": {}, "order": []}

    parent, requires, after = {}, {}, {}
    known = set(branches)
    for b in branches:
        parent[b] = one(f"branch.{b}.stack-parent") or one(f"stack-branch.{b}.parent") or "main"
        requires[b] = many(f"branch.{b}.stack-requires") or many(f"stack-branch.{b}.requires")
        # `after` = merge-order-only dependence: no carried commits, no rebase coupling —
        # the branch is content-independent but must land later (deploy invariants).
        # Counts fully in rank so the canonical order honors it.
        after[b] = many(f"branch.{b}.stack-after") or many(f"stack-branch.{b}.after")

    memo = {}

    def rank(b, seen):
        if b == "main" or b not in known:
            return 0
        if b in memo:
            return memo[b]
        if b in seen:
            return 0  # cycle guard — a forest shouldn't have one, but never loop forever
        seen = seen | {b}
        ups = []
        if parent[b] != "main" and parent[b] in known:
            ups.append(parent[b])
        ups += [r for r in requires[b] if r in known]
        ups += [a for a in after[b] if a in known]
        r = 1 + max((rank(u, seen) for u in ups), default=0)
        memo[b] = r
        return r

    ranks = {b: rank(b, set()) for b in branches}
    # stable sort preserves the declared branch-list order within a rank
    order = sorted(branches, key=lambda b: ranks[b])
    return {"project": project, "rank": ranks, "order": order}


def main():
    if len(sys.argv) < 2:
        print(json.dumps({"project": "", "rank": {}, "order": []}))
        return
    print(json.dumps(compute(sys.argv[1], read_config())))


if __name__ == "__main__":
    main()
