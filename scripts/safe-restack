#!/usr/bin/env bash
# safe-restack — restack a project's forest onto fresh origin/main WITH the guardrails
# learned the hard way (goals-in-workflows orphan, 2026-07-08; feedback_restack-orphaned-stack).
#
#   safe-restack <project>          restack the project onto fresh origin/main
#   safe-restack <project> --dry    show the plan (orphan screen + topo order); change nothing
#   safe-restack <project> --verify also run tsc on the tip after (heavy; needs node_modules)
#
# Safety posture (why this beats a raw rebase loop):
#   • PREFLIGHT REFUSALS — bails before touching anything on: an ORPHANED edge (parent tip
#     not an ancestor of child → a raw rebase would duplicate code), a dirty checked-out
#     worktree, or a missing branch. Orphans must be de-orphaned by hand first (two-phase).
#   • SNAPSHOT + ROLLBACK — records every branch SHA up front; if ANY branch hits a conflict,
#     restores every branch to its snapshot and aborts. Never leaves a half-restacked forest.
#   • NEVER force-resolves — a conflict means a real semantic clash; that's for a human, not
#     a --theirs/-X guess. Clean-apply-or-rollback only.
#   • Cuts at the stack-parent's PRE-rebase tip (snapshot), rebasing bottom-up (topological).
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

proj=""; dry=0; verify=0
for a in "$@"; do
  case "$a" in
    --dry) dry=1 ;; --verify) verify=1 ;;
    -h|--help) sed -n '2,25p' "$0"; exit 0 ;;
    *) proj="$a" ;;
  esac
done
[ -n "$proj" ] || { echo "usage: safe-restack <project> [--dry] [--verify]" >&2; exit 1; }
git rev-parse --git-dir >/dev/null 2>&1 || { echo "not in a git repo" >&2; exit 1; }

branches=$(git config --get-all "stack-project.$proj.branch" 2>/dev/null || true)
[ -n "$branches" ] || { echo "no branches for project '$proj'" >&2; exit 1; }
sha() { git rev-parse --short "$1" 2>/dev/null; }
parentof() { git config "branch.$1.stack-parent" 2>/dev/null || git config "stack-branch.$1.parent" 2>/dev/null || echo main; }
wt_of() { git worktree list --porcelain | awk -v want="$1" '/^worktree /{w=$2} /^branch /{b=$2;sub("refs/heads/","",b); if(b==want){f=w}} END{if(f)print f}'; }

# ── PREFLIGHT ───────────────────────────────────────────────────────────────
echo "── preflight: $proj ──"
fail=0
for b in $branches; do
  git rev-parse --verify -q "$b" >/dev/null || { echo "  ✗ MISSING branch $b (in config, no ref)"; fail=1; continue; }
  p=$(parentof "$b")
  if [ "$p" != "main" ] && [ "$p" != "origin/main" ] && git rev-parse --verify -q "$p" >/dev/null; then
    if ! git merge-base --is-ancestor "$p" "$b" 2>/dev/null; then
      echo "  ⚠ ORPHAN $b — parent '$p' tip $(sha "$p") is not an ancestor; de-orphan by hand first (two-phase)."
      fail=1
    fi
  fi
  w=$(wt_of "$b")
  if [ -n "$w" ] && [ -n "$(git -C "$w" status --porcelain 2>/dev/null | head -c1)" ]; then
    echo "  ✗ DIRTY worktree for $b ($w) — commit/stash first."; fail=1
  fi
done
if [ "$fail" = "1" ]; then echo "REFUSING: fix the above (run 'stack-doctor $proj' for the full picture). Nothing changed."; exit 2; fi
echo "  ✓ no orphans, no dirty worktrees, all refs present"

# ── topological order (parents before children) ─────────────────────────────
bl=" $(echo $branches) "   # space-joined membership list (config is newline-separated)
in_project() { case "$bl" in *" $1 "*) return 0;; *) return 1;; esac; }
order=" "
for _ in $(seq 1 50); do
  progressed=0
  for b in $branches; do
    case "$order" in *" $b "*) continue;; esac
    p=$(parentof "$b")
    # ready if parent is main, or a non-project (external) branch, or already ordered
    if [ "$p" = "main" ] || [ "$p" = "origin/main" ] || ! in_project "$p" || case "$order" in *" $p "*) true;; *) false;; esac; then
      order="$order$b "; progressed=1
    fi
  done
  [ "$progressed" = "0" ] && break
done
order=$(echo $order)
echo "── restack order (bottom-up): $order"

# ── snapshot (file-backed; bash 3.2 has no assoc arrays) ────────────────────
snapfile="$(git rev-parse --git-dir)/safe-restack-$proj.snap"
: > "$snapfile"; for b in $branches; do echo "$b $(git rev-parse "$b")" >> "$snapfile"; done
snap_of() { awk -v b="$1" '$1==b{print $2}' "$snapfile"; }
echo "  snapshot saved: $snapfile"

git fetch origin main --quiet 2>/dev/null || true
OM=$(git rev-parse origin/main)
echo "  target origin/main: $(sha "$OM")"

if [ "$dry" = "1" ]; then
  echo "── DRY RUN — plan only ──"
  for b in $order; do
    p=$(parentof "$b")
    if [ "$p" = "main" ] || [ "$p" = "origin/main" ]; then echo "  $b: rebase --onto origin/main \$(merge-base $b origin/main)"
    else echo "  $b: rebase --onto <new $p> $(snap_of "$p" | cut -c1-9)  (cut at $p's snapshot tip)"; fi
  done
  rm -f "$snapfile"; exit 0
fi

rollback() {
  echo "!! ROLLBACK — restoring all branches from snapshot"
  while read -r b s; do
    [ -z "$b" ] && continue
    w=$(wt_of "$b")
    if [ -n "$w" ]; then git -C "$w" reset --hard "$s" >/dev/null 2>&1; else git branch -f "$b" "$s" 2>/dev/null; fi
  done < "$snapfile"
  echo "   restored. Nothing left half-done."
}

# ── rebase bottom-up ────────────────────────────────────────────────────────
for b in $order; do
  p=$(parentof "$b")
  if [ "$p" = "main" ] || [ "$p" = "origin/main" ]; then onto="$OM"; cut=$(git merge-base "$b" "$OM"); else onto=$(git rev-parse "$p"); cut=$(snap_of "$p"); fi
  w=$(wt_of "$b"); tmp=""
  if [ -z "$w" ]; then tmp="/tmp/sr-${b//\//_}"; rm -rf "$tmp"; git worktree add "$tmp" "$b" >/dev/null 2>&1; w="$tmp"; fi
  if ( cd "$w" && git rebase --onto "$onto" "$cut" >/dev/null 2>&1 ); then
    echo "  ✓ $b -> $(sha "$b")"
    [ -n "$tmp" ] && git worktree remove --force "$tmp" >/dev/null 2>&1
  else
    ( cd "$w" && git rebase --abort >/dev/null 2>&1 )
    [ -n "$tmp" ] && git worktree remove --force "$tmp" >/dev/null 2>&1
    echo "  ✗ $b CONFLICT — real semantic clash, not auto-resolving."
    rollback; rm -f "$snapfile"; exit 3
  fi
done

# ── post-verify ─────────────────────────────────────────────────────────────
tip=$(echo $order | awk '{print $NF}')
vw=$(wt_of "$tip"); [ -n "$vw" ] || vw="$PWD"
echo "── verify ──"
if git -C "$vw" grep -q '^<<<<<<< \|^>>>>>>> ' 2>/dev/null; then echo "  ✗ conflict markers found in $tip"; rollback; rm -f "$snapfile"; exit 3; fi
echo "  ✓ no conflict markers"
if [ "$verify" = "1" ]; then
  if [ -e "$vw/node_modules" ]; then
    echo "  running tsc on $tip ($vw) ..."
    if ( cd "$vw" && tsc-turn npx tsc --project tsconfig.node.json --noEmit >/tmp/sr-tsc.log 2>&1 ); then echo "  ✓ tsc clean"
    else echo "  ⚠ tsc errors ($(grep -c 'error TS' /tmp/sr-tsc.log) total) — review /tmp/sr-tsc.log (may be stale-trpc-types noise; filter to your files)"; fi
  else echo "  (skip tsc: $tip not checked out in a worktree with node_modules)"; fi
fi
rm -f "$snapfile"
echo "── done: $proj restacked onto origin/main $(sha "$OM"). Snapshot cleared. ──"
