#!/usr/bin/env bash
# port-forward to an rds cluster through the bastion via ssm session manager.
#
# picks the first running instance from an ASG named bastion-*, lists rds
# clusters in the account, prompts for one with fzf, then opens a port forward
# to that cluster's reader endpoint (or writer with --writer).
#
# usage:
#   aws-vault exec staging -- bin/bastion-tunnel
#   aws-vault exec staging -- bin/bastion-tunnel --writer
#   LOCAL_PORT=5433 aws-vault exec staging -- bin/bastion-tunnel
#
# flags:
#   --writer            forward to the writer endpoint instead of the reader (default)
#   --cluster <id>      forward to this cluster directly, skipping the fzf picker
#
# env vars:
#   LOCAL_PORT   local port to bind (default: remote port + 20000)

set -euo pipefail

ENV="${AWS_VAULT:-${AWS_PROFILE:-}}"

die() { echo "error: $*" >&2; exit 1; }
log() { echo "[$(date +%H:%M:%S)] $*" >&2; }

require() {
  for c in "$@"; do
    command -v "$c" >/dev/null || die "missing dependency: $c"
  done
}

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

port_in_use() {
  lsof -iTCP:"$1" -sTCP:LISTEN -P -n >/dev/null 2>&1
}

pick_local_port() {
  local port=$1
  if [[ -n "${LOCAL_PORT:-}" ]]; then
    port_in_use "$LOCAL_PORT" && die "LOCAL_PORT=$LOCAL_PORT is already in use"
    echo "$LOCAL_PORT"
    return
  fi
  local candidate=$((port + 20000))
  while port_in_use "$candidate"; do
    log "local port $candidate in use, trying $((candidate + 1))"
    candidate=$((candidate + 1))
  done
  echo "$candidate"
}

main() {
  local use_writer=0
  local want_cluster=""
  while (( $# )); do
    case "$1" in
      -h|--help) usage ;;
      --writer) use_writer=1 ;;
      --cluster) shift; [[ $# -gt 0 ]] || die "--cluster needs an identifier"; want_cluster="$1" ;;
      *) die "unknown argument: $1" ;;
    esac
    shift
  done

  require aws jq fzf
  [[ -z "$ENV" ]] && die "no aws profile set — run via 'aws-vault exec <profile> -- $0'"

  local role="reader"
  (( use_writer )) && role="writer"

  log "looking up bastion instance..."
  local instance_id
  instance_id=$(aws autoscaling describe-auto-scaling-instances \
    --query "AutoScalingInstances[?contains(AutoScalingGroupName, 'bastion') && LifecycleState=='InService'] | [0].InstanceId" \
    --output text)
  [[ -z "$instance_id" || "$instance_id" == "None" ]] && die "no in-service bastion ASG instance found"
  log "bastion: $instance_id"

  log "listing rds clusters..."
  local clusters
  clusters=$(aws rds describe-db-clusters \
    --query "DBClusters[].[DBClusterIdentifier,Endpoint,ReaderEndpoint,Port,Engine,EngineVersion]" \
    --output text)
  [[ -z "$clusters" ]] && die "no rds clusters found"

  local endpoint_col=3
  (( use_writer )) && endpoint_col=2

  local identifier
  if [[ -n "$want_cluster" ]]; then
    printf "%s\n" "$clusters" | awk -F"\t" -v id="$want_cluster" '$1 == id {found=1} END {exit !found}' \
      || die "cluster not found in $ENV: $want_cluster"
    identifier="$want_cluster"
  else
    local selected
    selected=$(printf "%s\n" "$clusters" \
      | awk -F"\t" -v ec="$endpoint_col" '{printf "%s\t%s %s\t%s:%s\n", $1, $5, $6, $ec, $4}' \
      | column -t -s $'\t' \
      | fzf --header="env=$ENV  role=$role  pick a cluster to forward (esc to cancel)" --no-sort)
    [[ -z "$selected" ]] && die "no selection"
    identifier=$(echo "$selected" | awk '{print $1}')
  fi

  local row endpoint port
  row=$(printf "%s\n" "$clusters" | awk -F"\t" -v id="$identifier" '$1 == id {print; exit}')
  endpoint=$(echo "$row" | awk -F"\t" -v ec="$endpoint_col" '{print $ec}')
  port=$(echo "$row" | awk -F"\t" '{print $4}')

  local local_port
  local_port=$(pick_local_port "$port")

  log "forwarding $identifier [$role] ($endpoint:$port) -> localhost:$local_port via $instance_id"
  
  echo && log "point your client to localhost:$local_port"

  aws ssm start-session \
    --target "$instance_id" \
    --document-name AWS-StartPortForwardingSessionToRemoteHost \
    --parameters "{\"host\":[\"$endpoint\"],\"portNumber\":[\"$port\"],\"localPortNumber\":[\"$local_port\"]}"
}

main "$@"
