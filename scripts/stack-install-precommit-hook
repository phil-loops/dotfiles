#!/usr/bin/env bash
# stack-install-precommit-hook — wire stack-precommit-fmt as a repo's pre-commit hook,
# so staged .ts/.tsx is oxfmt-clean before it ever lands on a branch. Idempotent.
#
#   stack-install-precommit-hook            # install into the current repo
#   stack-install-precommit-hook /path/repo
#
# Note: git hooks live in the common git dir, so one install covers every linked
# worktree of the repo.
set -euo pipefail

fmt="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/stack-precommit-fmt"
repo="${1:-$PWD}"
hooks_dir="$(git -C "$repo" rev-parse --absolute-git-dir)/hooks"
hook="$hooks_dir/pre-commit"

mkdir -p "$hooks_dir"

if [[ -e "$hook" ]] && ! grep -q "stack-precommit-fmt" "$hook" 2>/dev/null; then
  echo "✋ $hook already exists and isn't ours — leaving it alone." >&2
  echo "   Add this line to it yourself: \"$fmt\"" >&2
  exit 1
fi

cat > "$hook" <<EOF
#!/usr/bin/env bash
# installed by stack-install-precommit-hook — oxfmt staged .ts/.tsx before commit
"$fmt"
EOF
chmod +x "$hook"
echo "✓ pre-commit oxfmt installed → $hook"
