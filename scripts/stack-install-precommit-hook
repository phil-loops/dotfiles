#!/usr/bin/env bash
# stack-install-precommit-hook — wire the repo's pre-commit hook: staged .ts/.tsx is oxfmt-clean
# before it lands, and a commit that would bake a revert of merged work is refused. Idempotent.
#
#   stack-install-precommit-hook             # install into the current repo
#   stack-install-precommit-hook /path/repo
#   stack-install-precommit-hook --guard-only  # the revert guard alone, no formatting on commit
#
# Note: git hooks live in the common git dir, so one install covers every linked
# worktree of the repo.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fmt="$here/stack-precommit-fmt"
guard="$here/stack-reparent-guard"
guard_only=0
[[ "${1:-}" == "--guard-only" ]] && { guard_only=1; shift; }
repo="${1:-$PWD}"
hooks_dir="$(git -C "$repo" rev-parse --absolute-git-dir)/hooks"
hook="$hooks_dir/pre-commit"

mkdir -p "$hooks_dir"

if [[ -e "$hook" ]] && ! grep -q "stack-precommit-fmt" "$hook" 2>/dev/null; then
  echo "✋ $hook already exists and isn't ours — leaving it alone." >&2
  echo "   Add this line to it yourself: \"$fmt\"" >&2
  exit 1
fi

{
  echo '#!/usr/bin/env bash'
  echo '# installed by stack-install-precommit-hook'
  echo '# refuse a commit that would bake a revert of merged work (soft-reset onto a moved ref)'
  echo "\"$guard\""
  if (( ! guard_only )); then
    echo '# oxfmt staged .ts/.tsx before commit'
    echo "\"$fmt\""
  fi
} > "$hook"
chmod +x "$hook"
echo "✓ pre-commit $( (( guard_only )) && echo "reparent guard" || echo "oxfmt + reparent guard") installed → $hook"
