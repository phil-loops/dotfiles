#!/usr/bin/env bash
# viewer-sandbox — a throwaway repo with real forests, and a viewer server over it.
#
#   viewer-sandbox <dir>                          build <dir>/repo (+ <dir>/origin.git, a local bare remote)
#   viewer-sandbox <dir> --serve <port> [--scripts <scripts-dir>]
#                                                 …and run the viewer over it (foreground)
#   viewer-sandbox <dir> --github [--serve …]     …with a fake GitHub: demo/queries + demo/model pushed
#                                                 as PRs #42/#43 with review threads (bot findings with
#                                                 suggestions, a teammate question, resolved, outdated),
#                                                 a teammate's PR imported as review/pr-77, and second-
#                                                 reader notes. <dir>/github.json IS that GitHub
#                                                 (STACK_REVIEW_GH_FAKE): review writes land there.
#
# Everything — pushes included — stays inside <dir>: origin is a bare repo next to it, and the
# server runs with STACK_REVIEW_SANDBOX=1 (no gh prewarm, focus restacks or pregates). Use it to
# exercise mutating viewer endpoints for real without touching a live branch. --scripts points
# the server at a worktree's scripts/ so you can test unlanded code.
set -euo pipefail

dir=${1:?usage: viewer-sandbox <dir> [--github] [--serve <port>] [--scripts <scripts-dir>]}
shift
port="" scripts="$HOME/.dotfiles/scripts" github=""
while (($#)); do
  case $1 in
    --github) github=1; shift ;;
    --serve) port=$2; shift 2 ;;
    --scripts) scripts=$2; shift 2 ;;
    *) echo "viewer-sandbox: unknown arg $1" >&2; exit 2 ;;
  esac
done

mkdir -p "$dir"
dir=$(cd "$dir" && pwd)
repo="$dir/repo"

commit() {   # [FILE=<path>] commit <subject> [body] — writes a file (named after the subject unless FILE says) so every commit has a diff
  local file="${FILE:-src/$(echo "$1" | tr -cs 'a-z0-9' '-' | cut -c1-40).ts}"
  mkdir -p "$repo/$(dirname "$file")"
  printf 'export const v = %s;\n' "$RANDOM" > "$repo/$file"
  git -C "$repo" add "$file"
  if [[ -n ${2:-} ]]; then git -C "$repo" commit -q -m "$1" -m "$2"; else git -C "$repo" commit -q -m "$1"; fi
}

put() {   # put <path> < content — stage a real source file; the next commit carries it beside its own
  mkdir -p "$(dirname "$repo/$1")"
  cat > "$repo/$1"
  git -C "$repo" add "$1"
}

branch() {   # branch <name> <parent> <project> <description>
  git -C "$repo" checkout -q -b "$1" "$2"
  git -C "$repo" config "branch.$1.stack-parent" "$2"
  git -C "$repo" config "branch.$1.stack-project" "$3"
  git -C "$repo" config "branch.$1.description" "$4"
  git -C "$repo" config --add "stack-project.$3.branch" "$1"
}

if [[ ! -d $repo/.git ]]; then
  git init -q --bare "$dir/origin.git"
  git init -q -b main "$repo"
  git -C "$repo" config user.name "Sandbox"
  git -C "$repo" config user.email "sandbox@example.com"
  git -C "$repo" remote add origin "$dir/origin.git"
  printf '# sandbox\n' > "$repo/README.md"
  printf 'node_modules\n.gen\n' > "$repo/.gitignore"   # stack-open links both into its scratch trees
  git -C "$repo" add README.md .gitignore && git -C "$repo" commit -q -m "chore: start the sandbox"
  # A small typed module graph threaded through the demo forest — an interface with JSDoc, an
  # import chain across files, a tsconfig — so the branch page's hover / go-to-definition
  # (srv/lsp.py) has real types to show. Each file rides an existing commit; the shape is unchanged.
  put tsconfig.json <<'TS'
{ "compilerOptions": { "target": "es2022", "module": "esnext", "moduleResolution": "bundler", "strict": true, "noEmit": true }, "include": ["src"] }
TS
  put src/widget.ts <<'TS'
/** A thing the dashboard can show. */
export interface Widget {
  id: string;
  name: string;
  /** Price in cents. */
  price: number;
}

/** Formats a widget as one dashboard line, e.g. `Lamp — $12.00`. */
export function formatWidget(w: Widget): string {
  return `${w.name} — $${(w.price / 100).toFixed(2)}`;
}
TS
  commit "feat: add the app shell"
  mkdir -p "$repo/.github"
  printf -- '---\n👮 Traffic Cop\n\n- [ ] Tested in staging\n- [ ] This PR contains migrations\n' > "$repo/.github/pull_request_template.md"
  git -C "$repo" add .github && git -C "$repo" commit -q -m "chore: add the PR template"
  git -C "$repo" push -q origin main

  git -C "$repo" config stack-project.demo.ticket LOO-9999
  branch demo/queries main demo "adds the widget queries"
  put src/queries/widgets.ts <<'TS'
import type { Widget } from "../widget";

const WIDGETS: Widget[] = [
  { id: "w1", name: "Lamp", price: 1200 },
  { id: "w2", name: "Desk", price: 18900 },
];

/** Every widget, cheapest first. */
export function listWidgets(): Widget[] {
  return [...WIDGETS].sort((a, b) => a.price - b.price);
}
TS
  FILE=queries/widget.ts commit "feat(loo-9999): add the widget queries" "Part of a stack (demo):

1. demo/queries — adds the widget queries  ← this branch
2. demo/model — moves widget rules into a model
3. demo/ui — shows widgets on the dashboard

The query layer stays thin: one Prisma call per function, no business logic, so the model above it can be tested with fakes."
  FILE=queries/widget.test.ts commit "test: cover the widget queries"
  branch demo/model demo/queries demo "moves widget rules into a model"
  put src/models/widget-rules.ts <<'TS'
import type { Widget } from "../widget";
import { listWidgets } from "../queries/widgets";

/** Widgets cheap enough for the dashboard, at most `max` cents each. */
export function affordableWidgets(max: number): Widget[] {
	return listWidgets().filter((w) => w.price <= max);
}
TS
  FILE=models/widget.ts commit "feat(loo-9999): move widget rules into a model"
  branch demo/ui demo/model demo "shows widgets on the dashboard"
  put src/ui/dashboard.ts <<'TS'
import { affordableWidgets } from "../models/widget-rules";
import { formatWidget } from "../widget";

/** The dashboard's lines for a budget in cents. */
export function dashboardLines(budget: number): string[] {
  return affordableWidgets(budget).map(formatWidget);
}
TS
  FILE=components/Dashboard.tsx commit "feat(loo-9999): show widgets on the dashboard"
  put src/models/widget-rules.ts <<'TS'
import type { Widget } from "../widget";
import { listWidgets } from "../queries/widgets";

const DEFAULT_LIMIT = 10;

/** Widgets cheap enough for the dashboard, at most `max` cents each. */
export function affordableWidgets(max: number, limit = DEFAULT_LIMIT): Widget[] {
	return listWidgets().filter((w) => w.price <= max).slice(0, limit);
}

/** A card label — the emoji is two UTF-16 units, so positions after it test the offset math. */
export const cardLabel = (w: Widget) => "💡 " + w.name;
TS
  FILE=components/WidgetCard.tsx commit "refactor: extract the widget card"
  put src/queries/widgets.ts <<'TS'
import type { Widget } from "../widget";

/** What the dashboard says when nothing fits the budget. */
export const EMPTY_LABEL = "no widgets";

const WIDGETS: Widget[] = [
  { id: "w1", name: "Lamp", price: 1200 },
  { id: "w2", name: "Desk", price: 18900 },
];

/** Every widget, cheapest first. */
export function listWidgets(): Widget[] {
  return [...WIDGETS].sort((a, b) => a.price - b.price);
}
TS
  FILE=components/WidgetEmpty.tsx commit "fix: keep the empty state when there are no widgets"
  branch demo/docs main demo "documents the widget api"
  commit "docs(loo-9999): document the widget api"
  git -C "$repo" push -q origin demo/docs

  branch solo/fix main solo "stops the login banner flickering"
  commit "fix: stop the login banner flickering"

  # a step that already landed and was contracted away lives on only in the merge ledger
  printf '{"merges": {"demo": [{"pr": 41, "title": "feat(loo-9999): add the widget table", "branch": "demo/schema", "at": "2026-10-20T10:00:00-07:00"}]}}\n' \
    > "$repo/.git/stack-project-merges.json"

  git -C "$repo" checkout -q main
  git -C "$repo" config stack.viewer-repos "$repo"
  echo "viewer-sandbox: built $repo (forests: demo ×4, solo ×1; origin = $dir/origin.git)"
fi


if [[ -n $github && ! -f $dir/github.json ]]; then
  git -C "$repo" push -q origin demo/queries demo/model
  # a teammate's PR, imported the way stack-review-import does it
  git -C "$repo" checkout -q -b review/pr-77 main
  put src/ui/banner.ts <<'TS'
/** Loads the login banner, retrying a failed fetch before showing the error. */
export async function loadBanner(fetchBanner: () => Promise<string>): Promise<string> {
  let last: unknown;
  for (let attempt = 0; attempt < 3; attempt++) {
    try {
      return await fetchBanner();
    } catch (e) {
      last = e;
    }
  }
  console.error("banner failed", last);
  return "";
}
TS
  git -C "$repo" -c user.name=Nalanj -c user.email=nalanj@example.com commit -q -m "fix: retry the banner fetch before giving up"
  git -C "$repo" push -q origin review/pr-77:nalanj/retry-banner
  git -C "$repo" config branch.review/pr-77.stack-parent origin/main
  git -C "$repo" config branch.review/pr-77.description "#77 retry the banner fetch — @nalanj"
  git -C "$repo" config --add stack.standalone review/pr-77
  git -C "$repo" checkout -q main
  python3 - "$dir" "$repo" <<'PY'
import json, os, subprocess, sys
d, repo = sys.argv[1], sys.argv[2]
sha = lambda r: subprocess.run(["git", "-C", repo, "rev-parse", r], capture_output=True, text=True).stdout.strip()
h42, h43, h77 = sha("demo/queries"), sha("demo/model"), sha("review/pr-77")
AT = "2026-10-22T16:%02d:00Z"
n = [0]
def c(author, body, commit, hunk=None, minute=0):
    n[0] += 1
    out = {"id": f"PRRC_sb{n[0]}", "db": n[0], "author": author, "body": body, "at": AT % minute,
           "url": f"https://github.com/sandbox/repo/pull/43#discussion_r{n[0]}", "commit": commit, "originalCommit": commit}
    if hunk is not None:
        out["hunk"] = hunk
    return out
def t(node, path, line, comments, start=None, resolved=False, outdated=False, original=None):
    return {"node": node, "path": path, "line": None if outdated else line, "startLine": start,
            "originalLine": original or line, "originalStartLine": start, "side": "RIGHT", "subject": "LINE",
            "outdated": outdated, "resolved": resolved, "canResolve": not resolved, "canUnresolve": resolved,
            "canReply": True, "comments": comments}
R = "src/models/widget-rules.ts"
bot, me, mate = "john-hankles", "sandbox-phil", "nalanj"
threads43 = [
    t("PRRT_sb1", R, 6, [c(bot, "`affordableWidgets` keeps placeholder widgets: one with `price: 0` passes `w.price <= max`, so the dashboard lists free placeholders as affordable.\n\n```suggestion\n\treturn listWidgets().filter((w) => w.price > 0 && w.price <= max);\n```", h43, "@@ -0,0 +1,7 @@\n+import type { Widget } from \"../widget\";", 4)]),
    t("PRRT_sb2", R, 5, [c(bot, "The doc comment drops the order the dashboard relies on: `listWidgets` sorts cheapest first, and `affordableWidgets` keeps that order.\n\n```suggestion\n/** Widgets the dashboard can afford — at most `max` cents each, cheapest first. */\nexport function affordableWidgets(max: number): Widget[] {\n```", h43, "", 5)], start=4),
    t("PRRT_sb3", R, 2, [c(mate, "Should this import the queries as a namespace (`import * as WidgetQueries from \"../queries/widgets\"`)? AGENTS.md asks for full namespace names.", h43, "", 9)]),
    t("PRRT_sb4", R, 1, [c(bot, "`Widget` is only used as a type here — `import type` keeps it out of the runtime graph.", h43, "", 3),
                          c(me, "Addressed in 4d6c4be: it's already `import type`.", h43, None, 12)], resolved=True),
    t("PRRT_sb5", "models/widget.ts", None, [c(bot, "A bare `v` export says nothing to a reader of the model layer; name what it holds.", h43, "@@ -0,0 +1 @@\n+export const v = 1;", 2)], outdated=True, original=1),
]
threads42 = [t("PRRT_sb6", "src/queries/widgets.ts", 9, [c(bot, "`listWidgets` copies before sorting — good; the doc comment could say so.", h42, "", 1),
                                                        c(me, "Addressed in 9f1e2d3: kept as is, the copy is the point.", h42, None, 6)], resolved=True)]
prs = {
    "42": {"id": "PR_sb42", "number": 42, "headRef": "demo/queries", "head": h42, "base": "main", "title": "feat(loo-9999): add the widget queries",
           "body": "## Intent\n- Adds the widget queries: one call per function, no business logic.\n\n## Where this sits\n→ **this PR**\n○ demo/model", "url": "https://github.com/sandbox/repo/pull/42",
           "state": "OPEN", "author": me, "botRan": True, "threads": threads42,
           "reviews": [{"id": "PRR_sb1", "author": bot, "state": "COMMENTED", "body": "", "at": AT % 1, "url": ""}], "comments": [], "pending": None},
    "43": {"id": "PR_sb43", "number": 43, "headRef": "demo/model", "head": h43, "base": "demo/queries", "title": "feat(loo-9999): move widget rules into a model",
           "body": "## Intent\n- Moves the widget rules out of the dashboard into `models/widget-rules.ts`.\n- The dashboard shows only widgets within budget.\n\n## Not in this PR\n- Showing widgets on the dashboard — up next\n\n## Where this sits\nStacked on: #42\n✓ #41 add the widget table\n○ #42 add the widget queries\n→ **this PR**",
           "url": "https://github.com/sandbox/repo/pull/43", "state": "OPEN", "author": me, "botRan": True, "threads": threads43,
           "reviews": [{"id": "PRR_sb2", "author": bot, "state": "COMMENTED", "body": "", "at": AT % 5, "url": ""},
                       {"id": "PRR_sb3", "author": mate, "state": "COMMENTED", "body": "One question inline.", "at": AT % 9, "url": ""}],
           "comments": [{"id": "IC_sb1", "author": bot, "body": "**Review** — 3 findings on this diff, 1 already resolved. Claims 1–2 hold.", "at": AT % 6, "url": ""}],
           "pending": None},
    "77": {"id": "PR_sb77", "number": 77, "headRef": "nalanj/retry-banner", "head": h77, "base": "main", "title": "fix: retry the banner fetch before giving up",
           "body": "Retries a failed banner fetch twice before showing the error, so a flaky edge doesn't blank the login page.", "url": "https://github.com/sandbox/repo/pull/77",
           "state": "OPEN", "author": mate, "botRan": False, "threads": [], "reviews": [], "comments": [], "pending": None},
}
json.dump({"viewer": me, "prs": prs, "seq": 100, "log": []}, open(os.path.join(d, "github.json"), "w"), indent=1)
json.dump({"demo/queries": {"number": 42, "state": "OPEN", "url": prs["42"]["url"], "title": prs["42"]["title"], "review": "REVIEW_REQUIRED", "baseRef": "main"},
           "demo/model": {"number": 43, "state": "OPEN", "url": prs["43"]["url"], "title": prs["43"]["title"], "review": "REVIEW_REQUIRED", "baseRef": "demo/queries"}},
          open(os.path.join(d, "pr-fixture.json"), "w"), indent=1)
notes = os.path.join(repo, ".git", "stack-review-notes", "43")
os.makedirs(notes, exist_ok=True)
json.dump({"verdict": "right", "evidence": [{"path": R, "line": 6, "why": "the filter admits price 0"}],
           "elsewhere": [{"path": "src/ui/dashboard.ts", "line": 6, "branch": "demo/ui", "why": "maps the same unfiltered list"},
                         {"path": "src/queries/widgets.ts", "line": 9, "branch": "demo/queries", "why": "sorts placeholders first"}],
           "cause": "listWidgets has no notion of a placeholder, so each caller filters on its own.",
           "draftReply": "Agreed — zero-priced placeholders are filtered out here now. The query still returns them; demo/ui inherits the fix through this model.",
           "model": "opus", "at": "2026-10-22T17:00:00Z"}, open(os.path.join(notes, "PRRT_sb1.json"), "w"), indent=1)
json.dump({"verdict": "partly", "evidence": [{"path": R, "line": 2, "why": "a bare named import of one function"}], "elsewhere": [],
           "cause": None, "draftReply": "Yes — switching to `import * as WidgetQueries` here.", "model": "opus", "at": "2026-10-22T17:00:00Z"},
          open(os.path.join(notes, "PRRT_sb3.json"), "w"), indent=1)
json.dump({"items": [{"path": R, "line": 5, "why": "`max` is never checked — a negative budget silently returns nothing"}], "model": "opus", "at": "2026-10-22T17:00:00Z"},
          open(os.path.join(notes, "_unflagged.json"), "w"), indent=1)
PY
  echo "viewer-sandbox: fake GitHub at $dir/github.json (PRs #42 #43 on demo/*, #77 as review/pr-77)"
fi

if [[ -n $port ]]; then
  if [[ -f $dir/github.json ]]; then
    export STACK_REVIEW_GH_FAKE="$dir/github.json"
    export STACK_OUTBOX_PR_FIXTURE="${STACK_OUTBOX_PR_FIXTURE:-$dir/pr-fixture.json}"
  fi
  mkdir -p "$dir/serve"
  # stack-open's scratch worktrees and the viewer's tsgo stay inside the sandbox too
  export STACK_OPEN_DIR="$dir/stack-study" STACK_LSP_STATE_DIR="$dir/lsp"
  echo "viewer-sandbox: serving $repo on http://127.0.0.1:$port (scripts: $scripts)"
  STACK_REVIEW_SANDBOX=1 exec python3 "$scripts/stack-review-server.py" "$dir/serve" "$scripts" "$repo" "$port"
fi
