#!/usr/bin/env python3
"""stack-review-run — review one branch's diff with a headless, read-only claude and write the verdict.

  stack-review-run --branch <b> --out <verdict.json> [--depth light|standard|full] [--repo DIR]

The viewer server spawns this (POST /review) and records the verdict it writes — tree-keyed review
flags in git config — so a review verdict only ever comes from a review that ran. Run by hand it
prints the verdict and records nothing.

The diff is <parent>...<branch> (parent = branch.<b>.stack-parent, else main). With no --depth, the
depth follows from what the diff touches (push-ready's table): queries/models/migrations/auth →
full, any other code → standard, docs/config only → light. The model reads the code in a detached
worktree at the tip and never edits; its findings come back CONFIRMED (verified against the code,
with evidence) or PLAUSIBLE.

Bounded like stack-second-reader (shares its machine-wide claude slots and memory floor).
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
os.environ.setdefault("STACK_SECOND_READER_TIMEOUT", os.environ.get("STACK_REVIEW_RUN_TIMEOUT", "1500"))
_loader = importlib.machinery.SourceFileLoader("second_reader", os.path.join(HERE, "stack-second-reader"))
_spec = importlib.util.spec_from_loader("second_reader", _loader)
sr = importlib.util.module_from_spec(_spec)
_loader.exec_module(sr)

DIFF_CAP = 120_000
FULL = re.compile(r"(^|/)(queries|models|migrations)/|(^|/)(auth|permission|session|middleware)[^/]*\.|/auth/|schema\.prisma$")
LIGHT = re.compile(r"\.(md|mdx|txt|json|ya?ml|toml|ini|cfg|lock)$|(^|/)(docs?|\.github)/")
MODELS = {"light": "sonnet", "standard": "opus", "full": "opus"}

PROMPT = """You review one branch of a stacked-PR forest before it is pushed. Do not modify anything.

Branch `{branch}`, diffed against `{parent}` (merge base {base}); tip {tip}. You are in a detached checkout
of the tip. Read files and run read-only git commands (`git show`, `git diff {base} {tip} -- <path>`,
`git grep`, `git log`) as needed. The diff:

```diff
{diff}
```

Depth: {depth}. {depth_note}

Three lenses, in this order.

1. The repository's own rules. Read AGENTS.md at the repository root first (and CLAUDE.md, and the
skills under .agents/skills/ that the diff's kind of change calls for). Check the diff against every
rule that applies: which layer each piece of code belongs in and what it may call, where tests go and
what they test, comments, naming, PR shape. Report each violation as a finding that quotes the rule.

2. Inherited habits. Code is often copied from a sibling file. For each piece of the diff that looks
copied — boilerplate, cleanup calls, a defensive re-check of something already checked, usage
printers, argument massaging, return values only a test reads — say what it does in THIS change. If
it does nothing this change needs, report it as a habit, naming the sibling it likely came from. Open
that sibling and walk both files side by side: every piece the two share is a candidate, and each one
that this change doesn't need is its own finding — don't stop at the first.

3. Defects. Find real defects: correctness bugs, broken invariants, unsafe or irreversible behavior, missing error
handling where it matters, tests that pass for the wrong reason, comments or messages that say something
the code does not do. For every line the diff REMOVES or rewrites, check that each condition or guard it
dropped is accounted for (a filter, a null/undefined check, an early return).

Don't report personal style preferences the repository's rules don't state, or what a type checker,
linter or formatter would catch.

Verify each finding against the code before you report it. Mark it CONFIRMED only when you read the code
that proves it, and say what you read; otherwise PLAUSIBLE. Write each summary in plain short sentences.

End your answer with one JSON object and nothing after it:
{{"findings": [{{"file": "<repo-relative path>", "line": <int>, "verdict": "CONFIRMED|PLAUSIBLE",
"lens": "rule|habit|defect", "summary": "<one sentence: the problem>",
"evidence": "<what you read that shows it: the rule's words, the sibling, the code>"}}]}}
An empty list means you found nothing worth a reviewer's time."""

DEPTH_NOTES = {
    "light": "Docs/config only: check that what they say is true of the code, and nothing else.",
    "standard": "Review the whole diff carefully.",
    "full": "This touches data access, models, migrations or auth: trace every caller of what changed and "
            "every path into it, and check authorization and data-loss cases explicitly.",
}


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)


def depth_for(files):
    if any(FULL.search(f) for f in files):
        return "full"
    if files and all(LIGHT.search(f) for f in files):
        return "light"
    return "standard"


def emit(path, verdict):
    text = json.dumps(verdict, indent=1)
    if path:
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write(text)
        os.replace(tmp, path)
    print(text, flush=True)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--branch", required=True)
    ap.add_argument("--out")
    ap.add_argument("--depth", choices=("light", "standard", "full"))
    ap.add_argument("--repo", default=os.getcwd())
    a = ap.parse_args()
    repo, branch = a.repo, a.branch

    tip = git(repo, "rev-parse", "--verify", f"{branch}^{{commit}}").stdout.strip()
    if not tip:
        return emit(a.out, {"ok": False, "branch": branch, "err": f"no branch {branch}"}) or 1
    tree = git(repo, "rev-parse", f"{tip}^{{tree}}").stdout.strip()
    parent = git(repo, "config", f"branch.{branch}.stack-parent").stdout.strip() or "main"
    base = git(repo, "merge-base", parent, tip).stdout.strip()
    files = [f for f in git(repo, "diff", "--name-only", base, tip).stdout.splitlines() if f]
    depth = a.depth or depth_for(files)
    head = {"branch": branch, "tip": tip, "tree": tree, "parent": parent, "base": base,
            "depth": depth, "auto": not a.depth, "files": len(files)}
    if not files:
        return emit(a.out, {"ok": True, **head, "findings": [], "note": "empty diff"})

    diff = git(repo, "diff", base, tip).stdout
    if len(diff) > DIFF_CAP:
        diff = diff[:DIFF_CAP] + f"\n… diff truncated at {DIFF_CAP} chars — read the rest with git diff\n"
    prompt = PROMPT.format(branch=branch, parent=parent, base=base, tip=tip, diff=diff,
                           depth=depth, depth_note=DEPTH_NOTES[depth])

    wt = tempfile.mkdtemp(prefix="stack-review-run-")
    t0 = time.time()
    try:
        r = git(repo, "worktree", "add", "--detach", wt, tip)
        if r.returncode != 0:
            return emit(a.out, {"ok": False, **head, "err": f"worktree: {r.stderr.strip()[:300]}"}) or 1
        try:
            text, usage = sr.run_claude(prompt, wt, MODELS[depth], meta={"kind": "review-run", "branch": branch})
        except RuntimeError as e:
            return emit(a.out, {"ok": False, **head, "err": str(e)[:500]}) or 1
    finally:
        git(repo, "worktree", "remove", "--force", wt)
        shutil.rmtree(wt, ignore_errors=True)

    got = sr.last_json_object(text)
    if not isinstance(got, dict) or not isinstance(got.get("findings"), list):
        return emit(a.out, {"ok": False, **head, "err": "the review returned no findings JSON",
                            "raw": (text or "")[-2000:]}) or 1
    findings = []
    for f in got["findings"]:
        if not isinstance(f, dict) or not f.get("summary"):
            continue
        verdict = str(f.get("verdict", "")).upper()
        lens = str(f.get("lens") or "defect").lower()
        lens = lens if lens in ("rule", "habit", "defect") else "defect"
        summary = str(f["summary"]).strip()
        findings.append({"file": str(f.get("file") or ""), "line": f.get("line") if isinstance(f.get("line"), int) else None,
                         "verdict": verdict if verdict in ("CONFIRMED", "PLAUSIBLE") else "PLAUSIBLE", "lens": lens,
                         "summary": summary if lens == "defect" else f"[{lens}] {summary}",
                         "evidence": str(f.get("evidence") or "").strip()})
    emit(a.out, {"ok": True, **head, "findings": findings, "model": MODELS[depth],
                 "secs": round(time.time() - t0, 1), "cost": usage.get("cost")})
    return 0


if __name__ == "__main__":
    sys.exit(main())
