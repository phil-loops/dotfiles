#!/usr/bin/env python3
"""stack-review-run — review one branch's diff with a headless, read-only claude and write the verdict.

  stack-review-run --branch <b> --out <verdict.json> [--depth light|standard|full] [--repo DIR]

The viewer server spawns this (POST /review) and records the verdict it writes — tree-keyed review
flags in git config — so a review verdict only ever comes from a review that ran. Run by hand it
prints the verdict and records nothing.

The diff is <parent>...<branch> (parent = branch.<b>.stack-parent, else main). With no --depth, the
depth follows from what the diff touches (push-ready's table): queries/models/migrations/auth →
full, any other code → standard, docs/config only → light. The model reads the code in a detached
worktree at the tip and never edits; its findings come back CONFIRMED (verified against the code,
with evidence) or PLAUSIBLE.

Five lenses: the repo's rules, inherited habits, defects, the reviewer checklist
(claude/hankles-checklist.md, read each run, with a pre-scan of added lines for an explicit `any` or
a cast), and scope (the branch's description, its parent's, its commit subjects). The verdict's
`covered` says which of them had their input, so a review that skipped one shows it.

Bounded like stack-second-reader (shares its machine-wide claude slots and memory floor).
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
os.environ.setdefault("STACK_SECOND_READER_TIMEOUT", os.environ.get("STACK_REVIEW_RUN_TIMEOUT", "1500"))
_loader = importlib.machinery.SourceFileLoader("second_reader", os.path.join(HERE, "stack-second-reader"))
_spec = importlib.util.spec_from_loader("second_reader", _loader)
sr = importlib.util.module_from_spec(_spec)
_loader.exec_module(sr)

DIFF_CAP = 120_000
FULL = re.compile(r"(^|/)(queries|models|migrations)/|(^|/)(auth|permission|session|middleware)[^/]*\.|/auth/|schema\.prisma$")
LIGHT = re.compile(r"\.(md|mdx|txt|json|ya?ml|toml|ini|cfg|lock)$|(^|/)(docs?|\.github)/")
MODELS = {"light": "sonnet", "standard": "opus", "full": "opus"}

PROMPT = """You review one branch of a stacked-PR forest before it is pushed. Do not modify anything.

Branch `{branch}`, diffed against `{parent}` (merge base {base}); tip {tip}. You are in a detached checkout
of the tip. Read files and run read-only git commands (`git show`, `git diff {base} {tip} -- <path>`,
`git grep`, `git log`) as needed.

What the branch says it does:
{scope}

The diff:

```diff
{diff}
```

Depth: {depth}. {depth_note}

Five lenses, in this order.

1. The repository's own rules. Read AGENTS.md at the repository root first (and CLAUDE.md, and the
skills under .agents/skills/ that the diff's kind of change calls for). Check the diff against every
rule that applies: which layer each piece of code belongs in and what it may call, where tests go and
what they test, comments, naming, PR shape. Report each violation as a finding that quotes the rule.

2. Inherited habits. Code is often copied from a sibling file. For each piece of the diff that looks
copied — boilerplate, cleanup calls, a defensive re-check of something already checked, usage
printers, argument massaging, return values only a test reads — say what it does in THIS change. If
it does nothing this change needs, report it as a habit, naming the sibling it likely came from. Open
that sibling and walk both files side by side: every piece the two share is a candidate, and each one
that this change doesn't need is its own finding — don't stop at the first.

3. Defects. Find real defects: correctness bugs, broken invariants, unsafe or irreversible behavior, missing error
handling where it matters, tests that pass for the wrong reason, comments or messages that say something
the code does not do. For every line the diff REMOVES or rewrites, check that each condition or guard it
dropped is accounted for (a filter, a null/undefined check, an early return).

4. What this repository's PR reviewer gets accepted. These are the findings its reviewer bot raises
that authors then accept. Check the diff for each item, and tag what you find `rule`, naming the
item in the evidence.

{checklist}

A scan of the diff's ADDED lines found these untyped holes: an explicit `any` in a parameter, field,
return type or generic argument, `as any`, or `as unknown as`. Neither tool catches them here: tsc
accepts an explicit `any`, and this repository's oxlint turns `no-explicit-any` off. Report each one
under checklist item "Casts", unless the code around it shows the type cannot be named (an untyped
third-party value at a boundary, say). If so, say why in a PLAUSIBLE finding. A mock takes its real
signature: `t.mock.fn<DepsType["fnName"]>(…)` or `mock.fn<typeof fn>(…)`, never `(_input: any) => …`.

{prescan}

5. Scope. Every hunk must be explained by the branch's description or by one of its commit subjects
(both above). A hunk that none of them explains is a finding, tagged `rule`, that quotes the
description. Look hardest at hunks in tests and shared helpers. {parent_note}

Don't report what tsc or oxlint, as this repository configures them, already fail on. An explicit
`any`, `as any` and `as unknown as` are NOT among those (lens 4). Don't report personal style
preferences that neither the repository's rules nor the checklist state. Stay quiet on these, which
authors decline:

{quiet}

Verify each finding against the code before you report it. Mark it CONFIRMED only when you read the code
that proves it, and say what you read; otherwise PLAUSIBLE. Write each summary in plain short sentences.

End your answer with one JSON object and nothing after it:
{{"findings": [{{"file": "<repo-relative path>", "line": <int>, "verdict": "CONFIRMED|PLAUSIBLE",
"lens": "rule|habit|defect", "summary": "<one sentence: the problem>",
"evidence": "<what you read that shows it: the rule's words, the sibling, the code>"}}]}}
An empty list means you found nothing worth a reviewer's time."""

DEPTH_NOTES = {
    "light": "Docs/config only: check that what they say is true of the code, and that each change is in scope (lens 5).",
    "standard": "Review the whole diff carefully.",
    "full": "This touches data access, models, migrations or auth: trace every caller of what changed and "
            "every path into it, and check authorization and data-loss cases explicitly.",
}


CHECKLIST = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "claude", "hankles-checklist.md")
CODE = re.compile(r"\.(ts|tsx|mts|cts|js|jsx|mjs|cjs)$")
# an explicit any in a parameter/field/return type (`: any`), a generic argument (`<any>`, `<T, any>`,
# `any[]`), or a cast (`as any`, `as unknown as`)
UNTYPED = re.compile(r"\bas\s+any\b|\bas\s+unknown\s+as\b|:\s*any\b|<\s*any\b|,\s*any\s*[>,\])]|\bany\s*\[\]")
PRESCAN_CAP = 60


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)


def checklist():
    """The reviewer checklist's two halves, read fresh each run: (check for, stay quiet on)."""
    try:
        with open(CHECKLIST) as f:
            text = f.read()
    except OSError:
        return None, None
    check, _, quiet = text.partition("\n## Stay quiet on")
    check = check.split("\n## Check for", 1)[-1].strip()
    quiet = quiet.split("\n", 1)[-1].strip() if quiet else ""
    return check, quiet


def prescan(diff):
    """Added lines of code files holding an untyped hole: [(path, new-side line, text)]."""
    hits, path, n = [], None, 0
    for ln in diff.splitlines():
        if ln.startswith("+++ "):
            p = ln[4:]
            path = p[2:] if p.startswith("b/") else None
        elif ln.startswith("@@"):
            m = re.search(r"\+(\d+)", ln)
            n = int(m.group(1)) if m else 0
        elif path is None or ln.startswith("\\"):
            continue
        elif ln.startswith("+"):
            if CODE.search(path) and UNTYPED.search(ln[1:]):
                hits.append((path, n, ln[1:].strip()))
            n += 1
        elif not ln.startswith("-"):
            n += 1
    return hits


def scope_of(repo, branch, parent, base, tip, carried=frozenset()):
    """The branch's own words for the scope lens: its description, its parent's, its commit subjects
    (its own commits only: carried ones are reviewed on the branch they come from)."""
    desc = git(repo, "config", f"branch.{branch}.description").stdout.strip()
    pdesc = git(repo, "config", f"branch.{parent}.description").stdout.strip() if parent != "main" else ""
    subjects = "\n".join(ln.split(" ", 1)[1] for ln in
                         git(repo, "log", "--reverse", "--format=%H %h %s", f"{base}..{tip}").stdout.splitlines()
                         if ln.split(" ", 1)[0] not in carried)
    text = [f"- description: {desc}" if desc else "- description: (none: the branch has no description; report that, and judge scope by the commits)",
            "- commits, oldest first:\n" + "\n".join(f"    {s}" for s in subjects.splitlines()) if subjects else "- commits: (none)"]
    if parent != "main":
        text.append(f"- its parent `{parent}` describes itself: {pdesc}" if pdesc else f"- its parent `{parent}` has no description")
    note = (f"This branch is stacked on `{parent}`: judge it only on what it adds on top. A hunk that does the work "
            f"the parent's description names belongs in the parent, so report it.") if parent != "main" else ""
    covered = {"description": bool(desc), "commits": len(subjects.splitlines()) if subjects else 0}
    if parent != "main":
        covered["parent_description"] = bool(pdesc)
    return "\n".join(text), note, covered


def own_base(repo, branch, base, tip):
    """The base this branch's own work is diffed against: its parent's merge base plus the commits it
    carries from its `requires` deps.
    Reviewing parent...branch whole judged carried code as this branch's own scope (2026-11-17: three
    goal-flip-converter branches flagged for capabilities they only carried). Returns (base, carried
    shas); if the carried commits don't replay onto the base, the plain base and no carried shas.
    A commit counts as carried when it is in a dep outright or `git cherry` matches its patch there."""
    deps = [d for d in git(repo, "config", "--get-all", f"branch.{branch}.stack-requires").stdout.split() if d]
    carried = set()
    own = set(git(repo, "rev-list", f"{base}..{tip}").stdout.split())
    for dep in deps:
        # in the dep outright (the cherry-pick reproduced its commit) …
        carried |= own - set(git(repo, "rev-list", f"{dep}..{tip}").stdout.split())
        # … or a copy of one of its patches
        for ln in git(repo, "cherry", dep, tip, base).stdout.splitlines():
            if ln.startswith("- "):
                carried.add(ln[2:].strip())
    if not carried:
        return base, []
    order = [c for c in git(repo, "rev-list", "--reverse", f"{base}..{tip}").stdout.split() if c in carried]
    wt = tempfile.mkdtemp(prefix="stack-review-base-")
    try:
        if git(repo, "-c", "core.hooksPath=/dev/null", "worktree", "add", "--detach", wt, base).returncode != 0:
            return base, []
        pick = ["-c", "core.hooksPath=/dev/null", "-c", "user.name=stack-review-run", "-c", "user.email=stack-review-run@localhost"]
        for c in order:
            if git(wt, *pick, "cherry-pick", "--empty=drop", "--allow-empty-message", c).returncode != 0:
                git(wt, "cherry-pick", "--abort")
                return base, []
        return git(wt, "rev-parse", "HEAD").stdout.strip(), order
    finally:
        git(repo, "worktree", "remove", "--force", wt)
        shutil.rmtree(wt, ignore_errors=True)


def depth_for(files):
    if any(FULL.search(f) for f in files):
        return "full"
    if files and all(LIGHT.search(f) for f in files):
        return "light"
    return "standard"


def emit(path, verdict):
    text = json.dumps(verdict, indent=1)
    if path:
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write(text)
        os.replace(tmp, path)
    print(text, flush=True)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--branch", required=True)
    ap.add_argument("--out")
    ap.add_argument("--depth", choices=("light", "standard", "full"))
    ap.add_argument("--repo", default=os.getcwd())
    a = ap.parse_args()
    repo, branch = a.repo, a.branch

    tip = git(repo, "rev-parse", "--verify", f"{branch}^{{commit}}").stdout.strip()
    if not tip:
        return emit(a.out, {"ok": False, "branch": branch, "err": f"no branch {branch}"}) or 1
    tree = git(repo, "rev-parse", f"{tip}^{{tree}}").stdout.strip()
    parent = git(repo, "config", f"branch.{branch}.stack-parent").stdout.strip() or "main"
    base = git(repo, "merge-base", parent, tip).stdout.strip()
    base, carried = own_base(repo, branch, base, tip)
    files = [f for f in git(repo, "diff", "--name-only", base, tip).stdout.splitlines() if f]
    depth = a.depth or depth_for(files)
    head = {"branch": branch, "tip": tip, "tree": tree, "parent": parent, "base": base,
            "depth": depth, "auto": not a.depth, "files": len(files), "carried": len(carried)}
    if not files:
        return emit(a.out, {"ok": True, **head, "findings": [], "note": "empty diff"})

    diff = git(repo, "diff", base, tip).stdout
    hits = prescan(diff)  # the whole diff, before the cap
    if len(diff) > DIFF_CAP:
        diff = diff[:DIFF_CAP] + f"\n… diff truncated at {DIFF_CAP} chars — read the rest with git diff\n"
    check, quiet = checklist()
    scope, parent_note, scope_cov = scope_of(repo, branch, parent, base, tip, set(carried))
    listed = "\n".join(f"- {p}:{n}: `{t}`" for p, n, t in hits[:PRESCAN_CAP])
    if len(hits) > PRESCAN_CAP:
        listed += f"\n- … and {len(hits) - PRESCAN_CAP} more: grep the added lines yourself"
    prompt = PROMPT.format(branch=branch, parent=parent, base=base, tip=tip, diff=diff, scope=scope,
                           depth=depth, depth_note=DEPTH_NOTES[depth], parent_note=parent_note,
                           checklist=check or f"(the checklist at {CHECKLIST} could not be read: say so in a finding)",
                           prescan=listed or "(the scan found none)",
                           quiet=quiet or "(the checklist's stay-quiet list could not be read)")
    covered = {"rules": True, "habits": True, "defects": True, "checklist": check is not None,
               "scope": scope_cov, "prescan": len(hits)}

    wt = tempfile.mkdtemp(prefix="stack-review-run-")
    t0 = time.time()
    try:
        # hooks off: the repo's post-checkout queues a seed-gen --sync (types, packages) for every new
        # worktree, which a read-only review never uses and deletes minutes later; under a busy
        # review day those syncs held every heavy-turn slot (2026-11-17)
        r = git(repo, "-c", "core.hooksPath=/dev/null", "worktree", "add", "--detach", wt, tip)
        if r.returncode != 0:
            return emit(a.out, {"ok": False, **head, "err": f"worktree: {r.stderr.strip()[:300]}"}) or 1
        try:
            text, usage = sr.run_claude(prompt, wt, MODELS[depth], meta={"kind": "review-run", "branch": branch})
        except RuntimeError as e:
            return emit(a.out, {"ok": False, **head, "err": str(e)[:500]}) or 1
    finally:
        git(repo, "worktree", "remove", "--force", wt)
        shutil.rmtree(wt, ignore_errors=True)

    got = sr.last_json_object(text)
    if not isinstance(got, dict) or not isinstance(got.get("findings"), list):
        return emit(a.out, {"ok": False, **head, "err": "the review returned no findings JSON",
                            "raw": (text or "")[-2000:]}) or 1
    findings = []
    for f in got["findings"]:
        if not isinstance(f, dict) or not f.get("summary"):
            continue
        verdict = str(f.get("verdict", "")).upper()
        lens = str(f.get("lens") or "defect").lower()
        lens = lens if lens in ("rule", "habit", "defect") else "defect"
        summary = str(f["summary"]).strip()
        findings.append({"file": str(f.get("file") or ""), "line": f.get("line") if isinstance(f.get("line"), int) else None,
                         "verdict": verdict if verdict in ("CONFIRMED", "PLAUSIBLE") else "PLAUSIBLE", "lens": lens,
                         "summary": summary if lens == "defect" else f"[{lens}] {summary}",
                         "evidence": str(f.get("evidence") or "").strip()})
    emit(a.out, {"ok": True, **head, "findings": findings, "covered": covered, "model": MODELS[depth],
                 "secs": round(time.time() - t0, 1), "cost": usage.get("cost")})
    return 0


if __name__ == "__main__":
    sys.exit(main())
