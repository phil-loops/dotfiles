#!/bin/zsh
# prwatch — your open PRs at a glance, and watch a PR's CI checks till they settle.
#
#   prwatch              list your open PRs (with a live check rollup) and fzf-pick
#                        one to watch
#   prwatch <number>     watch that PR's checks directly (searches your repos)
#   prwatch <url>        watch a .../pull/<n> URL's checks, or a .../actions/runs/<id>
#                        Actions-run URL to completion
#   prwatch -l|--list    just list; don't watch
#   prwatch --await <b>  wait for branch <b>'s PR, watch its CI to completion, then
#                        notify & exit — backgrounded by the pre-push hook (on-demand)
#   prwatch --tracking   list the PRs whose CI is being watched right now (the live
#                        --await processes); also what the SwiftBar menu badge reads
#   prwatch --sweep      one quiet polling pass (for launchd): notify on PRs that
#                        newly fail, recover, or first appear already green — a
#                        source-agnostic "PR opened"
#                        monitor (catches PRs opened on the web). See prwatch.plist.
#
# "Watch" streams gh's check status until every check passes or one fails, then
# fires a desktop notification (+ a terminal bell). It scans your fork AND the
# team repo, since CI usually runs on the team-repo PR — override the set with
#   git config stack.pr-repos "owner/repo owner/repo"
#
# Rollup glyphs:  ✓ all pass   ● running   ✗ failing   ○ no checks reported
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

repos=(${=$(git config stack.pr-repos 2>/dev/null || true)})
(( ${#repos} )) || repos=(phil-loops/loops Loops-so/loops)

# Clean up the tracking marker on real shell exit / ctrl-c. Must live at top
# level: in zsh a `trap ... EXIT` set inside a function is function-local and
# fires the instant that function returns — which would delete the marker
# register_watch just wrote. _marker is a process-global set by register_watch.
_marker=""
trap '[[ -n "$_marker" ]] && rm -f "$_marker"; open -g "swiftbar://refreshplugin?name=prwatch" 2>/dev/null' EXIT INT TERM

# jq program: one open PR → "number<TAB>rollup<TAB>title<TAB>branch"
# (single-quoted so no shell interpolation; statusCheckRollup states vary by
#  check type — conclusion for completed, status/state while in flight.)
ROLL_JQ='
def f: ["FAILURE","ERROR","CANCELLED","TIMED_OUT","STARTUP_FAILURE","ACTION_REQUIRED"];
def p: ["PENDING","IN_PROGRESS","QUEUED","EXPECTED","WAITING","REQUESTED"];
.[] | [
  (.number|tostring),
  ( [.statusCheckRollup[]?
      # conclusion (CheckRun, when finished) → status (CheckRun, in flight) → state (StatusContext).
      # an empty-string conclusion means "not finished" — fall through to status.
      | ((.conclusion | select(. != "")) // .status // .state // "PENDING")] as $st
    | ($st|length) as $n
    | ([$st[] | select(. as $x | f | index($x))] | length) as $nf   # bind $x; f|index(.) would rebind . to f
    | ([$st[] | select(. as $x | p | index($x))] | length) as $np
    | if   $n==0  then "○ no checks"
      elif $nf>0  then "✗ \($nf) failing"
      elif $np>0  then "● \($np) running"
      else             "✓ all pass" end ),
  .title,
  .headRefName
] | @tsv'

notify() {  # $1 status   $2 detail   $3 url (optional — opened when you click it)
  print -n '\a'
  # Prefer terminal-notifier: posts under its own identity (clicking opens $3, the
  # PR/run — not Script Editor) and lands in Notification Center. Fall back to
  # osascript, whose notifications are owned by "Script Editor", so clicking one
  # just opens that app (install terminal-notifier to fix: brew install terminal-notifier).
  if command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title "prwatch · $1" -message "${2:-$1}" -sound Glass \
      ${3:+-open "$3"} >/dev/null 2>&1
  else
    local t="prwatch · $1" m="${2:-$1}"
    t=${t//\\/\\\\}; t=${t//\"/\\\"}; m=${m//\\/\\\\}; m=${m//\"/\\\"}
    osascript >/dev/null 2>&1 \
      -e "display notification \"$m\" with title \"$t\" sound name \"Glass\"" || true
  fi
}

register_watch() {  # $1 key  $2 repo  $3 id  $4 title  $5 url — track a live watch for the badge
  local d="$HOME/.cache/prwatch/tracking"; mkdir -p "$d"
  _marker="$d/$1.tsv"   # process-global so the EXIT trap can see it
  if [[ -f "$_marker" ]]; then                       # dedup: a live watcher on this key → reuse
    local epid=$(cut -f6 "$_marker" 2>/dev/null)
    if [[ -n "$epid" ]] && kill -0 "$epid" 2>/dev/null; then
      open -g "swiftbar://refreshplugin?name=prwatch" 2>/dev/null
      echo "prwatch: already watching $2#$3 (pid $epid)"; exit 0
    fi
  fi
  print -r -- "$2"$'\t'"$3"$'\t'"$4"$'\t'"$5"$'\t'"$(date +%s)"$'\t'"$$" > "$_marker"
  # cleanup trap lives at top level (set near the script header) — a function-local
  # `trap ... EXIT` would fire on return and delete the marker we just wrote.
  open -g "swiftbar://refreshplugin?name=prwatch" 2>/dev/null   # no-op until SwiftBar installed
}

watch_pr() {  # $1 repo  $2 number
  local repo="$1" num="$2" url="https://github.com/$1/pull/$2"
  local title=$(gh pr view "$num" --repo "$repo" --json title --jq .title 2>/dev/null)
  register_watch "${repo//\//-}-${num}" "$repo" "$num" "${title:-PR #$num}" "$url"
  print -P "%F{yellow}⟳%f watching ${repo}#${num} — ctrl-c to stop"
  if gh pr checks "$num" --repo "$repo" --watch; then
    print -P "%F{green}✓ ${repo}#${num} — all checks passed%f"
    notify "✓ passed" "${repo}#${num} — all checks green" "$url"
  else
    print -P "%F{red}✗ ${repo}#${num} — a check failed (or none reported)%f"
    notify "✗ failed" "${repo}#${num} — a check failed" "$url"
  fi
}

watch_run() {  # $1 repo  $2 run-id — watch a single Actions run to completion
  local repo="$1" rid="$2" url="https://github.com/$1/actions/runs/$2"
  register_watch "${repo//\//-}-run-${rid}" "$repo" "$rid" "run $rid" "$url"
  print -P "%F{yellow}⟳%f watching run ${repo} #${rid} — ctrl-c to stop"
  if gh run watch "$rid" --repo "$repo" --exit-status; then
    print -P "%F{green}✓ run ${rid} — succeeded%f"
    notify "✓ run passed" "${repo} run ${rid} succeeded" "$url"
  else
    print -P "%F{red}✗ run ${rid} — failed%f"
    notify "✗ run failed" "${repo} run ${rid} failed" "$url"
  fi
}

# rows: "repo<TAB>number<TAB>rollup<TAB>title<TAB>branch" across all repos
collect() {
  local repo
  for repo in $repos; do
    gh pr list --repo "$repo" --author @me --state open \
      --json number,title,headRefName,statusCheckRollup --jq "$ROLL_JQ" 2>/dev/null \
      | awk -v r="$repo" 'NF{print r"\t"$0}'   # awk \t = a real tab (BSD sed won't)
  done
}

# --- direct: prwatch <github-url> ---------------------------------------------
# An Actions run URL → watch that run; a pull URL → watch that PR's checks.
#   https://github.com/<owner>/<repo>/actions/runs/<id>[/job/<id>]
#   https://github.com/<owner>/<repo>/pull/<n>
if [[ "${1:-}" == http(s|)://github.com/* ]]; then
  url="$1"
  ownerrepo=$(print -r -- "$url" | sed -E 's#https?://github.com/([^/]+/[^/]+)/.*#\1#')
  if [[ "$url" == *"/actions/runs/"* ]]; then
    rid=$(print -r -- "$url" | sed -E 's#.*/actions/runs/([0-9]+).*#\1#')
    watch_run "$ownerrepo" "$rid"; exit 0
  elif [[ "$url" == *"/pull/"* ]]; then
    num=$(print -r -- "$url" | sed -E 's#.*/pull/([0-9]+).*#\1#')
    watch_pr "$ownerrepo" "$num"; exit 0
  fi
  echo "prwatch: unrecognized github URL (want .../actions/runs/<id> or .../pull/<n>)" >&2; exit 1
fi

# --- direct: prwatch <number> -------------------------------------------------
# Use the REST API (repos/<owner>/<repo>/pulls/<n>) — strictly repo-scoped, so a
# fork won't cross-resolve the number to its upstream the way `gh pr view` does.
if [[ "${1:-}" == <-> ]]; then
  for repo in $repos; do
    if gh api "repos/$repo/pulls/$1" --jq .number >/dev/null 2>&1; then
      watch_pr "$repo" "$1"; exit 0
    fi
  done
  echo "prwatch: PR #$1 not found in: ${repos[*]}" >&2; exit 1
fi

# --- await: prwatch --await <branch> ------------------------------------------
# On-demand replacement for the launchd sweep: wait for the open PR with this head
# branch to appear, watch its checks to completion, fire one notification, exit.
# Meant to be backgrounded by the pre-push hook so a watcher exists only while CI
# is actually in flight — no idle 120s poller. Quietly gives up if no PR appears.
if [[ "${1:-}" == "--await" ]]; then
  branch="${2:-}"
  [[ -n "$branch" ]] || { echo "usage: prwatch --await <branch>" >&2; exit 1 }
  # prefer the CI repo (sweep-repos) over the fork, which runs no checks
  awaitrepos=(${=$(git config prwatch.sweep-repos 2>/dev/null || true)})
  (( ${#awaitrepos} )) && repos=($awaitrepos)

  # 1) wait up to ~5 min for an open PR on this head branch (often opened just after push)
  arepo=""; anum=""
  for i in {1..30}; do
    for repo in $repos; do
      n=$(gh pr list --repo "$repo" --head "$branch" --state open \
            --json number --jq '.[0].number // empty' 2>/dev/null)
      [[ -n "$n" ]] && { arepo="$repo"; anum="$n"; break 2 }
    done
    sleep 10
  done
  [[ -n "$anum" ]] || exit 0   # no PR opened for this branch → nothing to watch

  # 2) wait up to ~5 min for checks to attach (so the watcher won't false-fail on "no checks")
  for i in {1..30}; do
    roll=$(gh pr list --repo "$arepo" --head "$branch" --state open \
             --json number,title,headRefName,statusCheckRollup --jq "$ROLL_JQ" 2>/dev/null \
           | head -1 | cut -f2)
    [[ -n "$roll" && "$roll" != *"no checks"* ]] && break
    sleep 10
  done

  # 3) block until checks resolve, then notify. watch_pr registers the tracking
  #    marker (badge + --tracking) and prunes it on exit.
  watch_pr "$arepo" "$anum"
  exit 0
fi

# --- tracking: prwatch --tracking — list PRs whose CI is being watched now -----
if [[ "${1:-}" == "--tracking" || "${1:-}" == "--watching" ]]; then
  trackdir="$HOME/.cache/prwatch/tracking"
  active=0
  for f in "$trackdir"/*.tsv(N); do
    IFS=$'\t' read -r repo num title url started pid <"$f"
    kill -0 "$pid" 2>/dev/null || { rm -f "$f"; continue }   # watcher gone → prune stale marker
    active=1
    print -P "%F{yellow}👁%f ${repo}#${num} — ${title}  %F{8}${url}%f"
  done
  (( active )) || echo "no PRs are being watched"
  exit 0
fi

# a non-empty argument that matched no handler above is an unrecognized watch
# target — error out rather than silently falling through to the PR list/picker.
if [[ -n "${1:-}" && "$1" != "-l" && "$1" != "--list" ]]; then
  echo "prwatch: can't watch '$1' — want a PR number, a /pull/<n> URL, or an /actions/runs/<id> URL" >&2
  exit 2
fi

# surface the PRs worth monitoring: failing → running → passing → no-checks
rows=$(collect | awk -F'\t' '
  { pri = ($3 ~ /✗/) ? 0 : ($3 ~ /●/) ? 1 : ($3 ~ /✓/) ? 2 : 3; print pri "\t" $0 }' \
  | sort -t$'\t' -k1,1n -s | cut -f2-)
[[ -n "$rows" ]] || { echo "no open PRs authored by you in: ${repos[*]}"; exit 0; }

# printed table (also the fzf source)
print -P "%F{yellow}your open PRs%f"
printf '%s\n' "$rows" | awk -F'\t' '{printf "  %-16s #%-4s %-12s %s\n", $1, $2, $3, $4}'

[[ "${1:-}" == "-l" || "${1:-}" == "--list" ]] && exit 0
command -v fzf >/dev/null 2>&1 || { echo "(fzf not found — watch one with: prwatch <number>)"; exit 0; }

# fzf input: "repo<TAB>num<TAB>display"; show only the display, but {1}/{2} carry
# repo/number for the preview + selection.
sel=$(printf '%s\n' "$rows" \
  | awk -F'\t' '{printf "%s\t%s\t%-12s #%-5s %s\n", $1, $2, $3, $2, $4}' \
  | fzf --delimiter='\t' --with-nth=3.. --prompt='watch checks › ' \
        --height=45% --reverse --header='pick a PR → watch its CI checks (esc to cancel)' \
        --preview-window='down,9,wrap' \
        --preview='gh pr checks {2} --repo {1} 2>/dev/null | head -40')
[[ -n "$sel" ]] || exit 0
watch_pr "$(printf '%s' "$sel" | cut -f1)" "$(printf '%s' "$sel" | cut -f2)"
