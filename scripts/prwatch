#!/bin/zsh
# prwatch — your open PRs at a glance, and watch a PR's CI checks till they settle.
#
#   prwatch              list your open PRs (with a live check rollup) and fzf-pick
#                        one to watch
#   prwatch <number>     watch that PR's checks directly (searches your repos)
#   prwatch <url>        watch a .../pull/<n> URL's checks, or a .../actions/runs/<id>
#                        Actions-run URL to completion
#   prwatch -l|--list    just list; don't watch
#   prwatch --await <b>  wait for branch <b>'s PR, watch its CI to completion, then
#                        notify & exit — backgrounded by the pre-push hook (on-demand)
#   prwatch --tracking   list the PRs whose CI is being watched right now (the live
#                        --await processes); also what the SwiftBar menu badge reads
#   prwatch --sweep      one quiet polling pass (for launchd): notify on a PR that
#                        newly fails, recovers, first appears green, or MERGES —
#                        the standing counterpart to --await, and the only thing
#                        that catches a merge (a merged PR drops off the open scan).
#                        Installed as launchd/com.philbrockman.prwatch-sweep.plist.
#                        Two loudness tiers: LOUD (sound, persistent) = newly-failing
#                        CI, a PR's FIRST approval, deploy landings, and sweep-workflows
#                        run completions (those are runs *I* dispatched — high signal);
#                        QUIET (no sound, self-dismissing — replaced by the next quiet
#                        banner and cleared at the next pass) = merged, passing,
#                        recovered. Everything lands in notify-log.
#                        Also watches dispatched workflow runs (deploys) — set
#                          git config prwatch.sweep-workflows "owner/repo:deploy-v2.yml …"
#                        and each of your runs notifies once when it succeeds or fails.
#                        And tracks per-PR DEPLOY LANDING: after a PR merges it pings
#                        again when it reaches staging, then production — a main-build
#                        deploy whose commit contains the PR's merge (ancestry, not
#                        time, so rollbacks and PR-branch staging tests don't false-fire).
#                        Watched repo: git config prwatch.landing-repos "owner/repo …"
#                        (default Loops-so/loops).
#                        After a long offline gap (> PRWATCH_SWEEP_GAP_H, default 6h —
#                        reboot, weekend) the pass's notifications collapse into ONE
#                        "while you were away" digest instead of a per-event storm.
#
# "Watch" streams gh's check status until every check passes or one fails, then
# fires a desktop notification (+ a terminal bell). It scans your fork AND the
# team repo, since CI usually runs on the team-repo PR — override the set with
#   git config stack.pr-repos "owner/repo owner/repo"
#
# Rollup glyphs:  ✓ all pass   ● running   ✗ failing   ○ no checks reported
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

repos=(${=$(git config stack.pr-repos 2>/dev/null || true)})
(( ${#repos} )) || repos=(phil-loops/loops Loops-so/loops)

# Clean up the tracking marker on real shell exit / ctrl-c. Must live at top
# level: in zsh a `trap ... EXIT` set inside a function is function-local and
# fires the instant that function returns — which would delete the marker
# register_watch just wrote. _marker is a process-global set by register_watch.
_marker=""
poke_swiftbar() {  # watch state changed — both the 👁 and 🔨 plugins render the watch list
  open -g "swiftbar://refreshplugin?name=prwatch" 2>/dev/null
  open -g "swiftbar://refreshplugin?name=build-status" 2>/dev/null
}
trap '[[ -n "$_marker" ]] && rm -f "$_marker"; poke_swiftbar' EXIT INT TERM

# jq program: one open PR → "number<TAB>rollup<TAB>title<TAB>branch"
# (single-quoted so no shell interpolation; statusCheckRollup states vary by
#  check type — conclusion for completed, status/state while in flight.)
ROLL_JQ='
def f: ["FAILURE","ERROR","CANCELLED","TIMED_OUT","STARTUP_FAILURE","ACTION_REQUIRED"];
def p: ["PENDING","IN_PROGRESS","QUEUED","EXPECTED","WAITING","REQUESTED"];
.[] | [
  (.number|tostring),
  ( [.statusCheckRollup[]?
      # conclusion (CheckRun, when finished) → status (CheckRun, in flight) → state (StatusContext).
      # an empty-string conclusion means "not finished" — fall through to status.
      | ((.conclusion | select(. != "")) // .status // .state // "PENDING")] as $st
    | ($st|length) as $n
    | ([$st[] | select(. as $x | f | index($x))] | length) as $nf   # bind $x; f|index(.) would rebind . to f
    | ([$st[] | select(. as $x | p | index($x))] | length) as $np
    | if   $n==0  then "○ no checks"
      elif $nf>0  then "✗ \($nf) failing"
      elif $np>0  then "● \($np) running"
      else             "✓ all pass" end ),
  .title,
  .headRefName,
  (if ([.latestReviews[]? | select(.state=="APPROVED")] | length) > 0 then "approved" else "-" end)
] | @tsv'

# jq program: one PR (gh pr view --json statusCheckRollup) → fail | pending | pass | none.
# Same state buckets as ROLL_JQ; used to double-check gh pr checks' exit code, which
# conflates "a check failed" with "no checks on this head yet" (both exit non-zero).
VERDICT_JQ='
def f: ["FAILURE","ERROR","CANCELLED","TIMED_OUT","STARTUP_FAILURE","ACTION_REQUIRED"];
def p: ["PENDING","IN_PROGRESS","QUEUED","EXPECTED","WAITING","REQUESTED"];
[.statusCheckRollup[]? | ((.conclusion | select(. != "")) // .status // .state // "PENDING")] as $st
| if   ($st|length)==0 then "none"
  elif ([$st[] | select(. as $x | f | index($x))] | length) > 0 then "fail"
  elif ([$st[] | select(. as $x | p | index($x))] | length) > 0 then "pending"
  else "pass" end'

# one-shot mute: an EXPLICIT watch (URL/number/fzf — not --await) records its key here
# after its single notification; every ambient notifier (sweep transitions, approved,
# merged, landing, build-notify success) skips answered keys forever. Keys lowercased —
# URL-parsed repos are lowercase ("loops-so/loops") while config repos are "Loops-so/loops".
ANSWERED="$HOME/.cache/prwatch/answered.txt"
answered() { grep -qxF "${(L)1}" "$ANSWERED" 2>/dev/null }
mark_answered() { mkdir -p "${ANSWERED:h}"; print -r -- "${(L)1}" >> "$ANSWERED" }

QUIET_GROUP="prwatch-quiet"
notify_quiet() {  # $1 status  $2 detail  $3 url — no sound, replaces the previous quiet
                  # banner (same -group), removed at the next sweep pass: self-dismissing
  "$HOME/.dotfiles/scripts/notify-journal" prwatch quiet "$1" "${2:-}" "${3:-}" 2>/dev/null || true
  if command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title "prwatch · $1" -message "${2:-$1}" -group "$QUIET_GROUP" \
      ${3:+-open "$3"} </dev/null >/dev/null 2>&1 || true
  fi
}

notify() {  # $1 status   $2 detail   $3 url (optional — opened when you click it)
  "$HOME/.dotfiles/scripts/notify-journal" prwatch notified "$1" "${2:-}" "${3:-}" 2>/dev/null || true
  print -n '\a'
  # Prefer terminal-notifier: posts under its own identity (clicking opens $3, the
  # PR/run — not Script Editor) and lands in Notification Center. Fall back to
  # osascript, whose notifications are owned by "Script Editor", so clicking one
  # just opens that app (install terminal-notifier to fix: brew install terminal-notifier).
  if command -v terminal-notifier >/dev/null 2>&1; then
    # </dev/null is load-bearing: terminal-notifier slurps piped stdin as the message, so
    # inside a `while read` loop it would eat every remaining row (and display them raw).
    # Unique -group + delayed -remove: with terminal-notifier set to Alert style (System
    # Settings → Notifications → terminal-notifier → Alerts) the notification HOLDS on
    # screen for PRWATCH_NOTE_SECONDS, then dismisses itself. Banner style is unaffected
    # (macOS hides banners at ~5s regardless; the remove just tidies Notification Center).
    local g="prwatch-note-$$-$RANDOM"
    terminal-notifier -title "prwatch · $1" -message "${2:-$1}" -sound Glass -group "$g" \
      ${3:+-open "$3"} </dev/null >/dev/null 2>&1 || true
    ( sleep "${PRWATCH_NOTE_SECONDS:-45}"
      terminal-notifier -remove "$g" </dev/null >/dev/null 2>&1 ) >/dev/null 2>&1 &!
  else
    local t="prwatch · $1" m="${2:-$1}"
    t=${t//\\/\\\\}; t=${t//\"/\\\"}; m=${m//\\/\\\\}; m=${m//\"/\\\"}
    osascript >/dev/null 2>&1 \
      -e "display notification \"$m\" with title \"$t\" sound name \"Glass\"" || true
  fi
}

DONEDIR="$HOME/.cache/prwatch/done"
notify_sticky() {  # $1 status  $2 detail  $3 url — banner now, PLUS a row that persists in
                   # the build-status menu (FINISHED section) until dismissed there. The
                   # completion of something explicitly asked for must survive a glance away;
                   # banners evaporate, and a modal dialog parked mid-screen was too
                   # distracting. The menu derives its symbol from $1 (fail words → xmark)
                   # and renders $2 as the row — keep $1 a plain word, $2 self-contained.
  notify "$@"
  mkdir -p "$DONEDIR"
  local slug="$1 $2"; slug="${slug//[^A-Za-z0-9._-]/-}"; slug="${slug[1,80]}"
  print -r -- "$1"$'\t'"${2:-}"$'\t'"${3:-}"$'\t'"$(date +%s)" > "$DONEDIR/$slug.tsv"
  poke_swiftbar
}

poke_viewers() {  # a PR just merged — nudge every live forest viewer to refresh trunk + PR state
  # Viewer ports are derived per-repo in the [62333, 63332] band (stack-review-port), so
  # rather than mapping repo-slug → local checkout → port, poke every Python listener in the
  # band; /pr-poke on a viewer for an unrelated repo is a cheap no-op fetch.
  local ports p
  ports=$(lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null \
    | awk '$1 ~ /^[Pp]ython/ && match($9, /:(62[3-9][0-9][0-9]|63[0-3][0-9][0-9])$/) {print substr($9, RSTART+1)}' \
    | sort -u) || true
  for p in ${(f)ports}; do
    [[ -n "$p" ]] && curl -s -m 20 -X POST "http://127.0.0.1:$p/pr-poke" -o /dev/null || true
  done
}

register_watch() {  # $1 key  $2 repo  $3 id  $4 title  $5 url — track a live watch for the badge
  local d="$HOME/.cache/prwatch/tracking"; mkdir -p "$d"
  _marker="$d/$1.tsv"   # process-global so the EXIT trap can see it
  if [[ -f "$_marker" ]]; then                       # dedup: a live watcher on this key → reuse
    local epid=$(cut -f6 "$_marker" 2>/dev/null)
    if [[ -n "$epid" ]] && kill -0 "$epid" 2>/dev/null; then
      poke_swiftbar
      echo "prwatch: already watching $2#$3 (pid $epid)"; exit 0
    fi
  fi
  print -r -- "$2"$'\t'"$3"$'\t'"$4"$'\t'"$5"$'\t'"$(date +%s)"$'\t'"$$" > "$_marker"
  # cleanup trap lives at top level (set near the script header) — a function-local
  # `trap ... EXIT` would fire on return and delete the marker we just wrote.
  poke_swiftbar   # no-op until SwiftBar installed
}

watch_pr() {  # $1 repo  $2 number
  local repo="$1" num="$2" url="https://github.com/$1/pull/$2"
  local title=$(gh pr view "$num" --repo "$repo" --json title --jq .title 2>/dev/null)
  register_watch "${repo//\//-}-${num}" "$repo" "$num" "${title:-PR #$num}" "$url"
  print -P "%F{yellow}⟳%f watching ${repo}#${num} — ctrl-c to stop"
  local st msg verdict empties=0
  while true; do
    if gh pr checks "$num" --repo "$repo" --watch; then
      print -P "%F{green}✓ ${repo}#${num} — all checks passed%f"
      st="passed" msg="${repo}#${num} — all checks green"
      break
    fi
    # gh pr checks exits non-zero for "no checks reported" too — for a few seconds
    # after a push the new head has zero check runs, so a watcher started against
    # the old head false-fails right as CI is queueing. Trust the exit code only
    # when the rollup actually shows a failure; otherwise re-enter the watch
    # (which also follows a mid-watch push onto the fresh head's checks).
    if verdict=$(gh pr view "$num" --repo "$repo" --json statusCheckRollup --jq "$VERDICT_JQ" 2>/dev/null); then
      case "$verdict" in
        (fail)
          print -P "%F{red}✗ ${repo}#${num} — a check failed%f"
          st="failed" msg="${repo}#${num} — a check failed"
          break ;;
        (none)
          if (( ++empties >= 30 )); then   # ~5 min with zero checks → report that, not "failed"
            print -P "%F{red}○ ${repo}#${num} — no checks reported%f"
            st="no checks" msg="${repo}#${num} — no checks reported"
            break
          fi ;;
        (*) empties=0 ;;   # pending/pass: gh flinched (push race, transient hiccup) — re-watch
      esac
    fi                     # rollup fetch failed = transient gh/network error — just re-watch
    sleep 10
  done
  # --await watchers (one per push) stay banner-tier and out of the mute list; an
  # EXPLICIT watch gets the sticky ✅ badge and mutes ambient repeats
  if [[ "${PRWATCH_AWAIT:-0}" == 1 ]]; then
    notify "$st" "$msg" "$url"
  else
    notify_sticky "$st" "$msg" "$url"
    mark_answered "$repo#$num"
  fi
}

watch_run() {  # $1 repo  $2 run-id — watch a single Actions run to completion
  local repo="$1" rid="$2" url="https://github.com/$1/actions/runs/$2"
  register_watch "${repo//\//-}-run-${rid}" "$repo" "$rid" "run $rid" "$url"
  print -P "%F{yellow}⟳%f watching run ${repo} #${rid} — ctrl-c to stop"
  if gh run watch "$rid" --repo "$repo" --exit-status; then
    print -P "%F{green}✓ run ${rid} — succeeded%f"
    notify_sticky "run passed" "${repo} run ${rid} succeeded" "$url"
  else
    print -P "%F{red}✗ run ${rid} — failed%f"
    notify_sticky "run failed" "${repo} run ${rid} failed" "$url"
  fi
  mark_answered "$repo/$rid"
}

# rows: "repo<TAB>number<TAB>rollup<TAB>title<TAB>branch" across all repos
collect() {
  local repo
  for repo in $repos; do
    gh pr list --repo "$repo" --author @me --state open \
      --json number,title,headRefName,statusCheckRollup,latestReviews --jq "$ROLL_JQ" 2>/dev/null \
      | awk -v r="$repo" 'NF{print r"\t"$0}'   # awk \t = a real tab (BSD sed won't)
  done
}

# --- direct: prwatch <github-url> ---------------------------------------------
# An Actions run URL → watch that run; a pull URL → watch that PR's checks.
#   https://github.com/<owner>/<repo>/actions/runs/<id>[/job/<id>]
#   https://github.com/<owner>/<repo>/pull/<n>
if [[ "${1:-}" == http(s|)://github.com/* ]]; then
  url="$1"
  ownerrepo=$(print -r -- "$url" | sed -E 's#https?://github.com/([^/]+/[^/]+)/.*#\1#')
  if [[ "$url" == *"/actions/runs/"* ]]; then
    rid=$(print -r -- "$url" | sed -E 's#.*/actions/runs/([0-9]+).*#\1#')
    watch_run "$ownerrepo" "$rid"; exit 0
  elif [[ "$url" == *"/pull/"* ]]; then
    num=$(print -r -- "$url" | sed -E 's#.*/pull/([0-9]+).*#\1#')
    watch_pr "$ownerrepo" "$num"; exit 0
  fi
  echo "prwatch: unrecognized github URL (want .../actions/runs/<id> or .../pull/<n>)" >&2; exit 1
fi

# --- direct: prwatch <number> -------------------------------------------------
# Use the REST API (repos/<owner>/<repo>/pulls/<n>) — strictly repo-scoped, so a
# fork won't cross-resolve the number to its upstream the way `gh pr view` does.
if [[ "${1:-}" == <-> ]]; then
  for repo in $repos; do
    if gh api "repos/$repo/pulls/$1" --jq .number >/dev/null 2>&1; then
      watch_pr "$repo" "$1"; exit 0
    fi
  done
  echo "prwatch: PR #$1 not found in: ${repos[*]}" >&2; exit 1
fi

# --- await: prwatch --await <branch> ------------------------------------------
# On-demand replacement for the launchd sweep: wait for the open PR with this head
# branch to appear, watch its checks to completion, fire one notification, exit.
# Meant to be backgrounded by the pre-push hook so a watcher exists only while CI
# is actually in flight — no idle 120s poller. Quietly gives up if no PR appears.
if [[ "${1:-}" == "--await" ]]; then
  branch="${2:-}"
  [[ -n "$branch" ]] || { echo "usage: prwatch --await <branch>" >&2; exit 1 }
  # prefer the CI repo (sweep-repos) over the fork, which runs no checks
  awaitrepos=(${=$(git config prwatch.sweep-repos 2>/dev/null || true)})
  (( ${#awaitrepos} )) && repos=($awaitrepos)

  # 1) wait up to ~5 min for an open PR on this head branch (often opened just after push)
  arepo=""; anum=""
  for i in {1..30}; do
    for repo in $repos; do
      n=$(gh pr list --repo "$repo" --head "$branch" --state open \
            --json number --jq '.[0].number // empty' 2>/dev/null)
      [[ -n "$n" ]] && { arepo="$repo"; anum="$n"; break 2 }
    done
    sleep 10
  done
  [[ -n "$anum" ]] || exit 0   # no PR opened for this branch → nothing to watch

  # 2) wait up to ~5 min for checks to attach (so the watcher won't false-fail on "no checks")
  for i in {1..30}; do
    # || true: head -1 closes early, so gh/jq die on SIGPIPE (141) — pipefail + set -e would abort
    roll=$(gh pr list --repo "$arepo" --head "$branch" --state open \
             --json number,title,headRefName,statusCheckRollup --jq "$ROLL_JQ" 2>/dev/null \
           | head -1 | cut -f2) || true
    [[ -n "$roll" && "$roll" != *"no checks"* ]] && break
    sleep 10
  done

  # 3) block until checks resolve, then notify. watch_pr registers the tracking
  #    marker (badge + --tracking) and prunes it on exit.
  PRWATCH_AWAIT=1 watch_pr "$arepo" "$anum"
  exit 0
fi

# --- tracking: prwatch --tracking — list PRs whose CI is being watched now -----
if [[ "${1:-}" == "--tracking" || "${1:-}" == "--watching" ]]; then
  trackdir="$HOME/.cache/prwatch/tracking"
  active=0
  for f in "$trackdir"/*.tsv(N); do
    IFS=$'\t' read -r repo num title url started pid <"$f"
    kill -0 "$pid" 2>/dev/null || { rm -f "$f"; continue }   # watcher gone → prune stale marker
    active=1
    print -P "%F{yellow}👁%f ${repo}#${num} — ${title}  %F{8}${url}%f"
  done
  (( active )) || echo "no PRs are being watched"
  exit 0
fi

# --- sweep: prwatch --sweep — one quiet launchd pass --------------------------
# Diff every open PR (authored by me, across repos) against the previous pass and
# notify ONLY on a transition worth knowing: newly failing · recovered (fail→pass)
# · first-seen already green · MERGED. Merge is the gap --await can't fill — a
# merged PR drops off the open scan, so we remember last pass's open set and ask
# GitHub about any that vanished. First run with no prior state seeds silently.
if [[ "${1:-}" == "--sweep" ]]; then
  sweeprepos=(${=$(git config prwatch.sweep-repos 2>/dev/null || true)})
  (( ${#sweeprepos} )) && repos=($sweeprepos)
  state="$HOME/.cache/prwatch/sweep-state.tsv"
  mkdir -p "${state:h}"

  # gap-aware digest: after a long offline stretch (reboot, weekend) every transition
  # that happened while away would fire its own notification in one burst. If the last
  # completed pass is older than PRWATCH_SWEEP_GAP_H (default 6h), collect this pass's
  # notifications into ONE "while you were away" summary instead.
  stamp="$HOME/.cache/prwatch/sweep-last-pass"
  now_s=$(date +%s)
  last_s=0; [[ -f "$stamp" ]] && last_s=$(<"$stamp")
  digest=0
  (( last_s > 0 && now_s - last_s > ${PRWATCH_SWEEP_GAP_H:-6} * 3600 )) && digest=1
  digest_lines=()
  snotify() {
    if (( digest )); then
      digest_lines+=("$1 · $2")
      "$HOME/.dotfiles/scripts/notify-journal" prwatch digest "$1" "${2:-}" "${3:-}" 2>/dev/null || true
    else
      notify "$@"
    fi
  }
  squiet() {
    if (( digest )); then
      digest_lines+=("$1 · $2")
      "$HOME/.dotfiles/scripts/notify-journal" prwatch digest "$1" "${2:-}" "${3:-}" 2>/dev/null || true
    else
      notify_quiet "$@"
    fi
  }
  salert() {  # my dispatched deploys finishing: sticky-tier — a banner evaporates
              # while you look away, and a deploy landing is exactly the thing to miss
    if (( digest )); then
      digest_lines+=("$1 · $2")
      "$HOME/.dotfiles/scripts/notify-journal" prwatch digest "$1" "${2:-}" "${3:-}" 2>/dev/null || true
    else
      notify_sticky "$@"
    fi
  }
  deploy_title() {  # gh displayTitle "[staging] deploying 2026.07.13-20248-1" → "2026.07.13-20248-1 to staging"
    if [[ "$1" =~ '^\[([a-z-]+)\][[:space:]]+deploying[[:space:]]+(.+)$' ]]; then
      print -r -- "${match[2]} to ${match[1]}"
    else
      print -r -- "$1"
    fi
  }
  # clear last pass's quiet banner — quiet notifications live one sweep interval, tops
  command -v terminal-notifier >/dev/null 2>&1 && \
    { terminal-notifier -remove "$QUIET_GROUP" </dev/null >/dev/null 2>&1 || true; }

  rows="$(collect || true)"
  # transient gh/network failure: an empty poll while we hold state is almost
  # certainly a bad fetch, not "every PR merged at once" — skip, keep last state.
  [[ -z "$rows" && -s "$state" ]] && exit 0

  typeset -A prev prevtitle
  if [[ -f "$state" ]]; then
    while IFS=$'\t' read -r k st title _url; do
      [[ -n "$k" ]] && { prev[$k]=$st; prevtitle[$k]=$title }
    done <"$state"
  fi
  firstrun=0; [[ -f "$state" ]] || firstrun=1

  # first approvals: a PR notifies ONCE, ever, when it first shows an approving
  # review — re-approvals after new pushes stay quiet. Missing file = seed silently.
  aseen="$HOME/.cache/prwatch/sweep-approved.txt"
  afirst=0; [[ -f "$aseen" ]] || afirst=1

  typeset -A cur
  newstate=""
  while IFS=$'\t' read -r repo num rollup title _branch approved; do
    [[ -n "$num" ]] || continue
    key="$repo#$num"; url="https://github.com/$repo/pull/$num"
    case "$rollup" in
      (*✗*) st=fail ;; (*●*) st=running ;; (*✓*) st=pass ;; (*) st=none ;;
    esac
    cur[$key]=1
    newstate+="$key"$'\t'"$st"$'\t'"$title"$'\t'"$url"$'\n'
    if [[ "$approved" == approved ]] && ! grep -qxF "$key" "$aseen" 2>/dev/null; then
      (( afirst || firstrun )) || answered "$key" || snotify "✅ approved" "$key — $title" "$url"
      print -r -- "$key" >> "$aseen"
    fi
    (( firstrun )) && continue
    answered "$key" && continue   # explicit watch already notified — state recorded above, no taps
    was="${prev[$key]:-}"
    if [[ $st == fail && $was != fail ]]; then
      snotify "✗ failing" "$key — $title" "$url"
    elif [[ $st == pass && $was == fail ]]; then
      squiet "✓ recovered" "$key — checks green again" "$url"
    elif [[ $st == pass && -z $was ]]; then
      squiet "✓ passing" "$key — $title" "$url"
    fi
  done <<< "$rows"

  # merges: a PR open last pass but gone now — did it land (vs just close)?
  merged_now=()
  if (( ! firstrun )); then
    any_merged=0
    for key in ${(k)prev}; do
      [[ -n "${cur[$key]:-}" ]] && continue
      repo="${key%\#*}"; num="${key##*\#}"
      prstate="$(gh pr view "$num" --repo "$repo" --json state --jq .state 2>/dev/null)" || prstate=""
      if [[ "$prstate" == MERGED ]]; then
        answered "$key" || squiet "🎉 merged" "$key — ${prevtitle[$key]:-merged}" "https://github.com/$repo/pull/$num"
        merged_now+=("$key")   # hand off to deploy-landing tracking below
        any_merged=1
      elif [[ "$prstate" != CLOSED ]]; then
        # still open (or unverifiable) yet missing from the scan — a partial gh fetch
        # dropped it; carry it over so its green doesn't re-announce when it reappears
        newstate+="$key"$'\t'"${prev[$key]}"$'\t'"${prevtitle[$key]:-}"$'\t'"https://github.com/$repo/pull/$num"$'\n'
      fi
    done
    (( any_merged )) && poke_viewers
  fi

  printf '%s' "$newstate" >"$state"   # atomic-ish single write; merged/closed drop off

  # workflow runs (deploys): the PR scan can't see a workflow_dispatch run, so a
  # `task release:production` deploy would otherwise finish unannounced. Track the
  # configured workflows' recent runs (mine only) and notify once on completion.
  sweepwfs=(${=$(git config prwatch.sweep-workflows 2>/dev/null || true)})
  if (( ${#sweepwfs} )); then
    rstate="$HOME/.cache/prwatch/sweep-runs-state.tsv"
    me=$(gh api user --jq .login 2>/dev/null) || me=""
    uflag=(); [[ -n "$me" ]] && uflag=(--user "$me")
    rrows=""
    for spec in $sweepwfs; do
      wrepo="${spec%%:*}"; wfile="${spec#*:}"
      chunk=$(gh run list --repo "$wrepo" --workflow "$wfile" $uflag --limit 10 \
        --json databaseId,status,conclusion,displayTitle 2>/dev/null \
        | jq -r --arg r "$wrepo" '.[] | [$r, (.databaseId|tostring),
            (if .status=="completed" then .conclusion else .status end),
            .displayTitle] | @tsv') || chunk=""
      [[ -n "$chunk" ]] && rrows+="$chunk"$'\n'
    done

    # empty poll = transient gh failure (or no runs yet) — keep last state untouched
    if [[ -n "$rrows" ]]; then
      typeset -A rprev
      rfirst=0; [[ -f "$rstate" ]] || rfirst=1
      if [[ -f "$rstate" ]]; then
        while IFS=$'\t' read -r k st _; do [[ -n "$k" ]] && rprev[$k]=$st; done <"$rstate"
      fi
      # Per-lane supersession: deploys to the SAME env supersede each other — once a newer
      # [staging] run exists (any state), an older [staging] success is stale news; the
      # newer run's completion is the one that matters. Envs never supersede across, so a
      # staging deploy and a production deploy each still announce. Failures always notify.
      typeset -A envnewest
      while IFS=$'\t' read -r wrepo rid st title; do
        [[ -n "$rid" && "$title" =~ '^\[([a-z-]+)\]' ]] || continue
        ek="$wrepo:${match[1]}"
        (( rid > ${envnewest[$ek]:-0} )) && envnewest[$ek]=$rid
      done <<< "$rrows"
      rnew=""
      while IFS=$'\t' read -r wrepo rid st title; do
        [[ -n "$rid" ]] || continue
        key="$wrepo/$rid"; url="https://github.com/$wrepo/actions/runs/$rid"
        rnew+="$key"$'\t'"$st"$'\n'
        (( rfirst )) && continue
        was="${rprev[$key]:-}"
        [[ "$st" == "$was" ]] && continue
        answered "$key" && continue   # run was explicitly watched — its one notification fired
        case "$st" in
          (success)
            if [[ "$title" =~ '^\[([a-z-]+)\]' ]] && (( ${envnewest[$wrepo:${match[1]}]:-0} > rid )); then
              "$HOME/.dotfiles/scripts/notify-journal" prwatch silent-superseded "deployed" \
                "Deployed $(deploy_title "$title") — superseded by a newer ${match[1]} deploy" "$url" 2>/dev/null || true
            else
              salert "deployed" "Deployed $(deploy_title "$title")" "$url"
            fi ;;
          (failure|timed_out|startup_failure|cancelled)
            salert "deploy failed" "Deploy ${st//_/ } — $(deploy_title "$title")" "$url" ;;
        esac   # in-flight states record silently — Slack already announces the start
      done <<< "$rrows"
      printf '%s' "$rnew" >"$rstate"
    fi
  fi

  # --- per-PR deploy landing: merged → in staging → in production --------------
  # A merged PR has "landed" in an env once a SUCCESSFUL deploy of that env ships a
  # build whose commit CONTAINS the PR's merge commit. Rollback-safe: the deploy
  # version (date-<runNumber>-attempt) maps to the build-and-test run that built it,
  # whose headSha is the deployed commit — ancestry, not timestamps, decides.
  landrepos=(${=$(git config prwatch.landing-repos 2>/dev/null || echo "Loops-so/loops")})
  lstate="$HOME/.cache/prwatch/sweep-landing.tsv"
  # ingest PRs that merged THIS pass, recording their merge commit
  for key in ${merged_now[@]:-}; do
    [[ -n "$key" ]] || continue
    answered "$key" && continue   # explicit watch already notified — no landing taps either
    lrepo="${key%\#*}"; lnum="${key##*\#}"
    if [[ -f "$lstate" ]] && grep -q "^${key}"$'\t' "$lstate"; then continue; fi   # already tracked
    msha=$(gh pr view "$lnum" --repo "$lrepo" --json mergeCommit --jq '.mergeCommit.oid' 2>/dev/null) || msha=""
    [[ -n "$msha" ]] || continue
    ltitle=$(gh pr view "$lnum" --repo "$lrepo" --json title --jq .title 2>/dev/null) || ltitle=""
    print -r -- "$key"$'\t'"$msha"$'\t'"$ltitle"$'\t'0$'\t'0 >> "$lstate"
  done
  if [[ -s "$lstate" ]]; then
    typeset -a stag prod
    for lr in $landrepos; do
      while IFS=$'\t' read -r denv dver; do
        [[ -n "$dver" ]] || continue
        rn="${dver#*-}"; rn="${rn%-*}"           # date-<runNumber>-attempt → runNumber
        [[ "$rn" == <-> ]] || continue
        # only MAIN builds count as a landing — a deploy of a PR-branch build is
        # pre-merge staging-testing, not the merged code going out.
        dsha=$(gh run list --repo "$lr" --workflow build-and-test.yml --limit 150 --json number,headSha,headBranch 2>/dev/null \
                 | jq -r --argjson n "$rn" '.[] | select(.number==$n and .headBranch=="main") | .headSha' 2>/dev/null | head -1) || dsha=""
        [[ -n "$dsha" ]] || continue
        case "$denv" in (staging) stag+="$lr|$dsha";; (production) prod+="$lr|$dsha";; esac
      done < <(gh run list --repo "$lr" --workflow deploy-v2.yml --status success --limit 25 --json displayTitle 2>/dev/null \
                 | jq -r '.[] | (.displayTitle | capture("\\[(?<e>[a-z]+)\\] deploying (?<v>[^ ]+)")) | "\(.e)\t\(.v)"' 2>/dev/null || true)
    done
    stag=(${(u)stag}); prod=(${(u)prod})         # dedupe candidate deploy commits
    _pr_in_deploy() {  # $1 repo  $2 mergeSha  $3.. list of "repo|sha" — 0 if merge is an ancestor of any
      local mr="$1" ms="$2"; shift 2
      local pair r s stt
      for pair in "$@"; do
        r="${pair%%|*}"; s="${pair#*|}"
        [[ "$r" == "$mr" ]] || continue
        stt=$(gh api "repos/$mr/compare/$ms...$s" --jq .status 2>/dev/null) || stt=""
        [[ "$stt" == ahead || "$stt" == identical ]] && return 0
      done
      return 1
    }
    lnew=""
    while IFS=$'\t' read -r key msha title staged prodded; do
      [[ -n "$key" ]] || continue
      lrepo="${key%\#*}"; lnum="${key##*\#}"; lurl="https://github.com/$lrepo/pull/$lnum"
      if [[ "$staged" != 1 ]] && _pr_in_deploy "$lrepo" "$msha" ${stag[@]:-}; then
        snotify "🚀 landed in staging" "$key — $title" "$lurl"; staged=1
      fi
      if [[ "$prodded" != 1 ]] && _pr_in_deploy "$lrepo" "$msha" ${prod[@]:-}; then
        snotify "🚀 landed in production" "$key — $title" "$lurl"; prodded=1
      fi
      [[ "$staged" == 1 && "$prodded" == 1 ]] && continue   # fully landed → drop from tracking
      lnew+="$key"$'\t'"$msha"$'\t'"$title"$'\t'"$staged"$'\t'"$prodded"$'\n'
    done < "$lstate"
    printf '%s' "$lnew" >"$lstate"
  fi

  if (( ${#digest_lines} )); then
    dmsg="${(j:; :)digest_lines[1,3]}"
    (( ${#digest_lines} > 3 )) && dmsg+=" … +$(( ${#digest_lines} - 3 )) more"
    notify "⏰ while you were away (${#digest_lines})" "$dmsg" "https://github.com/pulls"
    for dl in $digest_lines; do echo "prwatch: (away) $dl"; done
  fi
  print -r -- "$now_s" >"$stamp"
  exit 0
fi

# a non-empty argument that matched no handler above is an unrecognized watch
# target — error out rather than silently falling through to the PR list/picker.
if [[ -n "${1:-}" && "$1" != "-l" && "$1" != "--list" ]]; then
  echo "prwatch: can't watch '$1' — want a PR number, a /pull/<n> URL, or an /actions/runs/<id> URL" >&2
  exit 2
fi

# surface the PRs worth monitoring: failing → running → passing → no-checks
rows=$(collect | awk -F'\t' '
  { pri = ($3 ~ /✗/) ? 0 : ($3 ~ /●/) ? 1 : ($3 ~ /✓/) ? 2 : 3; print pri "\t" $0 }' \
  | sort -t$'\t' -k1,1n -s | cut -f2-)
[[ -n "$rows" ]] || { echo "no open PRs authored by you in: ${repos[*]}"; exit 0; }

# printed table (also the fzf source)
print -P "%F{yellow}your open PRs%f"
printf '%s\n' "$rows" | awk -F'\t' '{printf "  %-16s #%-4s %-12s %s\n", $1, $2, $3, $4}'

[[ "${1:-}" == "-l" || "${1:-}" == "--list" ]] && exit 0
command -v fzf >/dev/null 2>&1 || { echo "(fzf not found — watch one with: prwatch <number>)"; exit 0; }

# fzf input: "repo<TAB>num<TAB>display"; show only the display, but {1}/{2} carry
# repo/number for the preview + selection.
sel=$(printf '%s\n' "$rows" \
  | awk -F'\t' '{printf "%s\t%s\t%-12s #%-5s %s\n", $1, $2, $3, $2, $4}' \
  | fzf --delimiter='\t' --with-nth=3.. --prompt='watch checks › ' \
        --height=45% --reverse --header='pick a PR → watch its CI checks (esc to cancel)' \
        --preview-window='down,9,wrap' \
        --preview='gh pr checks {2} --repo {1} 2>/dev/null | head -40')
[[ -n "$sel" ]] || exit 0
watch_pr "$(printf '%s' "$sel" | cut -f1)" "$(printf '%s' "$sel" | cut -f2)"
