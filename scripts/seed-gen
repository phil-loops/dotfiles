#!/usr/bin/env bash
# seed-gen [--sync] <worktree-dir>
#
# Give a worktree a .gen so `tsc`/the editor can resolve #trpc imports. Without it the tRPC
# client type COLLAPSES to the "collides with a built-in method" sentinel and every
# trpc.*.useQuery in the app reports as a bogus error (hundreds of .tsx errors, verified).
# .gen is gitignored, so a fresh sibling worktree has none.
#
# ONE implementation for every caller — the git hooks (post-checkout/-merge/-rewrite),
# stack-open, and stack-gates. Two copies of this logic drifted apart and each drift was a
# silent bug: this one's rebuild aimed at a tsconfig loops had moved (dead since 2026-07-19),
# and stack-open's copy watched only trpc/ while this one watched the real input set.
#
# Which trees can build a correct .gen: the main checkout always (real node_modules, either
# compiler). Everywhere else node_modules is a symlink, and typescript<7's tsc trips TS2883
# there (prisma-inferred exports resolve outside the project root), silently skipping the
# aggregates the client type resolves through — the native compiler (tsgo, and tsc itself
# since TS7) emits the full tree correctly (verified 2026-07-30). So in-tree rebuilds outside
# the main checkout are native-compiler-only: the tree's own tsc on TS7, tsgo on pre-TS7.
#
#   default (hooks; async, never blocks):
#     main checkout        rebuild whenever HEAD moved off what .gen was built for
#     scratch review tree  symlink main's .gen — a read surface, nothing there writes it
#     any other worktree   copy main's .gen — `task dev` there must not write through
#
#   --sync (stack-gates; foreground): make THIS tree's .gen describe THIS tree's HEAD —
#     reseed from main if absent, trade a symlink for a private copy rather than write
#     through it, emit in-tree, stamp .gen/.seed-gen-sha with the HEAD it now
#     describes. Prints one line per action taken; silent no-op when already accurate.
#
# NB: .gen does NOT reduce tsc memory — purely correctness.
set -u

realpath_of(){ (cd "$1" 2>/dev/null && pwd -P); }

# .rebuilding is the single-flight lock. A crashed build strands it, and a stranded lock
# silently freezes that tree's .gen forever (bit us 2026-07-30) — steal locks older than 10m.
# A live lock means someone else is doing the work we came to do — join it (wait, then
# re-check) instead of failing: the gate's --sync used to red on the viewer's background heal
# of the same scratch tree, and the typecheck then ran against the stale types (2026-09-08).
wait_lock(){ # $1 = lock dir; returns once we hold it, 1 after 600s of someone else holding it
  local lock="$1" waited=0 age
  until mkdir "$lock" 2>/dev/null; do
    age=$(( $(date +%s) - $(stat -f %m "$lock" 2>/dev/null || echo 0) ))
    (( age > 600 )) && { rm -rf "$lock"; continue; }
    (( waited >= 600 )) && return 1
    sleep 2; waited=$(( waited + 2 ))
  done
  return 0
}
take_lock(){ wait_lock "$1/.rebuilding"; }   # $1 = the .gen dir
drop_lock(){ rmdir "$1/.rebuilding" 2>/dev/null; }

# One seed-gen at a time per tree: the whole materialization (node_modules view, packages
# dist, prisma client, .gen) is serialized on a lock in the worktree's own git dir — never
# under .gen, which may still be a link into MAIN's.
tree_lock=""
drop_tree_lock(){ [[ -n "$tree_lock" ]] && rmdir "$tree_lock" 2>/dev/null; }

# A tree's node_modules is in one of three states and every one of them rots, so all three are
# handled here — the guard used to return unless it was a symlink, and the other two went unseen.
#   symlink elsewhere: reads some other tree's frozen packages/*/dist (wt-075238, 2026-07-30)
#   missing entirely:  the gate dies on ./node_modules/.bin/prisma (loops-wt-044724, 2026-09-09)
#   exploded view:     a SNAPSHOT nothing else re-runs, so a donor install (404 added / 348
#                      removed, 2026-09-09) freezes it against a donor that has moved on
repair_node_modules(){ # $1 = tree, $2 = main checkout; echoes a note when it acted
  local nm="$1/node_modules" target="$2/node_modules"
  [[ -d "$target" ]] || return 0
  if [[ ! -e "$nm" && ! -L "$nm" ]]; then
    ln -s "$target" "$nm" && echo "node_modules was missing — linked the main checkout's"
    return 0
  fi
  if [[ -L "$nm" ]]; then
    [[ "$(realpath_of "$nm")" == "$(realpath_of "$target")" ]] && return 0
    local old; old=$(readlink "$nm")
    rm "$nm" && ln -s "$target" "$nm" && echo "node_modules pointed at $old — repointed at the main checkout"
    return 0
  fi
  local before after
  before=$(view_entry_count "$nm")
  explode_node_modules "$1" "$2" || return 0
  after=$(view_entry_count "$nm")
  (( before != after )) && echo "node_modules view was $before entries, donor has $after — resynced"
  return 0
}

view_entry_count(){ ( shopt -s dotglob nullglob; set -- "$1"/* "$1"/@*/*; echo $#; ) }

# @loops/* resolves through node_modules/@loops/<p> → ../../packages/<p>, relative to where
# node_modules PHYSICALLY lives — so a tree whose node_modules is a symlink to main's can never
# see its own packages/* changes. "Exploding" gives the tree a real node_modules directory of
# per-entry symlinks into main's, except @loops, which points at the tree's own packages.
exploded(){ # $1 = tree: real node_modules whose @loops resolves tree-locally
  [[ ! -L "$1/node_modules" && -d "$1/node_modules/@loops" ]] \
    && [[ "$(realpath_of "$1/node_modules/@loops/prisma")" == "$(realpath_of "$1/packages/prisma")" ]]
}

explode_node_modules(){ # $1 = tree, $2 = main checkout; idempotent: prunes dead links, tops up new ones
  local nm="$1/node_modules" src_nm="$2/node_modules"
  [[ -d "$src_nm" ]] || return 1
  [[ -L "$nm" ]] && rm "$nm"
  mkdir -p "$nm/@loops"
  local e b s sb
  # Prune BEFORE topping up: a package the donor retired leaves a link resolving to nothing,
  # which is worse than an absent one (a resolver finds it, then fails), and the top-up below
  # skips any name that already exists — dangling included — so a stale link would never heal.
  # Only symlinks are considered: seed_prisma_client turns .prisma/@prisma into real copies.
  ( shopt -s dotglob nullglob
    for e in "$nm"/* "$nm"/@*/*; do
      [[ -L "$e" && ! -e "$e" ]] && rm "$e"
    done )
  ( shopt -s dotglob nullglob
    for e in "$src_nm"/*; do
      b=$(basename "$e")
      [[ "$b" == "@loops" ]] && continue
      # scope dirs get a REAL dir with per-package links, never a whole-scope symlink:
      # npm reify in the tree resolves paths THROUGH a scope symlink and deletes/stages
      # inside the DONOR (gutted @esbuild/@typescript + stranded .staging dirs, 2026-08-24).
      # A per-package symlink caps the blast radius — rm unlinks it, the donor survives.
      if [[ "$b" == @* && -d "$e" && ! -L "$e" ]]; then
        # convert a legacy whole-scope symlink left by an older explode
        [[ -L "$nm/$b" ]] && rm "$nm/$b"
        mkdir -p "$nm/$b"
        for s in "$e"/*; do
          sb=$(basename "$s")
          [[ -e "$nm/$b/$sb" || -L "$nm/$b/$sb" ]] || ln -sh "$s" "$nm/$b/$sb"
        done
        continue
      fi
      [[ -e "$nm/$b" || -L "$nm/$b" ]] || ln -sh "$e" "$nm/$b"
    done )
  local p
  # -h + the -L guard: a dangling @loops link passes ! -e, and plain ln descends into a
  # symlinked-dir destination — minting a packages/<p>/<p> self-link (2026-08-04 push block)
  for p in "$1"/packages/*/; do
    b=$(basename "$p")
    [[ -L "$p$b" && "$(readlink "$p$b")" == "../../packages/$b" ]] && rm "$p$b"
    [[ -f "$p/package.json" && ! -e "$nm/@loops/$b" && ! -L "$nm/@loops/$b" ]] \
      && ln -sh "../../packages/$b" "$nm/@loops/$b"
  done
  # An exploded view is never LEFT drifted. This lives here rather than at the call sites because
  # the tree gets exploded from three of them, and the first one runs before the explode — which
  # is how the first cut of this silently never fired (2026-09-21).
  repoint_drifted_deps "$1"
  return 0
}

seed_prisma_client(){ # $1 = tree, $2 = main checkout; a schema.prisma that differs from the donor's
  # cannot read the donor's generated client — trade the .prisma/@prisma links for real copies and
  # generate from THIS tree's schema. Stamped by schema blob hash: no-op while current, regenerates
  # on any schema change including a revert back to the donor's.
  local tree="$1" src="$2" schema="$1/packages/prisma/schema.prisma"
  [[ -f "$schema" ]] || return 0
  local want stamp="$1/node_modules/.prisma/.seed-gen-schema"
  want=$(git -C "$tree" hash-object "$schema" 2>/dev/null) || return 0
  [[ "$(cat "$stamp" 2>/dev/null)" == "$want" ]] && return 0
  local src_head; src_head=$(git -C "$src" rev-parse HEAD 2>/dev/null)
  if [[ -L "$tree/node_modules/.prisma" && -n "$src_head" ]] \
     && git -C "$tree" diff --quiet "$src_head" HEAD -- packages/prisma/schema.prisma 2>/dev/null; then
    return 0                       # donor's client through the link still describes this schema
  fi
  local pkg sub
  for pkg in .prisma @prisma; do
    if [[ -L "$tree/node_modules/$pkg" ]]; then
      rm "$tree/node_modules/$pkg"
      cp -cR "$src/node_modules/$pkg" "$tree/node_modules/$pkg" 2>/dev/null \
        || cp -R "$src/node_modules/$pkg" "$tree/node_modules/$pkg"
    elif [[ -d "$tree/node_modules/$pkg" && ! -L "$tree/node_modules/$pkg" ]]; then
      # per-package exploded scope: trade each symlinked child — a linked @prisma/client
      # still names the DONOR's runtime in declaration emit (the TS2883 escape)
      for sub in "$tree/node_modules/$pkg"/*; do
        [[ -L "$sub" ]] || continue
        rm "$sub"
        cp -cR "$src/node_modules/$pkg/$(basename "$sub")" "$sub" 2>/dev/null \
          || cp -R "$src/node_modules/$pkg/$(basename "$sub")" "$sub"
      done
    fi
  done
  local out
  # generate never connects; prisma.config.ts still demands DATABASE_URL, and PRISMA_SCHEMA
  # feeds the schema's binaryTargets env() — native is all a typecheck needs
  if out=$(cd "$tree" && DATABASE_URL='postgresql://localhost:5432/seed-gen' PRISMA_SCHEMA='["native"]' \
             ./node_modules/.bin/prisma generate --schema packages/prisma/schema.prisma 2>&1); then
    echo "$want" > "$stamp"
    echo "generated tree-local prisma client (schema differs from the donor's)"
  else
    echo "tree-local prisma generate FAILED:"; echo "$out" | tail -5
    return 1
  fi
}

# A workspace package (packages/<p>) only becomes resolvable as @loops/<p> when npm install
# writes the node_modules/@loops link; the Taskfile's npm:install keys on package.json + the
# prisma schema, and a new workspace package changes neither (2026-09-08: safe-fetch, #10419).
# npm-owed asks npm whether this tree's node_modules matches its lockfile (dry run, hash-cached).
# Exploding fixes @loops/*, and stops there: every OTHER entry is still a symlink into the donor,
# so it carries whatever version the MAIN checkout's lockfile installed. A branch then typechecks
# its own source against another branch's dependencies, and the reds land in files the diff never
# touched — 2026-09-21, a branch 54 commits ahead of a parked main: stripe's apiVersion union
# (lib/stripe.ts) and @prisma/client's missing models, none of them the branch's doing. Repointing
# the drifted entries at their pinned versions closes that gap; a tree whose node_modules is a
# plain symlink has no per-entry link to repoint and is left alone.
deps_drift(){ # $1 = tree; prints "<name>\t<version this branch pins>" for each drifted borrowed dep
  python3 - "$1" <<'PYEOF'
import json, os, re, sys
tree = sys.argv[1]

# npm normalises a lockfile version, the published package.json need not be normalised at all:
# @upstash/ratelimit ships "v2.0.8" against a lock that pins "2.0.8". Comparing the raw strings
# called that drifted forever — repointing it on every single sync (caught 2026-09-21 by the
# repoint not being idempotent). Anything that still disagrees after this is real drift.
def norm(v):
    return re.sub(r"^[vV]", "", v).strip() if isinstance(v, str) else v
try:
    lock = json.load(open(os.path.join(tree, "package-lock.json")))
except Exception:
    sys.exit(0)
for path, meta in (lock.get("packages") or {}).items():
    if not path.startswith("node_modules/"):
        continue
    name = path[len("node_modules/"):]
    if "node_modules/" in name or meta.get("link"):
        continue                      # a nested dep, or a workspace link — explode owns those
    want = meta.get("version")
    if not want:
        continue
    entry = os.path.join(tree, "node_modules", name)
    if not os.path.islink(entry):
        continue                      # already tree-local: npm-owed judges those
    try:
        have = json.load(open(os.path.join(entry, "package.json"))).get("version")
    except Exception:
        continue
    # a git/file/link/alias dep carries a version the registry cannot be asked for — npm would
    # resolve the spec, not the number, so leave those to npm-owed rather than guess
    resolved = meta.get("resolved") or ""
    if resolved and not resolved.startswith(("http://", "https://")):
        continue
    if have and norm(have) != norm(want):
        print("%s\t%s" % (name, want))
PYEOF
}

# The repair has to be DETERMINISTIC — it runs inside stack-gates' env_repair, whose whole
# contract is that a gate red means the code is wrong, not the environment. `npm install <pkg>@<v>`
# is not: it asks the registry to re-resolve that package's own dependency ranges, so the tree it
# builds depends on what was published today, carries no integrity pinning from this branch, and
# needs the network. That is the same defect this function exists to fix, one level down.
# The branch's lockfile already pins the exact answer — version, tarball URL and integrity — for
# the package AND its whole closure, so build a minimal lockfile out of it and `npm ci` that: no
# resolver, integrity-checked, and offline once npm's cache is warm.
deps_scratch_lock(){ # $1 = tree, $2 = scratch, rest = package names. exit 3 = scratch already serves them
  local tree="$1" scratch="$2"; shift 2
  python3 - "$tree" "$scratch" "$@" <<'PYEOF'
import json, os, sys
tree, scratch, names = sys.argv[1], sys.argv[2], sys.argv[3:]
lock = json.load(open(os.path.join(tree, "package-lock.json")))
pkgs = lock.get("packages") or {}

def resolve(frm, dep):
    """npm's own lookup: nearest enclosing node_modules, then walk outward."""
    base = frm
    while True:
        cand = (base + "/node_modules/" + dep) if base else ("node_modules/" + dep)
        if cand in pkgs:
            return cand
        if not base:
            return None
        i = base.rfind("/node_modules/")
        base = base[:i] if i != -1 else ""

roots = {}
queue = []
for n in names:
    k = "node_modules/" + n
    meta = pkgs.get(k)
    if meta and meta.get("version") and not meta.get("link"):
        roots[n] = meta["version"]
        queue.append(k)
if not roots:
    sys.exit(1)

# Union with whatever this scratch already serves: another tree on the same lockfile may be
# reading through it right now, and npm ci rebuilds node_modules from scratch — dropping its
# packages mid-typecheck would be exactly the stomp the shared scratch is supposed to avoid.
prev = {}
try:
    prev = (json.load(open(os.path.join(scratch, "package.json"))).get("dependencies") or {})
except Exception:
    pass
merged = dict(prev); merged.update(roots)
# Only names this lockfile can actually satisfy. The scratch is keyed by lock hash so a stale
# root should be impossible, but a manifest claiming a dep the lock has no entry for makes
# `npm ci` refuse the whole tree — a cheap filter beats a scratch that can never install again.
merged = {n: v for n, v in merged.items()
          if pkgs.get("node_modules/" + n) and not pkgs["node_modules/" + n].get("link")}
if not merged:
    sys.exit(1)

keep, seen = {}, set()
queue = [("node_modules/" + n) for n in merged if ("node_modules/" + n) in pkgs]
while queue:
    k = queue.pop()
    if k in seen:
        continue
    seen.add(k)
    meta = dict(pkgs[k])
    if meta.get("link"):          # a workspace ref has no tarball to fetch; not our business
        continue
    # The closure is installed for its own sake, so a `dev` mark would make npm prune exactly
    # what we asked for. `optional` must SURVIVE though: it is what lets npm skip a dependency
    # built for another platform, and stripping it turned @oxc-parser's android/arm binary into
    # a required install — npm ci dies EBADPLATFORM on a mac. devOptional is the optional dep of
    # a dev dep, so it becomes plainly optional here rather than plainly required.
    if meta.pop("devOptional", None):
        meta["optional"] = True
    meta.pop("dev", None)
    keep[k] = meta
    for field in ("dependencies", "optionalDependencies", "peerDependencies"):
        for d in (meta.get(field) or {}):
            r = resolve(k, d)
            if r and r not in seen:
                queue.append(r)

root = {"name": "seed-gen-deps", "version": "0.0.0", "license": "UNLICENSED", "dependencies": merged}
manifest = {"name": "seed-gen-deps", "version": "0.0.0", "private": True,
            "license": "UNLICENSED", "dependencies": merged}
new_lock = {"name": "seed-gen-deps", "version": "0.0.0", "lockfileVersion": 3, "requires": True,
            "packages": dict([("", root)] + sorted(keep.items()))}

def same(path, obj):
    try:
        return json.load(open(path)) == obj
    except Exception:
        return False

lp = os.path.join(scratch, "package-lock.json")
mp = os.path.join(scratch, "package.json")
if same(mp, manifest) and same(lp, new_lock) and all(
        os.path.exists(os.path.join(scratch, "node_modules", n)) for n in merged):
    sys.exit(3)
json.dump(manifest, open(mp, "w"), indent=2)
json.dump(new_lock, open(lp, "w"), indent=2)
PYEOF
}

repoint_drifted_deps(){ # $1 = tree; echoes a note when it acted
  local tree="$1" drift n stamp scratch name ver landed
  [[ -f "$tree/package-lock.json" ]] || return 0
  exploded "$tree" || return 0
  drift=$(deps_drift "$tree" 2>/dev/null) || return 0
  [[ -n "$drift" ]] || return 0
  n=$(grep -c . <<<"$drift")
  # A big delta means the donor is simply the wrong tree, not that a few packages slipped, and
  # installing 170 packages per worktree is not the answer to that — measured on this machine,
  # a branch a few weeks behind a parked main drifts 140-170 deps. Warn and move on: a gate that
  # refused to run here would wedge every worktree on the machine, and blocking a push over the
  # environment is not this tool's call (the same reason the .gen provenance check only explains
  # a red). --check reports the drift at any size, so a red is never left looking like the code.
  if (( n > 60 )); then
    echo "node_modules borrows $n deps at versions this branch does not pin — too many to repoint; npm install in the main checkout, or give this tree a real node_modules"
    return 0
  fi
  stamp=$(md5 -q "$tree/package-lock.json" 2>/dev/null) || return 0
  # Keyed by lockfile, so trees on the same lock share one install. OUTSIDE the worktree on
  # purpose: npm takes its project root from the nearest package.json, so a scratch under the
  # tree would reify into the tree itself — the same stomp the per-package explode exists to stop.
  scratch="$HOME/.cache/seed-gen/deps/$stamp"
  mkdir -p "$scratch" || return 0
  # a plain string, not an array: bash 3.2 expands an empty "${a[@]:-}" to one EMPTY argument,
  # so the array form seeds the command with a bare "". Package names never contain spaces.
  local wanted=""
  while IFS=$'\t' read -r name ver; do
    [[ -n "$name" ]] && wanted="$wanted $name"
  done <<<"$drift"
  [[ -n "$wanted" ]] || return 0
  deps_scratch_lock "$tree" "$scratch" $wanted
  case $? in
    0) if ! ( cd "$scratch" && npm ci --no-audit --no-fund ) >/dev/null 2>&1; then
         echo "node_modules borrows $n dep(s) at the wrong version ($(cut -f1 <<<"$drift" | head -3 | tr '\n' ' ')…) and the pinned repoint install failed — a typecheck here answers for the main checkout, not this branch"
         return 0
       fi ;;
    3) ;;                        # the scratch already serves every one of them, pinned
    *) echo "node_modules borrows $n dep(s) at the wrong version but this branch's lockfile does not pin them — leaving the donor's"
       return 0 ;;
  esac
  landed=0
  while IFS=$'\t' read -r name ver; do
    [[ -n "$name" && -L "$tree/node_modules/$name" && -d "$scratch/node_modules/$name" ]] || continue
    if rm "$tree/node_modules/$name" && ln -sh "$scratch/node_modules/$name" "$tree/node_modules/$name"; then
      landed=$((landed + 1))
    fi
  done <<<"$drift"
  if (( landed )); then
    echo "node_modules borrowed $landed dep(s) at the main checkout's versions — repointed at this branch's: $(cut -f1 <<<"$drift" | tr '\n' ' ')"
  fi
  return 0
}

install_if_owed(){ # $1 = tree with a REAL node_modules; echoes a note when it acted
  local what
  what="$("$(dirname "$0")/npm-owed" "$1" 2>/dev/null)" || return 0
  if "$(dirname "$0")/npm-owed" --install "$1" >/dev/null 2>"$1/.gen/.npm-owed.err"; then
    echo "node_modules was behind package-lock.json ($what) — ran npm install"
  else
    echo "node_modules is behind package-lock.json ($what) but npm install FAILED:"; tail -5 "$1/.gen/.npm-owed.err"
    return 1
  fi
}

build_packages(){ # $1 = tree; every packages/*/tsconfig.json, with the canonical tsc (no-op-fast when current)
  local tsc="$1/node_modules/typescript/bin/tsc"
  [[ -e "$tsc" ]] || return 0
  local cfgs=() p
  for p in "$1"/packages/*/tsconfig.json; do [[ -f "$p" ]] && cfgs+=("${p#"$1"/}"); done
  (( ${#cfgs[@]} )) || return 0
  (cd "$1" && "$HOME/.volta/bin/node" "$tsc" -b "${cfgs[@]}" --pretty false 2>&1)
}

trpc_types_project(){ # $1 = tree; echoes the tsconfig path or nothing
  local proj=typescript/tsconfig.trpc-types.json            # moved under typescript/ by loops #9599
  [[ -f "$1/$proj" ]] || proj=tsconfig.trpc-types.json      # a pre-split branch still has it at the root
  [[ -f "$1/$proj" ]] && echo "$proj"
}

# --check <worktree>: are the generated types AND the borrowed dependencies this tree reads
# trustworthy FOR THE BRANCH IT IS ON?
# The marker is read from THIS tree's .gen (through a symlink that is main's marker; a
# self-built copy carries its own) — a copy with no marker has no provenance at all.
# Exit 0 = trustworthy. Exit 1 = say so out loud instead of reporting a confident red.
if [[ "${1:-}" == --check ]]; then
  dir="${2:?usage: seed-gen --check <worktree-dir>}"
  [[ -d "$dir/.gen" || -L "$dir/.gen" ]] || { echo "no generated tRPC types in this tree"; exit 1; }
  sha=$(cat "$dir/.gen/.seed-gen-sha" 2>/dev/null)
  head=$(git -C "$dir" rev-parse HEAD 2>/dev/null)
  branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
  [[ "$branch" == HEAD ]] && branch=$(cat "$(git -C "$dir" rev-parse --git-dir)/stack-open-branch" 2>/dev/null || echo "$head")
  fix="$(cd "$(dirname "$0")" && pwd -P)/seed-gen --sync ${dir}"
  drift=$(deps_drift "$dir" 2>/dev/null) || drift=""
  if [[ -n "$drift" ]]; then
    echo "this tree borrows $(grep -c . <<<"$drift") dependency(ies) from the main checkout at versions this branch does not pin: $(cut -f1 <<<"$drift" | head -5 | tr '\n' ' ')"
    echo "  errors above in files your diff never touched may be those deps, not your code"
    echo "  repair: $fix"; exit 1
  fi
  if [[ -z "$sha" ]]; then
    echo "generated tRPC types have no provenance marker — cannot tell what they describe"
    echo "  rebuild for this tree: $fix"; exit 1
  fi
  if ! git -C "$dir" merge-base --is-ancestor "$sha" "$head" 2>/dev/null; then
    where=$(git -C "$dir" branch --contains "$sha" 2>/dev/null | head -3 | tr -d ' *' | tr '\n' ' ')
    echo "generated tRPC types were built from ${sha:0:10} (${where:-on no branch}), which is not in ${branch}"
    echo "  any tRPC type error above may be the types, not your code"
    echo "  rebuild for this tree: $fix"; exit 1
  fi
  if ! git -C "$dir" diff --quiet "$sha" "$head" -- trpc 2>/dev/null; then
    echo "this branch changes trpc/ beyond what the generated types were built for (${sha:0:10})"
    echo "  tRPC shape errors above may be the types, not your code"
    echo "  rebuild for this tree: $fix"; exit 1
  fi
  exit 0
fi

sync=0
[[ "${1:-}" == --sync ]] && { sync=1; shift; }
dir="${1:?usage: seed-gen [--sync] <worktree-dir>}"
# realpath: a /tmp spelling makes tsgo treat the tree's own node_modules as external
# (/private/tmp realpaths) and dts emit fails with TS2883
dir=$(realpath_of "$dir") || exit 0

# source .gen from the donor (stack-donor: the origin/main donor, else the first worktree), not
# wherever this runs — a sibling worktree has no .gen of its own (gitignored).
src=$("$(dirname "$0")/stack-donor" "$dir" 2>/dev/null) \
  || src=$(git -C "$dir" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}')
[[ -n "$src" && -d "$src/.gen" ]] || exit 0                  # nothing to seed from

if [[ "$(realpath_of "$dir")" != "$(realpath_of "$src")" ]]; then
  _gitdir=$(git -C "$dir" rev-parse --path-format=absolute --git-dir 2>/dev/null) || exit 0
  wait_lock "$_gitdir/seed-gen.lock" || { echo "a seed-gen run has held this tree for over 10 minutes"; exit 1; }
  tree_lock="$_gitdir/seed-gen.lock"; trap drop_tree_lock EXIT

  if (( sync )); then
    head=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || exit 0
    repair_node_modules "$dir" "$src"
    # a branch whose packages/* source differs from what main's dist was built from cannot
    # typecheck through main's node_modules — give it its own view + its own dist. An already-
    # exploded tree rebuilds unconditionally (no-op-fast) so a revert can't leave dist stale.
    main_head=$(git -C "$src" rev-parse HEAD 2>/dev/null)
    if exploded "$dir" \
       || { [[ -n "$main_head" ]] \
            && ! git -C "$dir" diff --quiet "$main_head" HEAD -- packages ':(exclude)packages/prisma/migrations' 2>/dev/null; }; then
      if ! exploded "$dir"; then
        explode_node_modules "$dir" "$src" && echo "packages source differs from main — gave this tree its own node_modules view"
      fi
      if out=$(build_packages "$dir"); then
        [[ -n "$out" ]] && { echo "tree-local packages dist build:"; echo "$out" | tail -3; }
      else
        echo "tree-local packages dist build FAILED:"; echo "$out" | tail -5
        exit 1
      fi
    fi
    seed_prisma_client "$dir" "$src" || exit 1
    marker="$dir/.gen/.seed-gen-sha"
    # trust the marker only in a private .gen — through a symlink it is MAIN's marker, and a
    # concurrent stamp-through-the-link can make it claim this branch's HEAD (2026-08-03)
    [[ ! -L "$dir/.gen" && -f "$marker" && "$(cat "$marker" 2>/dev/null)" == "$head" ]] && exit 0
    if [[ -L "$dir/.gen" ]]; then
      # main's .gen through a link — keep it only if it already describes this HEAD.
      # The diff must cover everything root.d.ts inlines through, not trpc/ alone: router
      # inputs come from lib/ zod schemas and outputs from models/ + queries/ (a branch
      # adding a lib/types/UserPreferences key kept main's stale link, 2026-08-03).
      sha=$(cat "$dir/.gen/.seed-gen-sha" 2>/dev/null)
      if [[ -n "$sha" ]] && git -C "$dir" merge-base --is-ancestor "$sha" "$head" 2>/dev/null \
         && git -C "$dir" diff --quiet "$sha" "$head" -- trpc lib models queries packages ':(exclude)packages/prisma/migrations' 2>/dev/null; then
        exit 0
      fi
      rm -f "$dir/.gen"
      echo "traded main's .gen link for a private copy (seed does not describe this branch)"
    fi
    if [[ ! -e "$dir/.gen" ]]; then
      cp -cR "$src/.gen" "$dir/.gen" 2>/dev/null || cp -R "$src/.gen" "$dir/.gen" 2>/dev/null || mkdir -p "$dir/.gen"
      rm -f "$marker"                     # the copy was built for main's HEAD, not this one
      rm -rf "$dir/.gen/.rebuilding"      # a lock riding along in the copy is not ours
    fi
    proj=$(trpc_types_project "$dir") || exit 0
    tsc="$dir/node_modules/typescript/bin/tsc"
    [[ -e "$tsc" ]] || { echo "no repo-local tsc — cannot rebuild types here"; exit 0; }
    # declaration emit names .prisma types relative to where node_modules PHYSICALLY lives — through
    # a symlinked node_modules the reference escapes the tree: tsc trips TS2883, and tsgo silently
    # emits `user?: Prisma` (namespace-as-type → every consumer goes unknown/any, 2026-08-04).
    # Real tree-local .prisma/@prisma keep the reference inside; emit with tsc, never tsgo.
    if ! exploded "$dir"; then
      explode_node_modules "$dir" "$src" && echo "exploded node_modules for a tree-local types rebuild"
      if out=$(build_packages "$dir"); then
        [[ -n "$out" ]] && { echo "tree-local packages dist build:"; echo "$out" | tail -3; }
      else
        echo "tree-local packages dist build FAILED:"; echo "$out" | tail -5
        exit 1
      fi
    fi
    for _pkg in .prisma @prisma; do
      if [[ -L "$dir/node_modules/$_pkg" ]]; then
        rm "$dir/node_modules/$_pkg"
        cp -cR "$src/node_modules/$_pkg" "$dir/node_modules/$_pkg" 2>/dev/null \
          || cp -R "$src/node_modules/$_pkg" "$dir/node_modules/$_pkg"
      elif [[ -d "$dir/node_modules/$_pkg" && ! -L "$dir/node_modules/$_pkg" ]]; then
        # per-package exploded scope: a linked @prisma/client child still names the donor's
        # runtime in declaration emit → TS2883, so trade each symlinked child for a real copy
        for _sub in "$dir/node_modules/$_pkg"/*; do
          [[ -L "$_sub" ]] || continue
          rm "$_sub"
          cp -cR "$src/node_modules/$_pkg/$(basename "$_sub")" "$_sub" 2>/dev/null \
            || cp -R "$src/node_modules/$_pkg/$(basename "$_sub")" "$_sub"
        done
      fi
    done
    take_lock "$dir/.gen" || { echo "a types rebuild is already in flight in this tree"; exit 1; }
    if out=$(cd "$dir" && "$HOME/.volta/bin/node" "$tsc" --project "$proj" --pretty false 2>&1); then
      # never stamp through a symlink: the async scratch path can re-link .gen to main's mid-
      # rebuild, and writing then poisons MAIN's marker with this branch's HEAD (2026-08-03)
      [[ ! -L "$dir/.gen" && "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" == "$head" ]] && echo "$head" > "$marker"
      drop_lock "$dir/.gen"
      echo "rebuilt tRPC types for ${head:0:10} in this tree"
    else
      drop_lock "$dir/.gen"
      echo "tRPC types rebuild FAILED:"; echo "$out" | tail -5
      exit 1
    fi
    exit 0
  fi

  scratch=$(realpath_of "${STACK_OPEN_DIR:-$HOME/Library/Caches/stack-study}")
  if [[ -n "$scratch" && "$(realpath_of "$dir")" == "$scratch"/* ]]; then
    # Nothing in a scratch tree rebuilds .gen on the async path, so a private copy is 17M of
    # types frozen at whenever it was seeded — including the 47 the pre-2026-07-22 seeders left
    # behind. Trade each one for the live link on its next open, unless a rebuild is holding it.
    # A marker matching HEAD is a --sync-built copy that is MORE accurate than main's seed: keep it.
    if [[ ! -L "$dir/.gen" && -d "$dir/.gen" && ! -d "$dir/.gen/.rebuilding" ]]; then
      if [[ "$(cat "$dir/.gen/.seed-gen-sha" 2>/dev/null)" != "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" ]]; then
        rm -rf "$dir/.gen"
      fi
    fi
    [[ -e "$dir/.gen" ]] || ln -sfn "$src/.gen" "$dir/.gen"
    exit 0
  fi
  if [[ ! -e "$dir/.gen" ]]; then
    cp -cR "$src/.gen" "$dir/.gen" 2>/dev/null \
      || cp -R "$src/.gen" "$dir/.gen" 2>/dev/null || exit 0  # COW clone, fall back to plain copy
  fi
  # A copied marker describes the tree it was copied FROM: left in place it claims this
  # worktree's .gen was built for a commit it has never seen. (A marker matching this tree's
  # HEAD is a --sync-built .gen — that one is real, keep it.)
  if [[ ! -L "$dir/.gen" && "$(cat "$dir/.gen/.seed-gen-sha" 2>/dev/null)" != "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" ]]; then
    rm -f "$dir/.gen/.seed-gen-sha"
  fi
  exit 0
fi

head=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || exit 0
marker="$dir/.gen/.seed-gen-sha"
# Ahead of the marker early-exit: the marker vouches for .gen, not for node_modules, and every
# other tree resolves @loops/* and its deps through this checkout's node_modules.
if (( sync )); then install_if_owed "$dir" || exit 1; fi
[[ -f "$marker" && "$(cat "$marker" 2>/dev/null)" == "$head" ]] && exit 0   # already built for this HEAD
# Gate on HEAD alone, never on `git diff main...HEAD -- <inputs>`: that gate is empty when the
# checkout comes back TO main, so .gen kept whatever shape the last feature branch left it —
# which is how the seed every other worktree copies got poisoned.

proj=$(trpc_types_project "$dir") || exit 0

tsc="$dir/node_modules/typescript/bin/tsc"
ts_major=$(sed -n 's/.*"version": *"\([0-9]*\)\..*/\1/p' "$dir/node_modules/typescript/package.json" 2>/dev/null | head -1)
tsgo="$dir/node_modules/.bin/tsgo"
[[ -x "$tsgo" ]] || tsgo=$(command -v tsgo 2>/dev/null) || tsgo=""
[[ -n "$tsgo" || -e "$tsc" ]] || exit 0                      # no compiler → keep what's there
if ! take_lock "$dir/.gen"; then
  (( sync )) && { echo "a types rebuild has held the main checkout for over 10 minutes"; exit 1; }
  exit 0
fi
if [[ -f "$marker" && "$(cat "$marker" 2>/dev/null)" == "$head" ]]; then
  drop_lock "$dir/.gen"; (( sync )) && echo "joined a types rebuild that just finished for ${head:0:10}"; exit 0
fi

if [[ -e "$tsc" && "${ts_major:-0}" -ge 7 ]]; then
  build=("$HOME/.volta/bin/node" "$tsc")     # TS7 tsc IS the native compiler
elif [[ -n "$tsgo" ]]; then
  build=("$tsgo")                            # pre-TS7 tsc: TS2883 partial emit (header)
else
  build=("$HOME/.volta/bin/node" "$tsc")
fi

build_main(){
  cd "$dir"
  # packages/*/dist (gitignored, built locally) feeds @loops/* resolution in BOTH the .gen emit
  # and the app typecheck, and `tsc -b` is a no-op when nothing changed. Build with tsc (not
  # tsgo) to match the canonical `task build:packages`, so the shared dist/*.tsbuildinfo never
  # thrashes between two compilers.
  build_packages "$dir" >/dev/null 2>&1
  # A HEAD that moved during the build would make this stamp claim a shape .gen doesn't have.
  "${build[@]}" --project "$proj" --pretty false >/dev/null 2>&1 \
    && [[ "$(git rev-parse HEAD 2>/dev/null)" == "$head" ]] && echo "$head" > "$marker"
  drop_lock "$dir/.gen"
}

if (( sync )); then
  build_main
  if [[ "$(cat "$marker" 2>/dev/null)" == "$head" ]]; then
    echo "rebuilt main checkout types (+packages dist) for ${head:0:10}"
  else
    echo "main checkout types rebuild FAILED (or HEAD moved during the build)"; exit 1
  fi
else
  # The subshell drops the inherited stdout/stderr too, not just the compiler's: a caller that
  # pipes us waits for EOF on those fds, so holding them open makes this "background" rebuild
  # block that caller for as long as the compile takes. Call the binary DIRECTLY (never npx —
  # backgrounded npx with no TTY hangs on its install prompt and piles up runaway procs).
  ( build_main ) >/dev/null 2>&1 &
fi
