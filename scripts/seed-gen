#!/usr/bin/env bash
# seed-gen <worktree-dir>
#
# Give a worktree a .gen so `tsc`/the editor can resolve #trpc imports. Without it the tRPC
# client type COLLAPSES to the "collides with a built-in method" sentinel and every
# trpc.*.useQuery in the app reports as a bogus error (hundreds of .tsx errors, verified).
# .gen is gitignored and only ever built in the main checkout, so a fresh sibling worktree
# has none.
#
# Clone main's .gen (APFS copy-on-write, ~instant) as a baseline so the worktree never
# collapses — a COW clone, NOT a symlink: a regen in the worktree must not write through
# into main's .gen. Then, ONLY if the branch touches something the declaration build reads
# and we haven't already built for this HEAD, kick a background incremental rebuild so the
# types reflect the branch. Never blocks. NB: .gen does NOT reduce tsc memory — purely correctness.
set -u

dir="${1:?usage: seed-gen <worktree-dir>}"

# source .gen from the MAIN checkout (first worktree), not wherever this runs — a sibling
# worktree has no .gen of its own (gitignored, only built in main).
src=$(git -C "$dir" worktree list --porcelain | awk '/^worktree /{print $2; exit}')
[[ -n "$src" && -d "$src/.gen" ]] || exit 0                  # nothing to seed from
[[ -d "$dir/.gen" ]] || cp -cR "$src/.gen" "$dir/.gen" 2>/dev/null \
  || cp -R "$src/.gen" "$dir/.gen" 2>/dev/null || exit 0     # COW clone, fall back to plain copy

head=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || exit 0
marker="$dir/.gen/.seed-gen-sha"
[[ -f "$marker" && "$(cat "$marker" 2>/dev/null)" == "$head" ]] && exit 0   # already built for this HEAD
# root.d.ts inlines every procedure's output type, so it carries ~500 references into lib/,
# models/ and queries/ — watching trpc/ alone leaves .gen silently stale (and stale .gen
# typechecks GREEN against yesterday's field names, which is the bad kind of wrong).
git -C "$dir" diff --quiet main...HEAD -- trpc lib models queries packages tsconfig.trpc-types.json 2>/dev/null && exit 0

tsgo="$dir/node_modules/.bin/tsgo"                           # ~3x faster; falls back to tsc
[[ -x "$tsgo" ]] || tsgo=""
tsc="$dir/node_modules/typescript/bin/tsc"
[[ -n "$tsgo" || -e "$tsc" ]] || exit 0                      # no compiler → keep the cloned baseline
mkdir "$dir/.gen/.rebuilding" 2>/dev/null || exit 0          # single-flight lock: a rebuild is already in flight

# background incremental rebuild → stamp the sha, release the lock. Call the binary DIRECTLY
# (never npx — backgrounded npx with no TTY hangs on its install prompt and piles up runaway procs).
if [[ -n "$tsgo" ]]; then
  build=("$tsgo")
else
  build=("$HOME/.volta/bin/node" "$tsc")
fi
( cd "$dir"
  # packages/*/dist (gitignored, built locally) feeds @loops/* resolution in BOTH the .gen emit
  # and the app typecheck. A branch that changed package source leaves dist stale, so the .gen
  # would regen against yesterday's package types. Rebuild it first — gated on packages actually
  # changing so app-only branches skip it. Packages are still moduleResolution=node10, which tsgo
  # rejects (TS5108), so build them with tsc even when the .gen emit below uses tsgo.
  if [[ -e "$tsc" ]] && ! git diff --quiet main...HEAD -- packages 2>/dev/null; then
    "$HOME/.volta/bin/node" "$tsc" -b \
      packages/settings/tsconfig.json packages/valkey/tsconfig.json packages/mail-pg/tsconfig.json \
      packages/realtime-client/tsconfig.json packages/prisma/tsconfig.json --pretty false >/dev/null 2>&1
  fi
  "${build[@]}" --project tsconfig.trpc-types.json --pretty false >/dev/null 2>&1 && echo "$head" > "$marker"
  rmdir "$dir/.gen/.rebuilding" 2>/dev/null ) &
