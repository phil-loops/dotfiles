#!/usr/bin/env bash
# seed-gen [--sync] <worktree-dir>
#
# Give a worktree a .gen so `tsc`/the editor can resolve #trpc imports. Without it the tRPC
# client type COLLAPSES to the "collides with a built-in method" sentinel and every
# trpc.*.useQuery in the app reports as a bogus error (hundreds of .tsx errors, verified).
# .gen is gitignored, so a fresh sibling worktree has none.
#
# ONE implementation for every caller — the git hooks (post-checkout/-merge/-rewrite),
# stack-open, and stack-gates. Two copies of this logic drifted apart and each drift was a
# silent bug: this one's rebuild aimed at a tsconfig loops had moved (dead since 2026-07-19),
# and stack-open's copy watched only trpc/ while this one watched the real input set.
#
# Which trees can build a correct .gen: the main checkout always (real node_modules, either
# compiler). Everywhere else node_modules is a symlink, and typescript<7's tsc trips TS2883
# there (prisma-inferred exports resolve outside the project root), silently skipping the
# aggregates the client type resolves through — the native compiler (tsgo, and tsc itself
# since TS7) emits the full tree correctly (verified 2026-07-30). So in-tree rebuilds outside
# the main checkout are native-compiler-only: the tree's own tsc on TS7, tsgo on pre-TS7.
#
#   default (hooks; async, never blocks):
#     main checkout        rebuild whenever HEAD moved off what .gen was built for
#     scratch review tree  symlink main's .gen — a read surface, nothing there writes it
#     any other worktree   copy main's .gen — `task dev` there must not write through
#
#   --sync (stack-gates; foreground): make THIS tree's .gen describe THIS tree's HEAD —
#     reseed from main if absent, trade a symlink for a private copy rather than write
#     through it, emit in-tree, stamp .gen/.seed-gen-sha with the HEAD it now
#     describes. Prints one line per action taken; silent no-op when already accurate.
#
# NB: .gen does NOT reduce tsc memory — purely correctness.
set -u

realpath_of(){ (cd "$1" 2>/dev/null && pwd -P); }

# .rebuilding is the single-flight lock. A crashed build strands it, and a stranded lock
# silently freezes that tree's .gen forever (bit us 2026-07-30) — steal locks older than 10m.
take_lock(){ # $1 = the .gen dir
  local lock="$1/.rebuilding"
  mkdir "$lock" 2>/dev/null && return 0
  local age=$(( $(date +%s) - $(stat -f %m "$lock" 2>/dev/null || echo 0) ))
  (( age > 600 )) && rm -rf "$lock" && mkdir "$lock" 2>/dev/null && return 0
  return 1
}

drop_lock(){ rmdir "$1/.rebuilding" 2>/dev/null; }

# A node_modules symlink aimed anywhere but the main checkout reads some other tree's frozen
# packages/*/dist (the wt-075238 donor rot, 2026-07-30) — repoint it. A real dir is left alone.
repair_node_modules(){ # $1 = tree, $2 = main checkout; echoes a note when it acted
  local nm="$1/node_modules" target="$2/node_modules"
  [[ -L "$nm" && -d "$target" ]] || return 0
  [[ "$(realpath_of "$nm")" == "$(realpath_of "$target")" ]] && return 0
  local old; old=$(readlink "$nm")
  rm "$nm" && ln -s "$target" "$nm" && echo "node_modules pointed at $old — repointed at the main checkout"
}

# @loops/* resolves through node_modules/@loops/<p> → ../../packages/<p>, relative to where
# node_modules PHYSICALLY lives — so a tree whose node_modules is a symlink to main's can never
# see its own packages/* changes. "Exploding" gives the tree a real node_modules directory of
# per-entry symlinks into main's, except @loops, which points at the tree's own packages.
exploded(){ # $1 = tree: real node_modules whose @loops resolves tree-locally
  [[ ! -L "$1/node_modules" && -d "$1/node_modules/@loops" ]] \
    && [[ "$(realpath_of "$1/node_modules/@loops/prisma")" == "$(realpath_of "$1/packages/prisma")" ]]
}

explode_node_modules(){ # $1 = tree, $2 = main checkout; idempotent, tops up new entries
  local nm="$1/node_modules" src_nm="$2/node_modules"
  [[ -d "$src_nm" ]] || return 1
  [[ -L "$nm" ]] && rm "$nm"
  mkdir -p "$nm/@loops"
  local e b
  ( shopt -s dotglob nullglob
    for e in "$src_nm"/*; do
      b=$(basename "$e")
      [[ "$b" == "@loops" ]] && continue
      [[ -e "$nm/$b" || -L "$nm/$b" ]] || ln -sh "$e" "$nm/$b"
    done )
  local p
  # -h + the -L guard: a dangling @loops link passes ! -e, and plain ln descends into a
  # symlinked-dir destination — minting a packages/<p>/<p> self-link (2026-08-04 push block)
  for p in "$1"/packages/*/; do
    b=$(basename "$p")
    [[ -L "$p$b" && "$(readlink "$p$b")" == "../../packages/$b" ]] && rm "$p$b"
    [[ -f "$p/package.json" && ! -e "$nm/@loops/$b" && ! -L "$nm/@loops/$b" ]] \
      && ln -sh "../../packages/$b" "$nm/@loops/$b"
  done
  return 0
}

seed_prisma_client(){ # $1 = tree, $2 = main checkout; a schema.prisma that differs from the donor's
  # cannot read the donor's generated client — trade the .prisma/@prisma links for real copies and
  # generate from THIS tree's schema. Stamped by schema blob hash: no-op while current, regenerates
  # on any schema change including a revert back to the donor's.
  local tree="$1" src="$2" schema="$1/packages/prisma/schema.prisma"
  [[ -f "$schema" ]] || return 0
  local want stamp="$1/node_modules/.prisma/.seed-gen-schema"
  want=$(git -C "$tree" hash-object "$schema" 2>/dev/null) || return 0
  [[ "$(cat "$stamp" 2>/dev/null)" == "$want" ]] && return 0
  local src_head; src_head=$(git -C "$src" rev-parse HEAD 2>/dev/null)
  if [[ -L "$tree/node_modules/.prisma" && -n "$src_head" ]] \
     && git -C "$tree" diff --quiet "$src_head" HEAD -- packages/prisma/schema.prisma 2>/dev/null; then
    return 0                       # donor's client through the link still describes this schema
  fi
  local pkg
  for pkg in .prisma @prisma; do
    [[ -L "$tree/node_modules/$pkg" ]] || continue
    rm "$tree/node_modules/$pkg"
    cp -cR "$src/node_modules/$pkg" "$tree/node_modules/$pkg" 2>/dev/null \
      || cp -R "$src/node_modules/$pkg" "$tree/node_modules/$pkg"
  done
  local out
  # generate never connects; prisma.config.ts still demands DATABASE_URL, and PRISMA_SCHEMA
  # feeds the schema's binaryTargets env() — native is all a typecheck needs
  if out=$(cd "$tree" && DATABASE_URL='postgresql://localhost:5432/seed-gen' PRISMA_SCHEMA='["native"]' \
             ./node_modules/.bin/prisma generate --schema packages/prisma/schema.prisma 2>&1); then
    echo "$want" > "$stamp"
    echo "generated tree-local prisma client (schema differs from the donor's)"
  else
    echo "tree-local prisma generate FAILED:"; echo "$out" | tail -5
    return 1
  fi
}

build_packages(){ # $1 = tree; every packages/*/tsconfig.json, with the canonical tsc (no-op-fast when current)
  local tsc="$1/node_modules/typescript/bin/tsc"
  [[ -e "$tsc" ]] || return 0
  local cfgs=() p
  for p in "$1"/packages/*/tsconfig.json; do [[ -f "$p" ]] && cfgs+=("${p#"$1"/}"); done
  (( ${#cfgs[@]} )) || return 0
  (cd "$1" && "$HOME/.volta/bin/node" "$tsc" -b "${cfgs[@]}" --pretty false 2>&1)
}

trpc_types_project(){ # $1 = tree; echoes the tsconfig path or nothing
  local proj=typescript/tsconfig.trpc-types.json            # moved under typescript/ by loops #9599
  [[ -f "$1/$proj" ]] || proj=tsconfig.trpc-types.json      # a pre-split branch still has it at the root
  [[ -f "$1/$proj" ]] && echo "$proj"
}

# --check <worktree>: is the .gen this tree reads trustworthy FOR THE BRANCH IT IS ON?
# The marker is read from THIS tree's .gen (through a symlink that is main's marker; a
# self-built copy carries its own) — a copy with no marker has no provenance at all.
# Exit 0 = trustworthy. Exit 1 = say so out loud instead of reporting a confident red.
if [[ "${1:-}" == --check ]]; then
  dir="${2:?usage: seed-gen --check <worktree-dir>}"
  [[ -d "$dir/.gen" || -L "$dir/.gen" ]] || { echo "no generated tRPC types in this tree"; exit 1; }
  sha=$(cat "$dir/.gen/.seed-gen-sha" 2>/dev/null)
  head=$(git -C "$dir" rev-parse HEAD 2>/dev/null)
  branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
  [[ "$branch" == HEAD ]] && branch=$(cat "$(git -C "$dir" rev-parse --git-dir)/stack-open-branch" 2>/dev/null || echo "$head")
  fix="$(cd "$(dirname "$0")" && pwd -P)/seed-gen --sync ${dir}"
  if [[ -z "$sha" ]]; then
    echo "generated tRPC types have no provenance marker — cannot tell what they describe"
    echo "  rebuild for this tree: $fix"; exit 1
  fi
  if ! git -C "$dir" merge-base --is-ancestor "$sha" "$head" 2>/dev/null; then
    where=$(git -C "$dir" branch --contains "$sha" 2>/dev/null | head -3 | tr -d ' *' | tr '\n' ' ')
    echo "generated tRPC types were built from ${sha:0:10} (${where:-on no branch}), which is not in ${branch}"
    echo "  any tRPC type error above may be the types, not your code"
    echo "  rebuild for this tree: $fix"; exit 1
  fi
  if ! git -C "$dir" diff --quiet "$sha" "$head" -- trpc 2>/dev/null; then
    echo "this branch changes trpc/ beyond what the generated types were built for (${sha:0:10})"
    echo "  tRPC shape errors above may be the types, not your code"
    echo "  rebuild for this tree: $fix"; exit 1
  fi
  exit 0
fi

sync=0
[[ "${1:-}" == --sync ]] && { sync=1; shift; }
dir="${1:?usage: seed-gen [--sync] <worktree-dir>}"
# realpath: a /tmp spelling makes tsgo treat the tree's own node_modules as external
# (/private/tmp realpaths) and dts emit fails with TS2883
dir=$(realpath_of "$dir") || exit 0

# source .gen from the MAIN checkout (first worktree), not wherever this runs — a sibling
# worktree has no .gen of its own (gitignored, only routinely built in main).
src=$(git -C "$dir" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}')
[[ -n "$src" && -d "$src/.gen" ]] || exit 0                  # nothing to seed from

if [[ "$(realpath_of "$dir")" != "$(realpath_of "$src")" ]]; then

  if (( sync )); then
    head=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || exit 0
    repair_node_modules "$dir" "$src"
    # a branch whose packages/* source differs from what main's dist was built from cannot
    # typecheck through main's node_modules — give it its own view + its own dist. An already-
    # exploded tree rebuilds unconditionally (no-op-fast) so a revert can't leave dist stale.
    main_head=$(git -C "$src" rev-parse HEAD 2>/dev/null)
    if exploded "$dir" \
       || { [[ -n "$main_head" ]] \
            && ! git -C "$dir" diff --quiet "$main_head" HEAD -- packages ':(exclude)packages/prisma/migrations' 2>/dev/null; }; then
      if ! exploded "$dir"; then
        explode_node_modules "$dir" "$src" && echo "packages source differs from main — gave this tree its own node_modules view"
      fi
      if out=$(build_packages "$dir"); then
        [[ -n "$out" ]] && { echo "tree-local packages dist build:"; echo "$out" | tail -3; }
      else
        echo "tree-local packages dist build FAILED:"; echo "$out" | tail -5
        exit 1
      fi
    fi
    seed_prisma_client "$dir" "$src" || exit 1
    marker="$dir/.gen/.seed-gen-sha"
    # trust the marker only in a private .gen — through a symlink it is MAIN's marker, and a
    # concurrent stamp-through-the-link can make it claim this branch's HEAD (2026-08-03)
    [[ ! -L "$dir/.gen" && -f "$marker" && "$(cat "$marker" 2>/dev/null)" == "$head" ]] && exit 0
    if [[ -L "$dir/.gen" ]]; then
      # main's .gen through a link — keep it only if it already describes this HEAD.
      # The diff must cover everything root.d.ts inlines through, not trpc/ alone: router
      # inputs come from lib/ zod schemas and outputs from models/ + queries/ (a branch
      # adding a lib/types/UserPreferences key kept main's stale link, 2026-08-03).
      sha=$(cat "$dir/.gen/.seed-gen-sha" 2>/dev/null)
      if [[ -n "$sha" ]] && git -C "$dir" merge-base --is-ancestor "$sha" "$head" 2>/dev/null \
         && git -C "$dir" diff --quiet "$sha" "$head" -- trpc lib models queries packages ':(exclude)packages/prisma/migrations' 2>/dev/null; then
        exit 0
      fi
      rm -f "$dir/.gen"
      echo "traded main's .gen link for a private copy (seed does not describe this branch)"
    fi
    if [[ ! -e "$dir/.gen" ]]; then
      cp -cR "$src/.gen" "$dir/.gen" 2>/dev/null || cp -R "$src/.gen" "$dir/.gen" 2>/dev/null || mkdir -p "$dir/.gen"
      rm -f "$marker"                     # the copy was built for main's HEAD, not this one
      rm -rf "$dir/.gen/.rebuilding"      # a lock riding along in the copy is not ours
    fi
    proj=$(trpc_types_project "$dir") || exit 0
    tsc="$dir/node_modules/typescript/bin/tsc"
    [[ -e "$tsc" ]] || { echo "no repo-local tsc — cannot rebuild types here"; exit 0; }
    # declaration emit names .prisma types relative to where node_modules PHYSICALLY lives — through
    # a symlinked node_modules the reference escapes the tree: tsc trips TS2883, and tsgo silently
    # emits `user?: Prisma` (namespace-as-type → every consumer goes unknown/any, 2026-08-04).
    # Real tree-local .prisma/@prisma keep the reference inside; emit with tsc, never tsgo.
    if ! exploded "$dir"; then
      explode_node_modules "$dir" "$src" && echo "exploded node_modules for a tree-local types rebuild"
      if out=$(build_packages "$dir"); then
        [[ -n "$out" ]] && { echo "tree-local packages dist build:"; echo "$out" | tail -3; }
      else
        echo "tree-local packages dist build FAILED:"; echo "$out" | tail -5
        exit 1
      fi
    fi
    for _pkg in .prisma @prisma; do
      [[ -L "$dir/node_modules/$_pkg" ]] || continue
      rm "$dir/node_modules/$_pkg"
      cp -cR "$src/node_modules/$_pkg" "$dir/node_modules/$_pkg" 2>/dev/null \
        || cp -R "$src/node_modules/$_pkg" "$dir/node_modules/$_pkg"
    done
    take_lock "$dir/.gen" || { echo "a types rebuild is already in flight in this tree"; exit 1; }
    if out=$(cd "$dir" && "$HOME/.volta/bin/node" "$tsc" --project "$proj" --pretty false 2>&1); then
      # never stamp through a symlink: the async scratch path can re-link .gen to main's mid-
      # rebuild, and writing then poisons MAIN's marker with this branch's HEAD (2026-08-03)
      [[ ! -L "$dir/.gen" && "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" == "$head" ]] && echo "$head" > "$marker"
      drop_lock "$dir/.gen"
      echo "rebuilt tRPC types for ${head:0:10} in this tree"
    else
      drop_lock "$dir/.gen"
      echo "tRPC types rebuild FAILED:"; echo "$out" | tail -5
      exit 1
    fi
    exit 0
  fi

  scratch=$(realpath_of "${STACK_OPEN_DIR:-/tmp/stack-study}")
  if [[ -n "$scratch" && "$(realpath_of "$dir")" == "$scratch"/* ]]; then
    # Nothing in a scratch tree rebuilds .gen on the async path, so a private copy is 17M of
    # types frozen at whenever it was seeded — including the 47 the pre-2026-07-22 seeders left
    # behind. Trade each one for the live link on its next open, unless a rebuild is holding it.
    # A marker matching HEAD is a --sync-built copy that is MORE accurate than main's seed: keep it.
    if [[ ! -L "$dir/.gen" && -d "$dir/.gen" && ! -d "$dir/.gen/.rebuilding" ]]; then
      if [[ "$(cat "$dir/.gen/.seed-gen-sha" 2>/dev/null)" != "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" ]]; then
        rm -rf "$dir/.gen"
      fi
    fi
    [[ -e "$dir/.gen" ]] || ln -sfn "$src/.gen" "$dir/.gen"
    exit 0
  fi
  if [[ ! -e "$dir/.gen" ]]; then
    cp -cR "$src/.gen" "$dir/.gen" 2>/dev/null \
      || cp -R "$src/.gen" "$dir/.gen" 2>/dev/null || exit 0  # COW clone, fall back to plain copy
  fi
  # A copied marker describes the tree it was copied FROM: left in place it claims this
  # worktree's .gen was built for a commit it has never seen. (A marker matching this tree's
  # HEAD is a --sync-built .gen — that one is real, keep it.)
  if [[ ! -L "$dir/.gen" && "$(cat "$dir/.gen/.seed-gen-sha" 2>/dev/null)" != "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" ]]; then
    rm -f "$dir/.gen/.seed-gen-sha"
  fi
  exit 0
fi

head=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || exit 0
marker="$dir/.gen/.seed-gen-sha"
[[ -f "$marker" && "$(cat "$marker" 2>/dev/null)" == "$head" ]] && exit 0   # already built for this HEAD
# Gate on HEAD alone, never on `git diff main...HEAD -- <inputs>`: that gate is empty when the
# checkout comes back TO main, so .gen kept whatever shape the last feature branch left it —
# which is how the seed every other worktree copies got poisoned.

proj=$(trpc_types_project "$dir") || exit 0

tsc="$dir/node_modules/typescript/bin/tsc"
ts_major=$(sed -n 's/.*"version": *"\([0-9]*\)\..*/\1/p' "$dir/node_modules/typescript/package.json" 2>/dev/null | head -1)
tsgo="$dir/node_modules/.bin/tsgo"
[[ -x "$tsgo" ]] || tsgo=$(command -v tsgo 2>/dev/null) || tsgo=""
[[ -n "$tsgo" || -e "$tsc" ]] || exit 0                      # no compiler → keep what's there
if ! take_lock "$dir/.gen"; then
  (( sync )) && { echo "a types rebuild is already in flight in the main checkout"; exit 1; }
  exit 0
fi

if [[ -e "$tsc" && "${ts_major:-0}" -ge 7 ]]; then
  build=("$HOME/.volta/bin/node" "$tsc")     # TS7 tsc IS the native compiler
elif [[ -n "$tsgo" ]]; then
  build=("$tsgo")                            # pre-TS7 tsc: TS2883 partial emit (header)
else
  build=("$HOME/.volta/bin/node" "$tsc")
fi

build_main(){
  cd "$dir"
  # packages/*/dist (gitignored, built locally) feeds @loops/* resolution in BOTH the .gen emit
  # and the app typecheck, and `tsc -b` is a no-op when nothing changed. Build with tsc (not
  # tsgo) to match the canonical `task build:packages`, so the shared dist/*.tsbuildinfo never
  # thrashes between two compilers.
  if [[ -e "$tsc" ]]; then
    "$HOME/.volta/bin/node" "$tsc" -b \
      packages/settings/tsconfig.json packages/valkey/tsconfig.json packages/mail-pg/tsconfig.json \
      packages/realtime-client/tsconfig.json packages/prisma/tsconfig.json --pretty false >/dev/null 2>&1
  fi
  # A HEAD that moved during the build would make this stamp claim a shape .gen doesn't have.
  "${build[@]}" --project "$proj" --pretty false >/dev/null 2>&1 \
    && [[ "$(git rev-parse HEAD 2>/dev/null)" == "$head" ]] && echo "$head" > "$marker"
  drop_lock "$dir/.gen"
}

if (( sync )); then
  build_main
  if [[ "$(cat "$marker" 2>/dev/null)" == "$head" ]]; then
    echo "rebuilt main checkout types (+packages dist) for ${head:0:10}"
  else
    echo "main checkout types rebuild FAILED (or HEAD moved during the build)"; exit 1
  fi
else
  # The subshell drops the inherited stdout/stderr too, not just the compiler's: a caller that
  # pipes us waits for EOF on those fds, so holding them open makes this "background" rebuild
  # block that caller for as long as the compile takes. Call the binary DIRECTLY (never npx —
  # backgrounded npx with no TTY hangs on its install prompt and piles up runaway procs).
  ( build_main ) >/dev/null 2>&1 &
fi
