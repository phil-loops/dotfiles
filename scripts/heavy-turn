#!/usr/bin/env python3
"""heavy-turn — the machine-wide admission queue for heavy work.

One budget of slots (default 2) shared by everything that pegs the machine: typechecks,
gates steps, node_modules clones, preview setup. Extra callers wait their turn instead of
stacking — every slow-viewer episode on the 16GB box lined up with two or three of these
running at once on top of a full swap.

  heavy-turn [--class <name>] [--batch] [--key <k>] [--unless <probe>] -- <cmd...>
                                                     run <cmd> once a slot is free
  heavy-turn --acquire [--class <name>] [--batch] --owner <pid>
                                                     block until a slot is free, hold it
                                                     for <pid>, print the ticket id
  heavy-turn --release <ticket>                      give a held slot back
  heavy-turn --status [--json]                       who holds, who waits
  heavy-turn --audit [YYYY-MM-DD]                    a day's journal against the two rules below

Two rules, enforced here and not left to callers:

  A slot is for work that will change something. --unless <probe> is a shell command that exits 0
  when the work is already done; it runs before queueing and again at the grant (someone else may
  have done the work while this waited), and a satisfied probe ends the request without <cmd>
  running (journal status `unneeded`). --key <k> names the work: a request whose key matches one
  still waiting is the same work asked for twice and ends at once (`folded`); it is for callers
  that do not wait for the result. Before these, callers that fired per event or per timer put
  572 seed-gen and 327 review-warm tickets in one day's queue, most of them no-ops (2026-11-12).

  A slot is for bounded work. A holder past HEAVY_TURN_MAX_HOLD awake seconds (1800) has overstayed:
  it keeps running and keeps its class cap, but stops counting against the budget, since the
  queue cannot schedule around a job with no end (2026-11-12: a six-hour eval held half of it).
  The memory floor still answers for what such a job costs the machine.

Order: interactive callers (the default) before --batch ones, then first come first served.
A batch caller never takes a slot while an interactive one is waiting. A class may carry its
own cap (HEAVY_TURN_CAP_<CLASS>=n, defaults below) so one kind of work can't take the whole
budget. A holder whose pid is gone is reaped on the next look, so a killed caller can't
wedge the queue. A command run under a held slot exports HEAVY_TURN_HELD, and a nested
heavy-turn inside it runs straight through — the outer slot already counts it.

The budget shrinks to one slot while the box is under memory pressure (the kernel's
kern.memorystatus_level, the number `memory_pressure` prints, below HEAVY_TURN_MEM_FLOOR,
default 30%). The slots exist to keep heavy work out of swap, and two queued 5GB typechecks
beside an unqueued 4.6GB job still drove it there (2026-10-19: an 18-minute tsc, load 300).
Running work is never preempted; only admission waits, and one slot always stays open so an
unqueued hog can't starve the queue forever.

Every finished ticket appends a line to HEAVY_TURN_JOURNAL (~/.cache/heavy-turn/journal.tsv):
granted, class, pid, wait s, run s (awake seconds: sleep is not counted), exit, mem %, cwd, cmd — so "who ran that, and how long did
it take" outlives the process.

Env: HEAVY_TURN_SLOTS (2), HEAVY_TURN_DIR (/tmp/heavy-turn), HEAVY_TURN_MEM_FLOOR (30),
HEAVY_TURN_MAX_HOLD (1800),
HEAVY_TURN_JOURNAL, HEAVY_TURN_MEM_LEVEL (forces the measured level; tests).
"""
import fcntl
import json
import os
import signal
import subprocess
import sys
import time
import uuid
from contextlib import contextmanager
from pathlib import Path

ROOT = Path(os.environ.get("HEAVY_TURN_DIR", "/tmp/heavy-turn"))
SLOTS = int(os.environ.get("HEAVY_TURN_SLOTS", "2"))
MEM_FLOOR = int(os.environ.get("HEAVY_TURN_MEM_FLOOR", "30"))
MAX_HOLD = float(os.environ.get("HEAVY_TURN_MAX_HOLD", "1800"))
JOURNAL = Path(os.environ.get("HEAVY_TURN_JOURNAL",
                              os.path.expanduser("~/.cache/heavy-turn/journal.tsv")))
CLASS_CAPS = {"gates": 1, "clone": 1, "preview": 1, "review-warm": 1}
POLL = 0.5


def mem_level():
    """Free-memory percentage per the kernel's memorystatus; None when it can't be read."""
    forced = os.environ.get("HEAVY_TURN_MEM_LEVEL")
    if forced:
        return int(forced)
    try:
        out = subprocess.run(["sysctl", "-n", "kern.memorystatus_level"],
                             capture_output=True, text=True, timeout=2)
        return int(out.stdout.strip())
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def budget(level):
    return 1 if level is not None and level < MEM_FLOOR else SLOTS


def pressure_note(level):
    return f", memory {level}% < {MEM_FLOOR}%: budget 1" if budget(level) < SLOTS else ""


def journal(t, status):
    now = time.time()
    granted = t.get("granted")
    # wait and run count awake seconds: a laptop that slept mid-run journaled a 3s job as 931s
    up, up0, up1 = time.monotonic(), t.get("created_up"), t.get("granted_up")
    if up0 is None or up0 > up:        # a ticket from before the awake stamps, or from before a reboot
        up, up0, up1 = now, t["created"] / 1e9, granted
    row = [time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(granted or now)),
           t["cls"] + (" batch" if t["batch"] else ""), str(t["pid"]),
           f"{(up1 or up) - up0:.0f}", f"{up - up1:.0f}" if up1 else "0",
           str(status), str(t.get("mem", "")), t.get("cwd", ""), " ".join(t.get("cmd") or [])]
    try:
        JOURNAL.parent.mkdir(parents=True, exist_ok=True)
        with JOURNAL.open("a") as f:
            f.write("\t".join(row) + "\n")
    except OSError:
        pass


def cap_of(cls):
    env = os.environ.get(f"HEAVY_TURN_CAP_{cls.upper().replace('-', '_')}")
    if env:
        return int(env)
    return CLASS_CAPS.get(cls, SLOTS)


_lock_depth = 0


@contextmanager
def locked():
    """The queue lock, reentrant within a process. A SIGTERM/SIGHUP lands while the main thread may
    be inside, and the handler's drop() locks again: a second open+flock is a different holder to
    the kernel, so it waits on itself and every heavy-turn on the machine waits behind it
    (2026-11-12: a seed-gen waiter signalled mid-claim held the queue for 40 minutes)."""
    global _lock_depth
    if _lock_depth:
        _lock_depth += 1
        try:
            yield
        finally:
            _lock_depth -= 1
        return
    ROOT.mkdir(parents=True, exist_ok=True)
    with (ROOT / "lock").open("a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        _lock_depth = 1
        try:
            yield
        finally:
            _lock_depth = 0


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except (OSError, ValueError, TypeError):
        return False


def tickets():
    """Every live ticket; dead owners' tickets are deleted on sight (caller holds the lock)."""
    out = []
    for p in ROOT.glob("*.json"):
        try:
            t = json.loads(p.read_text())
        except (OSError, ValueError):
            continue
        if not alive(t.get("pid")):
            journal(t, "reaped")
            p.unlink(missing_ok=True)
            continue
        t["_path"] = p
        out.append(t)
    return out


def save(t):
    p = ROOT / f"{t['id']}.json"
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps({k: v for k, v in t.items() if k != "_path"}))
    os.replace(tmp, p)


def overstayed(t):
    up = t.get("granted_up")
    return t["state"] == "running" and up is not None and 0 <= time.monotonic() - up > MAX_HOLD


def order(t):
    return (1 if t["batch"] else 0, t["created"])


def try_claim(me):
    """Under the lock: grant <me> a slot if the budget, its class cap, and the queue order allow."""
    live = tickets()
    running = [t for t in live if t["state"] == "running"]
    level = mem_level()
    slots = budget(level)
    counted = sum(1 for t in running if not overstayed(t))
    if counted >= slots:
        return False
    per_class = {}
    for t in running:
        per_class[t["cls"]] = per_class.get(t["cls"], 0) + 1
    waiting = sorted((t for t in live if t["state"] == "waiting"), key=order)
    interactive_waiting = any(not t["batch"] and per_class.get(t["cls"], 0) < cap_of(t["cls"])
                              for t in waiting)
    free = slots - counted
    # Walk the queue in order, handing out the free slots; a waiter whose class is at its cap
    # is skipped rather than blocking everyone behind it.
    for t in waiting:
        if free <= 0:
            return False
        if t["batch"] and interactive_waiting:
            return False
        if per_class.get(t["cls"], 0) >= cap_of(t["cls"]):
            continue
        if t["id"] == me["id"]:
            me["state"] = "running"
            me["granted"] = time.time()
            me["granted_up"] = time.monotonic()
            me["mem"] = level
            save(me)
            return True
        per_class[t["cls"]] = per_class.get(t["cls"], 0) + 1
        free -= 1
    return False


def describe(t, now):
    since = now - t.get("granted", t["created"] / 1e9)
    cmd = " ".join(t.get("cmd") or [])[:90]
    late = " OVERSTAYED, not counted" if overstayed(t) else ""
    return f"{t['cls']}{' (batch)' if t['batch'] else ''} pid {t['pid']} {int(since)}s{late}  {cmd}"


def why_waiting(me):
    with locked():
        live = tickets()
    now = time.time()
    level = mem_level()
    held = [t for t in live if t["state"] == "running"]
    ahead = [t for t in live if t["state"] == "waiting" and order(t) < order(me)]
    lines = [f"heavy-turn: waiting for a slot ({sum(1 for t in held if not overstayed(t))}/{budget(level)} held"
             + (f", {len(ahead)} ahead" if ahead else "") + pressure_note(level) + ")"]
    lines += [f"  held: {describe(t, now)}" for t in held]
    return "\n".join(lines)


def ticket(cls, batch, pid, cmd, key=None):
    t = {"id": uuid.uuid4().hex[:12], "pid": pid, "cls": cls, "batch": batch,
         "created": time.time_ns(), "created_up": time.monotonic(), "state": "waiting", "cmd": cmd, "cwd": os.getcwd()}
    if key:
        t["key"] = key
    return t


def enqueue(cls, batch, pid, cmd, key=None):
    """The new waiting ticket, or None when one with the same key is already waiting."""
    t = ticket(cls, batch, pid, cmd, key)
    with locked():
        if key and any(o["state"] == "waiting" and o.get("key") == key for o in tickets()):
            journal(t, "folded")
            return None
        save(t)
    return t


def done_already(probe):
    return bool(probe) and subprocess.call(probe, shell=True, stdin=subprocess.DEVNULL,
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0


def drop(tid):
    with locked():
        (ROOT / f"{tid}.json").unlink(missing_ok=True)


def wait_for_slot(t, quiet=False):
    t0 = time.monotonic()
    said = -1.0
    while True:
        with locked():
            if try_claim(t):
                break
        el = time.monotonic() - t0
        if not quiet and (said < 0 or el - said >= 30):
            print(why_waiting(t), file=sys.stderr, flush=True)
            said = el
        time.sleep(POLL)
    el = time.monotonic() - t0
    if not quiet and said >= 0:
        print(f"heavy-turn: slot free after {int(el)}s — running", file=sys.stderr, flush=True)


def run(cls, batch, cmd, key=None, unless=None):
    if os.environ.get("HEAVY_TURN_HELD"):
        return subprocess.call(cmd)
    if done_already(unless):
        journal(ticket(cls, batch, os.getpid(), cmd, key), "unneeded")
        return 0
    t = enqueue(cls, batch, os.getpid(), cmd, key)
    if t is None:
        return 0
    child = None
    rc = "signal"

    def stop(signum, _frame):
        if child is not None and child.poll() is None:
            child.send_signal(signum)
        else:
            journal(t, 128 + signum)
            drop(t["id"])
            sys.exit(128 + signum)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    try:
        wait_for_slot(t)
        if done_already(unless):
            rc = "unneeded"
            return 0
        env = dict(os.environ, HEAVY_TURN_HELD=t["id"])
        child = subprocess.Popen(cmd, env=env)
        while True:
            try:
                rc = child.wait()
                return rc
            except KeyboardInterrupt:
                continue   # the child got the same ^C; wait for it to exit
    except KeyboardInterrupt:
        rc = 130
        return rc
    finally:
        journal(t, rc)
        drop(t["id"])


def acquire(cls, batch, owner):
    if os.environ.get("HEAVY_TURN_HELD"):
        print("nested")
        return 0
    t = enqueue(cls, batch, owner, [f"(held by pid {owner})"])
    try:
        wait_for_slot(t)
    except KeyboardInterrupt:
        drop(t["id"])
        return 130
    print(t["id"])
    return 0


def release(tid):
    if tid and tid != "nested":
        try:
            journal(json.loads((ROOT / f"{tid}.json").read_text()), "released")
        except (OSError, ValueError):
            pass
        drop(tid)
    return 0


def status(as_json):
    with locked():
        live = tickets()
    now = time.time()
    level = mem_level()
    held = sorted((t for t in live if t["state"] == "running"), key=order)
    waiting = sorted((t for t in live if t["state"] == "waiting"), key=order)
    if as_json:
        strip = lambda t: {k: v for k, v in t.items() if k != "_path"}
        print(json.dumps({"slots": budget(level), "configured": SLOTS, "mem": level,
                          "held": [strip(t) for t in held],
                          "waiting": [strip(t) for t in waiting]}))
        return 0
    print(f"heavy-turn: {sum(1 for t in held if not overstayed(t))}/{budget(level)} slots held, {len(waiting)} waiting"
          + pressure_note(level))
    for t in held:
        print(f"  held     {describe(t, now)}")
    for t in waiting:
        print(f"  waiting  {describe(t, now)}")
    return 0


def audit(day):
    """A day's journal against the two rules. Exit 1 when a class breaks one.
    "Quick" is the evidence available for a no-op: admitted, exit 0, done within 2 awake seconds."""
    day = day or time.strftime("%Y-%m-%d")
    rows = {}
    try:
        lines = JOURNAL.read_text().splitlines()
    except OSError:
        lines = []
    for line in lines:
        f = line.split("\t")
        if len(f) < 9 or not f[0].startswith(day):
            continue
        r = rows.setdefault(f[1], {"n": 0, "folded": 0, "unneeded": 0, "admitted": 0, "quick": 0,
                                   "over": 0, "waited": 0})
        r["n"] += 1
        if f[5] in ("folded", "unneeded"):
            r[f[5]] += 1
            continue
        try:
            wait, ran = float(f[3]), float(f[4])
        except ValueError:
            continue
        r["waited"] += wait
        if f[5] in ("reaped", "signal") or ran == 0 and f[5] not in ("0", "released"):
            continue                    # never admitted: died waiting
        r["admitted"] += 1
        r["quick"] += f[5] == "0" and ran <= 2
        r["over"] += ran > MAX_HOLD
    print(f"heavy-turn audit {day}")
    print(f"  {'class':<22}{'asked':>6}{'folded':>8}{'unneeded':>9}{'admitted':>9}{'quick':>7}{'overstay':>9}{'waited s':>10}")
    broken = []
    for cls, r in sorted(rows.items(), key=lambda kv: -kv[1]["n"]):
        print(f"  {cls:<22}{r['n']:>6}{r['folded']:>8}{r['unneeded']:>9}{r['admitted']:>9}{r['quick']:>7}{r['over']:>9}{r['waited']:>10.0f}")
        if r["admitted"] >= 10 and r["quick"] * 2 > r["admitted"]:
            broken.append(f"{cls}: {r['quick']} of {r['admitted']} admitted runs finished within 2s — "
                          "it asks for slots it does not need (give it --unless)")
        if r["over"]:
            broken.append(f"{cls}: {r['over']} run(s) held a slot past {MAX_HOLD:.0f}s — unbounded work, keep it out of the queue")
    for b in broken:
        print(f"  ✗ {b}")
    if not rows:
        print("  no tickets")
    return 1 if broken else 0


def main(argv):
    cls, batch, owner, mode, arg, as_json = "default", False, None, "run", None, False
    key = unless = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            i += 1
            break
        if a == "--class":
            cls = argv[i + 1]; i += 2
        elif a == "--batch":
            batch = True; i += 1
        elif a == "--key":
            key = argv[i + 1]; i += 2
        elif a == "--unless":
            unless = argv[i + 1]; i += 2
        elif a == "--audit":
            mode = "audit"
            arg = argv[i + 1] if i + 1 < len(argv) and not argv[i + 1].startswith("-") else None
            i += 2 if arg else 1
        elif a == "--owner":
            owner = int(argv[i + 1]); i += 2
        elif a == "--acquire":
            mode = "acquire"; i += 1
        elif a == "--release":
            mode, arg = "release", argv[i + 1]; i += 2
        elif a == "--status":
            mode = "status"; i += 1
        elif a == "--json":
            as_json = True; i += 1
        elif a in ("-h", "--help"):
            print(__doc__)
            return 0
        elif a.startswith("-"):
            print(f"heavy-turn: unknown flag {a}", file=sys.stderr)
            return 2
        else:
            break
    cmd = argv[i:]
    if mode == "status":
        return status(as_json)
    if mode == "audit":
        return audit(arg)
    if mode == "release":
        return release(arg)
    if mode == "acquire":
        if owner is None:
            print("heavy-turn: --acquire needs --owner <pid>", file=sys.stderr)
            return 2
        return acquire(cls, batch, owner)
    if not cmd:
        print("heavy-turn: no command (heavy-turn [--class c] [--batch] -- <cmd...>)", file=sys.stderr)
        return 2
    return run(cls, batch, cmd, key, unless)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
