#!/bin/zsh
# stack-review-html [<branch>] — STATIC snapshot of a stack review (file://).
#
# Bakes the model in at generation time — good for sharing/archiving a review,
# but the embedded statuses + diffs are frozen (a photograph; it can't know it
# has gone stale). For the LIVE, blessing-aware view use the server:
#   loops stack review --html        (→ stack-review-serve)
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

branch="${1:-$(git branch --show-current 2>/dev/null)}"
[[ -n "$branch" ]] || { echo "stack-review-html: no branch" >&2; exit 1; }
here="${0:A:h}"

out="/tmp/stack-review-$(echo "$branch" | tr '/' '-').html"
modelf="$(mktemp)"
"$here/stack-forest" "$branch" > "$modelf"
python3 "$here/stack-review-html.tpl.py" "$modelf" "$out"
rm -f "$modelf"
echo "→ $out"
[[ "${NO_OPEN:-}" == 1 ]] || open "$out"
