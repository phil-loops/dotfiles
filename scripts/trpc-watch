#!/bin/bash
# Keep .gen/trpc-types fresh in a loops worktree.
#
# Without a watcher, .gen goes stale the moment you touch a router, and the LSP
# then lies to you: a new procedure reports "does not exist" (loud), and a
# renamed output field keeps typechecking GREEN while the code is broken
# (silent — the bad one). `task dev` runs a watcher; a bare worktree does not.
#
#   trpc-watch          start (or adopt) a watcher for this worktree
#   trpc-watch --status list every worktree currently being watched
#   trpc-watch --stop   stop this worktree's watcher
set -euo pipefail

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "trpc-watch: not in a git repo" >&2; exit 1
}
[[ -f "$root/tsconfig.trpc-types.json" ]] || {
  echo "trpc-watch: no tsconfig.trpc-types.json in $root" >&2; exit 1
}

log="${TMPDIR:-/tmp}/trpc-watch-$(echo "$root" | md5 -q 2>/dev/null || echo "$root" | md5sum | cut -d' ' -f1).log"
running_pid() { pgrep -f "trpc-types.json --watch" 2>/dev/null | while read -r p; do
  [[ "$(lsof -p "$p" -a -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')" == "$root" ]] && echo "$p"
done; }

case "${1:-}" in
  --status)
    pgrep -fl "trpc-types.json --watch" 2>/dev/null || echo "  (no watchers running)"
    exit 0 ;;
  --stop)
    pid=$(running_pid | head -1)
    [[ -n "$pid" ]] && { kill "$pid"; echo "stopped watcher for $root"; } || echo "no watcher for $root"
    exit 0 ;;
esac

if [[ -n "$(running_pid | head -1)" ]]; then
  echo "already watching $root  (log: $log)"; exit 0
fi

# tsgo where it's available (incremental rebuilds are ~instant); else tsc.
tsc="$root/node_modules/.bin/tsgo"
[[ -x "$tsc" ]] || tsc="$root/node_modules/.bin/tsc"
[[ -x "$tsc" ]] || { echo "trpc-watch: no compiler in $root/node_modules/.bin" >&2; exit 1; }

nohup "$tsc" -p "$root/tsconfig.trpc-types.json" --watch --preserveWatchOutput --pretty false \
  >"$log" 2>&1 &
echo "watching $root with $(basename "$tsc")  (pid $!, log: $log)"
echo "  .gen now rebuilds whenever you touch a router — your editor stops lying"
