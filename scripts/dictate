#!/bin/zsh
# dictate — the menu-bar dictation app: 🌐 twice (or Ctrl-a v in tmux) records, 🌐 twice again drops the words as a draft
# into the Claude session of your last tmux pane. Source in scripts/dictate-app; builds in ~/.cache/dictate, and the app
# lives in /Applications so Spotlight finds it.
#   dictate             build if the source changed, then start the app; a running Dictate is never killed, it moves onto
#                       the new build by itself once it isn't recording or transcribing
#   dictate --build     build only
#   dictate --selftest  check the pure pieces (taps, targeting, preview) without a mic or keyboard
set -euo pipefail
here="${0:A:h}/dictate-app"
cache="$HOME/.cache/dictate"
app="/Applications/Dictate.app"
stamp="$cache/source.sha"

build() {
  local sha
  sha="$(cd "$here" && find Package.swift Sources -type f -print0 | sort -z | xargs -0 shasum -a 256 | shasum -a 256 | cut -d' ' -f1)"
  [[ -x "$app/Contents/MacOS/Dictate" && "$(cat "$stamp" 2>/dev/null)" == "$sha" ]] && return
  echo "dictate: building…" >&2
  swift build -c release --package-path "$here" --scratch-path "$cache/build" --product Dictate >&2
  swift build -c release --package-path "$here" --scratch-path "$cache/build" --product DictateInput >&2
  mkdir -p "$app/Contents/MacOS"
  cp "$(swift build -c release --package-path "$here" --scratch-path "$cache/build" --show-bin-path)/Dictate" "$app/Contents/MacOS/Dictate.new"
  mv -f "$app/Contents/MacOS/Dictate.new" "$app/Contents/MacOS/Dictate"
  cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>Dictate</string>
  <key>CFBundleIdentifier</key><string>com.philbrockman.dictate</string>
  <key>CFBundleName</key><string>Dictate</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSUIElement</key><true/>
  <key>NSMicrophoneUsageDescription</key><string>Dictate into a tmux pane while you work in any window.</string>
  <key>CFBundleURLTypes</key>
  <array><dict>
    <key>CFBundleURLName</key><string>com.philbrockman.dictate</string>
    <key>CFBundleURLSchemes</key><array><string>dictate</string></array>
  </dict></array>
</dict>
</plist>
PLIST
  # a fixed local identity, so macOS keeps Dictate's Microphone and Input Monitoring grants across rebuilds (ad hoc changes
  # identity every build); falls back to ad hoc on a machine without it
  codesign --force --sign "Dictate Local Signing" --identifier com.philbrockman.dictate "$app" >&2 2>/dev/null \
    || codesign --force --sign - --identifier com.philbrockman.dictate "$app" >&2
  install_input
  echo "$sha" > "$stamp"
  # written last, once the new build is whole and signed: the running Dictate watches it to know when to move over
  echo "$sha" > "$cache/installed"
}

# Dictate Input, the input source Dictate inserts words through, in ~/Library/Input Methods where macOS looks for them.
# The first install selects it as the input source (keys still type with your keyboard layout); after that, a rebuild
# swaps the binary and stops the old process by its exact path, and macOS starts the new one when a text field next asks.
input="$HOME/Library/Input Methods/Dictate Input.app"
install_input() {
  mkdir -p "$input/Contents/MacOS" "$input/Contents/Resources"
  cp "$(swift build -c release --package-path "$here" --scratch-path "$cache/build" --show-bin-path)/DictateInput" "$input/Contents/MacOS/DictateInput.new"
  mv -f "$input/Contents/MacOS/DictateInput.new" "$input/Contents/MacOS/DictateInput"
  "$input/Contents/MacOS/DictateInput" --render-icon "$input/Contents/Resources/mic.tiff"
  cat > "$input/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>DictateInput</string>
  <key>CFBundleIdentifier</key><string>com.philbrockman.inputmethod.Dictate</string>
  <key>CFBundleName</key><string>Dictate</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSBackgroundOnly</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>InputMethodConnectionName</key><string>com.philbrockman.inputmethod.Dictate_Connection</string>
  <key>InputMethodServerControllerClass</key><string>DictateInputController</string>
  <key>TISInputSourceID</key><string>com.philbrockman.inputmethod.Dictate</string>
  <key>TISIntendedLanguage</key><string>en</string>
  <key>tsInputMethodCharacterRepertoireKey</key><array><string>Latn</string></array>
  <key>tsInputMethodIconFileKey</key><string>mic.tiff</string>
</dict>
</plist>
PLIST
  codesign --force --sign "Dictate Local Signing" --identifier com.philbrockman.inputmethod.Dictate "$input" >&2 2>/dev/null \
    || codesign --force --sign - --identifier com.philbrockman.inputmethod.Dictate "$input" >&2
  local running
  running="$(pgrep -fx "$input/Contents/MacOS/DictateInput" || true)"
  [[ -n "$running" ]] && kill $running
  if [[ ! -e "$cache/input-installed" ]]; then
    "$input/Contents/MacOS/DictateInput" --install "$input" && touch "$cache/input-installed"
  fi
}

case "${1:-}" in
  --build) build ;;
  --selftest) build; "$app/Contents/MacOS/Dictate" --selftest ;;
  "")
    build
    open -g "$app" ;;
  *) echo "usage: dictate [--build | --selftest]" >&2; exit 2 ;;
esac
