#!/usr/bin/env python3
"""stack-prepush-guard — refuse to push throwaway/checkpoint commits.

Install as a repo's `pre-push` hook (see stack-install-prepush-hook). git feeds the
hook one line per ref being pushed on stdin:

    <local ref> <local sha> <remote ref> <remote sha>

For each pushed ref we scan the commits that would actually land on the remote and
abort the whole push if any is a work-in-progress commit — one carrying an `X-WIP`
trailer (how Claude/`stack-wip` stamp checkpoints), or a bare `wip`/`fixup!`/`squash!`
subject. The squash-before-push flow consumes these in the happy path; this hook is
the net for a push that skips the flow (e.g. straight from the laptop).

It also blocks **merge commits on a feature branch** — one means a `git pull`
(merge) on a diverged branch, which (because PRs squash-merge) drags landed
commits back in and bloats the PR with phantom "new" commits. Rebase onto
origin/main instead.

Escape hatches (per guard, one push): `ALLOW_WIP_PUSH=1` / `ALLOW_MERGE_PUSH=1`.
For pushes from GUI clients that can't set env vars (GH Desktop), a one-shot
per-branch flag does the same for the merge guard and is consumed on use:
`git config stack-branch.<branch>.allow-merge-push true`.

Exit 0 = clean (allow push). Exit 1 = blocked.
"""
import os
import re
import subprocess
import sys

ZERO = "0" * 40
TRAILER_RE = re.compile(r"^X-WIP:\s*(.+?)\s*$", re.IGNORECASE | re.MULTILINE)
FALSEY = {"", "0", "false", "no", "off"}
SUBJECT_RE = re.compile(r"^(wip\b|fixup!|squash!|amend!)", re.IGNORECASE)


def range_for(local_sha, remote_sha):
    """The commits this ref would add to the remote, as git-rev-list args."""
    if remote_sha == ZERO or not remote_sha:
        # new branch on the remote: everything on it that no remote already has
        return [local_sha, "--not", "--remotes"]
    return [f"{remote_sha}..{local_sha}"]


def wip_commits(rev_args):
    """[(sha, subject, reason)] for WIP commits in the range, newest first."""
    sep = "\x1e"     # record sep between commits
    usep = "\x1f"    # unit sep: sha / subject / full-body
    fmt = f"%H{usep}%s{usep}%B{sep}"
    out = subprocess.run(
        ["git", "log", f"--format={fmt}", *rev_args],
        capture_output=True, text=True,
    ).stdout
    found = []
    for rec in out.split(sep):
        rec = rec.strip("\n")
        if not rec:
            continue
        parts = rec.split(usep)
        if len(parts) < 3:
            continue
        sha, subject, body = parts[0], parts[1], parts[2]
        m = TRAILER_RE.search(body)
        if m and m.group(1).strip().lower() not in FALSEY:
            found.append((sha[:9], subject, f"X-WIP: {m.group(1).strip()}"))
        elif SUBJECT_RE.match(subject.strip()):
            found.append((sha[:9], subject, "wip-style subject"))
    return found


def merge_commits(rev_args):
    """[(sha, subject)] for merge commits in the range, newest first."""
    out = subprocess.run(
        ["git", "log", "--merges", "--format=%H\x1f%s", *rev_args],
        capture_output=True, text=True,
    ).stdout
    found = []
    for line in out.splitlines():
        if "\x1f" not in line:
            continue
        sha, subject = line.split("\x1f", 1)
        found.append((sha[:9], subject))
    return found


def branch_merge_pass(remote_ref):
    """One-shot per-branch merge-push pass, consumed on use (for GUI pushes)."""
    branch = remote_ref.removeprefix("refs/heads/")
    key = f"stack-branch.{branch}.allow-merge-push"
    val = subprocess.run(
        ["git", "config", "--get", key], capture_output=True, text=True,
    ).stdout.strip().lower()
    if val in FALSEY:
        return False
    subprocess.run(["git", "config", "--unset", key], capture_output=True)
    print(f"⚑ merge-push pass for {branch} — used and cleared ({key})", file=sys.stderr)
    return True


def main():
    refs = []
    for line in sys.stdin:
        cols = line.split()
        if len(cols) < 4:
            continue
        _local_ref, local_sha, remote_ref, remote_sha = cols[:4]
        if local_sha == ZERO:   # deleting a ref — nothing to scan
            continue
        refs.append((local_sha, remote_ref, remote_sha))

    if os.environ.get("ALLOW_MERGE_PUSH", "").strip().lower() in FALSEY:
        merges = []
        for local_sha, remote_ref, remote_sha in refs:
            if remote_ref.endswith("/main"):
                continue
            if branch_merge_pass(remote_ref):
                continue
            merges += merge_commits(range_for(local_sha, remote_sha))
        if merges:
            seen = set()
            print("\n✋ push blocked — merge commit(s) on a feature branch:\n", file=sys.stderr)
            for sha, subject in merges:
                if sha in seen:
                    continue
                seen.add(sha)
                print(f"   {sha}  {subject}", file=sys.stderr)
            print(
                "\nA `git pull` (merge) drags squash-merged commits back in. Rebase instead:\n"
                "   git rebase origin/main\n"
                "or, to override this one push: ALLOW_MERGE_PUSH=1 git push …\n",
                file=sys.stderr,
            )
            return 1

    if os.environ.get("ALLOW_WIP_PUSH", "").strip().lower() in FALSEY:
        offenders = []
        for local_sha, _remote_ref, remote_sha in refs:
            offenders += wip_commits(range_for(local_sha, remote_sha))
        if offenders:
            seen = set()
            print("\n✋ push blocked — work-in-progress commit(s) in this push:\n", file=sys.stderr)
            for sha, subject, reason in offenders:
                if sha in seen:
                    continue
                seen.add(sha)
                print(f"   {sha}  {subject}   ({reason})", file=sys.stderr)
            print(
                "\nSquash them away first (the viewer's 'prepare to push' / `stack-squash --unpushed`),\n"
                "or, to override this one push: ALLOW_WIP_PUSH=1 git push …\n",
                file=sys.stderr,
            )
            return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
