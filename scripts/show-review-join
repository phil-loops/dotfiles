#!/usr/bin/env python3
"""show-review-join <review folder> — turn a spoken review into notes filed under what was on screen when each was said.

Show writes the folder when a review starts (review.json: scope, repo, every in-scope branch's tip) and appends to
trail.jsonl each time canopy's place changes (uptime-clock ns, the address, the branch and the commit on screen).
Dictate adds recording.json (when the audio began, same clock) and utterances.json (each stretch between pauses, timed
from the audio's start). Each utterance goes to the place it overlapped most; each branch's commit is compared with
the branch's tip now, so a note about code that has since moved says so. Writes notes.md and notes.json (each note
numbered n1, n2, … so a session can answer it by id), hands them to the session that owns the forest
(`stack-project.<forest>.owner`) to act on, posts them to Show's Inbox saying whether that worked, and copies them to
the clipboard. --quiet writes the files only.
"""
import json
import os
import subprocess
import sys
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlsplit

SCRIPTS = Path(__file__).resolve().parent
NS = 1_000_000_000


def place(address):
    """What an address names: the branch (None on a forest's own page), the file and line, if any."""
    parts = urlsplit(address)
    segments = [unquote(s) for s in parts.path.split("/") if s]
    query = {k: v[0] for k, v in parse_qs(parts.query).items()}
    name = "/".join(segments[3:]) if len(segments) >= 4 else None
    branch = name if segments[:2] == ["v2", "b"] else None
    forest = name if segments[:2] == ["v2", "p"] else None
    file, line = query.get("file"), query.get("line")
    at = query.get("at", "")
    if not file and at[:2] in ("l|", "g|"):
        file = at.split("|")[1]
    return {"branch": branch, "forest": forest, "file": file, "line": int(line) if line and line.isdigit() else None}


def assign(trail, start_ns, utterances):
    """Each utterance with the trail entry it overlapped most (the first entry when it came before them all)."""
    trail = sorted(trail, key=lambda e: e["uptimeNs"])
    out = []
    for u in utterances:
        lo, hi = start_ns + int(u["start"] * NS), start_ns + int(u["end"] * NS)
        best, most = trail[0] if trail else None, -1
        for i, entry in enumerate(trail):
            begin = entry["uptimeNs"]
            end = trail[i + 1]["uptimeNs"] if i + 1 < len(trail) else hi
            overlap = min(hi, end) - max(lo, begin)
            if overlap > most:
                best, most = entry, overlap
        out.append((u, best))
    return out


def tip(repo_path, branch):
    result = subprocess.run(["git", "-C", repo_path, "rev-parse", "--verify", "-q", f"refs/heads/{branch}"],
                            capture_output=True, text=True)
    return result.stdout.strip() or None


def render(review, trail, pairs, tips_now):
    """The notes as markdown, and as records: forest-wide notes first, then each branch in the order it was first talked
    about; utterances in a row at one file and line make one note."""
    repo = review.get("repo", "loops")
    sections, order = {}, []
    for u, entry in pairs:
        where = place(entry["address"]) if entry else {"branch": None, "forest": None, "file": None, "line": None}
        key = where["branch"]
        if key not in sections:
            sections[key] = []
            order.append(key)
        sections[key].append((u, where, entry))
    if None in order:
        order.remove(None)
        order.insert(0, None)
    started = review.get("tips", {})
    lines, notes = [], []
    for key in order:
        if key is None:
            lines.append("## The whole review" if review.get("scope", "").startswith("/v2/p/") else "## Not on a branch")
        else:
            lines.append(f"## [{key}](canopy://v2/b/{repo}/{key})")
            shown = [e["commit"] for e in sorted(trail, key=lambda e: e["uptimeNs"]) if e.get("branch") == key and e.get("commit")]
            seen = [e["commit"] for _, _, e in sections[key] if e and e.get("commit")]
            now = tips_now.get(key)
            if len(set(shown)) > 1:
                lines.append(f"_The branch changed while you were reviewing it ({shown[0][:8]} → {shown[-1][:8]})._")
            if seen and now and seen[-1] != now:
                lines.append(f"_Moved since you said this: {seen[-1][:8]} → {now[:8]}._")
            elif seen and now is None:
                lines.append(f"_The branch is gone now; you reviewed {seen[-1][:8]}._")
            elif not seen and key in started and now and started[key] != now:
                lines.append(f"_Moved since the review started: {started[key][:8]} → {now[:8]}._")
        last = None
        for u, where, entry in sections[key]:
            anchor = (where["file"], where["line"]) if where["file"] else None
            text = u["text"].strip()
            if anchor and anchor == last:
                notes[-1]["text"] += " " + text
                lines[-1] += " " + text
                continue
            notes.append({"id": f"n{len(notes) + 1}", "branch": key, "file": where["file"], "line": where["line"],
                          "commit": entry.get("commit") if entry else None, "text": text})
            label = f"`{where['file']}:{where['line']}`" if anchor and where["line"] else f"`{where['file']}`" if anchor else None
            lines.append(f"- **{notes[-1]['id']}** " + (f"{label} — {text}" if label else text))
            last = anchor
        lines.append("")
    return "\n".join(lines).strip() + "\n", notes


def owner(review):
    """The forest a review covered and the session recorded as its owner, either of which may be missing."""
    repo, parts = review["repoPath"], [p for p in review.get("scope", "").split("/") if p]
    name = "/".join(parts[3:]) if len(parts) >= 4 else ""
    def config(key):
        return subprocess.run(["git", "-C", repo, "config", "--get", key], capture_output=True, text=True).stdout.strip()
    forest = name if parts[:2] == ["v2", "p"] else config(f"branch.{name}.stack-project") if parts[:2] == ["v2", "b"] else ""
    return forest or None, (config(f"stack-project.{forest}.owner") if forest else "") or None


def deliver(folder, forest, session):
    """Sends the owning session its cue; True when claude-say says it was delivered."""
    if not session:
        return False
    cue = (f"[spoken review] Phil just finished a spoken review of {forest}, which you own. His notes, numbered: "
           f"{folder}/notes.md. Before changing code, write plan.txt in that folder and run "
           f"~/.dotfiles/scripts/show-review-reply {folder}. Once your tips are final, write answers.txt, with two or three "
           f"plain sentences for Phil under '# for phil', and run it again. That is how Phil hears back. "
           f"`show-review-reply --help` has the shape.")
    say = os.environ.get("SHOW_CLAUDE_SAY", str(SCRIPTS / "claude-say"))
    return subprocess.run([say, session[:8], cue], capture_output=True, text=True).returncode == 0


def main():
    args = [a for a in sys.argv[1:] if a != "--quiet"]
    if len(args) != 1:
        sys.exit(__doc__.strip())
    folder = Path(args[0])
    review = json.loads((folder / "review.json").read_text())
    start_ns = json.loads((folder / "recording.json").read_text())["startUptimeNs"]
    utterances = json.loads((folder / "utterances.json").read_text())["utterances"]
    trail_file = folder / "trail.jsonl"
    trail = [json.loads(l) for l in trail_file.read_text().splitlines() if l.strip()] if trail_file.exists() else []
    pairs = assign(trail, start_ns, utterances)
    branches = {place(e["address"])["branch"] for _, e in pairs if e} | set(review.get("tips", {}))
    tips_now = {b: tip(review["repoPath"], b) for b in branches if b}
    title = f"Spoken review · {review.get('title', folder.name)}"
    body, notes = render(review, trail, pairs, tips_now) if utterances else ("_Nothing was heard in this review._\n", [])
    body += (f"\n<sub>{folder} · a session acting on these notes answers each by id in plan.txt (before changing anything) "
             f"and answers.txt (once its tips are final) there, then runs show-review-reply on the folder; its --help has the shape</sub>\n")
    (folder / "notes.md").write_text(body)
    (folder / "notes.json").write_text(json.dumps(notes, indent=1))
    if "--quiet" in sys.argv:
        return
    notes_only = body
    forest, session = owner(review)
    if utterances and deliver(folder, forest, session):
        body = f"_Sent to the session that owns {forest}; you'll get its reply here._\n\n" + body
    elif utterances:
        reason = f"No live session owns {forest}" if forest else "This review isn't of a forest"
        body = f"_{reason}, so nothing picked these up. They're on your clipboard._\n\n" + body
    parts = [p for p in review.get("scope", "").split("/") if p]
    about = (["--forest", f"loops/{forest}"] if forest
             else ["--branch", "loops/" + "/".join(parts[3:])] if parts[:2] == ["v2", "b"] and len(parts) >= 4 else [])
    subprocess.run([os.environ.get("SHOW_NOTE", str(SCRIPTS / "show-note")), *about, title, body], check=False)
    subprocess.run([os.environ.get("SHOW_REVIEW_COPY", "pbcopy")], input=notes_only, text=True, check=False)


if __name__ == "__main__":
    main()
