#!/usr/bin/env bash
set -euo pipefail
# restack-dryrun — what the (future) ambient restacker WOULD do, moving NOTHING.
#
# The dry-run-first safety gate for the auto-restack daemon (design-viewer-flow.md,
# Phase 3): before the daemon is ever allowed to move a ref, this reports — per forest
# branch — its behind-count, a definitive rebase-classify verdict, and the action the
# daemon would take. No ref is moved, no branch checked out, no worktree mutated. The
# only side effect is fetching origin/main (read-only, like the daemon's trunk poll).
#
#   restack-dryrun            fetch origin/main, classify every forest branch, report
#   restack-dryrun --no-fetch use the local origin/main as-is (no network)
#   restack-dryrun --json     emit a machine-readable report (for the daemon / viewer)
#   restack-dryrun --deep-all trial-rebase EVERY branch (slow, fully definitive) instead of
#                             the default two-tier (fast classify; --deep only the overlap ones)
#
# Verdicts (per branch, vs fresh origin/main):
#   clean          behind=0 — nothing to do
#   would-restack  behind, replays clean (classify AUTOMATE) — daemon does it SILENTLY
#   would-contract already-merged ghost (classify CONTRACT) — daemon would drop & rewire
#   will-conflict  real collision (classify CONFLICT, --deep confirmed) — needs a human
#   skip-open-pr   has an open PR — daemon never auto-restacks it (house rule)
#   skip-stacked   parent isn't main — restacked by the forest walk, not the trunk pass
#   error          classify failed — inspect by hand

here="$(cd "$(dirname "$0")" && pwd)"
classify="$here/rebase-classify"
MAIN="$(git config stack.main-branch 2>/dev/null || echo main)"
fetch=1
json=0
deep_all=0
for a in "$@"; do
  case "$a" in
    --no-fetch) fetch=0 ;;
    --json)     json=1 ;;
    --deep-all) deep_all=1 ;;
    -h|--help)  sed -n '3,23p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "restack-dryrun: unknown arg $a" >&2; exit 2 ;;
  esac
done

command -v git >/dev/null || { echo "git required" >&2; exit 2; }
[[ -x "$classify" ]] || { echo "rebase-classify not found next to this script" >&2; exit 2; }

if (( fetch )); then
  git fetch -q origin "$MAIN" 2>/dev/null || echo "restack-dryrun: warning — could not fetch origin/$MAIN, using local" >&2
fi
trunk="origin/$MAIN"
git rev-parse --verify --quiet "$trunk" >/dev/null || trunk="$MAIN"
trunk_tip="$(git rev-parse --verify --quiet "$trunk" || echo "")"

# forest branches = anything with a stack-branch.<b>.parent, plus every stack-project list entry.
# NB: `git config --get-regexp` exits 1 when nothing matches; the `|| true` on each keeps
# that (and `set -o pipefail`) from aborting the run in a forest that has parents but no
# project lists (or vice-versa).
branches="$(
  {
    git config --name-only --get-regexp '^stack-branch\..*\.parent$' 2>/dev/null \
      | sed 's/^stack-branch\.//; s/\.parent$//' || true
    git config --get-regexp '^stack-project\..*\.branch$' 2>/dev/null | awk '{print $2}' || true
  } | sort -u
)"
if [[ -z "$branches" ]]; then
  if (( json )); then
    jq -n --arg trunk "$trunk" --arg tip "$trunk_tip" \
      '{trunk:$trunk, trunk_tip:$tip, branches:[], summary:{clean:0,would_restack:0,would_contract:0,will_conflict:0,skipped:0}}'
  else
    echo "no forest branches configured (stack-branch.*.parent / stack-project.*.branch)"
  fi
  exit 0
fi

# one gh call for all open-PR heads (best-effort; empty if gh/network/GH-remote unavailable —
# the trailing `|| true` keeps a gh failure from tripping `set -o pipefail` and killing the run).
open_pr_heads=" $(gh pr list --state open --limit 200 --json headRefName --jq '.[].headRefName' 2>/dev/null | tr '\n' ' ' || true) "

# classify every branch into a TSV row: branch \t parent \t behind \t verdict \t would-do
rows=()
clean=0 restack=0 contract=0 conflict=0 skipped=0
while IFS= read -r b; do
  [[ -n "$b" ]] || continue
  git rev-parse --verify --quiet "$b" >/dev/null || continue
  parent="$(git config "stack-branch.$b.parent" 2>/dev/null || echo "$MAIN")"

  if [[ "$open_pr_heads" == *" $b "* ]]; then
    rows+=("$b	$parent	-	skip-open-pr	left alone — has an open PR"); skipped=$((skipped+1)); continue
  fi
  if [[ "$parent" != "$MAIN" ]]; then
    rows+=("$b	$parent	-	skip-stacked	parent=$parent — forest walk handles it"); skipped=$((skipped+1)); continue
  fi

  behind="$(git rev-list --count "$b..$trunk" 2>/dev/null || echo 0)"
  if [[ "$behind" == "0" ]]; then
    rows+=("$b	$parent	0	clean	nothing to do"); clean=$((clean+1)); continue
  fi

  # Two-tier (default): a fast file-overlap classify first, UPGRADING only an at-risk branch
  # (overlap → fast says conflict) with the definitive ~1.5s --deep trial-rebase. Fast
  # AUTOMATE(0)=no overlap=can't conflict and CONTRACT(20)=already-merged are both already
  # definitive, so only the overlap minority pays for --deep — the ambient hot path stays
  # ~10x cheaper while the conflict verdict stays trustworthy. --deep-all forces the slow,
  # fully-definitive pass on every branch.
  set +e
  if (( deep_all )); then
    "$classify" "$b" "$trunk" --deep >/dev/null 2>&1; code=$?
  else
    "$classify" "$b" "$trunk" >/dev/null 2>&1; code=$?
    (( code == 30 )) && { "$classify" "$b" "$trunk" --deep >/dev/null 2>&1; code=$?; }
  fi
  set -e
  case "$code" in
    0)  rows+=("$b	$parent	$behind	would-restack	auto-restack (silent)"); restack=$((restack+1)) ;;
    20) rows+=("$b	$parent	$behind	would-contract	drop & rewire (already merged)"); contract=$((contract+1)) ;;
    30) # name the culprit: the newest merged PR whose files overlap this branch's (no gh call)
        # || true: head -1 closes early, so rebase-culprit dies on SIGPIPE (141) — pipefail + set -e would abort
        top="$("$here/rebase-culprit" "$b" "$trunk" 2>/dev/null | head -1)" || true
        cpr="${top%%$'\t'*}"; ctitle=""; [[ "$top" == *$'\t'* ]] && ctitle="${top#*$'\t'}"
        wd="⚠ needs you — real collision"; [[ -n "$cpr" ]] && wd="⚠ conflicts with #$cpr"
        rows+=("$b	$parent	$behind	will-conflict	$wd	$cpr	$ctitle"); conflict=$((conflict+1)) ;;
    *)  rows+=("$b	$parent	$behind	error	classify failed ($code) — inspect by hand"); skipped=$((skipped+1)) ;;
  esac
done <<< "$branches"

if (( json )); then
  printf '%s\n' "${rows[@]}" | jq -R -s \
    --arg trunk "$trunk" --arg tip "$trunk_tip" \
    --argjson sum "{\"clean\":$clean,\"would_restack\":$restack,\"would_contract\":$contract,\"will_conflict\":$conflict,\"skipped\":$skipped}" '
      split("\n") | map(select(length > 0) | split("\t")) |
      map({branch:.[0], parent:.[1],
           behind:(if .[2] == "-" then null else (.[2]|tonumber) end),
           verdict:.[3], would_do:.[4],
           conflict_pr:(if (.[5]//"") == "" then null else (.[5]|tonumber) end),
           conflict_title:(if (.[6]//"") == "" then null else .[6] end)}) |
      {trunk:$trunk, trunk_tip:$tip, branches:., summary:$sum}'
  exit 0
fi

printf '%-40s %-8s %-16s %s\n' "BRANCH" "BEHIND" "VERDICT" "WOULD DO"
printf '%-40s %-8s %-16s %s\n' "------" "------" "-------" "--------"
for r in "${rows[@]}"; do
  IFS=$'\t' read -r b parent behind verdict would cpr ctitle <<< "$r"
  printf '%-40s %-8s %-16s %s\n' "$b" "$behind" "$verdict" "$would"
done
echo "------"
echo "summary: clean=$clean would-restack=$restack would-contract=$contract will-conflict=$conflict skipped=$skipped"
echo "(dry run — nothing was moved)"
