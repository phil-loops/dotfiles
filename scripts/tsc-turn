#!/bin/zsh
# tsc-turn — the typecheck spelling of heavy-turn, the machine-wide queue for heavy work.
# Kept so every existing caller (the .zshrc tsc/npx wrappers, safe-restack) lands in the same
# budget as gates, clones and preview setup instead of a typecheck-only one.
#
#   tsc-turn npx tsc --project tsconfig.node.json --noEmit
#
# TSC_TURN_DIR (with TSC_TURN_SLOTS) still names a private slot set: stack-donor uses it to
# serialize donor refreshes with the gates queue's slot1. The command takes that private slot
# first, then a heavy-turn slot.
set -u
here="${0:A:h}"
[[ -n "${TSC_TURN_DIR:-}" ]] || exec "$here/heavy-turn" --class "${TSC_TURN_CLASS:-tsc}" -- "$@"

slots=${TSC_TURN_SLOTS:-2}
lockroot=$TSC_TURN_DIR
mkdir -p "$lockroot"
waited=0
while true; do
  for i in $(seq 1 "$slots"); do
    d="$lockroot/slot$i"
    if mkdir "$d" 2>/dev/null; then
      echo $$ > "$d/pid"
      trap 'rm -rf "$d"' EXIT INT TERM
      (( waited )) && echo "tsc-turn: slot free after ${waited}s — running" >&2
      "$here/heavy-turn" --class "${TSC_TURN_CLASS:-tsc}" -- "$@"
      exit $?
    fi
    pid=$(cat "$d/pid" 2>/dev/null)
    if [[ -n "${pid:-}" ]] && ! kill -0 "$pid" 2>/dev/null; then
      rm -rf "$d"   # holder died without cleanup — reap so the queue can't wedge
    fi
  done
  (( waited == 0 )) && echo "tsc-turn: all $slots slots busy — waiting" >&2
  sleep 2; (( waited += 2 ))
done
