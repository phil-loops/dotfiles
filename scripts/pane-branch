#!/usr/bin/env python3
"""pane-branch — which branch each tmux pane is working on, whatever runs in it (Claude, Codex, a shell).

  pane-branch                 every pane that has a branch: where it sits, the branch, why, how long ago
  pane-branch --json          every pane as JSON; branch is null where there's none
  pane-branch <pane>          "<repo>\\t<branch>" for one pane; exit 1 saying why when it has none
  pane-branch url <pane>      that branch's canopy:// link
  pane-branch from <pane>     the same answer, and remember the pane as the one you left: what canopy asks once
                              Ctrl-Space in tmux has brought it forward
  pane-branch tmux [--prefer <pane-id>]… [<repo> <branch>] [--stay] [--dry-run]
                              go to the pane for that branch: a preferred pane that exists, else the pane that
                              last worked on the branch, else the pane you left; then bring the terminal forward
                              (--stay: the caller already has)
  pane-branch host            "<pid>\\t<app>" of the app your tmux client runs in (Terminal, Ghostty, …)

<pane> is a pane id (%342), window:pane (3:1) in the session your tmux client shows, or one digit: that
pane of the window your client shows.

The record is the reference-transaction hook's (hooks/loops-reference-transaction): one line per branch
move, written in the pane that made it. A pane is on the branch it last added commits to, or last
started in a forest. A rewrite (a restack, a squash), a delete, the default branch and a bare
placeholder branch say nothing about what a pane is working on."""
import glob
import json
import os
import subprocess
import sys
import time

ZERO = "0" * 40


def journal_dir():
    return os.environ.get("PANE_BRANCH_DIR") or os.path.expanduser("~/.cache/pane-branch")


def read_moves(server, base=None):
    """The server's moves, oldest first: dicts of at, pane, repo, branch, old, new."""
    out = []
    try:
        with open(os.path.join(base or journal_dir(), f"moves-{server}.tsv")) as f:
            for line in f:
                parts = line.rstrip("\n").split("\t")
                if len(parts) == 6 and parts[0].isdigit():
                    out.append(dict(zip(("at", "pane", "repo", "branch", "old", "new"), parts), at=int(parts[0])))
    except OSError:
        pass
    return out


class Git:
    """The few facts a move is judged by, asked once each."""

    def __init__(self):
        self.memo = {}

    def _run(self, repo, *args):
        key = (repo, args)
        if key not in self.memo:
            r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
            self.memo[key] = (r.returncode, r.stdout.strip())
        return self.memo[key]

    def exists(self, repo, branch):
        return self._run(repo, "rev-parse", "-q", "--verify", f"refs/heads/{branch}")[0] == 0

    def in_forest(self, repo, branch):
        return bool(self._run(repo, "config", "--get", f"branch.{branch}.stack-project")[1])

    def default_branch(self, repo):
        key = (repo, "default")
        if key not in self.memo:
            try:
                with open(os.path.join(repo, ".git", "refs", "remotes", "origin", "HEAD")) as f:
                    self.memo[key] = f.read().strip().removeprefix("ref: refs/remotes/origin/") or "main"
            except OSError:
                self.memo[key] = "main"
        return self.memo[key]

    def adds_commits(self, repo, old, new):
        return old != new and self._run(repo, "merge-base", "--is-ancestor", old, new)[0] == 0


def how(move, git):
    """"committed" | "started" when the move is work on its branch, else None."""
    repo, branch, old, new = move["repo"], move["branch"], move["old"], move["new"]
    if new == ZERO or branch == git.default_branch(repo) or not git.exists(repo, branch):
        return None
    if old == ZERO:
        return "started" if git.in_forest(repo, branch) else None
    return "committed" if git.adds_commits(repo, old, new) else None


def working_on(moves, git):
    """pane id → its latest move that is work, with `how` set."""
    out = {}
    for move in reversed(moves):
        if move["pane"] in out:
            continue
        why = how(move, git)
        if why:
            out[move["pane"]] = dict(move, how=why)
    return out


def tmux(*args):
    r = subprocess.run(["tmux", *args], capture_output=True, text=True)
    return r.stdout.rstrip("\n") if r.returncode == 0 else None


def tmux_state():
    """(server pid, the client's session, the client's window id, panes) or None without a server."""
    out = tmux("display-message", "-p", "#{pid}\t#{session_name}\t#{window_id}", ";",
               "list-panes", "-a", "-F", "#{pane_id}\t#{session_name}\t#{window_index}\t#{pane_index}\t#{window_id}")
    if not out:
        return None
    head, _, listing = out.partition("\n")
    server, session, window = head.split("\t")
    panes = [dict(zip(("pane", "session", "window", "index", "window_id"), line.split("\t"))) for line in listing.splitlines()]
    return server, session, window, panes


def host_of(pid, table):
    """(pid, bundle path) of the app a process runs in: its nearest ancestor that is an app's own executable.
    `table` is pid -> (parent pid, command path)."""
    seen = set()
    while pid in table and pid not in seen:
        seen.add(pid)
        parent, command = table[pid]
        if ".app/Contents/MacOS/" in command:
            return pid, command.split(".app/Contents/MacOS/")[0] + ".app"
        pid = parent
    return None


def host():
    """The app the tmux client runs in, or None: the terminal is whatever that is, never a name assumed here."""
    client = tmux("display-message", "-p", "#{client_pid}")
    listing = subprocess.run(["ps", "-axo", "pid=,ppid=,comm="], capture_output=True, text=True).stdout
    table = {}
    for line in listing.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3:
            table[parts[0]] = (parts[1], parts[2])
    return host_of(client, table) if client else None


def rows(state, moves, git):
    """Every pane with its address and, where it has one, its branch."""
    _, session, _, panes = state
    found = working_on(moves, git)
    out = []
    for p in panes:
        place = f"{p['window']}:{p['index']}"
        row = {"pane": p["pane"], "address": place if p["session"] == session else f"{p['session']} {place}",
               "session": p["session"], "window": int(p["window"]), "index": int(p["index"]), "window_id": p["window_id"],
               "repo": None, "repo_path": None, "branch": None, "how": None, "at": None}
        move = found.get(p["pane"])
        if move:
            row.update(repo=os.path.basename(move["repo"]), repo_path=move["repo"], branch=move["branch"], how=move["how"], at=move["at"])
        out.append(row)
    return out


def pick(target, state, all_rows):
    """The row a <pane> argument names, or (None, why)."""
    _, session, window, _ = state
    if target.startswith("%"):
        hits = [r for r in all_rows if r["pane"] == target]
    elif target.isdigit():
        hits = [r for r in all_rows if r["window_id"] == window and r["index"] == int(target)]
    else:
        w, _, i = target.partition(":")
        if not (w.isdigit() and i.isdigit()):
            return None, f"{target!r} isn't a pane id, window:pane or a digit"
        hits = [r for r in all_rows if r["session"] == session and r["window"] == int(w) and r["index"] == int(i)]
    return (hits[0], None) if hits else (None, f"no pane {target}")


def last_pane_file():
    return os.path.join(journal_dir(), "last-pane")


def remember(server, pane):
    try:
        os.makedirs(journal_dir(), exist_ok=True)
        with open(last_pane_file(), "w") as f:
            f.write(f"{server}\t{pane}\n")
    except OSError:
        pass


def remembered(server):
    try:
        with open(last_pane_file()) as f:
            was, _, pane = f.read().strip().partition("\t")
    except OSError:
        return None
    return pane if was == server and pane else None


def workers(moves, git, repo, branch):
    """The panes that worked on a branch, latest work first — a pane since moved on to another still counts."""
    out = []
    for move in reversed(moves):
        if move["branch"] == branch and os.path.basename(move["repo"]) == repo and move["pane"] not in out and how(move, git):
            out.append(move["pane"])
    return out


def target(all_rows, prefer=(), worked=(), last=None):
    """The pane to land on: a preferred one that exists, else the one that last worked on the branch,
    else the one canopy was entered from; None when there's nothing to choose by."""
    here = {r["pane"] for r in all_rows}
    return next((pane for pane in [*prefer, *worked, last] if pane in here), None)


SHOW = os.path.expanduser("~/.cache/show/Show.app/Contents/MacOS/Show")


def show_takes_bare_links():
    """Whether the running Show is its current build: an older one reads a link with no page as "go home"."""
    r = subprocess.run(["pgrep", "-nxf", SHOW], capture_output=True, text=True)
    if r.returncode != 0:
        return False
    started = " ".join(subprocess.run(["ps", "-o", "lstart=", "-p", r.stdout.strip()], capture_output=True, text=True).stdout.split())
    try:
        return time.mktime(time.strptime(started, "%a %b %d %H:%M:%S %Y")) >= os.path.getmtime(SHOW)
    except (ValueError, OSError):
        return False


def to_canopy(pane, state, moves, git):
    """One pane's branch is all this asks git about, and the link goes straight to Show, marked so Show takes the
    terminal window's place and size (show-app/TerminalFrame.swift)."""
    remember(state[0], pane)
    move = working_on([m for m in moves if m["pane"] == pane], git).get(pane)
    if move:
        os.execvp("open", ["open", f"canopy://v2/b/{os.path.basename(move['repo'])}/{move['branch']}?beside=terminal"])
    if show_takes_bare_links():
        os.execvp("open", ["open", "canopy://?beside=terminal"])
    canopy = os.path.join(os.path.dirname(os.path.abspath(__file__)), "canopy")
    os.execv(canopy, [canopy, "--focus"])


def to_tmux(args, state, moves, git):
    dry, stay = "--dry-run" in args, "--stay" in args
    args = [a for a in args if a not in ("--dry-run", "--stay")]
    prefer = []
    while args[:1] == ["--prefer"] and len(args) >= 2:
        prefer.append(args[1])
        args = args[2:]
    if len(args) not in (0, 2):
        print(__doc__, file=sys.stderr)
        return 2
    repo, branch = args if args else (None, None)
    here = [{"pane": p["pane"]} for p in state[3]]
    # a chat's pane needs no question of git; the branch's workers are only asked for when none is there
    pane = target(here, prefer) or target(here, (), workers(moves, git, repo, branch) if branch else (), remembered(state[0]))
    commands = [["tmux", "select-window", "-t", pane, ";", "select-pane", "-t", pane, ";", "switch-client", "-t", pane]] if pane else []
    if not stay:
        commands.append(["open", "-a", (host() or (None, "Terminal"))[1]])
    for command in commands:
        if dry:
            print(" ".join(command))
        else:
            subprocess.run(command, capture_output=True)
    return 0


def ago(seconds):
    for size, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if seconds >= size:
            return f"{int(seconds // size)}{unit}"
    return "now"


def main():
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    state = tmux_state()
    if not state:
        print("pane-branch: no tmux server", file=sys.stderr)
        return 1
    moves, git = read_moves(state[0]), Git()
    if args[:1] == ["canopy"] and len(args) == 2:   # the binding a tmux not yet reloaded still has
        to_canopy(args[1], state, moves, git)
    if args == ["host"]:
        found = host()
        if not found:
            print("pane-branch: the tmux client runs in no app", file=sys.stderr)
            return 1
        print("\t".join(found))
        return 0
    if args[:1] == ["tmux"]:
        return to_tmux(args[1:], state, moves, git)
    if args[:1] == ["from"] and len(args) == 2 and args[1].startswith("%"):
        moves = [m for m in moves if m["pane"] == args[1]]   # one pane's branch is all this asks git about
    all_rows = rows(state, moves, git)
    if args == ["--json"]:
        print(json.dumps(all_rows))
        return 0
    if not args:
        now = time.time()
        for r in all_rows:
            if r["branch"]:
                print(f"{r['address']:<14} {r['repo']:<12} {r['branch']}  ·  {r['how']} {ago(now - r['at'])}")
        return 0
    want_url, leaving = args[0] == "url", args[0] == "from"
    if len(args) != (2 if want_url or leaving else 1):
        print(__doc__, file=sys.stderr)
        return 2
    row, why = pick(args[-1], state, all_rows)
    if row and leaving:
        remember(state[0], row["pane"])
    if row and not row["branch"]:
        row, why = None, f"pane {row['address']} hasn't committed to a branch or started one"
    if not row:
        print(f"pane-branch: {why}", file=sys.stderr)
        return 1
    print(f"canopy://v2/b/{row['repo']}/{row['branch']}" if want_url else f"{row['repo']}\t{row['branch']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
