#!/usr/bin/env python3
"""Resolve a tRPC call chain under the cursor to the procedure's source location.

Prints `path:line` for Helix's `:open`, which parses that syntax.

The generated .gen/trpc-types declarations inline the whole router tree into
root.d.ts, so LSP go-to-definition can only land on the appRouter literal. This
walks the chain by hand instead: api.<routerKey>.<procedure> -> the router
identifier in trpc/root.ts -> its import -> the procedure key in that file.

usage: trpc-goto <file> <line>
"""

import os
import re
import subprocess
import sys


def fail(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def repo_root(start):
    try:
        return subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=os.path.dirname(os.path.abspath(start)),
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except subprocess.CalledProcessError:
        fail("not in a git repo")


def read(path):
    with open(path, encoding="utf-8") as fh:
        return fh.read()


def find_key_line(text, key):
    m = re.search(rf"^\s*{re.escape(key)}\s*:", text, re.M)
    return text[: m.start()].count("\n") + 1 if m else None


def main():
    if len(sys.argv) < 3:
        fail("usage: trpc-goto <file> <line>")
    src_file, lineno = sys.argv[1], int(sys.argv[2])

    lines = read(src_file).splitlines()
    if not 1 <= lineno <= len(lines):
        fail("line out of range")

    # the cursor often rests inside the call's argument object, so walk back to
    # the nearest chain above it
    chain = next(
        (
            m
            for m in (
                re.search(r"\bapi\.(\w+)\.(\w+)", lines[i])
                for i in range(lineno - 1, max(-1, lineno - 9), -1)
            )
            if m
        ),
        None,
    )
    if not chain:
        fail("no api.<router>.<procedure> near this line")
    router_key, procedure = chain.group(1), chain.group(2)

    root = repo_root(src_file)
    root_ts = os.path.join(root, "trpc", "root.ts")
    if not os.path.exists(root_ts):
        fail("trpc/root.ts not found")
    root_src = read(root_ts)

    ident = re.search(rf"^\s*{re.escape(router_key)}\s*:\s*(\w+)\s*,", root_src, re.M)
    if not ident:
        fail(f"router '{router_key}' not in appRouter")
    ident = ident.group(1)

    imp = re.search(
        rf"""import\s*\{{[^}}]*\b{re.escape(ident)}\b[^}}]*\}}\s*from\s*["']([^"']+)["']""",
        root_src,
    )
    if not imp:
        fail(f"no import for '{ident}'")

    rel = re.sub(r"\.js$", "", imp.group(1))
    base = os.path.normpath(os.path.join(os.path.dirname(root_ts), rel))
    target = next(
        (c for c in (base + ".ts", base + ".tsx", os.path.join(base, "index.ts")) if os.path.exists(c)),
        None,
    )
    if not target:
        fail(f"router source not found for '{rel}'")

    hit = find_key_line(read(target), procedure)
    # no trailing newline: Helix's %sh{} splices this straight into `:open`'s
    # path argument, and a newline makes it a nonexistent file
    print(f"{target}:{hit}" if hit else target, end="")


if __name__ == "__main__":
    main()
