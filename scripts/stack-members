#!/usr/bin/env python3
"""stack-members <project> — the forest's member branches, one per line: every local branch whose
branch.<b>.stack-project names <project>, in registry order, then the unlisted by name.
The one membership read for scripts (see stack_members.py)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from stack_members import members  # noqa: E402

if len(sys.argv) != 2 or sys.argv[1].startswith("-"):
    print(__doc__.strip(), file=sys.stderr)
    sys.exit(2)
for b in members(sys.argv[1]):
    print(b)
