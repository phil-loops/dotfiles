#!/bin/zsh
# stdin → formatted stdout, picking oxfmt's dialect from the buffer's name. Used by helix's
# space-m (select_all → :pipe → :write): piping is a synchronous transaction, where :format
# is an async job whose edit lands AFTER a :write queued behind it (verified 2026-07-22).
#
# FAILS CLOSED, and that is the whole point: :pipe replaces the selection with whatever it
# reads — including stderr — so a formatter that rejects a mid-edit syntax error would
# otherwise overwrite the buffer with "Unexpected token" and :write would save it (verified:
# it ate a file). Anything but a clean, non-empty format hands the original bytes back.
set -u
in=$(mktemp) || exit 0
out=$(mktemp) || { rm -f "$in"; exit 0; }
trap 'rm -f "$in" "$out"' EXIT
cat > "$in"

case "${1##*.}" in
  ts)  lang=ts ;;
  tsx) lang=tsx ;;
  *)   cat "$in"; exit 0 ;;   # a file oxfmt doesn't own passes through untouched
esac

if "$HOME/.dotfiles/scripts/oxfmt-stdin" "$lang" < "$in" > "$out" 2>/dev/null && [[ -s "$out" ]]; then
  cat "$out"
else
  cat "$in"
fi
