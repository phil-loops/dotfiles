#!/bin/zsh
# stack-pr-body — furniture for a GitHub PR body: the branch's one-line purpose plus its
# merge-order block, shaped to sit UNDER hand-written prose (and above the Traffic Cop template)
# rather than replace it. The default output is deliberately an appendix, not a document — the
# PR author's own words go on top; this block guarantees the branch's rationale and forest
# position ship with them.
#
# Everything comes from stack_facts.py (which owns every fact — position, plan, edges, PR
# numbers) so the default costs nothing, reads the same every time, and cannot disagree with the
# commit body or the map. Only --full touches stack-summary, which may spend a model call when
# the stored summary is stale.
#
#   stack-pr-body <branch>           → Phil's voice: the opening commit's short why (1–3 lines, plan
#                                      stripped), or nothing — for above the Traffic Cop template
#   stack-pr-body <branch> --plan    → purpose + commit outline + merge-order furniture (opt-in)
#   stack-pr-body <branch> --context → where this PR sits in the project: what already landed,
#                                      this PR, and what's coming — for pasting above Traffic Cop
#   stack-pr-body <branch> --full    → the full document (title, where-it-fits, stored change
#                                      summary, merge order, mermaid map)
#   stack-pr-body <branch> --link    → also link the fork's assembled integration (opt-in: that
#                                      link is the one fact the forest cannot vouch for itself)
#   stack-pr-body <branch> --packet  → the review packet (review_packet.py) — what the viewer's
#                                      compare links publish: Intent, scope, merge order, reading
#                                      order, verified facts, then the repo's PR template
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

here="${0:A:h}"
branch="${1:-}"
[[ -n "$branch" ]] || { echo "usage: stack-pr-body <branch> [--plan] [--context] [--full] [--link] [--packet]" >&2; exit 2; }
shift
[[ " $* " == *" --packet "* ]] && exec python3 "$here/review_packet.py" "$branch"
if (( $# == 0 )); then   # the default: his voice, not furniture (2026-10-25)
  parent=$(git config "branch.$branch.stack-parent" 2>/dev/null || echo main)
  [[ "$parent" == main || "$parent" == master ]] && git rev-parse -q --verify "origin/$parent" >/dev/null && parent="origin/$parent"
  first=$(git log --reverse --first-parent --format='%b%x1e' "$parent..$branch" | python3 -c 'import sys; print(sys.stdin.read().split("\x1e")[0])')
  FIRST="$first" PYTHONPATH="$here" python3 -c '
import os, review_packet as rp
why = rp.strip_plan(os.environ["FIRST"])
lines = [l for l in why.splitlines() if l.strip()]
if why and len(why) <= 280 and len(lines) <= 3: print(why)'
  exit 0
fi

full=0 link=0 context=0
for arg in "$@"; do
  case "$arg" in
    --plan) ;;
    --context) context=1 ;;
    --full) full=1 ;;
    --link) link=1 ;;
    *) echo "unknown flag: $arg" >&2; exit 2 ;;
  esac
done

facts=$(python3 "$here/stack_facts.py" facts "$branch")

if (( full )); then
  change=$("$here/stack-summary" "$branch" 2>/dev/null || true)
  [[ -n "$change" ]] || change="_(no summary — run \`stack-summary ${branch}\`)_"
else
  change=""
fi

BRANCH="$branch" FACTS="$facts" CHANGE="$change" FULL="$full" CONTEXT="$context" python3 - <<'PY'
import json, os, re, subprocess

f = json.loads(os.environ["FACTS"])
full = os.environ["FULL"] == "1"
out = []

def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True).stdout

def own_subjects(branch):
    # The branch's own commits, oldest first — the outline a reviewer reads the diff by. A
    # repo squash-merges with PR_BODY, so this list is what survives on main. Fan-in commits
    # carried as cherry-picks of a `requires` dep are the dep's story, not this branch's.
    parent = git("config", f"branch.{branch}.stack-parent").strip() or "main"
    base = (git("merge-base", "origin/main", branch).strip()
            if parent in ("main", "master") else parent)
    shas = git("rev-list", "--reverse", f"{base}..{branch}").split()
    for dep in git("config", "--get-all", f"branch.{branch}.stack-requires").split():
        carried = {line[2:] for line in git("cherry", dep, branch, base).splitlines()
                   if line.startswith("- ")}
        shas = [sha for sha in shas if sha not in carried]
    return [re.sub(r"^(\w+)\([^)]*\)(!?):", r"\1\2:", git("log", "-1", "--format=%s", sha).strip())
            for sha in shas]

if os.environ["CONTEXT"] == "1":
    if not f["project"] or len(f["plan"]) < 2:
        raise SystemExit
    def ref(s):
        return "#%s" % s["pr"] if s.get("pr") else s["job"]
    me = next(s["n"] for s in f["plan"] if s.get("me"))
    landed = [s for s in f["plan"] if s.get("landed")]
    before = [s for s in f["plan"] if s["n"] < me and not s.get("landed")]
    after = [s for s in f["plan"] if s["n"] > me and not s.get("landed")]
    out.append("**Where this fits** — %s of %s" % (f["position"], f["total"]))
    if landed:
        out.append("\nAlready merged:")
        out += ["- %s" % ref(s) for s in landed]
    if before:
        out.append("\nIn review:")
        out += ["- %s" % ref(s) for s in before]
    out.append("\n**This PR:** %s" % (f["purpose"] or f["job"]))
    if after:
        out.append("\nComing up:")
        out += ["- %s" % ref(s) for s in after]
    print("\n".join(out))
    raise SystemExit

outline = own_subjects(os.environ["BRANCH"])

def step_ref(s):
    if not s.get("pr"):
        return ""
    return " (#%s%s)" % (s["pr"], ", merged" if s.get("state") == "merged" else "")

if not full:
    out.append(f["purpose"] or f["job"])
    if len(outline) > 1:
        out.append("\nCommits, in order:")
        out += ["  %d. %s" % (i, s) for i, s in enumerate(outline, 1)]
    if f["project"] and len(f["plan"]) > 1:
        out.append("\nPart of a stack, in merge order:")
        for s in f["plan"]:
            if s.get("me"):
                out.append("  %d. [this branch]" % s["n"])
                continue
            # a PR number alone: GitHub renders the title and merged state on the link
            label = "#%s" % s["pr"] if s.get("pr") else s["job"]
            out.append("  %d. %s" % (s["n"], label))
        if f["requires"]:
            step_by_branch = {s.get("branch"): s["n"] for s in f["plan"]}
            def req_ref(r):
                if r.get("pr"):
                    return "#%s" % r["pr"]
                n = step_by_branch.get(r.get("branch"))
                return "step %d" % n if n else r["job"]
            out.append("\nPulls in (fan-in — merges first): " + ", ".join(
                req_ref(r) for r in f["requires"]))
    print("\n".join(out))
    raise SystemExit

if f["project"] and f["position"]:
    out.append("Title: %s/%s — %s\n\n---\n" % (f["project"], f["position"], f["job"]))

out.append(f["purpose"] or f["job"])

if f["project"]:
    out.append("\n### Where it fits\n")
    out.append("Part of a stack — %s of %s.\n" % (f["position"], f["total"]))
    if f["buildsOn"]:
        b = f["buildsOn"]
        out.append("Builds on (merges first):\n- %s%s\n" % (b["job"], step_ref(b)))
    else:
        out.append("An independent base — forks off `main`, merges on its own schedule.\n")
    if f["requires"]:
        out.append("Pulls in (fan-in — merges first):")
        out += ["- %s%s" % (r["job"], step_ref(r)) for r in f["requires"]] + [""]
    if f["unblocks"]:
        out.append("Unblocks (waits on this):")
        out += ["- %s%s" % (u["job"], step_ref(u)) for u in f["unblocks"]] + [""]

if len(outline) > 1:
    out.append("\n### Commits\n")
    out += ["%d. %s" % (i, s) for i, s in enumerate(outline, 1)]

out.append("\n### The change\n")
out.append(os.environ["CHANGE"])

if f["project"]:
    out.append("\n### Merge order\n")
    for s in f["plan"]:
        mark = "  ← **this PR**" if s.get("me") else ""
        label = "#%s" % s["pr"] if s.get("pr") else s["job"]
        out.append("%d. %s%s" % (s["n"], label, mark))

print("\n".join(out))
PY

if (( link )); then
  project=$(git config "branch.${branch}.stack-project" 2>/dev/null || git config "stack-branch.${branch}.project" 2>/dev/null || true)
  url=$("$here/stack-integ-publish" --url "$project" 2>/dev/null || true)
  [[ -n "$url" ]] && printf '\nWhole feature assembled: %s\n' "$url"
fi

if (( full )); then
  printf '\n%s\n' "$(python3 "$here/stack_facts.py" mermaid "$branch" --fence)"
fi
