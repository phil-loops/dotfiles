#!/bin/zsh
# stack-pr-body — a GitHub PR description that frames ONE branch in its forest. Paste it into the PR
# above the Traffic Cop block: this repo has a PR template, so GitHub prefills from the TEMPLATE and
# nothing here ever arrives by commit-message prefill.
#
# NOTHING here is drafted on the fly. The relational sections come from stack_facts.py (which owns
# every fact — position, plan, edges, PR numbers, the map) and the change description comes from
# stack-summary (stored on the branch, keyed by a rebase-stable patch-id). So regenerating a body
# costs nothing, reads the same every time, and cannot disagree with the commit body or the map.
#
#   stack-pr-body <branch>          → GitHub-flavored markdown PR body on stdout
#   stack-pr-body <branch> --link   → also link the fork's assembled integration (opt-in: that link
#                                     is the one fact the forest cannot vouch for itself)
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

here="${0:A:h}"
branch="${1:-}"
[[ -n "$branch" ]] || { echo "usage: stack-pr-body <branch> [--link]" >&2; exit 2; }

facts=$(python3 "$here/stack_facts.py" facts "$branch")
change=$("$here/stack-summary" "$branch" 2>/dev/null || true)
[[ -n "$change" ]] || change="_(no summary — run \`stack-summary ${branch}\`)_"

FACTS="$facts" CHANGE="$change" python3 - <<'PY'
import json, os

f = json.loads(os.environ["FACTS"])
out = []

def step_ref(s):
    if not s.get("pr"):
        return ""
    return " (#%s%s)" % (s["pr"], ", merged" if s.get("state") == "merged" else "")

if f["project"] and f["position"]:
    out.append("Title: %s/%s — %s\n\n---\n" % (f["project"], f["position"], f["job"]))

out.append(f["purpose"] or f["job"])

if f["project"]:
    out.append("\n### Where it fits\n")
    out.append("Part of a stack — %s of %s.\n" % (f["position"], f["total"]))
    if f["buildsOn"]:
        b = f["buildsOn"]
        out.append("Builds on (merges first):\n- %s%s\n" % (b["job"], step_ref(b)))
    else:
        out.append("An independent base — forks off `main`, merges on its own schedule.\n")
    if f["requires"]:
        out.append("Pulls in (fan-in — merges first):")
        out += ["- %s%s" % (r["job"], step_ref(r)) for r in f["requires"]] + [""]
    if f["unblocks"]:
        out.append("Unblocks (waits on this):")
        out += ["- %s%s" % (u["job"], step_ref(u)) for u in f["unblocks"]] + [""]

out.append("\n### The change\n")
out.append(os.environ["CHANGE"])

if f["project"]:
    out.append("\n### Merge order\n")
    for s in f["plan"]:
        mark = "  ← **this PR**" if s.get("me") else ""
        ref = ""
        if s.get("pr"):
            ref = " #%s%s" % (s["pr"], " (merged)" if s.get("state") == "merged" else "")
        out.append("%d.%s %s%s" % (s["n"], ref, s["job"], mark))

print("\n".join(out))
PY

if [[ "${2:-}" == "--link" ]]; then
  project=$(git config "branch.${branch}.stack-project" 2>/dev/null || git config "stack-branch.${branch}.project" 2>/dev/null || true)
  url=$("$here/stack-integ-publish" --url "$project" 2>/dev/null || true)
  [[ -n "$url" ]] && printf '\nWhole feature assembled: %s\n' "$url"
fi

printf '\n%s\n' "$(python3 "$here/stack_facts.py" mermaid "$branch" --fence)"
