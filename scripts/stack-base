#!/usr/bin/env zsh
# stack-base — print the commit a stacked branch is currently based on.
#
# Resolves stack-branch.<branch>.base when recorded (authoritative — it survives
# a parent force-push/rewrite that would shift a live merge-base). Otherwise it
# derives the base as merge-base(parent, branch), PERSISTS it, and prints it —
# self-healing legacy branches with no recorded base on first use.
#
# Why this exists: base-mutating ops (stack-squash, single-branch rebases) must
# act against the *frozen* base, never the parent *name*. `main` is a moving ref;
# resolving it at op-time silently folds main's advance into the result. The base
# is recorded at branch creation and refreshed by stack-restack after each rebase.
#
# Usage: stack-base <branch>      → prints a full SHA on stdout
set -uo pipefail

local branch="${1:-}"
[[ -z "$branch" ]] && { print -u2 "usage: stack-base <branch>"; exit 2; }

if ! git rev-parse --verify --quiet "refs/heads/${branch}" >/dev/null; then
  print -u2 "stack-base: no such branch: ${branch}"
  exit 1
fi

# Recorded base wins — but only if it still exists and is an ancestor of the
# branch (an external rebase can leave it stale; fall through to recompute).
local recorded=$(git config "branch.${branch}.stack-base" 2>/dev/null || git config "stack-branch.${branch}.base" 2>/dev/null || true)
if [[ -n "$recorded" ]] \
   && git rev-parse --verify --quiet "$recorded" >/dev/null \
   && git merge-base --is-ancestor "$recorded" "$branch" 2>/dev/null; then
  print -- "$recorded"
  exit 0
fi

# Derive from the fork point with the parent (default main).
local parent=$(git config "branch.${branch}.stack-parent" 2>/dev/null || git config "stack-branch.${branch}.parent" 2>/dev/null || echo main)
git rev-parse --verify --quiet "$parent" >/dev/null || parent=main

local base=$(git merge-base "$parent" "$branch" 2>/dev/null || true)
if [[ -z "$base" ]]; then
  print -u2 "stack-base: cannot derive base for ${branch} (parent=${parent})"
  exit 1
fi

# Persist so it's authoritative from here on.
git config "stack-branch.${branch}.base" "$base"
print -- "$base"
