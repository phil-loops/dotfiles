#!/usr/bin/env bash
# loops-tail — one combined, colored tail of the loops dev stack's logs.
#
#   loops-tail                 tail your default sources (loops-tail.conf)
#   loops-tail -p | --pick     fzf multi-select sources (TAB toggles), then tail
#   loops-tail -l | --list     list available sources (● = in your defaults)
#   loops-tail <source…>       tail exactly these sources
#   loops-tail -a | --all …    include dead servers' leftover logs (post-mortem tail)
#
# Sources (discovered live):
#   server            the whole dev stack, merged (/tmp/loops-dev.log)
#   dev:<name>        one dev app split out by loops-dev-demux (/tmp/loops-dev.d/<name>.log)
#   svc:<name>        a sidecar loops-doctor runs in its own tmux session, e.g. svc:jobs-worker
#   preview:<name>    a loops-preview side server (/tmp/loops-preview-<name>.log)
#   docker:<name>     a running container (docker logs -f)
#
# Defaults live in ~/.dotfiles/loops-tail.conf — one source per line, # comments fine.
# Each line of output is prefixed with a colored, width-aligned tag; Ctrl-C stops everything.
# A preview tags as its PORT ([:3011]) — the number in the browser tab you're comparing
# against — and tailing more than one source prints a legend of tag → source · branch · url.
set -uo pipefail

CONF="$HOME/.dotfiles/loops-tail.conf"
TAIL_N="${LOOPS_TAIL_LINES:-50}"
ALL=0   # --all: include sources whose server is gone but whose log file remains (post-mortem)

# a log file alone isn't a source — dead preview servers leave their /tmp logs behind.
# live = the tmux session that tees the log still exists (loops-restart / loops-preview naming).
alive() { tmux has-session -t "$1" 2>/dev/null; }

session_for() {
  case "$1" in
    server)    echo "loops-dev" ;;
    dev:*)     echo "loops-dev" ;;
    svc:*)     echo "loops-${1#svc:}" ;;
    preview:*) echo "loops-preview-${1#preview:}" ;;
    *)         return 1 ;;
  esac
}

log_for() {
  case "$1" in
    server)    echo "/tmp/loops-dev.log" ;;
    dev:*)     echo "/tmp/loops-dev.d/${1#dev:}.log" ;;
    svc:*)     echo "/tmp/loops-${1#svc:}.log" ;;
    preview:*) echo "/tmp/loops-preview-${1#preview:}.log" ;;
    *)         return 1 ;;
  esac
}

meta_get()   { [ -f "$1" ] && sed -n "s/^$2=//p" "$1" | head -1 || true; }   # $1=metafile $2=KEY
meta_for()   { printf '/tmp/loops-preview-%s.meta' "$1"; }                   # $1=preview NAME

# A preview's PORT is its identity — it's the number in the browser tab you're comparing
# against. The worktree name isn't: several previews can live in look-alike wt-* dirs.
# Only previews get a port; `server` is a MERGED stack log, so stamping :3000 on a worker
# line would be a lie.
port_for() {
  case "$1" in
    preview:*) meta_get "$(meta_for "${1#preview:}")" PORT ;;
    *)         return 1 ;;
  esac
}

# $1 = source → the branch a preview serves (legend only). A stack-open scratch worktree is
# detached-but-intentional: it records the branch it stands in for, so prefer that name.
branch_for() {
  local dir b gd
  case "$1" in preview:*) dir="$(meta_get "$(meta_for "${1#preview:}")" DIR)" ;; *) return 1 ;; esac
  { [ -n "$dir" ] && [ -d "$dir" ]; } || return 1
  b="$(git -C "$dir" branch --show-current 2>/dev/null)"
  if [ -n "$b" ]; then echo "$b"; return 0; fi
  gd="$(git -C "$dir" rev-parse --git-dir 2>/dev/null)"
  if [ -n "$gd" ] && [ -s "$gd/stack-open-branch" ]; then sed -n '1p' "$gd/stack-open-branch"; return 0; fi
  echo "detached@$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
}

tag_for() {
  local p; p="$(port_for "$1" 2>/dev/null)" || p=""
  if [ -n "$p" ]; then printf ':%s' "$p"; else printf '%s' "$1"; fi
}

# what a tag stands for, saying each thing once: the source id only when the tag hides it,
# the branch only when it isn't already the preview's name, then the url. A source whose tag
# already names it earns its keep by showing where it reads from instead.
legend_detail() {
  local s="$1" d="" b p
  [ "$(tag_for "$s")" = "$s" ] || d="$s"
  b="$(branch_for "$s" 2>/dev/null)" || b=""
  [ -n "$b" ] && [ "$b" != "${s#preview:}" ] && d="${d:+$d · }$b"
  p="$(port_for "$s" 2>/dev/null)" || p=""
  [ -n "$p" ] && d="${d:+$d · }http://localhost:$p"
  if [ -z "$d" ]; then
    case "$s" in docker:*) d="container ${s#docker:}" ;; *) d="$(log_for "$s")" ;; esac
  fi
  printf '%s' "$d"
}

sources() {
  if [ -f /tmp/loops-dev.log ] && { [ "$ALL" = 1 ] || alive loops-dev; }; then
    echo "server"
  fi
  # per-app splits written by loops-dev-demux; all live/die with the loops-dev session
  if [ "$ALL" = 1 ] || alive loops-dev; then
    for f in /tmp/loops-dev.d/*.log; do
      [ -e "$f" ] || continue
      n="${f#/tmp/loops-dev.d/}"
      echo "dev:${n%.log}"
    done
  fi
  # sidecars loops-doctor runs outside the dev stack (jobs worker, mail-schedule):
  # each is its own `loops-<name>` tmux session redirecting to /tmp/loops-<name>.log.
  for f in /tmp/loops-*.log; do
    [ -e "$f" ] || continue
    b="${f#/tmp/}"
    n="${b%.log}"
    case "$n" in loops-dev|loops-preview-*) continue ;; esac
    if [ "$ALL" = 1 ] || alive "$n"; then
      echo "svc:${n#loops-}"
    fi
  done
  for f in /tmp/loops-preview-*.log; do
    [ -e "$f" ] || continue
    b="${f#/tmp/}"
    n="${b%.log}"
    if [ "$ALL" = 1 ] || alive "$n"; then
      echo "preview:${n#loops-preview-}"
    fi
  done
  docker ps --format '{{.Names}}' 2>/dev/null | sed 's/^/docker:/' | sort
}

defaults() {
  local d=""
  if [ -f "$CONF" ]; then
    d="$(grep -vE '^[[:space:]]*#' "$CONF" | awk 'NF')"
  fi
  if [ -n "$d" ]; then echo "$d"; else echo "server"; fi
}

list() {
  local defs p; defs=" $(defaults | tr '\n' ' ') "
  sources | while IFS= read -r s; do
    p="$(port_for "$s" 2>/dev/null)" || p=""
    case "$defs" in *" $s "*) printf '● %s%s\n' "$s" "${p:+  :$p}" ;; *) printf '  %s%s\n' "$s" "${p:+  :$p}" ;; esac
  done
}

cmd_for() {
  case "$1" in
    server|dev:*|svc:*|preview:*) echo "tail -n $TAIL_N -F $(log_for "$1")" ;;
    docker:*)                     echo "docker logs -f --tail $TAIL_N ${1#docker:}" ;;
    *)                            return 1 ;;
  esac
}

# defaults-first ordering so the picker's top rows are the usual suspects
ordered() {
  local all defs
  all="$(sources)"
  defs="$(defaults)"
  if [ -z "$defs" ]; then echo "$all"; return; fi
  { grep -Fx "$defs" <<<"$all"; grep -Fxv "$defs" <<<"$all"; } 2>/dev/null | awk 'NF'
}

# ── flags (any position before the mode/source args) ────────────────
MODE=""
args=()
for a in "$@"; do
  case "$a" in
    -a|--all)  ALL=1 ;;
    -l|--list) MODE="list" ;;
    -p|--pick) MODE="pick" ;;
    *)         args+=("$a") ;;
  esac
done

# ── pick the sources ────────────────────────────────────────────────
picked=()
if [ "$MODE" = "list" ]; then
  list; exit 0
elif [ "$MODE" = "pick" ]; then
  command -v fzf >/dev/null || { echo "loops-tail: --pick needs fzf" >&2; exit 1; }
  while IFS= read -r s; do picked+=("$s"); done < <(
    ordered | fzf --multi --height=50% --reverse --no-info \
      --prompt='tail ▸ ' --header='TAB: mark several · ENTER: tail'
  )
  [ "${#picked[@]:-0}" -gt 0 ] || exit 0
elif [ "${#args[@]:-0}" -gt 0 ]; then
  picked=("${args[@]}")
else
  while IFS= read -r s; do picked+=("$s"); done < <(defaults)
fi

warn() { printf '\033[33m[loops-tail]\033[0m %s\n' "$1" >&2; }

# ── resolve which sources really tail, and how wide their tags are ──
valid=()
TAGW=0
for s in ${picked[@]+"${picked[@]}"}; do
  cmd_for "$s" >/dev/null 2>&1 || { warn "unknown source '$s' (try --list)"; continue; }
  # a tmux-backed source can be stale (server died, log remains) or missing outright —
  # say so instead of tailing silence. `lsof :3000` catches a dev server started as a
  # bare `task dev`: it's live but nothing tees its output into the log file.
  if sess="$(session_for "$s" 2>/dev/null)" && ! alive "$sess"; then
    if [ ! -f "$(log_for "$s")" ]; then
      warn "'$s' has no log file — start it via loops-restart / loops-doctor / loops-preview"; continue
    fi
    if [ "$s" = "server" ] && lsof -ti :3000 >/dev/null 2>&1; then
      warn "something IS on :3000, but it wasn't started via loops-restart — this log is from an older run"
    else
      warn "'$s' isn't running — showing its log's last output (stale)"
    fi
  fi
  valid+=("$s")
  t="$(tag_for "$s")"; [ "${#t}" -gt "$TAGW" ] && TAGW="${#t}"
done
[ "${#valid[@]:-0}" -gt 0 ] || { echo "loops-tail: nothing to tail" >&2; exit 1; }

COLORS=(36 33 35 32 34 91 92 93 94 95)
color_at() { echo "${COLORS[$(($1 % ${#COLORS[@]}))]}"; }

# ── legend — a bare :3011 is only readable if you can look up what it serves ──
if [ "${#valid[@]}" -gt 1 ]; then
  i=0
  for s in "${valid[@]}"; do
    printf '\033[%sm[%-*s]\033[0m \033[2m%s\033[0m\n' \
      "$(color_at $i)" "$TAGW" "$(tag_for "$s")" "$(legend_detail "$s")" >&2
    i=$((i + 1))
  done
fi

# ── tail them all, tagged and colored ───────────────────────────────
# set -m: each background pipeline becomes its own PROCESS GROUP. Without it, bash
# collapses `( cmd | awk ) &` so $! is only the awk side and async jobs ignore SIGINT —
# Ctrl-C returned the prompt but left tail/docker-logs running. kill -- -pgid gets all.
set -m
pids=()
cleanup() {
  for p in ${pids[@]+"${pids[@]}"}; do   # ${arr[@]+…}: empty array + set -u crashes bash 3.2
    kill -- -"$p" 2>/dev/null || kill "$p" 2>/dev/null
  done
}
trap cleanup EXIT INT TERM

i=0
for s in "${valid[@]}"; do
  cmd="$(cmd_for "$s")"
  tag="$(printf '\033[%sm[%-*s]\033[0m' "$(color_at $i)" "$TAGW" "$(tag_for "$s")")"
  i=$((i + 1))
  (
    $cmd 2>&1 | awk -v tag="$tag" '{ print tag, $0; fflush() }'
  ) &
  pids+=($!)
done

wait
