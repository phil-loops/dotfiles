#!/usr/bin/env python3
"""forest-lock — run a command while holding a forest's lock (srv/forestlock.py, tooling-doctor P2).

  forest-lock <project> [--wait S] [--who <name>] -- <cmd…>        hold the forest while <cmd> runs
  forest-lock --branch <b> [--wait S] [--who <name>] -- <cmd…>     the forest <b> belongs to
  forest-lock --held (<project> | --branch <b>)                   exit 0 and say who while held

Every tool that moves a forest's branch refs takes this lock, so canopy's background restack, a
click in canopy and an agent's reshape never rewrite the same forest at once. An agent's raw git
on forest branches runs under it: `forest-lock disable-evidence --who "claude <session>" -- git
rebase …`, or a whole reshape as one `-- bash -c '…'`. A kernel lock: it dies with its holder.
Exit: the command's own; 75 when the forest stayed held past --wait (default 60s)."""
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from srv import forestlock  # noqa: E402


def main(argv):
    cwd = os.getcwd()
    project = branch = ""
    who = os.environ.get("CLAUDE_CODE_SESSION_ID") and f"claude {os.environ['CLAUDE_CODE_SESSION_ID'][:8]}" or f"forest-lock (pid {os.getpid()})"
    wait, check, cmd = 60.0, False, None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            cmd = argv[i + 1:]
            break
        if a == "--branch" and i + 1 < len(argv):
            branch = argv[i + 1]; i += 2
        elif a == "--wait" and i + 1 < len(argv):
            wait = float(argv[i + 1]); i += 2
        elif a == "--who" and i + 1 < len(argv):
            who = argv[i + 1]; i += 2
        elif a == "--held":
            check = True; i += 1
        elif not a.startswith("-") and not project:
            project = a; i += 1
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    if not (project or branch):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    key = forestlock.key_for(cwd, project, branch)
    if check:
        rec = forestlock.held(cwd, key)
        if rec:
            print(f"held by {forestlock.describe(rec)}")
            return 0
        return 1
    if not cmd:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    try:
        with forestlock.hold(cwd, key, who, wait=wait):
            return subprocess.run(cmd).returncode
    except forestlock.Held as e:
        print(f"forest-lock: {e}", file=sys.stderr)
        return 75


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
