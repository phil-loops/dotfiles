#!/usr/bin/env python3
"""claude-session-track — Claude Code SessionStart + PostToolUse hook.

Maintains a per-session presence record at ~/.claude/session-presence/<sid>.json so
any session (or the `claude-sessions` reader) can see who is working on what, across
every repo — not just dotfiles lanes.

Liveness is the OWNING PROCESS's existence (pid + start-time), NOT a timeout: a
crashed/closed session's record is reaped on sight; an idle-but-alive one is kept.
That's the distinction the time-based `own` lane staleness can't make.

WARN-ONLY / NEVER BLOCKS: always exits 0 and swallows every error — a presence
tracker must never break a tool call. Each session owns its own file, so concurrent
sessions never contend on a write.
"""
import sys, os, json, subprocess, time, glob, fcntl, re

DIR = os.environ.get("CLAUDE_SESSION_PRESENCE_DIR") or os.path.expanduser("~/.claude/session-presence")
FILES_CAP = 8       # keep only the most-recent N touched files
ACTED_CAP = 20      # branches a chat acted on, newest kept (DESIGN.md round 28)
PATCHES_CAP = 20    # dotfiles patches this session wrote, newest kept (closeup counts only these)
PATCH_WRITE = re.compile(r">\s*['\"]?(\S*?/patches/[\w.-]+\.patch)")
GIT_TTL = 20        # re-resolve repo/branch/purpose at most once per N seconds (keeps PostToolUse cheap)


def sh(args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return ""


def proc_start(pid):
    # canonical single-spaced lstart (see claude-session-pid) so reuse-guard compares hold
    return " ".join(sh(["ps", "-o", "lstart=", "-p", str(pid)]).split())


def resolve_owner():
    """(pid, start_time) of the claude session process, via the shared resolver —
    the SAME token `own` stamps on a lane claim, so the two systems agree."""
    helper = os.path.join(os.path.dirname(os.path.realpath(__file__)), "claude-session-pid")
    out = sh([helper])
    if out and "\t" in out:
        p, s = out.split("\t", 1)
        try:
            return int(p), s
        except ValueError:
            pass
    ppid = os.getppid()
    return ppid, proc_start(ppid)   # fallback: at least something process-shaped


def pid_alive(pid, start):
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass   # alive, just not signalable by us
    except Exception:
        return False
    return proc_start(pid) == start   # start-time match guards against pid reuse


def branch_of(path):
    """('<repo>:<branch>', its work id or None) for the worktree a file really sits in, resolved now
    (round 28, P5): the repo is its main worktree's name, as the viewer names repos; the work id
    keeps a recreated branch of the same name from inheriting it. None for a detached or non-git place."""
    d = os.path.dirname(os.path.realpath(path))
    while d and not os.path.isdir(d):
        d = os.path.dirname(d)
    out = sh(["git", "-C", d, "rev-parse", "--path-format=absolute", "--git-common-dir", "--abbrev-ref", "HEAD"]).splitlines()
    if len(out) != 2 or out[1] in ("", "HEAD"):
        return None
    common = out[0].rstrip("/")
    main = os.path.dirname(common) if os.path.basename(common) == ".git" else common
    return f"{os.path.basename(main)}:{out[1]}", sh(["git", "-C", d, "config", f"branch.{out[1]}.stack-work"]) or None


def gc_stale():
    """Reap records whose process is gone, AND superseded records that share a LIVE
    pid: a SessionStart under a new session_id in the same process (/clear, /resume) ends
    the previous conversation, whose pid stays alive so a plain liveness check never drops
    it. Subagents carry their parent's session_id and never start a record of their own.
    Keep the newest per pid, drop the rest."""
    best = {}   # pid -> (file, last_active)
    for f in glob.glob(os.path.join(DIR, "*.json")):
        try:
            r = json.load(open(f))
        except Exception:
            try:
                os.remove(f)
            except Exception:
                pass
            continue
        pid = r.get("pid")
        if not pid_alive(pid, r.get("start_time", "")):
            try:
                os.remove(f)
            except Exception:
                pass
            continue
        la = r.get("last_active", 0)
        if pid not in best:
            best[pid] = (f, la)
        else:   # same live process → keep the newer record, drop the older
            old = best[pid]
            drop = old[0] if la > old[1] else f
            if la > old[1]:
                best[pid] = (f, la)
            try:
                os.remove(drop)
            except Exception:
                pass


def main():
    raw = sys.stdin.read()
    d = json.loads(raw) if raw.strip() else {}
    sid = d.get("session_id") or "unknown"
    cwd = d.get("cwd") or os.getcwd()
    event = d.get("hook_event_name", "")

    os.makedirs(DIR, exist_ok=True)
    path = os.path.join(DIR, sid + ".json")
    # a parent and its subagents share a session id and their hooks run at once: one writer at a time,
    # or two edits read the same record and the second write drops the first's evidence
    lock = open(os.path.join(DIR, ".lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    rec = {}
    if os.path.exists(path):
        try:
            rec = json.load(open(path))
        except Exception:
            rec = {}

    now = int(time.time())
    rec["session_id"] = sid
    rec["cwd"] = cwd
    rec["last_active"] = now
    rec.setdefault("started_at", now)
    # the tmux pane this session lives in (inherited env) — lets claude-say address
    # it directly instead of reverse-mapping pid→pane. Empty if not under tmux.
    pane = os.environ.get("TMUX_PANE", "")
    if pane:
        rec["tmux_pane"] = pane

    # a SessionStart is a fresh process (incl. --resume) → (re)capture the liveness token
    if event == "SessionStart" or not rec.get("pid"):
        rec["pid"], rec["start_time"] = resolve_owner()

    # repo/branch/purpose: throttled so PostToolUse doesn't shell out to git every call
    if event == "SessionStart" or (now - rec.get("_git_at", 0) >= GIT_TTL):
        repo = sh(["git", "-C", cwd, "rev-parse", "--show-toplevel"])
        branch = sh(["git", "-C", cwd, "rev-parse", "--abbrev-ref", "HEAD"])
        if branch == "HEAD":   # detached (common in worktrees) → a short sha reads better
            sha = sh(["git", "-C", cwd, "rev-parse", "--short", "HEAD"])
            branch = "@" + sha if sha else "(detached)"
        purpose = sh(["git", "-C", cwd, "config", "branch.%s.description" % branch]) if branch and not branch.startswith("@") else ""
        rec["repo"] = repo
        rec["repo_name"] = os.path.basename(repo) if repo else "(no repo)"
        rec["branch"] = branch
        rec["purpose"] = purpose
        rec["_git_at"] = now

    if event == "PostToolUse":
        rec["last_tool"] = d.get("tool_name", "")
        fp = (d.get("tool_input") or {}).get("file_path", "")
        written = [m.group(1) for m in PATCH_WRITE.finditer((d.get("tool_input") or {}).get("command", ""))]
        if rec["last_tool"] == "Write" and re.search(r"/patches/[\w.-]+\.patch$", fp):
            written.append(fp)
        if written:
            names = [os.path.basename(os.path.expanduser(w)) for w in written]
            rec["patches"] = ([x for x in rec.get("patches", []) if x not in names] + names)[-PATCHES_CAP:]
        repo = rec.get("repo", "")
        if fp:
            rel = fp[len(repo) + 1:] if repo and fp.startswith(repo) else fp
            files = [x for x in rec.get("files", []) if x != rel]
            files.append(rel)
            rec["files"] = files[-FILES_CAP:]
            if rec["last_tool"] in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
                hit = branch_of(fp)
                if hit:
                    at, work = hit
                    acted = {k: v for k, v in (rec.get("acted") or {}).items() if k != at}
                    acted[at] = {"edit": now, **({"work": work} if work else {})}
                    rec["acted"] = dict(sorted(acted.items(), key=lambda kv: -kv[1]["edit"])[:ACTED_CAP])

    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as fh:
        json.dump(rec, fh)
    os.replace(tmp, path)   # a crash mid-write leaves the old record, never an empty one
    lock.close()

    if event == "SessionStart":
        gc_stale()   # reap dead records + supersede our pid's prior session_id


try:
    main()
except Exception:
    pass
sys.exit(0)
