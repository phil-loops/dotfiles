#!/bin/zsh
# stack-review-serve [<branch>] — launch the LIVE blessing review in the browser.
#
# Starts a tiny 127.0.0.1 server that serves the shell and recomputes the model
# (status + diffs + stale deltas) per request, so the view is never a stale
# snapshot. Bless buttons POST back, the page re-fetches, staleness updates. The
# server self-reaps a short while after you close the tab (heartbeat).
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

# `--ensure` → headless "make sure :62333 is up" mode for the dev flow: no browser, no
# build, just start the API server if it isn't already live, then exit. `npm run dev`'s
# predev hook calls this so the Vite proxy always has a live upstream.
# `--no-open` → full build + serve (same as a normal launch) but DON'T open a browser —
# warm the standalone viewer in the background (mobile/remote access, or pre-warm).
ensure=0
no_open=0
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --ensure) ensure=1; shift ;;
    --no-open) no_open=1; shift ;;
    *) break ;;
  esac
done

# No arg → land on the project picker (no ?branch). An explicit branch/project
# name (or `--all`) opens straight into that view.
branch="${1:-}"
qs=""; [[ -n "$branch" ]] && qs="?branch=${branch}"
here="${0:A:h}"
# pin the server's git context to the repo ROOT, not raw $(pwd) — launching from
# a subdir still scopes right, and launching outside a repo errors loudly instead
# of silently binding to the wrong place (the empty-/model footgun).
repo=$(git rev-parse --show-toplevel 2>/dev/null) \
  || { echo "stack-review-serve: not inside a git repo" >&2; exit 1; }
# Repo IDENTITY for the squatter check: the git common dir, shared by every
# worktree of the same repo (so launching from a feature worktree still matches
# the main checkout's live server). Must mirror the server's _repo_id().
repo_id=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
# Per-repo stable port (shared helper → never drifts from the :5174 proxy). Each repo
# gets its own port, so forests in several repos coexist as live tabs. Export it so the
# Python server binds the same port we computed (it reads $STACK_REVIEW_PORT).
STABLE_PORT=$("$here/stack-review-port" "$repo")
export STACK_REVIEW_PORT="$STABLE_PORT"

# A live server on THIS repo's port is normally ours (same repo → reuse). A foreign repo
# can only land here via a rare hash collision; the reclaim path stays as the safety net
# (kill the holder, fall through to launch a server bound to THIS repo).
sig=$(curl -sf --max-time 1 "http://127.0.0.1:${STABLE_PORT}/sig" 2>/dev/null) || sig=""
if [[ -n "$sig" ]]; then
  live_repo=$(print -r -- "$sig" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("repo",""))' 2>/dev/null)
  if [[ -n "$live_repo" && "$live_repo" == "$repo_id" ]]; then
    if (( ensure )); then
      exit 0
    fi
    if (( no_open )); then
      echo "✦ server already live (not opened) → http://127.0.0.1:${STABLE_PORT}"
    else
      open "http://127.0.0.1:${STABLE_PORT}/${qs}"
      echo "✦ reusing live review → http://127.0.0.1:${STABLE_PORT}  (${branch:-project picker})"
    fi
    exit 0
  fi

  # Foreign squatter (or a pre-/sig-repo server that can't identify itself).
  live_pid=$(print -r -- "$sig" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("pid",""))' 2>/dev/null)
  # || true: head -1 closes early, so lsof dies on SIGPIPE (141) — pipefail + set -e would abort
  [[ -z "$live_pid" ]] && live_pid=$(lsof -ti "TCP:${STABLE_PORT}" -sTCP:LISTEN 2>/dev/null | head -1) || true
  other=$(basename "$(dirname "${live_repo:-?}")")
  if [[ -n "$live_pid" ]]; then
    kill "$live_pid" 2>/dev/null
    # wait for the port to actually free before we try to bind it
    for i in {1..50}; do
      curl -sf --max-time 1 "http://127.0.0.1:${STABLE_PORT}/sig" >/dev/null 2>&1 || break
      sleep 0.1
    done
  fi
  echo "✦ reclaimed :${STABLE_PORT} from another repo (${other}) → rebinding to $(basename "$repo")" >&2
fi

servedir="$(mktemp -d)"   # scratch ROOT (restack.log etc.); the page itself is the built dist/

# Build the Solid viewer so the server serves a current scripts/viewer-solid/dist/.
# Cold-start only (a live server is reused above), so this ~0.4s build is rare. During
# active viewer work use `npm run dev` (:5174); this is the stable served build.
# In --ensure (dev) mode the app is served by Vite on :5174, so :62333 only needs to
# answer the JSON/SSE API — skip the dist build entirely.
if (( ! ensure )); then
  viewer="$here/viewer-solid"
  if [[ -d "$viewer/node_modules" ]]; then
    ( cd "$viewer" && npm run build >/dev/null 2>&1 ) \
      || echo "stack-review-serve: viewer build failed — serving the existing dist/ if present" >&2
  elif [[ ! -f "$viewer/dist/index.html" ]]; then
    echo "stack-review-serve: viewer not built and node_modules missing — run 'npm install' in $viewer" >&2
    exit 1
  fi
fi

# start the server detached; it prints its chosen port on the first line (the
# stable port, or an ephemeral fallback if something else already holds it)
python3 "$here/stack-review-server.py" "$servedir" "$here" "$repo" > "$servedir/port" 2>"$servedir/log" &!
for i in {1..60}; do port=$(cat "$servedir/port" 2>/dev/null); [[ -n "$port" ]] && break; sleep 0.1; done
[[ -n "${port:-}" ]] || { echo "stack-review-serve: server didn't start"; cat "$servedir/log"; exit 1; }

if (( ensure )); then
  echo "stack-review-serve: backend ensured live → http://127.0.0.1:${port}"
  exit 0
fi

if (( no_open )); then
  echo "✦ live review serving (not opened) → http://127.0.0.1:${port}  (${branch:-project picker})"
  exit 0
fi
open "http://127.0.0.1:${port}/${qs}"
echo "✦ live review → http://127.0.0.1:${port}  (${branch:-project picker})"
echo "  closes itself ~15min after you close the tab"
