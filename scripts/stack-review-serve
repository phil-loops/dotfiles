#!/bin/zsh
# stack-review-serve [<branch>] — launch the LIVE forest review in canopy (the native app).
#
# Starts a tiny 127.0.0.1 server that answers canopy's API and recomputes what it shows
# per request, so the view is never a stale snapshot. The server self-reaps a
# short while after canopy disconnects (heartbeat).
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

# `--ensure` → headless "make sure the server is up" mode: start the API server if it isn't
# already live, then exit.
# `--no-open` → serve (same as a normal launch) but DON'T open canopy — pre-warm.
# `--supervise` → run the server in the FOREGROUND on this repo's stable port and never
# return: the shape a KeepAlive launchd agent wants (it owns the restart, the server owns
# nothing). Takes the port over from whatever holds it, and refuses to run on any other port.
#
# NOT INSTALLED as an agent yet, and the reason is worth writing down: 6+ things can start
# this server on demand (this script, --ensure from the repo's predev hook, gh-to-nvim-host,
# stack-doctor, hx-ship, stack-review-port), and any of them can win the port between the
# supervised process exiting and launchd restarting it. Tried it live 2026-09-09: the agent
# ended up on 54735 and then 55775 while an on-demand server held 62497 — a supervised
# server that looks healthy to launchd and is invisible to every consumer. Collapsing the
# starters into ONE seam is the prerequisite; this flag is the other half, waiting for it.
ensure=0
no_open=0
supervise=0
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --ensure) ensure=1; shift ;;
    --no-open) no_open=1; shift ;;
    --supervise) supervise=1; shift ;;
    --help|-h)
      echo "usage: stack-review-serve [--ensure|--no-open|--supervise] [<project>|<branch>|--all]"
      echo "  no target: open the project picker; --all: every forest in this repo"
      exit 0 ;;
    --all) break ;;
    *) echo "stack-review-serve: unknown flag $1 (see --help)" >&2; exit 2 ;;
  esac
done

# No arg → v2's Forests. An explicit name opens straight into its v2 page: the forest's page when
# it names a forest, else that branch's review page when it's a branch — the viewer router reads PATHS, and an
# unrecognised one silently falls home.
branch="${1:-}"
here="${0:A:h}"
# pin the server's git context to the repo ROOT, not raw $(pwd) — launching from
# a subdir still scopes right, and launching outside a repo errors loudly instead
# of silently binding to the wrong place (the empty-/model footgun).
repo=$(git rev-parse --show-toplevel 2>/dev/null) \
  || { echo "stack-review-serve: not inside a git repo" >&2; exit 1; }
# the <repo> segment of a v2 path: the main worktree's name, as the viewer registry names it
repo_name=$(git worktree list --porcelain | sed -n '1s/^worktree //p'); repo_name=${repo_name:t}
qs="v2"
if [[ -n "$branch" && "$branch" != --all ]]; then
  if ! git config --get-all "stack-project.${branch}.branch" >/dev/null \
     && git show-ref --verify --quiet "refs/heads/${branch}"; then qs="v2/b/${repo_name}/${branch}"
  else qs="v2/p/${repo_name}/${branch}"; fi
fi
# Repo IDENTITY for the squatter check: the git common dir, shared by every
# worktree of the same repo (so launching from a feature worktree still matches
# the main checkout's live server). Must mirror the server's _repo_id().
repo_id=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
# Per-repo stable port (shared helper → never drifts from the :5174 proxy). Each repo
# gets its own port, so forests in several repos coexist as live tabs. Export it so the
# Python server binds the same port we computed (it reads $STACK_REVIEW_PORT).
STABLE_PORT=$("$here/stack-review-port" "$repo")
export STACK_REVIEW_PORT="$STABLE_PORT"

# A live server on THIS repo's port is normally ours (same repo → reuse). A foreign repo
# can only land here via a rare hash collision; the reclaim path stays as the safety net
# (kill the holder, fall through to launch a server bound to THIS repo).
# 3s, not 1: under load (a sibling session's typecheck puts this box at load 18) a live
# server's /sig can take over a second, and a timeout here reads as "nothing is running" and
# starts a SECOND server on a random port.
sig=$(curl -sf --max-time 3 "http://127.0.0.1:${STABLE_PORT}/sig" 2>/dev/null) || sig=""

# ── ONE owner of "start" ─────────────────────────────────────────────────────────────────
# Everything that can bring this server up comes through this script: the interactive launch,
# `--ensure` from the repo's predev hook, hx-ship, and gh-to-nvim-host (which is also how the
# browser extension launches it). Until now each of those could SPAWN, and against a supervised
# owner that is a race the owner loses — tried 2026-09-09: the launchd agent ended up on a
# random port while an on-demand server held the stable one, healthy to launchd and invisible
# to every consumer. So when an owner exists for THIS repo, nobody else spawns: they kick the
# agent and wait for its port.
AGENT="com.philbrockman.canopy-server"
OWNER_FILE="$HOME/.cache/canopy-server/owner"

owner_is_ours() {   # the agent is loaded AND it supervises this repo (it is per-repo)
  launchctl print "gui/$(id -u)/${AGENT}" >/dev/null 2>&1 || return 1
  [[ -r "$OWNER_FILE" ]] || return 1
  [[ "$(head -1 "$OWNER_FILE")" == "$repo_id" ]]
}

wait_for_port() {   # $1 = seconds to wait for /sig to answer
  local tries=$(( ${1:-20} * 4 ))
  for i in $(seq 1 $tries); do
    curl -sf --max-time 3 "http://127.0.0.1:${STABLE_PORT}/sig" >/dev/null 2>&1 && return 0
    sleep 0.25
  done
  return 1
}

if (( supervise )); then
  # take the port: any live holder is either a stale on-demand server for this repo or a
  # foreign squatter, and either way the supervised process is the owner now.
  # Ask the KERNEL who holds the port, not the server: /sig can time out under load, and a
  # takeover that silently skips leaves the supervised process to lose its own port.
  # || true: lsof exits 1 when nothing listens, and set -e would abort the agent.
  live_pid=$(lsof -nP -ti "TCP:${STABLE_PORT}" -sTCP:LISTEN 2>/dev/null | head -1) || true
  if [[ -n "${live_pid:-}" ]]; then
    kill "$live_pid" 2>/dev/null || true
    for i in {1..60}; do
      lsof -nP -ti "TCP:${STABLE_PORT}" -sTCP:LISTEN >/dev/null 2>&1 || break
      sleep 0.25
    done
  fi
  servedir="$HOME/.cache/canopy-server"   # stable, not mktemp: it outlives every restart
  mkdir -p "$servedir"
  print -r -- "$repo_id" > "$OWNER_FILE"   # what the deferral above reads: this repo has an owner
  export STACK_REVIEW_SUPERVISED=1
  exec python3 "$here/stack-review-server.py" "$servedir" "$here" "$repo"
fi
if [[ -n "$sig" ]]; then
  live_repo=$(print -r -- "$sig" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("repo",""))' 2>/dev/null)
  if [[ -n "$live_repo" && "$live_repo" == "$repo_id" ]]; then
    if (( ensure )); then
      exit 0
    fi
    if (( no_open )); then
      echo "✦ server already live (not opened) → http://127.0.0.1:${STABLE_PORT}"
    else
      "$here/canopy" --repo "$repo" --port "$STABLE_PORT" "/${qs}"
      echo "✦ reusing live review → canopy /${qs}  (:${STABLE_PORT})"
    fi
    exit 0
  fi

  # Foreign squatter (or a pre-/sig-repo server that can't identify itself).
  live_pid=$(print -r -- "$sig" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("pid",""))' 2>/dev/null)
  # || true: head -1 closes early, so lsof dies on SIGPIPE (141) — pipefail + set -e would abort
  [[ -z "$live_pid" ]] && live_pid=$(lsof -ti "TCP:${STABLE_PORT}" -sTCP:LISTEN 2>/dev/null | head -1) || true
  other=$(basename "$(dirname "${live_repo:-?}")")
  if [[ -n "$live_pid" ]]; then
    kill "$live_pid" 2>/dev/null
    # wait for the port to actually free before we try to bind it
    for i in {1..50}; do
      curl -sf --max-time 1 "http://127.0.0.1:${STABLE_PORT}/sig" >/dev/null 2>&1 || break
      sleep 0.1
    done
  fi
  echo "✦ reclaimed :${STABLE_PORT} from another repo (${other}) → rebinding to $(basename "$repo")" >&2
fi

# The owner starts servers for this repo; we only ask. (Not in --supervise: that IS the owner.)
if (( ! supervise )) && owner_is_ours; then
  launchctl kickstart "gui/$(id -u)/${AGENT}" >/dev/null 2>&1 || true
  if wait_for_port 20; then
    if (( ensure )); then
      echo "stack-review-serve: backend ensured live → http://127.0.0.1:${STABLE_PORT}"
    elif (( no_open )); then
      echo "✦ owner serving (not opened) → http://127.0.0.1:${STABLE_PORT}"
    else
      "$here/canopy" --repo "$repo" --port "$STABLE_PORT" "/${qs}"
      echo "✦ live review → canopy /${qs}  (:${STABLE_PORT})"
    fi
    exit 0
  fi
  # the owner is installed but didn't come up: say so and start one here rather than leave the
  # consumer with nothing — a wedged agent must not become a dead tool
  echo "stack-review-serve: ${AGENT} is installed but didn't answer on :${STABLE_PORT} — starting one here" >&2
fi

servedir="$(mktemp -d)"   # scratch ROOT (restack.log etc.)

# start the server detached; it prints its chosen port on the first line (the
# stable port, or an ephemeral fallback if something else already holds it)
python3 "$here/stack-review-server.py" "$servedir" "$here" "$repo" > "$servedir/port" 2>"$servedir/log" &!
for i in {1..60}; do port=$(cat "$servedir/port" 2>/dev/null); [[ -n "$port" ]] && break; sleep 0.1; done
[[ -n "${port:-}" ]] || { echo "stack-review-serve: server didn't start"; cat "$servedir/log"; exit 1; }

if (( ensure )); then
  echo "stack-review-serve: backend ensured live → http://127.0.0.1:${port}"
  exit 0
fi

if (( no_open )); then
  echo "✦ live review serving (not opened) → http://127.0.0.1:${port}  (${branch:-project picker})"
  exit 0
fi
"$here/canopy" --repo "$repo" --port "$port" "/${qs}"
echo "✦ live review → canopy /${qs}  (:${port})"
echo "  closes itself ~15min after canopy disconnects"
