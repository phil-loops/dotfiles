#!/bin/zsh
# Stack Restack - rebase every branch in a stack-project onto fresh origin/main.
#
# Usage: loops stack restack <project>            # start fresh
#        loops stack restack <project> --continue # resume after a manual resolve
#        loops stack restack <project> --abort    # discard saved state
#        loops stack restack <project> --plan     # dry-run: topo order + parent map
#        loops stack restack <project> --no-claude# disable auto-resolve (manual only)
#
# What it does:
#   1. Fetch origin; fast-forward local main
#   2. Snapshot every project branch's current SHA (so descendants know where to
#      rebase --onto from after their parent moves)
#   3. Topologically rebase bottom-up: roots onto main, then children onto their
#      (now-moved) parents, walking up the tree
#   4. After the walk, detect branches that became empty (no diff vs parent, or
#      ancestor of main) — delete them locally and rewire children's parent
#      metadata to the dropped branch's parent
#   5. Print summary
#
# Conflict handling:
#   On a conflict, headless `claude` is invoked (conservative bar) to attempt a
#   resolution. It auto-resolves only mechanically-certain cases — redundant
#   squash-merged commits, generated/lockfiles, non-overlapping add/add — and
#   stages them so the rebase continues. Anything touching hand-written logic,
#   delete/modify, or overlapping edits is escalated: the script saves state to
#   <git-common-dir>/stack-restack-state and exits 1 with a ready-to-run
#   interactive `claude` command (and the manual git steps). Resolve, then
#   `loops stack restack <project> --continue` resumes the topo walk.
#   `--no-claude` skips the auto step and always pauses for a human.
#   Tunables: CLAUDE_BIN (default `claude`), STACK_RESTACK_BUDGET_USD (default 2).
#
# Worktree awareness:
#   If a branch is checked out in another worktree, the rebase runs there.
#   Branches not checked out anywhere run in the current repo (HEAD moves to
#   the branch; restored to main at the end).

set -u

MAIN_BRANCH=$(git config stack.main-branch 2>/dev/null || echo "main")
STATE_DIR="$(git rev-parse --git-common-dir)/stack-restack-state"
SELF_DIR="${0:A:h}"   # script dir, captured at top level ($0 inside a zsh function is the function name, not the script)

usage() {
  cat >&2 <<EOF
Usage: loops stack restack <project>
       loops stack restack <project> --continue
       loops stack restack <project> --handoff   # AI-resolve the parked conflict (human-authorized), then resume
       loops stack restack <project> --abort
       loops stack restack <project> --plan
       loops stack restack <project> --no-claude
EOF
  exit 2
}

PROJECT=""
MODE="start"
# Auto-resolve conflicts via headless claude (conservative bar). On by default;
# --no-claude reverts to the old behavior (pause + manual resolve + --continue).
USE_CLAUDE=1
CLAUDE_BIN="${CLAUDE_BIN:-claude}"
# Resolution bar for the headless resolver. "conservative" (default) only auto-resolves
# mechanically-certain conflicts and escalates hand-written logic to a human. "full" is
# the human-authorized handoff (--handoff): resolve with judgment, still escalate when
# intent is genuinely ambiguous.
RESOLVE_BAR="${RESOLVE_BAR:-conservative}"
for arg in "$@"; do
  case "$arg" in
    --continue) MODE="continue" ;;
    --handoff|--resolve) MODE="handoff" ;;   # AI-resolve the currently-paused conflict (human-authorized), then resume
    --abort) MODE="abort" ;;
    --plan) MODE="plan" ;;
    --no-claude|--manual) USE_CLAUDE=0 ;;
    --*) echo "unknown flag: $arg" >&2; usage ;;
    *) [[ -z "$PROJECT" ]] && PROJECT="$arg" ;;
  esac
done

[[ -z "$PROJECT" ]] && usage

# ---------- helpers ----------

# Topologically order the project members so a branch always comes after its parent.
# Outputs one branch per line on stdout.
topo_order() {
  local project="$1"
  local -a members
  # Members = the whole connected forest, EXPANDED from the project's seeds along the
  # parent/requires graph — the SAME resolution the viewer (stack-forest) uses, so
  # "view the forest" and "restack the forest" can never disagree. A seed list of just
  # the root(s) therefore restacks everything; no need to keep it manually complete.
  local sf="${SELF_DIR}/stack-forest"
  while IFS= read -r m; do
    [[ -n "$m" ]] && members+=("$m")
  done < <("$sf" "$project" 2>/dev/null | jq -r '.nodes // {} | keys[]' 2>/dev/null)
  # Fallback: if stack-forest is unavailable/errored, use the literal seed list.
  if (( ${#members[@]} == 0 )); then
    while IFS= read -r m; do
      [[ -n "$m" ]] && members+=("$m")
    done < <(git config --get-all "stack-project.${project}.branch" 2>/dev/null)
  fi

  local -A is_member
  for m in "${members[@]}"; do is_member[$m]=1; done

  # Kahn-ish: repeatedly emit branches whose parent is already emitted (or not a member).
  local -A emitted
  local progress=1
  while (( progress )); do
    progress=0
    for m in "${members[@]}"; do
      [[ -n "${emitted[$m]:-}" ]] && continue
      local p=$(git config "stack-branch.${m}.parent" 2>/dev/null || true)
      if [[ -z "${is_member[$p]:-}" ]] || [[ -n "${emitted[$p]:-}" ]]; then
        echo "$m"
        emitted[$m]=1
        progress=1
      fi
    done
  done

  # Any unemitted = cycle.
  local cycle=()
  for m in "${members[@]}"; do
    [[ -z "${emitted[$m]:-}" ]] && cycle+=("$m")
  done
  if (( ${#cycle[@]} > 0 )); then
    echo "cycle in stack-branch parents: ${cycle[*]}" >&2
    return 1
  fi
}

worktree_of() {
  local branch="$1"
  git worktree list --porcelain | awk -v b="refs/heads/$branch" '
    $1 == "worktree" { p = $2 }
    $0 == "branch " b { print p; exit }
  '
}

# Run a git command in the right place for a branch. If checked out in another
# worktree, use -C <wt>. Else use current dir, after checking out the branch.
in_branch_place() {
  local branch="$1"; shift
  local wt=$(worktree_of "$branch")
  if [[ -n "$wt" ]]; then
    git -C "$wt" "$@"
  else
    git checkout "$branch" >/dev/null 2>&1 || return $?
    git "$@"
  fi
}

# Is `a` an ancestor of `b`?
is_ancestor() {
  git merge-base --is-ancestor "$1" "$2" 2>/dev/null
}

# When a member is dropped/orphaned (its branch ref is gone), strip the config refs
# that the parent-rewire + registry-removal DON'T cover: its per-branch `.project`
# membership tag, and any OTHER branch's `requires` that points AT it (a fan-in dep on
# a now-gone branch). Without this, a merged base leaves dangling tags + requires that
# the viewer and the next restack trip over.  $1 = the removed branch
_purge_member_refs() {
  local gone="$1" key v
  git config --unset "stack-branch.${gone}.project" 2>/dev/null || true
  while IFS= read -r key; do
    [[ -z "$key" ]] && continue
    typeset -a keep; keep=()
    while IFS= read -r v; do [[ -n "$v" && "$v" != "$gone" ]] && keep+=("$v"); done \
      < <(git config --get-all "$key" 2>/dev/null)
    git config --unset-all "$key" 2>/dev/null || true
    for v in "${keep[@]}"; do git config --add "$key" "$v"; done
    echo "  cleaned requires: ${key#stack-branch.} no longer needs ${gone}" >&2
  done < <(git config --get-regexp '^stack-branch\..*\.requires$' | awk -v g="$gone" '$2==g{print $1}' | sort -u)
}

# Where a branch's rebase actually runs (its worktree, or the current repo
# after in_branch_place checked it out here).
rebase_dir_for() {
  local branch="$1"
  local wt=$(worktree_of "$branch")
  if [[ -n "$wt" ]]; then echo "$wt"; else git rev-parse --show-toplevel; fi
}

# True while a rebase is paused/in-progress in $1.
rebase_in_progress() {
  local gitdir
  gitdir=$(git -C "$1" rev-parse --git-dir 2>/dev/null) || return 1
  [[ "$gitdir" != /* ]] && gitdir="$1/$gitdir"
  [[ -d "$gitdir/rebase-merge" || -d "$gitdir/rebase-apply" ]]
}

# Ask headless claude to resolve the current rebase conflict in $1, conservatively.
# Stages a resolution and returns 0, or returns 1 to escalate to a human.
# $1=dir  $2=branch  $3=parent
claude_attempt_resolve() {
  local dir="$1" branch="$2" parent="$3"
  (( USE_CLAUDE )) || return 1
  command -v "$CLAUDE_BIN" >/dev/null 2>&1 || {
    echo "    (claude not found on PATH — escalating)" >&2; return 1; }

  local conflicted
  conflicted=$(git -C "$dir" diff --name-only --diff-filter=U)
  [[ -z "$conflicted" ]] && return 0  # nothing unmerged; caller can --continue

  echo "    conflicts: $(echo "$conflicted" | tr '\n' ' ')" >&2

  local prompt budget
  if [[ "$RESOLVE_BAR" == "full" ]]; then
    echo "    → claude (full-judgment handoff)…" >&2
    budget="${STACK_RESTACK_HANDOFF_BUDGET_USD:-5}"
    prompt=$(cat <<EOF
You are resolving a git rebase conflict during a stack restack. A human has
explicitly handed this conflict to you to resolve with judgment — the
conservative auto-pass already escalated it, and the human clicked "hand off to
Claude". So resolve it properly; do not punt it back unless intent is genuinely
unrecoverable from the code + history.
Branch being rebased: ${branch}
Rebasing onto: ${parent}

The rebase is PAUSED with conflicts. Unmerged files:
${conflicted}

How to resolve well:
  - Understand BOTH sides with git: \`git diff\`, \`git log\`, \`git show <ref>:<path>\`,
    and read the surrounding code. Work out what each side intended.
  - Common case — squash-merge redundancy: the conflicting commit already landed
    on the new base (often as a squash-merge), possibly with small wording/impl
    differences. Take the new base's version; the branch commit is redundant.
  - Where the branch adds genuinely NEW behavior on top of the base's version,
    combine them so BOTH intents are preserved — the base's landed form plus the
    branch's new contribution. Never drop the branch's unique work.
  - Generated files / lockfiles (*.gen, .gen/*, package-lock.json, pnpm-lock.yaml,
    clickhouse/schema.sql, prisma client): take the new-base side; regenerated later.
  - Match the surrounding code's style and keep it compiling.

Only ESCALATE if, after reading both sides and the history, the correct intent is
truly ambiguous (e.g. two conflicting business-logic changes where picking either
silently loses behavior and there's no signal which is right).

Edit files to their final content, then \`git add <file>\` each. Do NOT run
\`git rebase --continue\`, push, reset, or rebase — the caller drives the rebase.

Finish by printing EXACTLY ONE line:
  RESTACK_RESOLVED            — all conflicts staged
  RESTACK_ESCALATE: <reason>  — genuinely ambiguous, left for a human (with reason)
EOF
)
  else
    echo "    → claude (conservative auto-resolve)…" >&2
    budget="${STACK_RESTACK_BUDGET_USD:-2}"
    prompt=$(cat <<EOF
You are resolving a git rebase conflict during an automated stack restack.
Branch being rebased: ${branch}
Rebasing onto: ${parent}

The rebase is PAUSED with conflicts. Unmerged files:
${conflicted}

Resolve ONLY when the resolution is mechanically certain. Be conservative —
when in doubt, escalate. It is always safe to escalate; a wrong auto-merge is not.

AUTO-RESOLVE (edit to final content, then \`git add <file>\`) only when:
  - The conflicting commit is already in the new base (a squash-merged commit
    being replayed) — the change is redundant; take the new base's version.
  - The file is generated / a lockfile (*.gen, .gen/*, package-lock.json,
    pnpm-lock.yaml, clickhouse/schema.sql, prisma generated client). Take the
    new-base side; it gets regenerated later.
  - Pure add/add with non-overlapping additions — keep both.

ESCALATE (do NOT edit; just explain) for everything else:
  - Conflicts in hand-written .ts/.tsx/.go/.sql logic
  - delete/modify conflicts
  - Overlapping edits to the same lines
  - Anything where you are not certain intent is preserved

Use git (git diff, git log, git show <ref>:<path>) to understand each side.
Read files as needed. Do NOT run \`git rebase --continue\`, push, reset, or
rebase — the caller drives the rebase. Only edit + \`git add\`.

Finish by printing EXACTLY ONE line:
  RESTACK_RESOLVED            — all conflicts staged, mechanically certain
  RESTACK_ESCALATE: <reason>  — left for a human, with a one-line reason
EOF
)
  fi

  local out
  out=$(cd "$dir" && "$CLAUDE_BIN" -p "$prompt" \
        --permission-mode default \
        --allowed-tools "Edit" "Read" "Grep" "Glob" \
          "Bash(git add:*)" "Bash(git diff:*)" "Bash(git status:*)" \
          "Bash(git log:*)" "Bash(git show:*)" "Bash(git checkout:*)" \
        --output-format text \
        --max-budget-usd "$budget" \
        2>&1)

  if echo "$out" | grep -q "RESTACK_RESOLVED"; then
    if [[ -n "$(git -C "$dir" diff --name-only --diff-filter=U)" ]]; then
      echo "    claude reported resolved but unmerged paths remain — escalating" >&2
      return 1
    fi
    echo "    ✓ claude resolved" >&2
    return 0
  fi

  local reason
  reason=$(echo "$out" | grep -m1 "RESTACK_ESCALATE" | sed 's/.*RESTACK_ESCALATE: *//')
  echo "    ⚑ claude escalated: ${reason:-no clear decision}" >&2
  return 1
}

# ---------- footprint guard ----------
#
# A correct restack only moves a branch's commits onto a new base — it must NEVER
# change WHICH files the branch touches. The dangerous failure mode is a conflict
# auto-resolved by deleting the base's own work (e.g. dropping an upstream-added
# file): the rebased commit then silently REVERTS upstream, and nothing downstream
# notices until a human stares at a node diff full of unrelated deletions.
#
# So after each branch finishes rebasing, compare its file footprint before vs after:
#   before = git diff --name-only OLD_PARENT...ORIG_TIP   (its own changes, pre-restack)
#   after  = git diff --name-only NEW_PARENT...NEW_TIP    (its own changes, post-restack)
# The set may only SHRINK (a commit becoming redundant). If it GREW, the rebase made
# the branch touch files it never owned — almost always reverted upstream work. If a
# file the branch used to ADD vanished from both the branch and the new base, its own
# work was dropped. Either way: don't poison every descendant — escalate.
#
# Catches restack-INTRODUCED corruption (the thing the rebase did wrong). A branch
# that was already corrupt before the restack carries the same footprint in and out,
# so this won't retroactively flag it — fix those by hand.
#
# Returns 0 clean, 1 anomaly (prints offending paths). $1=dir $2=branch $3=parent
# $4=old_parent_sha $5=orig_tip
restack_sanity_check() {
  local dir="$1" branch="$2" parent="$3" old_parent_sha="$4" orig_tip="$5"
  [[ -z "$old_parent_sha" || -z "$orig_tip" ]] && return 0  # can't compare — don't block
  local f
  local -A before after
  while IFS= read -r f; do [[ -n "$f" ]] && before[$f]=1; done \
    < <(git -C "$dir" diff --name-only "${old_parent_sha}...${orig_tip}" 2>/dev/null)
  while IFS= read -r f; do [[ -n "$f" ]] && after[$f]=1; done \
    < <(git -C "$dir" diff --name-only "${parent}...${branch}" 2>/dev/null)
  # An empty `before` with a non-empty `after` means we couldn't compute the
  # pre-restack footprint (e.g. no merge-base) — bail rather than flag everything.
  (( ${#before[@]} == 0 )) && return 0

  local -a grew dropped
  for f in "${(@k)after}"; do
    [[ -z "${before[$f]:-}" ]] && grew+=("$f")
  done
  for f in "${(@k)before}"; do
    [[ -n "${after[$f]:-}" ]] && continue
    git -C "$dir" cat-file -e "${branch}:${f}" 2>/dev/null && continue  # still on branch
    git -C "$dir" cat-file -e "${parent}:${f}" 2>/dev/null && continue  # landed on base
    dropped+=("$f")
  done

  (( ${#grew[@]} + ${#dropped[@]} == 0 )) && return 0
  echo "    ✗ sanity check failed for ${branch}: the rebase changed its file footprint" >&2
  if (( ${#grew[@]} > 0 )); then
    echo "        now touches files it never owned (likely reverted upstream work):" >&2
    for f in "${(o)grew}"; do echo "          + $f" >&2; done
  fi
  if (( ${#dropped[@]} > 0 )); then
    echo "        lost files it used to add (its own work was dropped):" >&2
    for f in "${(o)dropped}"; do echo "          - $f" >&2; done
  fi
  return 1
}

# Park a footprint-guard failure for a human, mirroring the conflict-escalation flow:
# save state (CURRENT stays set), print how to fix the branch + resume, and exit 1.
# --continue re-runs the guard, so a blind resume won't sneak the corruption through.
# $1=branch $2=dir $3=parent $4=old_parent_sha
escalate_footprint() {
  local branch="$1" dir="$2" parent="$3" old_parent_sha="$4"
  save_state
  cat >&2 <<EOF

Restack halted: ${branch}'s rebased tip changed files it never owned (see ✗ above).
  This is the signature of a conflict auto-resolved by reverting upstream work —
  landing it would corrupt every branch that rebases onto ${branch}. Not marked done.

  Redo this branch's rebase, resolving conflicts by KEEPING the upstream side:
    git -C ${dir} rebase --onto ${parent} ${old_parent_sha} ${branch}
  (or drop the spurious hunks from the current tip). Its diff vs ${parent} should be
  limited to ${branch}'s own files. Then resume (re-checks the footprint first):
    loops stack restack ${PROJECT} --continue
  Or bail out:
    git -C ${dir} rebase --abort 2>/dev/null; loops stack restack ${PROJECT} --abort
EOF
  exit 1
}

# ---------- state file (used by --continue) ----------

save_state() {
  mkdir -p "$STATE_DIR"
  {
    echo "PROJECT=${PROJECT}"
    echo "MAIN_BRANCH=${MAIN_BRANCH}"
    echo "CURRENT=${CURRENT:-}"
    printf "COMPLETED="; for b in "${COMPLETED[@]}"; do printf "%s\n" "$b"; done | tr '\n' ' '; echo
    printf "PENDING="; for b in "${PENDING[@]}"; do printf "%s\n" "$b"; done | tr '\n' ' '; echo
    for key in "${(@k)SNAPSHOT}"; do
      echo "SNAP|${key}|${SNAPSHOT[$key]}"
    done
  } > "$STATE_DIR/state"
}

load_state() {
  [[ ! -f "$STATE_DIR/state" ]] && { echo "no saved state" >&2; return 1; }
  COMPLETED=()
  PENDING=()
  typeset -gA SNAPSHOT
  SNAPSHOT=()
  while IFS= read -r line; do
    case "$line" in
      PROJECT=*) [[ -z "$PROJECT" ]] && PROJECT="${line#PROJECT=}" ;;
      MAIN_BRANCH=*) MAIN_BRANCH="${line#MAIN_BRANCH=}" ;;
      CURRENT=*) CURRENT="${line#CURRENT=}" ;;
      COMPLETED=*) read -rA COMPLETED <<<"${line#COMPLETED=}" ;;
      PENDING=*) read -rA PENDING <<<"${line#PENDING=}" ;;
      SNAP\|*)
        local rest="${line#SNAP|}"
        local k="${rest%|*}"
        local v="${rest##*|}"
        SNAPSHOT[$k]="$v"
        ;;
    esac
  done < "$STATE_DIR/state"
}

clear_state() {
  rm -rf "$STATE_DIR"
}

# ---------- main flows ----------

if [[ "$MODE" == "abort" ]]; then
  clear_state
  echo "Restack state cleared. (Existing rebase, if any, untouched — abort it manually if needed.)"
  exit 0
fi

if [[ "$MODE" == "plan" ]]; then
  echo "Plan for $PROJECT:"
  echo "  Main: $MAIN_BRANCH ($(git rev-parse --short $MAIN_BRANCH))"
  while IFS= read -r b; do
    p=$(git config "stack-branch.${b}.parent" 2>/dev/null || echo "?")
    sha=$(git rev-parse --short "$b" 2>/dev/null || echo "MISSING")
    wt=$(worktree_of "$b")
    printf "  %-45s parent=%-40s sha=%s  wt=%s\n" "$b" "$p" "$sha" "${wt:-<unchecked-out>}"
  done < <(topo_order "$PROJECT")
  exit 0
fi

if [[ "$MODE" == "handoff" ]]; then
  # Human-authorized handoff: a previous run parked on a conflict it wouldn't auto-
  # resolve. Re-run the resolver at the full-judgment bar on the still-paused rebase,
  # then fall through into the normal cascade (the main loop below picks up PENDING).
  load_state || exit 1
  RESOLVE_BAR=full
  if [[ -z "${CURRENT:-}" ]]; then
    echo "Nothing paused to hand off (no CURRENT in saved state). Use --continue." >&2
    exit 1
  fi
  REBASE_DIR=$(rebase_dir_for "$CURRENT")
  PARENT_NAME=$(git config "stack-branch.${CURRENT}.parent" 2>/dev/null || true)
  if ! rebase_in_progress "$REBASE_DIR"; then
    echo "No rebase in progress for ${CURRENT} — it may already be resolved. Resuming cascade." >&2
  fi
  echo "→ Handoff: Claude resolving the paused rebase of ${CURRENT} onto ${PARENT_NAME}…"
  while rebase_in_progress "$REBASE_DIR"; do
    if claude_attempt_resolve "$REBASE_DIR" "$CURRENT" "$PARENT_NAME"; then
      git -C "$REBASE_DIR" -c core.editor=true rebase --continue >/dev/null 2>&1 || true
      continue
    fi
    save_state
    cat >&2 <<EOF

Handoff: Claude couldn't safely resolve ${CURRENT} — genuinely ambiguous, still needs a human.
  Rebase paused in: ${REBASE_DIR}
  Resolve by hand, then resume:
    git -C ${REBASE_DIR} add <resolved-files> && git -C ${REBASE_DIR} rebase --continue
    loops stack restack ${PROJECT} --continue
EOF
    exit 1
  done
  HANDOFF_OLDP="${SNAPSHOT[$PARENT_NAME]:-$(git rev-parse "$PARENT_NAME" 2>/dev/null)}"
  if ! restack_sanity_check "$REBASE_DIR" "$CURRENT" "$PARENT_NAME" "$HANDOFF_OLDP" "${SNAPSHOT[$CURRENT]:-}"; then
    escalate_footprint "$CURRENT" "$REBASE_DIR" "$PARENT_NAME" "$HANDOFF_OLDP"
  fi
  COMPLETED+=("$CURRENT")
  CURRENT=""
  save_state
  echo "    ✓ ${COMPLETED[-1]} resolved + rebased — resuming the cascade"
fi

if [[ "$MODE" == "continue" ]]; then
  load_state || exit 1
  if [[ -n "${CURRENT:-}" ]]; then
    # Verify rebase is finished (no in-progress markers in any worktree we might
    # have used). Cheap heuristic: check the current repo + branch worktree.
    local_wt="$(git rev-parse --show-toplevel)"
    if [[ -d "$local_wt/.git/rebase-merge" ]] || [[ -d "$local_wt/.git/rebase-apply" ]]; then
      echo "Rebase still in progress in $local_wt — finish it first (git rebase --continue)." >&2
      exit 1
    fi
    cur_wt=$(worktree_of "$CURRENT")
    if [[ -n "$cur_wt" ]]; then
      if [[ -d "$cur_wt/.git/rebase-merge" ]] || [[ -d "$cur_wt/.git/rebase-apply" ]]; then
        echo "Rebase still in progress in $cur_wt — finish it first." >&2
        exit 1
      fi
    fi
    # Re-verify the human-finished rebase before accepting it.
    cont_parent=$(git config "stack-branch.${CURRENT}.parent" 2>/dev/null || true)
    cont_oldp="${SNAPSHOT[$cont_parent]:-$(git rev-parse "$cont_parent" 2>/dev/null)}"
    cont_dir=$(rebase_dir_for "$CURRENT")
    if ! restack_sanity_check "$cont_dir" "$CURRENT" "$cont_parent" "$cont_oldp" "${SNAPSHOT[$CURRENT]:-}"; then
      escalate_footprint "$CURRENT" "$cont_dir" "$cont_parent" "$cont_oldp"
    fi
    COMPLETED+=("$CURRENT")
    CURRENT=""
  fi
elif [[ "$MODE" == "start" ]]; then
  if [[ -d "$STATE_DIR" ]]; then
    echo "Restack state already exists at $STATE_DIR. Either:" >&2
    echo "  --continue   to resume" >&2
    echo "  --abort      to discard" >&2
    exit 1
  fi

  # Validate project exists.
  if [[ -z "$(git config --get-all "stack-project.${PROJECT}.branch" 2>/dev/null)" ]]; then
    echo "no such project: $PROJECT" >&2
    exit 1
  fi

  # Fetch + fast-forward main.
  echo "Fetching origin..."
  git fetch --quiet origin "${MAIN_BRANCH}:${MAIN_BRANCH}" 2>&1 \
    || echo "  (couldn't fast-forward ${MAIN_BRANCH} — may be ahead of origin or diverged)"

  # Snapshot every project branch's current SHA.
  typeset -gA SNAPSHOT
  SNAPSHOT=()
  SNAPSHOT[$MAIN_BRANCH]=$(git rev-parse "$MAIN_BRANCH")
  while IFS= read -r b; do
    if ! git rev-parse --verify "refs/heads/${b}" >/dev/null 2>&1; then
      echo "  ! branch $b doesn't exist locally — skipping" >&2
      continue
    fi
    SNAPSHOT[$b]=$(git rev-parse "$b")
  done < <(topo_order "$PROJECT")

  # Build PENDING from topo order, filtering out missing branches.
  PENDING=()
  while IFS= read -r b; do
    [[ -n "${SNAPSHOT[$b]:-}" ]] && PENDING+=("$b")
  done < <(topo_order "$PROJECT")

  COMPLETED=()
  CURRENT=""
fi

# ---------- the rebase loop ----------

while (( ${#PENDING[@]} > 0 )); do
  BRANCH="${PENDING[1]}"
  PENDING=("${PENDING[@]:1}")

  PARENT_NAME=$(git config "stack-branch.${BRANCH}.parent" 2>/dev/null || true)
  if [[ -z "$PARENT_NAME" ]]; then
    # No parent recorded = almost always a root that lost (or never got) its pointer.
    # Default to main, RECORD it (self-heal so the next run is clean), and warn — rather
    # than silently skipping, which strands the branch forever "behind".
    PARENT_NAME="$MAIN_BRANCH"
    echo "  ! $BRANCH has no parent recorded — assuming '$MAIN_BRANCH' (root) and recording it" >&2
    git config "stack-branch.${BRANCH}.parent" "$MAIN_BRANCH"
  fi

  OLD_PARENT_SHA="${SNAPSHOT[$PARENT_NAME]:-}"
  if [[ -z "$OLD_PARENT_SHA" ]]; then
    # Parent wasn't snapshot'd (e.g. main, or a foreign branch). Use current tip.
    OLD_PARENT_SHA=$(git rev-parse "$PARENT_NAME" 2>/dev/null || true)
  fi

  CURRENT="$BRANCH"
  save_state

  echo "→ Rebasing ${BRANCH} onto ${PARENT_NAME}"

  # Kick off the rebase. Don't gate on the pipeline exit code (piping through
  # sed would mask git's status); detect conflicts via the on-disk rebase
  # state in the dir where it actually runs.
  in_branch_place "$BRANCH" rebase --onto "$PARENT_NAME" "$OLD_PARENT_SHA" "$BRANCH" 2>&1 | sed 's/^/    /'
  REBASE_DIR=$(rebase_dir_for "$BRANCH")

  # Resolution loop: a single rebase can stop on multiple commits. Each stop,
  # try claude (conservative); if it resolves, --continue and re-check; if it
  # escalates, pause for a human.
  while rebase_in_progress "$REBASE_DIR"; do
    if claude_attempt_resolve "$REBASE_DIR" "$BRANCH" "$PARENT_NAME"; then
      # Advance past the now-staged commit. core.editor=true avoids opening an
      # editor for the commit message.
      git -C "$REBASE_DIR" -c core.editor=true rebase --continue >/dev/null 2>&1 || true
      continue
    fi

    save_state
    cat >&2 <<EOF

Conflict during restack of ${BRANCH} — needs a human.
  Rebase paused in: ${REBASE_DIR}

  Resolve together (interactive claude in that dir):
    (cd ${REBASE_DIR} && claude "finish resolving this paused rebase of ${BRANCH} onto ${PARENT_NAME}, then run git rebase --continue")

  Or by hand:
    git -C ${REBASE_DIR} add <resolved-files>
    git -C ${REBASE_DIR} rebase --continue
  Then resume the cascade:
    loops stack restack ${PROJECT} --continue

  To bail out instead:
    git -C ${REBASE_DIR} rebase --abort
    loops stack restack ${PROJECT} --abort
EOF
    exit 1
  done

  # The rebase finished — but did it stay within the branch's own footprint?
  if ! restack_sanity_check "$REBASE_DIR" "$BRANCH" "$PARENT_NAME" "$OLD_PARENT_SHA" "${SNAPSHOT[$BRANCH]:-}"; then
    escalate_footprint "$BRANCH" "$REBASE_DIR" "$PARENT_NAME" "$OLD_PARENT_SHA"
  fi

  # Persist the frozen base: the branch now sits on the parent's current tip.
  # Independent ops (stack-squash, the viewer) read this instead of resolving the
  # moving parent name; stack-base recomputes it if ever unset or stale.
  NEW_BASE=$(git rev-parse "$PARENT_NAME" 2>/dev/null || true)
  [[ -n "$NEW_BASE" ]] && git config "stack-branch.${BRANCH}.base" "$NEW_BASE"

  CURRENT=""
  COMPLETED+=("$BRANCH")
  save_state
done

# ---------- post: drop empty branches, rewire children ----------

echo ""
echo "Rebase loop complete. Checking for empty/merged branches..."

typeset -a TO_DROP
for b in "${COMPLETED[@]}"; do
  [[ "$b" == "$MAIN_BRANCH" ]] && continue
  p=$(git config "stack-branch.${b}.parent" 2>/dev/null || true)
  [[ -z "$p" ]] && continue
  # Empty vs parent OR merged into main?
  if [[ -z "$(git log --oneline "${p}..${b}" 2>/dev/null)" ]]; then
    TO_DROP+=("$b")
  elif is_ancestor "$b" "$MAIN_BRANCH"; then
    TO_DROP+=("$b")
  fi
done

# Project members whose branch ref no longer exists — e.g. squash-merged on the
# remote then branch-deleted — are filtered out of the rebase walk above (no ref
# to rebase), so they never enter TO_DROP. Detect them straight from the project
# listing so their stale membership + inbound child links get cleaned up too.
typeset -a ORPHANS
ORPHANS=()
while IFS= read -r m; do
  [[ -z "$m" ]] && continue
  git rev-parse --verify --quiet "refs/heads/${m}" >/dev/null 2>&1 || ORPHANS+=("$m")
done < <(git config --get-all "stack-project.${PROJECT}.branch" 2>/dev/null)

if (( ${#TO_DROP[@]} + ${#ORPHANS[@]} > 0 )); then
  # Orphaned members: rewire any inbound children up to the orphan's nearest live
  # ancestor (or main, never onto another orphan), then strip the orphan's own
  # parent metadata and project membership.
  if (( ${#ORPHANS[@]} > 0 )); then
    echo "Orphaned members (branch ref gone — cleaning stale config):"
    for b in "${ORPHANS[@]}"; do echo "  - $b"; done
    for orphan in "${ORPHANS[@]}"; do
      op=$(git config "stack-branch.${orphan}.parent" 2>/dev/null || echo "$MAIN_BRANCH")
      [[ -z "$op" ]] && op="$MAIN_BRANCH"
      while [[ "$op" != "$MAIN_BRANCH" ]] \
            && ! git rev-parse --verify --quiet "refs/heads/${op}" >/dev/null 2>&1; do
        op=$(git config "stack-branch.${op}.parent" 2>/dev/null || echo "$MAIN_BRANCH")
        [[ -z "$op" ]] && op="$MAIN_BRANCH"
      done
      while IFS=' ' read -r key val; do
        [[ -z "$key" ]] && continue
        child="${key#stack-branch.}"
        child="${child%.parent}"
        if [[ "$val" == "$orphan" ]]; then
          echo "  rewire: $child parent → $op"
          git config "stack-branch.${child}.parent" "$op"
          # Parent changed → drop the stale base so stack-base recomputes it.
          git config --unset "stack-branch.${child}.base" 2>/dev/null || true
        fi
      done < <(git config --get-regexp '^stack-branch\..*\.parent$')
      git config --unset "stack-branch.${orphan}.parent" 2>/dev/null || true
      _purge_member_refs "$orphan"

      typeset -a remaining
      remaining=()
      while IFS= read -r m; do
        [[ -n "$m" ]] && [[ "$m" != "$orphan" ]] && remaining+=("$m")
      done < <(git config --get-all "stack-project.${PROJECT}.branch" 2>/dev/null)
      git config --unset-all "stack-project.${PROJECT}.branch" 2>/dev/null || true
      for m in "${remaining[@]}"; do
        git config --add "stack-project.${PROJECT}.branch" "$m"
      done
    done
  fi

  if (( ${#TO_DROP[@]} > 0 )); then
    echo "Branches to drop (empty or merged):"
    for b in "${TO_DROP[@]}"; do echo "  - $b"; done

    # Rewire children of dropped branches to their dropped parent's parent.
    for dropped in "${TO_DROP[@]}"; do
      dropped_parent=$(git config "stack-branch.${dropped}.parent" 2>/dev/null || echo "$MAIN_BRANCH")
      while IFS=' ' read -r key val; do
        [[ -z "$key" ]] && continue
        child="${key#stack-branch.}"
        child="${child%.parent}"
        if [[ "$val" == "$dropped" ]]; then
          echo "  rewire: $child parent → $dropped_parent"
          git config "stack-branch.${child}.parent" "$dropped_parent"
          # Parent changed → drop the stale base so stack-base recomputes it.
          git config --unset "stack-branch.${child}.base" 2>/dev/null || true
        fi
      done < <(git config --get-regexp '^stack-branch\..*\.parent$')
    done

    # Delete the dropped branches + their stack-branch.<x>.parent entries +
    # remove from project listing.
    for b in "${TO_DROP[@]}"; do
      wt=$(worktree_of "$b")
      if [[ -n "$wt" ]]; then
        echo "  (warning: $b is checked out in $wt — leaving the worktree alone, but the branch ref will be deleted)" >&2
        git -C "$wt" checkout --detach HEAD >/dev/null 2>&1 || true
      fi
      if ! git branch -D "$b" >/dev/null 2>&1; then
        # A failed delete (usually: still checked out in some worktree, so git refuses)
        # must NOT strip the node's parent/membership. A surviving branch with its
        # parent erased becomes an "amnesiac" member that every future restack silently
        # skips — it just shows "behind" forever. Leave it FULLY intact; a later run
        # reaps it once it's free.
        echo "    ⚠ couldn't delete $b (still checked out?) — left intact (parent + membership kept); re-run restack once it's free" >&2
        continue
      fi
      git config --unset "stack-branch.${b}.parent" 2>/dev/null || true
      git config --unset "stack-branch.${b}.base" 2>/dev/null || true
      _purge_member_refs "$b"

      # Remove from project listing.
      typeset -a remaining
      remaining=()
      while IFS= read -r m; do
        [[ -n "$m" ]] && [[ "$m" != "$b" ]] && remaining+=("$m")
      done < <(git config --get-all "stack-project.${PROJECT}.branch" 2>/dev/null)
      git config --unset-all "stack-project.${PROJECT}.branch" 2>/dev/null || true
      for m in "${remaining[@]}"; do
        git config --add "stack-project.${PROJECT}.branch" "$m"
      done
    done
  fi

  # Safety: a dropped parent's children were rewired up to its parent (often main),
  # becoming new roots. If the seed list was minimal (didn't list them), seed any
  # surviving root that isn't seeded yet — so next time expansion still reaches the
  # whole forest instead of an empty/partial project.
  typeset -A _seeded _dropped
  while IFS= read -r m; do [[ -n "$m" ]] && _seeded[$m]=1; done < <(git config --get-all "stack-project.${PROJECT}.branch" 2>/dev/null)
  for b in "${TO_DROP[@]}"; do _dropped[$b]=1; done
  for b in "${ORPHANS[@]}"; do _dropped[$b]=1; done
  for b in "${COMPLETED[@]}"; do
    [[ "$b" == "$MAIN_BRANCH" || -n "${_dropped[$b]:-}" || -n "${_seeded[$b]:-}" ]] && continue
    pp=$(git config "stack-branch.${b}.parent" 2>/dev/null || echo "$MAIN_BRANCH")
    if [[ "$pp" == "$MAIN_BRANCH" ]]; then
      git config --add "stack-project.${PROJECT}.branch" "$b"
      echo "  re-seed new root: $b"
    fi
  done
fi

# ---------- done ----------

clear_state

echo ""
echo "✓ Restack of ${PROJECT} complete."
echo "  rebased: ${#COMPLETED[@]} branches"
if (( ${#TO_DROP[@]} > 0 )); then
  echo "  dropped: ${#TO_DROP[@]} branches"
fi
if (( ${#ORPHANS[@]} > 0 )); then
  echo "  cleaned orphaned members: ${#ORPHANS[@]}"
fi
