#!/bin/zsh
# Stack Restack - rebase every branch in a stack-project onto fresh origin/main.
#
# Usage: loops stack restack <project>           # start fresh
#        loops stack restack <project> --continue # resume after manual conflict resolve
#        loops stack restack <project> --abort   # discard saved state
#        loops stack restack <project> --plan    # dry-run: show topo order + parent map, no mutations
#
# What it does:
#   1. Fetch origin; fast-forward local main
#   2. Snapshot every project branch's current SHA (so descendants know where to
#      rebase --onto from after their parent moves)
#   3. Topologically rebase bottom-up: roots onto main, then children onto their
#      (now-moved) parents, walking up the tree
#   4. After the walk, detect branches that became empty (no diff vs parent, or
#      ancestor of main) — delete them locally and rewire children's parent
#      metadata to the dropped branch's parent
#   5. Print summary
#
# Conflict handling:
#   When a `git rebase` hits a conflict, the script saves state to
#   .git/stack-restack-state and exits 1 with instructions. You resolve, finish
#   the rebase (`git add`, `git rebase --continue`), then call this script
#   again with --continue and it resumes the topo walk.
#
# Worktree awareness:
#   If a branch is checked out in another worktree, the rebase runs there.
#   Branches not checked out anywhere run in the current repo (HEAD moves to
#   the branch; restored to main at the end).

set -u

MAIN_BRANCH=$(git config stack.main-branch 2>/dev/null || echo "main")
STATE_DIR="$(git rev-parse --git-common-dir)/stack-restack-state"

usage() {
  cat >&2 <<EOF
Usage: loops stack restack <project>
       loops stack restack <project> --continue
       loops stack restack <project> --abort
       loops stack restack <project> --plan
EOF
  exit 2
}

PROJECT=""
MODE="start"
for arg in "$@"; do
  case "$arg" in
    --continue) MODE="continue" ;;
    --abort) MODE="abort" ;;
    --plan) MODE="plan" ;;
    --*) echo "unknown flag: $arg" >&2; usage ;;
    *) [[ -z "$PROJECT" ]] && PROJECT="$arg" ;;
  esac
done

[[ -z "$PROJECT" ]] && usage

# ---------- helpers ----------

# Topologically order the project members so a branch always comes after its parent.
# Outputs one branch per line on stdout.
topo_order() {
  local project="$1"
  local -a members
  while IFS= read -r m; do
    [[ -n "$m" ]] && members+=("$m")
  done < <(git config --get-all "stack-project.${project}.branch" 2>/dev/null)

  local -A is_member
  for m in "${members[@]}"; do is_member[$m]=1; done

  # Kahn-ish: repeatedly emit branches whose parent is already emitted (or not a member).
  local -A emitted
  local progress=1
  while (( progress )); do
    progress=0
    for m in "${members[@]}"; do
      [[ -n "${emitted[$m]:-}" ]] && continue
      local p=$(git config "stack-branch.${m}.parent" 2>/dev/null || true)
      if [[ -z "${is_member[$p]:-}" ]] || [[ -n "${emitted[$p]:-}" ]]; then
        echo "$m"
        emitted[$m]=1
        progress=1
      fi
    done
  done

  # Any unemitted = cycle.
  local cycle=()
  for m in "${members[@]}"; do
    [[ -z "${emitted[$m]:-}" ]] && cycle+=("$m")
  done
  if (( ${#cycle[@]} > 0 )); then
    echo "cycle in stack-branch parents: ${cycle[*]}" >&2
    return 1
  fi
}

worktree_of() {
  local branch="$1"
  git worktree list --porcelain | awk -v b="refs/heads/$branch" '
    $1 == "worktree" { p = $2 }
    $0 == "branch " b { print p; exit }
  '
}

# Run a git command in the right place for a branch. If checked out in another
# worktree, use -C <wt>. Else use current dir, after checking out the branch.
in_branch_place() {
  local branch="$1"; shift
  local wt=$(worktree_of "$branch")
  if [[ -n "$wt" ]]; then
    git -C "$wt" "$@"
  else
    git checkout "$branch" >/dev/null 2>&1 || return $?
    git "$@"
  fi
}

# Is `a` an ancestor of `b`?
is_ancestor() {
  git merge-base --is-ancestor "$1" "$2" 2>/dev/null
}

# ---------- state file (used by --continue) ----------

save_state() {
  mkdir -p "$STATE_DIR"
  {
    echo "PROJECT=${PROJECT}"
    echo "MAIN_BRANCH=${MAIN_BRANCH}"
    echo "CURRENT=${CURRENT:-}"
    printf "COMPLETED="; for b in "${COMPLETED[@]}"; do printf "%s\n" "$b"; done | tr '\n' ' '; echo
    printf "PENDING="; for b in "${PENDING[@]}"; do printf "%s\n" "$b"; done | tr '\n' ' '; echo
    for key in "${(@k)SNAPSHOT}"; do
      echo "SNAP|${key}|${SNAPSHOT[$key]}"
    done
  } > "$STATE_DIR/state"
}

load_state() {
  [[ ! -f "$STATE_DIR/state" ]] && { echo "no saved state" >&2; return 1; }
  COMPLETED=()
  PENDING=()
  typeset -gA SNAPSHOT
  SNAPSHOT=()
  while IFS= read -r line; do
    case "$line" in
      PROJECT=*) [[ -z "$PROJECT" ]] && PROJECT="${line#PROJECT=}" ;;
      MAIN_BRANCH=*) MAIN_BRANCH="${line#MAIN_BRANCH=}" ;;
      CURRENT=*) CURRENT="${line#CURRENT=}" ;;
      COMPLETED=*) read -rA COMPLETED <<<"${line#COMPLETED=}" ;;
      PENDING=*) read -rA PENDING <<<"${line#PENDING=}" ;;
      SNAP\|*)
        local rest="${line#SNAP|}"
        local k="${rest%|*}"
        local v="${rest##*|}"
        SNAPSHOT[$k]="$v"
        ;;
    esac
  done < "$STATE_DIR/state"
}

clear_state() {
  rm -rf "$STATE_DIR"
}

# ---------- main flows ----------

if [[ "$MODE" == "abort" ]]; then
  clear_state
  echo "Restack state cleared. (Existing rebase, if any, untouched — abort it manually if needed.)"
  exit 0
fi

if [[ "$MODE" == "plan" ]]; then
  echo "Plan for $PROJECT:"
  echo "  Main: $MAIN_BRANCH ($(git rev-parse --short $MAIN_BRANCH))"
  while IFS= read -r b; do
    p=$(git config "stack-branch.${b}.parent" 2>/dev/null || echo "?")
    sha=$(git rev-parse --short "$b" 2>/dev/null || echo "MISSING")
    wt=$(worktree_of "$b")
    printf "  %-45s parent=%-40s sha=%s  wt=%s\n" "$b" "$p" "$sha" "${wt:-<unchecked-out>}"
  done < <(topo_order "$PROJECT")
  exit 0
fi

if [[ "$MODE" == "continue" ]]; then
  load_state || exit 1
  if [[ -n "${CURRENT:-}" ]]; then
    # Verify rebase is finished (no in-progress markers in any worktree we might
    # have used). Cheap heuristic: check the current repo + branch worktree.
    local_wt="$(git rev-parse --show-toplevel)"
    if [[ -d "$local_wt/.git/rebase-merge" ]] || [[ -d "$local_wt/.git/rebase-apply" ]]; then
      echo "Rebase still in progress in $local_wt — finish it first (git rebase --continue)." >&2
      exit 1
    fi
    cur_wt=$(worktree_of "$CURRENT")
    if [[ -n "$cur_wt" ]]; then
      if [[ -d "$cur_wt/.git/rebase-merge" ]] || [[ -d "$cur_wt/.git/rebase-apply" ]]; then
        echo "Rebase still in progress in $cur_wt — finish it first." >&2
        exit 1
      fi
    fi
    COMPLETED+=("$CURRENT")
    CURRENT=""
  fi
elif [[ "$MODE" == "start" ]]; then
  if [[ -d "$STATE_DIR" ]]; then
    echo "Restack state already exists at $STATE_DIR. Either:" >&2
    echo "  --continue   to resume" >&2
    echo "  --abort      to discard" >&2
    exit 1
  fi

  # Validate project exists.
  if [[ -z "$(git config --get-all "stack-project.${PROJECT}.branch" 2>/dev/null)" ]]; then
    echo "no such project: $PROJECT" >&2
    exit 1
  fi

  # Fetch + fast-forward main.
  echo "Fetching origin..."
  git fetch --quiet origin "${MAIN_BRANCH}:${MAIN_BRANCH}" 2>&1 \
    || echo "  (couldn't fast-forward ${MAIN_BRANCH} — may be ahead of origin or diverged)"

  # Snapshot every project branch's current SHA.
  typeset -gA SNAPSHOT
  SNAPSHOT=()
  SNAPSHOT[$MAIN_BRANCH]=$(git rev-parse "$MAIN_BRANCH")
  while IFS= read -r b; do
    if ! git rev-parse --verify "refs/heads/${b}" >/dev/null 2>&1; then
      echo "  ! branch $b doesn't exist locally — skipping" >&2
      continue
    fi
    SNAPSHOT[$b]=$(git rev-parse "$b")
  done < <(topo_order "$PROJECT")

  # Build PENDING from topo order, filtering out missing branches.
  PENDING=()
  while IFS= read -r b; do
    [[ -n "${SNAPSHOT[$b]:-}" ]] && PENDING+=("$b")
  done < <(topo_order "$PROJECT")

  COMPLETED=()
  CURRENT=""
fi

# ---------- the rebase loop ----------

while (( ${#PENDING[@]} > 0 )); do
  BRANCH="${PENDING[1]}"
  PENDING=("${PENDING[@]:1}")

  PARENT_NAME=$(git config "stack-branch.${BRANCH}.parent" 2>/dev/null || true)
  if [[ -z "$PARENT_NAME" ]]; then
    echo "  ! $BRANCH has no parent recorded — skipping" >&2
    COMPLETED+=("$BRANCH")
    continue
  fi

  OLD_PARENT_SHA="${SNAPSHOT[$PARENT_NAME]:-}"
  if [[ -z "$OLD_PARENT_SHA" ]]; then
    # Parent wasn't snapshot'd (e.g. main, or a foreign branch). Use current tip.
    OLD_PARENT_SHA=$(git rev-parse "$PARENT_NAME" 2>/dev/null || true)
  fi

  CURRENT="$BRANCH"
  save_state

  echo "→ Rebasing ${BRANCH} onto ${PARENT_NAME}"

  if ! in_branch_place "$BRANCH" rebase --onto "$PARENT_NAME" "$OLD_PARENT_SHA" "$BRANCH" 2>&1 | sed 's/^/    /'; then
    cat >&2 <<EOF

Conflict during restack of ${BRANCH}.

  Resolve the conflict in the worktree where the rebase is paused, then:
    git add <resolved-files>
    git rebase --continue
  Then resume:
    loops stack restack ${PROJECT} --continue

  To bail out instead:
    git rebase --abort
    loops stack restack ${PROJECT} --abort
EOF
    exit 1
  fi

  CURRENT=""
  COMPLETED+=("$BRANCH")
  save_state
done

# ---------- post: drop empty branches, rewire children ----------

echo ""
echo "Rebase loop complete. Checking for empty/merged branches..."

typeset -a TO_DROP
for b in "${COMPLETED[@]}"; do
  [[ "$b" == "$MAIN_BRANCH" ]] && continue
  p=$(git config "stack-branch.${b}.parent" 2>/dev/null || true)
  [[ -z "$p" ]] && continue
  # Empty vs parent OR merged into main?
  if [[ -z "$(git log --oneline "${p}..${b}" 2>/dev/null)" ]]; then
    TO_DROP+=("$b")
  elif is_ancestor "$b" "$MAIN_BRANCH"; then
    TO_DROP+=("$b")
  fi
done

if (( ${#TO_DROP[@]} > 0 )); then
  echo "Branches to drop (empty or merged):"
  for b in "${TO_DROP[@]}"; do echo "  - $b"; done

  # Rewire children of dropped branches to their dropped parent's parent.
  for dropped in "${TO_DROP[@]}"; do
    dropped_parent=$(git config "stack-branch.${dropped}.parent" 2>/dev/null || echo "$MAIN_BRANCH")
    while IFS=' ' read -r key val; do
      [[ -z "$key" ]] && continue
      child="${key#stack-branch.}"
      child="${child%.parent}"
      if [[ "$val" == "$dropped" ]]; then
        echo "  rewire: $child parent → $dropped_parent"
        git config "stack-branch.${child}.parent" "$dropped_parent"
      fi
    done < <(git config --get-regexp '^stack-branch\..*\.parent$')
  done

  # Delete the dropped branches + their stack-branch.<x>.parent entries +
  # remove from project listing.
  for b in "${TO_DROP[@]}"; do
    wt=$(worktree_of "$b")
    if [[ -n "$wt" ]]; then
      echo "  (warning: $b is checked out in $wt — leaving the worktree alone, but the branch ref will be deleted)" >&2
      git -C "$wt" checkout --detach HEAD >/dev/null 2>&1 || true
    fi
    git branch -D "$b" >/dev/null 2>&1 || echo "    (couldn't delete $b)" >&2
    git config --unset "stack-branch.${b}.parent" 2>/dev/null || true

    # Remove from project listing.
    typeset -a remaining
    remaining=()
    while IFS= read -r m; do
      [[ -n "$m" ]] && [[ "$m" != "$b" ]] && remaining+=("$m")
    done < <(git config --get-all "stack-project.${PROJECT}.branch" 2>/dev/null)
    git config --unset-all "stack-project.${PROJECT}.branch" 2>/dev/null || true
    for m in "${remaining[@]}"; do
      git config --add "stack-project.${PROJECT}.branch" "$m"
    done
  done
fi

# ---------- done ----------

clear_state

echo ""
echo "✓ Restack of ${PROJECT} complete."
echo "  rebased: ${#COMPLETED[@]} branches"
if (( ${#TO_DROP[@]} > 0 )); then
  echo "  dropped: ${#TO_DROP[@]} branches"
fi
