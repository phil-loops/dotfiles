#!/usr/bin/env python3
"""show-note "<title>" "<markdown body>" — post a message from this Claude session to Show's Inbox.

Every message is one section of a single deck, ~/.cache/show/inbox.json, newest first and grouped by day; each section
carries its sender as `replyTo`. In Show the sidebar is the message list. ⌘S signs it off (ack). A reply typed under
it goes back to the session that wrote it. Go to session (⌘J) jumps to that session's tmux pane. Run outside a Claude
session, a message has no sender, so no reply or jump.
"""
import fcntl
import json
import os
import subprocess
import sys
import time
from pathlib import Path

INBOX = Path.home() / ".cache/show/inbox.json"
KEEP = 200
SCRIPTS = Path(__file__).resolve().parent


def topic(session):
    if not session:
        return None
    result = subprocess.run([str(SCRIPTS / "claude-say"), "--topic", session], capture_output=True, text=True)
    return result.stdout.strip() or None


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__.strip())
    title, body = sys.argv[1], sys.argv[2]
    session = os.environ.get("CLAUDE_CODE_SESSION_ID", "")[:8] or None
    sender = " · ".join(x for x in [topic(session), session] if x) or "unknown session"
    INBOX.parent.mkdir(parents=True, exist_ok=True)
    with open(INBOX.with_suffix(".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        deck = json.loads(INBOX.read_text()) if INBOX.exists() else {"title": "Inbox", "subtitle": "Messages from Claude sessions", "sections": []}
        deck["workspace"] = "inbox"
        deck["sections"] = [{
            "id": f"msg-{time.strftime('%Y%m%d-%H%M%S')}-{session or 'none'}",
            "group": time.strftime("%a %b %-d"),
            "title": title,
            "tag": f"{sender} · {time.strftime('%H:%M')}",
            "body": body,
            "replyTo": session,
        }] + deck["sections"][:KEEP - 1]
        tmp = INBOX.with_suffix(".tmp")
        tmp.write_text(json.dumps(deck, indent=1, ensure_ascii=False))
        os.replace(tmp, INBOX)
    subprocess.run([str(SCRIPTS / "show"), str(INBOX)], check=True)
    print(INBOX)


if __name__ == "__main__":
    main()
