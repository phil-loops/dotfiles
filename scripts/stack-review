#!/bin/zsh
# Stack Review - opens nvim with diffview for reviewing stacked branches
# Reads parent pointers from stack-branch.<name>.parent

set -e

# Get current branch
BRANCH=$(git branch --show-current 2>/dev/null)
if [[ -z "$BRANCH" ]]; then
  echo "Not in a git repository"
  exit 1
fi

PARENT=$(git config "stack-branch.${BRANCH}.parent" 2>/dev/null)
if [[ -z "$PARENT" ]]; then
  echo "Branch '$BRANCH' has no parent recorded."
  echo "Run: git config stack-branch.$BRANCH.parent <parent-branch>"
  exit 1
fi

# Build the branch chain (walk up to main, then find all descendants)
MAIN_BRANCH=$(git config stack.main-branch 2>/dev/null || echo "main")

# Keep the review base fresh: fast-forward the trunk from origin so the bottom
# branch isn't diffed against a stale local main (best effort; FF-only).
git fetch --quiet origin "${MAIN_BRANCH}:${MAIN_BRANCH}" 2>/dev/null \
  || echo "  (couldn't fast-forward ${MAIN_BRANCH} from origin — review base may be stale)"

typeset -A parents
typeset -A children

while IFS= read -r line; do
  if [[ "$line" =~ 'stack-branch\.(.+)\.parent=(.+)' ]]; then
    parents[${match[1]}]="${match[2]}"
  fi
done < <(git config --local --list 2>/dev/null | grep -E "^stack-branch\..*\.parent=")

# Rebuild children map from final parents map (so legacy/new dedup is reflected)
for branch in "${(@k)parents}"; do
  parent="${parents[$branch]}"
  children[$parent]+="$branch "
done

# Walk up from current branch to main
chain=()
current="$BRANCH"
while [[ -n "$current" ]] && [[ "$current" != "$MAIN_BRANCH" ]]; do
  chain=("$current" "${chain[@]}")
  current="${parents[$current]}"
done
chain=("$MAIN_BRANCH" "${chain[@]}")

# Walk down to find descendants of current branch
find_descendants() {
  local branch="$1"
  for child in ${(s: :)children[$branch]}; do
    chain+=("$child")
    find_descendants "$child"
  done
}
find_descendants "$BRANCH"

# Find current branch index (1-based for lua)
start_idx=1
for i in {1..${#chain[@]}}; do
  if [[ "${chain[$i]}" = "$BRANCH" ]]; then
    start_idx=$i
    break
  fi
done

# Build chain as lua table string
lua_chain="{"
for i in {1..${#chain[@]}}; do
  branch="${chain[$i]}"
  if [[ $i -eq 1 ]]; then
    p=""
  else
    p="${chain[$((i-1))]}"
  fi
  [[ $i -gt 1 ]] && lua_chain+=","
  lua_chain+="{branch=\"$branch\",parent=\"$p\"}"
done
lua_chain+="}"

# Launch nvim with DiffviewOpen, then setup stack-review module
nvim -c "DiffviewOpen ${PARENT}..${BRANCH}" \
     -c "lua require('custom.stack-review').setup({chain=${lua_chain},start_idx=${start_idx}})"
