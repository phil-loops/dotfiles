#!/bin/zsh
# Stack Review - opens nvim with diffview for reviewing stacked branches
# Reads parent pointers from stack-branch.<name>.parent
# Usage: loops stack review [<branch>|<project>] [--html|-H]

set -e

HTML=0
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --html|-H) HTML=1 ;;
    *) ARGS+=("$arg") ;;
  esac
done
set -- "${ARGS[@]}"

# Branch to review: explicit arg, else current branch.
TARGET="${1:-$(git branch --show-current 2>/dev/null)}"
if [[ -z "$TARGET" ]]; then
  echo "No branch given and no current branch (detached HEAD?)"
  echo "Usage: loops stack review [<branch>|<project>]"
  exit 1
fi

# If TARGET names a registered stack-project, we load ALL its branches into the
# panel (tree view). Otherwise treat it as a single branch and walk its
# ancestors+descendants. PROJECT_MODE controls which.
typeset -a project_members
while IFS= read -r member; do
  [[ -n "$member" ]] && project_members+=("$member")
done < <(git config --get-all "stack-project.${TARGET}.branch" 2>/dev/null || true)

PROJECT_MODE=0
if (( ${#project_members[@]} > 0 )); then
  PROJECT_MODE=1
  PROJECT_NAME="$TARGET"
  # BRANCH is just used for the initial DiffviewOpen and start_idx; the panel
  # will list every project member. Pick the first member with a parent
  # (i.e. the first non-root) so we open on something reviewable.
  BRANCH=""
  for m in "${project_members[@]}"; do
    p=$(git config "stack-branch.${m}.parent" 2>/dev/null || true)
    if [[ -n "$p" ]]; then BRANCH="$m"; break; fi
  done
  [[ -z "$BRANCH" ]] && BRANCH="${project_members[1]}"
else
  BRANCH="$TARGET"
fi

if ! git rev-parse --verify "refs/heads/${BRANCH}" >/dev/null 2>&1; then
  echo "Branch '${BRANCH}' does not exist"
  exit 1
fi

PARENT=$(git config "stack-branch.${BRANCH}.parent" 2>/dev/null)
if [[ -z "$PARENT" ]]; then
  echo "Branch '$BRANCH' has no parent recorded."
  echo "Run: git config stack-branch.$BRANCH.parent <parent-branch>"
  exit 1
fi

# Build the branch chain (walk up to main, then find all descendants)
MAIN_BRANCH=$(git config stack.main-branch 2>/dev/null || echo "main")

# Keep the review base fresh: fast-forward the trunk from origin so the bottom
# branch isn't diffed against a stale local main (best effort; FF-only).
git fetch --quiet origin "${MAIN_BRANCH}:${MAIN_BRANCH}" 2>/dev/null \
  || echo "  (couldn't fast-forward ${MAIN_BRANCH} from origin — review base may be stale)"

typeset -A parents
typeset -A children

while IFS= read -r line; do
  if [[ "$line" =~ 'stack-branch\.(.+)\.parent=(.+)' ]]; then
    parents[${match[1]}]="${match[2]}"
  fi
done < <(git config --local --list 2>/dev/null | grep -E "^stack-branch\..*\.parent=")

# Rebuild children map from final parents map (so legacy/new dedup is reflected)
for branch in "${(@k)parents}"; do
  parent="${parents[$branch]}"
  children[$parent]+="$branch "
done

# Build the ordered chain. Two modes:
#   PROJECT_MODE=1: include every project member, DFS topologically from project
#     roots; depth tracked per branch.
#   single-branch:  walk up to main from BRANCH, then DFS descendants (just that
#     subtree); depth tracked too.
chain=()
typeset -A depth_of

if (( PROJECT_MODE )); then
  # Determine which members are "project roots" (parent not in project set).
  typeset -A is_member
  for m in "${project_members[@]}"; do is_member[$m]=1; done

  typeset -a project_roots
  for m in "${project_members[@]}"; do
    p="${parents[$m]:-}"
    [[ -z "${is_member[$p]:-}" ]] && project_roots+=("$m")
  done

  # Start the chain with MAIN_BRANCH at depth 0 (read-only base).
  chain+=("$MAIN_BRANCH"); depth_of[$MAIN_BRANCH]=0

  # DFS visit, in `git config --get-all` order (preserves user's intent).
  visit() {
    local b="$1" d="$2"
    chain+=("$b"); depth_of[$b]=$d
    for child in ${(s: :)children[$b]}; do
      [[ -n "${is_member[$child]:-}" ]] && visit "$child" $((d + 1))
    done
  }
  for r in "${project_roots[@]}"; do
    visit "$r" 1
  done
else
  # Single-branch mode: walk up to main.
  ancestors=()
  current="$BRANCH"
  while [[ -n "$current" ]] && [[ "$current" != "$MAIN_BRANCH" ]]; do
    ancestors=("$current" "${ancestors[@]}")
    current="${parents[$current]:-}"
  done
  chain+=("$MAIN_BRANCH"); depth_of[$MAIN_BRANCH]=0
  d=1
  for a in "${ancestors[@]}"; do
    chain+=("$a"); depth_of[$a]=$d
    d=$((d + 1))
  done
  # Plus descendants of BRANCH.
  d_descend=${depth_of[$BRANCH]}
  find_descendants() {
    local b="$1" d="$2"
    for child in ${(s: :)children[$b]}; do
      chain+=("$child"); depth_of[$child]=$d
      find_descendants "$child" $((d + 1))
    done
  }
  find_descendants "$BRANCH" $((d_descend + 1))
fi

# Find start_idx (1-based for lua) — first non-root member in project mode,
# else BRANCH.
start_idx=1
for i in {1..${#chain[@]}}; do
  if [[ "${chain[$i]}" = "$BRANCH" ]]; then
    start_idx=$i
    break
  fi
done

# In project mode, identify leaves (members with no project-member child) and
# flag them for the panel — they get a → arrow showing the virtual edge to the
# feature node, which is appended below as a virtual entry.
typeset -A is_leaf
if (( PROJECT_MODE )); then
  for m in "${project_members[@]}"; do
    has_child=0
    for other in "${project_members[@]}"; do
      [[ "$other" == "$m" ]] && continue
      op="${parents[$other]:-}"
      if [[ "$op" == "$m" ]]; then has_child=1; break; fi
    done
    (( has_child == 0 )) && is_leaf[$m]=1
  done
fi

# Build lua chain: use REAL parents from stack-branch.<x>.parent, never array
# position (which lies on non-linear stacks).
lua_chain="{"
for i in {1..${#chain[@]}}; do
  branch="${chain[$i]}"
  if [[ "$branch" = "$MAIN_BRANCH" ]]; then
    p=""
  else
    p="${parents[$branch]:-}"
  fi
  d="${depth_of[$branch]:-0}"
  leaf_flag="false"
  [[ -n "${is_leaf[$branch]:-}" ]] && leaf_flag="true"
  [[ $i -gt 1 ]] && lua_chain+=","
  lua_chain+="{branch=\"$branch\",parent=\"$p\",depth=${d},is_leaf=${leaf_flag}}"
done

# Append virtual feature node in project mode.
if (( PROJECT_MODE )); then
  feature_label="[${PROJECT_NAME} — integrated]"
  lua_chain+=",{branch=\"${feature_label}\",parent=\"${MAIN_BRANCH}\",depth=0,is_feature=true,project_name=\"${PROJECT_NAME}\"}"
fi

lua_chain+="}"

if (( HTML )); then
  files=()
  tabs_html=""
  target_src=""
  for i in {2..${#chain[@]}}; do
    parent="${chain[$((i-1))]}"
    child="${chain[$i]}"
    slug="${child//\//-}"
    patch="/tmp/stack-review-${i}-${slug}.patch"
    html_file="/tmp/stack-review-${i}-${slug}.html"
    git diff "${parent}...${child}" > "$patch"
    npx --yes diff2html-cli -i file -s side -F "$html_file" -- "$patch" >/dev/null
    files+=("$html_file")
    basename_file="stack-review-${i}-${slug}.html"
    active_class=""
    if [[ "$child" = "$BRANCH" ]]; then
      active_class=" active"
      target_src="$basename_file"
    fi
    tabs_html+="<button class=\"tab${active_class}\" data-src=\"${basename_file}\">${child}</button>"
    echo "→ ${parent} → ${child}: $html_file"
  done
  if [[ ${#files[@]} -gt 0 ]]; then
    [[ -z "$target_src" ]] && target_src="$(basename ${files[1]})"
    index_file="/tmp/stack-review-index.html"
    cat > "$index_file" <<EOF
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Stack review: ${BRANCH}</title>
  <style>
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, sans-serif; background: #1a1a1a; }
    .tabs { display: flex; background: #1a1a1a; border-bottom: 1px solid #333; overflow-x: auto; }
    .tab { padding: 12px 18px; cursor: pointer; color: #aaa; border: none; background: none; font-size: 13px; white-space: nowrap; font-family: inherit; }
    .tab:hover { color: #fff; background: #2a2a2a; }
    .tab.active { color: #fff; background: #2a2a2a; border-bottom: 2px solid #4a9eff; }
    iframe { width: 100%; height: calc(100vh - 45px); border: none; display: block; background: #fff; }
  </style>
</head>
<body>
  <div class="tabs">${tabs_html}</div>
  <iframe id="content" src="${target_src}"></iframe>
  <script>
    document.querySelectorAll('.tab').forEach(function(t) {
      t.onclick = function() {
        document.querySelectorAll('.tab').forEach(function(x) { x.classList.remove('active'); });
        t.classList.add('active');
        document.getElementById('content').src = t.dataset.src;
      };
    });
  </script>
</body>
</html>
EOF
    open "$index_file"
  fi
  exit 0
fi

# Launch nvim with DiffviewOpen, then setup stack-review module
nvim -c "DiffviewOpen ${PARENT}...${BRANCH}" \
     -c "lua require('custom.stack-review').setup({chain=${lua_chain},start_idx=${start_idx}})"
