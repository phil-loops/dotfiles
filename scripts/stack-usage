#!/usr/bin/env python3
# stack-usage — digest the local usage log (.git/stack-usage.jsonl) the viewer + git hooks
# write. Read-only, single-user, never leaves the machine. Surfaces workflow friction:
# where you spend nav time, what you search for but can't find (cmd_miss), which actions you
# actually use, and your commit→squash→push shape (local WIP vs what reaches GitHub).
#
#   stack-usage            digest the current repo's log
#   stack-usage --raw      dump the raw JSONL
import sys, os, json, subprocess
from collections import Counter


def git(*a):
    return subprocess.run(["git", *a], capture_output=True, text=True).stdout.strip()


def log_path():
    gd = git("rev-parse", "--git-common-dir")
    if gd and not os.path.isabs(gd):
        top = git("rev-parse", "--show-toplevel")
        gd = os.path.join(top, gd) if top else gd
    return os.path.join(gd, "stack-usage.jsonl") if gd else ""


def load(path):
    out = []
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        out.append(json.loads(line))
                    except ValueError:
                        pass
    except FileNotFoundError:
        pass
    return out


def top(counter, n, indent="    "):
    for k, c in counter.most_common(n):
        print(f"{indent}{c:>4}  {k}")


def main():
    path = log_path()
    if not path:
        print("not in a git repo")
        return
    if "--raw" in sys.argv:
        try:
            with open(path) as f:
                sys.stdout.write(f.read())
        except FileNotFoundError:
            print("(no usage log yet)")
        return

    ev = load(path)
    if not ev:
        print(f"(no events yet — {path})")
        return

    span = ev[-1].get("ts", 0) - ev[0].get("ts", 0)
    days = max(1, span // 86400)
    print(f"{len(ev)} events over ~{days}d  ({path})\n")

    kinds = Counter(e.get("type") for e in ev)
    print("by type:")
    top(kinds, 20)

    navs = [e for e in ev if e.get("type") == "nav"]
    if navs:
        print("\nmost-visited forests:")
        top(Counter(e["project"] for e in navs if e.get("project")), 10)
        print("\nmost-visited nodes:")
        top(Counter(e["node"] for e in navs if e.get("node")), 10)
        # bounce: a forest/node opened then left in <8s
        bounces = 0
        for a, b in zip(navs, navs[1:]):
            if a.get("ts") and b.get("ts") and b["ts"] - a["ts"] < 8 and a.get("node"):
                bounces += 1
        print(f"\nquick bounces (<8s on a node): {bounces}")

    misses = [e.get("q", "") for e in ev if e.get("type") == "cmd_miss"]
    if misses:
        print("\nzero-result searches (wanted, not found):")
        top(Counter(m for m in misses if m), 15)

    actions = [e.get("url") for e in ev if e.get("type") == "action"]
    if actions:
        print("\nactions used:")
        top(Counter(a for a in actions if a), 20)

    commits = [e for e in ev if e.get("type") == "commit"]
    pushes = [e for e in ev if e.get("type") == "push"]
    if commits or pushes:
        print("\ncommit / push workflow:")
        if commits:
            short = sum(1 for c in commits if (c.get("subjectLen") or 0) <= 50 and (c.get("bodyLines") or 0) == 0)
            print(f"    {len(commits)} commits · {short} single-line ≤50ch (your 'simple message' shape)")
        if pushes:
            aheads = [p.get("ahead") for p in pushes if isinstance(p.get("ahead"), int)]
            if aheads:
                squashed = sum(1 for a in aheads if a == 1)
                avg = sum(aheads) / len(aheads)
                print(f"    {len(pushes)} pushes · {squashed} sent as 1 commit · avg {avg:.1f} commits ahead of main")
                print(f"    (>1 ahead = local WIP not squashed before it reached GitHub)")


if __name__ == "__main__":
    main()
