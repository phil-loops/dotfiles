+            g["working"] = g["working"] or r["working"]
+            if r["active_at"] > g["active_at"]:
+                g["active_at"], g["age"], g["idle_age"], g["etime"] = r["active_at"], r["age"], r["idle_age"], r["etime"]
+    return list(grouped.values())
