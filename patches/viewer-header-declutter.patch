--- a/scripts/viewer-solid/src/index.css
+++ b/scripts/viewer-solid/src/index.css
@@ -104,13 +104,58 @@ body {
 
 /* ── review surface ─────────────────────────────────────────────────── */
 .surface { padding: 30px 34px 90px; max-width: 1120px; }
-.node-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 24px; }
+/* two tiers: an identity line, then a quiet controls bar under a hairline. Splitting them
+   stops a long branch name from wrapping into the toolbar and gives the actions room. */
+.node-head { display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; }
 .node-head h1 {
   font-family: var(--display); font-style: italic; font-weight: 600;
   font-size: 32px; margin: 0; color: var(--ink); letter-spacing: -0.01em;
 }
-.against { color: var(--ink-faint); font-size: 13px; }
+.nh-id { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
+.nh-bar { display: flex; align-items: center; gap: 16px; padding-top: 11px; border-top: 1px solid var(--rule); }
+.nh-spacer { flex: 1; }
+.diff-hint { display: flex; justify-content: flex-end; margin: -8px 0 16px; }
+.against { color: var(--ink-faint); font-size: 13px; flex: none; }
 .meta { margin-left: auto; color: var(--ink-dim); font-size: 11px; letter-spacing: 0.06em; }
+
+/* ── branch state badge + ⋯ actions menu (NodeActions) ───────────────── */
+.node-actions { position: relative; display: flex; align-items: center; gap: 9px; }
+.nh-behind { font-size: 12px; color: var(--patina); opacity: 0.9; }
+.nh-blocked { font-size: 12px; color: var(--del); font-weight: 600; cursor: help; }
+.nh-fix {
+  font: inherit; font-size: 12px; color: var(--del); background: transparent;
+  border: 1px solid var(--del); border-radius: 5px; padding: 3px 9px; cursor: pointer; opacity: 0.9;
+}
+.nh-fix:hover:not(:disabled) { opacity: 1; }
+.nh-fix:disabled { opacity: 0.5; cursor: default; }
+.nh-done {
+  font-size: 12px; color: var(--patina); opacity: 0.9;
+  max-width: 22ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
+}
+/* ghost icon button — chat (✦) and the ⋯ trigger; quiet until hovered/open */
+.icon-btn {
+  font: inherit; font-size: 15px; line-height: 1; color: var(--ink-faint);
+  background: transparent; border: 1px solid transparent; border-radius: 6px;
+  padding: 4px 9px; cursor: pointer;
+}
+.icon-btn:hover, .icon-btn.on { color: var(--ink); border-color: var(--rule); background: var(--vellum-edge); }
+.nh-menu {
+  position: absolute; top: calc(100% + 7px); right: 0; z-index: 20;
+  min-width: 196px; display: flex; flex-direction: column; gap: 2px;
+  background: var(--vellum-raise); border: 1px solid var(--rule); border-radius: 9px;
+  padding: 6px; box-shadow: 0 12px 34px -14px rgba(0, 0, 0, 0.75);
+}
+.nh-item {
+  display: flex; align-items: center; gap: 10px; width: 100%; text-align: left;
+  font: inherit; font-size: 12px; color: var(--patina);
+  background: transparent; border: 1px solid transparent; border-radius: 6px;
+  padding: 7px 10px; cursor: pointer;
+}
+.nh-item:hover:not(:disabled) { background: var(--vellum-edge); border-color: var(--patina); }
+.nh-item:disabled { opacity: 0.45; cursor: default; }
+.nh-item.armed { color: var(--del); border-color: var(--del); }
+.nh-item-ic { width: 14px; flex: none; text-align: center; opacity: 0.85; }
+.nh-item-note { font-size: 11px; color: var(--ink-faint); padding: 4px 10px 2px; }
 .loading, .empty { color: var(--ink-faint); padding: 14px 4px; font-style: italic; }
 
 /* a file is a ledger entry; blessed ones illuminate from the gutter */
@@ -251,7 +296,7 @@ body {
