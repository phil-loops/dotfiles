     # later never rebased onto main (its descendants rebase onto it instead). Everything else sits on
     # origin/main. This is the ONE seam so trunk overrides main in a single place, not scattered.
-    if _is_trunk(branch):
+    if branch in trunks:
         return branch
     return "origin/main"
 
