diff --git a/.zshrc b/.zshrc
index 8081e7f..09717df 100644
--- a/.zshrc
+++ b/.zshrc
@@ -74,7 +74,7 @@ loops() {
                     # we're not on a stack at all (e.g. main) do we fzf-pick.
