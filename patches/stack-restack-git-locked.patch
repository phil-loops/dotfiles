--- a/scripts/stack-restack
+++ b/scripts/stack-restack
@@ -154,16 +154,36 @@ worktree_of() {
   '
 }
 
+# Run `git "$@"`, retrying briefly on a transient `.git/index.lock` loss. We mutate
+# in whatever worktree a branch lives in — often the MAIN checkout, whose index is
+# shared with anything else watching it (GitHub Desktop polling `git status` holds
+# the lock ~100ms). A rebase / update-index / checkout that reaches for the lock
+# mid-poll would otherwise fail — and here those failures are mostly swallowed
+# (`|| true`, exit code ignored), so a lost lock silently SKIPS the step. Retried
+# only on the lock's stderr signature; any other failure returns its real exit code
+# at once. Combined output is re-emitted on stdout so each caller's own redirection
+# (`2>&1 | sed`, `>/dev/null 2>&1`) still applies.
+git_locked() {
+  local attempt out rc
+  for attempt in 1 2 3 4 5; do   # 0.15+0.30+0.45+0.60+0.75 ≈ 2.25s of patience, max
+    out=$(git "$@" 2>&1); rc=$?
+    [[ -n "$out" ]] && print -r -- "$out"
+    [[ $rc -eq 0 || "$out" != *index.lock*"File exists"* ]] && return $rc
+    sleep 0.$(( attempt * 15 ))
+  done
+  return $rc
+}
+
 # Run a git command in the right place for a branch. If checked out in another
 # worktree, use -C <wt>. Else use current dir, after checking out the branch.
 in_branch_place() {
   local branch="$1"; shift
   local wt=$(worktree_of "$branch")
   if [[ -n "$wt" ]]; then
-    git -C "$wt" "$@"
+    git_locked -C "$wt" "$@"
   else
-    git checkout "$branch" >/dev/null 2>&1 || return $?
-    git "$@"
+    git_locked checkout "$branch" >/dev/null 2>&1 || return $?
+    git_locked "$@"
   fi
 }
 
