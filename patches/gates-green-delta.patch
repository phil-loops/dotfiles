+# The verdict also seals the DELTA (gates-green-delta): a forward rebase or catch-up merge
+# moves the tree while the branch's own hunks stay byte-identical, and re-paying a typecheck
+# for that relocked push on every main merge (2026-09-14). Recorded only when the verdict is
+# for the current tip — a harvested older tree gets no delta.
+def _green_delta(branch):
+    return repostate.snapshot().branch_key(branch, "gates-green-delta")
+
+
 def _record_green(branch, tree):
     stackcfg.set_key(branch, "gates-green-tree", tree)
+    if tree == _tree(branch):
+        stackcfg.set_key(branch, "gates-green-delta", _delta_id(branch))
+
+
+_HUNK_HEADER = re.compile(r"^@@ -\d+(?:,\d+)? \+\d+(?:,\d+)? @@", re.MULTILINE)
+
+
+def _delta_id(branch):
+    """sha256 of the branch's own diff against its stack base (parent, else origin/main) with
+    index lines and hunk offsets stripped — git patch-id's idea, computed here so it needs no
+    stdin pipe. Context lines stay in: main landing INSIDE a hunk's context changes the id,
+    which is exactly when a carried verdict should lapse."""
+    snap = repostate.snapshot()
+    base = snap.parent(branch)
+    if base == snap.main() and snap.remote(base):
+        base = f"origin/{base}"
+
+    def compute():
+        diff = ctx.run(["git", "diff", "--no-color", f"{base}...{branch}"]).stdout
+        kept = [ln for ln in diff.splitlines() if not ln.startswith("index ")]
+        return hashlib.sha256(_HUNK_HEADER.sub("@@", "\n".join(kept)).encode("utf-8", "replace")).hexdigest()
+
+    return snap.once(("delta-id", branch, snap.local(branch), base), compute)
+
+
+def _verdict_stands(branch):
+    """How the gates verdict for <branch> holds: "tree" when the recorded tree is the tip's,
+    "delta" when the tip moved but its own hunks did not (forward rebase, catch-up merge),
+    "" when it lapsed."""
+    snap = repostate.snapshot()
+    tip = snap.local(branch)
+    if not tip:
+        return ""
+    green = _green_tree(branch)
+    if green and green == snap.tree(tip):
+        return "tree"
+    delta = _green_delta(branch)
+    if delta and delta == _delta_id(branch):
+        return "delta"
+    return ""
 
 
