+# Run a command with a hard wall-clock cap (macOS has no timeout(1)) and stdin
+# detached from /dev/null, so a hung resolver can never block the driver forever.
+# Combined output → stdout; returns the command's status, or 124 if the cap fired
+# (the command, and its grace-period KILL, are guaranteed dead before we return).
+run_bounded() {
+  local secs="$1"; shift
+  local tmp fired; tmp="$(mktemp)"; fired="$tmp.timedout"
+  "$@" </dev/null >"$tmp" 2>&1 &
+  local cmdpid=$!
+  ( sleep "$secs"; : >"$fired"; kill -TERM "$cmdpid" 2>/dev/null
+    sleep 3; kill -KILL "$cmdpid" 2>/dev/null ) &
+  local watch=$!
+  wait "$cmdpid" 2>/dev/null; local rc=$?
+  kill "$watch" 2>/dev/null; wait "$watch" 2>/dev/null
+  local timed_out=0; [[ -e "$fired" ]] && timed_out=1
+  cat "$tmp"; rm -f "$tmp" "$fired"
+  (( timed_out )) && return 124
+  return $rc
+}
