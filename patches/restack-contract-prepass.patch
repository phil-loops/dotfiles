+
+  # ---------- pre-pass: contract already-merged branches ----------
+  # A squash-merged branch's files are already in its parent but its history diverged,
+  # so it's neither empty-vs-parent nor an ancestor of main — the post-walk drop check
+  # misses it, and rebasing it replays commits that conflict with their own landed work.
+  # rebase-classify catches it (VERDICT=already-merged → exit 20). Contract it up front:
+  # rewire its inbound children onto its parent (so the walk rebases them onto a live
+  # base) and queue it for the same drop machinery the empty-branch pass uses. The probe
+  # is read-only (scratch worktree); the branch ref never moves until the drop step.
+  if (( USE_CLASSIFY )) && [[ -x "${SELF_DIR}/rebase-classify" ]]; then
+    typeset -a _survivors
+    _survivors=()
+    for b in "${PENDING[@]}"; do
+      bp=$(git config "stack-branch.${b}.parent" 2>/dev/null || echo "$MAIN_BRANCH")
+      [[ -z "$bp" ]] && bp="$MAIN_BRANCH"
+      "${SELF_DIR}/rebase-classify" "$b" "$bp" >/dev/null 2>&1 && _crc=0 || _crc=$?
+      if (( _crc == 20 )); then
+        echo "  ● $b already merged into $bp — contracting (drop + rewire), skipping rebase"
+        while IFS=' ' read -r key val; do
+          [[ -z "$key" ]] && continue
+          child="${key#stack-branch.}"; child="${child%.parent}"
+          if [[ "$val" == "$b" ]]; then
+            echo "    rewire: $child parent → $bp"
+            git config "stack-branch.${child}.parent" "$bp"
+            git config --unset "stack-branch.${child}.base" 2>/dev/null || true
+          fi
+        done < <(git config --get-regexp '^stack-branch\..*\.parent$')
+        CONTRACTED+=("$b")
+      else
+        _survivors+=("$b")
+      fi
+    done
+    PENDING=("${_survivors[@]}")
+  fi
 fi
 
