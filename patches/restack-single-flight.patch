diff --git a/scripts/stack-restack b/scripts/stack-restack
index c247627..1c3ffee 100755
--- a/scripts/stack-restack
+++ b/scripts/stack-restack
@@ -108,6 +108,16 @@ done
 LOCK_HELD=""
 acquire_lock() {
   local label="$1"
+  # Reentrant under a batch driver (stack-restack-all holds one lock for the whole
+  # run and exports its pid): operate under the ancestor's lock — don't take or
+  # release our own, so a parked child handing off mid-batch can't drop it.
+  if [[ -n "${STACK_RESTACK_LOCK_OWNER:-}" ]]; then
+    local owner; owner="$(cat "$LOCK_FILE" 2>/dev/null)"
+    if [[ "${owner%% *}" == "$STACK_RESTACK_LOCK_OWNER" ]] && kill -0 "$STACK_RESTACK_LOCK_OWNER" 2>/dev/null; then
+      LOCK_HELD=""
+      return 0
+    fi
+  fi
   while true; do
     if ( set -o noclobber; print -r -- "$$ $label" > "$LOCK_FILE" ) 2>/dev/null; then
       LOCK_HELD="$LOCK_FILE"
@@ -650,7 +660,9 @@ load_state() {
 clear_state() {
   rm -rf "$STATE_DIR"
   rm -f "$CONFLICT_FILE" "$SNAPSHOT_FILE"   # no parked conflict → no diagnosis artifact/snapshot
-  rm -f "$LOCK_FILE"                        # abort is the escape hatch — free a wedged driver's lock
+  # abort frees a wedged STANDALONE driver's lock; under a batch driver (stack-restack-all's
+  # internal abort_park) the batch owns the lock for the rest of the run, so leave it.
+  [[ -z "${STACK_RESTACK_LOCK_OWNER:-}" ]] && rm -f "$LOCK_FILE"
 }
 
 # ---------- main flows ----------
diff --git a/scripts/stack-restack-all b/scripts/stack-restack-all
index d651f64..b0c028e 100755
--- a/scripts/stack-restack-all
+++ b/scripts/stack-restack-all
@@ -16,6 +16,34 @@ GIT_COMMON_DIR=$(git rev-parse --git-common-dir)
 [[ "$GIT_COMMON_DIR" != /* ]] && GIT_COMMON_DIR="$PWD/$GIT_COMMON_DIR"
 STATE="$GIT_COMMON_DIR/stack-restack-state/state"
 
+# Single-flight the WHOLE batch. stack-restack locks per-invocation and releases on
+# every exit (including a park→handoff), so back-to-back children leave gaps a
+# concurrent `stack-restack <project>` can slip into — two drivers, one worktree.
+# Hold ONE lock for the run; children go reentrant via STACK_RESTACK_LOCK_OWNER.
+# Same lockfile stack-restack uses (GIT_COMMON_DIR, shared across linked worktrees).
+LOCK_FILE="$GIT_COMMON_DIR/stack-restack.lock"
+LOCK_HELD=""
+release_batch_lock() {
+  [[ -n "$LOCK_HELD" ]] || return 0
+  local holder; holder="$(cat "$LOCK_HELD" 2>/dev/null)"
+  [[ "${holder%% *}" == "$$" ]] && rm -f "$LOCK_HELD"
+  LOCK_HELD=""
+}
+trap 'release_batch_lock' EXIT INT TERM
+while true; do
+  if ( set -o noclobber; print -r -- "$$ restack-all $*" > "$LOCK_FILE" ) 2>/dev/null; then
+    LOCK_HELD="$LOCK_FILE"; break
+  fi
+  holder="$(cat "$LOCK_FILE" 2>/dev/null)"; holder_pid="${holder%% *}"
+  if [[ -n "$holder_pid" ]] && kill -0 "$holder_pid" 2>/dev/null; then
+    echo "a restack is already running (pid $holder_pid: ${holder#* }) — wait for it, or abort the wedged project if needed." >&2
+    exit 1
+  fi
+  echo "  (clearing stale restack lock from dead pid ${holder_pid:-?})" >&2
+  rm -f "$LOCK_FILE"
+done
+export STACK_RESTACK_LOCK_OWNER=$$
+
 worktree_of() {  # the worktree a branch is checked out in (mirrors stack-restack's helper)
   git worktree list --porcelain | awk -v b="refs/heads/$1" '
     $1 == "worktree" { p = $2 }
