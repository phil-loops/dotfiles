diff --git a/scripts/viewer-solid/src/index.css b/scripts/viewer-solid/src/index.css
index 6c06203..dc0f87e 100644
--- a/scripts/viewer-solid/src/index.css
+++ b/scripts/viewer-solid/src/index.css
@@ -497,6 +497,52 @@ td.d2h-del:not(.d2h-code-side-linenumber) { border-left-color: var(--stripe-del)
 .pr-rev.ok { color: var(--add); }
 .pr-rev.chg { color: var(--del); }
 .pr-rev.req { color: var(--ink-faint); }
+
+/* Work tab — intent sections + the "blessing spine" (a state-coloured rail per row).
+   The rail is the one place colour concentrates; everything else stays warm monochrome. */
+.work-sec { margin-bottom: 30px; }
+.eyebrow-ask {
+  font-family: var(--display); font-style: italic; text-transform: none; letter-spacing: 0;
+  font-size: 14px; color: var(--ink-dim); margin-left: 8px;
+}
+.work-rule { height: 1px; background: var(--rule); margin: 0 0 6px; }
+.work-forest { display: flex; align-items: baseline; gap: 10px; margin: 16px 2px 4px; }
+.work-forest-name {
+  font-family: var(--display); font-style: italic; font-size: 15px; color: var(--ink);
+  text-decoration: none;
+}
+.work-forest-name:hover { color: var(--gold-leaf); }
+.work-verdict {
+  font-size: 10px; letter-spacing: 0.05em; color: var(--state, var(--ink-dim));
+  border: 1px solid var(--state-edge, var(--rule)); border-radius: 6px; padding: 1px 7px;
+}
+.work-meta { color: var(--ink-faint); font-size: 11px; flex: none; }
+
+.work-row {
+  position: relative; display: flex; align-items: center; gap: 14px;
+  padding: 11px 14px 11px 20px; border-radius: 9px; text-decoration: none; color: var(--ink);
+  transition: background 0.12s;
+}
+.work-row::before {
+  content: ""; position: absolute; left: 0; top: 7px; bottom: 7px; width: 4px; border-radius: 2px;
+  background: var(--state, var(--ink-faint)); box-shadow: 0 0 9px -1px var(--state-glow, transparent);
+}
+.work-row:hover { background: var(--vellum-raise); }
+.work-link {
+  display: flex; align-items: center; gap: 14px; flex: 1; min-width: 0;
+  text-decoration: none; color: inherit;
+}
+/* actions recede until the row is hovered — they stop competing with the title down the column */
+.work-acts { flex: none; opacity: 0; transition: opacity 0.12s; }
+.work-row:hover .work-acts, .work-acts:focus-within { opacity: 1; }
+
+.work-state-changes { --state: #e8794a; --state-edge: var(--del); --state-glow: rgba(232,121,74,0.5); }
+.work-state-review  { --state: #f2c258; --state-edge: var(--gold-deep); --state-glow: rgba(242,194,88,0.45); }
+.work-state-pending { --state: #9ec6b6; }
+.work-state-draft   { --state: #9d8d6b; }
+.work-state-landed  { --state: #8fb0a2; opacity: 0.8; }
+.work-row.work-state-landed .pr-title { color: var(--ink-dim); }
+
 .forest-name { font-family: var(--display); font-style: italic; font-size: 17px; flex: 1; }
 .forest-meta { color: var(--ink-faint); font-size: 11px; flex: none; }
 /* a forest with an open PR is badged (not hidden) — understated, never gold (gold is earned) */
