diff --git a/scripts/viewer-solid/src/index.css b/scripts/viewer-solid/src/index.css
index 1a3ceeb..d373d0d 100644
--- a/scripts/viewer-solid/src/index.css
+++ b/scripts/viewer-solid/src/index.css
@@ -281,6 +281,28 @@ body {
 }
 .forest-dot.parked { background: transparent; border: 1.5px solid var(--del); box-shadow: inset 0 0 0 1.5px var(--del); }
 .forest-row.parked { border-color: var(--del); }
+.restack-err { margin-left: auto; color: var(--del); font-size: 11px; letter-spacing: 0.02em; padding-right: 10px; }
+/* a parked branch carries its own contextual menu — one bad branch marks itself, not the whole home */
+.forest-parked { position: relative; flex: none; }
+.forest-resolve.open { background: var(--del); color: #1a1411; }
+.forest-popover {
+  position: absolute; top: calc(100% + 6px); right: 0; z-index: 30; width: 240px;
+  padding: 11px 12px; border-radius: 9px; border: 1px solid var(--del);
+  background: #18120f; box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.6);
+  cursor: default; text-align: left;
+}
+.forest-popover-why { margin: 0 0 8px; font-size: 11px; line-height: 1.45; color: var(--patina); }
+.forest-popover-reason { margin: 0 0 8px; font-size: 10.5px; line-height: 1.4; color: var(--del); opacity: 0.85; }
+.forest-popover-actions { display: flex; flex-direction: column; gap: 6px; }
+.forest-popover-actions button {
+  font: inherit; font-size: 11px; letter-spacing: 0.02em; cursor: pointer; text-align: left;
+  border-radius: 6px; padding: 5px 9px; background: transparent;
+  color: var(--patina); border: 1px solid var(--patina);
+  transition: border-color 0.12s, color 0.12s, background 0.12s;
+}
+.forest-popover-actions button:hover { background: rgba(127, 160, 147, 0.12); }
+.forest-popover-actions button.danger { color: var(--del); border-color: var(--del); }
+.forest-popover-actions button.danger:hover { background: var(--del-bg); }
 
