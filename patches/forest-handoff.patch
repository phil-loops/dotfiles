@@ -107,6 +107,21 @@ def _project_of(branch):
     return None
 
 
+def _handed_off():
+    # Forests flagged "someone else's problem" — they keep all their config but drop out
+    # of the active list and the restack-all count until reclaimed. Presence of a truthy
+    # stack-project.<name>.handedoff key is the flag.
+    out = set()
+    for line in ctx.run(["git", "config", "--get-regexp",
+                         r"^stack-project\..*\.handedoff$"]).stdout.splitlines():
+        k, _, v = line.partition(" ")
+        if v.strip().lower() in ("true", "1", "yes"):
+            m = re.match(r"^stack-project\.(.+)\.handedoff$", k)
+            if m:
+                out.add(m.group(1))
+    return out
+
+
 def _scan_merges():
     # Walk new origin/main commits since the last scan; attribute each squash-merge
     # (subject "… (#N)") to a project via its head branch's project tag, and keep the
@@ -200,12 +215,14 @@ def projects(req):
     with ThreadPoolExecutor(max_workers=8) as ex:
         fresh = dict(zip(roots, ex.map(_root_fresh, roots)))
     merges = _scan_merges()
+    handed = _handed_off()
     for p in projs:
         p["ready"], p["candidates"] = _ready_to_merge(p.get("mergeable", []), prmap)
         bs = p.get("mergeable", [])
         p["behind"] = max((fresh[b][0] for b in bs), default=0)
         p["overlap"] = any(fresh[b][1] for b in bs)
         p["merged"] = merges.get(p["name"])
+        p["handedOff"] = p["name"] in handed
     payload = json.dumps(projs)
     _pcache.clear()
     _pcache[pck] = payload
@@ -361,6 +378,24 @@ def drop_project(req, raw):   # POST /drop-project — forget a forest grouping
     req._send(200, json.dumps({"ok": True, "dropped": project, "untagged": untagged}))
 
 
+def handoff(req, raw):   # POST /handoff — flag a forest "someone else's problem" (reversible)
+    d = json.loads(raw or "{}")
+    project = d.get("project", "").strip()
+    if not project:
+        req._send(400, json.dumps({"ok": False, "err": "no project"}))
+        return
+    key = f"stack-project.{project}.handedoff"
+    if d.get("op") == "reclaim":
+        ctx.run(["git", "config", "--unset", key])   # exit 5 if already absent — harmless
+        req._send(200, json.dumps({"ok": True, "handedOff": False, "project": project}))
+        return
+    if not ctx.run(["git", "config", "--get-all", f"stack-project.{project}.branch"]).stdout.strip():
+        req._send(404, json.dumps({"ok": False, "err": "no such forest"}))
+        return
+    ctx.run(["git", "config", key, "true"])
+    req._send(200, json.dumps({"ok": True, "handedOff": True, "project": project}))
+
+
 def steer(req, raw):   # POST /steer — launch the Steer workspace (headless-claude design convo)
     d = json.loads(raw or "{}")
     args = [os.path.join(ctx.SCRIPTS, "steer-open"), d.get("branch", "")]
