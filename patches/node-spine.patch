@@ -0,0 +1,123 @@
+/* The waymark spine — one chip, one slot. Every color is an existing register, honestly
+   applied: gold is blessed and nothing else; ember is heat before the crossing; sage is
+   work planted in the shared world; patina is finished history. No new tokens. */
+
+.spine-wrap {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.spine-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 9px;
+  padding: 3px 11px 3px 9px;
+  border: 1px solid var(--rule);
+  border-radius: 999px;
+  background: var(--vellum-raise);
+  cursor: default;
+}
+
+.spine-path {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  font-size: 10px;
+  line-height: 1;
+}
+
+/* the path at rest: faint marks, a journey drawn in pencil */
+.spine-mark {
+  color: var(--ink-faint);
+  transition: color 160ms ease, text-shadow 160ms ease;
+}
+.spine-mark.past {
+  color: var(--ink-dim);
+}
+
+/* each station lights in its own material — only when the branch stands there */
+.spine-mark.here.m-edit {
+  color: var(--ink);
+}
+.spine-mark.here.m-review {
+  color: var(--ink);
+}
+.spine-mark.here.m-ready {
+  color: var(--ember);
+  text-shadow: 0 0 7px var(--ember-wash);
+}
+.spine-mark.here.m-shared {
+  color: var(--add);
+}
+.spine-mark.here.m-merged {
+  color: var(--patina);
+}
+/* gold is earned, not positional: the review mark gilds only at every-file-blessed,
+   whether the branch stands there or has moved on */
+.spine-mark.lit.m-review {
+  color: var(--gold-leaf);
+  text-shadow: 0 0 8px var(--gold-wash);
+}
+
+/* the station word — one word of ritual type in the mono chrome */
+.spine-word {
+  font-family: "Fraunces", Georgia, serif;
+  font-style: italic;
+  font-size: 12.5px;
+  letter-spacing: 0.02em;
+  color: var(--ink);
+}
+.spine-chip.at-merged .spine-word {
+  color: var(--ink-dim);
+  text-decoration: line-through;
+  text-decoration-color: var(--patina);
+}
+.spine-chip.at-shared .spine-word {
+  color: var(--add);
+}
+
+/* the slot — the one next step. Absent when there is none: an idle branch shows a chip
+   and silence, never a disabled door. */
+.spine-slot {
+  font: inherit;
+  font-size: 12px;
+  padding: 3px 12px;
+  border: 1px solid var(--rule);
+  border-radius: 999px;
+  background: transparent;
+  color: var(--ink);
+  cursor: pointer;
+  transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
+}
+.spine-slot:hover {
+  border-color: var(--ink-dim);
+}
+.spine-slot:focus-visible {
+  outline: 2px solid var(--ember);
+  outline-offset: 2px;
+}
+.spine-slot.pending {
+  color: var(--ink-dim);
+  cursor: progress;
+}
+
+/* the crossing gets the heat: push is the only warm door in the header */
+.spine-slot.slot-push {
+  border-color: var(--ember);
+  color: var(--ember);
+}
+.spine-slot.slot-push:hover,
+.spine-slot.slot-push.armed {
+  background: var(--ember-wash);
+}
+.spine-slot.slot-push.armed {
+  color: var(--ink);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .spine-mark,
+  .spine-slot {
+    transition: none;
+  }
+}
