diff --git a/scripts/stack-open b/scripts/stack-open
index 57a2394..a3c8385 100755
--- a/scripts/stack-open
+++ b/scripts/stack-open
@@ -105,6 +105,17 @@ in_use(){   # is <dir>, or anything under it, some live process's cwd?
   return 1
 }
 idle_dirs(){ find "$SCRATCH" -maxdepth 1 -mindepth 1 -type d -mtime +"$1" 2>/dev/null }
+session_recent(){   # <dir> <days> — does a claude conversation for this dir have activity
+  # within <days>? A killed/backgrounded session stays resumable only while its cwd exists;
+  # removing the dir strands it — `claude --continue` falls back to $HOME and reports "no
+  # conversation found" with no hint why (2026-08-18: a live-session cull + the 3d rung
+  # reaped a study worktree whose conversation was 2h old).
+  local real key
+  real=$(cd "$1" 2>/dev/null && pwd -P) || real="$1"
+  key="${real//[\/._]/-}"   # claude's project key: /, ., _ each map to -
+  [[ -d "$HOME/.claude/projects/$key" ]] || return 1
+  [[ -n "$(find "$HOME/.claude/projects/$key" -name '*.jsonl' -mtime -"$2" -print 2>/dev/null | head -1)" ]]
+}
 ours(){   # $SCRATCH is one shared directory but stack-open runs from whatever repo you're in —
           # only reclaim from worktrees of THIS repo, whose node_modules we know the source of
   [[ "$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" == "$_common_dir" ]]
@@ -206,6 +217,7 @@ prune_old(){ [[ -d "$SCRATCH" ]] || return 0
     # is neither — $SCRATCH is one shared directory and we run from whatever repo you're in.
     if ! ours "$d" && git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then continue; fi
     in_use "$d" && continue
+    session_recent "$d" "${1:-3}" && continue
     git worktree remove --force "$d" 2>/dev/null || rm -rf "$d"
   done
   git worktree prune 2>/dev/null || true
