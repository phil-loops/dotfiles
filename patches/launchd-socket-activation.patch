-except OSError:
-    httpd = ThreadingHTTPServer(("127.0.0.1", 0), H)
-PORT = httpd.server_address[1]
-if len(sys.argv) <= 4:
-    print(PORT, flush=True)  # announce the port only on the first launch
+# When launchd launched us (--launchd), it already created + bound + listened on the
+# :62333 socket; inherit that fd and skip our own bind. NEVER take the ephemeral
+# fallback here — a self-bound random port would strand tabs while launchd's socket
+# sits idle. The dev/non-launchd path keeps the stable-port-with-fallback behavior.
+LAUNCHD_FD = launchd_socket("ReviewServer") if "--launchd" in sys.argv else None
+if LAUNCHD_FD is not None:
+    httpd = ThreadingHTTPServer(("127.0.0.1", PORT), H, bind_and_activate=False)
+    httpd.socket = socket.socket(family=socket.AF_INET, type=socket.SOCK_STREAM, fileno=LAUNCHD_FD)
+    PORT = httpd.socket.getsockname()[1]
+else:
+    try:
+        httpd = ThreadingHTTPServer(("127.0.0.1", PORT), H)
+    except OSError:
+        httpd = ThreadingHTTPServer(("127.0.0.1", 0), H)
+    PORT = httpd.server_address[1]
+if len(sys.argv) <= 4 and LAUNCHD_FD is None:
+    print(PORT, flush=True)  # announce the port only on the first (non-launchd) launch
 
 
 def watcher():
@@ -286,6 +309,12 @@ def watcher():
         try:
             if max(os.path.getmtime(f) for f in srcs) != m0:
                 httpd.socket.close()
+                # Under socket activation we can't re-exec in place: launch_activate_socket
+                # returns EALREADY on a second call within the same job, and the inherited
+                # fd would need set_inheritable to survive execv. Just exit — launchd
+                # relaunches fresh on the next connection, picking up the new code.
+                if LAUNCHD_FD is not None:
+                    os._exit(0)
                 os.execv(sys.executable, [sys.executable, src, ROOT, SCRIPTS, CWD, str(PORT)])
         except OSError:
