 The page is same-origin with the server, so /model and /bless are plain relative fetches.
 """
-import sys, os, json, subprocess, threading, time, hashlib, shlex
+import sys, os, json, subprocess, threading, time, hashlib, shlex, socket
+import ctypes, ctypes.util
 from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
 from urllib.parse import urlparse, parse_qs
 
@@ -258,19 +259,41 @@ def reaper():
             os._exit(0)
 
 
+def launchd_socket(name):
+    # launchd socket-activation: return the listening fd launchd created for us, or
+    # None when we weren't launched by launchd (dev runs via stack-review-serve fall
+    # through to the normal bind below). stdlib doesn't wrap launch_activate_socket(3),
+    # so reach it through libSystem. EALREADY/ESRCH → not a launchd socket → None.
+    lib = ctypes.CDLL(ctypes.util.find_library("System"))
+    fds = ctypes.POINTER(ctypes.c_int)()
+    cnt = ctypes.c_size_t(0)
+    rc = lib.launch_activate_socket(name.encode(), ctypes.byref(fds), ctypes.byref(cnt))
+    return fds[0] if rc == 0 and cnt.value else None
+
+
 # Port: a STABLE default (so reloads + already-open tabs survive a restart) —
 # overridable via $STACK_REVIEW_PORT. The 4th arg is the watcher's rebind port on
 # self-reload. If the stable port is taken (a stale/foreign holder), fall back to
 # an ephemeral one rather than failing to start.
 PORT = int(sys.argv[4]) if len(sys.argv) > 4 else int(os.environ.get("STACK_REVIEW_PORT", "62333"))
 ThreadingHTTPServer.allow_reuse_address = True
-try:
