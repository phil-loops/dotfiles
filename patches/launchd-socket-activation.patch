+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
+  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+<dict>
+  <key>Label</key><string>so.loops.review-server</string>
+
+  <key>ProgramArguments</key>
+  <array>
+    <string>/usr/bin/python3</string>
+    <string>/Users/philbrockman/.dotfiles/scripts/stack-review-server.py</string>
+    <string>--launchd</string>
+  </array>
+
+  <!-- launchd owns the listener; the job inherits the fd on first connect.
+       NO inetdCompatibility: that spawns one process per connection, which would
+       shred the in-memory caches (_index_cache, _pulse) and per-tab SSE streams.
+       We want one long-lived multi-connection server, merely started on demand. -->
+  <key>Sockets</key>
+  <dict>
+    <key>ReviewServer</key>
+    <dict>
+      <key>SockNodeName</key><string>127.0.0.1</string>
+      <key>SockServiceName</key><string>62333</string>
+      <key>SockType</key><string>stream</string>
+      <key>SockFamily</key><string>IPv4</string>
+    </dict>
+  </dict>
+
+  <!-- On-demand: the socket launches it. Not RunAtLoad, not KeepAlive — the 15min
+       idle reaper still os._exit(0)s, and launchd relaunches on the next /sig poll. -->
+  <key>RunAtLoad</key><false/>
+
+  <key>EnvironmentVariables</key>
+  <dict>
+    <key>STACK_REVIEW_PORT</key><string>62333</string>
+    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
+  </dict>
+
+  <key>WorkingDirectory</key><string>/Users/philbrockman/coding/loops</string>
+  <key>StandardOutPath</key><string>/tmp/loops-review-server.log</string>
+  <key>StandardErrorPath</key><string>/tmp/loops-review-server.log</string>
+  <key>ThrottleInterval</key><integer>2</integer>
+</dict>
+</plist>
