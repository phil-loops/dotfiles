+}
+.mp-origin-btn:not(:disabled):not(.armed):hover {
+  background: var(--ember-wash);
+}
+.mp-origin-btn.armed {
+  color: var(--vellum-night);
+  background: var(--ember);
+  transition-delay: 0ms;
+}
+.mp-origin-done {
+  margin-top: 14px;
+  text-align: center;
+  color: var(--add);
+  font-size: 13px;
+}
+.mp-origin-done a {
+  color: inherit;
+}
+@media (prefers-reduced-motion: reduce) {
+  .mp-ward,
+  .mp-ward-seal,
+  .mp-origin-btn {
+    transition: none;
+  }
+}
