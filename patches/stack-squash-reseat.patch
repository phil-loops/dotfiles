     sys.exit(0 if d.get("ok") else 1)
 
 
+def children_of(b):
+    """branches whose stack-branch.<child>.parent points at b (direct children)."""
+    kids = []
+    for ln in git(["config", "--get-regexp", r"^stack-branch\..*\.parent$"]).stdout.splitlines():
+        key, _, val = ln.partition(" ")
+        if val.strip() == b and key.startswith("stack-branch.") and key.endswith(".parent"):
+            kids.append(key[len("stack-branch."):-len(".parent")])
+    return kids
+
+
+def subtree(base):
+    """(node, parent) pairs for base + all descendants, BFS parent-before-child order."""
+    order, frontier = [(base, None)], [base]
+    while frontier:
+        node = frontier.pop(0)
+        for c in children_of(node):
+            order.append((c, node)); frontier.append(c)
+    return order
+
+
+def reseat_gate(base):
+    """Reason a base's subtree can't be safely reseated, or None. Run BEFORE squashing so an
+    unreseatable base is left untouched (no squash) rather than squashed-then-orphaned. A
+    descendant checked out in a worktree can't be rewritten under a live session; a pushed one
+    would need a force-push."""
+    live = {b for _, b in worktrees() if b}
+    for node, _ in subtree(base)[1:]:
+        if f"refs/heads/{node}" in live:
+            return f"{node} is checked out — reseat would rewrite a live worktree"
+        if git(["rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{node}"]).returncode == 0:
+            return f"{node} is pushed — reseat would need a force-push"
+    return None
+
+
+def reseat_cascade(base, old_base_tip, base_wt):
+    """After the base tip moved (old_base_tip → HEAD), replay every descendant onto its parent's
+    NEW tip, cut at the parent's OLD tip, parent-first — the reseat stack-squash historically
+    punted to the caller. Conflict → roll the WHOLE subtree back to pre-squash tips (undoing the
+    squash: base via reset --hard in its worktree, descendants via branch -f) so a failed reseat
+    never leaves a half-moved or orphaned stack. Returns {reseated:[...]} | {conflict:branch}."""
+    order = subtree(base)
+    if len(order) == 1:
+        return {"reseated": []}
+    snap = {node: git(["rev-parse", node]).stdout.strip() for node, _ in order}
+    snap[base] = old_base_tip   # base already moved; its pre-squash tip is the rollback + cut point
+
+    def rollback():
+        for nb, sha in snap.items():
+            if nb == base and base_wt:
+                git(["reset", "--hard", sha], cwd=base_wt)
+            else:
+                git(["branch", "-f", nb, sha], cwd=None)
+
+    scratch = subprocess.run(["mktemp", "-d", "-t", "squash-reseat"], capture_output=True, text=True).stdout.strip()
+    git(["worktree", "add", "--detach", scratch, base], cwd=None)
+    try:
+        for node, par in order[1:]:
+            oldp, newp = snap[par], git(["rev-parse", par]).stdout.strip()
+            if git(["rebase", "--onto", newp, oldp, node], cwd=scratch).returncode != 0:
+                git(["rebase", "--abort"], cwd=scratch)
+                rollback()
+                return {"conflict": node}
+        return {"reseated": [n for n, _ in order[1:]]}
+    finally:
+        git(["worktree", "remove", "--force", scratch], cwd=None)
+
+
