+gen_rebuild(){   # incremental declaration emit → stamp the sha, release the single-flight lock. Call
+                 # the binary DIRECTLY (never npx — backgrounded npx with no TTY hangs on its install
+                 # prompt and piles up runaway procs); tsc is a JS entrypoint so it needs node, tsgo
+                 # is native. The subshell must drop the inherited stdout/stderr too, not just silence
+                 # the compiler: a caller that pipes us (the server's Popen+communicate) waits for EOF
+                 # on those fds, so holding them open makes a background rebuild block the open.
+  local dir="$1" head="$2" marker="$3"; shift 3
+  # Stamp on a written declaration, NOT on the exit code: node_modules is a symlink here, so prisma's
+  # runtime types resolve outside the project and every inferred export trips TS2883 — the emit exits
+  # 1 in every scratch worktree while still writing correct output. Gating the stamp on success left
+  # the marker permanently unwritten, so each open re-paid the full rebuild.
+  # set +e is load-bearing: the emit's failure would otherwise abort this subshell under the script's
+  # errexit, stranding the .rebuilding lock — and a stranded lock makes every later seed return early,
+  # freezing that worktree's .gen forever.
+  ( set +e; cd "$dir" || exit 0
+    "$@" >/dev/null 2>&1
+    [[ -f "$dir/.gen/trpc-types/trpc/root.d.ts" ]] && echo "$head" > "$marker"
+    rmdir "$dir/.gen/.rebuilding" 2>/dev/null
+    exit 0 ) >/dev/null 2>&1
+}
