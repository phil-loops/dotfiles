+                  # hand — so it silently falls behind its own tree, and a branch that never touched
+                  # trpc/ then typechecks against the WRONG router shape (3 false push-blocks on
+                  # 2026-07-21). -quit stops at the first newer source, so this stays ~free.
+  local src="$1" ref="$1/.gen/trpc-types/trpc/root.d.ts"
+  [[ -f "$ref" ]] || return 0
