index 37c8342..3f52d1b 100755
--- a/scripts/loops-preview
+++ b/scripts/loops-preview
@@ -433,6 +433,7 @@ if [ -L "$DIR/node_modules" ]; then BUNDLER="--webpack"; fi
 
 # the workspace links resolve to the checkout's OWN packages/*, which carry source but no build —
 # take MAIN's dist for each (gitignored, so the checkout stays clean)
+borrowed_cfgs=""
 for src in "$MAIN"/packages/*/dist; do
   [ -d "$src" ] || continue
   dest="$DIR/packages/$(basename "$(dirname "$src")")/dist"
@@ -440,6 +441,9 @@ for src in "$MAIN"/packages/*/dist; do
   if [ ! -d "$dest" ] || [ "$src" -nt "$dest" ]; then
     rm -rf "$dest"
     cp -Rc "$src" "$dest" 2>/dev/null || cp -R "$src" "$dest"
+    if [ -f "$(dirname "$dest")/tsconfig.json" ]; then
+      borrowed_cfgs="$borrowed_cfgs $(dirname "$dest")/tsconfig.json"
+    fi
   fi
 done
 # A borrowed dist can be unbuilt — MAIN between `task dev` runs, or on a branch that lacks the
@@ -455,19 +459,22 @@ if [ -n "$unbuilt" ]; then
   cyan "building unbuilt workspace package(s):$(printf '%s\n' $unbuilt | xargs -n1 dirname | xargs -n1 basename | tr '\n' ' ' | sed 's/ $//')"
