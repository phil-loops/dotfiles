@@ -109,6 +148,7 @@ build_integration() {
   # Single leaf: integration ref = leaf tip itself. No merge needed.
   if (( ${#leaves[@]} == 1 )); then
     git update-ref "$ref" "refs/heads/${leaves[1]}"
+    if (( STATUS )); then report_playground "$project" "$ref"; return 0; fi
     if (( CHECK_ONLY )); then return 0; fi
     if (( WORKTREE )); then materialize_worktree "$project" "$ref"; return 0; fi
     echo "$ref"
