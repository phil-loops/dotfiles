diff --git a/scripts/stack-integrate b/scripts/stack-integrate
index 47d5cf0..b40bfbe 100755
--- a/scripts/stack-integrate
+++ b/scripts/stack-integrate
@@ -84,7 +84,7 @@ build_integration() {
   for m in "${members[@]}"; do
     while IFS= read -r r; do
       [[ -n "$r" ]] && is_carried[$r]=1
-    done < <(git config --get-all "stack-branch.${m}.requires" 2>/dev/null || true)
+    done < <(git config --get-all "branch.${m}.stack-requires" 2>/dev/null || git config --get-all "stack-branch.${m}.requires" 2>/dev/null || true)
