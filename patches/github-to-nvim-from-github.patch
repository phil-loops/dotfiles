+def open_file(req, raw):   # POST /open — open a file on a branch in the warm review-nvim
+    d = json.loads(raw or "{}")
+    code, out, err = open_on_branch(d.get("branch", ""), d.get("path", ""), d.get("pos") or d.get("line"))
+    if code == 504:
+        req._send(504, json.dumps({"ok": False, "err": err}))
+        return
