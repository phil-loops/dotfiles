<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.phil.prwatch-sweep</string>

  <!-- run `prwatch --sweep` every 60s: it notifies only when one of your open
       PRs newly fails or recovers (source-agnostic; catches web-opened PRs). -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/philbrockman/.dotfiles/scripts/prwatch</string>
    <string>--sweep</string>
  </array>

  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>

  <!-- gh + jq live in homebrew; gh reads its auth from ~/.config/gh -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/philbrockman/.local/bin</string>
    <key>HOME</key>
    <string>/Users/philbrockman</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/prwatch-sweep.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/prwatch-sweep.log</string>
</dict>
</plist>
